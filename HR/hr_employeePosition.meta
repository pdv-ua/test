      "description": "Відключити автоматичне табелювання факту",
      "defaultValue": "0"
    },
    {
      "name": "deletedByEmployee",
      "dataType": "Boolean",
      "caption": "Ознака видаленого запису зв'язанного с ОР",
      "description": "Ознака видаленого запису зв'язанного с ОР",
      "defaultValue": "0"
    },
    {
      "name": "dictEmpCategoryID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictEmpCategory",
      "caption": "Кваліфікаційна категорія",
      "description": "Кваліфікаційна категорія"
    },
    {
      "name": "dictQualificationID",
      "dataType": "Entity",
      "associatedEntity": "trf_dictQualification",
      "caption": "Кваліфікація",
      "description": "Кваліфікація"
    },
    {
      "name": "tabNum",
      "dataType": "String",
      "size": 15,
      "caption": "Табельний номер",
      "description": "Табельний номер",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 en.tabNum from hr_employeeNumber en where en.ID = {self}.employeeNumberID)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select en.tabNum from hr_employeeNumber en where en.ID = {self}.employeeNumberID LIMIT 1)"
        }
      ]
    },
    {
      "name": "dictTrialPeriodID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictTrialPeriod",
      "caption": "Термін",
      "description": "Термін випробувального періоду",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 dictTrialPeriodID FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT dictTrialPeriodID FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC LIMIT 1)"
        }
      ]
    },
    {
      "name": "dateTrialEnd",
      "dataType": "Date",
      "caption": "Закінчення випробувального терміну",
      "description": "Закінчення випробувального терміну",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 dateTrialEnd FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT dateTrialEnd FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC LIMIT 1)"
        }
      ]
    },
    {
      "name": "closeOrderID",
      "dataType": "Entity",
      "associatedEntity": "hr_order",
      "caption": "Наказ на закриття",
      "description": "Наказ на закриття",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select case year({self}.dateTo) when 9999 then null else coalesce({self}.changeOrderID, {self}.orderID) end)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select case Extract(YEAR from {self}.dateTo) when 9999 then null else coalesce({self}.changeOrderID, {self}.orderID) end)"
        }
      ]
    }
  ],
  "dbExtensions": {
    "IDX_HR_EMPPOS": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "employeeNumberID": { "sort": "ASC" },
          "isActive": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPPOS_EMP": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "employeeID": { "sort": "ASC" },
          "isActive": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPPOS_ORG": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "organizationID": { "sort": "ASC" },
          "isActive": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" },
          "dateTo": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPPOS_DATA": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "dateFrom": { "sort": "ASC" },
          "dateTo": { "sort": "ASC" },
          "isActive": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "rls": {
      "func": "hr_employeePosition.rls"
    }
  }
}
