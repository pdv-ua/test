{
  "caption": "Входження виду оплати",
  "description": "Входження виду оплати",
  "descriptionAttribute": "payElBaseID",
  "cacheType": "None",
  "attributes": [
    {
      "name": "payElID",
      "dataType": "Entity",
      "associatedEntity": "hr_payEl",
      "caption": "Вид оплати",
      "description": "Вид оплати",
      "documentation": "Вид оплати",
      "allowNull": false
    },
    {
      "name": "payElBaseID",
      "dataType": "Entity",
      "associatedEntity": "hr_payEl",
      "caption": "Базовий Вид оплати",
      "description": "Базовий Вид оплати",
      "documentation": "Базовий Вид оплати",
      "allowNull": false
    },
    {
      "name": "entryType",
      "dataType": "Enum",
      "enumGroup": "HR_ENTRY_TYPE",
      "caption": "Тип входження",
      "description": "Тип входження",
      "documentation": "Тип входження",
      "allowNull": false,
      "defaultValue": "SUM"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "allowNull": false,
      "defaultView": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}