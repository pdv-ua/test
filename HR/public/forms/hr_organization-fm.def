/* global UB AC HR */
exports.formDef = {
  requiredFields: ['state', 'mi_data_id', 'priorID', 'staffOrderID.orderState', 'staffOrderID.entryDate'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'vbox', align: 'stretch' }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'createNewVersion'
        }
      ]
    }
  ],
  items: [
    {
      xtype: 'tabpanel',
      flex: 1,
      items: [
        {
          title: UB.i18n('Загальне'),
          layout: { type: 'vbox', align: 'stretch' },
          defaults: { labelWidth: 170 },
          flex: 1,
          autoScroll: true,
          items: [
            AC.viewUtils.getCollapsiblePanel(
              /* eslint-disable */
              '<table><tr><td><span style="color:#2196F3;padding-left: 16px">${UB.i18n("Код")}: </span> ${code}</td><td><span style="color:#2196F3;padding-left: 16px">${UB.i18n("Номер за порядком")}:</span> ${idxNum}</td></tr>' +
              '<tr><td><span style="color:#2196F3;padding-left: 16px">${UB.i18n("Дата початку дії")}:</span> ${get("mi_dateFrom") ? moment(get("mi_dateFrom")).format("DD.MM.YYYY"): " - "}</td><td><span style="color:#2196F3;padding-left: 16px">${UB.i18n("Дата закінчення дії")}:</span> ${get("dateToEmpty") ? moment(get("dateToEmpty")).format("DD.MM.YYYY"): " - "}</td></tr></table> '
              ,
              /* eslint-enable */
              {
                expandTitle: UB.i18n('Інформація'),
                layout: {
                  type: 'vbox',
                  align: 'stretch'
                },
                margin: '5px 10px 5px 10px',
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        attributeName: 'staffOrderID',
                        hideEntityItemInContext: true,
                        readOnly: true,
                        margin: '10 15 5 15',
                        fieldList: ['ID', 'description', 'orderState', 'entryDate'],
                        whereList: {
                          orderClass: {
                            expression: '[orderClass.entityName]',
                            condition: 'in',
                            values: {
                              orderClass: ['hr_staffOrder', 'hr_staffTable', 'hr_staffOrderOrgStructure']
                            }
                          }
                        },
                        labelWidth: 170,
                        flex: 1
                      },
                      {
                        attributeName: 'entryOrderID',
                        readOnly: true,
                        margin: '10 15 5 15',
                        fieldList: ['ID', 'description'],
                        labelWidth: 150,
                        flex: 1
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      { attributeName: 'code', labelWidth: 170, flex: 1 },
                      { attributeName: 'idxNum', labelWidth: 150, flex: 1, maxValue: 99999999, minValue: 0 }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        layout: { type: 'hbox' },
                        items: [
                          {
                            attributeName: 'mi_dateFrom',
                            fieldLabel: UB.i18n('Дата початку дії'),
                            readOnly: true,
                            xtype: 'datefield',
                            labelWidth: 170,
                            width: 300,
                            margin: '5 15 10px 15'
                          },
                          {
                            xtype: 'component',
                            flex: 1
                          }
                        ],
                        flex: 1
                      },
                      {
                        layout: { type: 'hbox' },
                        items: [
                          {
                            attributeName: 'dateToEmpty',
                            fieldLabel: UB.i18n('Дата закінчення дії'),
                            readOnly: true,
                            xtype: 'datefield',
                            labelWidth: 150,
                            width: 300
                          },
                          {
                            xtype: 'component',
                            flex: 1
                          }
                        ],
                        flex: 1
                      }
                    ]
                  }
                ]
              }),
            { attributeName: 'name' },
            { attributeName: 'nameEng', vtype: 'latinSymbolsValidator' },
            { attributeName: 'fullName', xtype: 'textarea', height: 45 },
            {
              attributeName: 'parentUnitID',
              fieldList: ['mi_data_id', 'description', 'mi_dateFrom', 'state', 'staffOrderID'],
              orderList: { orderBy: { expression: 'mi_dateFrom', order: 'desc' } },
              valueField: 'mi_data_id',
              displayField: 'description',
              hideEntityItemInContext: true,
              __mip_recordhistory_all: true
            },
            {
              layout: { type: 'hbox' },
              items: [
                {
                  attributeName: 'conditionalName',
                  labelWidth: 170,
                  margin: '5 15 10px 15',
