                    },
                    flex: 1,
                    defaults: {
                      labelWidth: 170
                    },
                    items: [
                      AC.viewUtils.getCollapsiblePanel(
                        /* eslint-disable */
                        '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Дата початку дії")}:</span> ${get("mi_dateFrom") ? moment(get("mi_dateFrom")).format("DD.MM.YYYY"): " - "} <br>',
                        /* eslint-enable */
                        {
                          name: 'panelCommonInfo',
                          layout: {
                            type: 'vbox',
                            align: 'stretch'
                          },
                          margin: '5 15 5 5',
                          defaults: {
                            labelWidth: 170
                          },
                          items: [
                            {
                              attributeName: 'staffOrderID',
                              hideEntityItemInContext: true,
                              readOnly: true,
                              fieldList: ['ID', 'description', 'orderState', 'entryDate', 'orderDate'],
                              whereList: {
                                orderClass: {
                                  expression: '[orderClass.entityName]',
