              listeners: {
                render: grid => {
                  grid.menu.add([
                    {
                      text: UB.i18n('Копіювати'),
                      disabled: !AC.entityUtils.verifyRightsMethod('hr_positionInstruction', 'addnew'),
                      handler: function () {
                        let record = AC.gridUtils.getCurrentRecord(grid)
                        if (!record) {
                          AC.viewUtils.showToast(UB.i18n('Помилка'), UB.i18n('Не вибрано запис'))
                          return
                        }
                        const payElID = record.get('ID')
                        $App.connection.run({
                          entity: 'hr_positionInstruction',
                          method: 'copyRecord',
                          ID: payElID
                        }).then((mParams) => {
                          grid.onRefresh()
                          $App.doCommand({
                            cmdType: 'showForm',
                            entity: 'hr_positionInstruction',
                            formCode: 'hr_positionInstruction',
                            instanceID: mParams.newID,
                            tabId: 'hr_positionInstruction_copyRecord' + Date.now(),
                            target: $App.getViewport().centralPanel,
                            cmpInitConfig: {
                              method: 'copyRecord',
                              sourceGrid: grid
                            }
                          })
                        })
                      }
                    }
                  ])
                }
              }
            }
