                            fieldList: ['ID', 'description', 'codeSort'],
                            orderList: { orderBy: { expression: 'codeSort' } },
                            whereList: {
                              isSalary: {
                                expression: '[methodID.methodGroupID.code]',
                                condition: 'equal',
                                value: '1'
                              },
                              tariff: {
                                expression: '[methodID.code]',
                                condition: 'notIn',
                                value: ['143', '144', '145', '146', '147', '156']
                              }
                            }
                          },
