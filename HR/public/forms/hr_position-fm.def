                },
                cmpInitConfig: {
                  afterInit: function () {
                    const notShowSalary = AC.entityUtils.verifyRightsMethod('hr_service', 'notShowSalary') && !AC.entityUtils.isAdmin()
                    if (notShowSalary) {
                      const renderer = {
                        accrualSum: {
                          renderer: function (value, meta, record) {
                            return notShowSalary ? 0 : value
                          }
                        }
