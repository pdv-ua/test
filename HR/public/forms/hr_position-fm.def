        ubID: 'tabMain',
        layout: {
          type: 'border'
        },
        items: [
          {
            region: 'center',
            autoScroll: true,
            split: true,
            layout: {
              type: 'vbox',
              align: 'stretch'
            },
            defaults: {
              labelWidth: 170
            },
            flex: 1,
            items: [
              {
                layout: {
                  type: 'hbox'
                },
                items: [
                  {
                    layout: {
                      type: 'vbox',
                      align: 'stretch'
                    },
                    flex: 1,
                    defaults: {
                      labelWidth: 170,
                      flex: 1
                    },
                    items: [
                      {
                        attributeName: 'positionType',
                        allowBlank: false,
                        width: 420
                      },
                      {
                        attributeName: 'dictPositionID',
                        fieldList: ['ID', 'description', 'name', 'nameNom', 'code', 'positionCategory', 'dictWagePayID',
                          'psCategory', 'dictStatePayID', 'positionType', 'dictStaffCatID', 'dictStaffSubCatID',
                          'dictSpecialtyID', 'dictEmpCategoryID', 'dictTarifCoeffID', 'workScheduleID', 'dictCostTypeID',
                          'dictSalarySchemeLevelID', 'dictAcademStatusID', 'dictDegreeID'],
