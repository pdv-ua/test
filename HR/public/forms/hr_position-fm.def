                      }),
                      {
                        attributeName: 'dictProfessionID',
                        fieldList: ['ID', 'description', 'name', 'code',
                          'contractType', 'dictContractKindID', 'workerType', 'personalType', 'positionCategory', 'dictWagePayID', 'psCategory' ],
