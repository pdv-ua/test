                        labelWidth: 170,
                        maxLength: 250,
                        gridFieldList: ['name', { name: 'ID', visibility: false }],
                        flex: 1,
                        ubRequest: {
                          entity: 'hr_dictNameAddition',
                          fieldList: ['ID', 'name'],
                          orderList: { orderBy: { expression: 'name' } }
                        },
                        onControlChange: (ctrl, value) => {
                          const me = ctrl.up('form')
                          me.setCases()
                          me.setFullName()
