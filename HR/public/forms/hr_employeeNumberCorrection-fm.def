// @isModal true
/* global appAC appHR UB Ext AC $App HR */

exports.formDef = 'HR.employeePositionUpdate'

Ext.define('HR.employeePositionUpdate', {
  extend: 'Ext.form.Panel',
  alias: 'widget.employeePositionUpdate',
  width: 1100,
  height: 700,
  layout: { type: 'border' },
  viewConfig: {
    toggleOnDblClick: false
  },
  isModal: true,
  initComponent: function () {
    const me = this
    me.items = [
      {
        layout: { type: 'border' },
        region: 'center',
        items: [
          {
            xtype: 'tabpanel',
            region: 'center',
            items: [
              {
                title: UB.i18n('Параметри коригування'),
                layout: { type: 'border' },
                items: [
                  {
                    xtype: 'panel',
                    region: 'north',
                    margin: {
                      top: 10
                    },
                    layout: { type: 'vbox' },
                    items: [
                      {
                        xtype: 'combobox',
                        name: 'entity',
                        labelWidth: 100,
                        width: 350,
                        fieldLabel: UB.i18n('Розділ'),
                        valueField: 'code',
                        displayField: 'name',
                        defaultValue: 'employeePosition',
                        store: Ext.create('Ext.data.Store', {
                          fields: [
                            { name: 'name' },
                            { name: 'code' }
                          ],
                          data: [
                            { name: UB.i18n('Призначення працівника'), code: 'employeePosition' },
                            { name: UB.i18n('Постійні нарахування'), code: 'employeeAccrual' },
                            { name: UB.i18n('Постійні утримання'), code: 'payRetention' },
                            { name: UB.i18n('Шаблон виплати'), code: 'payOutTemplate' }
                          ]
                        }),
                        listeners: {
                          change: (ctrl, value) => {
                            HR.orderManager.showIf(me)
                            HR.orderManager.disabledIf(me)
                            switch (value) {
                              case 'employeePosition':
                                me.attr.action.setValue({ mode: 'updateEmployeePosition' })
                                me.attr.accrualSum.setFieldLabel(UB.i18n('Оклад'))
                                AC.viewUtils.setWhereListProperty(me.attr.payElID, [
                                  ['methodID.code', 'in', ['1', '2', '3', '44', '77', '63']]
                                ], undefined, ['clearValue', 'clearStore', 'clearWhereList'])
                                break
                              case 'employeeAccrual':
                                me.attr.action.setValue({ mode: 'updateEmployeeAccrual' })
                                me.attr.accrualSum.setFieldLabel(UB.i18n('Сума'))
                                AC.viewUtils.setWhereListProperty(me.attr.payElID, [
                                  ['methodID.methodGroupID.groupType', '=', 'PAYMENT'],
                                  ['isAutoCalc', '=', 1]
                                ], undefined, ['clearValue', 'clearStore', 'clearWhereList'])
                                break
                              case 'payRetention':
                                me.attr.action.setValue({ mode: 'updatePayRetention' })
                                me.attr.accrualSum.setFieldLabel(UB.i18n('Сума'))
                                AC.viewUtils.setWhereListProperty(me.attr.payElID, [
                                  ['methodID.methodGroupID.groupType', 'in', ['OFFTAKE', 'FORPAY']],
                                  ['methodID.code', 'notEqual', '43']
                                ], undefined, ['clearValue', 'clearStore', 'clearWhereList'])
                                break
                              case 'payOutTemplate':
                                me.attr.action.setValue({ mode: 'updatePayOutTemplate' })
                                break
                            }
                          }
                        }
                      }
                    ]
                  },
                  {
                    xtype: 'panel',
                    region: 'center',
                    ubID: 'employeePosition',
                    margin: {
                      top: 10
                    },
                    style: 'border-top: 1px solid #BFBFBF;',
                    layout: { type: 'vbox', align: 'stretch' },
                    autoScroll: true,
                    items: [
                      {
                        xtype: 'radiogroup',
                        name: 'action',
                        columns: 1,
                        vertical: true,
                        margin: {
                          left: 100
                        },
                        listeners: {
                          change: (ctrl, value) => {
                            HR.orderManager.showIf(me)
                            HR.orderManager.disabledIf(me)
                            HR.orderManager.requiredIf(me)
                          }
                        },
                        items: [
                          {
                            name: 'mode',
                            boxLabel: UB.i18n('Коригувати наявні призначення'),
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                            inputValue: 'updateEmployeePosition',
                            width: 450
                          },
                          {
                            name: 'mode',
                            boxLabel: UB.i18n('Створити нове призначення'),
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                            inputValue: 'createEmployeePosition'
                          },
                          {
                            name: 'mode',
                            boxLabel: ('Коригувати наявні записи постійних нарахувань'),
                            showIf: (ctrl, me) => ['employeeAccrual'].includes(me.attr.entity.getValue()),
                            inputValue: 'updateEmployeeAccrual'
                          },
                          {
                            name: 'mode',
                            boxLabel: UB.i18n('Створити новий запис постійного нарахування'),
                            showIf: (ctrl, me) => ['employeeAccrual'].includes(me.attr.entity.getValue()),
                            inputValue: 'createEmployeeAccrual'
                          },
                          {
                            name: 'mode',
                            showIf: (ctrl, me) => ['payRetention'].includes(me.attr.entity.getValue()),
                            boxLabel: UB.i18n('Коригувати наявні записи постійних утримань і виплат'),
                            inputValue: 'updatePayRetention'
                          },
                          {
                            name: 'mode',
                            showIf: (ctrl, me) => ['payRetention'].includes(me.attr.entity.getValue()),
                            boxLabel: UB.i18n('Створити новий запис постійного утримання або виплати'),
                            inputValue: 'createPayRetention'
                          },
                          {
                            name: 'mode',
                            showIf: (ctrl, me) => ['payOutTemplate'].includes(me.attr.entity.getValue()),
                            boxLabel: UB.i18n('Коригувати наявні записи шаблонів виплат'),
                            inputValue: 'updatePayOutTemplate'
                          }
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        padding: {
                          bottom: 10
                        },
                        items: [
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            items: [
                              {
                                name: 'dateFrom',
                                showIf: (ctrl, me) => !['payOutTemplate'].includes(me.attr.entity.getValue()),
                                xtype: 'ubdatefield',
                                labelWidth: 100,
                                fieldLabel: UB.i18n('Початок'),
                                requiredIf: (ctrl, me) => ['createEmployeePosition', 'createEmployeeAccrual', 'createPayRetention'].includes(me.getActionValue())
                              },
                              {
                                name: 'dateTo',
                                showIf: (ctrl, me) => !['payOutTemplate'].includes(me.attr.entity.getValue()),
                                xtype: 'ubdatefield',
                                fieldLabel: UB.i18n('Закінчення')
                              }
                            ]
                          },
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            items: [
                              {
                                name: 'orderNumber',
                                showIf: (ctrl, me) => ['employeePosition', 'employeeAccrual'].includes(me.attr.entity.getValue()) && !['updateEmployeePosition'].includes(me.getActionValue()),
                                labelWidth: 80,
                                xtype: 'ubtextfield',
                                fieldLabel: UB.i18n('Наказ')
                              },
                              {
                                name: 'orderDate',
                                labelWidth: 60,
                                showIf: (ctrl, me) => ['employeePosition', 'employeeAccrual'].includes(me.attr.entity.getValue()) && !['updateEmployeePosition'].includes(me.getActionValue()),
                                xtype: 'ubdatefield',
                                fieldLabel: UB.i18n('від')
                              }
                            ]
                          }
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        style: 'border-top: 1px solid #BFBFBF;',
                        items: [
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkWorkPlace',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.workPlace.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubcombobox',
                                fieldLabel: UB.i18n('Місце роботи'),
                                labelWidth: 150,
                                name: 'workPlace',
                                hideEntityItemInContext: true,
                                valueField: 'code',
                                ubRequest: {
                                  entity: 'ubm_enum',
                                  method: UB.core.UBCommand.methodName.SELECT,
                                  fieldList: ['ID', 'name', 'code', 'eGroup'],
                                  whereList: {
                                    enumGroupFilter: {
                                      expression: '[eGroup]',
                                      condition: 'equal',
                                      values: {
                                        val: 'HR_WORKER_PLACE'
                                      }
                                    }
                                  }
                                },
                                listeners: {
                                  select: () => {
                                    me.attr.checkWorkPlace.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkWorkPlace.setValue(!!value)
                                  }
                                },
                                flex: 1
                              }
                            ]
                          },
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkRaiseSalary',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.raiseSalary.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubdatefield',
                                fieldLabel: UB.i18n('Місяць підвищення доходу для індексації'),
                                labelWidth: 150,
                                name: 'raiseSalary',
                                flex: 1,
                                listeners: {
                                  select: () => {
                                    me.attr.checkRaiseSalary.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkRaiseSalary.setValue(!!value)
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        showIf: (ctrl, me) => ['payOutTemplate'].includes(me.attr.entity.getValue()),
                        requiredIf: (ctrl, me) => ['payOutTemplate'].includes(me.attr.entity.getValue()),
                        items: [
                          {
                            xtype: 'ubcombobox',
                            fieldLabel: UB.i18n('Шаблон виплати'),
                            labelWidth: 150,
                            name: 'payOutTemplateID',
                            hideEntityItemInContext: true,
                            ubRequest: {
                              entity: 'hr_payOut',
                              method: UB.core.UBCommand.methodName.SELECT,
                              fieldList: ['ID', 'name']
                            },
                            flex: 1
                          }
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        items: [
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkWorkerType',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.workerType.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubcombobox',
                                fieldLabel: UB.i18n('Форма зайнятості'),
                                labelWidth: 150,
                                name: 'workerType',
                                hideEntityItemInContext: true,
                                valueField: 'code',
                                ubRequest: {
                                  entity: 'ubm_enum',
                                  method: UB.core.UBCommand.methodName.SELECT,
                                  fieldList: ['ID', 'name', 'code', 'eGroup'],
                                  whereList: {
                                    enumGroupFilter: {
                                      expression: '[eGroup]',
                                      condition: 'equal',
                                      values: {
                                        val: 'HR_WORKER_TYPE'
                                      }
                                    }
                                  }
                                },
                                listeners: {
                                  select: () => {
                                    me.attr.checkWorkerType.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkWorkerType.setValue(!!value)
                                  }
                                },
                                flex: 1
                              }
                            ]
                          },
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkDateNew',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.dateNew.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubdatefield',
                                fieldLabel: UB.i18n('Дата створення нового робочого місця'),
                                labelWidth: 150,
                                name: 'dateNew',
                                flex: 1,
                                listeners: {
                                  select: () => {
                                    me.attr.checkDateNew.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkDateNew.setValue(!!value)
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                        items: [
                          {
                            xtype: 'checkbox',
                            name: 'checkDictStaffCatID',
                            listeners: {
                              change: (ctrl, value) => {
                                if (!value) me.attr.dictStaffCatID.setValue()
                              }
                            }
                          },
                          {
                            xtype: 'ubcombobox',
                            fieldLabel: UB.i18n('Категорія персоналу'),
                            labelWidth: 150,
                            disableModifyEntity: true,
                            displayField: 'description',
                            name: 'dictStaffCatID',
                            ubRequest: {
                              entity: 'hr_dictStaffCat',
                              method: UB.core.UBCommand.methodName.SELECT,
                              fieldList: ['ID', 'name', 'code', 'description']
                            },
                            listeners: {
                              select: () => {
                                me.attr.checkDictStaffCatID.setValue(true)
                              },
                              change: (ctrl, value) => {
                                me.attr.checkDictStaffCatID.setValue(!!value)
                              }
                            },
                            flex: 1
                          },
                          {
                            xtype: 'checkbox',
                            name: 'checkIsIndex',
                            listeners: {
                              change: (ctrl, value) => {
                                if (!value) me.attr.isIndex.setValue()
                              }
                            }
                          },
                          {
                            xtype: 'checkbox',
                            fieldLabel: UB.i18n('Індексувати середній заробіток згідно підвищення окладу'),
                            labelWidth: 250,
                            name: 'isIndex',
                            flex: 1,
                            listeners: {
                              select: () => {
                                me.attr.checkIsIndex.setValue(true)
                              },
                              change: (ctrl, value) => {
                                me.attr.checkIsIndex.setValue(!!value)
                              }
                            }
                          }
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()),
                        items: [
                          {
                            xtype: 'checkbox',
                            name: 'checkDepartmentID',
                            listeners: {
                              change: (ctrl, value) => {
                                if (!value) me.attr.departmentID.setValue()
                              }
                            }
                          },
                          {
                            xtype: 'ubcombobox',
                            fieldLabel: UB.i18n('Підрозділ'),
                            labelWidth: 150,
                            name: 'departmentID',
                            disableModifyEntity: true,
                            valueField: 'mi_data_id',
                            displayField: 'caption',
                            ubRequest: {
                              entity: 'hr_department',
                              method: UB.core.UBCommand.methodName.SELECT,
                              fieldList: ['ID', 'name', 'description', 'caption', 'mi_data_id'],
                              __mip_recordhistory_all: true,
                              whereList: { state: { expression: '[state]', condition: '=', value: 'ACTIVE' } }
                            },
                            flex: 1,
                            listeners: {
                              select: () => {
                                me.attr.checkDepartmentID.setValue(true)
                              },
                              change: (ctrl, value) => {
                                me.attr.checkDepartmentID.setValue(!!value)
                              }
                            }
                          },
                          {
                            xtype: 'checkbox',
                            name: 'checkDictCategoryECBID',
                            listeners: {
                              change: (ctrl, value) => {
                                if (!value) me.attr.dictCategoryECBID.setValue()
                              }
                            }
                          },
                          {
                            xtype: 'ubcombobox',
                            fieldLabel: UB.i18n('Категорія застрахованої особи'),
                            labelWidth: 150,
                            disableModifyEntity: true,
                            displayField: 'description',
                            name: 'dictCategoryECBID',
                            ubRequest: {
                              entity: 'hr_dictCategoryECB',
                              method: UB.core.UBCommand.methodName.SELECT,
                              fieldList: ['ID', 'name', 'description']
                            },
                            flex: 1,
                            listeners: {
                              select: () => {
                                me.attr.checkDictCategoryECBID.setValue(true)
                              },
                              change: (ctrl, value) => {
                                me.attr.checkDictCategoryECBID.setValue(!!value)
                              }
                            }
                          }
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        items: [
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()) && AC.settings.get('hrUseStaffingTable', appAC.globalOrganization()),
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkPositionID',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.positionID.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubcombobox',
                                fieldLabel: UB.i18n('Посада'),
                                labelWidth: 150,
                                name: 'positionID',
                                valueField: 'mi_data_id',
                                displayField: 'caption',
                                disableModifyEntity: true,
                                ubRequest: {
                                  entity: 'hr_position',
                                  method: UB.core.UBCommand.methodName.SELECT,
                                  fieldList: ['ID', 'name', 'description', 'caption', 'mi_data_id'],
                                  __mip_recordhistory_all: true,
                                  whereList: { state: { expression: '[state]', condition: '=', value: 'ACTIVE' } }
                                },
                                flex: 1,
                                listeners: {
                                  select: () => {
                                    me.attr.checkPositionID.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkPositionID.setValue(!!value)
                                  }
                                }
                              }
                            ]
                          },
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            showIf: (ctrl, me) => ['employeePosition'].includes(me.attr.entity.getValue()) && !AC.settings.get('hrUseStaffingTable', appAC.globalOrganization()),
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkDictPositionID',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.dictPositionID.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubcombobox',
                                fieldLabel: UB.i18n('Посада'),
                                labelWidth: 150,
                                name: 'dictPositionID',
                                valueField: 'ID',
                                displayField: 'name',
                                disableModifyEntity: true,
                                ubRequest: {
                                  entity: 'hr_dictPosition',
                                  method: UB.core.UBCommand.methodName.SELECT,
                                  fieldList: ['ID', 'name'],
                                  __mip_recordhistory_all: true
                                },
                                flex: 1,
                                listeners: {
                                  select: () => {
                                    me.attr.checkDictPositionID.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkDictPositionID.setValue(!!value)
                                  }
                                }
                              }
                            ]
                          },
                          {
                            layout: { type: 'hbox' },
                            showIf: (ctrl, me) => ['employeeAccrual', 'payRetention'].includes(me.attr.entity.getValue()),
                            // disabledIf: (ctrl, me) => !(['createEmployeeAccrual', 'createPayRetention'].includes(me.getActionValue())),
                            flex: 1,
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkPayElID',
                                // disabledIf: (ctrl, me) => !(['createEmployeeAccrual', 'createPayRetention'].includes(me.getActionValue())),
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.payElID.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubcombobox',
                                name: 'payElID',
                                labelWidth: 150,
                                flex: 1,
                                displayField: 'description',
                                fieldLabel: UB.i18n('Вид оплати'),
                                disableModifyEntity: true,
                                ubRequest: {
                                  entity: 'hr_payEl',
                                  method: UB.core.UBCommand.methodName.SELECT,
                                  fieldList: ['ID', 'name', 'description'],
                                  orderList: {
                                    orderBy: {
                                      expression: 'codeSort'
                                    }
                                  }
                                },
                                requiredIf: (ctrl, me) => ['createEmployeeAccrual', 'createPayRetention'].includes(me.getActionValue()),
                                // disabledIf: (ctrl, me) => !(['createEmployeeAccrual', 'createPayRetention'].includes(me.getActionValue())),
                                listeners: {
                                  select: () => {
                                    me.attr.checkPayElID.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkPayElID.setValue(!!value)
                                  }
                                }
                              }
                            ]
                          },
                          {
                            layout: { type: 'hbox' },
                            flex: 1,
                            showIf: (ctrl, me) => ['employeeAccrual', 'employeePosition'].includes(me.attr.entity.getValue()),
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkDictFundSourceID',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.dictFundSourceID.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubcombobox',
                                fieldLabel: UB.i18n('Джерело фінансування'),
                                labelWidth: 150,
                                name: 'dictFundSourceID',
                                disableModifyEntity: true,
                                displayField: 'description',
                                ubRequest: {
                                  entity: 'ac_fundSource',
                                  method: UB.core.UBCommand.methodName.SELECT,
                                  fieldList: ['ID', 'name', 'description']
                                },
                                flex: 1,
                                listeners: {
                                  select: () => {
                                    me.attr.checkDictFundSourceID.setValue(true)
                                  },
                                  change: (ctrl, value) => {
                                    me.attr.checkDictFundSourceID.setValue(!!value)
                                  }
                                }
                              }
                            ]
                          },
                          {
                            layout: { type: 'hbox' },
                            showIf: (ctrl, me) => ['payRetention'].includes(me.attr.entity.getValue()),
                            flex: 1,
                            items: [
                              {
                                xtype: 'checkbox',
                                name: 'checkContractorID',
                                listeners: {
                                  change: (ctrl, value) => {
                                    if (!value) me.attr.contractorID.setValue()
                                  }
                                }
                              },
                              {
                                xtype: 'ubcombobox',
                                fieldLabel: UB.i18n('Отримувач'),
                                labelWidth: 150,
                                displayField: 'description',
                                disableModifyEntity: true,
                                name: 'contractorID',
                                ubRequest: {
                                  entity: 'ac_contractor',
                                  method: UB.core.UBCommand.methodName.SELECT,
                                  fieldList: ['ID', 'name', 'description']
                                },
                                flex: 1,
                                listeners: {
                                  select: () => {
                                    me.attr.checkContractorID.setValue(true)
