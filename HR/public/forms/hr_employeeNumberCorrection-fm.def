              {
                xtype: 'acGrid',
                name: 'employeePositionList',
                stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_employeePositionUpdate_employeePositionList'),
                title: UB.i18n('Список особових рахунків'),
                layout: 'fit',
                flex: 1,
                autoScroll: true,
                rowEditing: true,
                notWriteChanges: true,
                storeType: 'local',
                showToolBar: true,
                disablePaging: true,
                hideActions: ['addNewByCurrent'],
                loadMaskMessage: UB.i18n('Завантаження даних...'),
                onBeforeEdit: (control, context) => {
                  AC.viewUtils.setFilterValue(context.column.field, { orgID: appAC.globalOrganization() })
                  context.column.field.on('change', (ctrl) => {
                    context.record.set('employeeNumberID.posName', ctrl.getFieldValue('posName'))
                    context.record.set('employeeNumberID.depName', ctrl.getFieldValue('depName'))
                  })
                },
                fields: [
                  { name: 'ID' },
                  { name: 'mi_modifyDate' },
                  {
                    name: 'employeeNumberID.description',
                    columnConfig: {
                      text: UB.i18n('Працівник'),
                      flex: 1,
                      editor: {
                        dataType: 'Entity',
                        hideEntityItemInContext: true,
                        associatedEntity: 'hr_employeeNumberSR',
                        allowBlank: false,
                        disableClearSelection: true,
                        disableContextMenu: true,
                        storeAttributeValueField: 'employeeNumberID',
                        fieldList: ['ID', 'description', 'orgID', 'posName', 'depName']
                      }
                    }
                  },
                  {
                    name: 'employeeNumberID.posName',
                    columnConfig: {
                      text: UB.i18n('Посада'),
                      flex: 1
                    }
                  },
                  {
                    name: 'employeeNumberID.depName',
                    columnConfig: {
                      text: UB.i18n('Підрозділ'),
                      flex: 1
                    }
                  },
                  { name: 'employeeNumberID' }
                ],
                customToolBarActions: [
                  {
                    xtype: 'button',
                    name: 'addBtn',
                    iconCls: 'fas fa-angle-double-down',
                    cls: 'fill-action',
                    scale: 'medium',
                    tooltip: UB.i18n('Додати списком'),
                    handler: function (btn) {
                      const me = btn.up('form')
                      me.setEmployeeNumbers(me)
                    }
                  }
                ]
              }
            ]
          },
          {
            xtype: 'panel',
            layout: { type: 'hbox', pack: 'end' },
            region: 'south',
            style: 'border-top: 1px solid #BFBFBF',
            items: [
              {
                xtype: 'button',
                text: UB.i18n('Коригувати'),
                width: 150,
                height: 30,
                margin: '10 10 10 0',
                cls: 'blue-action',
                handler: function () {
                  me.doCorrection()
                }
              }
            ]
          }
        ]
      }
    ]

    me.setEmployeeNumbers = function (me) {
      $App.doCommand({
        cmdType: 'showForm',
        formCode: 'hr_employeeNumberSearch',
        isModal: true,
        cmpInitConfig: {
          orgID: appAC.globalOrganization(),
          readOnlyAttr: ['periodID'],
          defaultValues: {
            periodID: me.currentPeriod.ID
          },
          onSelect: (data) => {
            const addEmployeeNumbers = []
            const store = me.attr.employeePositionList.getStore()
            const setData = () => {
              me.attr.employeePositionList.getStore().un('clear', setData)
              data.forEach(row => {
                if (!store.findRecord('employeeNumberID', row.employeeNumberID)) {
                  row['employeeNumberID.posName'] = row['posName']
                  row['employeeNumberID.depName'] = row['depName']
                  addEmployeeNumbers.push(row)
                }
              })
              if (addEmployeeNumbers.length) {
                me.attr.employeePositionList.getStore().insert(me.attr.employeePositionList.getStore().data.length, addEmployeeNumbers)
              }
            }
            if (me.attr.employeePositionList.getStore().count()) {
              $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n(`Видалити раніше внесені особові рахунки?`))
                .then(res => {
                  if (res) {
                    me.attr.employeePositionList.getStore().on('clear', setData)
                    me.attr.employeePositionList.removeAll()
                  } else {
                    setData()
                  }
                })
            } else {
              setData()
            }
          }
        }
      })
    }

    me.getActionValue = function () {
      return me.attr.action.getChecked() && me.attr.action.getChecked().length ? me.attr.action.getChecked()[0].inputValue : null
    }

    me.doCorrection = function () {
      const employeeNumberIDs = me.attr.employeePositionList.getStore().data.items.map(item => item.get('employeeNumberID'))
      if (!employeeNumberIDs.length) {
        $App.dialogInfo(UB.i18n('Не вибрано працівників'), UB.i18n('Увага'))
        return
      }
      const entityCode = me.attr.entity.getValue()
      const action = me.attr.action.getChecked()[0].inputValue
      const execParams = {
        orgID: appAC.globalOrganization(),
        dateFrom: me.attr.dateFrom.getValue(),
        dateTo: me.attr.dateTo.getValue(),
        orderNumber: me.attr.orderNumber.getValue(),
        orderDate: me.attr.orderDate.getValue(),
        action,
        employeeNumbers: employeeNumberIDs,
        params: {}
      }
      if (['createEmployeePosition', 'createEmployeeAccrual', 'createPayRetention'].includes(action) && !me.attr.dateFrom.getValue()) {
        $App.dialogInfo(UB.i18n('Не заповнена дата початку'), UB.i18n('Увага'))
        return
      }
      if (['createEmployeeAccrual', 'createPayRetention'].includes(action) && !me.attr.payElID.getValue()) {
        $App.dialogInfo(UB.i18n('Не заповнено вид оплати  '), UB.i18n('Увага'))
        return
      }
      switch (entityCode) {
        case 'employeePosition':
          if (me.attr.checkWorkPlace.getValue()) execParams.params.workPlace = me.attr.workPlace.getValue()
          if (me.attr.checkRaiseSalary.getValue()) execParams.params.raiseSalary = me.attr.raiseSalary.getValue()
          if (me.attr.checkWorkerType.getValue()) execParams.params.workerType = me.attr.workerType.getValue()
          if (me.attr.checkDateNew.getValue()) execParams.params.dateNew = me.attr.dateNew.getValue()
          if (me.attr.checkDictStaffCatID.getValue()) execParams.params.dictStaffCatID = me.attr.dictStaffCatID.getValue()
          if (me.attr.checkIsIndex.getValue()) execParams.params.isIndex = me.attr.isIndex.getValue()
          if (me.attr.checkDepartmentID.getValue()) execParams.params.departmentID = me.attr.departmentID.getValue()
          if (me.attr.checkPositionID.getValue()) execParams.params.positionID = me.attr.positionID.getValue()
          if (me.attr.checkDictPositionID.getValue()) execParams.params.dictPositionID = me.attr.dictPositionID.getValue()
          if (me.attr.checkDictCategoryECBID.getValue()) execParams.params.dictCategoryECBID = me.attr.dictCategoryECBID.getValue()
          if (me.attr.checkDictFundSourceID.getValue()) execParams.params.dictFundSourceID = me.attr.dictFundSourceID.getValue()
          if (me.attr.checkDictTarifCoeffID.getValue()) execParams.params.dictTarifCoeffID = me.attr.dictTarifCoeffID.getValue()
          if (me.attr.checkWorkScheduleID.getValue()) execParams.params.workScheduleID = me.attr.workScheduleID.getValue()
          if (me.attr.checkEmpPosPayElID.getValue()) execParams.params.payElID = me.attr.empPosPayElID.getValue()
          if (me.attr.checkAccountID.getValue()) execParams.params.accountID = me.attr.accountID.getValue()
          if (me.attr.checkAccrualSum.getValue()) execParams.params.accrualSum = me.attr.accrualSum.getValue()
          if (me.attr.checkMtCount.getValue()) execParams.params.mtCount = me.attr.mtCount.getValue()
          break
        case 'employeeAccrual':
          if (me.attr.checkPayElID.getValue()) execParams.params.payElID = me.attr.payElID.getValue()
          if (me.attr.checkDictFundSourceID.getValue()) execParams.params.dictFundSourceID = me.attr.dictFundSourceID.getValue()
          if (me.attr.checkAccountID.getValue()) execParams.params.accountID = me.attr.accountID.getValue()
          if (me.attr.checkAccrualSum.getValue()) execParams.params.accrualSum = me.attr.accrualSum.getValue()
          if (me.attr.checkAccrualRate.getValue()) execParams.params.accrualRate = me.attr.accrualRate.getValue()
          break
        case 'payRetention':
          if (me.attr.checkPayElID.getValue()) execParams.params.payElID = me.attr.payElID.getValue()
          if (me.attr.checkContractorID.getValue()) execParams.params.contractorID = me.attr.contractorID.getValue()
          if (me.attr.checkPaymentMethod.getValue()) execParams.params.paymentMethod = me.attr.paymentMethod.getValue()
          if (me.attr.checkBankAccount.getValue()) execParams.params.bankAccount = me.attr.bankAccount.getValue()
          if (me.attr.checkPayOutID.getValue()) execParams.params.payOutID = me.attr.payOutID.getValue()
          if (me.attr.checkAccrualSum.getValue()) execParams.params.baseSum = me.attr.accrualSum.getValue()
          if (me.attr.checkRate.getValue()) execParams.params.rate = me.attr.rate.getValue()
          break
        case 'payOutTemplate':
          execParams.params.payOutID = me.attr.payOutTemplateID.getValue()
          break
      }
      me.setLoading(true)
      $App.connection.run({
        entity: 'hr_employeeNumber',
        method: 'dataCorrection',
        execParams: execParams
      }).then((mParams) => {
        me.setLoading(false)
        const result = JSON.parse(mParams.result) || []
        if (result.length) {
          const errors = []
          result.forEach(o => {
            if (/<<<.*>>>/.test(o.message)) {
              o.message = o.message.match(/<<<(.*)>>>/)[1]
            }
            errors.push(`${o.description}: ${o.message}`)
          })
          $App.dialogError(UB.i18n('Не вдалося створити/оновити записи: <br/> {0}', errors.join('<br/>')))
        } else {
          $App.dialogInfo(UB.i18n('Завершено'))

          me.up('window') && me.up('window').close()
        }
      }, (err) => {
        $App.dialogError(err.message)
        me.setLoading(false)
      })
    }

    me.on('afterrender', async () => {
      const me = this
      AC.viewUtils.setAttr(me)
      me.attr.employeePositionList = me.down('[name=employeePositionList]')
      me.attr.entity.setValue('employeePosition')
      me.currentPeriod = await appHR.getCurrentPeriod(appAC.globalOrganization())

      AC.viewUtils.setWhereListProperty(me.attr.workScheduleID, [
        ['organizationID', '=', appAC.globalOrganization(), 'org'],
        ['organizationID', 'isNull', null, 'orgNull']
      ], ['(([org]) OR ([orgNull]))'], ['clearWhereList'])

      const entryDate = appAC.globalApplicationDate()
      me.attr.departmentID.store.ubRequest.__mip_ondate = entryDate
      delete me.attr.departmentID.store.ubRequest.__mip_recordhistory_all
      me.attr.positionID.store.ubRequest.__mip_ondate = entryDate
      delete me.attr.positionID.store.ubRequest.__mip_recordhistory_all
      delete me.attr.dictPositionID.store.ubRequest.__mip_recordhistory_all
      AC.viewUtils.setFilterValue(me.attr.departmentID, { orgID: appAC.globalOrganization() })

      appHR.getPayOutList(appAC.globalOrganization()).then(payOutList => {
        AC.viewUtils.setFilterValue(me.attr.payOutID, { ID: payOutList })
        AC.viewUtils.setFilterValue(me.attr.payOutTemplateID, { ID: payOutList })
      })

      AC.viewUtils.setWhereListProperty(me.attr.positionID, [
        [ 'orgID', '=', appAC.globalOrganization() ]
      ], null, [])

      HR.orderManager.showIf(me)
    }, me)

    me.callParent(arguments)
  }
})
