/* global Ext UB $App */

exports.formDef = 'HR.reportSelect'

Ext.define('HR.reportSelect', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  initComponent: function () {
    const me = this
    const queryDelay = 500
    let allGrid
    let selGrid
    const storeMain = Ext.create('Ext.data.Store', {
      groupField: 'groupCode',
      columnName: 'caption',
      fields: [
        { name: 'ID' },
        { name: 'code' },
        { name: 'groupCode' },
        { name: 'caption' }
      ],
      data: []
    })
    function setFilter () {
      storeMain.filter({
        id: 'searchTask',
        property: 'caption',
        condition: UB.core.UBCommand.condition.sqlecLike,
        value: searchCtrl.getValue(),
        anyMatch: true,
        caseSensitive: false
      })
    }
    function clearFilter () {
      storeMain.filters.removeAtKey('searchTask')
      storeMain.clearFilter()
    }
    const doQueryTask = new Ext.util.DelayedTask(function () {
      const value = searchCtrl.getValue()
      if (value === '') {
        clearFilter()
      } else {
        setFilter()
      }
    }, me)
    const searchCtrl = Ext.widget('textfield', {
      labelWidth: 60,
      fieldLabel: UB.i18n('filter')
    })
    searchCtrl.on('change', function () {
      doQueryTask.delay(queryDelay)
    })
    const storeSel = Ext.create('Ext.data.ArrayStore', {
      fields: [
        { name: 'ID' },
        { name: 'code' },
        { name: 'groupCode' },
        { name: 'caption' }
      ],
      data: []
    })
    me.items = [
      allGrid = Ext.create('Ext.grid.Panel', {
        xtype: 'grid',
        store: storeMain,
        features: [{
          id: 'group',
          ftype: 'grouping',
          groupHeaderTpl: ['<input class="grpCheckbox" {[values.rows[0].data.isGroupChecked ? "checked" : ""]} type="checkbox"> {[this.styleFunc(values)]}{[this.nameFunc(values)]}</span></font>', {
            styleFunc: function (values) {
              return values.rows.filter(row => (row.get('isChecked') !== '' && row.get('isChecked'))).length ? '<span  style="color: blue; ">' : '<span  style="color: black; ">'
            },
            nameFunc: function (values) {
              switch (values.groupValue) {
                case 'consolReports':
                  return UB.i18n('Консолідовані звіти')
                case 'accrualReportCalc':
                  return UB.i18n('Звіти для контроля розрахунку нарахувань/утримань')
                case 'control':
                  return UB.i18n('Списки для контролю')
                case 'dictionary':
                  return UB.i18n('Довідки')
                case 'employeeReportCalc':
                  return UB.i18n('Звіти розрахунку для працівника')
                default:
                  return UB.i18n('Інше')
              }
            }
          }],
          enableGroupingMenu: false,
          hideGroupHeader: true,
          startCollapsed: true
        }],
        viewConfig: {
          markDirty: false
        },
        listeners: {
          groupclick: function (grid, node, group, event, eOpts) {
            if (event && grid) {
              const store = allGrid.getStore()
              const storeSel = selGrid.getStore()
              Ext.suspendLayouts()
              allGrid.suspendEvents()
              store.suspendEvents()
              selGrid.suspendEvents()
              storeSel.suspendEvents()
              const target = event.getTarget('.grpCheckbox')
              const groupRecord = store.groups.getByKey(group)
              if (target && store && groupRecord) {
                const checked = target.checked
                allGrid.updatingRecords = true
                selGrid.updatingRecords = true
                groupRecord.records.forEach(function (rec) {
                  rec.beginEdit()
                  if (checked) {
                    if (!rec.get('isChecked')) {
                      rec.set('isChecked', checked)
                      storeSel.add(rec)
                    }
                  } else {
                    if (rec.get('isChecked')) {
                      rec.set('isChecked', checked)
                      const selRec = storeSel.findRecord('ID', rec.get('ID'))
                      if (selRec) {
                        storeSel.remove(selRec)
                      }
                    }
                  }
                  rec.set('isGroupChecked', checked)
                  rec.endEdit(true)
                })
                allGrid.updatingRecords = false
                selGrid.updatingRecords = false
                if (allGrid.view.features[0].isExpanded(group)) {
                  allGrid.view.features[0].collapse(group)
                } else {
                  allGrid.view.features[0].expand(group)
                }
              }
              allGrid.resumeEvents()
              store.resumeEvents()
              selGrid.resumeEvents()
              storeSel.resumeEvents()
              Ext.resumeLayouts(true)
              allGrid.getView().refreshView()
              selGrid.getView().refreshView()
            }
          },
          scope: me
        },
        autoScroll: true,
        flex: 1,
        split: true,
        region: 'west',
        title: UB.i18n('Всі звіти'),
        collapsible: true,
        columnLines: true,
        plugins: [Ext.create('Ext.grid.plugin.CellEditing', {
          clicksToEdit: 1
        })],
        tbar: Ext.create('Ext.toolbar.Toolbar', {
          height: 40,
          items: [
            {
              xtype: 'button',
              tooltip: UB.i18n('Відмітити всі'),
              iconCls: 'u-icon-check',
              cls: 'green-action',
              listeners: {
                click: function () {
                  const store = allGrid.getStore()
                  const storeSel = selGrid.getStore()
                  Ext.suspendLayouts()
                  allGrid.suspendEvents()
                  store.suspendEvents()
                  selGrid.suspendEvents()
                  storeSel.suspendEvents()

                  if (searchCtrl.getValue() !== '') {
                    clearFilter()
                  }
                  allGrid.updatingRecords = true
                  selGrid.updatingRecords = true

                  allGrid.getStore().each(rec => {
                    rec.beginEdit()
                    if (!rec.get('isChecked')) {
                      rec.set('isChecked', true)
                      storeSel.add(rec)
                    }
                    rec.endEdit(true)
                  })
                  allGrid.updatingRecords = false
                  selGrid.updatingRecords = false
                  store.groups.each(group => {
                    setGroupCheked(me, group.records[0].get('groupCode'))
                  })
                  allGrid.resumeEvents()
                  store.resumeEvents()
                  selGrid.resumeEvents()
                  storeSel.resumeEvents()
                  Ext.resumeLayouts(true)
                  selGrid.getView().refreshView()
                }
              }
            },
            {
              xtype: 'button',
              tooltip: UB.i18n('Виключити всі'),
              iconCls: 'u-icon-close',
              cls: 'red-action',
              listeners: {
                click: function () {
                  const store = allGrid.getStore()
                  const storeSel = selGrid.getStore()
                  Ext.suspendLayouts()
                  allGrid.suspendEvents()
                  store.suspendEvents()
                  selGrid.suspendEvents()
                  storeSel.suspendEvents()
                  if (searchCtrl.getValue() !== '') {
                    clearFilter()
                  }
                  allGrid.updatingRecords = true
                  selGrid.updatingRecords = true

                  allGrid.getStore().each(rec => {
                    rec.beginEdit()
                    rec.set('isChecked', false)
                    const selRec = storeSel.findRecord('ID', rec.get('ID'))
                    if (selRec) {
                      storeSel.remove(selRec)
                    }
                    rec.endEdit(true)
                  })
                  allGrid.updatingRecords = false
                  selGrid.updatingRecords = false
                  store.groups.each(group => {
                    setGroupCheked(me, group.records[0].get('groupCode'))
                  })
                  allGrid.resumeEvents()
                  store.resumeEvents()
                  selGrid.resumeEvents()
                  storeSel.resumeEvents()
                  Ext.resumeLayouts(true)
                  selGrid.getView().refreshView()
                }
              }
            },
            searchCtrl
          ]

        }),
        columns: [
          { xtype: 'checkcolumn', dataIndex: 'isChecked' },
          {
            header: UB.i18n('Звіти'),
            dataIndex: 'caption',
            flex: 1
          }
        ]
      }),
      selGrid = Ext.widget('grid', {
        xtype: 'grid',
        stripeRows: true,
        store: storeSel,
        autoScroll: true,
        region: 'center',
        flex: 1,
        title: UB.i18n('Вибрані звіти'),
        columns: [{
          header: UB.i18n('Вибрані звіти'),
          dataIndex: 'caption',
          flex: 1
        }],
        tbar: Ext.create('Ext.toolbar.Toolbar', { height: 40 }),

        listeners: {
          itemdblclick: function (row, record) {
            if (searchCtrl.getValue() !== '') {
              clearFilter()
            }
            storeSel.remove(record)
            const rec = storeMain.findRecord('ID', record.get('ID'))
            rec.set('isChecked', false)
            if (searchCtrl.getValue() !== '') {
              setFilter()
            }
          }
        }
      })
    ]
    me.tbar = [
      {
        xtype: 'button',
        scale: 'medium',
        iconCls: 'u-icon-save-and-close',
        tooltip: UB.i18n('saveAndClose'),
        cls: 'save-action',
        handler: function () {
          const codes = []
          storeSel.data.each(record => {
            codes.push(record.get('code'))
          })
          $App.connection.run({
            entity: 'ac_repFavorites',
            method: 'saveSelection',
            userID: $App.connection.userData().userID,
            codes: JSON.stringify(codes),
            reportsType: 1
          }).then(() => {
            if (me.sender && me.sender.showDesktop) me.sender.showDesktop()
            const wnd = me.up('window')
            wnd.close()
          })
        }
      }
    ]
    me.bbar = [
      '->'
    ]
    me.allGrid = allGrid
    me.selGrid = selGrid
    me.on('afterrender', function () {
      loadData(me, storeMain)
    })
    me.callParent(arguments)
  }
})

function loadData (me, store) {
  store.un('update', me.onStoreUpdate)
  // Консолідовані звіти
  let consolReportsList = ['accSalary_reportConsolAccDeduc', 'accSalary_accrualReportPaySummary', 'accSalary_accrualReportIncTax',
    'accSalary_accrualReportConsolCateg', 'accSalary_accrualReportN7', 'accSalary_memorialOrder5', 'accSalary_memorialOrder5PayEl',
    'accSalary_accrualReportCalcFunds', 'accSalary_posGroup', 'accSalary_accrualReportFOP', 'accSalary_accrualReportIndividualEmpContract',
    'accSalary_annexMemorialOrder', 'accSalary_payrollEducation', 'accSalary_summaryActualCosts', 'accSalary_accrualReportGeneralRegistry', 'accSalary_accrualReportGroupReport',
    'accSalary_accrualReport1NC', 'accSalary_accrualReportCostItems'
  ]
  // Звіти для контроля розрахунку нарахувань/утримань
  let accrualReportCalcList = ['saSalary_reportDeducMilitaryTax', 'saSalary_reportDeducTax', 'saSalary_accrualReportUnionPay', 'saSalary_accrualReportMinWage',
    'saSalary_accrualReportVacation', 'accSalary_accrualReportSickRegister', 'saSalary_accrualReportPaySickness', 'saSalary_accrualReportAliment', 'saSalary_accrualReportBonus',
    'accSalary_accrualReportControlCalcVacReserve', 'saSalary_reportControlCalcESV', 'saSalary_consolidatedStatementDeductions',
    'saSalary_consolidatedStatementDictProgClass', 'saSalary_consolidatedStatementDepartment']
  // Списки для контролю
  let controlList = ['saSalary_reportListDebtEmployees', 'saSalary_reportListlistEmployees', 'saSalary_empListSickLimit', 'saSalary_empListTaxLimit', 'saSalary_reportAddCostsECB',
    'saSalary_reportGreaterMaxECB', 'saSalary_reportAccrualReleased', 'accSalary_accrualReportTimeCost', 'accSalary_accrualReportByLongVacation']
  // Довідки
  let dictionaryList = ['hr_accrualReportAvgSalaryFSS', 'hr_accrualReportIncomeTax', 'hr_accrualReportIncome', 'hr_accrualReportCredit',
    'hr_accrualReportEmbassyPayroll', 'hr_accrualReportRequirePayroll', 'hr_accrualReportPayIndexSalary', 'hr_accrualReportAvgSalary13', 'hr_accrualReportAvgSalaryMain']
  // Звіти розрахунку для працівника
  let employeeReportCalcList = ['saSalary_reportInfoCard', 'saSalary_reportRL', 'saSalary_reportRLMonth', 'accSalary_accrualReportN6', 'saSalary_reportRLEmail', 'saSalary_reportRLMonthEdu']
  const favorites = UB.Repository('ac_repFavorites')
    .attrs(['reportCode'])
    .where('userID', '=', $App.connection.userData().userID)
    .where('reportsType', '=', 1)
    .selectAsArrayOfValues()
  let reports = UB.Repository('ubm_navshortcut')
    .attrs(['ID', 'code', 'caption'])
    .where('parentID.code', '=', 'hr_allReportSalaryCfg')
    .orderBy('caption')
    .selectAsObject()
  Promise.all([reports, favorites]).then(([result, favorites]) => {
    result.forEach(row => {
      if (consolReportsList.includes(row.code)) {
        row.groupCode = 'consolReports'
      } else if (accrualReportCalcList.includes(row.code)) {
        row.groupCode = 'accrualReportCalc'
      } else if (controlList.includes(row.code)) {
        row.groupCode = 'control'
      } else if (dictionaryList.includes(row.code)) {
        row.groupCode = 'dictionary'
      } else if (employeeReportCalcList.includes(row.code)) {
        row.groupCode = 'employeeReportCalc'
      } else {
        row.groupCode = 'elseReports'
      }
    })
    store.loadData(result)
    if (favorites && favorites.length) {
      const allRecord = store.snapshot || store.data
      const storeSel = me.selGrid.getStore()
      allRecord.items.forEach((row, idx) => {
        if (favorites.includes(row.get('code'))) {
          row.set('isChecked', true)
          storeSel.add(row)
        }
      })
    }
    store.on('update', onStoreUpdate, me)

    store.groups.each(group => {
      setGroupCheked(me, group.records[0].get('groupCode'))
    })
    me.setLoading(false)
  })
}

function onStoreUpdate (store, record) {
  const me = this
  const storeSel = me.selGrid.getStore()
  if (record.get('isChecked')) {
    storeSel.add(record)
  } else {
    const rec = storeSel.findRecord('ID', record.get('ID'))
    if (rec) {
      storeSel.remove(rec)
    }
  }
  setGroupCheked(me, record.get('groupCode'))
}

function setGroupCheked (me, groupName) {
  let isGroupChecked = true
  const store = me.allGrid.getStore()
  const groupRecord = store.groups.getByKey(groupName)
  groupRecord.records.forEach(rec => {
    if (!rec.get('isChecked')) {
      isGroupChecked = false
    }
  })
  me.allGrid.updatingRecords = true

  groupRecord.records.forEach(function (rec) {
    rec.beginEdit()
    rec.set('isGroupChecked', isGroupChecked)
    rec.endEdit(true)
  })
  me.allGrid.updatingRecords = false
  me.allGrid.getView().refreshView()
}
