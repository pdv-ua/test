        },
        {
          xtype: 'acGrid',
          name: 'vacationDt',
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_docRegVacation_vacationDt'),
          title: UB.i18n('Використання відпустки'),
          region: 'center',
          flex: 1,
          autoScroll: true,
          rowEditing: true,
          notWriteChanges: true,
          storeType: 'local',
          showToolBar: true,
          disablePaging: true,
          loadMaskMessage: UB.i18n('Завантаження даних...'),
          hideActions: ['addNewByCurrent'],
          customToolBarActions: [
            {
              xtype: 'button',
              name: 'fillBtn',
              tooltip: UB.i18n('Заповнити'),
              iconCls: 'fas fa-angle-double-down',
              cls: 'fill-action',
              handler: function (btn) {
                const me = btn.up('form')
                if (me.attr.vacationDt.getStore().count()) {
                  $App.dialogYesNo('Попередження', UB.i18n('Раніше додані записи будуть видалені. Продовжити?'))
                    .then(res => {
                      if (res) {
                        me.attr.vacationDt.removeAll()
                        me.setIsDirty(true)
                        me.saveForm().then(() => {
                          me.addVacationPeriods()
                        })
                      }
                    })
                } else {
                  me.addVacationPeriods()
                }
              }
            },
            {
              xtype: 'button',
              name: 'clearBtn',
              tooltip: UB.i18n('Очистити'),
              iconCls: 'fas fa-eraser',
              cls: 'fill-action',
              handler: function (btn) {
                const me = btn.up('form')
                if (me.attr.vacationDt.getStore().count()) {
                  $App.dialogYesNo('Попередження', UB.i18n('Раніше додані записи будуть видалені. Продовжити?'))
                    .then(function (res) {
                      if (res) {
                        me.attr.vacationDt.removeAll()
                        me.setIsDirty(true)
                        if (!me.isNewInstance) {
                          return me.saveForm()
                        }
                      }
                    })
                }
              }
            }
          ],
          fields: [
            { name: 'ID' },
            { name: 'mi_modifyDate' },
            { name: 'orderID' },
            { name: 'dictVacationKindID' },
            { name: 'empVacationPeriodID' },
            {
              name: 'dictVacationKindID.name',
              columnConfig: {
                text: UB.i18n('Вид відпустки'),
                sortable: false,
                flex: 1,
                editor: {
                  dataType: 'Entity',
                  hideEntityItemInContext: true,
                  associatedEntity: 'hr_dictVacationKind',
                  allowBlank: false,
                  disableClearSelection: true,
                  disableContextMenu: true,
                  storeAttributeValueField: 'dictVacationKindID',
                  fieldList: ['ID', 'name'],
                  whereList: {
                    payElID: {
                      expression: '[payElID]',
                      condition: 'equal',
                      value: '0'
                    }
                  }
                }
              }
            },
            {
              name: 'empVacationPeriodID.descriptionEx',
              columnConfig: {
                text: UB.i18n('За період роботи'),
                sortable: false,
                flex: 1,
                editor: {
                  dataType: 'Entity',
                  hideEntityItemInContext: true,
                  associatedEntity: 'hr_empVacationPeriod',
                  allowBlank: false,
                  disableClearSelection: true,
                  disableContextMenu: true,
                  storeAttributeValueField: 'empVacationPeriodID',
                  fieldList: ['ID', 'descriptionEx', 'dayDiff']
                }
              }
            },
            {
              name: 'dateFrom',
              columnConfig: {
                text: UB.i18n('З'),
                width: 150,
                dateFormat: 'd.m.Y',
                dataType: 'Date',
                editor: {
                  dataType: 'Date',
                  allowBlank: false
                }
              }
            },
            {
              name: 'dateTo',
              columnConfig: {
                text: UB.i18n('По'),
                width: 150,
                dateFormat: 'd.m.Y',
                dataType: 'Date',
                editor: {
                  dataType: 'Date',
                  allowBlank: false
                }
              }
            },
            {
              name: 'dayDiff',
              columnConfig: {
                text: UB.i18n('Невикористані дні'),
                sortable: false,
                width: 150,
                dataType: 'Int'
              }
            },
            {
              name: 'dayCount',
              columnConfig: {
                text: UB.i18n('Кількість днів за поточним документом'),
                sortable: false,
                width: 150,
                dataType: 'Int',
                editor: {
                  dataType: 'Int',
                  allowBlank: false
                }
              }
            }
          ],
          summary: { dayCount: 'sum' },
          summaryDataOnClient: true,
          getRowClass: function (record, rowIndex, rowParams, store) {
            return record.get('dayDiff') < record.get('dayCount') ? 'grd-color-red' : ''
          },
          onValidateEdit: function (editor, context) {
            const vacationFrom = AC.dateService.truncTimeToUtcNull(editor.editor.up('form').attr.dateFrom.getValue())
            const vacationTo = AC.dateService.truncTimeToUtcNull(editor.editor.up('form').attr.dateTo.getValue())
            const newPeriodFrom = AC.dateService.truncTimeToUtcNull(editor.editor.form.findField('dateFrom').getValue())
            const newPeriodTo = AC.dateService.truncTimeToUtcNull(editor.editor.form.findField('dateTo').getValue())
            if (newPeriodFrom < vacationFrom) {
              const errorMessage = UB.i18n('Не може бути менше ніж "дата початку"')
              editor.editor.form.findField('dateFrom').markInvalid(errorMessage)
              AC.viewUtils.showToast('Помилка', errorMessage)
              return false
            }
            if (newPeriodTo > vacationTo) {
              const errorMessage = UB.i18n('Не може бути більше ніж "дата закінчення"')
              editor.editor.form.findField('dateTo').markInvalid(errorMessage)
              AC.viewUtils.showToast('Помилка', errorMessage)
              return false
            }
            const store = context.grid.getStore()
            if (store.getCount() > 0) {
              let hasError = false
              store.each(record => {
                if (context.record.internalId === record.internalId) return
                const recordDateFrom = AC.dateService.truncTimeToUtcNull(record.get('dateFrom'))
                const recordDateTo = AC.dateService.truncTimeToUtcNull(record.get('dateTo'))
                if (!(newPeriodTo < recordDateFrom || newPeriodFrom > recordDateTo)) {
                  hasError = true
                }
              })
              if (hasError) {
                const errorMessage = UB.i18n(`Періоди перетинаються. Виправіть перед збереженням`)
                $App.dialogError(errorMessage)
                return false
              }
            }
            return true
          },
          edit: (control, context) => {
            const me = context.grid.up('form')
            me.setIsDirty(true)
            let dayCount = context.grid.getData().reduce((result, item) => result + item['dayCount'], 0)
            if (me.attr.dayCount.getValue() !== dayCount) {
              me.attr.dayCount.setValue(dayCount)
              me.attr.dayCount.calcValue = null
              me.calcVacation(me, true, false, me.attr.dayCount.name, false)
            }
          },
          onBeforeEdit: function (rowEditor, context) {
            const editor = rowEditor.editor
            const me = editor.up('form')
            const reco = context.record
            const dateFromCtrl = editor.query(`[name=dateFrom]`)[0]
            const dateToCtrl = editor.query(`[name=dateTo]`)[0]
            const dictVacationKindIDCtrl = editor.query(`[name=dictVacationKindID.name]`)[0]
            const empVacationPeriodIDCtrl = editor.query(`[name=empVacationPeriodID.descriptionEx]`)[0]
            const vacKindStore = dictVacationKindIDCtrl.getStore()
            vacKindStore.isInternalChange = true
            const vacPeriodStore = empVacationPeriodIDCtrl.getStore()
            vacPeriodStore.isInternalChange = true
            if (reco.phantom && !reco.get('orderID')) {
              reco.set('orderID', me.instanceID)
              const dateFrom = context.grid.getStore().count() > 1 ? AC.dateService.addDays(Math.max(...context.grid.getData().map(o => o.dateTo)), 1) : me.attr.dateFrom.getValue()
              reco.set('dateFrom', dateFrom)
              reco.set('dateTo', me.attr.dateTo.getValue())
            }
            AC.viewUtils.setWhereListProperty(dictVacationKindIDCtrl, [
              ['payElID', '=', me.attr.payElID.getValue()]
            ], undefined, ['clearWhereList', 'clearStore'])
            const store = dictVacationKindIDCtrl.getStore()
            store.ubRequest.whereList.hasDayDiff = {
              expression: '',
              condition: 'subquery',
              subQueryType: 'exists',
              value: {
                entity: 'hr_empVacationPeriod',
                fieldList: [],
                method: 'select',
                whereList: {
                  cond: {
                    expression: '[empVacationPlanID.dictVacationKindID]=[{master}.ID]',
                    condition: 'custom'
                  },
                  employeeNumberID: {
                    condition: '=',
                    expression: '[empVacationPlanID.employeeNumberID]',
                    value: me.record.get('employeeNumberID')
                  },
                  dayDiff: {
                    condition: '>',
                    expression: '[dayDiff]',
                    value: 0
                  },
                  mi_deleteDate: {
                    condition: '>=',
                    expression: '[empVacationPlanID.mi_deleteDate]',
                    value: '#maxdate'
                  }
                }
              }
            }

            dateFromCtrl.on('change', (ctrl, value) => {
              if (value && dateToCtrl.getValue() < value) {
                dateToCtrl.setValue(value)
              }
              me.recalcVacPeriodDays(editor, context.record)
            })
            dateToCtrl.on('change', (ctrl, value) => {
              if (value && dateFromCtrl.getValue() > value) {
                dateFromCtrl.setValue(value)
              }
              me.recalcVacPeriodDays(editor, context.record)
            })

            let vacPeriodFilter = [
              ['empVacationPlanID.employeeNumberID', '=', me.record.get('employeeNumberID')],
              ['empVacationPlanID.dictVacationKindID', '=', reco.get('dictVacationKindID') || 0],
              ['dayDiff', '>', 0],
              ['empVacationPlanID.mi_deleteDate', '>=', '#maxdate']
            ]
            if (context.grid.getStore().count()) {
              const usedVacPeriods = []
              context.grid.getStore().each(row => {
                if (reco.internalId === row.internalId) return
                usedVacPeriods.push(row.get('empVacationPeriodID'))
              })
              vacPeriodFilter.push([
                'ID', 'notIn', usedVacPeriods.filter(Boolean).concat([0])
              ])
            }
            AC.viewUtils.setWhereListProperty(empVacationPeriodIDCtrl, vacPeriodFilter)

            empVacationPeriodIDCtrl.on('change', ctrl => {
              reco.set('dayDiff', ctrl.getFieldValue('dayDiff'))
            })

            dictVacationKindIDCtrl.on('change', ctrl => {
              if (vacKindStore.isInternalChange) {
                vacKindStore.isInternalChange = false
                return
              }
              const vacPeriodStore = empVacationPeriodIDCtrl.getStore()
              vacPeriodStore.isInternalChange = true
              let vacPeriodFilter = [
                ['empVacationPlanID.employeeNumberID', '=', me.record.get('employeeNumberID')],
                ['empVacationPlanID.dictVacationKindID', '=', ctrl.getFieldValue('ID')],
                ['dayDiff', '>', 0],
                ['empVacationPlanID.mi_deleteDate', '>=', '#maxdate']
              ]
              if (context.grid.getStore().count()) {
                const usedVacPeriods = []
                context.grid.getStore().each(row => {
                  if (reco.internalId === row.internalId) return
                  usedVacPeriods.push(row.get('empVacationPeriodID'))
                })
                vacPeriodFilter.push([
                  'ID', 'notIn', usedVacPeriods.filter(Boolean).concat([0])
                ])
              }
              AC.viewUtils.setWhereListProperty(empVacationPeriodIDCtrl, vacPeriodFilter,
                undefined, ['clearWhereList', 'clearStore', 'clearValue'])
              me.recalcVacPeriodDays(editor, context.record)
            })
          }
        },
        {
          title: UB.i18n('Додаткові параметри'),
          autoScroll: true,
          layout: { type: 'vbox', align: 'stretch' },
          flex: 1,
          items: [
            {
              attributeName: 'dictFundSourceID',
              hideEntityItemInContext: true
            }
          ]
        },
        {
          title: UB.i18n('Додатки'),
          autoScroll: true,
          layout: { type: 'vbox', align: 'stretch' },
          flex: 1,
          items: [
            {
              xtype: 'docAttachment',
              entity: 'hr_orderAttachment',
              detailFields: 'documentID',
              masterFields: 'ID',
              showOriginal: true,
              minHeight: 55,
              maxHeight: 140,
              height: 95
            }
          ]
        }
      ]
    }
  ]
}
