                  notWriteChanges: true,
                  storeType: 'local',
                  showToolBar: false,
                  disablePaging: true,
                  loadMaskMessage: UB.i18n('Завантаження даних...'),
                  baseSummary: true,
                  summary: {
                    opSum: (records, dataIndex) => {
                      return records.reduce((sum, row) => {
                        return sum + (row.get(dataIndex) ? (row.get(dataIndex) || 0) : 0)
                      }, 0)
                    },
                    opDays: (records, dataIndex) => {
                      return records.reduce((sum, row) => {
                        return sum + (row.get(dataIndex) ? (row.get(dataIndex) || 0) : 0)
                      }, 0)
                    },
                    baseSum: (records, dataIndex) => {
