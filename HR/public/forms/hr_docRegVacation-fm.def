                        sortable: false,
                        align: 'right',
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 6) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          return value
                        },
                        editor: {
                          dataType: 'Currency',
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 6
                        }
                      }
                    },
                    {
                      name: 'baseSum',
                      columnConfig: {
                        text: UB.i18n('Заробіток'),
                        width: 120,
                        align: 'right',
                        sortable: false,
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          if (_.isNumber(value)) {
                            return Ext.util.Format.currency(value, '', 2).replace(/ /g, '')
                          } else return value
                        },
                        editor: {
                          dataType: 'Currency',
                          sortable: false,
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 0
                        }
                      }
                    },
                    {
                      name: 'opKoef',
                      columnConfig: {
                        text: UB.i18n('Коеф. індексації'),
                        hidden: true,
                        flex: 1,
                        align: 'right',
                        sortable: false,
                        floatFormat: 6,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 12) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          if (_.isNumber(value)) {
                            return Ext.util.Format.currency(value, '', 6).replace(/ /g, '')
                          } else return value
                        },
                        editor: {
                          dataType: 'Float',
                          decimalPrecision: 6,
                          minValue: 0,
                          flagsFix: 1 << 12
                        }
                      }
                    },
                    {
