/* global Ext UB $App _ */
exports.formDef = 'HR.dictListTarification'

Ext.define('HR.dictListTarification', {
  extend: 'Ext.Panel',
  layout: { type: 'vbox', align: 'stretch' },
  HR_PAY_DICTIONARY_CODE: 'hrPayDictionary',
  HR_PAY_SETTING_CODE: 'hrPaySettings',
  initComponent: function () {
    const me = this
    me.reportControl = Ext.create('Ext.Component', {
      flex: 1,
      autoEl: { tag: 'iframe' }
    })
    me.items = me.reportControl
    me.on('afterrender', () => me.showDesktop())
    me.callParent(arguments)
  },
  showDesktop: async function () {
    const me = this
    const iFrameDoc = me.reportControl.getEl().dom.contentDocument
    let shTemplate = ''
    let por = 0
    const shortcutData = await me.prepareShortcut()
    while (shortcutData[por]) { // Blocks
      for (let r = 0, l = _.max([shortcutData[por].length, (shortcutData[por + 1] || []).length]); r < l; r++) { // Rows
        shTemplate += '<tr>'
        for (let i = 0; i <= 1; i++) { // Columns
          const row = (shortcutData[por + i] || [])[r] || { ID: '', isHeader: false, caption: '' }
          shTemplate += `
            <td style="
              width:50%;
              height:24px;
              font-size:${row.isHeader ? 16 : 14}px;
              padding-left: 30px;
            ">
              ${row.isHeader ? '<b><span ' : '<a href="#"'}
                data-id=${row.ID}>${row.caption}
              ${row.isHeader ? '</span></b>' : '</a>'}
            </td>`
        }
        shTemplate += '</tr>'
      }
      por += 2
    }

    iFrameDoc.head.innerHTML = `
      <style type="text/css">
        body {
          background-color: #FFFFFF;
          color: #000000;
          font-family: Roboto, Arial, Helvetica, sans-serif;
          font-size: 14px;
          line-height: 1.3;
        }
        a {
          text-decoration: none;
          color: #2f7c94;
        }
        td,th {
          font-family: Roboto,Arial,Helvetica,sans-serif;
          font-size: 14px
        }
      </style>`
    iFrameDoc.body.innerHTML = `
      <table
        style="
          border-collapse: collapse;
          width: 730px;
          word-break: break-all;
        "
        border="0px"
        cellspacing="0"
        cellpadding="3px"
      >
        <tbody>
          ${shTemplate}
        </tbody>
      </table>`

    const refs = iFrameDoc.getElementsByTagName('a')
    for (let i = 0, L = refs.length; i < L; i++) {
      refs[i].addEventListener('click', me.onReportClick, true)
    }
  },
  prepareShortcut: async function () {
    const titleCodes = [this.HR_PAY_DICTIONARY_CODE, this.HR_PAY_SETTING_CODE]
    const lookupCodes = [
      'trf_dictAccrual',
      'hr_dictSalaryRank',
      'trf_tariffSheet',
      'hr_dictTarifCoeff'
    ]
    const settingsCodes = [
      'ac_fundSource',
      'hr_dictStaffCat',
      'trf_dictPupil',
      'trf_dictQualification',
      'hr_dictEducationLevel',
      'hr_dictStaffSubCat',
      'hr_departmentSalary',
      'hr_dictPosition',
      'trf_dictPositionProps',
      'trf_dictSubject',
      'trf_dictEducationRank',
      'trf_workNorm',
      'trf_dictPart'
    ]

    const allDictCode = 'accPay_AllDict'
    const titles = this.getShortcuts(titleCodes)
    const lookups = this.getShortcuts(lookupCodes)
    const allDicts = this.getShortcuts([allDictCode])
    const settings = this.getShortcuts(settingsCodes)
    const result = []
    for (let i = 0; i < titleCodes.length; i++) {
      const shortcuts = []
      const id = titles[i].get('ID')
      const caption = titles[i].get('caption')
      const titleShortcut = this.getShortcut(id, caption, true)
      const separator = this.getShortcut('', '', true)
      shortcuts.push(titleShortcut)
      shortcuts.push(separator)
      if (titleCodes[i] === this.HR_PAY_DICTIONARY_CODE) {
        this.fillShortcut(shortcuts, lookups)
        const hrShortcut = this.getShortcut('', '<hr  align="left" width="300" size="2">', true)
        shortcuts.push(hrShortcut)
        const allDictShortcut = this.getShortcut(allDicts[0].get('ID'), allDicts[0].get('caption'), false)
        shortcuts.push(allDictShortcut)
      }
      if (titleCodes[i] === this.HR_PAY_SETTING_CODE) {
        this.fillShortcut(shortcuts, settings)
      }
      result.push(shortcuts)
    }
    return result
  },
  fillShortcut: function (shortcuts, items) {
    items.forEach((item) => {
      const id = item.get('ID')
      let caption = ''
      switch (item.get('caption')) {
        case UB.i18n('Джерело фінансування (бюджет)'): caption = UB.i18n('Джерела фінансування')
          break
        case UB.i18n('Надбавки і доплати тарифікації'): caption = UB.i18n('Надбавки і доплати')
          break
        case UB.i18n('Рівні освіти'): caption = UB.i18n('Освіта')
          break
        case UB.i18n('Підрозділи (персонал)'): caption = UB.i18n('Підрозділи')
          break
        case UB.i18n('Довідник посад'): caption = UB.i18n('Посади')
          break
        case UB.i18n('Предмети (дисципліни)'): caption = UB.i18n('Предмети')
          break
        default: caption = item.get('caption')
      }
      shortcuts.push(this.getShortcut(id, caption, false))
    })
  },
  getShortcut: function (id, caption, isHeader) {
    return {
      ID: id,
      caption: caption,
      isHeader: isHeader
    }
  },
  getShortcuts: function (codes) {
    function getCaption (item) {
      let caption = ''
      switch (item.get('caption')) {
        case UB.i18n('Джерела фінансування (зарплата)'): caption = UB.i18n('Джерела фінансування')
          break
        case UB.i18n('Рівні освіти'): caption = UB.i18n('Освіта')
          break
        case UB.i18n('Підрозділи (персонал)'): caption = UB.i18n('Підрозділи')
          break
        case UB.i18n('Довідник посад'): caption = UB.i18n('Посади')
          break
        case UB.i18n('Предмети (дисципліни)'): caption = UB.i18n('Предмети')
          break
        default: caption = item.get('caption')
      }
      return caption
    }
    const shortcuts = UB.core.UBStoreManager.getNavigationShortcutStore().data.items
      .filter(x => codes.indexOf(x.get('code')) !== -1).map((o) => {
        o.set('caption', getCaption(o))
        return o
      })
    shortcuts.sort((a, b) => { return a.get('caption').localeCompare(b.get('caption')) })
    return shortcuts
  },
  onReportClick: function (e) {
    e.preventDefault()
    if (e.target.dataset.id && e.target.dataset.id !== '') {
      const store = UB.core.UBStoreManager.getNavigationShortcutStore()
      const shortcut = _.find(store.data.items, item => { return item.get('ID') === Number(e.target.dataset.id) })
      $App.runShortcutCommand(shortcut.get('code'), shortcut.get('inWindow'))
    }
  }
})
