exports.formDef = {
  size: {
    width: 1100,
    height: 600
  },
  items: [
    {
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        { attributeName: 'code' },
        { attributeName: 'illnessKind' },
        { attributeName: 'name' },
        { attributeName: 'fullName' },
        {
          attributeName: 'payElFOPID',
