            isIllness: {
              expression: '[methodID.methodGroupID.code]',
              condition: 'equal',
              values: {
                val: '5'
              }
            }
          }
        },
        {
          attributeName: 'maxDayFOP',
          xtype: 'numberfield',
          vtype: 'numberValidator',
          maxValue: 36000,
          minValue: 0
        },
        {
          attributeName: 'payElFSSUID',
          allowBlank: false,
          whereList: {
            isIllness: {
              expression: '[methodID.methodGroupID.code]',
              condition: 'equal',
              values: {
                val: '5'
              }
            }
          }
        },
        {
          attributeName: 'payElUnpaidID',
          allowBlank: true,
          whereList: {
            isIllness: {
              expression: '[methodID.methodGroupID.code]',
              condition: 'equal',
              values: {
                val: '5'
              }
            }
          }
        },
        {
          attributeName: 'orderN',
          xtype: 'numberfield',
          vtype: 'numberValidator',
          maxValue: 1000,
          minValue: 0
