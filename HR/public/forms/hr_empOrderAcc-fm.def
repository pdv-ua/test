exports.formDef = (function () {
  return {
    requiredFields: ['empOrderDetID', 'empOrderID'],
    parentConfig: {
      layout: {
        type: 'vbox',
        align: 'stretch'
      }
    },
    defaults: {
      layout: 'fit'
    },
    size: {
      width: 1100,
      height: 600
    },
    items: [
      { attributeName: 'payElID',
        fieldList: ['ID', 'description', 'methodID.methodGroupID.groupType'],
        orderList: { orderBy: { expression: 'codeSort' } } }, // Вид нарахування (Вид нарахування),
      { attributeName: 'dateFrom' }, // Дата початку дії (Дата початку дії),
      { attributeName: 'dateToEmpty' }, // Дата закінчення дії (Дата закінчення дії),
      { attributeName: 'accrualSum' }, // Сума (Сума),
      { attributeName: 'accrualRate' } // Відсоток (Відсотока),
    ]
  }
})()
