/* global UB AC Ext appAC appHR $App Blob */
exports.formDef = 'HR.accrualReportPosGroup'

Ext.define('HR.accrualReportPosGroup', {
  extend: 'Ext.form.Panel',
  requires: [
    'UBS.UBReport',
    'UB.ux.PDFComponent'
  ],
  layout: { type: 'vbox', align: 'stretch' },
  width: 1100,
  height: 600,
  items: [{}],

  initComponent: function () {
    const me = this
    me.posGroupID = me.instanceID
    me.listParamTabs = {
      posPosition: { ID: null, code: null },
      payElPosition: { ID: null, code: null }
    }

    me.record = {}
    me.attr = {}
    me.requiredAttr = []
    let container
    let control
    let tabs = []
    const reportCode = me.reportCode
    const onCalcFunc = () => {}

    const validateFields = function () {
      let isValid = true

      me.requiredAttr.forEach(field => {
        isValid = isValid && field.validate()
      })
      return isValid
    }
    function getListParamTabs (currTabs, tabParamListToAdd) {
      tabParamListToAdd.forEach(({ tabName, formCode, fieldList, title, formListCode, enableOrderN }) => {
        currTabs.push({
          itemId: tabName,
          title: title,
          autoScroll: true,
          flex: 1,
          margin: '5, 0, 0, 0',
          layout: {
            type: 'vbox',
            align: 'stretch'
          },
          items: [
            {
              xtype: 'entitygridpanel',
              cmdType: 'showList',
              hideActions: ['showPreview', 'itemLink', 'commandLink', 'addNewByCurrent', 'detail', 'edit', formListCode ? 'addNew' : ''],
              name: tabName,
              autoScroll: true,
              flex: 1,
              rowEditing: true,
              entityConfig: {
                entity: 'hr_idParam',
                method: 'select',
                fieldList,
                whereList: {
                  byTab: {
                    expression: '[listParamID.code]',
                    condition: 'isNull'
                  }
                }
              },
              onAddNew: function () {
                const grid = this
                if (!me.posGroupID) {
                  $App.dialogInfo(UB.i18n('Необхідно спочатку зберегти дані'))
                  return
                }

                $App.doCommand({
                  cmdType: 'showForm',
                  formCode: formCode,
                  entity: 'hr_idParam',
                  initialFieldValues: {
                    listParamID: me.listParamTabs[tabName].ID,
                    orgID: appAC.globalOrganization()
                  },
                  store: grid.getStore()
                }
                )
              },
              onItemDblClick: function (grid, record) {
                if (!formListCode) {
                  const sender = this
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: formCode,
                    entity: 'hr_idParam',
                    instanceID: record.get('ID'),
                    initialFieldValues: {
                      listParamID: me.listParamTabs[tabName].ID,
                      orgID: appAC.globalOrganization()
                    },
                    store: grid.getStore(),
                    sender: sender
                  })
                }
              },
              afterInit: function () {
                const grid = this
                if (me.posGroupID) {
                  if (!me.listParamTabs[tabName].code) {
                    const listParamsCodesNames = [`posPosition${me.posGroupID}`, `payElPosition${me.posGroupID}`]
                    UB.Repository('hr_listParam')
                      .attrs('ID', 'code')
                      .where('code', 'in', listParamsCodesNames)
                      .selectAsObject().then(result => {
                        result.forEach(resItem => {
                          for (const prop in me.listParamTabs) {
                            if (resItem.code.includes(prop)) {
                              me.listParamTabs[prop] = { ID: resItem.ID, code: resItem.code }
                            }
                          }
                        })
                        grid.store.ubRequest.whereList.byTab = {
                          expression: '[listParamID.code]',
                          condition: 'equal',
                          values: { 'code': me.listParamTabs[tabName].code }
                        }
                      })
                  }
                }
              },
              customActions: [
                {
                  itemId: 'addList',
                  text: UB.i18n('Додати списком'),
                  actionId: 'addByList',
                  iconCls: 'u-icon-edit-alt',
                  scale: 'medium',
                  cls: 'fill-action',
                  hidden: !formListCode,
                  handler: function (btn) {
                    if (!me.posGroupID) {
                      $App.dialogInfo(UB.i18n('Необхідно спочатку зберегти дані'))
                      return
                    }
                    UB.Repository('hr_idParam')
                      .where('[listParamID]', '=', me.listParamTabs[tabName].ID)
                      .where('[orgID]', '=', appAC.globalOrganization())
                      .attrs(['ID', 'valuesID'])
                      .selectAsObject()
                      .then(result => {
                        const grid = btn.up('entitygridpanel')
                        $App.doCommand({
                          cmdType: 'showForm',
                          formCode: formListCode,
                          entity: 'hr_idParam',
                          cmpInitConfig: {
                            selectData: result.map(o => o.valuesID),
                            sourceData: result,
                            payElEntryType: ['PAYMENT'],
                            sourceAttr: 'valuesID',
                            listParamID: me.listParamTabs[tabName].ID,
                            onSelectData: (data) => {
                              if (data.remove.length || data.add.length) {
                                $App.connection.run({
                                  entity: 'hr_idParam',
                                  method: 'updateValuesIDs',
                                  listParamID: me.listParamTabs[tabName].ID,
                                  orgID: appAC.globalOrganization(),
                                  data: JSON.stringify(data)
                                }).then(() => {
                                  grid.getStore().load()
                                })
                              }
                            }
                          },
                          store: grid.getStore()
                        })
                      })
                  }
                }
              ]
            }
          ]
        })
      })
    }

    function getPosGroupName (onChange = () => true) {
      return {
        xtype: 'textfield',
        name: 'posGroupName',
        formParams: true,
        fieldLabel: UB.i18n('Назва '),
        labelWidth: 100,
        allowBlank: false,
        listeners: {
          change: function (fld) {
            me.record.posGroupName = fld.getValue() || null
            const form = fld.up('form')
            me.loadFirst ? me.loadFirst = false : form.down('[name=btnSave]').setDisabled(false)
            onChange({ posGroupName: me.record.posGroupName, orgID: appAC.globalOrganization() }) &&
            validateFields() && me.makeReport('html')
          }
        }
      }
    }

    function getObjPeriodsCtrl (onChange = () => true) {
      return {
        layout: { type: 'hbox' },
        items: [
          getObjPeriodCtrl('objPeriodFrom', UB.i18n('Період з')),
          getObjPeriodCtrl('objPeriodTo', UB.i18n('по'))
        ]
      }
    }

    function getObjPeriodCtrl (name, fieldLabel) {
      return {
        xtype: 'ubcombobox',
        allowBlank: false,
        name: name,
        fieldLabel: fieldLabel,
        labelWidth: 100,
        width: 340,
        hideEntityItemInContext: true,
        selectOnFocus: true,
        ubRequest: {
          entity: 'hr_dictPeriod',
          fieldList: ['ID', 'name', 'description', 'dateFrom', 'dateTo', 'orgID'],
          orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
        },
        pageSize: 50,
        listeners: {
          beforeQuerySend: function () {
            this.store.ubRequest.whereList = {
              orgID: {
                expression: '[orgID]',
                condition: 'equal',
                value: appAC.globalOrganization()
              }
            }
            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
          },
          change: function (fld) {
            const rec = AC.gridUtils.getCurrentRecord(fld)
            me.record[name] = fld.getRawValue()
            me.record[`${name}DateFrom`] = rec ? rec.get('dateFrom') : null
            me.record[`${name}DateTo`] = rec ? rec.get('dateTo') : null
            validateFields() && me.makeReport('html')
          },
          expand: appHR.periodExpand
        }
      }
    }

    function getReportTab () {
      return {
        itemId: 'tabReport',
        title: UB.i18n('Звіт'),
        autoScroll: true,
        margin: '5, 0, 0, 0',
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        items: [
          {
            flex: 1,
            autoScroll: true,
            layout: {
              type: 'hbox',
              pack: 'center',
              align: 'stretch'
            },
            bodyCls: 'ub-panel-gray',
            items: [control]
          }
        ]
      }
    }

    control = Ext.create('Ext.Component', {
      flex: 1,
      margin: 0,
      autoEl: {
        tag: 'iframe'
      }
    })

    tabs = [
      getReportTab()
    ]

    const posPositionFieldList = [
      {
        name: 'listParamID',
        visibility: false
      },
      {
        name: 'orgID',
        visibility: false
      },
      {
        name: 'valuesID',
        visibility: false
      },
      {
        name: 'positionID.name',
        description: UB.i18n('Посада'),
        config: {
          width: 450
        }
      },
      {
        name: 'positionID.parentUnitID.name',
        description: UB.i18n('Підпорядкування'),
        config: {
          width: 450
        }
      },
      {
        name: 'positionID.dictPositionID.dictProfessionID.description',
        description: UB.i18n('Державна класіфікація'),
        config: {
          flex: 2
        }
      }
    ]

    const payElPositionFieldList = [
      {
        name: 'listParamID',
        visibility: false
      },
      {
        name: 'valuesID',
        visibility: false
      },
      {
        name: 'orgID',
        visibility: false
      },
      {
        name: 'payElID.description',
        description: UB.i18n('Вид оплати'),
        config: { width: 450 },
        editor: { xtype: 'textfield', readOnly: true }
      },
      {
        name: 'payElID.methodID.methodGroupID.groupType',
        description: UB.i18n('Тип'),
        simpleFilter: true,
        editor: { xtype: 'textfield', readOnly: true }
      },
      {
        name: 'payElID.methodID.methodGroupID.name',
        description: UB.i18n('Група'),
        simpleFilter: true,
        config: { flex: 2 },
        editor: { xtype: 'textfield', readOnly: true }
      },
      {
        name: 'orderN',
        config: { flex: 1 },
        editor: { minValue: 0, maxValue: 99999, allowExponential: false }
      }
    ]

    const tabParamList = [
      {
        tabName: 'payElPosition',
        formCode: 'hr_idParam-payEl',
        formListCode: 'hr_payElSelect',
        fieldList: payElPositionFieldList,
        enableOrderN: true,
        title: UB.i18n('Список видів оплат')
      }
    ]

    getListParamTabs(tabs, tabParamList)

    tabs.push({
      itemId: 'posPosition',
      title: UB.i18n('Список посад'),
      autoScroll: true,
      flex: 1,
      margin: '5, 0, 0, 0',
      layout: {
        type: 'vbox',
        align: 'stretch'
      },
      items: [
        {
          xtype: 'entitygridpanel',
          cmdType: 'showList',
          hideActions: ['showPreview', 'itemLink', 'commandLink', 'addNew', 'addNewByCurrent', 'detail', 'edit'],
          name: 'posPosition',
          autoScroll: true,
          pageSize: 10000,
          flex: 1,
          entityConfig: {
            entity: 'hr_idParam',
            method: 'select',
            fieldList: posPositionFieldList,
            whereList: {
              byTab: {
                expression: '[listParamID.code]',
                condition: 'isNull'
              },
              posState: {
                expression: '[positionID.state]',
                condition: '=',
                value: 'ACTIVE'
              },
              posDateDelete: {
                expression: '[positionID.mi_deleteDate]',
                condition: '=',
                value: '#maxdate'
              },
              posDateFrom: {
                expression: '[positionID.mi_dateFrom]',
                condition: '<=',
                value: appAC.globalApplicationDate()
              },
              posDateTo: {
                expression: '[positionID.mi_dateTo]',
                condition: '>=',
                value: appAC.globalApplicationDate()
              }
            }

          },
          onAddNew: function () {
            const grid = this
            if (!me.posGroupID) {
              $App.dialogInfo(UB.i18n('Необхідно спочатку зберегти дані'))
              return
            }

            $App.doCommand({
              cmdType: 'showForm',
              formCode: 'hr_idParam-position',
              entity: 'hr_idParam',
              initialFieldValues: {
                listParamID: me.listParamTabs['posPosition'].ID,
                orgID: appAC.globalOrganization()
              },
              store: grid.getStore()
            }
            )
          },
          onItemDblClick: function (grid, record) {
            const sender = this
            $App.doCommand({
              cmdType: 'showForm',
              formCode: 'hr_idParam-position',
              entity: 'hr_idParam',
              instanceID: record.get('ID'),
              initialFieldValues: {
                listParamID: me.listParamTabs['posPosition'].ID,
                orgID: appAC.globalOrganization()
              },
              store: grid.getStore(),
              sender: sender
            })
          },
          afterInit: function () {
            const grid = this
            if (me.posGroupID) {
              if (!me.listParamTabs['posPosition'].code) {
                const listParamsCodesNames = [`posPosition${me.posGroupID}`, `payElPosition${me.posGroupID}`]
                UB.Repository('hr_listParam')
                  .attrs('ID', 'code')
                  .where('code', 'in', listParamsCodesNames)
                  .selectAsObject().then(result => {
                    result.forEach(resItem => {
                      for (const prop in me.listParamTabs) {
                        if (resItem.code.includes(prop)) {
                          me.listParamTabs[prop] = { ID: resItem.ID, code: resItem.code }
                        }
                      }
                    })

                    grid.store.ubRequest.whereList.byTab = {
                      expression: '[listParamID.code]',
                      condition: 'equal',
                      values: { 'code': me.listParamTabs['posPosition'].code }
                    }

                    grid.store.ubRequest.whereList.posDateFrom = {
                      expression: '[positionID.mi_dateFrom]',
                      condition: '<=',
                      value: appAC.globalApplicationDate()
                    }
                    grid.store.ubRequest.whereList.posDeleteUser = {
                      expression: '[positionID.mi_deleteUser]',
                      condition: 'isNull'
                    }
                    grid.store.ubRequest.whereList.depDateFrom = {
                      expression: '[positionID.parentUnitID.mi_dateFrom]',
                      condition: '<=',
                      value: appAC.globalApplicationDate()
                    }

                    grid.store.ubRequest.whereList.depDeleteUser = {
                      expression: '[positionID.parentUnitID.mi_deleteUser]',
                      condition: 'isNull'
                    }
                  })
              }
            }
          },
          customActions: [{
            itemId: 'addList',
            text: UB.i18n('Додати списком'),
            actionId: 'addByList',
            iconCls: 'u-icon-edit-alt',
            scale: 'medium',
            cls: 'fill-action',
            handler: function (btn) {
              if (!me.posGroupID) {
                $App.dialogInfo(UB.i18n('Необхідно спочатку зберегти дані'))
                return
              }
              UB.Repository('hr_idParam')
                .where('[listParamID]', '=', me.listParamTabs.posPosition.ID)
                .where('[orgID]', '=', appAC.globalOrganization())
                .attrs(['ID', 'valuesID'])
                .selectAsObject()
                .then(result => {
                  const grid = btn.up('entitygridpanel')
                  const sourceData = result // (grid.getStore().snapshot || grid.getStore().data).items
                  const selectData = result.map(o => o.valuesID) // sourceData.map(o => o.data.valuesID)
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: 'hr_positionSearch',
                    isModal: true,
                    cmpInitConfig: {
                      orgID: appAC.globalOrganization(),
                      selectData,
                      onSelect: (data) => {
                        let updateData = {
                          remove: sourceData.filter(o => !data.some(d => o.valuesID === d.mi_data_id)).map(o => o.ID),
                          add: data.filter(d => !selectData.includes(d.mi_data_id)).map(d => d.mi_data_id)
                        }

                        if (updateData.remove.length || updateData.add.length) {
                          $App.connection.run({
                            entity: 'hr_idParam',
                            method: 'updateValuesIDs',
                            listParamID: me.listParamTabs['posPosition'].ID,
                            orgID: appAC.globalOrganization(),
                            data: JSON.stringify(updateData)
                          }).then(() => {
                            grid.getStore().load()
                          })
                        }
                      }
                    }
                  })
                })
            }
          }]
        }
      ]
    })

    container = Ext.create('Ext.panel.Panel', {
      layout: {
        type: 'vbox',
        align: 'stretch'
      },
      flex: 1,
      items: [
        {
          xtype: 'toolbar',
          items: [
            {
              tooltip: UB.i18n('Сформувати'),
              iconCls: 'fas fa-calculator',
              cls: 'green-action',
              handler: function () {
                validateFields() && me.makeReport('html')
              }
            },
            {
              tooltip: UB.i18n('Зберегти'),
              iconCls: 'fas fa-save',
              cls: 'save-action',
              xtype: 'button',
              disabled: true,
              name: 'btnSave',
              handler: function (ctrl) {
                if (validateFields()) {
                  // save hr_posGroup and get ID, then hr_listParam
                  $App.connection.run({
                    entity: 'hr_posGroup',
                    method: 'insertOrUpdatePosGroup',
                    posGroupID: me.posGroupID,
                    posGroupName: me.attr.posGroupName.getValue(),
                    orgID: appAC.globalOrganization()
                  }).then((result) => {
                    const btn = this
                    if (!me.posGroupID) {
                      me.posGroupID = result.posGroupID
                      for (const prop in me.listParamTabs) {
                        me.listParamTabs[prop].ID = result[prop].ID
                        me.listParamTabs[prop].code = result[prop].code
                      }

                      const grids = me.query('entitygridpanel')
                      grids.forEach(gr => {
                        gr.store.ubRequest.whereList.byTab = {
                          expression: '[listParamID.code]',
                          condition: 'equal',
                          values: { 'code': result[gr.name].code }
                        }
                      })
                    }
                    btn.setDisabled(true)
                  })
                }
              }
            },
            {
              tooltip: UB.i18n('Друкувати'),
              iconCls: 'fas fa-print',
              cls: 'blue-action',
              handler: function () {
                const iFrame = me.reportControl.getEl().dom
                iFrame.contentWindow.print()
              }
            },
            {
              tooltip: UB.i18n('Сформувати Excel'),
              iconCls: 'fas fa-file-excel',
              cls: 'green-action',
              handler: function () {
                validateFields() && me.makeReport('xlsx')
              }
            }
          ]
        },
        {
          xtype: 'panel',
          layout: { type: 'vbox', align: 'stretch' },
          items: [
            getPosGroupName(),
            getObjPeriodsCtrl()
          ]
        },
        {
          xtype: 'tabpanel',
          itemId: 'cmpTabPanel',
          flex: 1,
          minWidth: 250,
          margin: '10 10 10 10',
          plain: true,
          items: tabs
        }
      ]
    })
    me.items = [
      container
    ]
    me.reportControl = control

    const reportMethod = {
      'hr_accrual-posGroup': 'getPosGroupReportData'
    }

    me.globalDateChange = function () {
      const store = me.down('[name=posPosition]').getStore()
      store.ubRequest.onDate = appAC.globalApplicationDate()
      store.ubRequest.whereList.posDateFrom = {
        expression: '[positionID.mi_dateFrom]',
        condition: '<=',
        value: appAC.globalApplicationDate()
      }
      store.ubRequest.whereList.depDateFrom = {
        expression: '[positionID.parentUnitID.mi_dateFrom]',
        condition: '<=',
        value: appAC.globalApplicationDate()
      }
      store.load()
    }

    me.makeReport = function (type) {
      me.setLoading(true)
      onCalcFunc()
      $App.connection.run({
        entity: 'hr_accrualReport',
        method: reportMethod[reportCode],
        execParams: Object.assign({
          reportCode,
          orgID: appAC.globalOrganization(),
          currDate: appAC.globalApplicationDate(),
          selectedRows: JSON.stringify(me.accrualGrid ? me.accrualGrid.getCheckedRows() : []),
          listParamTabs: me.listParamTabs
        },
        me.record)
      }).then(mParams => {
        if (type === 'xlsx') {
          me.report = Ext.create('UBS.UBReport', {
            code: reportCode,
            type: 'xlsx',
            params: JSON.parse(mParams.resultData)
          })
          me.report.makeReport().then(function (data) {
            const blobData = new Blob(
              [data.reportData], {
                type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
              }
            )
            const repName = reportCode.split('-').slice(-1)
            const fileName = `${repName}.xlsx`
            window.saveAs(blobData, fileName)
            me.setLoading(false)
            me.reportType = 'html'
          })
        } else {
          me.report = Ext.create('UBS.UBReport', {
            code: reportCode,
            type: 'html',
            params: JSON.parse(mParams.resultData)
          })

          me.report
            .init()
            .then(function () {
              return me.report.makeReport()
            })
            .then(function (data) {
              if (data && data.reportData) {
                me.showReport(data.reportData)
              }
              me.setLoading(false)
              me.reportDone = true
            })
        }
      })
    }

    me.callParent(arguments)
  },
  showReport: function (data) {
    const me = this
    const HTML_PAGEBREAK_RE = new RegExp('<!-- pagebreak -->', 'gi')
    const HTML_PAGEBREAK_EL = '<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" class="mce-pagebreak"/>'
    const iFrame = me.reportControl.getEl().dom
    const iFrameDoc = iFrame.contentDocument
    const style = [getStyle()]
    const orientation = me.report.reportOptions.pageOrientation
    if (orientation === 'landscape') {
      style.push('@page{size: landscape;}')
    } else if (orientation === 'portrait') {
      style.push('@page{size: portrait;}')
    }
    const styleText = `<style type="text/css"> ${style.join('\n')} </style>`
    me.report.reportOptions.html = data
    iFrameDoc.body.innerHTML = data.replace(HTML_PAGEBREAK_RE, HTML_PAGEBREAK_EL)
    iFrameDoc.head.innerHTML = styleText
    me.setLoading(false)
  },

  afterRender: function () {
    const me = this
    me.callParent()

    const fieldsAfterrender = {
      posGroupName: fld => {
        if (me.posGroupID) {
          me.loadFirst = true
          fld.setValue(me.posGroupName)
        }
      },

      periodID: fld => {
        appHR.getCurrentPeriod(appAC.globalOrganization()).then(res => {
          fld.setValueById(res.ID)
        })
      },
      reportDate: fld => {
        fld.setValue(appAC.globalApplicationDate())
        me.record.reportDate = appAC.globalApplicationDate()
      },
      objPeriodFrom: fld => {
        const orgID = appAC.globalOrganization()
        UB.Repository('hr_dictPeriod').attrs(['ID', 'dateFrom', 'dateTo', 'pYear'])
          .where('orgID', '=', orgID)
          .where('isCurrent', '=', true)
          .selectSingle().then(response => {
            if (response) {
              UB.Repository('hr_dictPeriod').attrs(['ID', 'dateFrom', 'dateTo', 'pYear'])
                .where('orgID', '=', orgID)
                .where('pYear', '=', response.pYear)
                .orderBy('dateFrom', 'asc')
                .selectSingle().then(resp => {
                  if (resp) {
                    fld.setValueById(resp.ID)
                  }
                })
            }
          })
      },
      objPeriodTo: fld => {
        appHR.getCurrentPeriod(appAC.globalOrganization()).then(res => {
          if (res && res.ID) fld.setValueById(res.ID)
        })
      }
    }
    me.accrualGrid = me.queryById('accrualGrid')
    me.getForm().getFields().getRange().forEach(item => {
      me.attr[item.name] = item
      !item.allowBlank && !item.hidden && me.requiredAttr.push(item)
    })

    Object.keys(fieldsAfterrender).forEach(item => {
      me.attr[item] && fieldsAfterrender[item](me.attr[item])
    })
  }
})

function getStyle () {
  return `
    body {
      background-color: #FFFFFF;
      color: #000000;
      font-family: Verdana, Arial, Helvetica, sans-serif;
      font-size: 14px;
      line-height: 1.3;
    }
    .word-wrap {
      word-wrap: break-word;
      hyphens: auto
    }
    td {
      padding: 0 2px 0 2px;
    }
    .mce-pagebreak {
      cursor: default;
      display: block;
      border: 0;
      width: 100%;
      height: 5px;
      border: 1px dashed #666;
      margin-top: 15px;
      page-break-before: always
    }
    table.layout-portrait {
      width:750px;
    }
    table.layout-landscape {
      width:1100px !important;
    }
    @media print {
      .mce-pagebreak {
        border: 0
      }
      a {
        text-decoration: none
      }
      table.layout-landscape {
        width:1300px;
      }
    }
  `
}
