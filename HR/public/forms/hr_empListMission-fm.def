/* global Ext AC appAC HR $App UB */
exports.formDef = 'HR.empListMission'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.empListMission', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.empListMission',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox' },
            collapsed: false,
            items: [
              {
                layout: { type: 'vbox' },
                items: [
                  HR.controlService.getTimeCostGroupInfo('LST_TRIP'),
                  {
                    layout: { type: 'vbox' },
                    items: [
                      {
                        layout: { type: 'hbox' },
                        items: [
                          HR.controlService.getOrgCombo({
                            labelWidth: 130,
                            width: 700,
                            flex: 1,
                            readOnly: !accMainReportsSubOrg,
                            ubRequest: {
                              entity: 'hr_organization',
                              fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                              whereList: {
                                state: {
                                  expression: '[state]',
                                  condition: '=',
                                  values: {
                                    state: 'ACTIVE'
                                  }
                                },
                                path: {
                                  expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                                  condition: accMainReportsSubOrg ? 'like' : '=',
                                  values: {
                                    state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                                  }
                                }
                              },
                              orderList: { orderBy: { expression: 'description' } },
                              __mip_ondate: appAC.globalApplicationDate()
                            },
                            listeners: {
                              change: function (ctrl) {
                                const form = ctrl.up('form')
                                HR.controlService.onChangeIncludeChildOrgs(form)
                              }
                            }
                          }),
                          HR.controlService.getIncludeChildOrgs(accMainReportsSubOrg)
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        items: [
                          HR.controlService.getDepCombo({
                            labelWidth: 130,
                            width: 700,
                            displayField: 'description',
                            flex: 1,
                            listeners: {
                              change: function (ctrl, value) {
                                const form = ctrl.up('form')
                                form.down('[name=includeChildDepts]').setReadOnly(!value)
                                if (!value) {
                                  form.down('[name=includeChildDepts]').setValue()
                                }
                              }
                            }
                          }),
                          HR.controlService.getIncludeChildDepts()
                        ]
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubdatefield',
                        labelWidth: 130,
                        name: 'dateFrom',
                        fieldLabel: UB.i18n('Період з'),
                        allowBlank: false
                      },
                      {
                        xtype: 'ubdatefield',
                        labelWidth: 50,
                        name: 'dateTo',
                        fieldLabel: UB.i18n('по'),
                        allowBlank: false
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubcombobox',
                        name: 'workPlace',
                        labelWidth: 130,
                        width: 700,
                        fieldLabel: UB.i18n('Місце роботи'),
                        hideEntityItemInContext: true,
                        enumGroupFilter: 'HR_WORKER_PLACE',
                        valueField: 'code',
                        displayField: 'name',
                        ubRequest: {
                          entity: 'ubm_enum',
                          method: UB.core.UBCommand.methodName.SELECT,
                          fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                          whereList: {
                            eGroup: {
                              expression: '[eGroup]',
                              condition: 'equal',
                              values: { 'eGroup': 'HR_WORKER_PLACE' }
                            }
                          }
                        },
                        listeners: {
                          render: function (ctrl) {
                            ctrl.store.on('load', () => {
                              if (!ctrl.store.isLoaded) {
                                ctrl.setValue('1')
                                ctrl.store.isLoaded = true
                              }
                            })
                            ctrl.store.load()
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                layout: { type: 'hbox' },
                padding: '50 0 0 0',
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Шукати'),
                    iconCls: 'fas fa-search',
                    width: 30,
                    cls: 'green-action',
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.searchEmployee()
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Очистити'),
                    iconCls: 'fas fa-eraser',
                    width: 30,
                    cls: 'fill-action',
                    margin: '5 0 0 0',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.clearSearch()
                    }
                  },
                  {
                    xtype: 'button',
                    iconCls: 'fas fa-print',
                    width: 30,
                    cls: 'blue-action',
                    margin: '5 0 0 0',
                    tooltip: UB.i18n('Друкувати'),
                    handler: function () {
                      me.doReport()
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        xtype: 'ubdetailgrid',
        name: 'employeeNumberListGrid',
        region: 'center',
        flex: 1,
        autoScroll: true,
        loadStoreImmediately: false,
        forceDataLoad: true,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink',
          'commandLink', 'showDetail', 'audit'],
        cmdData: {
          params: [{
            entity: 'hr_empListMission',
            method: 'search',
            fieldList: [
              { name: 'employeeID', visibility: false },
              { name: 'employeeNumberID', visibility: false },
              { name: 'tabNum', description: UB.i18n('Таб. №'), tooltip: UB.i18n('Табельний номер') },
              { name: 'fullFIO', description: UB.i18n('ПIБ') },
              { name: 'taxCode', description: UB.i18n('РНОКПП'), tooltip: UB.i18n('Реєстраційний номер облікової картки платника податків') },
              { name: 'addDescrPerson', description: UB.i18n('Додаткова інформація') },
              { name: 'cityName', description: UB.i18n('Населений пункт'), tooltip: UB.i18n('Населений пункт, куди був відряджений працівник') },
              { name: 'destOrganizationName', description: UB.i18n('Організація для відряждення'), tooltip: UB.i18n('Організація, куди був відряджений працівник') },
              { name: 'missionDateFrom', description: UB.i18n('Дата початку'), format: 'd.m.Y', tooltip: UB.i18n('Дата початку відрядження') },
              { name: 'missionDateTo', description: UB.i18n('Дата закінчення'), format: 'd.m.Y', tooltip: UB.i18n('Дата закінчення відрядження') },
              { name: 'isInsideCountry', description: UB.i18n('У межах країни'), tooltip: UB.i18n('У межах країни') },

              { name: 'missionIsNeedReport', description: UB.i18n('Подати звіт'), tooltip: UB.i18n('Подати звіт') },
              { name: 'reportDate', description: UB.i18n('Дата подачі звіту'), format: 'd.m.Y', tooltip: UB.i18n('Дата подачі звіту') },

              // { name: 'depName', description: 'Самостійний структурний підрозділ' },
              { name: 'posName', description: UB.i18n('Посада'), tooltip: UB.i18n('Посада') },
              { name: 'actualPositionName' },
              { name: 'depName', description: UB.i18n('Підрозділ'), tooltip: UB.i18n('Підрозділ') },
              { name: 'workPlace', description: UB.i18n('Місце роботи') },
              { name: 'selfStructDepName', description: UB.i18n('Самостійний структурний підрозділ') },
              { name: 'orgName', description: UB.i18n('Організація') }
            ]
          }]
        },
        onItemDblClick: HR.employeeTabs.openEmpCard,
        cmpInitConfig: {
          onDeterminateForm: HR.employeeTabs.onDeterminateCard,
          listeners: {
            render: (grid) => {
              grid.menu.removeAll()
              grid.menu.add([HR.employeeTabs.getEmpCardMenu(grid)])
              const showAddDescrPerson = !!AC.settings.get('hrShowAddDescrPerson', appAC.globalOrganization())
              const colPersonDescr = AC.gridUtils.getColumnByIndex(grid, 'addDescrPerson')
              colPersonDescr.setVisible(showAddDescrPerson)
              const useActualPositionName = AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization()) === true
              const colActualPositionName = AC.gridUtils.getColumnByIndex(grid, 'actualPositionName')
              colActualPositionName.setVisible(useActualPositionName)
            }
          }
        },
        getExportTitle: function () {
          return UB.i18n('Працівники, які перебувають у відрядженні')
        }
      }
    ]

    me.clearSearch = () => {
      me.attr.dateFrom.setValue(new Date())
      me.attr.dateTo.setValue(new Date())
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.includeChildOrgs.setValue()
      me.attr.departmentID.setValue()
      me.attr.includeChildDepts.setValue()
    }

    me.searchEmployee = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      const store = me.attr.grid.getStore()
      let req = store.ubRequest
      req.organizationID = me.attr.organizationID.getValue()
      req.includeChildOrgs = me.attr.includeChildOrgs.getValue()
      req.departmentID = me.attr.departmentID.getValue()
      req.includeChildDepts = me.attr.includeChildDepts.getValue()
      req.onDate = appAC.globalApplicationDate()
      req.dateFrom = AC.dateService.shiftDate(me.attr.dateFrom.getValue())
      req.dateTo = AC.dateService.shiftDate(me.attr.dateTo.getValue())
      req.workPlace = me.attr.workPlace.getValue()
      store.load()
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[name=employeeNumberListGrid]'),
        organizationID: me.down('[name=organizationID]'),
        includeChildOrgs: me.down('[name=includeChildOrgs]'),
        departmentID: me.down('[name=departmentID]'),
        includeChildDepts: me.down('[name=includeChildDepts]'),
        dateFrom: me.down('[name=dateFrom]'),
        dateTo: me.down('[name=dateTo]'),
        workPlace: me.down('[name=workPlace]')
      }
      me.attr.dateFrom.setValue(appAC.globalApplicationDate())
      me.attr.dateTo.setValue(appAC.globalApplicationDate())
    }, me)

    me.validateParams = () => {
      let res
      let params = []

      let dateFromCtrl = me.attr.dateFrom
      let dateFrom = dateFromCtrl.getValue()
      if (!dateFrom || !dateFromCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Період з"')))
      }
      let dateToCtrl = me.attr.dateTo
      let dateTo = dateToCtrl.getValue()
      if (!dateTo || !dateToCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"по"')))
      }
      if (!me.attr.organizationID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Організація"')))
      }
      if (params.length) {
        res = {
          msg: UB.i18n(`Не вибрано наступні параметри:<br/>{0}`, params.join(',<br/>'))
        }
      } else {
        if (dateFrom > dateTo) {
          res = {
            msg: UB.i18n(`Дата {0} не може перевищувати дату {1}`, AC.viewUtils.formatFieldLabel('"Період з"'), AC.viewUtils.formatFieldLabel('"по"'))
          }
        }
      }

      return res
    }

    me.report_code = 'hr_empListMission_1'
    me.doReport = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      let reportParams = {
        organizationID: me.attr.organizationID.getValue(),
        includeChildOrgs: me.attr.includeChildOrgs.getValue(),
        departmentID: me.attr.departmentID.getValue(),
        includeChildDepts: me.attr.includeChildDepts.getValue(),
        onDate: appAC.globalApplicationDate(),
        dateFrom: AC.dateService.shiftDate(me.attr.dateFrom.getValue()),
        dateTo: AC.dateService.shiftDate(me.attr.dateTo.getValue()),
        workPlace: me.attr.workPlace.getValue()
      }

      $App.doCommand({
        cmdType: 'showReport',
        caption: UB.i18n('Друкована форма'),
        tabId: 'printDocument' + me.report_code + Date.now(),
        target: $App.getViewport().centralPanel,
        cmdData: {
          reportCode: me.report_code,
          reportParams: reportParams,
          reportOptions: {
            allowExportToExcel: true,
            isModal: false
          }
        }
      })
    }

    me.callParent(arguments)
  }
})
