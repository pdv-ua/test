/* global Ext $App appAC UB AC appHR */
exports.formDef = 'HR.importCustom'

Ext.define('HR.importCustom', {
  extend: 'Ext.panel.Panel',
  alias: 'widget.hr_importCustom',
  width: 1100,
  height: 600,
  autoScroll: true,
  layout: { type: 'vbox', align: 'stretch' },
  initComponent: function () {
    const me = this
    const getLogButton = (method) => {
      return {
        xtype: 'button',
        tooltip: UB.i18n('Зауваження'),
        text: UB.i18n('Зауваження'),
        iconCls: 'u-icon-edit-alt',
        cls: 'fill-action',
        margin: '5 0 5 15',
        width: 150,
        handler: () => {
          $App.doCommand({
            entity: 'hr_importCustomLog',
            cmdType: 'showList',
            description: UB.i18n('Зауваження'),
            isModal: true,
            hideActions: ['edit', 'del', 'addNewByCurrent', 'addNew', 'itemSelect'],
            cmdData: {
              params: [{
                entity: 'hr_importCustomLog',
                method: 'select',
                fieldList: [
                  { name: 'operationDate', description: UB.i18n('Дата операції'), format: 'd.m.Y H:i:s' },
                  { name: 'msgType' },
                  { name: 'targetOrgID.name', description: UB.i18n('Організація') },
                  { name: 'description' },
                  { name: 'userID.name', description: UB.i18n('Користувач') }
                ],
                whereList: {
                  orgID: {
                    expression: '[orgID]',
                    condition: 'equal',
                    value: appAC.globalOrganization()
                  },
                  entityName: {
                    expression: '[entityName]',
                    condition: 'equal',
                    value: method
                  }
                }
              }]
            },
            cmpInitConfig: {
              customActions: [
                {
                  xtype: 'button',
                  scale: 'medium',
                  iconCls: 'fas fa-file-excel',
                  tooltip: UB.i18n('Сформувати'),
                  cls: 'green-action',
                  handler: (btn) => {
                    const grid = btn.up('entitygridpanel')
                    grid.onExportXls()
                  }
                }
              ]
            }
          })
        }
      }
    }
    const getRunButton = (buttonParams, runParams) => {
      return {
        xtype: 'button',
        tooltip: UB.i18n(buttonParams.text || 'Виконати'),
        text: UB.i18n(buttonParams.text || 'Виконати'),
        iconCls: buttonParams.iconCls || 'fas fa-cloud-download-alt',
        cls: buttonParams.cls || 'fill-action',
        margin: buttonParams.margin || '5 0 5 15',
        width: buttonParams.width || 150,
        handler: () => {
          if (!buttonParams.validateFunction || buttonParams.validateFunction()) {
            $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n(buttonParams.warningText || `Увага! ${buttonParams.text || 'Виконати'}?`))
              .then(res => {
                if (res) {
                  me.setLoading(true)
                  $App.connection.run(runParams()).then(response => {
                    me.setLoading(false)
                    if (response.msgType) {
                      $App.dialogInfo(UB.i18n('Операція виконана з зауваженнями'))
                    } else {
                      $App.dialogInfo(UB.i18n('Операція успішно виконана'))
                    }
                  }, (err) => {
                    me.setLoading(false)
                    if (err.config && err.config.timeout) {
                      $App.dialogInfo(UB.i18n('Операція виконується на сервері застосувань,\n та потребує додаткового часу для завершення.\n Зачекайте будь ласка, операцію буде виконано'))
                    } else {
                      throw err
                    }
                  })
                }
              })
          }
        }
      }
    }

    me.items = [
      {
        xtype: 'tabpanel',
        flex: 1,
        items: [
          {
            title: `${UB.i18n('Зарплата')} ${UB.i18n('Особові рахунки')}`,
            split: true,
            layout: 'accordion',
            layoutConfig: {
              collapsible: true,
              collapsed: false
            },
            autoScroll: true,
            items: [
              {
                xtype: 'panel',
                hidden: true,
                collapsed: false
              },
              {
                margin: '5 15 5 15',
                title: UB.i18n('Заповнення категорії застрахованих осіб для всіх'),
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'vbox' },
                items: [
                  {
                    xtype: 'ubcombobox',
                    name: 'dictCategoryECBID',
                    fieldLabel: UB.i18n('Категорія застрахованої особи'),
                    valueField: 'ID',
                    displayField: 'caption',
                    width: 600,
                    ubRequest: {
                      entity: 'hr_dictCategoryECB',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['ID', 'caption']
                    }
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      getRunButton({
                        text: 'Заповнити',
                        warningText: 'Увага! Заповнити категорію застрахованих осіб для всіх працівників?',
                        validateFunction: () => {
                          return me.attr.dictCategoryECBID.getValue()
                        }
                      },
                      () => {
                        return {
                          entity: 'hr_importCustom',
                          method: 'setDictCategoryECB',
                          orgID: appAC.globalOrganization(),
                          dictCategoryECBID: me.attr.dictCategoryECBID.getValue()
                        }
                      }),
                      getLogButton('setDictCategoryECB')
                    ]
                  }
                ]
              },
              {
                margin: '5 15 5 15',
                title: UB.i18n('Корректировки табеля'),
                hidden: true,
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'vbox' },
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Заповнити'),
                    text: UB.i18n('Заповнити'),
                    iconCls: 'fas fa-cloud-download-alt',
                    cls: 'fill-action',
                    margin: '5 0 5 15',
                    width: 150,
                    handler: () => {
                      me.timeSheetCorrect()
                    }
                  }
                ]
              },
              {
                margin: '5 15 5 15',
                title: UB.i18n('Замінити графік роботи по всій організації'),
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'vbox' },
                items: [
                  {
                    layout: { type: 'vbox' },
                    items: [
                      {
                        xtype: 'ubcombobox',
                        name: 'workScheduleFrom',
                        fieldLabel: UB.i18n('Існуючий графік роботи'),
                        displayField: 'description',
                        labelWidth: 180,
                        width: 500,
                        ubRequest: {
                          entity: 'hr_workSchedule',
                          method: UB.core.UBCommand.methodName.SELECT,
                          fieldList: ['ID', 'description', 'organizationID'],
                          whereList: {
                            organizationID: {
                              expression: '[organizationID]',
                              condition: 'equal',
                              value: appAC.globalOrganization()
                            },
                            orgIsNull: {
                              expression: '[organizationID]',
                              condition: 'isNull'
                            }
                          },
                          logicalPredicates: ['[organizationID] OR [orgIsNull]']
                        }
                      },
                      {
                        xtype: 'ubcombobox',
                        name: 'workScheduleTo',
                        fieldLabel: UB.i18n('Новий графік роботи'),
                        displayField: 'description',
                        labelWidth: 180,
                        width: 500,
                        ubRequest: {
                          entity: 'hr_workSchedule',
                          method: UB.core.UBCommand.methodName.SELECT,
                          fieldList: ['ID', 'description', 'organizationID'],
                          whereList: {
                            organizationID: {
                              expression: '[organizationID]',
                              condition: 'equal',
                              value: appAC.globalOrganization()
                            },
                            orgIsNull: {
                              expression: '[organizationID]',
                              condition: 'isNull'
                            }
                          },
                          logicalPredicates: ['[organizationID] OR [orgIsNull]']
                        }
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      getRunButton({
                        text: 'Замінити',
                        warningText: 'Увага! Замінити графік роботи по всій організації?',
                        validateFunction: () => {
                          if (me.down('[name=workScheduleFrom]').getValue() === me.down('[name=workScheduleTo]').getValue()) {
                            AC.viewUtils.showToast(UB.i18n('Помилка'), UB.i18n('Вибрані однакові значення'))
                            return false
                          } else {
                            return true
                          }
                        }
                      },
                      () => {
                        return {
                          entity: 'hr_importCustom',
                          method: 'replaceWorkSchedule',
                          orgID: appAC.globalOrganization(),
                          workScheduleFromID: me.down('[name=workScheduleFrom]').getValue(),
                          workScheduleToID: me.down('[name=workScheduleTo]').getValue()
                        }
                      }),
                      getLogButton('replaceWorkSchedule')
                    ]
                  }
                ]
              },
              {
                margin: '5 15 5 15',
                title: UB.i18n('Заповнення ознаки індексувати середній заробіток згідно підвищенню окладу'),
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'vbox' },
                items: [

                  {
                    xtype: 'ubdatefield',
                    name: 'isIndexDateFrom',
                    fieldLabel: UB.i18n('Дата підвищення окладів'),
                    labelWidth: 200,
                    width: 320
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      getRunButton({
                        text: 'Заповнити',
                        warningText: 'Увага! Заповнити ознаки індексувати середній заробіток згідно підвищенню окладу?',
                        validateFunction: () => {
                          return me.attr.isIndexDateFrom.getValue() && me.attr.isIndexDateFrom.isValid()
                        }
                      },
                      () => {
                        return {
                          entity: 'hr_importCustom',
                          method: 'setIsIndexSalary',
                          orgID: appAC.globalOrganization(),
                          isIndexDateFrom: me.attr.isIndexDateFrom.getValue()
                        }
                      }),
                      getLogButton('setIsIndexSalary')
                    ]
                  }
                ]
              },
              {
                margin: '5 15 5 15',
                title: UB.i18n('Оновлення особових рахунків даними з Тарифікаці'),
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'vbox', align: 'stretch' },
                items: [
                  {
                    xtype: 'textarea',
                    rows: 3,
                    name: 'tariffTabNums',
                    fieldLabel: UB.i18n('Табельні номери (через кому)')
                  },
                  {
                    layout: { type: 'vbox' },
                    items: [
                      {
                        xtype: 'checkboxfield',
                        name: 'tariffChildOrg',
                        labelWidth: 250,
                        width: 600,
                        boxLabelAlign: 'before',
                        fieldLabel: UB.i18n('Разом з підпорядкованими')
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      getRunButton({
                        text: 'Оновити',
                        warningText: 'Увага! Оновити особові рахункіи з Тарифікаці?'
                      },
                      () => {
                        return {
                          entity: 'hr_importCustom',
                          method: 'createTarifications',
                          orgID: appAC.globalOrganization(),
                          tariffTabNums: me.down('[name=tariffTabNums]').getValue(),
                          tariffChildOrg: me.down('[name=tariffChildOrg]').getValue()
                        }
                      }),
                      getLogButton('createTarifications')
                    ]
                  }
                ]
              }
            ]
          },
          {
            title: `${UB.i18n('Зарплата')} ${UB.i18n('Розрахункові листи')}`,
            split: true,
            layout: 'accordion',
            layoutConfig: {
              collapsible: true,
              collapsed: false
            },
            autoScroll: true,
            items: [
              {
                xtype: 'panel',
                hidden: true,
                collapsed: false
              },
              {
                margin: '5 15 5 15',
                title: UB.i18n('Перенесення записів РЛ з одного ОР на інший'),
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'vbox' },
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'label',
                        text: UB.i18n('За період'),
                        cls: 'x-form-item-label',
                        margin: '8 15 0 15',
                        width: 120
                      },
                      {
                        xtype: 'ubcombobox',
                        name: 'periodFromRlID',
                        fieldLabel: UB.i18n('з'),
                        labelWidth: 15,
                        width: 200,
                        selectOnFocus: true,
                        ubRequest: {
                          entity: 'hr_dictPeriod',
                          fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'name', 'isClosed'],
                          whereList: {
                            isClosed: {
                              expression: '[isClosed]',
                              condition: 'equal',
                              value: true
                            }
                          },
                          orderList: { orderBy: { expression: 'dateFrom', order: 'asc' } }
                        },
                        pageSize: 50,
                        listeners: {
                          expand: appHR.periodExpand,
                          change: function (ctrl, value) {
                            if (value && me.attr.periodToRlID.getValue() &&
                              AC.dateService.shiftDate(me.attr.periodFromRlID.getFieldValue('dateFrom')) > AC.dateService.shiftDate(me.attr.periodToRlID.getFieldValue('dateFrom'))) {
                              me.attr.periodToRlID.setValueById(value)
                            }
                            AC.viewUtils.setFilterValue(me.attr.sourceRlID, {
                              orgID: appAC.globalOrganization()
                            })
                          }
                        }
                      },
                      {
                        xtype: 'ubcombobox',
                        name: 'periodToRlID',
                        fieldLabel: UB.i18n('по'),
                        labelWidth: 20,
                        width: 200,
                        selectOnFocus: true,
                        ubRequest: {
                          entity: 'hr_dictPeriod',
                          fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'name', 'isClosed'],
                          whereList: {
                            isClosed: {
                              expression: '[isClosed]',
                              condition: 'equal',
                              value: true
                            }
                          },
                          orderList: { orderBy: { expression: 'dateFrom', order: 'asc' } }
                        },
                        pageSize: 50,
                        listeners: {
                          expand: appHR.periodExpand,
                          change: function (ctrl, value) {
                            if (value && me.attr.periodFromRlID.getValue() &&
                              AC.dateService.shiftDate(me.attr.periodFromRlID.getFieldValue('dateFrom')) > AC.dateService.shiftDate(me.attr.periodToRlID.getFieldValue('dateFrom'))) {
                              me.attr.periodFromRlID.setValueById(value)
                            }
                            AC.viewUtils.setFilterValue(me.attr.sourceRlID, {
                              orgID: appAC.globalOrganization()
                              /* dateTo: { value: AC.dateService.shiftDate(me.attr.periodToRlID.getFieldValue('dateFrom') || AC.dateService.minDate()), condition: '>=' },
                              dateFrom: { value: AC.dateService.shiftDate(me.attr.periodToRlID.getFieldValue('dateTo') || AC.dateService.maxDate()), condition: '<=' } */
                            })
                          }
                        }
                      }
                    ]
                  },
                  {
                    xtype: 'empNumComboBox',
                    name: 'sourceRlID',
                    displayField: 'description',
                    fieldLabel: UB.i18n('З ОР працівника'),
                    addPlural: true,
                    addDateTo: true,
                    ubRequest: {
                      entity: 'hr_employeeNumberS',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['ID', 'description', 'orgID', 'dateFrom', 'dateToEmpty', 'depName', 'posName', 'workPlaceCode', 'workPlace', 'employeeID']
                    },
                    labelWidth: 140,
                    width: 500,
                    listeners: {
                      change: function (ctrl, value) {
                        if (value) {
                          me.down('[name=sourceRlDateFrom]').setValue(ctrl.getFieldValue('dateFrom') ? AC.dateService.shiftDate(ctrl.getFieldValue('dateFrom')) : null)
                          me.down('[name=sourceRlDateTo]').setValue(ctrl.getFieldValue('dateToEmpty') ? AC.dateService.shiftDate(ctrl.getFieldValue('dateToEmpty')) : null)
                          me.down('[name=sourceRlDepName]').setValue(ctrl.getFieldValue('depName') || null)
                          me.down('[name=sourceRlPosName]').setValue(ctrl.getFieldValue('posName') || null)
                          AC.viewUtils.setFilterValue(me.attr.targetRlID, {
                            orgID: appAC.globalOrganization(),
                            ID: { value: value, condition: '<>' }
                          })
                          UB.Repository('hr_employeeNumberSR')
                            .attrs('ID')
                            .where('orgID', '=', appAC.globalOrganization())
                            .where('employeeID', '=', me.attr.targetRlID.getFieldValue('employeeID'))
                            .where('ID', '<>', value)
                            .selectAsObject().then(responses => {
                              if (responses.length === 1) {
                                me.attr.targetRlID.setValueById(responses.ID)
                              } else if (responses.length > 1) {
                                me.attr.targetRlID.setValueById(null)
                              }
                            })
                        }
                      }
                    }
                  },
                  {
                    layout: { type: 'hbox' },
                    margin: '0 15 0 145',
                    items: [
                      {
                        xtype: 'ubdatefield',
                        name: 'sourceRlDateFrom',
                        fieldLabel: UB.i18n('Дата прийому'),
                        readOnly: true,
                        labelWidth: 100,
                        width: 200
                      },
                      {
                        xtype: 'ubdatefield',
                        name: 'sourceRlDateTo',
                        fieldLabel: UB.i18n('Дата звільнення'),
                        readOnly: true,
                        labelWidth: 140,
                        width: 240
                      }
                    ]
                  },
                  {
                    xtype: 'textfield',
                    name: 'sourceRlDepName',
                    fieldLabel: UB.i18n('Підрозділ'),
                    readOnly: true,
                    margin: '0 15 0 160',
                    labelWidth: 100,
                    width: 500
                  },
                  {
                    xtype: 'textfield',
                    name: 'sourceRlPosName',
                    fieldLabel: UB.i18n('Посада'),
                    margin: '0 15 0 160',
                    readOnly: true,
                    labelWidth: 100,
                    width: 500
                  },
                  {
                    xtype: 'empNumComboBox',
                    name: 'targetRlID',
                    displayField: 'description',
                    fieldLabel: UB.i18n('На ОР працівника'),
                    addPlural: true,
                    addDateTo: true,
                    ubRequest: {
                      entity: 'hr_employeeNumberS',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['ID', 'description', 'orgID', 'dateFrom', 'dateTo', 'dateToEmpty', 'depName', 'posName', 'workPlaceCode', 'workPlace', 'employeeID']
                    },
                    labelWidth: 140,
                    width: 500,
                    listeners: {
                      change: function (ctrl, value) {
                        if (value) {
                          me.down('[name=targetRlDateFrom]').setValue(ctrl.getFieldValue('dateFrom') ? AC.dateService.shiftDate(ctrl.getFieldValue('dateFrom')) : null)
                          me.down('[name=targetRlDateTo]').setValue(ctrl.getFieldValue('dateToEmpty') ? AC.dateService.shiftDate(ctrl.getFieldValue('dateToEmpty')) : null)
                          me.down('[name=targetRlDepName]').setValue(ctrl.getFieldValue('depName') || null)
                          me.down('[name=targetRlPosName]').setValue(ctrl.getFieldValue('posName') || null)
                        }
                      }
                    }
                  },
                  {
                    layout: { type: 'hbox' },
                    margin: '0 15 0 145',
                    items: [
                      {
                        xtype: 'ubdatefield',
                        name: 'targetRlDateFrom',
                        fieldLabel: UB.i18n('Дата прийому'),
                        readOnly: true,
                        labelWidth: 100,
                        width: 200
                      },
                      {
                        xtype: 'ubdatefield',
                        name: 'targetRlDateTo',
                        fieldLabel: UB.i18n('Дата звільнення'),
                        readOnly: true,
                        labelWidth: 140,
                        width: 240
                      }
                    ]
                  },
                  {
                    xtype: 'textfield',
                    name: 'targetRlDepName',
                    fieldLabel: UB.i18n('Підрозділ'),
                    readOnly: true,
                    margin: '0 15 0 160',
                    labelWidth: 100,
                    width: 500
                  },
                  {
                    xtype: 'textfield',
                    name: 'targetRlPosName',
                    fieldLabel: UB.i18n('Посада'),
                    margin: '0 15 0 160',
                    readOnly: true,
                    labelWidth: 100,
                    width: 500
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Виконати'),
                    text: UB.i18n('Виконати'),
                    iconCls: 'fas fa-cloud-download-alt',
                    cls: 'fill-action',
                    margin: '5 0 5 15',
                    width: 150,
                    handler: async function (btn) {
                      if (me.attr.sourceRlID.getValue() && me.attr.targetRlID.getValue()) {
                        if (me.attr.sourceRlID.getFieldValue('employeeID') !== me.attr.targetRlID.getFieldValue('employeeID')) {
                          const res = await $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n('Увага! Особові рахунки належать різним особам! Все одно переносити?'))
                          if (!res) {
                            return
                          }
                        }
                        if (me.attr.sourceRlID.getFieldValue('workPlaceCode') === '1') {
                          const res = await $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n('Увага! Ви дійсно хочите перенести нарахування з табельного номера, у якому місцем роботи=Основне?'))
                          if (!res) {
                            return
                          }
                        }
                        if (me.attr.targetRlID.getFieldValue('workPlaceCode') !== '1') {
                          const res = await $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n('Увага! Ви дійсно хочите перенести нарахування на табельний номер, у якому місцем роботи = {0} ?', me.attr.targetRlID.getFieldValue('workPlace') || ''))
                          if (!res) {
                            return
                          }
                        }
                        const periodText = (!me.attr.periodFromRlID.getValue() && !me.attr.periodToRlID.getValue())
                          ? UB.i18n('за всі місяці')
                          : (!me.attr.periodFromRlID.getValue() && me.attr.periodToRlID.getValue())
                            ? `${UB.i18n('за всі місяці')} ${UB.i18n('по')} ${me.attr.periodToRlID.getFieldValue('name')}`
                            : (me.attr.periodFromRlID.getValue() && !me.attr.periodToRlID.getValue())
                              ? `${UB.i18n('за всі місяці')} ${UB.i18n('з')} ${me.attr.periodFromRlID.getFieldValue('name')}`
                              : `${UB.i18n('за період')} ${UB.i18n('з')} ${me.attr.periodFromRlID.getFieldValue('name')} ${UB.i18n('по')} ${me.attr.periodToRlID.getFieldValue('name')}`

                        const resRl = await $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n('Перенести записи з розрахункового листа {0} {1} у розрахунковий лист {2}?',
                          me.attr.sourceRlID.getFieldValue('description'), periodText, me.attr.targetRlID.getFieldValue('description')))
                        if (resRl) {
                          me.setLoading(true)
                          $App.connection.run({
                            entity: 'hr_importCustom',
                            method: 'transferRl',
                            orgID: appAC.globalOrganization(),
                            sourceRlID: me.attr.sourceRlID.getValue(),
                            targetRlID: me.attr.targetRlID.getValue(),
                            periodFromRlID: me.attr.periodFromRlID.getValue(),
                            periodToRlID: me.attr.periodToRlID.getValue()
                          }).then(response => {
                            me.setLoading(false)
                            $App.dialogInfo(UB.i18n('Операція успішно виконана'))
                          }, (err) => {
