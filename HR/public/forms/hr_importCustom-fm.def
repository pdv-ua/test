                    boxLabelAlign: 'before',
                    fieldLabel: UB.i18n('З будь-яких джерел фінансування включно з пустим та видаленим'),
                    listeners: {
                      change: function (ctrl, value) {
                        if (value) {
                          me.down('[name=nullFundSource]').setValue(false)
                          me.down('[name=delFundSource]').setValue(false)
                          me.down('[name=dictFundSourceIDFrom]').setValueById()
                        }
                      }
                    }
                  },
                  {
                    xtype: 'checkboxfield',
                    name: 'nullFundSource',
                    labelWidth: 380,
                    boxLabelAlign: 'before',
                    fieldLabel: UB.i18n('Тільки з пустим джерелом фінансування'),
                    listeners: {
                      change: function (ctrl, value) {
                        if (value) {
                          me.down('[name=allFundSource]').setValue(false)
                          me.down('[name=delFundSource]').setValue(false)
                          me.down('[name=dictFundSourceIDFrom]').setValueById()
                        }
                      }
                    }
                  },
                  {
                    xtype: 'checkboxfield',
                    name: 'delFundSource',
                    labelWidth: 380,
                    boxLabelAlign: 'before',
                    fieldLabel: UB.i18n('Тільки з видаленим джерелом фінансування'),
                    listeners: {
                      change: function (ctrl, value) {
                        if (value) {
                          me.down('[name=allFundSource]').setValue(false)
                          me.down('[name=nullFundSource]').setValue(false)
                          me.down('[name=dictFundSourceIDFrom]').setValueById()
                        }
                      }
                    }
                  },
                  {
                    xtype: 'ubcombobox',
                    name: 'dictFundSourceIDFrom',
                    fieldLabel: UB.i18n('Тільки з'),
                    valueField: 'ID',
                    displayField: 'name',
                    width: 800,
                    labelWidth: 380,
                    ubRequest: {
                      entity: 'ac_fundSource',
                      method: 'selectByOrg',
                      fieldList: ['ID', 'name']
                    },
                    beforeQuerySend: (ctrl) => {
                      const me = ctrl.combo.up('form')
                      ctrl.combo.store.ubRequest.orgID = me.record.get('orgID') || appAC.globalOrganization()
                      ctrl.combo.store.ubRequest.__allowSelectSafeDeleted = true
                    },
                    listeners: {
                      change: function (ctrl, value) {
                        if (value) {
                          me.down('[name=nullFundSource]').setValue(false)
                          me.down('[name=allFundSource]').setValue(false)
                          me.down('[name=delFundSource]').setValue(false)
                        }
                      }
                    }
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'textarea',
                        rows: 3,
                        labelWidth: 380,
                        width: 800,
                        hidden: true,
                        name: 'tabNumsFundSource',
                        fieldLabel: UB.i18n('Табельні номери (через кому)')
                      },
                      {
                        xtype: 'ubcombobox',
                        name: 'dictFundSourceIDTo',
                        fieldLabel: UB.i18n('На джерело фінансування'),
                        valueField: 'ID',
                        displayField: 'name',
                        width: 600,
                        labelWidth: 200,
                        ubRequest: {
                          entity: 'ac_fundSource',
                          method: 'selectByOrg',
                          fieldList: ['ID', 'name']
                        },
                        beforeQuerySend: (ctrl) => {
                          const me = ctrl.combo.up('form')
                          ctrl.combo.store.ubRequest.orgID = me.record.get('orgID') || appAC.globalOrganization()
                        }
                      }
                    ]
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Перенести'),
                    text: UB.i18n('Перенести'),
                    iconCls: 'fas fa-cloud-download-alt',
                    cls: 'fill-action',
                    margin: '5 0 5 15',
                    width: 150,
                    handler: async () => {
                      const allFundSource = me.down('[name=allFundSource]').getValue()
                      const nullFundSource = me.down('[name=nullFundSource]').getValue()
                      const delFundSource = me.down('[name=delFundSource]').getValue()
                      const dictFundSourceIDFrom = me.down('[name=dictFundSourceIDFrom]').getValue()
                      const dictFundSourceIDTo = me.down('[name=dictFundSourceIDTo]').getValue()
                      const tabNumsFundSource = me.down('[name=tabNumsFundSource]').getValue()

                      const currPeriod = await appHR.getCurrentPeriod(appAC.globalOrganization())

                      if (!dictFundSourceIDTo) {
                        return $App.dialogInfo('Необхідно заповнити поле "На джерело фінансування".', 'Увага!')
                      }
                      if (!allFundSource && !nullFundSource && !delFundSource && !dictFundSourceIDFrom) {
                        return $App.dialogInfo('Не вказане джерело фінансування, з якого треба перенести залишки, та не стоїть ознака "Зі всіх джерел фінансування"! Вкажіть джерела фінансування, з яких перенести залишки.', 'Увага!')
                      }
                      if (dictFundSourceIDFrom && dictFundSourceIDTo && dictFundSourceIDFrom === dictFundSourceIDTo) {
                        return $App.dialogInfo('Перенесення залишків на те ж саме джерело фінансування не має сенсу!', 'Увага!')
                      }
                      let msg = ''
                      if (allFundSource) {
                        msg = `Перенести всі залишки на початок періоду ${currPeriod.description} на джерело фінансування ${me.down('[name=dictFundSourceIDTo]').getFieldValue('name')}?`
                      } else if (nullFundSource) {
                        msg = `Перенести всі залишки на початок періоду ${currPeriod.description} з пустим джерелом фінансування на джерело фінансування ${me.down('[name=dictFundSourceIDTo]').getFieldValue('name')}?`
                      } else if (delFundSource) {
                        msg = `Перенести всі залишки на початок періоду ${currPeriod.description} з видаленим джерелом фінансування на джерело фінансування ${me.down('[name=dictFundSourceIDTo]').getFieldValue('name')}?`
                      } else if (dictFundSourceIDFrom) {
                        msg = `Перенести всі залишки на початок періоду ${currPeriod.description} з джерела фінансування ${me.down('[name=dictFundSourceIDFrom]').getFieldValue('name')} на джерело фінансування ${me.down('[name=dictFundSourceIDTo]').getFieldValue('name')}?`
                      }
                      $App.dialogYesNo(UB.i18n('Попередження'), msg)
                        .then(res => {
                          if (res) {
                            me.setLoading(true)
                            $App.connection.run({
                              entity: 'hr_importCustom',
                              method: 'updateFundBalance',
                              orgID: appAC.globalOrganization(),
                              allFundSource,
                              nullFundSource,
                              delFundSource,
                              dictFundSourceIDFrom,
                              dictFundSourceIDTo,
                              tabNumsFundSource
                            }).then(response => {
                              me.setLoading(false)
                              $App.dialogInfo(response.result === 'OK' ? UB.i18n('Операція успішно виконана') : response.result || UB.i18n('Виконано'))
                            }, (err) => {
                              me.setLoading(false)
                              if (err.config && err.config.timeout) {
                                $App.dialogInfo(UB.i18n('Операція виконується на сервері застосувань,\n та потребує додаткового часу для завершення.\n Зачекайте будь ласка, операцію буде виконано'))
                              } else {
                                throw err
                              }
                            })
                          }
                        })
                    }
                  }
                ]
              },
              {
                margin: '5 15 5 15',
                title: UB.i18n('Видалення перенесення залишків джерел фінансування'),
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'vbox' },
                items: [
