                        cls: 'fill-action',
                        margin: '5 0 5 15',
                        width: 150,
                        handler: () => {
                          const payElFromID = me.down('[name=payElFromID]').getValue()
                          const payElToID = me.down('[name=payElToID]').getValue()
                          if (payElFromID && payElToID) {
