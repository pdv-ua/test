                          orgID: {
                            expression: '[orgID]',
                            condition: 'equal',
                            value: appAC.globalOrganization()
                          }
                        }
                        if (!this.whereListIsSet) this.whereListIsSet = true
                        else this.store.reload()
                      }
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Змінити поточний розрахунковий період'),
                    text: UB.i18n('Змінити'),
                    iconCls: 'fas fa-cloud-download-alt',
                    cls: 'fill-action',
                    margin: '5 0 5 15',
                    width: 150,
                    handler: () => {
                      const dateFrom = me.down('[name=dictPeriod]').getFieldValue('dateFrom')
                      if (!dateFrom) {
                        AC.viewUtils.showToast(UB.i18n('Не визначено розрахунковий період'))
                        return
                      }

                      $App.dialogYesNo(UB.i18n('Зміна поточного розрахункового періоду'), UB.i18n('Буде змінено поточний розрахунковий період для поточної організації та усіх підпорядкованих організацій. Продовжити?'))
                        .then(res => {
                          if (res) {
                            me.setLoading(true)
                            $App.connection.run({
                              entity: 'hr_importCustom',
                              method: 'updateDictPeriod',
                              orgID: appAC.globalOrganization(),
                              dateFrom: dateFrom
                            }).then(response => {
                              me.setLoading(false)
                              $App.dialogInfo(response.result === 'OK' ? UB.i18n('Зміна поточного розрахункового періоду') : response.result || UB.i18n('Виконано'))
                            }, (err) => {
                              me.setLoading(false)
                              if (err.config && err.config.timeout) {
                                $App.dialogInfo(UB.i18n('Операція виконується на сервері застосувань,\n та потребує додаткового часу для завершення.\n Зачекайте будь ласка, операцію буде виконано'))
                              } else {
                                throw err
                              }
                            })
                          }
                        })
                    }
                  }
                ]
              },
              {
                xtype: 'fieldset',
                margin: '5 15 5 15',
                title: `${`<span style="color:red;">`}${UB.i18n('Змінити особу у всіх сутностях')}${`</span>`}`,
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'hbox' },
                items: [
                  {
                    xtype: 'ubcombobox',
                    name: 'employeeSourceID',
                    displayField: 'taxCode',
                    fieldLabel: UB.i18n('З особи'),
                    ubRequest: {
                      entity: 'hr_employee',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['ID', 'taxCode', 'fullFIO']
                    },
                    labelWidth: 120,
                    width: 440
                  },
                  {
                    xtype: 'ubcombobox',
                    name: 'employeeTargetID',
                    displayField: 'taxCode',
                    fieldLabel: UB.i18n('На особу'),
                    addPlural: true,
                    addDateTo: true,
                    ubRequest: {
                      entity: 'hr_employee',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['ID', 'taxCode', 'fullFIO']
                    },
                    labelWidth: 140,
                    width: 440
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n(`Замінити`),
                    text: UB.i18n('Замінити'),
                    iconCls: 'u-icon-copy',
                    cls: 'fill-action',
                    margin: '5 0 5 15',
                    width: 150,
                    handler: () => {
                      if (me.attr.employeeSourceID.getValue() && me.attr.employeeTargetID.getValue()) {
                        $App.dialogYesNo('Попередження', UB.i18n(`Увага! Буде замінена особа {0} на {1}. Виконати?`,
                          me.attr.employeeSourceID.getFieldValue('taxCode') + me.attr.employeeSourceID.getFieldValue('fullFIO'), me.attr.employeeTargetID.getFieldValue('taxCode') + me.attr.employeeTargetID.getFieldValue('fullFIO')))
                          .then(res => {
                            if (res) {
                              me.setLoading(true)
                              $App.connection.run({
                                entity: 'hr_importCustom',
                                method: 'changeEmployee',
                                orgID: appAC.globalOrganization(),
                                sourceID: me.attr.employeeSourceID.getValue(),
                                targetID: me.attr.employeeTargetID.getValue()
                              }).then(response => {
                                me.setLoading(false)
                                $App.dialogInfo(UB.i18n('Операція успішно виконана'))
                              }, (err) => {
                                me.setLoading(false)
                                if (err.config && err.config.timeout) {
                                  $App.dialogInfo(UB.i18n('Операція виконується на сервері застосувань,\n та потребує додаткового часу для завершення.\n Зачекайте будь ласка, операцію буде виконано'))
                                } else {
                                  throw err
                                }
                              })
                            }
                          })
                      }
                    }
                  }
                ]
              },
              {
                xtype: 'fieldset',
                margin: '5 15 5 15',
                title: `${`<span style="color:red;">`}${UB.i18n('Актуалізація mi_treePath для всіх організацій')}${`</span>`}`,
                defaults: {
                  labelWidth: 250
                },
                layout: { type: 'hbox' },
                items: [
                  {
                    layout: { type: 'vbox' },
                    items: [
                      {
                        xtype: 'label',
                        text: UB.i18n('Для актуалізація mi_treePath для всіх організацій натисніть на кнопку заповнити'),
                        cls: 'x-form-item-label',
                        margin: '10 0 0 17'
                      }
                    ],
                    width: 560
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Заповнити'),
                    text: UB.i18n('Заповнити'),
                    iconCls: 'fas fa-cloud-download-alt',
                    cls: 'fill-action',
                    margin: '5 0 5 15',
                    width: 150,
                    handler: () => {
                      $App.dialogYesNo('Попередження', UB.i18n(`Актуалізувати mi_treePath для всіх організацій ?`)).then(isAgree => {
                        if (!isAgree) {
                          return
                        }
                        me.setLoading(true)
                        $App.connection.run({
                          entity: 'hr_importCustom',
                          method: 'setMiTreePathByAllOrgs',
                          orgID: appAC.globalOrganization(),
                          onDate: appAC.globalApplicationDate()
                        }).then(response => {
                          me.setLoading(false)
                          $App.dialogInfo(UB.i18n(`Операція успішно виконана.`))
                        }, (err) => {
                          me.setLoading(false)
                          if (err.config && err.config.timeout) {
                            $App.dialogInfo(UB.i18n('Операція виконується на сервері застосувань,\n та потребує додаткового часу для завершення.\n Зачекайте будь ласка, операцію буде виконано'))
                          } else {
                            throw err
                          }
                        })
                      })
                    }
                  }
                ]
              },
              {
                xtype: 'fieldset',
                margin: '5 15 5 15',
                title: `${`<span style="color:red;">`}${UB.i18n('Заміна зовнішнього ID підрозділів ktID на clID в Express')}${`</span>`}`,
                defaults: {
                  labelWidth: 250
                },
                ubID: 'changeDepartmentKtID2ClID',
                hidden: false,
                layout: { type: 'hbox' },
                items: [
                  {
                    layout: { type: 'vbox' },
                    items: [
                      {
                        xtype: 'label',
                        text: UB.i18n('Для заміни зовнішнього ID підрозділів ktID на clID в Express для всіх організацій натисніть на кнопку заповнити'),
                        cls: 'x-form-item-label',
                        margin: '10 0 0 17'
                      }
                    ],
                    width: 560
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Заповнити'),
                    text: UB.i18n('Заповнити'),
                    iconCls: 'fas fa-cloud-download-alt',
                    cls: 'fill-action',
                    margin: '5 0 5 15',
                    width: 150,
                    handler: () => {
                      $App.dialogYesNo('Попередження', UB.i18n(`Замінити зовнішній ID підрозділів ktID на clID в Express?`)).then(isAgree => {
                        if (!isAgree) {
                          return
                        }
                        me.setLoading(true)
                        $App.connection.run({
                          entity: 'hr_importCustom',
                          method: 'changeDepartmentKtID2ClID',
                          orgID: appAC.globalOrganization(),
                          onDate: appAC.globalApplicationDate()
                        }).then(response => {
                          me.setLoading(false)
                          $App.dialogInfo(UB.i18n(`Операція успішно виконана.`))
                        }, (err) => {
                          me.setLoading(false)
                          if (err.config && err.config.timeout) {
                            $App.dialogInfo(UB.i18n('Операція виконується на сервері застосувань,\n та потребує додаткового часу для завершення.\n Зачекайте будь ласка, операцію буде виконано'))
                          } else {
                            throw err
                          }
                        })
                      })
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]

    me.timeSheetCorrect = () => {
      Ext.create('UB.view.UploadFileAjax', {
        scope: this,
        listeners: {
          afterrender: function (cmp) {
            this.fieldFile.fileInputEl.set({
              accept: '.csv'
            })
          }
        },
        upLoad: function (btn) {
          me.setLoading(true)
          const dialogWindow = btn.up('window')
          const inputDom = this.fieldFile.fileInputEl.dom
          if (inputDom.files.length === 0) {
            return
          }
          const file = inputDom.files[0]
          if (file.name.indexOf('.csv', file.name.length - 4) === -1) {
            $App.dialogInfo(UB.i18n('Невірний формат файлу, для завантаження використовується формат csv'))
            me.setLoading(false)
            return
          }
          btn.disable()

          UB.connection.post('loadImportDataEx', file, {
            params: {
              entityName: '',
              encoding: 'win1251',
              fileName: file.name
            },
            headers: { 'Content-Type': 'application/octet-stream' }
          }).then(response => {
            me.setLoading(false)
            const data = response.data
            const attrs = [ 'ID', 'periodID', 'employeeNumberID', 'dateWork', 'planID', 'planTimeCostID', 'planHour',
              'planHourNight', 'planHourEvening', 'factTimeCostID', 'factHour', 'factHourNight', 'factHourEvening',
              'isActive', 'mtCount', 'factPlanHour', 'isCorrection' ]
            const parsedData = []
            data && data.forEach((item, key) => {
              if (key === 0) {
                return
              }
              let row = {}
              attrs.forEach((attr, idx) => {
                row[attr] = attr === 'dateWork' ? item[idx] : Number(item[idx])
              })
              parsedData.push(row)
            })
            $App.connection.run({
              entity: 'hr_importCustom',
              method: 'timeSheetCorrect',
              data: JSON.stringify(parsedData),
              orgID: appAC.globalOrganization()
            }).then(response => {
              $App.dialogInfo(UB.i18n('Завершено'))
            })
          }, (err) => {
            me.setLoading(false)
            if (err.config && err.config.timeout) {
              $App.dialogInfo(UB.i18n('Операція виконується на сервері застосувань,\n та потребує додаткового часу для завершення.\n Зачекайте будь ласка, операцію буде виконано'))
            } else {
              throw err
            }
          }).finally(() => {
            me.setLoading(false)
          })
          dialogWindow.close()
        }
      })
    }
    me.periodAttrs = ['sourceID', 'targetID', 'periodID', 'esvPeriodID', 'sourceRlID', 'targetRlID', 'periodFromRlID', 'periodToRlID',
      'tariffRlPeriodFromID', 'tariffRlPeriodToID', 'impRlPeriodFromID', 'impRlPeriodToID', 'corPeriodFromID', 'corPeriodToID',
      'corMissionPeriodFromID', 'corMissionPeriodToID']
    me.changeGlobal = () => {
      const globalOrganization = appAC.globalOrganization()
      me.periodAttrs.forEach(periodAttrName => {
        AC.viewUtils.setFilterValue(me.attr[periodAttrName], { orgID: globalOrganization }, ['clearValue'])
      })
      AC.viewUtils.setWhereListProperty(me.attr.workScheduleFrom, [
        [ 'organizationID', 'equal', globalOrganization ],
        [ 'organizationID', 'isNull', globalOrganization ]
      ], ['[organizationID] OR [orgIsNull]'], ['clearValue', 'clearStore'])
      AC.viewUtils.setWhereListProperty(me.attr.workScheduleTo, [
        [ 'organizationID', 'equal', globalOrganization ],
        [ 'organizationID', 'isNull', globalOrganization ]
      ], ['[organizationID] OR [orgIsNull]'], ['clearValue', 'clearStore'])
      AC.viewUtils.setWhereListProperty(me.attr.departmentID, [
        ['orgID', '=', globalOrganization || 0],
        ['state', '=', 'ACTIVE']
      ], null, ['clearStore', 'clearWhereList', 'clearValue'])
      appHR.getCurrentPeriod(globalOrganization).then(currentPeriod => {
        if (currentPeriod) {
          me.attr.periodID.setValueById(currentPeriod.ID)
          me.attr.esvPeriodID.setValueById(currentPeriod.priorPeriodID)
          me.attr.periodFromRlID.setValueById(null)
          me.attr.periodToRlID.setValueById(currentPeriod.priorPeriodID)
          me.attr.tariffRlPeriodFromID.setValueById(null)
          me.attr.tariffRlPeriodToID.setValueById(currentPeriod.priorPeriodID)
          me.attr.impRlPeriodFromID.setValueById(null)
          me.attr.impRlPeriodToID.setValueById(null)
          me.attr.corPeriodFromID.setValueById(null)
          me.attr.corPeriodToID.setValueById(null)
          me.attr.corMissionPeriodFromID.setValueById(null)
          me.attr.corMissionPeriodToID.setValueById(null)
        } else {
          me.periodAttrs.forEach(periodAttrName => {
            me.attr[periodAttrName].setValueById(null)
          })
        }
      })
    }

    me.on('destroy', () => {
      $App.un('ac:app:organizationChanged', me.changeGlobal)
    }, me)
    me.on('afterrender', () => {
      const me = this

      me.attr = {
        dictCategoryECBID: me.down('[name=dictCategoryECBID]'),
        sourceID: me.down('[name=sourceID]'),
        targetID: me.down('[name=targetID]'),
        workScheduleFrom: me.down('[name=workScheduleFrom]'),
        workScheduleTo: me.down('[name=workScheduleTo]'),
        isIndexDateFrom: me.down('[name=isIndexDateFrom]'),
        departmentID: me.down('[name=departmentID]'),
        periodID: me.down('[name=periodID]'),
        esvPeriodID: me.down('[name=esvPeriodID]'),
        sourceRlID: me.down('[name=sourceRlID]'),
        targetRlID: me.down('[name=targetRlID]'),
        periodFromRlID: me.down('[name=periodFromRlID]'),
        periodToRlID: me.down('[name=periodToRlID]'),
        tariffRlPeriodFromID: me.down('[name=tariffRlPeriodFromID]'),
        tariffRlPeriodToID: me.down('[name=tariffRlPeriodToID]'),
        impRlPeriodFromID: me.down('[name=impRlPeriodFromID]'),
        impRlPeriodToID: me.down('[name=impRlPeriodToID]'),
        corPeriodFromID: me.down('[name=corPeriodFromID]'),
        corPeriodToID: me.down('[name=corPeriodToID]'),
        corMissionPeriodFromID: me.down('[name=corMissionPeriodFromID]'),
        corMissionPeriodToID: me.down('[name=corMissionPeriodToID]'),
        employeeSourceID: me.down('[name=employeeSourceID]'),
        employeeTargetID: me.down('[name=employeeTargetID]')
      }

      me.periodAttrs.forEach(periodAttrName => {
        AC.viewUtils.setFilterValue(me.attr[periodAttrName], { orgID: appAC.globalOrganization() }, ['clearValue'])
      })

      AC.viewUtils.setWhereListProperty(me.attr.workScheduleFrom, [
        [ 'organizationID', 'equal', appAC.globalOrganization() ],
        [ 'organizationID', 'isNull', appAC.globalOrganization() ]
      ], ['[organizationID] OR [orgIsNull]'])
      AC.viewUtils.setWhereListProperty(me.attr.workScheduleTo, [
        [ 'organizationID', 'equal', appAC.globalOrganization() ],
        [ 'organizationID', 'isNull', appAC.globalOrganization() ]
      ], ['[organizationID] OR [orgIsNull]'])
      AC.viewUtils.setWhereListProperty(me.attr.departmentID, [
        ['orgID', '=', appAC.globalOrganization() || 0],
        ['state', '=', 'ACTIVE']
      ])
      appHR.getCurrentPeriod(appAC.globalOrganization()).then(currentPeriod => {
        if (currentPeriod) {
          me.attr.periodID.setValueById(currentPeriod.ID)
          me.attr.esvPeriodID.setValueById(currentPeriod.priorPeriodID)
          me.attr.periodToRlID.setValueById(currentPeriod.priorPeriodID)
        }
      })
      if ($App.domainInfo.models['INTEGRATOR']) {
        me.down('[ubID=changeDepartmentKtID2ClID]').show()
      }
      $App.on('ac:app:organizationChanged', me.changeGlobal)
    }, me)

    me.callParent(arguments)
  }
})
