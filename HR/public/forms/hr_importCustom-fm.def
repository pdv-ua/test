                      () => {
                        return {
                          entity: 'hr_importCustom',
                          method: 'createAccrualDt',
                          orgID: appAC.globalOrganization(),
                          periodID: me.attr.periodID.getValue(),
                          childOrg: me.down('[name=createAccrualDtChildOrg]').getValue(),
                          allPayEl: me.down('[name=createAccrualDtAllPayEl]').getValue(),
