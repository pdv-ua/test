/* global UB appAC HR */
exports.formDef = {
  size: {
    width: 1100,
    height: 700
  },
  requiredFields: ['organizationID', 'srcOrganizationID', 'srcOrganizationName', 'srcOrganizationID.name', 'impSourceID', 'educationOrgID',
    'educationName', 'dictTrainingTopicID', 'dictTrainingTopicName', 'byOrganizationID', 'byOrganizationName', 'byOrganizationID.name', 'orderID'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'vbox', align: 'stretch' },
    defaults: { labelWidth: 200 }
  },
  items: [
    { attributeName: 'employeeID', hidden: true },
    {
      layout: { type: 'hbox' },
      items: [
        { attributeName: 'isInsideCountry', labelWidth: 200, width: 220 },
        {
          attributeName: 'countryID',
          labelWidth: 60,
          flex: 1,
          disabledIf: (ctrl, me) => me.attr.isInsideCountry.getValue(),
          requiredIf: (ctrl, me) => !me.attr.isInsideCountry.getValue()
        }
      ]
    },
    HR.controlService.getIDNameCombo({
      fieldID: 'byOrganizationID',
      fieldName: 'byOrganizationName',
      fieldLabel: UB.i18n('За рахунок'),
      maxLength: 200,
      ubRequest: {
        entity: 'hr_organization',
        fieldList: ['ID', 'name'],
        whereList: {
          isActive: {
            expression: '[state]',
            condition: 'equal',
            value: 'ACTIVE'
          }
        },
        orderList: { orderBy: { expression: 'name' } },
        __mip_ondate: appAC.globalApplicationDate()
      }
    }),
    HR.controlService.getEduOrgCombo({
      fieldID: 'educationOrgID',
      fieldName: 'educationName',
      onControlChange: (ctrl, value) => {
        const form = ctrl.up('form')
        form.attr.docIssuer.setValue(value)
      }
    }),
    {
      layout: { type: 'hbox' },
      items: [
        { attributeName: 'dateFrom', labelWidth: 200, width: 320 },
        { attributeName: 'dateTo', labelWidth: 120, width: 240, margin: '5 15 5 0' }
      ]
    },
    {
      xtype: 'fieldset',
      title: UB.i18n('Підготовка'),
      layout: { type: 'vbox', align: 'stretch' },
      margin: '0 15 10 10',
      defaults: { labelWidth: 180 },
      items: [
        { attributeName: 'groupCategory', disableContextMenu: false, hideEntityItemInContext: true },
        {
          attributeName: 'dictProfCompDevelopFormID',
          fieldLabel: UB.i18n('Вид професійного навчання'),
          whereList: {
            isActive: {
              expression: '[isActive]',
              condition: 'equal',
              value: 1
            }
          }
        },
        { attributeName: 'dictProfCompetencyID' },
        HR.controlService.getIDNameCombo({
          fieldID: 'dictTrainingTopicID',
          fieldName: 'dictTrainingTopicName',
          fieldLabel: UB.i18n('Тематика'),
          maxLength: 260,
          ubRequest: {
            entity: 'hr_dictTrainingTopic',
            fieldList: ['ID', 'name'],
            orderList: { orderBy: { 'expression': 'name', 'order': 'asc' } }
          }
        }),
        { attributeName: 'trainingDirection' }
      ]
    },
    {
      layout: { type: 'hbox' },
      items: [
        { attributeName: 'hours', labelWidth: 200, width: 320 },
        { attributeName: 'ects', labelWidth: 105, width: 225 }
      ]
    },
    { attributeName: 'comment' },
    {
      xtype: 'fieldset',
      title: UB.i18n('Документ'),
      layout: { type: 'vbox', align: 'stretch' },
      margin: '0 15 10 10',
      defaults: { labelWidth: 180 },
      items: [
        { attributeName: 'docType', disableContextMenu: false, hideEntityItemInContext: true },
        { attributeName: 'dictDocKindID', recordField: 'dictDocKindID', hidden: true },
        {
          attributeName: 'employeeDocID',
          fieldList: ['ID', 'dictDocKindID', 'docSeries', 'docNumber', 'docIssued', 'docIssuedDate', 'employeeID', 'description'],
          gridFieldList: ['description', 'docIssued'],
          displayField: 'description',
          labelWidth: 180
        },
        {
          layout: { type: 'hbox' },
          items: [
            { attributeName: 'docNumber', labelWidth: 180, width: 300, recordField: 'docNumber' },
            { attributeName: 'docSeries', labelWidth: 105, width: 225, recordField: 'docSeries' },
            { attributeName: 'docDate', labelWidth: 100, width: 220, recordField: 'docIssuedDate' }
          ]
        },
        { attributeName: 'docIssuer', recordField: 'docIssued', margin: '5 15 5 15' }
      ]
    },
    {
      xtype: 'fieldset',
      title: UB.i18n('Наказ'),
      layout: { type: 'vbox', align: 'stretch' },
      margin: '0 15 10 10',
      items: [
        {
          layout: { type: 'hbox' },
          items: [
            { attributeName: 'orderNumber', labelWidth: 180, width: 300 },
            { attributeName: 'orderDate', labelWidth: 105, width: 225 }
          ]
        },
        HR.controlService.getIDNameCombo({
          fieldID: 'srcOrganizationID',
          fieldName: 'srcOrganizationName',
          fieldLabel: UB.i18n('Ким виданий'),
          labelWidth: 180,
          maxLength: 200,
          ubRequest: {
            entity: 'hr_organization',
            fieldList: ['ID', 'name'],
            whereList: {
              isActive: {
                expression: '[state]',
                condition: 'equal',
                value: 'ACTIVE'
              }
            },
            orderList: { orderBy: { expression: 'name' } },
            __mip_ondate: appAC.globalApplicationDate()
          }
        })
      ]
    }
  ]
}
