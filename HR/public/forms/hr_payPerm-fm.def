      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        {
          layout: { type: 'hbox' },
          items: [
            {
              layout: { type: 'vbox' },
              defaults: {
                labelWidth: 170
              },
              flex: 1,
              items: [
                {
                  attributeName: 'payElID',
                  width: '100%',
                  fieldList: ['ID', 'description', 'methodID.methodGroupID.groupType', 'isAutoCalc', 'methodID.valuation', 'codeSort', 'methodID.code'],
                  orderList: { orderBy: { expression: 'codeSort' } }
                },
                { attributeName: 'dateFromEmpty' },
                { attributeName: 'dateToEmpty' },
                { attributeName: 'paySum', hidden: true, width: 330 },
                { attributeName: 'rate', hidden: true, width: 330 },
                { attributeName: 'limitSum', hidden: true, width: 330 }
              ]
            },
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              defaults: {
                labelWidth: 170
              },
              items: [
                {
                  attributeName: 'dictFundSourceID',
                  fieldList: ['ID', 'name']
                },
                {
                  xtype: 'accountDimensionsControl',
                  name: 'dimControl',
                  fieldLabel: UB.i18n('Рахунок витрат'),
                  accountDisplayField: 'description',
                  allowBlank: true,
                  allowBlankDims: true,
                  getDefaultDimension: HR.accrualService.getDefaultDimension
                }
              ]
            }
          ]
        }
      ]
    },
    {
      xtype: 'tabpanel',
      region: 'center',
      items: [
        {
          title: UB.i18n('Організації'),
          layout: { type: 'border' },
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              region: 'north',
              items: [
                {
                  attributeName: 'excludeOrg'
                }
              ]
            },
            {
              xtype: 'ubdetailgrid',
              region: 'center',
              name: 'organization',
              autoScroll: true,
              hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
              flex: 1,
              entityConfig: {
                entity: 'hr_payPermDt',
                method: 'select',
                fieldList: [
                  {
                    name: 'orgID.description',
                    description: UB.i18n('Організація'),
                    simpleFilter: true
                  }
                ],
                whereList: {
                  orgID: {
                    expression: '[orgID.state]',
                    condition: 'equal',
                    value: 'ACTIVE'
                  },
                  permType: {
                    expression: '[permType]',
                    condition: 'equal',
                    value: '1'
                  }
                }
              },
              masterFields: ['ID'],
              detailFields: ['payPermID'],
              cmpInitConfig: {
                customActions: [
                  {
                    text: UB.i18n('Редагувати'),
                    iconCls: 'u-icon-edit-alt',
                    cls: 'fill-action',
                    scale: 'medium',
                    handler: function (btn) {
                      const grid = btn.up('grid')
                      const form = grid.up('form')
                      if (form.isNewInstance) {
                        form.saveForm().then(result => {
                          if (result !== -1) {
                            form.changeGridValue(form, grid)
                          }
                        })
                      } else {
                        form.changeGridValue(form, grid)
                      }
                    }
                  }
                ],
                onItemDblClick: function (grid) {
                  const form = grid.up('form')
                  form.changeGridValue(form, grid.ownerCt)
                },
                onDeterminateForm: function () {
                  return {
                    cmpInitConfig: {
                      defaultValues: { permType: '1' }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          title: UB.i18n('Підрозділи'),
