              },
              {
                attributeName: 'reportDate',
                labelWidth: 150,
                showIf: (ctrl, me) => me.record.get('isNeedReport')
              }
            ]
          }
        ]
      },
      {
        xtype: 'fieldset',
        title: UB.i18n('Наказ'),
