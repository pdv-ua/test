      },
      {
        layout: {
          type: 'hbox',
          align: 'stretch'
        },
        items: [
          {
            attributeName: 'isInsideCountry',
            labelWidth: 135,
            readOnly: true
          },
          {
            attributeName: 'countryID',
            labelWidth: 100,
            flex: 1,
            showIf: (ctrl, me) => !me.record.get('isInsideCountry'),
            readOnly: true
          }
        ]
      },
      {
        layout: {
          type: 'hbox',
          align: 'middle'
        },
        items: [
          {
            attributeName: 'destOrganizationName',
