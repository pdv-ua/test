            readOnly: true,
            flex: 1
          }
        ]
      },
      {
        layout: {
          type: 'hbox',
          align: 'middle'
        },
        items: [{
          attributeName: 'dateFrom',
          labelWidth: 135,
          readOnly: true
        },
        {
          attributeName: 'dayCount',
          labelWidth: 50,
          width: 120,
          readOnly: true
        },
        {
          attributeName: 'dateTo',
          labelWidth: 70,
          readOnly: true
        }
        ]
      },
      {
        attributeName: 'purpose',
        fieldLabel: UB.i18n('З метою'),
        readOnly: true
      },
      {
        attributeName: 'reason',
        readOnly: true,
        hidden: true
      },
      {
        xtype: 'fieldset',
        title: UB.i18n('Інформація про звіт'),
        layout: { type: 'vbox', align: 'stretch' },
        margin: '0 10 10 10',
        items: [
          {
            attributeName: 'requisites'
