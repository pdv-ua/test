exports.formDef = (function () {
  return {
    requiredFields: ['orderID', 'organizationID', 'employeeNumberID',
      'destOrganizationName', 'cityName', 'destOrganizationID', 'cityID', 'organizationID.name'
    ],
    parentConfig: {
