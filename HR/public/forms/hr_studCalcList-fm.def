/* global Ext $App HR AC appAC UB */
exports.formDef = 'HR.studCalcList'

Ext.define('HR.studCalcList', {
  extend: 'Ext.form.Panel',
  alias: 'widget.studCalcList',
  width: 800,
  height: 400,
  layout: { type: 'vbox', align: 'stretch' },
  autoScroll: true,
  flex: 1,
  items: [
    {
      xtype: 'panel',
      region: 'center',
      name: 'reportPanel',
      flex: 1,
      items: []
    }
  ],
  initComponent: function () {
    const me = this
    const control = Ext.create('Ext.Component', {
      flex: 1,
      margin: 0,
      autoEl: {
        tag: 'iframe'
      }
    })
    const container = Ext.create('Ext.panel.Panel', {
      layout: { type: 'vbox', align: 'stretch' },
      flex: 1,
      items: [
        {
          flex: 1,
          autoScroll: true,
          layout: { type: 'hbox', pack: 'center', align: 'stretch' },
          bodyCls: 'ub-panel-gray',
          items: [control]
        }]
    })
    me.items = [container]
    me.reportControl = control
    me.on('afterrender', function () {
      me.showDesktop()
    })
    me.callParent(arguments)
  },
  showDesktop: async function () {
    const me = this
    const iFrameDoc = me.reportControl.getEl().dom.contentDocument


    let template = `
<table
        style="
          border-collapse: collapse;
          width: 730px;
          word-break: break-word;
        "
        border="0px"
        cellspacing="0"
        cellpadding="3px"
      >
        <tbody>
<tr> 
<td width="600" style="vertical-align: top;">
          <table style="border-collapse: collapse; word-break: break-word;" border="0px" cellspacing="0" cellpadding="3px">
            <tbody>
             <tr> 
             <td style=" width:50%; height:24px; font-size: 16px; padding-left: 30px;">
                <b><span>${UB.i18n('Розрахунок стипендії')}</span></b>
              </td>
            </tr>
            <tr> 
              <td style="width:50%; height:24px; font-size:14px; padding-left: 30px;">
                <a href="#" data-code='hr_dictPeriod'>
                  ${UB.i18n('Розрахункові періоди')}
                </a>
                <br><i>Закрийте попередній розрахунковий період</i>
                </td>
             </tr>
             <tr>  
    <td style="width:50%; height:24px; font-size:14px; padding-left: 30px;">
                <a href="#" data-code='hr_dictStipendAmount'>
                  ${UB.i18n('Розмір стипендії')}
                </a>
                <br><i>Перевірте, що розмір стипендії на поточний місяць вказаний вірно, за потреби внесіть зміни</i>
              </td>
              </tr>
              <tr> 
              <td style="width:50%; height:24px; font-size:14px; padding-left: 30px;">
                <a href="#" data-code='hr_importStudentAPI'>
                  ${UB.i18n('Завантаження з АСУ ВНЗ')}
                </a>
                <br><i>Завантажте поточну інформацію по студентам з деканату</i>
              </td>
              </tr>
              <tr> 
              <td style="width:50%; height:24px; font-size:14px; padding-left: 30px;">
                <a href="#" data-code='hr_employeeStudList'>
                  ${UB.i18n('Особові рахунки студентів')}
                </a>
                <br><i>За потреби внесіть інформацію про зміни в соціальних або іменних стипендіях студентів.</i>
              </td>
              </tr>
              <tr> 
              <td style="width:50%; height:24px; font-size:14px; padding-left: 30px;">
                <a href="#" data-code='hr_payRollList'>
                  ${UB.i18n('Платіжні відомості')}
                </a>
                <br><i>Створіть платіжні відомості</i>
              </td>  
                    </tr>  
            </tbody>
          </table>
        </td>

        
                          
      </tr>
      </tbody>
      </table>
`








    /*`

    `*/

    iFrameDoc.body.innerHTML = template

    iFrameDoc.head.innerHTML = `
      <style type="text/css">
        body {
          background-color: #FFFFFF;
          color: #000000;
          font-family: Roboto, Arial, Helvetica, sans-serif;
          font-size: 14px;
          line-height: 1.3;
        }
        a {
          text-decoration: none;
          color: #2f7c94;
        }
        td,th {
          font-family: Roboto,Arial,Helvetica,sans-serif;
          font-size: 14px
        }
      </style>`

    const refs = iFrameDoc.getElementsByTagName('a')
    for (let i = 0, L = refs.length; i < L; i++) {
      refs[i].addEventListener('click', me.onReportClick, true)
    }
  },
  onReportClick: (e) => {
    e.preventDefault()
    let shortcutCode = e.target.dataset.code
    if (shortcutCode) {
      $App.runShortcutCommand(shortcutCode)
    }
  }
})
