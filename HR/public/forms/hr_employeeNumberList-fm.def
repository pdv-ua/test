// @isModal true
/* global Ext AC UB $App appAC appHR */

exports.formDef = 'HR.employeeNumberList'

Ext.define('HR.employeeNumberList', {
  extend: 'Ext.form.Panel',
  name: 'form',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.employeeNumberList',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.currentPeriod = {
      dateFrom: appAC.globalApplicationDate(),
      dateTo: appAC.globalApplicationDate()
    }

    me.settings = JSON.parse(UB.core.UBLocalStorageManager.getItem('hr_employeeNumberList') || '{"isShowAll":true}')

    // UB.core.UBLocalStorageManager.setItem('hr_employeeNumberList', JSON.stringify(settings))

    const cmdData = me.cmdData
    let cmdCustomParam = null
    if (cmdData) {
      cmdCustomParam = cmdData.customParams.mode
    }
    me.items = [
      {
        xtype: 'tabpanel',
        header: false,
        region: 'center',
        name: 'panel',
        flex: 1,
        layout: 'fit',
        margin: '8 0 0 0',
        listeners: {
          tabchange: function (tp, t) {
            me.tabSelect(tp, t)
          }
        },
        items: [
          {
            title: UB.i18n('Основні відомості'),
            xtype: 'ubdetailgrid',
            name: 'employeeNumberListGrid',
            stateful: true,
            stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_employeeNumberList_employeeNumberListGrid'),
            autoScroll: true,
            layout: 'fit',
            flex: 1,
            forceDataLoad: true,
            disableAutoLoadStore: true,
            hideActions: ['addNewByCurrent', 'edit', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
            cmdData: {
              params: [{
                entity: 'hr_employeeNumberSR',
                method: 'select',
                fieldList: [
                  { name: 'ID', visibility: false },
                  { name: 'mi_deleteUser', visibility: false },
                  { name: 'mi_deleteDate', visibility: false },
                  { name: 'workPlaceCode', visibility: false },
                  { name: 'tabNumSort', visibility: false },
                  { name: 'tabNum', description: UB.i18n('Таб. №') },
                  { name: 'employeeID', visibility: false },
                  { name: 'employeeID.lastName', description: UB.i18n('Прізвище'), simpleFilter: true },
                  { name: 'employeeID.firstName', description: UB.i18n('Ім\'я'), simpleFilter: true },
                  { name: 'employeeID.middleName', description: UB.i18n('По батькові'), simpleFilter: true },
                  { name: 'employeeID.sexType', description: UB.i18n('Стать'), simpleFilter: true },
                  { name: 'employeeID.taxCode', description: UB.i18n('РНОКПП'), simpleFilter: true },
                  { name: 'employeeID.birthDate', description: UB.i18n('Дата народження'), format: 'd.m.Y', simpleFilter: true },
                  { name: 'dateFrom', description: UB.i18n('Дата прийому'), format: 'd.m.Y' },
                  { name: 'dateToEmpty', description: UB.i18n('Дата звільнення'), format: 'd.m.Y' },
                  { name: 'depCaption' },
                  { name: 'dictStaffCatName', description: UB.i18n('Категорія персоналу') },
                  { name: 'dictPositionName', description: UB.i18n('Посада') },
                  { name: 'positionName', description: UB.i18n('Штатна посада') },
                  { name: 'mtCount', description: UB.i18n('Ставок'), format: '0.00' },
                  { name: 'dictFundSourceID' },
                  { name: 'dictProgClassID' },
                  { name: 'payElName', description: UB.i18n('Система оплати') },
                  { name: 'accrualSum', description: UB.i18n('Оклад') },
                  { name: 'dictCategoryECBName', description: UB.i18n('Категорія застрахованої особи') },
                  { name: 'accountID', description: UB.i18n('Рахунок витрат') },
                  { name: 'raiseSalary', description: UB.i18n('Місяць підвищення доходу для індексації') },
                  { name: 'workSchedule', description: UB.i18n('Графік роботи') },
                  { name: 'workerType', description: UB.i18n('Форма зайнятості') },
                  { name: 'workPlace', description: UB.i18n('Місце роботи') },
                  { name: 'dictTarifCoeffName' },
                  { name: 'limitedAccess' },
                  { name: 'orderID.orderClass.entityName', visibility: false },
                  { name: 'selfStructDepName', description: UB.i18n('Самостійний структурний підрозділ') },
                  { name: 'parentUnitDepName', description: UB.i18n('Підпорядкування підрозділу') },
                  { name: 'payOutID.name', description: UB.i18n('Шаблон виплати') },
                  { name: 'factPosition', description: UB.i18n('Фактична посада') }
                ],
                orderList: { tabNum: { expression: 'tabNumSort' } }
              }]
            },
            onDeterminateForm: function () {
              return {
                entityName: 'hr_employeeNumber',
                formCode: 'hr_employeeNumber'
              }
            },
            cmpInitConfig: {
              afterInit: function () {
                const grid = this
                AC.gridUtils.setGlobalOrganization(this, 'orgID')
                AC.gridUtils.setCustomSorter(this, 'tabNum')
                const limitedAccess = !AC.entityUtils.verifyRightsMethod('hr_employeeNumber', 'employeeLimitedAccess')
                const notShowSalary = AC.entityUtils.verifyRightsMethod('hr_service', 'notShowSalary') && !AC.entityUtils.isAdmin()

                appHR.getCurrentPeriod(appAC.globalOrganization()).then(response => {
                  me.currentPeriod = response

                  if (!me.settings.isShowAll) {
                    grid.store.ubRequest.whereList.dateFrom = {
                      expression: '[dateFrom]',
                      condition: 'lessEqual',
                      value: response.dateTo
                    }
                    grid.store.ubRequest.whereList.dateTo = {
                      expression: '[dateTo]',
                      condition: 'moreEqual',
                      value: response.dateFrom
                    }
                  }
                  grid.store.load()
                })
                if (limitedAccess || notShowSalary) {
                  const renderer = {
                    accrualSum: {
                      renderer: function (value, meta, record) {
                        return notShowSalary ? 0 : (record.get ? record.get('limitedAccess') : record[29]) ? 0 : value
                      }
                    }
                  }
                  AC.gridUtils.tuneGridColumns(this, renderer)
                }
              },
              getRowClass: function (record, rowIndex, rowParams, store) {
                let cls = ''
                let { dateToEmpty, workPlaceCode } = record.data
                let miDeleteUser = record.data.mi_deleteUser
                if (miDeleteUser) {
                  cls = 'grd-color-grey'
                } else {
                  if (['1', '3', null].includes(workPlaceCode)) cls = (dateToEmpty && AC.dateService.shiftDate(dateToEmpty) <= me.currentPeriod.dateTo) ? 'grd-color-blue' : ''
                  else if (['2', '5'].includes(workPlaceCode)) cls = (dateToEmpty && AC.dateService.shiftDate(dateToEmpty) <= me.currentPeriod.dateTo) ? 'grd-color-blue-italic' : 'grd-italic'
                  else if (workPlaceCode === '4') cls = (dateToEmpty && AC.dateService.shiftDate(dateToEmpty) <= me.currentPeriod.dateTo) ? 'grd-color-blue' : 'grd-color-lightgreen'
                }
                return cls
              }
            },
            listeners: {
              render: function (grid) {
                const me = grid.up('[customParams]')
                const whereList = grid.getStore().ubRequest.whereList
                if (me.customParams.mode === 'IMPORT') {
                  grid.actions.addNew.hide()
                  grid.actions.del.hide()
                  grid.onDel = grid.onAddNew = () => { }
                  grid.doOnEdit = function () {
                    UB.Repository(grid.entityName)
                      .attrs('employeePositionID')
                      .selectById(AC.gridUtils.getCurrentRecord(grid).get('ID'))
                      .then(rec => {
                        if (!rec.employeePositionID) {
                          AC.viewUtils.showToast(UB.i18n('Призначення не знайдено, можливо, воно закрите'))
                          return
                        }

                        $App.doCommand({
                          cmdType: 'showForm',
                          entity: 'hr_employeePosition',
                          formCode: 'hr_employeePosition-edit',
                          instanceID: rec.employeePositionID
                        })
                      })
                  }
                } else if (me.customParams.mode === 'NOSTAFF') {
                  grid.actions.del.hide()
                  grid.onDel = () => { }
                  whereList.posIsNull = { expression: '[employeePositionID.positionID]', condition: 'isNull' }
                  whereList.dateTo = { expression: '[dateTo]', condition: '>=', value: appAC.globalApplicationDate() }
                  grid.getStore().ubRequest.whereList = whereList
                } else {
                  grid.menu.add([
                    {
                      text: UB.i18n('Відновити'),
                      iconCls: 'fas fa-thumbs-up',
                      ubID: 'itemRestoreEmployee',
                      hidden: !me.viewDeleted,
                      handler: () => {
                        const reco = AC.gridUtils.getCurrentRecord(me.attr.grid)
                        if (reco && reco.get('ID') && !AC.dateService.isMaxDate(reco.get('mi_deleteDate'))) {
                          $App.connection.run({
                            entity: 'hr_employeeNumber',
                            method: 'restoreRecord',
                            execParams: {
                              ID: reco.get('ID'),
                              employeeID: reco.get('employeeID'),
                              onDate: appAC.globalApplicationDate()
                            }
                          }).then(() => {
                            grid.getStore().load()
                          })
                        }
                      }
                    }
                  ])
                }
                if (me.customParams.mode === 'IMPORT') {
                  whereList.employeePositionID = {
                    expression: '[employeePositionID]',
                    condition: 'isNotNull'
                  }
                }
                if (me.customParams.paySummaryFilter === 'employees') {
                  whereList.dateFrom = { expression: '[dateFrom]', condition: '<=', value: AC.dateService.shiftDate(me.customParams.baseDate) }
                  whereList.dateTo = { expression: '[dateTo]', condition: '>=', value: AC.dateService.shiftDate(me.customParams.firstPeriodDay) }
                } else if (me.customParams.paySummaryFilter === 'hired') {
                  whereList.dateFrom = { expression: '[dateFrom]', condition: '>=', value: AC.dateService.shiftDate(me.customParams.firstPeriodDay) }
                  whereList.dateFromAdd = { expression: '[dateFrom]', condition: '<=', value: AC.dateService.shiftDate(me.customParams.baseDate) }
                } else if (me.customParams.paySummaryFilter === 'quitted') {
                  whereList.dateTo = { expression: '[dateTo]', condition: '>=', value: AC.dateService.shiftDate(me.customParams.firstPeriodDay) }
                  whereList.dateToAdd = { expression: '[dateTo]', condition: '<=', value: AC.dateService.shiftDate(me.customParams.baseDate) }
                }
                if (me.customParams.departmentIDs) {
                  whereList.depID = { expression: '[depID]', condition: 'in', value: me.customParams.departmentIDs }
                }
                whereList.mainEmpNumberID = {
                  expression: '[mainEmpNumberID]',
                  condition: 'isNull'
                }
              }
            }
          },
          {
            title: UB.i18n('Стаж роботи'),
            xtype: 'panel',
            name: 'panelExperience',
            region: 'center',
            layout: 'fit',
            items: [],
            listeners: {
              deactivate: async function (ctrl) {
                const me = ctrl.up('form')
                if (me.gridExperience && me.gridExperience.isDirty) {
                  const isSave = await $App.dialogYesNo('Збереження', `Стаж було змінено. Зберегти зміни?`)
                  if (isSave) {
                    await me.saveGridExperience()
                  }
                }
              }
            }
          },
          {
            title: UB.i18n('KPI'),
            xtype: 'panel',
            name: 'panelKpi',
            region: 'center',
            layout: 'fit',
            items: []
          }
        ]
      }
    ]
    me.globalOrganizationChange = () => {
      appHR.getCurrentPeriod(appAC.globalOrganization()).then(response => {
        me.currentPeriod = response
      })
    }
    me.on('close', async () => {
      const me = this
      if (me.gridExperience && me.gridExperience.isDirty) {
        const isSave = await $App.dialogYesNo('Збереження', `Стаж було змінено. Зберегти зміни?`)
        if (isSave) {
          await me.saveGridExperience()
        }
      }
    })
    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[name=employeeNumberListGrid]'),
        tabPanel: me.down('[name=panel]'),
        panelExperience: me.down('[name=panelExperience]'),
        panelKpi: me.down('[name=panelKpi]')
      }
      managePanelExperience(me)
      managePanelKpi(me)

      function printReport (reportCode) {
        $App.doCommand({
          cmdType: 'showForm',
          formCode: 'hr_accrual-report',
          tabId: 'printDocument_' + me.report_code + '_' + Date.now(),
          target: $App.getViewport().centralPanel,
          cmpInitConfig: {
            allRL: true
          },
          cmdData: {
            reportCode: reportCode,
            reportOptions: {
              allowExportToExcel: false,
              isModal: false
            }
          }
        })
      }
      me.viewDeleted = false

      const tb = me.down('toolbar')
      if (!(me.customParams.mode === 'NOSTAFF')) {
        tb.insert(2,
          Ext.create('Ext.Button', {
            tooltip: UB.i18n('Показати видалені записи'),
            iconCls: 'fas fa-trash-restore',
            cls: 'red-action',
            hidden: !AC.entityUtils.verifyRightsMethod('hr_employeeNumber', 'restoreRecord') || me.customParams.mode === 'IMPORT',
            listeners: {
              click: function () {
                const btn = this
                me.viewDeleted = !me.viewDeleted
                btn.addCls(me.viewDeleted ? 'add-new-action' : 'red-action')
                btn.removeCls(!me.viewDeleted ? 'add-new-action' : 'red-action')
                btn.setTooltip(!me.viewDeleted ? UB.i18n('Показати видалені записи') : UB.i18n('Приховати видалені записи'))
                const ubRequest = me.attr.grid.getStore().ubRequest
                ubRequest.__allowSelectSafeDeleted = me.viewDeleted
                if (me.viewDeleted) {
                  ubRequest.whereList.isDeleted = {
                    expression: '[mi_deleteUser]',
                    condition: 'isNotNull'
                  }
                  ubRequest.whereList.orderClass = {
                    expression: '[orderID.orderClass.entityName]',
                    condition: '!=',
                    value: 'hr_empOrder'
                  }
                } else {
                  delete ubRequest.whereList.isDeleted
                  delete ubRequest.whereList.orderClass
                }
                me.attr.grid.getStore().reload(true)
                const btnRestore = me.attr.grid.menu.items.items.find(o => o.ubID === 'itemRestoreEmployee')
                btnRestore && btnRestore.setVisible(me.viewDeleted)
                const actDel = me.attr.grid.menu.items.items.find(o => o.actionId === 'del')
                actDel && actDel.setDisabled(me.viewDeleted)
              }
            }
          })
        )
        tb.insert(3,
          Ext.create('Ext.Button', {
            tooltip: UB.i18n('Показувати посадові місця'),
            iconCls: 'el-icon-user',
            cls: 'green-action',
            listeners: {
              click: function () {
                const btn = this
                me.addWorkPlace = !me.addWorkPlace
                btn.addCls(!me.addWorkPlace ? 'green-action' : 'red-action')
                btn.removeCls(me.addWorkPlace ? 'green-action' : 'red-action')
                btn.setTooltip(!me.addWorkPlace ? UB.i18n('Показувати посадові місця') : UB.i18n('Приховати посадові місця'))
                const store = me.attr.grid.getStore()
                if (me.addWorkPlace) {
                  delete store.ubRequest.whereList.mainEmpNumberID
                } else {
                  store.ubRequest.whereList.mainEmpNumberID = {
                    expression: '[mainEmpNumberID]',
                    condition: 'isNull'
                  }
                }
                store.load()
              }
            }
          })
        )
        tb.insert(4,
          Ext.create('Ext.Button', {
            tooltip: me.settings.isShowAll ? UB.i18n('Приховати всіх') : UB.i18n('Показати всіх'),
            iconCls: 'fas fa-eye',
            cls: 'grey-action',
            listeners: {
              click: function (btn) {
                const store = me.attr.grid.getStore()
                me.settings.isShowAll = !me.settings.isShowAll

                btn.setTooltip( me.settings.isShowAll ? UB.i18n('Приховати всіх') : UB.i18n('Показати всіх'))

                UB.core.UBLocalStorageManager.setItem('hr_employeeNumberList', JSON.stringify(me.settings))
                if (me.settings.isShowAll) {
                  delete store.ubRequest.whereList.dateFrom
                  delete store.ubRequest.whereList.dateTo
                } else {
                  me.attr.grid.store.ubRequest.whereList.dateFrom = {
                    expression: '[dateFrom]',
                    condition: 'lessEqual',
                    value: me.currentPeriod.dateTo
                  }
                  me.attr.grid.store.ubRequest.whereList.dateTo = {
                    expression: '[dateTo]',
                    condition: 'moreEqual',
                    value: me.currentPeriod.dateFrom
                  }
                }
                store.load()
              }
            }
          })
        )
        if (cmdCustomParam !== 'WORKPLACE') {
          tb.insert(5,
            Ext.create('Ext.Button', {
              text: UB.i18n('Дата перерахунку зарплати'),
              tooltip: UB.i18n('Дата перерахунку зарплати'),
              cls: 'blue-action',
              hidden: !AC.entityUtils.verifyRightsMethod('hr_payCalcDateFrom', 'addForRecalc') || me.customParams.mode === 'IMPORT',
              listeners: {
                click: function () {
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: 'hr_employeeNumberRecalc',
                    sender: me
                  })
                }
              }
            })
          )
        }

        tb.insert(6,
          Ext.create('Ext.Button', {
            text: UB.i18n('Коригування'),
            tooltip: UB.i18n('Коригування'),
            cls: 'blue-action',
            hidden: !AC.entityUtils.verifyRightsMethod('hr_employeeNumber', 'dataCorrection'),
            listeners: {
              click: function () {
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode: 'hr_employeeNumberCorrection',
                  sender: me
                })
              }
            }
          })
        )
        tb.insert(7,
          Ext.create('Ext.Button', {
            tooltip: UB.i18n('Друкувати'),
            iconCls: 'fas fa-print',
            cls: 'blue-action',
            hidden: me.customParams.mode === 'IMPORT',
            menu: [
              {
                text: UB.i18n('Розрахунковий лист за місяць'),
                handler: function () {
                  printReport('hr_accrual-rlMonth')
                }
              }
            ]
          })
        )
      } else {
        tb.insert(3,
          Ext.create('Ext.Button', {
            tooltip: UB.i18n('Показати всіх працівників'),
            iconCls: 'el-icon-receiving',
            cls: 'grey-action',
            listeners: {
              click: function () {
                const store = me.attr.grid.getStore()
                delete store.ubRequest.whereList.dateTo
                store.load()
              }
            }
          })
        )
        tb.insert(4,
          Ext.create('Ext.Button', {
            tooltip: UB.i18n('Показати незвільнених працівників'),
            iconCls: 'fa fa-vcard-o',
            cls: 'green-action',
            listeners: {
              click: function () {
                const store = me.attr.grid.getStore()
                store.ubRequest.whereList.dateTo = {
                  expression: '[dateTo]',
                  condition: '>=',
                  value: appAC.globalApplicationDate()
                }
                store.load()
              }
            }
          })
        )
      }
    }, me)

    me.saveGridExperience = async () => {
      const data = []
      me.gridExperience.grid.getStore().data.items.forEach(rec => {
        Object.keys(rec.modified).forEach(colName => {
          data.push({
            empNumID: rec.get('employeeNumberID'),
            expID: Number(colName.slice(3)),
            value: rec.get(colName)
          })
        })
      })
      if (data.length) {
        me.setLoading(true)
        await $App.connection.run({
          entity: 'hr_employeeExperience',
          method: 'saveEmployeeExperienceList',
          orgID: appAC.globalOrganization(),
          onDate: me.gridExperience.onDate,
          data: JSON.stringify(data)
        }).then(response => {
          clearIsDirty(me.gridExperience.grid)
          me.gridExperience.isDirty = false
          me.attr.saveGridExperience.setDisabled(true)
          me.setLoading(false)
        }, function (err) {
          me.setLoading(false)
          throw err
        })
      } else {
        clearIsDirty(me.gridExperience.grid)
        me.gridExperience.isDirty = false
        me.attr.saveGridExperience.setDisabled(true)
      }
    }

    me.saveGridKpi = () => {
      const data = []
      me.gridKpi.grid.getStore().data.items.forEach(rec => {
        if (rec.modified && (rec.get('ID') || rec.get('KPI'))) {
          data.push({
            ID: rec.get('ID'),
            employeeNumberID: rec.get('employeeNumberID'),
            dateFrom: rec.get('dateFrom'),
            dateTo: rec.get('dateTo'),
            KPI: rec.get('KPI')
          })
        }
      })
      if (data.length) {
        me.setLoading(true)
        $App.connection.run({
          entity: 'hr_employeeKpi',
          method: 'saveEmployeeKpiList',
          orgID: appAC.globalOrganization(),
          onDate: me.gridKpi.onDate,
          data: JSON.stringify(data)
        }).then(response => {
          clearIsDirty(me.gridKpi.grid)
          me.gridKpi.isDirty = false
          me.attr.saveGridKpi.setDisabled(true)
          me.setLoading(false)
        }, function (err) {
          me.setLoading(false)
          throw err
        })
      } else {
        clearIsDirty(me.gridKpi.grid)
        me.gridKpi.isDirty = false
        me.attr.saveGridKpi.setDisabled(true)
      }
    }

    me.callParent(arguments)
  },
  createGridExperience: function (me, refresh = false) {
    if (!me.gridExperience) {
      me.gridExperience = {
        // onDate: AC.dateService.unshiftDate(me.currentPeriod.dateFrom || new Date()),
        onDate: AC.dateService.unshiftDate(AC.dateService.currentDate()),
        initiated: false,
        dict: [],
        fields: null,
        grid: null,
        data: null,
        isDirty: false
      }
    }
    if (!refresh && me.gridExperience.initiated) {
      return
    }

    if (me.gridExperience.grid) {
      me.attr.panelExperience.remove(me.gridExperience.grid, true)
      me.gridExperience.grid = null
    }
    me.gridExperience.dict = []
    me.gridExperience.fields = [
      { name: 'tabNumSort' },
      { name: 'employeeNumberID' },
      {
        name: 'tabNum',
        columnConfig: {
          text: UB.i18n('Таб. №'),
          tooltip: UB.i18n('Табельний номер'),
          width: 60,
          sortBy: 'Number'
        }
      },
      {
        name: 'fullFIO',
        columnConfig: {
          text: UB.i18n('Працівник'),
          tooltip: UB.i18n(`Прізвище ім'я по батькові`),
          width: 220
        }
      }
    ]
    me.setLoading(true)
    UB.Repository('hr_dictExperience')
      .attrs(['ID', 'code', 'name'])
      .where('dateFrom', '<=', me.gridExperience.onDate)
      .where('dateTo', '>=', me.gridExperience.onDate)
      .orderBy('code')
      .selectAsObject()
      .then(dict => {
        const explanation = UB.i18n('років.місяців.днів')
        me.gridExperience.dict = dict.sort((a, b) => Number(String(a.code || '').replace(/[^\d]/g, '') || 0) - Number(String(b.code || '').replace(/[^\d]/g, '') || 0))
        for (let n = 0; n < dict.length; n++) {
          me.gridExperience.fields.push({
            name: 'exp' + dict[n].ID,
            columnConfig: {
              text: `${dict[n].name}`,
              tooltip: `${dict[n].code} ${dict[n].name} - ${explanation}`,
              width: 100,
              editor: {
                xtype: 'textfield',
                regex: /^([0-9]?[0-9])\.([0-1]?[0-1]|[0-9])\.([0-2]?[0-9]|[3]?[0])$/,
                invalidText: UB.i18n('Невірний формат'),
                allowBlank: true,
                selectOnFocus: true,
                maxLength: 8
              }
            }
          })
        }
        const grid = me.gridExperience.grid = Ext.create('AC.controls.AcGrid', {
          xtype: 'acGrid',
          flex: 1,
          region: 'center',
          autoScroll: true,
          storeType: 'local',
          disablePaging: false,
          showToolBar: true,
          cellEditing: true,
          notWriteChanges: true,
          stateId: UB.core.UBLocalStorageManager.getKeyUI('tim_timeSheet_daysData'),
          hideActions: ['addNew', 'addNewByCurrent', 'del', 'edit'],
          firstColumns: ['tabNum', 'fullFIO'],
          pagerConfig: {
            pageSize: 100
          },
          viewConfig: {
            markDirty: false
          },
          onBeforeEdit: (control, context) => {
            if (context.record.phantom && context.record.dirtySave !== null) {
              context.record.dirtySave = null
            }
            context.column.field.prevValue = context.value
          },
          edit: function (control, context) {
            if (context.record.phantom && context.record.dirtySave) {
              context.record.dirtySave = null
            }
            const me = context.grid.up('form')
            if (!me.gridExperience.isDirty && Object.keys(context.record.modified).length) {
              me.gridExperience.isDirty = true
              const saveButton = me.down('[name=saveGridExperience]')
              if (saveButton) {
                saveButton.setDisabled(false)
              }
            }
            return true
          },
          fields: me.gridExperience.fields,
          onItemDoubleClick: function (row, record) {
            $App.doCommand({
              cmdType: 'showForm',
              formCode: 'hr_employeeNumber',
              entity: 'hr_employeeNumber',
              instanceID: record.get('employeeNumberID'),
              tabId: record.get('employeeNumberID'),
              target: $App.getViewport().centralPanel
            })
          },
          getRowClass: function (row) {
            // return row.get('overtime') > 0 ? 'ub-row-red' : ''
            return ''
          },
          customToolBarActions: [
            {
              xtype: 'button',
              tooltip: UB.i18n('Оновити'),
              scale: 'medium',
              iconCls: 'u-icon-refresh',
              handler: async (ctrl) => {
                const me = ctrl.up('form')
                if (me.gridExperience && me.gridExperience.isDirty) {
                  const isSave = await $App.dialogYesNo('Збереження', `Стаж було змінено. Зберегти зміни?`)
                  if (isSave) {
                    await me.saveGridExperience()
                  }
                }
                me.createGridExperience(me, true)
              }
            },
            {
              xtype: 'button',
              name: 'saveGridExperience',
              tooltip: UB.i18n('Зберегти'),
              iconCls: 'u-icon-save',
              cls: 'save-action',
              scale: 'medium',
              disabled: true,
              handler: () => {
                me.saveGridExperience()
              }
            },
            {
              xtype: 'ubdatefield',
              name: 'onDate',
              // readOnly: true,
              // width: 124,
              labelWidth: 120,
              fieldLabel: UB.i18n('Станом на дату:'),
              listeners: {
                change: (ctrl, value) => {
                  if (!value) {
                    ctrl.setValue(AC.dateService.todayDate())
                  }
                  const me = ctrl.up('form')
                  if (AC.dateService.isValid(value)) {
                    value = AC.dateService.unshiftDate(value)
                    if (me.gridExperience.onDate.setHours(0, 0, 0, 0) !== value.setHours(0, 0, 0, 0)) {
                      me.gridExperience.onDate = value
                      // me.onDateChange(me)
                      me.createGridExperience(me, true)
                    }
                  }
                }
              }
            },
            {
              xtype: 'textfield',
              name: 'searchBox',
              labelWidth: 60,
              width: 500,
              fieldLabel: UB.i18n('filter'),
              listeners: {
                change: function (ctrl, value) {
                  if (me.gridExperience && me.gridExperience.grid) {
                    if (value && value !== '') {
                      me.gridExperience.grid.setLocalStoreData(me.gridExperience.data.filter(row =>
                        row.fullFIO.toUpperCase().includes(value.toUpperCase()) ||
                        row.tabNum.toUpperCase().includes(value.toUpperCase())
                      ))
                    } else {
                      me.gridExperience.grid.setLocalStoreData(me.gridExperience.data)
                    }
                  }
                }
              }
            }
          ],
          customContextActions: [
            {
              text: UB.i18n('Особовий рахунок'),
              handler: () => {
                const record = AC.gridUtils.getCurrentRecord(grid)
                if (record) {
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: 'hr_employeeNumber',
                    entity: 'hr_employeeNumber',
                    instanceID: record.get('employeeNumberID'),
                    tabId: record.get('employeeNumberID'),
                    target: $App.getViewport().centralPanel
                  })
                }
              }
            },
            {
              text: UB.i18n('Розрахунковий лист'),
              iconCls: 'el-icon-tickets',
              ubID: 'itemShowRl',
              handler: () => {
                const record = AC.gridUtils.getCurrentRecord(grid)
                if (record) {
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: 'hr_rl',
                    entity: 'hr_rl',
                    cmpInitConfig: {
                      defaultValues: {
                        employeeNumberID: record.get('employeeNumberID')
                      }
                    },
                    tabId: `hr_rl${record.get('employeeNumberID')}`,
                    target: $App.getViewport().centralPanel
                  })
                }
              }
            }
          ]
        })
        me.attr.panelExperience.add(me.gridExperience.grid)
        me.attr.onDate = me.down('[name=onDate]')
        me.attr.onDate.setValue(me.gridExperience.onDate)
        me.attr.saveGridExperience = me.down('[name=saveGridExperience]')
        me.setLoading(false)
        setGridExperienceData(me)
        me.gridExperience.initiated = true
        me.gridExperience.isDirty = false
      }, function (err) {
        me.setLoading(false)
        throw err
      })
  },
  tabSelect: (tabPanel, tab) => {
    const me = tabPanel.up('form')
    switch (tab.name) {
      case 'panelExperience':
        me.createGridExperience(me)
        break
      case 'panelKpi':
        me.createGridKpi(me)
        break
    }
  },
  // onDateChange: (me) => {
  //   me.createGridExperience(me, true)
  // },
  createGridKpi: function (me, refresh = false) {
    if (!me.gridKpi) {
      me.gridKpi = {
        onDate: AC.dateService.unshiftDate(AC.dateService.currentDate()),
        initiated: false,
        fields: null,
        grid: null,
        data: null,
        isDirty: false
      }
    }
    if (!refresh && me.gridKpi.initiated) {
      return
    }

    if (me.gridKpi.grid) {
      me.attr.panelKpi.remove(me.gridKpi.grid, true)
      me.gridKpi.grid = null
    }
    me.gridKpi.fields = [
      { name: 'ID' },
      { name: 'dateFrom' },
      { name: 'dateTo' },
      { name: 'tabNumSort' },
      { name: 'employeeNumberID' },
      {
        name: 'tabNum',
        columnConfig: {
          text: UB.i18n('Таб. №'),
          tooltip: UB.i18n('Табельний номер'),
          width: 60,
          sortBy: 'Number'
        }
      },
      {
        name: 'fullFIO',
        columnConfig: {
          text: UB.i18n('Працівник'),
          tooltip: UB.i18n(`Прізвище ім'я по батькові`),
          width: 220
        }
      },
      {
        name: 'KPI',
        columnConfig: {
          text: UB.i18n('KPI'),
          tooltip: UB.i18n(`KPI працівника`),
          width: 220,
          editor: {
            xtype: 'numberfield',
            floatFormat: 4,
            allowBlank: true,
            selectOnFocus: true
          }
        }
      }
    ]
    const grid = me.gridKpi.grid = Ext.create('AC.controls.AcGrid', {
      xtype: 'acGrid',
      flex: 1,
      region: 'center',
      autoScroll: true,
      storeType: 'local',
      disablePaging: false,
      showToolBar: true,
      cellEditing: true,
      notWriteChanges: true,
      stateId: UB.core.UBLocalStorageManager.getKeyUI('gridKpi'),
      hideActions: ['addNew', 'addNewByCurrent', 'del', 'edit'],
      firstColumns: ['tabNum', 'fullFIO'],
      pagerConfig: {
        pageSize: 100
      },
      viewConfig: {
        markDirty: false
      },
      onBeforeEdit: (control, context) => {
        if (context.record.phantom && context.record.dirtySave !== null) {
          context.record.dirtySave = null
        }
        context.column.field.prevValue = context.value
      },
      edit: function (control, context) {
        if (context.record.phantom && context.record.dirtySave) {
          context.record.dirtySave = null
        }
        const me = context.grid.up('form')
        if (!me.gridKpi.isDirty && Object.keys(context.record.modified).length) {
          me.gridKpi.isDirty = true
          const saveButton = me.down('[name=saveGridKpi]')
          if (saveButton) {
            saveButton.setDisabled(false)
          }
        }
        return true
      },
      fields: me.gridKpi.fields,
      onItemDoubleClick: function (row, record) {
        $App.doCommand({
          cmdType: 'showForm',
          formCode: 'hr_employeeNumber',
          entity: 'hr_employeeNumber',
          instanceID: record.get('employeeNumberID'),
          tabId: record.get('employeeNumberID'),
          target: $App.getViewport().centralPanel
        })
      },
      getRowClass: function (row) {
        // return row.get('overtime') > 0 ? 'ub-row-red' : ''
        return ''
      },
      customToolBarActions: [
        {
          xtype: 'button',
          tooltip: UB.i18n('Оновити'),
          scale: 'medium',
          iconCls: 'u-icon-refresh',
          handler: (ctrl) => {
            const me = ctrl.up('form')
            me.createGridKpi(me, true)
          }
        },
        {
          name: 'importList',
          iconCls: 'el-icon-upload2',
          cls: 'fill-action',
          scale: 'medium',
          tooltip: UB.i18n('Завантажити KPI працівників'),
          handler: function (ctrl) {
            const me = ctrl.up('form')
            me.loadKpi(ctrl)
          }
        },
        {
          xtype: 'button',
          name: 'saveGridKpi',
          tooltip: UB.i18n('Зберегти'),
          iconCls: 'u-icon-save',
          cls: 'save-action',
          scale: 'medium',
          disabled: true,
          handler: () => {
            me.saveGridKpi()
          }
        },
        {
          xtype: 'ubdatefield',
          name: 'onDate',
          // readOnly: true,
          // width: 124,
          labelWidth: 120,
          fieldLabel: UB.i18n('Станом на дату:'),
          listeners: {
            change: (ctrl, value) => {
              if (!value) {
                ctrl.setValue(AC.dateService.todayDate())
              }
              const me = ctrl.up('form')
              if (AC.dateService.isValid(value)) {
                value = AC.dateService.unshiftDate(value)
                if (me.gridKpi.onDate.setHours(0, 0, 0, 0) !== value.setHours(0, 0, 0, 0)) {
                  me.gridKpi.onDate = value
                  // me.onDateChange(me)
                  me.createGridKpi(me, true)
                }
              }
            }
          }
        },
        {
          xtype: 'textfield',
          name: 'searchBox',
          labelWidth: 60,
          width: 500,
          fieldLabel: UB.i18n('filter'),
          listeners: {
            change: function (ctrl, value) {
              if (me.gridKpi && me.gridKpi.grid) {
                if (value && value !== '') {
                  me.gridKpi.grid.setLocalStoreData(me.gridKpi.data.filter(row =>
                    row.fullFIO.toUpperCase().includes(value.toUpperCase()) ||
                    row.tabNum.toUpperCase().includes(value.toUpperCase())
                  ))
                } else {
                  me.gridKpi.grid.setLocalStoreData(me.gridKpi.data)
                }
              }
            }
          }
        }
      ],
      customContextActions: [
        {
          text: UB.i18n('Особовий рахунок'),
          handler: () => {
            const record = AC.gridUtils.getCurrentRecord(grid)
            if (record) {
              $App.doCommand({
                cmdType: 'showForm',
                formCode: 'hr_employeeNumber',
                entity: 'hr_employeeNumber',
                instanceID: record.get('employeeNumberID'),
                tabId: record.get('employeeNumberID'),
                target: $App.getViewport().centralPanel
              })
            }
          }
        },
        {
          text: UB.i18n('Розрахунковий лист'),
          iconCls: 'el-icon-tickets',
          ubID: 'itemShowRl',
          handler: () => {
            const record = AC.gridUtils.getCurrentRecord(grid)
            if (record) {
              $App.doCommand({
                cmdType: 'showForm',
                formCode: 'hr_rl',
                entity: 'hr_rl',
                cmpInitConfig: {
                  defaultValues: {
                    employeeNumberID: record.get('employeeNumberID')
                  }
                },
                tabId: `hr_rl${record.get('employeeNumberID')}`,
                target: $App.getViewport().centralPanel
              })
            }
          }
        }
      ]
    })
    me.attr.panelKpi.add(me.gridKpi.grid)
    me.attr.onDate = me.down('[name=onDate]')
    me.attr.onDate.setValue(me.gridKpi.onDate)
    me.attr.saveGridKpi = me.down('[name=saveGridKpi]')
    me.setLoading(false)
    setGridKpiData(me)
    me.gridKpi.initiated = true
    me.gridKpi.isDirty = false
  },
  loadKpi: function (ctrl) {
    const me = ctrl.up('form')
    const entityName = 'hr_employeeKpi'
    const entityAttrs = AC.entityUtils.getAttributes(entityName)

    // Ext.create('UB.view.UploadFileAjax', {
    Ext.create('AC.controls.acUploadFileAjax', {
      scope: this,
      height: 200,
      customArea: {
        xtype: 'panel',
        region: 'center',
        height: 140,
        items: [
          {
            xtype: 'combobox',
            // labelWidth: 100,
            width: 250,
            editable: false,
            name: 'encoding',
            fieldLabel: UB.i18n('Кодування'),
            allowBlank: false,
            // defaultValue: 'utf8',
            store: Ext.create('Ext.data.Store', {
              fields: ['text', 'value'],
              data: [
                {
                  text: 'utf8',
                  value: 'utf8'
                },
                {
                  text: 'win1251',
                  value: 'win1251'
                }
              ]
            })
          }
        ]
      },
      listeners: {
        afterrender: function (cmp) {
          this.fieldFile.fileInputEl.set({
            accept: '.csv' // or w/e type
          })
          const encodingCtrl = this.down('[name=encoding]')
          encodingCtrl.setValue('utf8')
        }
      },
      upLoad: function (btn) {
        me.setLoading(true)
        const dialogWindow = btn.up('window')
        const inputDom = this.fieldFile.fileInputEl.dom
        if (inputDom.files.length === 0) {
          return
        }
        const file = inputDom.files[0]
        if (file.name.toLowerCase().indexOf('.csv', file.name.length - 4) === -1) {
          $App.dialogInfo(UB.i18n('Невірний формат файлу, для завантаження використовується формат csv'))
          me.setLoading(false)
          return
        }
        const encodingCtrl = this.down('[name=encoding]')
        const encoding = (encodingCtrl ? encodingCtrl.getValue() : null) || 'utf8'
        UB.connection.post('loadImportDataEx', file, {
          params: {
            entityName: '',
            encoding,
            fileName: file.name
          },
          headers: {
            'Content-Type': 'application/octet-stream'
          }
        }).then(response => {
          me.setLoading(false)
          const data = response.data
          const attrs = data[0]
          const sourceRows = data.slice(1, data.length)
          const parsedData = []
          sourceRows && sourceRows.forEach((item, key) => {
            let row = {}
            attrs.forEach((attr, idx) => {
              if (!entityAttrs[attr]) {
                row[attr] = item[idx] || ''
              } else {
                switch (entityAttrs[attr].dataType) {
                  case 'Date':
                  case 'DateTime':
                    row[attr] = item[idx] ? new Date(AC.moment(item[idx], 'DD.MM.YYYY').toDate()) : ''
                    break
                  default:
                    row[attr] = item[idx] || ''
                }
              }
            })
            parsedData.push(row)
          })

          const params = {
            orgID: appAC.globalOrganization(),
            onDate: me.gridExperience.onDate,
            data: JSON.stringify(parsedData)
          }
          if (params.data.length) {
            me.setLoading(true)
            $App.connection.run({
              entity: 'hr_employeeKpi',
              method: 'loadEmployeeKpiList',
              params: JSON.stringify(params)
            }).then(response => {
              setGridKpiData(me)
              me.setIsDirty(true)
              me.setLoading(false)
            }, function (err) {
              me.setLoading(false)
              throw err
            })
            dialogWindow.close()
          }
        })
      }
    })
  }
})

function setGridExperienceData (me) {
  const grid = me.gridExperience.grid
  if (me.gridExperience.dict.length) {
    me.setLoading(true)
    $App.connection.run({
      entity: 'hr_employeeExperience',
      method: 'getOrgEmployeeExperienceList',
      orgID: appAC.globalOrganization(),
      onDate: me.gridExperience.onDate,
      dictExperienceList: me.gridExperience.dict.map(o => o.ID)
    }).then(response => {
      me.gridExperience.data = JSON.parse(response.employeeExperience)
      grid.setLocalStoreData(me.gridExperience.data)
      me.setLoading(false)
    }, function (err) {
      me.setLoading(false)
      throw err
    })
  }
}

function managePanelExperience (me) {
  const tabs = me.attr.tabPanel
  const child = tabs.child('[name=panelExperience]')
  const { tab } = child
  if (tab) {
    if (me.customParams.mode) {
      tab.hide()
      const activeTab = tabs.getActiveTab()
      if (activeTab.name === 'panelExperience') {
        tabs.setActiveTab(0)
      }
    } else {
      tab.show()
    }
  }
}

function clearIsDirty (grid) {
  grid.getStore().data.items.forEach(rec => {
    rec.modified = {}
  })
  grid.getView().refresh()
}

function managePanelKpi (me) {
  const tabs = me.attr.tabPanel
  const child = tabs.child('[name=panelKpi]')
  const { tab } = child
  if (tab) {
    const hrKpi = AC.settings.get('hrKPI', appAC.globalOrganization())
    if (me.customParams.mode || !hrKpi) {
      tab.hide()
      const activeTab = tabs.getActiveTab()
      if (activeTab.name === 'panelKpi') {
        tabs.setActiveTab(0)
      }
    } else {
      tab.show()
    }
  }
}

function setGridKpiData (me) {
  const grid = me.gridKpi.grid
  me.setLoading(true)
  $App.connection.run({
    entity: 'hr_employeeKpi',
    method: 'getOrgEmployeeKpiList',
    orgID: appAC.globalOrganization(),
    onDate: me.gridKpi.onDate
  }).then(response => {
    me.gridKpi.data = JSON.parse(response.employeeKpi)
    grid.setLocalStoreData(me.gridKpi.data)
    me.setLoading(false)
  }, function (err) {
    me.setLoading(false)
    throw err
  })
}
