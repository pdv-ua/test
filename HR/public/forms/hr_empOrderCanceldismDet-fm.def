                  value: {
                    entity: 'ac_employeeOrg',
                    fieldList: [],
                    method: 'select',
                    whereList: {
                      cond: {
                        expression: '[employeeID]=[{master}.ID]',
                        condition: 'custom'
                      },
                      mi_deleteDate: {
                        condition: 'equal',
                        expression: '[mi_deleteDate]',
                        value: '#maxdate'
                      }
                    }
                  }
                }
              }
            },
            {
              xtype: 'ubfieldset',
