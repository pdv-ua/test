                align: 'stretch'
              },
              margin: '5 10 10 10',
              defaults: { labelWidth: 120 },
              items: [{
                attributeName: 'dismParaID',
                fieldList: ['ID', 'descriptionExt', 'orderID', 'dateFrom', 'orderID.orderDate', 'orderID.orderNumber',
                  'orderID.dictEmpOrderIndexID', 'employeeID', 'employeePositionID', 'employeeNumberID', 'positionID', 'departmentID'],
                valueField: 'ID',
                displayField: 'descriptionExt',
                fieldLabel: UB.i18n('Наказ про звільнення'),
                whereList: {
                  isPosted: {
                    expression: '[orderID.orderState]',
