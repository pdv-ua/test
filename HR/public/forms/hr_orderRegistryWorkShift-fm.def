/* global $App AC appHR UB HR appAC */

exports.formDef = {
  requiredFields: ['description', 'filterParams', 'orderType', 'orderNumber', 'hasPosted', 'payElID.useDictTech'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'calcDocAction'
        },
        {
          orderId: 5,
          actionId: 'postingAction'
        },
        {
          orderId: 6,
          actionId: 'cancelPostingAction'
        },
        {
          orderId: 7,
          actionId: 'copyDocAction'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      // split: true,
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        {
          layout: { type: 'hbox' },
          flex: 1,
          items: [
            { attributeName: 'orderType', hidden: true, readOnly: false },
            { attributeName: 'organizationID', hidden: true },
            { attributeName: 'orderState', hidden: true },
            {
              attributeName: 'periodID',
              hidden: true,
              fieldList: ['ID', 'dateFrom', 'dateTo']
            },
            {
              attributeName: 'periodSalaryID',
              hidden: true,
              fieldList: ['ID', 'dateFrom', 'dateTo']
            },
            {
              attributeName: 'orderNumber',
              fieldLabel: UB.i18n('Номер'),
              allowBlank: false,
              labelWidth: 80,
              width: 200
            },
            {
              attributeName: 'name',
              xtype: 'ubtextfield',
              fieldLabel: UB.i18n('Назва'),
              flex: 1
            }
          ]
        },
        {
          layout: { type: 'hbox' },
          flex: 1,
          items: [
            {
              attributeName: 'orderDate',
              fieldLabel: UB.i18n('Дата'),
              labelWidth: 80,
              width: 200
            },
            {
              attributeName: 'payElID',
              fieldLabel: UB.i18n('Вид оплати'),
              fieldList: ['ID', 'description', 'code', 'name', 'dateFrom', 'dateTo', 'methodID.code', 'useDictTech'],
              pageSize: 50,
              flex: 1,
              allowBlank: false,
              orderList: {
                orderBy: {
                  expression: 'dateFrom',
                  order: 'desc'
                }
              },
              listeners: {
                expand: appHR.periodExpand
              }
            }
          ]
        }
      ]
    },
    {
      xtype: 'tabpanel',
      name: 'tabs',
      region: 'center',
      margin: '10 8 0 8',
      items: [
        {
          title: UB.i18n('Продукція'),
          hidden: true,
          xtype: 'acGrid',
          name: 'docRegNomenclature',
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_orderRegistry_docRegNomenclature'),
          region: 'center',
          flex: 1,
          autoScroll: true,
          cellEditing: true,
          notWriteChanges: true,
          storeType: 'local',
          showToolBar: true,
          disablePaging: true,
          loadMaskMessage: UB.i18n('Завантаження...'),
          summary: { paySum: 'sum' },
          enableMultifilter: false,
          hideActions: ['addNewByCurrent'],
          includeContextMenuReadOnly: [],
          onBeforeEdit: (control, context) => {
            if (context.record.phantom && context.record.dirtySave !== null) {
              context.record.dirtySave = null
            }
            context.column.field.prevValue = context.value
            const me = context.grid.up('form')
            return me.beforeGridEditNomenclature(me, context)
          },
          edit: function (control, context) {
            if (context.record.phantom && context.record.dirtySave !== null) {
              context.record.dirtySave = null
            }
            const me = context.grid.up('form')
            return me.onGridEditNomenclature(me, context)
