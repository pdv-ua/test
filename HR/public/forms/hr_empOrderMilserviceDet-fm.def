/* global UB */
exports.formDef = {
  requiredFields: ['orderID', 'empOrderType', 'organizationID', 'lastName', 'firstName', 'middleName', 'employeeID'],
  parentConfig: {
    layout: {
      type: 'border'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'addIntComb'
        }
      ]
    }
  ],
  items: [
    {
      xtype: 'tabpanel',
      region: 'center',
      items: [
        {
          title: UB.i18n('Загальне'),
          layout: {
            type: 'vbox',
            align: 'stretch'
          },
          defaults: { labelWidth: 175 },
          items: [
            {
              attributeName: 'employeePositionID',
              margins: '5 0 0 0',
              gridFieldList: ['description'],
              fieldList: ['ID', 'description', 'employeeID.firstName', 'employeeID.lastName', 'employeeID.middleName',
                'employeeID', 'employeeNumberID', 'departmentID', 'organizationID', 'workPlace', 'vacancyDateFrom', 'vacancyDateTo',
                'dictStaffCatID', 'positionType'
              ],
              xtype: 'empPositionCombobox',
              addWorkPlace: true,
              allowBlank: false,
              hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion']
            },
            {
              attributeName: 'dateFrom',
              fieldLabel: UB.i18n('Дата увільнення')
            },
            {
              attributeName: 'dateTo',
              fieldLabel: UB.i18n('Дата повернення')
            },
            {
              attributeName: 'payElID',
              hideEntityItemInContext: true,
              orderList: { orderBy: { expression: 'codeSort' } },
              fieldList: ['ID', 'description', 'methodID.code', 'codeSort', 'dictTimeCostID'],
              allowBlank: false,
              whereList: {
                isSalary: {
                  expression: '[methodID.code]',
                  condition: 'equal',
                  value: '44'
                }
              }
            },
            {
              attributeName: 'dictTimeCostID',
              gridFieldList: ['nameSmall'],
              fieldList: ['nameSmall'],
              displayField: 'nameSmall',
              readOnly: true
            },
            {
              attributeName: 'isPosReserved'
            },
            {
              attributeName: 'dictMilitaryDutyID',
              allowBlank: false
            },
            {
              attributeName: 'isTempStopVacation'
            },
            {
              layout: {
                type: 'hbox',
                align: 'top'
              },
              flex: 1,
              name: 'reasonDocPanel',
              hidden: true,
              items: [
                {
                  labelWidth: 175,
                  fieldLabel: UB.i18n('Підстава (до пункту наказу)'),
                  attributeName: 'reason',
                  flex: 1
                },
                {
                  xtype: 'button',
                  cls: 'list-icon',
                  name: 'reasonButton',
                  tooltip: UB.i18n('Вибрати'),
                  width: 35,
                  height: 35,
                  margin: '0 2 0 -45',
                  handler: btn => {
                    btn.up('form').getField('reason').selectHandler(btn)
                  }
                  //handler: btn => btn.up('form').getField('reason').selectHandler(btn)
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
