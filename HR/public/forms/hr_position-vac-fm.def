// @isModal true

/* global Ext appAC $App */
exports.formDef = 'HR.positionListVac'

Ext.define(exports.formDef, {
  extend: 'Ext.panel.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.positionList',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  mainPanel: {
    xtype: 'panel',
    header: false,
    region: 'center',
    flex: 1,
    layout: 'fit',
    items: [{
      name: 'posVac',
      xtype: 'ubdetailgrid',
      autoScroll: true,
      layout: 'fit',
      flex: 1,
      hideActions: ['addNew', 'addNewByCurrent', 'del', 'audit', 'newVersion', 'history', 'showPreview', 'itemLink',
        'commandLink', 'showDetail'],
      cmdType: 'showList',
      description: UB.i18n('Посади вакантні'),
      entity: 'hr_position',
      cmdData: {
        params: [{
          entity: 'hr_positionVac',
          method: 'getVacancies',
          orgID: appAC.globalOrganization(),
          onDate: appAC.globalApplicationDate(),
          fieldList: [
            { name: 'code', description: UB.i18n('Код'), config: { align: 'center', width: 60 } },
            { name: 'name', description: UB.i18n('Назва') },
            { name: 'parentUnitID.name', description: UB.i18n('Підпорядкування') },
            { name: 'quantity', config: { align: 'center', width: 100 } },
            { name: 'mtCount', description: UB.i18n('Зайнятих ставок'), config: { align: 'center', width: 100 }, format: '0.00' },
            { name: 'vacCount', description: UB.i18n('Вакантних ставок'), config: { align: 'center', width: 100 }, format: '0.0' },
            { name: 'dictPositionID.dictProfessionID.code', description: UB.i18n('Державний класифікатор') },
            { name: 'mi_dateFrom', description: UB.i18n('Дата початку дії'), format: 'd.m.Y', config: { align: 'center', width: 100 } },
            { name: 'mi_dateTo', description: UB.i18n('Дата закінчення дії'), format: 'd.m.Y', config: { align: 'center', width: 100 } },
            { name: 'staffOrderID.description', description: UB.i18n('Наказ') }
          ],
          __mip_recordhistory_all: true
        }]
      },
      cmpInitConfig: {
        customInit: function () {},
        onDeterminateForm: function (grid) {
          return {
            entityName: 'hr_position',
            formCode: 'hr_position'
          }
        }
      }
    }]
  },
  initComponent: function () {
    let me = this
    me.items = [
      me.mainPanel
    ]
    me.changeGlobal = function () {
      const store = me.down('ubdetailgrid').getStore()
      store.ubRequest.onDate = appAC.globalApplicationDate()
      store.ubRequest.orgID = appAC.globalOrganization()
      store.load()
    }
    me.on('afterrender', () => {
      $App.on('ac:app:organizationChanged', me.changeGlobal)
      $App.on('ac:app:operationDateChanged', me.changeGlobal)
    }, me)

    me.on('destroy', () => {
      $App.un('ac:app:organizationChanged', me.changeGlobal)
      $App.un('ac:app:operationDateChanged', me.changeGlobal)
    }, me)
    me.callParent(arguments)
  }
})
