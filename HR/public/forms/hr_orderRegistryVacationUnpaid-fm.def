/* global $App appHR UB HR */
exports.formDef = {
  requiredFields: ['description', 'filterParams', 'orderType', 'orderNumber', 'hasPosted', 'hasProject'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'postingAction'
        },
        {
          orderId: 5,
          actionId: 'cancelPostingAction'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        {
          layout: { type: 'hbox' },
          flex: 1,
          items: [
            { attributeName: 'orderDate', hidden: true },
            { attributeName: 'orderType', hidden: true, readOnly: false },
            { attributeName: 'organizationID', hidden: true },
            {
              attributeName: 'orderNumber',
              fieldLabel: UB.i18n('Номер'),
              allowBlank: false,
              labelWidth: 100,
              width: 300
            },
            {
              attributeName: 'periodID',
              fieldLabel: UB.i18n('Період створення'),
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'name'],
              pageSize: 50,
              width: 420,
              labelWidth: 160,
              orderList: {
                orderBy: {
                  expression: 'dateFrom',
                  order: 'desc'
                }
              },
              listeners: {
                expand: appHR.periodExpand
              }
            },
            {
              attributeName: 'orderState',
              allowBlank: false,
              readOnly: true,
              flex: 1,
              hidden: true,
              labelWidth: 90,
              width: 300
            }
          ]
        },
        {
          attributeName: 'name',
          labelWidth: 100,
          xtype: 'ubtextfield',
          fieldLabel: UB.i18n('Назва'),
          flex: 1
        }
      ]
    },
    {
      xtype: 'panel',
      region: 'center',
      items: [
        {
          xtype: 'ubdetailgrid',
          name: 'orderRegistryDt',
          autoScroll: true,
          hideActions: ['addNew', 'del', 'addNewByCurrent', 'prefilter', 'exportXls', 'exportCsv', 'exportHtml',
            'showPreview', 'itemLink', 'commandLink', 'history', 'edit'
          ],
          stateful: true,
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_orderRegistryDt_orderRegistryVacationUnpaid'),
          disableMenuItemDetails: true,
          flex: 1,
          entityConfig: {
            entity: 'hr_orderRegistryDt',
            method: 'select',
            fieldList: [
              { name: 'ID', visibility: false },
              { name: 'employeeNumberID', visibility: false },
              { name: 'orderID', visibility: false },
              { name: 'orderID.orderState', visibility: false },
              { name: 'orderID.orderClass.entityName', visibility: false },
              { name: 'mi_modifyDate', visibility: false },
              { name: 'checked', description: ' ', config: HR.orderManager.checkBoxColumnConfig() },
              { name: 'employeeNumberID.tabNum', description: UB.i18n('Таб.№') },
              { name: 'employeeNumberID.description', description: UB.i18n('ПІБ') },
              { name: 'payElID.name', description: UB.i18n('Вид оплати') },
              { name: 'orderDateFrom', description: UB.i18n('Дата початку') },
              { name: 'orderDateTo', description: UB.i18n('Дата закінчення') },
              { name: 'periodSalaryID.name', description: UB.i18n('Період нарахування') },
              { name: 'dateFrom', description: UB.i18n('З'), format: 'd' },
              { name: 'dateTo', description: UB.i18n('По'), format: 'd' },
              { name: 'days', description: UB.i18n('Робочих днів') },
              { name: 'calendarDays', description: UB.i18n('Календарних днів'), format: '0' },
              { name: 'posName', description: UB.i18n('Посада') },
              { name: 'depName', description: UB.i18n('Підрозділ') },
              { name: 'orderNumber', description: UB.i18n('Номер наказу') },
              { name: 'orderDate', description: UB.i18n('Дата наказу') }
            ],
            orderList: { orderBy: { expression: 'employeeNumberID.tabNumSort' } }
          },
          summary: { days: 'sum', calendarDays: 'sum' },
          masterFields: ['ID'],
          detailFields: ['orderRegistryID'],
          cmpInitConfig: {
            getRowClass: function (row) {
              return row.get('orderID.orderState') === 'POSTED' ? 'ub-row-green' : 'ub-row-lightgrey'
            },
            customActions: [
              {
                text: UB.i18n(`Додати документ оплати Неоплачувана відпустка`),
                actionId: 'addNewOrder',
                iconCls: 'u-icon-add',
                scale: 'medium',
                cls: 'add-new-action',
                handler: function (btn) {
                  const me = btn.up('form')
                  const grid = btn.up('ubdetailgrid')
                  me.saveForm()
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: 'hr_docRegVacationUnpaid',
                    entity: 'hr_docRegVacationUnpaid',
                    tabId: 'hr_docRegVacationUnpaidNew' + Date.now(),
                    title: UB.i18n(`Неоплачувана відпустка`),
                    description: UB.i18n(`Неоплачувана відпустка`),
                    target: $App.getViewport().centralPanel,
                    sender: grid.getView(),
                    store: grid.store,
                    cmpInitConfig:
                      {
                        defaultValues: {
                          orderRegistryID: me.record.get('ID'),
                          'orderRegistryID.organizationID': me.record.get('organizationID'),
                          'orderRegistryID.periodID': me.record.get('periodID'),
                          'orderRegistryID.periodID.dateFrom': me.attr.periodID.getFieldValue('dateFrom')
                        }
                      }
                  })
                }
              }
            ],
            onItemDblClick: function (grid, record) {
              if (record.get('orderID')) {
                let ubdetailgrid = grid.up('ubdetailgrid')
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode: 'hr_docRegVacationUnpaid',
                  entity: 'hr_docRegVacationUnpaid',
                  title: UB.i18n(`Неоплачувана відпустка`),
                  isModal: false,
                  instanceID: record.get('orderID'),
                  tabId: 'hr_docRegVacationUnpaid' + record.get('ID'),
                  target: $App.getViewport().centralPanel,
                  sender: ubdetailgrid.getView(),
                  store: ubdetailgrid.store
                })
              }
            }
          },
          listeners: {
            render: grid => {
              grid.menu.add([
                HR.orderManager.getOrderRegistryDeleteAction(grid),
                HR.orderManager.getOrderRegistryRlAction(grid),
                HR.orderManager.getOrderRegistryEmployeeAction(grid)
              ])
            }
          }
        }
      ]
    }
  ]
}
