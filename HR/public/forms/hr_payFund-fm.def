                        fieldList: [
                          {
                            name: 'dictFundSourceID.name',
                            description: UB.i18n('Назва')
                          },
                          {
                            name: 'dateFromEmpty'
                          },
                          {
                            name: 'dateToEmpty'
                          }
                        ],
                        orderList: {
                          dateTo: {
                            expression: '[dateTo]',
                            order: 'desc'
                          }
                        }
                      },
                      masterFields: ['ID'],
                      detailFields: ['payFundID'],
                      cmpInitConfig: {
                        customActions: [
                          {
                            text: UB.i18n('Редагувати'),
                            iconCls: 'u-icon-edit-alt',
                            scale: 'medium',
                            cls: 'fill-action',
                            handler: function (btn) {
                              const grid = btn.up('grid')
                              const form = grid.up('form')
                              if (form.isNewInstance) {
                                form.saveForm().then(result => {
                                  if (result !== -1) {
                                    form.setFundSource(form, grid)
                                  }
                                })
                              } else {
                                form.setFundSource(form, grid)
                              }
                            }
                          }
                        ],
                        onItemDblClick: function (grid) {
                          const form = grid.up('form')
                          form.setFundSource(form, grid.ownerCt)
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              title: UB.i18n('Загальні налаштування'),
              itemId: 'settings',
              layout: { type: 'vbox', align: 'stretch' },
              items: [
                {
                  attributeName: 'isAutoCalc',
                  hideLabel: true,
                  boxLabel: UB.i18n('Розраховувати автоматично')
                },
                {
                  attributeName: 'isRecalculate',
                  hideLabel: true,
