                    ],
                    onItemDblClick: function (grid) {
                      const form = grid.up('form')
                      form.setPayElExclude(form, grid)
                    }
                  }
                }
              ]
            },
            {
              title: UB.i18n('Відсоток нарахування'),
              itemId: 'fundRate',
              layout: { type: 'vbox', align: 'stretch' },
              items: [
                {
                  xtype: 'ubdetailgrid',
                  autoScroll: true,
                  pageSize: 10000,
                  hideActions: [],
                  flex: 1,
                  entityConfig: {
                    entity: 'hr_payFundRate',
                    method: 'select',
                    fieldList: [
                      {
                        name: 'dateFromEmpty'
                      },
                      {
                        name: 'rate',
                        format: '0.00'
                      }
                    ],
                    orderList: { dateTo: { expression: 'dateTo', order: 'DESC' } }
                  },
                  masterFields: ['ID'],
                  detailFields: ['payFundID']
                }
              ]
            },
            {
              title: UB.i18n('Виключення робочого часу'),
              itemId: 'payFundTimeCostOut',
              layout: { type: 'vbox', align: 'stretch' },
              items: [
                {
                  name: 'payFundTimeCostOut',
                  xtype: 'ubdetailgrid',
                  autoScroll: true,
