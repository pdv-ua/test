                      }
                    ],
                    orderList: {
                      dateTo: {
                        expression: '[dateTo]',
                        order: 'desc'
                      }
                    }
                  },
                  masterFields: ['ID'],
                  detailFields: ['payFundID'],
                  cmpInitConfig: {
                    customActions: [
                      {
                        text: UB.i18n('Редагувати'),
                        iconCls: 'u-icon-edit-alt',
                        scale: 'medium',
                        cls: 'fill-action',
                        handler: function (btn) {
                          const grid = btn.up('grid')
                          const form = grid.up('form')
                          if (form.isNewInstance) {
                            form.saveForm().then(result => {
                              if (result !== -1) {
                                form.setTimeCost(form, grid)
                              }
                            })
                          } else {
                            form.setTimeCost(form, grid)
                          }
                        }
                      }
                    ],
                    onItemDblClick: function (grid) {
                      const form = grid.up('form')
                      form.setTimeCost(form, grid)
                    }
                  }
                }
              ]
            },
            {
              title: UB.i18n('Джерела фінансування для розподілу'),
              itemId: 'payFundSource',
              layout: { type: 'border' },
              items: [
                {
                  layout: { type: 'vbox', align: 'stretch' },
                  region: 'north',
                  items: [
                    {
                      attributeName: 'excludeFundSource'
                    },
                    {
                      name: 'payFundSource',
                      xtype: 'ubdetailgrid',
                      autoScroll: true,
                      pageSize: 10000,
                      hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
                      region: 'center',
                      flex: 1,
                      entityConfig: {
                        entity: 'hr_payFundSource',
