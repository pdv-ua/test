                  attributeName: 'dictProjectID',
                  fieldList: ['ID', 'description']
                },
                {
                  attributeName: 'entryOperationID',
                  width: '50%'
                },
                {
                  attributeName: 'isRecSum',
                  hideLabel: true,
                  boxLabel: UB.i18n('Сума не входить до нараховано/утримано')
