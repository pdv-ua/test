                  hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
                  flex: 1,
                  entityConfig: {
                    entity: 'hr_payFundTimeCost',
                    method: 'select',
                    fieldList: [
                      {
                        name: 'dictTimeCostID.code',
                        description: UB.i18n('Код')
                      },
                      {
                        name: 'dictTimeCostID.nameSmall',
                        description: UB.i18n('Назва')
                      },
                      {
