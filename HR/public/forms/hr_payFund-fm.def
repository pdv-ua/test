/* global UB */
exports.formDef = {
  requiredFields: ['payFundMethodID.code'],
  size: {
    width: 1100,
    height: 600
  },
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' }
  },
  items: [
    {
      layout: { type: 'vbox', align: 'stretch' },
      region: 'north',
      split: true,
      autoScroll: true,
      items: [
        {
          layout: { type: 'hbox' },
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              items: [
                {
                  layout: { type: 'hbox' },
                  items: [
                    { attributeName: 'code', flex: 1 },
                    { attributeName: 'name', flex: 2 }
                  ]
                },
                {
                  attributeName: 'payFundMethodID',
                  fieldList: ['ID', 'description', 'code'],
                  allowBlank: false
                }
              ]
            },
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              items: [
                { attributeName: 'dateFromEmpty' },
                { attributeName: 'dateToEmpty' }
              ]
            }
          ]
        }

      ]
    },
    {
      xtype: 'panel',
      region: 'center',
      width: '100%',
      layout: {
        type: 'vbox',
        align: 'stretch'
      },
      items: [
        {
          xtype: 'tabpanel',
          flex: 5,
          plain: true,
          tabPosition: 'top',
          items: [
            {
              title: UB.i18n('Властивості'),
              itemId: 'property',
              layout: { type: 'vbox', align: 'stretch' },
              defaults: {
                labelWidth: 210
              },
              items: [
                { attributeName: 'calcPeriod' },
                { attributeName: 'typeTaxECBID', fieldList: ['ID', 'description'] },
                { attributeName: 'sequence' },
                { attributeName: 'addMinSum', labelWidth: 350 },
              ]
            },
            {
              title: UB.i18n('Категорії застрахованих осіб'),
              itemId: 'fundCategory',
              layout: { type: 'vbox', align: 'stretch' },
              items: [
                {
                  xtype: 'ubdetailgrid',
                  pageSize: 10000,
                  name: 'dictCategoryECB',
                  autoScroll: true,
                  hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
                  flex: 1,
                  entityConfig: {
                    entity: 'hr_payFundCategory',
                    method: 'select',
                    fieldList: [
                      {
                        name: 'dictCategoryECBID.description',
                        description: UB.i18n('Назва'),
                        config: {
                          width: 700
                        }
                      }
                    ],
                    orderList: { dictCategory: { expression: 'dictCategoryECBID.name', order: 'ASC' } }
                  },
                  masterFields: ['ID'],
                  detailFields: ['payFundID'],
                  customActions: [
                    {
                      text: UB.i18n('Редагувати'),
                      iconCls: 'u-icon-edit-alt',
                      scale: 'medium',
                      cls: 'fill-action',
                      handler: function (btn) {
                        const grid = btn.up('grid')
                        const form = grid.up('form')
                        if (form.isNewInstance) {
                          form.saveForm().then(result => {
                            if (result !== -1) {
                              form.changeGridValue(form, grid)
                            }
                          })
                        } else {
                          form.changeGridValue(form, grid)
                        }
                      }
                    }
                  ],
                  onItemDblClick: function (grid) {
                    const form = grid.up('form')
                    form.changeGridValue(form, grid.ownerCt)
                  }
                }
              ]
            },
            {
              title: UB.i18n('Нараховується на суму'),
              itemId: 'fundBase',
              layout: { type: 'vbox', align: 'stretch' },
              items: [
                {
                  xtype: 'ubdetailgrid',
                  autoScroll: true,
                  pageSize: 10000,
                  hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
                  flex: 1,
                  entityConfig: {
                    entity: 'hr_payFundBase',
                    method: 'select',
                    fieldList: [
                      {
                        name: 'payElID.description',
                        description: UB.i18n('Вид оплати'),
                        config: { flex: 1 }
                      }
                    ],
                    orderList: { code: { expression: 'payElID.code', order: 'ASC' } }
                  },
                  masterFields: ['ID'],
                  detailFields: ['payFundID'],
                  cmpInitConfig: {
                    customActions: [
                      {
                        text: UB.i18n('Редагувати'),
