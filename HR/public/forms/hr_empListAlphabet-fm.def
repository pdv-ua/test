/* global Ext AC appAC HR UB */
exports.formDef = 'HR.empListAlphabet'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.empListAlphabet', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.empListAlphabet',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox' },
            collapsed: false,
            items: [
              {
                layout: { type: 'vbox' },
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getOrgCombo({
                        labelWidth: 130,
                        width: 700,
                        flex: 1,
                        readOnly: !accMainReportsSubOrg,
                        ubRequest: {
                          entity: 'hr_organization',
                          fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              values: {
                                state: 'ACTIVE'
                              }
                            },
                            path: {
                              expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                              condition: accMainReportsSubOrg ? 'like' : '=',
                              values: {
                                state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                              }
                            }
                          },
                          orderList: { orderBy: { expression: 'description' } },
                          __mip_ondate: appAC.globalApplicationDate()
                        },
                        listeners: {
                          change: function (ctrl) {
                            const form = ctrl.up('form')
                            HR.controlService.onChangeIncludeChildOrgs(form)
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildOrgs(accMainReportsSubOrg)
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getDepCombo({
                        labelWidth: 130,
                        width: 700,
                        displayField: 'description',
                        flex: 1,
                        listeners: {
                          change: function (ctrl, value) {
                            const form = ctrl.up('form')
                            form.down('[name=includeChildDepts]').setReadOnly(!value)
                            if (!value) {
                              form.down('[name=includeChildDepts]').setValue()
                            }
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildDepts()
                    ]
                  },
                  {
                    xtype: 'ubdatefield',
                    labelWidth: 130,
                    name: 'dateFrom',
                    fieldLabel: UB.i18n('Станом на'),
                    allowBlank: false
                  },
                  {
                    xtype: 'ubboxselect',
                    name: 'docKindID',
                    ubID: 'docKindID',
                    labelWidth: 130,
                    width: 700,
                    fieldLabel: UB.i18n('Виводити інформацію про документи'),
                    displayField: 'name',
                    valueField: 'ID',
                    ubRequest: {
                      entity: 'ac_dictDocKind',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['ID', 'name']
                    }
                  },
                  {
                    xtype: 'combobox',
                    name: 'orderBy',
                    labelWidth: 130,
                    width: 350,
                    fieldLabel: UB.i18n('Сортувати за'),
                    valueField: 'code',
                    displayField: 'name',
                    defaultValue: 'fullFIO',
                    store: Ext.create('Ext.data.Store', {
                      fields: [
                        { name: 'name' },
                        { name: 'code' }
                      ],
                      data: [
                        { name: UB.i18n('за алфавітом'), code: 'fullFIO' },
                        { name: UB.i18n('за штатним розписом'), code: 'posTreePath' }
                      ]
                    })
                  },
                  {
                    xtype: 'ubboxselect',
                    name: 'workPlace',
                    labelWidth: 130,
                    width: 700,
                    fieldLabel: UB.i18n('Місце роботи'),
                    hideEntityItemInContext: true,
                    enumGroupFilter: 'HR_WORKER_PLACE',
                    valueField: 'code',
                    displayField: 'name',
                    ubRequest: {
                      entity: 'ubm_enum',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                      whereList: {
                        eGroup: {
                          expression: '[eGroup]',
                          condition: 'equal',
                          values: { 'eGroup': 'HR_WORKER_PLACE' }
                        }
                      }
                    },
                    listeners: {
                      /*
                      afterrender: function (ctrl) {
                        ctrl.getStore().load({
                          callback: function (store) {
                            var flt = store.filter(item => {
                              return item.data['code'] === '1'
                            })
                            ctrl.setValue(flt)
                          }
                        })
                      }
                      */
                    }
                  }
                ]
              },
              {
                layout: { type: 'hbox' },
                padding: '35 0 0 0',
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Шукати'),
                    iconCls: 'fas fa-search',
                    width: 30,
                    cls: 'green-action',
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.searchEmployee()
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Очистити'),
                    iconCls: 'fas fa-eraser',
                    width: 30,
                    cls: 'fill-action',
                    margin: '5 0 0 0',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.clearSearch()
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        xtype: 'ubdetailgrid',
        name: 'employeeNumberListGrid',
        region: 'center',
        flex: 1,
        autoScroll: true,
        loadStoreImmediately: false,
        forceDataLoad: true,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink',
          'commandLink', 'showDetail', 'audit'],
        cmdData: {
          params: [{
            entity: 'hr_empListAlphabet',
            method: 'search',
            fieldList: [
              { name: 'employeeID', visibility: false },
              { name: 'employeeNumberID', visibility: false },
              { name: 'fullFIO', description: UB.i18n('ПIБ') },
              { name: 'depName', description: UB.i18n('Підрозділ') },
              { name: 'structDepName', description: UB.i18n('Самостійний структурний підрозділ') },
              { name: 'posName', description: UB.i18n('Посада') },
              { name: 'actualPositionName', description: UB.i18n('Фактична посада') },
              { name: 'workPlace', description: UB.i18n('Місце роботи') },
              { name: 'phoneMobile' },
              { name: 'phoneWorking' },
              { name: 'phoneHome' },
              { name: 'email' },
              { name: 'taxCode' },
              { name: 'documents' },
              { name: 'addDescrPerson', description: UB.i18n('Додаткова інформація') },
              { name: 'posTreePath', visibility: false },
              { name: 'orgName', description: UB.i18n('Організація') }
            ]
          }]
        },
        cmpInitConfig: {
          onDeterminateForm: HR.employeeTabs.onDeterminateCard,
          customActions: [
            {
              text: UB.i18n('Оновити'),
              iconCls: 'fa fa-refresh',
              cls: 'add-new-action',
              handler: function (btn) {
                me.searchEmployee()
              }
            }
          ],
          listeners: {
            render: (grid) => {
              grid.menu.removeAll()
              grid.menu.add([HR.employeeTabs.getEmpCardMenu(grid)])
              const showAddDescrPerson = !!AC.settings.get('hrShowAddDescrPerson', appAC.globalOrganization())
              const colPersonDescr = AC.gridUtils.getColumnByIndex(grid, 'addDescrPerson')
              colPersonDescr.setVisible(showAddDescrPerson)
              const useActualPositionName = AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization()) === true
              const colActualPositionName = AC.gridUtils.getColumnByIndex(grid, 'actualPositionName')
              colActualPositionName.setVisible(useActualPositionName)
            }
          }
        },
        getExportTitle: function () {
          return UB.i18n(`Список осіб`)
        }
      }
    ]

    me.clearSearch = () => {
      me.attr.dateFrom.setValue(new Date())
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.includeChildOrgs.setValue()
      me.attr.departmentID.setValue()
      me.attr.includeChildDepts.setValue()
      me.attr.docKindID.setValue()
      me.attr.workPlace.setValue()
      me.attr.orderBy.setValue('fullFIO')
    }

    me.searchEmployee = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      const store = me.attr.grid.getStore()
      let req = store.ubRequest
      req.onDate = appAC.globalApplicationDate()
      req.dateFrom = AC.dateService.shiftDate(me.attr.dateFrom.getValue())
      req.organizationID = me.attr.organizationID.getValue()
      req.includeChildOrgs = me.attr.includeChildOrgs.getValue()
      req.departmentID = me.attr.departmentID.getValue()
      req.includeChildDepts = me.attr.includeChildDepts.getValue()
      req.workPlace = me.attr.workPlace.getValue()
      req.docKindID = me.attr.docKindID.getValue().split(',').map(q => q.trim().replace(/"/g, '')).join(',')
      if (me.attr.orderBy.getValue() === 'posTreePath') {
        req.orderList = {
          posTreePath: { expression: '[posTreePath]', order: 'ASC' },
          fullFIO: { expression: '[fullFIO]', order: 'ASC' }
        }
      } else {
        req.orderList = { orderBy: { expression: me.attr.orderBy.getValue() || 'fullFIO', order: 'ASC' } }
      }
      store.load()
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[name=employeeNumberListGrid]'),
        dateFrom: me.down('[name=dateFrom]'),
        organizationID: me.down('[name=organizationID]'),
        includeChildOrgs: me.down('[name=includeChildOrgs]'),
        departmentID: me.down('[name=departmentID]'),
        includeChildDepts: me.down('[name=includeChildDepts]'),
        orderBy: me.down('[name=orderBy]'),
        docKindID: me.down('[name=docKindID]'),
        workPlace: me.down('[name=workPlace]')
      }
      me.attr.dateFrom.setValue(new Date())
      me.attr.orderBy.setValue('fullFIO')
    }, me)

    me.validateParams = () => {
      let res
      let params = []
      let dateFromCtrl = me.attr.dateFrom
      let dateFrom = dateFromCtrl.getValue()
      if (!dateFrom || !dateFromCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Cтаном на"')))
      }

      if (!me.attr.organizationID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Організація"')))
      }
      return res
    }

    me.callParent(arguments)
  }
})
