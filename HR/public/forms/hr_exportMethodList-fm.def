/* global Ext AC appAC appHR $App UB */

exports.formDef = 'HR.exportMethod'

Ext.define('HR.exportMethod', {
  extend: 'Ext.panel.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.exportMethod',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  mainPanel: {
    xtype: 'panel',
    header: false,
    region: 'center',
    flex: 1,
    layout: 'fit',
    items: [
      {
        xtype: 'ubdetailgrid',
        autoScroll: true,
        name: 'exportMethodGrid',
        layout: 'fit',
        flex: 1,
        hideActions: ['addNew', 'addNewByCurrent', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
        cmdType: 'showList',
        entity: 'hr_exportMethod',
        cmdData: {
          params: [{
            entity: 'hr_exportMethod',
            method: 'select',
            fieldList: [
              { name: 'name' },
              { name: 'shortName' },
              { name: 'nameFile' },
              { name: 'typeFile' },
              { name: 'isActive' }
            ]
          }]
        },
        cmpInitConfig: {
          onDeterminateForm: function (grid) {
            let res = {
              entityName: 'hr_exportMethod'
            }
            const reco = AC.gridUtils.getCurrentRecord(grid)
            if (reco && reco.get('typeFile') === 'fileSAP') {
              res.formCode = 'hr_exportMethodFileSap'
            }
            if (reco && reco.get('typeFile') === 'filePay') {
              res.formCode = 'hr_exportMethodFilePay'
            }
            if (reco && reco.get('typeFile') === 'fileWFM') {
              res.formCode = 'hr_exportMethodFileWFM'
            }
            if (reco && reco.get('typeFile') === 'fileExpress') {
              res.formCode = 'hr_exportMethodFileExpress'
            }
            return res
          },
          customInit: function () {
          },
          afterInit: function () {
            AC.gridUtils.setGlobalOrganization(this, 'orgID')
          },
