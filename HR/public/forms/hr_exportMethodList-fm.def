            {
              text: UB.i18n('Додати'),
              iconCls: 'u-icon-add',
              scale: 'medium',
              cls: 'add-new-action',
              disabled: !AC.entityUtils.verifyRightsMethod('hr_exportMethod', 'addnew'),
              handler: function (btn) {
                const grid = btn.up('[entityName=hr_exportMethod]')
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode: 'hr_exportMethodSelect',
                  sender: grid,
                  store: grid.store
                })
              }
            }
          ]
        }
      }
    ]
  },
  initComponent: function () {
    let me = this
    me.items = [
      me.mainPanel
    ]

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[entityName=hr_exportMethod]')
      }
      /* const tb = me.down('toolbar')
      const allActions = tb && tb.query('[menuId=AllActions]')[0]
