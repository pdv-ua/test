const layout = { type: 'vbox', align: 'stretch' }
const hLayout = { type: 'hbox' }
const labelWidth = 150
const labelWidthDouble = 300
const lWidth = 550
const lPartWidth = 390
const rLabelWidth = 150
const fieldOffset = 20
const dateFieldWidth = 120
const specTabLabelWidth = 220
const specTabLabel3Width = 140

const getContractorComboBox = (fieldName, fieldLabel) => ({
  xtype: 'ubcombobox',
  gridFieldList: ['name'],
  name: fieldName,
  valueField: 'name',
  displayField: 'name',
  allowCustomText: true,
  disableModifyEntity: true,
  triggerCls: 'hr-list-trigger',
  fieldLabel: fieldLabel,
  ubRequest: {
    entity: 'ac_contractor',
    fieldList: ['name'],
    whereList: {
      orgBusinessType: {
        expression: '[orgBusinessTypeID.code]',
        condition: 'equal',
        value: 'mlt'
      }
    },
    orderList: { orderBy: { 'expression': 'name', 'order': 'asc' } }
  },
  maxLength: 600,
  listeners: {
    render: function (ctrl) {
      const me = ctrl.up('form')
      const onCtrlChange = () => {
        let oldValue = me.record.get(fieldName)
        if (oldValue !== ctrl.rawValue) {
          me.record.set(fieldName, ctrl.rawValue ? ctrl.rawValue : null)
        }
      }
      me.on('recordloaded', () => {
        ctrl.un('change', onCtrlChange)
        ctrl.setValue(me.record.get(fieldName))
        ctrl.on('change', onCtrlChange)
      })
    },
    select: ctrl => {
      const form = ctrl.up('form')
      ctrl.setValue(ctrl.rawValue)
      form.record.set(fieldName, ctrl.rawValue)
    },
    blur: ctrl => {
      const form = ctrl.up('form')
      ctrl.setValue(ctrl.rawValue)
      form.record.set(fieldName, ctrl.rawValue)
    },
    focus: ctrl => {
      ctrl.inputEl.dom.setAttribute('maxlength', 600)
    }
  }
})

/* global HR */
