/* global appHR UB AC $App HR */

exports.formDef = {
  requiredFields: ['orderState', 'description', 'organizationID', 'filterParams', 'empOrderID', 'payElParams',
    'payElID.methodID.valuation', 'payElID.methodID.code', 'flagsFixDoc', 'empOrderID', 'empOrderID.description',
    'hasPosted', 'hasProject'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'postingAction'
        },
        {
          orderId: 5,
          actionId: 'cancelPostingAction'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        {
          layout: { type: 'hbox' },
          flex: 1,
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              defaults: { labelWidth: 130 },
              items: [
                {
                  layout: { type: 'hbox' },
                  flex: 1,
                  items: [
                    {
                      attributeName: 'name',
                      xtype: 'textfield',
                      labelWidth: 130,
                      flex: 2
                    },
                    {
                      attributeName: 'orderNumber',
                      fieldLabel: UB.i18n('Номер'),
                      labelWidth: 60,
                      allowBlank: true,
                      flex: 1
                    },
                    {
                      attributeName: 'orderType',
                      hidden: true,
                      flex: 1
                    }
                  ]
                },
                {
                  attributeName: 'isOnlyPositive',
                  margin: '10 0 0 15',
                  labelWidth: 200
                },
                {
                  layout: { type: 'hbox' },
                  flex: 1,
                  items: [
                    {
                      attributeName: 'docNumber',
                      fieldLabel: UB.i18n('Наказ №'),
                      labelWidth: 130,
                      flex: 1,
                      hidden: true,
                      skipSetReadOnly: true
                    },
                    {
                      attributeName: 'orderDate',
                      fieldLabel: UB.i18n('від'),
                      labelWidth: 40,
                      flex: 1,
                      hidden: true,
                      skipSetReadOnly: true
                    }
                  ]
                },
                {
                  fieldLabel: UB.i18n('Документ-підстава'),
                  xtype: 'textfield',
                  name: 'orderDescription',
                  fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
                  flex: 1,
                  hidden: true,
                  readOnly: true
                }
              ]
            },
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              defaults: { labelWidth: 130 },
              items: [
                {
                  attributeName: 'periodID',
                  fieldLabel: UB.i18n('Розрахунковий період'),
                  flex: 2,
                  pageSize: 50,
                  fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID'],
                  orderList: {
                    orderBy: {
                      expression: 'dateFrom',
                      order: 'desc'
                    }
                  },
                  listeners: {
                    expand: appHR.periodExpand
                  }
                },
                {
                  attributeName: 'periodSalaryID',
                  pageSize: 50,
                  fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID'],
                  orderList: {
                    orderBy: {
                      expression: 'dateFrom',
                      order: 'desc'
                    }
                  },
                  listeners: {
                    expand: appHR.periodExpand
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      xtype: 'tabpanel',
      region: 'center',
      items: [
        {
          xtype: 'acGrid',
          name: 'orderRegistryDt',
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_orderRegistryAccrualPay_orderRegistryDt'),
          title: UB.i18n('Список'),
          region: 'center',
          flex: 1,
          autoScroll: true,
          cellEditing: true,
          notWriteChanges: true,
          storeType: 'local',
          showToolBar: true,
          disablePaging: true,
          enableMultifilter: true,
          loadMaskMessage: UB.i18n('Завантаження даних...'),
          summary: { paySum: 'sum' },
          summaryDataOnClient: true,
          ignoreAttr: ['posName', 'depName'],
          hideActions: ['addNew', 'addNewByCurrent'],
          ignoreAttrNewByCurrent: ['posName', 'depName', 'employeeNumberID.description', 'employeeNumberID'],
          includeContextMenuReadOnly: [],
          flagsFixDoc: 0,
          onBeforeEdit: (control, context) => {
            const me = context.grid.up('form')
            me.setIsDirty(true)
            return me.beforeGridEdit(me, 'orderRegistryDt', context)
          },
          edit: (control, context) => {
            const me = context.grid.up('form')
            return me.onGridEdit(me, 'orderRegistryDt', context, control)
          },
          getRowClass: function (record) {
            let cls = ''
            const dateToEmpty = record.data['employeeNumberID.dateToEmpty']
            const workPlaceCode = record.data['employeeNumberID.workPlaceCode']
            const miDeleteUser = record.data.mi_deleteUser
            if (miDeleteUser) cls = 'grd-color-grey'
            else if (workPlaceCode) {
              if (['1', '3'].includes(workPlaceCode)) cls = dateToEmpty ? 'grd-color-blue' : ''
              else if (workPlaceCode === '2') cls = dateToEmpty ? 'grd-color-blue-italic' : 'grd-italic'
              else if (workPlaceCode === '4') cls = dateToEmpty ? 'grd-color-blue' : 'grd-color-lightgreen'
            }
            return cls
          },
          customContextActions: [
            HR.orderManager.getOrderRegistryRlAction(null),
            HR.orderManager.getOrderRegistryEmployeeAction(null),
            {
              text: UB.i18n('Аналітика'),
              iconCls: 'el-icon-notebook-2',
              name: 'dimension',
              cls: 'blue-action',
              handler: (context) => {
                const grid = context.up('').grid
                const me = grid.up('form')
                const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                if (record) {
                  const accrualDt = record.get('accrualDt')
                  if (accrualDt) {
                    $App.connection.run({
                      entity: 'hr_rl',
                      method: 'getDimension',
                      params: accrualDt,
                      orgID: me.record.get('organizationID')
                    }).then(response => {
                      const data = JSON.parse(response.resultData)
                      $App.doCommand({
                        cmdType: 'showForm',
                        formCode: 'hr_rlDimension',
                        isModal: true,
                        cmpInitConfig: {
                          defaultValues: data,
                          typeData: 'orderRegistryDt'
                        }
                      })
                    })
                  }
                }
              }
            }
          ],
          customToolBarActions: [
            {
              xtype: 'button',
              name: 'fillBtn',
              tooltip: UB.i18n('Заповнити'),
              iconCls: 'fas fa-angle-double-down',
              cls: 'fill-action',
              handler: function (btn) {
                const me = btn.up('form')
                me.setEmployeeList(me)
              }
            }
          ],
          fields: [
            { name: 'ID' },
            { name: 'employeeNumberID.dateToEmpty' },
            { name: 'employeeNumberID.workPlaceCode' },
            {
              name: 'employeeNumberID.description',
              columnConfig: {
                text: UB.i18n('Працівник'),
                flex: 1,
                filterBy: 'string'
              }
            },
            { name: 'employeeNumberID' },
            {
              name: 'payElID.description',
              columnConfig: {
                text: UB.i18n('Вид оплати'),
                flex: 1,
                hidden: true,
                filterBy: 'string'
              }
            },
            { name: 'payElID' },
            { name: 'baseSum' },
            { name: 'paySum',
              columnConfig: {
                text: UB.i18n('Сума'),
                width: 150,
                floatFormat: 2,
                align: 'right',
                sortBy: 'Number',
                editor: {
                  dataType: 'Currency',
                  decimalPrecision: 2,
                  minValue: 0,
                  flagsFix: 2
                },
                renderer: (value, meta, record) => {
                  if (record.get('flagsFixDoc') & 2) {
                    meta.tdCls = 'grd-italic'
                  } if (record.get('flagsFix') & 2) {
                    meta.tdCls = 'grd-color-blue'
                  }
                  return AC.currencyService.formatAsCurrency(value)
                },
                filterBy: 'float'
              }
            },
            {
              name: 'posName',
              columnConfig: {
                text: UB.i18n('Посада'),
                width: 150,
                filterBy: 'string'
              }
            },
            { name: 'depName',
              columnConfig: {
                text: UB.i18n('Підрозділ'),
                width: 150,
                filterBy: 'string'
              }
            },
            { name: 'periodCalcID' },
            { name: 'periodCalc' },
            { name: 'periodSalaryID' },
            { name: 'periodSalary' },
            { name: 'flagsFix' },
            { name: 'flagsRec' },
            { name: 'flagsFix' },
            { name: 'dateFrom' },
            { name: 'dateTo' },
            { name: 'mask' },
            { name: 'accrualDt' },
            { name: 'tabNum',
              columnConfig: {
                text: UB.i18n('Таб.№'),
                width: 150,
                filterBy: 'string'
              }
            },
            { name: 'mi_createDate',
              columnConfig: {
                text: UB.i18n('Дата створення'),
                width: 150,
                filterBy: 'date'
              }
            },
            { name: 'mi_createUser.fullName',
              columnConfig: {
                text: UB.i18n('Користувач, що створив'),
                width: 150,
                filterBy: 'string'
              }
            },
            { name: 'mi_modifyDate',
              columnConfig: {
                text: UB.i18n('Дата останнього коригування'),
                width: 150,
                filterBy: 'date'
              }
            },
            { name: 'mi_modifyUser.fullName',
              columnConfig: {
                text: UB.i18n('Користувач, що останнім коригував'),
                width: 150,
                filterBy: 'string'
              }
            }
          ]
        },
        {
          xtype: 'acGrid',
          name: 'orderRegistryPayEls',
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_orderRegistryAccrualPay_palEls'),
          title: UB.i18n('Види оплати'),
          region: 'center',
          flex: 1,
          autoScroll: true,
          notWriteChanges: true,
          storeType: 'local',
          showToolBar: true,
          showPopupMenu: false,
          disablePaging: true,
          loadMaskMessage: UB.i18n('Завантаження даних...'),
          enableMultifilter: true,
          hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
          flagsFixDoc: 0,
          fields: [
            { name: 'ID' },
            {
              name: 'description',
              columnConfig: {
                text: UB.i18n('Вид оплати'),
                flex: 1,
                filterBy: 'string'
              }
            }
          ],
          customToolBarActions: [
            {
              itemId: 'addPayElList',
              tooltip: UB.i18n('Редагувати список'),
              actionId: 'addPayELByList',
              iconCls: 'u-icon-edit-alt',
              scale: 'medium',
              cls: 'fill-action',
              handler: function (btn) {
                const grid = btn.up('[name=orderRegistryPayEls]')
                const me = btn.up('form')
                const sourceData = (grid.getStore().snapshot || grid.getStore().data).items.map(o => o.getData())
                const selectData = sourceData.map(o => o.ID)
                const sourceAttr = 'ID'
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode: 'hr_payElSelect',
                  entity: 'hr_idParam',
                  cmpInitConfig: {
                    selectData,
                    sourceData,
                    sourceAttr,
                    onSelectData: (data) => {
                      me.record.set('payElParams', JSON.stringify(data.selected))
                      me.loadPayElParams(grid, data.selected)
                    }
                  }
                })
              }
            }
          ]
        }
      ]
    }
  ]
}
