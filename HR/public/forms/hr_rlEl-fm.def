          labelWidth: 200
        },
        items: [
          {
            xtype: 'acGrid',
            name: 'accrual',
            stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_docRegVacation_orderRegistryDt'),
            title: UB.i18n('Розрахунок по місяцям'),
            region: 'center',
            split: true,
            flex: 1,
            hidden: true,
            autoScroll: true,
            cellEditing: true,
            notWriteChanges: true,
            storeType: 'local',
            showToolBar: false,
            disablePaging: true,
            loadMaskMessage: UB.i18n('Завантаження даних...'),
            summary: { paySum: 'sum', days: 'sum', calendarDays: 'sum' },
            summaryDataOnClient: true,
            ignoreAttr: ['posName', 'depName'],
            ignoreAttrNewByCurrent: ['posName', 'depName', 'employeeNumberID.description', 'employeeNumberID'],
            hideActions: ['addNew', 'del', 'addNewByCurrent'],
            onBeforeEdit: (control, context) => {
              if (context.record.phantom && context.record.dirtySave !== null) {
                context.record.dirtySave = null
              }
              return !me.down('[name=saveButton]').hidden
            },
            customPopupMenuItems: [
              {
                text: UB.i18n('Аналітика'),
                iconCls: 'el-icon-notebook-2',
                cls: 'blue-action',
                handler: (context) => {
                  const grid = me.panel.accrual
                  const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                  if (record) {
                    const accrualDt = record.get('accrualDt')
                    if (accrualDt) {
                      $App.connection.run({
                        entity: 'hr_rl',
                        method: 'getDimension',
                        params: typeof accrualDt === 'object' ? JSON.stringify(accrualDt) : accrualDt,
                        orgID: me.attr.employeeNumberID.getFieldValue('orgID')
                      }).then(response => {
                        const data = JSON.parse(response.resultData)
                        $App.doCommand({
                          cmdType: 'showForm',
                          formCode: 'hr_rlDimension',
                          isModal: true,
                          cmpInitConfig: {
                            readOnly: (record.get('flagsRec') & 1 << 1 || record.get('flagsRec') & 1 << 12 || record.get('flagsRec') & 1 << 9),
                            defaultValues: data,
                            paySum: record.get('paySum'),
                            orgID: me.attr.employeeNumberID.getFieldValue('orgID'),
                            employeeNumberID: me.attr.employeeNumberID.getValue(),
                            typeData: me.payType !== 'PAYMENT' ? 'retention' : 'accrual',
                            checkPaySum: false,
                            onSave: (accrualDt, paySum) => {
                              record.set('flagsFix', record.get('flagsFix') | 1 << 17)
                              record.set('accrualDt', JSON.stringify(accrualDt))
                              if (AC.currencyService.round(paySum) !== AC.currencyService.round(record.get('paySum'))) {
                                record.set('flagsFix', record.get('flagsFix') | 1 << 1)
                                record.set('paySum', AC.currencyService.round(paySum))
                              }
                            }
                          }
                        })
                      })
                    }
                  }
                }
              }
            ],
            fields: [
              { name: 'ID' },
              { name: 'orgID' },
              { name: 'periodCalcID' },
              { name: 'periodSalaryID' },
              { name: 'periodCalc' },
