
/* global Ext $App UB AC _ appAC appHR HR */
exports.formDef = 'HR.rlEl'

Ext.define('HR.rlEl', {
  extend: 'Ext.panel.Panel',
  alias: 'widget.hr_rlEl',
  height: 800,
  width: 600,
  layout: 'border',
  autoScroll: true,
  initComponent: function () {
    const me = this
    me.dockedItems = [
      {
        xtype: 'toolbar',
        dock: 'top',
        ubID: 'mainToolbar',
        enableOverflow: true,
        items: [
          {
            xtype: 'button',
            tooltip: UB.i18n('Розрахувати'),
            name: 'calcButton',
            hidden: true,
            iconCls: 'fas fa-calculator',
            cls: 'fill-action',
            disabled: !AC.entityUtils.verifyRightsMethod('hr_rl', 'calcAccrual'),
            handler: function () {
              me.calculate()
            }
          },
          {
            xtype: 'button',
            tooltip: UB.i18n('Зберегти'),
            name: 'saveButton',
            hidden: true,
            iconCls: 'fas fa-save',
            cls: 'green-action',
            disabled: !AC.entityUtils.verifyRightsMethod('hr_rl', 'saveAccrual'),
            handler: function () {
              me.save()
            }
          },
          {
            xtype: 'button',
            tooltip: UB.i18n('Аналітика'),
            name: 'dimButton',
            iconCls: 'el-icon-notebook-2',
            cls: 'blue-action',
            handler: function () {
              me.dimension()
            }
          },
          {
            xtype: 'button',
            tooltip: UB.i18n('Документ'),
            name: 'docButton',
            hidden: true,
            iconCls: 'el-icon-document',
            cls: 'delete-action',
            handler: function () {
              me.document()
            }
          },
          '->',
          { xtype: 'label', name: 'changeData', text: '', cls: 'x-form-item-label' }
        ]
      }
    ]
    me.items = [
      {
        region: 'north',
        autoScroll: true,
        split: true,
        layout: { type: 'vbox', align: 'stretch' },
        defaults: {
          labelWidth: 200
        },
        items: [
          {
            layout: { type: 'hbox', pack: 'end' },
            items: [
              { xtype: 'label', hidden: true, name: 'calcMessage', text: '', cls: 'grd-color-red' }
            ]
          },
          {
            xtype: 'ubcombobox',
            name: 'employeeNumberID',
            fieldLabel: UB.i18n('Працівник'),
            readOnly: true,
            allowBlank: false,
            ubRequest: {
              entity: 'hr_employeeNumberSR',
              fieldList: ['ID', 'description', 'employeeID', 'orgID', 'dateFrom', 'dateTo'],
              orderList: { orderBy: { expression: 'tabNumSort' } }
            },
            listeners: {
              change: function (ctrl) {
                AC.viewUtils.setFilterValue(me.attr.periodSalaryID, { orgID: ctrl.getFieldValue('orgID') })
                AC.viewUtils.setFilterValue(me.attr.periodFromAvg, { orgID: ctrl.getFieldValue('orgID') })
                AC.viewUtils.setFilterValue(me.attr.periodToAvg, { orgID: ctrl.getFieldValue('orgID') })
                AC.viewUtils.setFilterValue(me.attr.missingEmployeeNumberID, { orgID: ctrl.getFieldValue('orgID'), ID: { value: ctrl.getFieldValue('ID'), condition: '<>' } })
                me.attr.dictFundSourceID.store.ubRequest.orgID = ctrl.getFieldValue('orgID') || appAC.globalOrganization()
                me.changePeriodSalary()
              }
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'payElID',
            fieldLabel: UB.i18n('Вид оплати'),
            allowBlank: false,
            ubRequest: {
              entity: 'hr_payEl',
              fieldList: ['ID', 'description', 'methodID.code', 'calcSumType', 'methodID.methodGroupID.groupType', 'codeSort'],
              orderList: { orderBy: { expression: 'codeSort' } }
            },
            listeners: {
              change: function (cntr) {
                me.changePayEl(cntr.getFieldValue('methodID.code'))
                me.changePeriodSalary()
              }
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'periodSalaryID',
            fieldLabel: UB.i18n('Обліковий період'),
            allowBlank: false,
            pageSize: 50,
            ubRequest: {
              entity: 'hr_dictPeriod',
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID'],
              orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
            },
            listeners: {
              expand: appHR.periodExpand,
              change: function (ctrl) {
                if (ctrl.skipChange) {
                  delete ctrl.skipChange
                  return
                }
                me.changePeriodSalary()
              }
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'periodCalcID',
            fieldLabel: UB.i18n('Розрахунковий період'),
            hidden: true,
            pageSize: 50,
            allowBlank: false,
            ubRequest: {
              entity: 'hr_dictPeriod',
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID'],
              orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
            },
            listeners: {
              expand: appHR.periodExpand
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'dictFundSourceID',
            fieldLabel: UB.i18n('Джерело фінансування'),
            hideEntityItemInContext: true,
            hidden: true,
            flagsFix: 1 << 14,
            ubRequest: {
              entity: 'ac_fundSource',
              method: 'select',
              fieldList: ['ID', 'name']
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'dictProgClassID',
            fieldLabel: UB.i18n('КПК'),
            hideEntityItemInContext: true,
            hidden: true,
            flagsFix: 1 << 24,
            ubRequest: {
              entity: 'ac_dictProgClass',
              fieldList: ['ID', 'description'],
              orderList: { orderBy: { expression: 'description' } }
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'dictProjectID',
            fieldLabel: UB.i18n('Проєкт'),
            hideEntityItemInContext: true,
            hidden: true,
            flagsFix: 1 << 25,
            ubRequest: {
              entity: 'ac_dictProject',
              fieldList: ['ID', 'description'],
              orderList: { orderBy: { expression: 'description' } }
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'missingEmployeeNumberID',
            fieldLabel: UB.i18n('Працівник, що заміщується'),
            hidden: true,
            allowBlank: false,
            ubRequest: {
              entity: 'hr_employeeNumberSR',
              fieldList: ['ID', 'description', 'employeeID', 'orgID'],
              orderList: { orderBy: { expression: 'tabNumSort' } }
            },
            listeners: {
              change: function () {
                me.isChanged = true
              }
            }
          },
          {
            fieldLabel: UB.i18n('Документ-підстава'),
            xtype: 'textfield',
            name: 'orderDescription',
            fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
            hidden: true,
            readOnly: true
          },
          {
            xtype: 'ubfieldset',
            name: 'taxIndivid',
            border: '1 1 1 1',
            margin: '5 10 0 10',
            title: UB.i18n('Суми за видами доходу'),
            hidden: true,
            layout: { type: 'vbox', align: 'stretch' },
            items: [
              {
                xtype: 'acGrid',
                name: 'taxIndividGrid',
                stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_rlEl_taxIndividGrid'),
                flex: 1,
                autoScroll: true,
                region: 'center',
                storeType: 'local',
                disablePaging: true,
                notWriteChanges: true,
                cellEditing: true,
                showToolBar: false,
                hideActions: ['edit', 'del', 'addNewByCurrent', 'addNew'],
                summary: { incomeSum: 'sum', privilegeSum: 'sum', taxSum: 'sum', taxFreeSum: 'sum' },
                onBeforeEdit: (editor, context) => {

                },
                edit: function (control, context) {
                  if (context.record.get(context.field) === null) {
                    context.record.set(context.field, 0)
                  }
                  if (me.attr.payElID.getFieldValue('methodID.code') === '27') {
                    me.flagsFix = (me.flagsFix | 1 << 13)
                    if (context.field === 'incomeSum') {
                      context.record.set('taxSum', AC.currencyService.round(context.record.get('incomeSum') * (me.attr.rate.getValue() || 0) / 100))
                      me.flagsFix = (me.flagsFix | 1 << 0)
                      me.attr.baseSum.setValue(context.store.sum('incomeSum') || 0)
                      me.attr.paySum.setValue(context.store.sum('taxSum') || 0)
                    }
                    if (context.field === 'taxSum') {
                      context.record.set('incomeSum', AC.currencyService.round(context.record.get('taxSum') / (me.attr.rate.getValue() || 0) * 100))
                      me.flagsFix = (me.flagsFix | 1 << 0) | 1 << 1
                      me.attr.baseSum.setValue(context.store.sum('incomeSum') || 0)
                      me.attr.paySum.setValue(context.store.sum('taxSum') || 0)
                    }
                    me.isChanged = true
                    me.calculate()
                  } else {
                    if (
                      ['incomeSum', 'privilegeSum'].includes(context.field) &&
                      context.record.get('incomeSum') >= 0 && context.record.get('privilegeSum') >= 0) {
                      const me = context.grid.up('[formCode=hr_rlEl]')
                      const date = AC.dateService.unshiftDate(me.attr.periodSalaryID.getFieldValue('dateFrom'))
                      const year = date.getFullYear()
                      const inSum = context.record.get('incomeSum') - context.record.get('privilegeSum')
                      const rate = (me.hr_taxRate.find(o => o.yearFrom <= year && o.sumFrom <= inSum) || { rate: 0 }).rate
                      context.record.set('taxSum', AC.currencyService.round((context.record.get('incomeSum') - context.record.get('privilegeSum')) * rate / 100))
                    }
                    me.attr.baseSum.setValue(context.store.sum('incomeSum') || 0)
                    me.attr.paySum.setValue(context.store.sum('taxSum') || 0)
                  }
                  if (me.attr.taxIndividGrid.GridSummary) {
                    me.attr.taxIndividGrid.GridSummary.dataBind()
                  }
                },
                fields: [
                  { name: 'ID' },
                  { name: 'accrualID' },
                  { name: 'taxIndividID' },
                  { name: 'taxIndividID.name', columnConfig: { text: UB.i18n('Вид доходу'), flex: 1 } },
                  {
                    name: 'incomeSum',
                    columnConfig: {
                      text: UB.i18n('Сума доходу'),
                      width: 150,
                      align: 'right',
                      floatFormat: 2,
                      editor: {
                        dataType: 'Currency',
                        decimalPrecision: 2
                      }
                    }
                  },
                  {
                    name: 'privilegeSum',
                    columnConfig: {
                      text: UB.i18n('Застосована пільга'),
                      width: 150,
                      align: 'right',
                      floatFormat: 2,
                      editor: {
                        dataType: 'Currency',
                        decimalPrecision: 2
                      }
                    }
                  },
                  {
                    name: 'taxSum',
                    columnConfig: {
                      text: UB.i18n('Сума'),
                      width: 150,
                      align: 'right',
                      floatFormat: 2,
                      editor: {
                        dataType: 'Currency',
                        decimalPrecision: 2
                      }
                    }
                  },
                  {
                    name: 'taxFreeSum',
                    columnConfig: {
                      text: UB.i18n('Неоподаткована сума'),
                      hidden: true,
                      width: 150,
                      align: 'right',
                      floatFormat: 2,
                      editor: {
                        dataType: 'Currency',
                        decimalPrecision: 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            layout: { type: 'hbox' },
            items: [
              {
                layout: { type: 'vbox', align: 'stretch' },
                flex: 1,
                items: [
                  {
                    xtype: 'ubfieldset',
                    layout: { type: 'vbox' },
                    defaults: { labelWidth: 200, width: 330 },
                    items: [
                      {
                        xtype: 'ubdatefield',
                        name: 'dateFrom',
                        flagsFix: 1 << 2,
                        fieldLabel: UB.i18n('Початок'),
                        hidden: true,
                        enableKeyEvents: true
                      },
                      {
                        xtype: 'ubdatefield',
                        name: 'dateTo',
                        flagsFix: 1 << 3,
                        fieldLabel: UB.i18n('Кінець'),
                        hidden: true,
                        enableKeyEvents: true
                      }
                    ]
                  },
                  {
                    xtype: 'ubfieldset',
                    name: 'periodAvg',
                    margin: '0 0 0 10',
                    title: UB.i18n('Період збору заробітку'),
                    hidden: true,
                    layout: { type: 'vbox' },
                    defaults: { labelWidth: 190, width: 320 },
                    items: [
                      {
                        xtype: 'ubcombobox',
                        name: 'periodFromAvg',
                        fieldLabel: UB.i18n('Період для розрахунку з'),
                        hidden: true,
                        pageSize: 80,
                        width: '100%',
                        allowBlank: false,
                        ubRequest: {
                          entity: 'hr_dictPeriod',
                          fieldList: ['ID', 'name', 'dateFrom', 'dateTo', 'orgID'],
                          orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
                        },
                        listeners: {
                          expand: appHR.periodExpand
                        }
                      },
                      {
                        xtype: 'ubcombobox',
                        name: 'periodToAvg',
                        fieldLabel: UB.i18n('Період для розрахунку по'),
                        hidden: true,
                        pageSize: 80,
                        width: '100%',
                        flex: 1,
                        allowBlank: false,
                        ubRequest: {
                          entity: 'hr_dictPeriod',
                          fieldList: ['ID', 'name', 'dateFrom', 'dateTo', 'orgID'],
                          orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
                        },
                        listeners: {
                          expand: appHR.periodExpand
                        }
                      },
                      {
                        xtype: 'ubdatefield',
                        name: 'dateFromAvg',
                        flagsFix: 1 << 10,
                        fieldLabel: UB.i18n('Дата початку розрахунку'),
                        hidden: true,
                        enableKeyEvents: true
                      },
                      {
                        xtype: 'ubdatefield',
                        name: 'dateToAvg',
                        flagsFix: 1 << 11,
                        fieldLabel: UB.i18n('Дата кінця розрахунку'),
                        hidden: true,
                        enableKeyEvents: true
                      }
                    ]
                  },
                  {
                    layout: { type: 'vbox' },
                    defaults: { labelWidth: 200, width: 330 },
                    items: [
                      {
                        xtype: 'ubdatefield',
                        name: 'baseDate',
                        flagsFix: 1 << 10,
                        fieldLabel: UB.i18n('Базовий місяць'),
                        hidden: true,
                        enableKeyEvents: true
                      },
                      {
                        xtype: 'numberfield',
                        name: 'baseSum',
                        flagsFix: 1,
                        fieldLabel: UB.i18n('Сума для розрахунку'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'rate',
                        fieldLabel: UB.i18n('Відсоток'),
                        flagsFix: 1 << 9,
                        valueToRaw: AC.currencyService.valueAsMinDecimalPrecision, // UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 6,
                        minDecimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      }
                    ]
                  },
                  {
                    xtype: 'ubfieldset',
                    name: 'plan',
                    margin: '0 0 0 10',
                    title: UB.i18n('План'),
                    hidden: true,
                    layout: { type: 'vbox' },
                    defaults: { labelWidth: 190, width: 320 },
                    items: [
                      {
                        xtype: 'numberfield',
                        name: 'planDays',
                        flagsFix: 1 << 4,
                        decimalPrecision: 2,
                        fieldLabel: UB.i18n('Днів'),
                        enforceMaxLength: true,
                        allowExponential: false,
                        // allowDecimals: false,
                        hideTrigger: true,
                        hidden: true,
                        enableKeyEvents: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'planHours',
                        flagsFix: 1 << 5,
                        fieldLabel: UB.i18n('Годин'),
                        // valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 744,
                        enforceMaxLength: true,
                        allowExponential: false,
                        decimalPrecision: 3,
                        hideTrigger: true,
                        hidden: true,
                        enableKeyEvents: true,
                        mouseWheelEnabled: false
                      }
                    ]
                  },
                  {
                    xtype: 'ubfieldset',
                    name: 'fact',
                    margin: '0 0 0 10',
                    title: UB.i18n('Факт'),
                    hidden: true,
                    layout: { type: 'vbox' },
                    defaults: { labelWidth: 190, width: 320 },
                    items: [
                      {
                        xtype: 'numberfield',
                        name: 'days',
                        flagsFix: 1 << 6,
                        decimalPrecision: 2,
                        fieldLabel: UB.i18n('Днів'),
                        enforceMaxLength: true,
                        allowExponential: false,
                        // allowDecimals: false,
                        hideTrigger: true,
                        hidden: true,
                        enableKeyEvents: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'hours',
                        flagsFix: 1 << 7,
                        fieldLabel: UB.i18n('Годин'),
                        // valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 744,
                        enforceMaxLength: true,
                        allowExponential: false,
                        decimalPrecision: 3,
                        hideTrigger: true,
                        hidden: true,
                        enableKeyEvents: true,
                        mouseWheelEnabled: false
                      }
                    ]
                  },
                  {
                    xtype: 'ubfieldset',
                    name: 'experience',
                    title: UB.i18n('Стаж'),
                    margin: '10 0 0 10',
                    hidden: true,
                    layout: { type: 'vbox' },
                    defaults: { labelWidth: 190, width: 320 },
                    items: [
                      {
                        xtype: 'ubtextfield',
                        name: 'expName',
                        fieldLabel: UB.i18n('Назва'),
                        width: '100%',
                        hidden: true,
                        readOnly: true,
                        ubRequest: {
                          entity: 'hr_accrual',
                          fieldList: ['ID', 'payElID.dictExperienceID.name'],
                          orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
                        }
                      },
                      {
                        xtype: 'textfield',
                        name: 'expYear',
                        fieldLabel: UB.i18n('Років'),
                        hidden: true
                      },
                      {
                        xtype: 'textfield',
                        name: 'expMonth',
                        fieldLabel: UB.i18n('Місяців'),
                        hidden: true
                      },
                      {
                        xtype: 'numberfield',
                        name: 'extraRate',
                        fieldLabel: UB.i18n('Відсоток за розміром стажу'),
                        flagsFix: 1 << 19,
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      }
                    ]
                  },
                  {
                    layout: { type: 'vbox' },
                    defaults: { labelWidth: 200, width: 330 },
                    items: [
                      {
                        xtype: 'ubcombobox',
                        name: 'avgCalcType',
                        fieldLabel: UB.i18n('Тип розрахунку'),
                        hidden: true,
                        hideEntityItemInContext: true,
                        enumGroupFilter: 'HR_AVGCALC_TYPE',
                        valueField: 'code',
                        displayField: 'name',
                        ubRequest: {
                          entity: 'ubm_enum',
                          method: UB.core.UBCommand.methodName.SELECT,
                          fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                          whereList: {
                            eGroup: {
                              expression: '[eGroup]',
                              condition: 'equal',
                              values: { eGroup: 'HR_AVGCALC_TYPE' }
                            }
                          }
                        }
                      },
                      {
                        xtype: 'numberfield',
                        name: 'sumAvg',
                        flagsFix: 1 << 18,
                        fieldLabel: UB.i18n('Середньомісячна'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'planSumAvg',
                        flagsFix: 1,
                        fieldLabel: UB.i18n('Плановий заробіток'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'incomingDebtSum',
                        fieldLabel: UB.i18n('Вхідний залишок'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        readOnly: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'repaymentDebtSum',
                        flagsFix: 1 << 10,
                        fieldLabel: UB.i18n('Погашення залишку'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        margin: '3 15 15 15',
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'mtCount',
                        flagsFix: 1 << 8,
                        fieldLabel: UB.i18n('Кількість ставок'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 6,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'standingAll',
                        // flagsFix: 1 << 19,
                        fieldLabel: UB.i18n('Днів'),
                        enforceMaxLength: true,
                        allowExponential: false,
                        allowDecimals: false,
                        hideTrigger: true,
                        hidden: true,
                        enableKeyEvents: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'calendarDays',
                        flagsFix: 1 << 19,
                        fieldLabel: UB.i18n('Днів'),
                        enforceMaxLength: true,
                        allowExponential: false,
                        allowDecimals: false,
                        hideTrigger: true,
                        hidden: true,
                        enableKeyEvents: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'calculatedSum',
                        flagsFix: 1 << 11,
                        fieldLabel: UB.i18n('Розраховано за місяць'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'paySumAccrual',
                        flagsFix: 1 << 21,
                        fieldLabel: UB.i18n('Сума нарахування'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
                        minValue: -8999000000000000,
                        decimalPrecision: 2,
                        allowExponential: false,
                        hideTrigger: true,
                        hidden: true,
                        mouseWheelEnabled: false
                      },
                      {
                        xtype: 'numberfield',
                        name: 'repaymentSum',
                        flagsFix: 1 << 12,
                        fieldLabel: UB.i18n('Погашено за місяць'),
                        valueToRaw: UB.core.UBUtil.formatAsCurrency,
                        maxValue: 8999000000000000,
