              { name: 'dictProjectID' },
              { name: 'calcEarnings' },

              {
                name: 'periodSalaryID.name',
                columnConfig: {
                  text: UB.i18n('Обліковий період'),
                  sortable: false,
                  flex: 1
                }
              },
              {
                name: 'dateFrom',
                columnConfig: {
                  text: UB.i18n('З'),
                  flex: 1,
                  sortable: false,
                  dateFormat: 'd',
                  dataType: 'Date'
                }
              },
              {
                name: 'dateTo',
                columnConfig: {
                  text: UB.i18n('По'),
                  flex: 1,
