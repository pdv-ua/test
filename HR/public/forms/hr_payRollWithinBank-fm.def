/* global UB $App UBDomain appHR AC HR Ext appAC */
exports.formDef = {
  requiredFields: ['orderState', 'description', 'organizationID', 'orderType', 'periodCalcID', 'paymentMethod',
    'totalAmount', 'totalPaySum', 'applyRetention'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'filterButtonAction'
        },
        {
          orderId: 5,
          actionId: 'postingAction'
        },
        {
          orderId: 6,
          actionId: 'cancelPostingAction'
        },
        {
          orderId: 7,
          actionId: 'exportAction'
        },
        {
          orderId: 8,
          actionId: 'printAction'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        {
          layout: { type: 'hbox' },
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              defaults: { labelWidth: 150 },
              items: [
                {
                  layout: { type: 'hbox' },
                  defaults: { labelWidth: 140 },
                  items: [
                    {
                      attributeName: 'periodSalaryID',
                      fieldLabel: UB.i18n('За період'),
                      fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'name', 'isCurrent'],
                      pageSize: 50,
                      readOnly: true,
                      skipSetReadOnly: true,
                      flex: 1,
                      listeners: {
                        expand: appHR.periodExpand
                      }
                    },
                    {
                      attributeName: 'periodCalcID',
                      fieldLabel: UB.i18n('У періоді'),
                      fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'name', 'isCurrent'],
                      pageSize: 50,
                      readOnly: true,
                      flex: 1
                    } ]
                },
                {
                  attributeName: 'payElID',
                  allowBlank: false,
                  hideEntityItemInContext: true,
                  readOnly: true,
                  skipSetReadOnly: true,
                  fieldList: ['ID', 'description', 'methodID.methodGroupID.code', 'codeSort', 'roundUpTo'],
                  orderList: { orderBy: { expression: 'codeSort' } }
                },
                {
                  attributeName: 'payOutID',
                  fieldList: ['ID', 'name', 'organizationID', 'branchCode', 'projectCode', 'isDefault', 'exportMethodID'],
                  listeners: {
                    change: (ctrl, value) => {
                      const me = ctrl.up('form')
                      me.actions.exportAction.setDisabled(!value)
                    }
                  }
                },
                {
                  attributeName: 'percentPay',
                  fieldLabel: UB.i18n('Відсоток виплати'),
                  defaultValue: 100,
                  minValue: 0
                },
                {
                  attributeName: 'applyBalance',
                  listeners: {
                    change: (crtl, value) => {
                      const me = crtl.up('form')
                      if (me.formDataReady) { me.calc(me) }
                    }
                  }
                }
              ]
            },
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              defaults: { labelWidth: 80 },
              items: [
                {
                  layout: { type: 'hbox' },
                  items: [
                    {
                      attributeName: 'orderNumber',
                      fieldLabel: UB.i18n('Номер'),
                      labelWidth: 80,
                      flex: 1
                    },
                    {
                      attributeName: 'orderDate',
                      flex: 1,
                      labelWidth: 50,
                      fieldLabel: UB.i18n('Дата')
                    }
                  ]
                },
                {
                  attributeName: 'description'
                },
                {
                  attributeName: 'applyRetention',
                  fieldLabel: UB.i18n('Враховувати податки з обов\'язкових платежів'),
                  labelWidth: 350,
                  listeners: {
                    change: crtl => {
                      const me = crtl.up('form')
                      if (me.formDataReady) { me.calc(me) }
                    }
                  }
                },
                {
                  attributeName: 'applyAddRetention',
                  fieldLabel: UB.i18n('Враховувати додаткові утримання'),
                  labelWidth: 350,
                  listeners: {
                    change: crtl => {
                      const me = crtl.up('form')
                      if (me.formDataReady) { me.calc(me) }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      region: 'north',
      layout: { type: 'vbox', align: 'stretch' },
      split: true,
      items: [
        {
          xtype: 'panel',
          name: 'filterPanel',
          padding: '0 0 8 0',
          flex: 1,
          items: [
            {
              layout: { type: 'hbox' },
              items: [
                {
                  layout: { type: 'vbox', align: 'stretch' },
                  flex: 1,
                  items: [
                    {
                      layout: { type: 'hbox' },
                      items: [
                        {
                          attributeName: 'dictMultiGroupID',
                          fieldList: ['ID', 'name', 'orgID'],
                          labelWidth: 150,
                          flex: 1,
                          whereList: {
                            isClose: {
                              expression: '[isClose]',
                              condition: '=',
                              value: false
                            }
                          }
                        },
                        {
                          attributeName: 'includeSubDepGroup',
                          boxLabelAlign: 'after',
                          width: 120,
                          labelWidth: 90
                        }
                      ]
                    },
                    {
                      layout: { type: 'hbox' },
                      items: [
                        {
                          attributeName: 'departmentID',
                          fieldList: ['mi_data_id', 'name', 'orgID'],
                          valueField: 'mi_data_id',
                          displayField: 'name',
                          labelWidth: 150,
                          flex: 1,
                          __mip_recordhistory_all: false,
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              values: {
                                state: 'ACTIVE'
                              }
                            }
                          }
                        },
                        {
                          attributeName: 'includeSubDep',
                          boxLabelAlign: 'after',
                          width: 120,
                          labelWidth: 90
                        }
                      ]
                    }
                  ]
                },
                {
                  layout: { type: 'vbox', align: 'stretch' },
                  flex: 1,
                  items: [
                    {
                      xtype: 'ubboxselect',
                      attributeName: 'dictFundSourceList',
                      margin: '5 15 0 15',
                      fieldLabel: UB.i18n('Джерело фінансування'),
                      grow: false,
                      hideEntityItemInContext: true,
                      gridFieldList: ['ID', 'name'],
                      valueField: 'ID',
                      displayField: 'name',
                      ubRequest: {
                        entity: 'ac_fundSource',
                        fieldList: ['ID', 'name'],
                        whereList: {
                          groupCode: {
                            expression: '[dictFundTypeCode]',
                            condition: 'notEqual',
                            value: '02'
                          }
                        }
                      }
                    },
                    {
                      xtype: 'ubboxselect',
                      attributeName: 'dictProgClassList',
                      fieldLabel: UB.i18n('КПК'),
                      grow: false,
                      hideEntityItemInContext: true,
                      gridFieldList: ['ID', 'description'],
                      valueField: 'ID',
                      displayField: 'description',
                      ubRequest: {
                        entity: 'ac_dictProgClass',
                        fieldList: ['ID', 'description']
                      }
                    },
                    {
                      xtype: 'ubboxselect',
                      attributeName: 'dictProjectList',
                      fieldLabel: UB.i18n('Проєкт'),
                      grow: false,
                      hideEntityItemInContext: true,
                      gridFieldList: ['ID', 'description'],
                      valueField: 'ID',
                      displayField: 'description',
                      ubRequest: {
                        entity: 'ac_dictProject',
                        fieldList: ['ID', 'description']
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      xtype: 'tabpanel',
      region: 'center',
      listeners: {
        tabchange: function (tabPanel) {
          const me = tabPanel.up('form')
          if (me.changeCalcData) {
            me.calc(me)
          }
        }
      },
      items: [
        {
          title: UB.i18n('Документи нарахування'),
          layout: 'fit',
          items: [
            {
              xtype: 'acGrid',
              name: 'payRollPerm',
              stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_payRollWithIn_payRollPerm'),
              flex: 1,
              autoScroll: true,
              cellEditing: true,
              notWriteChanges: true,
              storeType: 'local',
              showToolBar: true,
              disablePaging: true,
              enableMultifilter: true,
              loadMaskMessage: UB.i18n('Завантаження даних...'),
              summary: { 'orderRegistryID.paySum': 'sum' },
              summaryDataOnClient: true,
              hideActions: ['addNewByCurrent'],
              onBeforeEdit: (control, context) => {
                const me = context.grid.up('form')
                me.beforeGridEdit(me, 'payRollPerm', context)
              },
              edit: (control, context) => {
                const me = context.grid.up('form')
                me.onGridEdit(me, 'payRollPerm', context, control)
              },
              customToolBarActions: [
                {
                  xtype: 'button',
                  iconCls: 'u-icon-list-success',
                  cls: 'fill-action',
                  scale: 'medium',
                  tooltip: UB.i18n('Додати списком'),
                  handler: function (btn) {
                    const me = btn.up('form')
                    if (me.attr.payRollPerm.getStore().count()) {
                      $App.dialogYesNo('Попередження', UB.i18n('Видалити раніше внесені документи?'))
                        .then(res => {
                          if (res) {
                            me.attr.payRollPerm.removeAll()
                            me.attr.payRollDt.removeAll()
                            me.attr.payOrder.removeAll()
                            me.setIsDirty(true)
                            me.selectOrderRegistry(me, true)
                          } else {
                            me.selectOrderRegistry(me, false)
                          }
                        })
                    } else {
                      me.selectOrderRegistry(me, true)
                    }
                  }
                }
              ],
              fields: [
                { name: 'ID' },
                { name: 'payRollID' },
                { name: 'mi_modifyDate' },
                { name: 'orderRegistryID' },
                { name: 'orderRegistryID.orderDate' },
                {
                  name: 'orderRegistryID.description',
                  columnConfig: {
                    text: UB.i18n('Назва'),
                    flex: 1,
                    filterBy: 'string',
                    editor: {
                      dataType: 'Entity',
                      xtype: 'accombobox',
                      hideEntityItemInContext: true,
                      disableClearSelection: true,
                      disableContextMenu: true,
                      associatedEntity: 'hr_orderRegistry',
                      storeAttributeValueField: 'orderRegistryID',
                      allowBlank: false,
                      fieldList: ['ID', 'description', 'periodID.name', 'orderNumber', 'orderState', 'orderType', 'organizationID', 'lineCount', 'paySum']
                    }
                  }
                },
                {
                  name: 'orderRegistryID.orderType',
                  columnConfig: {
                    text: UB.i18n('Тип'),
                    flex: 1,
                    filterBy: 'string',
                    dataType: UBDomain.ubDataTypes.Enum,
                    enumGroup: 'HR_ACCRDOC_TYPE',
                    ubRequest: {
                      entity: 'ubm_enum',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['name']
                    }
                  }
                },
                {
                  name: 'orderRegistryID.orderNumber',
                  columnConfig: {
                    text: UB.i18n('Номер'),
                    filterBy: 'string',
                    flex: 0.5
                  }
                },
                {
                  name: 'orderRegistryID.periodID.name',
                  columnConfig: {
                    text: UB.i18n('Період розрахунку'),
                    filterBy: 'string',
                    flex: 0.5
                  }
                },
                {
                  name: 'orderRegistryID.lineCount',
                  columnConfig: {
                    text: UB.i18n('Рядків'),
                    width: 50,
                    filterBy: 'float',
                    tooltip: UB.i18n('Кількість рядків'),
                    align: 'center'
                  }
                },
                {
                  name: 'orderRegistryID.paySum',
                  columnConfig: {
                    text: UB.i18n('Сума'),
                    flex: 0.5,
                    floatFormat: 2,
                    align: 'right',
                    filterBy: 'float',
                    sortBy: 'Number'
                  }
                }
              ]
            }
          ]
        },
        {
          title: UB.i18n('До виплати'),
          layout: 'fit',
          items: [
            {
              xtype: 'acGrid',
              name: 'payRollDt',
              stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_payRollWithIn_payRollDt'),
              flex: 1,
              autoScroll: true,
              cellEditing: true,
              notWriteChanges: true,
              storeType: 'local',
              showToolBar: true,
              disablePaging: true,
              enableMultifilter: true,
              loadMaskMessage: UB.i18n('Завантаження даних...'),
              summary: { docSum: 'sum', planPaySum: 'sum', baseSum: 'sum', taxSum: 'sum', paySum: 'sum', paidSum: 'sum', depSum: 'sum', dopTaxSum: 'sum' },
              summaryDataOnClient: true,
              ignoreAttr: ['posName', 'depName'],
              hideActions: ['addNewByCurrent', 'addNew'],
              includeContextMenuReadOnly: ['itemDelete', 'payOut'],
              checkColumn: {},
              onBeforeEdit: (control, context) => {
                const me = context.grid.up('form')
                me.setIsDirty(true)
                me.beforePayGridEdit(me, 'payRollDt', context)
              },
              edit: (control, context) => {
                const me = context.grid.up('form')
                me.onPayGridEdit(me, 'payRollDt', context, control)
              },
              onAfterRender: (grid) => {
                const me = grid.up('form')
                grid.menu.removeAll()
                grid.menu.add([
                  {
                    text: UB.i18n('Розрахунковий лист'),
                    iconCls: 'el-icon-tickets',
                    ubID: 'itemShowRl',
                    handler: function (context) {
                      const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                      if (record) {
                        appHR.showRl(record.get('employeeNumberID'))
                      }
                    }
                  },
                  {
                    text: UB.i18n('Особовий рахунок'),
                    iconCls: 'el-icon-s-custom',
                    ubID: 'itemShowEmployee',
                    handler: function (context) {
                      const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                      if (record) {
                        appHR.showEmployeeNumber(record.get('employeeNumberID'))
                      }
                    }
                  },
                  {
                    text: UB.i18n('Аналітика'),
                    iconCls: 'el-icon-notebook-2',
                    name: 'dimension',
                    cls: 'blue-action',
                    handler: (context) => {
                      const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                      if (record) {
                        const accrualDt = record.get('accrualDt')
                        if (accrualDt) {
                          $App.connection.run({
                            entity: 'hr_rl',
                            method: 'getDimension',
                            params: accrualDt,
                            orgID: me.record.get('organizationID')
                          }).then(response => {
                            const data = JSON.parse(response.resultData)
                            $App.doCommand({
                              cmdType: 'showForm',
                              formCode: 'hr_rlDimension',
                              isModal: true,
                              cmpInitConfig: {
                                defaultValues: data,
                                typeData: 'orderRegistryDt'
                              }
                            })
                          })
                        }
                      }
                    }
                  },
                  {
                    text: UB.i18n('Перенести на інший рахунок'),
                    iconCls: 'u-icon-share',
                    name: 'payOut',
                    handler: function (context) {
                      const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                      if (record) {
                        me.transferToPayOut(me, record)
                      }
                    }
                  },
                  {
                    xtype: 'menuseparator'
                  },
                  {
                    text: UB.i18n('showAudit'),
                    name: 'audit',
                    handler: function (context) {
                      const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                      if ($App.domainInfo.isEntityMethodsAccessible('uba_auditTrail', 'select') && record && record.get('ID')) {
                        UB.core.UBApp.showAuditTrail({
                          entityCode: 'hr_payRollDt',
                          instanceID: record.get('ID'),
                          isModal: false
                        })
                      }
                    }
                  },
                  {
                    xtype: 'menuseparator'
                  },
                  {
                    text: UB.i18n('Видалити запис'),
                    iconCls: 'fa fa-trash-o',
                    ubID: 'itemDelete',
                    handler: function (context) {
                      const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                      if (record && me.attr.periodSalaryID.getFieldValue('isCurrent')) {
                        $App.dialogYesNo(UB.i18n('Попередження!'), UB.i18n('Видалити запис?'))
                          .then(res => {
                            if (res) {
                              Ext.suspendLayouts()
                              grid.suspendEvents()
                              grid.getStore().suspendEvents()
                              grid.getStore().remove(record)
                              grid.getStore().removed = grid.getStore().removed.concat(record.getData())
                              grid.down('[name=delBtn]').setDisabled(grid.getCheckedRow().length === 0)
                              grid.resumeEvents()
                              grid.getStore().resumeEvents()
                              Ext.resumeLayouts(true)
                              grid.getView().refreshView()
                              me.setPayOrder(me, me.attr.payRollDt.getData())
                              grid.GridSummary.dataBind()
                              me.setIsDirty(true)
                            }
                          })
                      }
                    }
                  }
                ])
              },
              customToolBarActions: [
                {
                  xtype: 'button',
                  name: 'addBtn',
                  iconCls: 'u-icon-add',
                  cls: 'add-new-action',
                  scale: 'medium',
                  tooltip: UB.i18n('Додати'),
                  handler: function (btn) {
                    const me = btn.up('form')
                    me.setEmployeeNumbers(me)
                  }
                },
                {
                  xtype: 'button',
                  name: 'remarkBtn',
                  tooltip: UB.i18n('Зауваження (До виплати = 0)'),
                  iconCls: 'fas fa-ban',
                  cls: 'red-action',
                  scale: 'medium',
                  handler: function (btn) {
                    const me = btn.up('form')
                    me.viewReason = !me.viewReason
                    btn.addCls(me.viewReason ? 'add-new-action' : 'red-action')
                    btn.removeCls(!me.viewReason ? 'add-new-action' : 'red-action')
                    btn.setTooltip(me.viewReason ? UB.i18n('Зауваження (До виплати > 0)') : UB.i18n('Зауваження (До виплати = 0)'))
                    me.viewMark(me)
                  }
                },
                {
                  xtype: 'button',
                  tooltip: UB.i18n('Розрахувати'),
                  iconCls: 'fas fa-calculator',
                  cls: 'fill-action',
                  handler: function (btn) {
                    const me = btn.up('form')
                    me.setIsDirty(true)
                    me.calc(me, true)
                  }
                },
                {
                  xtype: 'button',
                  name: 'delBtn',
                  tooltip: UB.i18n('Видалити обрані записи'),
                  iconCls: 'far fa-trash-alt',
                  disabled: true,
                  handler: function (btn) {
                    const me = btn.up('form')
                    const grid = btn.up('acGrid')
                    const selectedItems = grid.getCheckedRow()
                    if (!selectedItems.length) {
                      return
                    }
                    $App.dialogYesNo(UB.i18n('Попередження!'), UB.i18n('Видалити відмічені записи?'))
                      .then(res => {
                        if (res) {
                          Ext.suspendLayouts()
                          grid.suspendEvents()
                          grid.getStore().suspendEvents()
                          grid.getStore().remove(selectedItems)
                          grid.getStore().removed = grid.getStore().removed.concat(selectedItems.map(row => row.getData()).filter(row => row.ID))
                          grid.down('[name=delBtn]').setDisabled(grid.getCheckedRow().length === 0)
                          grid.resumeEvents()
                          grid.getStore().resumeEvents()
                          Ext.resumeLayouts(true)
                          grid.getView().refreshView()
                          me.setPayOrder(me, me.attr.payRollDt.getData())
                          grid.GridSummary.dataBind()
                          me.setIsDirty(true)
                        }
                      })
                  }
                },
                {
                  xtype: 'button',
                  name: 'export',
                  tooltip: UB.i18n('Експорт у Excel'),
                  iconCls: 'fas fa-file-excel',
                  cls: 'green-action',
                  handler: function (btn) {
                    $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n('Експортувати записи платіжної відомості?'))
                      .then(res => {
                        if (res) {
                          const me = btn.up('form')
                          me.exportXLSX(me)
                        }
                      })
                  }
                }
              ],
              getRowClass: function (record) {
                const me = this.up('form')
                let rowClass = ''
                if (Math.abs(HR.accrualService.roundPayEl(record.get('planPaySum'), me.attr.payElID.getFieldValue('roundUpTo'), true) - record.get('paySum')) >= 0.01) {
                  rowClass = 'grd-color-blue'
                }
                const employeeNumberDateTo = record.get('employeeNumberID.dateTo') ? AC.dateService.shiftDate(record.get('employeeNumberID.dateTo')) : null
                if (employeeNumberDateTo && employeeNumberDateTo < me.attr.periodSalaryID.getFieldValue('dateTo')) {
                  rowClass = rowClass.length ? rowClass + '-bold' : 'grd-bold'
                }
                if (rowClass.length) {
                  return rowClass
                }
              },
              afterInit: function () {
              },
              fields: [
                { name: 'ID' },
                { name: 'payRollID' },
                { name: 'periodCalcID' },
                { name: 'periodCalc' },
                { name: 'periodSalaryID' },
                { name: 'periodSalary' },
                { name: 'dateFrom' },
                { name: 'dateTo' },
                { name: 'flagsFix' },
                { name: 'payRetentionID' },
                { name: 'employeePayOutID' },
                { name: 'payOutID' },
                { name: 'payRetentionID.payOutID.name' },
                { name: 'employeePayOutID.payOutID.name' },
                { name: 'reason' },
                { name: 'mask' },
                { name: 'accrualDt' },
                { name: 'paymentDt' },
                { name: 'employeeNumberID.dateTo' },
                {
                  name: 'employeeNumberID.description',
                  columnConfig: {
                    text: UB.i18n('Працівник'),
                    flex: 1,
                    filterBy: 'string',
                    editor: {
                      dataType: 'Entity',
                      disableClearSelection: true,
                      disableContextMenu: true,
                      hideEntityItemInContext: true,
                      associatedEntity: 'hr_employeePositionSR',
                      allowBlank: false,
                      fieldList: ['employeeNumberID.description', 'employeeNumberID', 'organizationID', 'depName', 'posName']
                    }
                  }
                },
                { name: 'employeeNumberID' },
                {
                  name: 'docSum',
                  columnConfig: {
                    hidden: true,
                    text: UB.i18n('Нараховано за документами'),
                    width: 150,
                    align: 'right',
                    floatFormat: 2,
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                },
                {
                  name: 'baseSum',
                  columnConfig: {
                    hidden: true,
                    text: UB.i18n('Нараховано'),
                    width: 150,
                    align: 'right',
                    floatFormat: 2,
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                },
                {
                  name: 'planPaySum',
                  columnConfig: {
                    hidden: true,
                    text: UB.i18n('Планова сума виплати'),
                    width: 150,
                    align: 'right',
                    floatFormat: 2,
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                },
                {
                  name: 'taxSum',
                  columnConfig: {
                    hidden: true,
                    text: UB.i18n('Податки'),
                    width: 150,
                    align: 'right',
                    floatFormat: 2,
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                },
                {
                  name: 'dopTaxSum',
                  columnConfig: {
                    hidden: true,
                    text: UB.i18n('Додатково утримано'),
                    width: 150,
                    align: 'right',
                    floatFormat: 2,
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                },
                {
                  name: 'paySum',
                  columnConfig: {
                    text: UB.i18n('До виплати'),
                    width: 150,
                    floatFormat: 2,
                    align: 'right',
                    sortBy: 'Number',
                    filterBy: 'float',
                    editor: {
                      dataType: 'Currency',
                      decimalPrecision: 2,
                      minValue: 0,
                      flagsFix: 2
                    }
                  }
                },
                {
                  name: 'payOutID.name',
                  columnConfig: {
                    text: UB.i18n('Шаблон виплати'),
                    width: 200,
                    sortByRendered: true,
                    filterBy: 'string',
                    renderer: (value, meta, record) => {
                      return record.get('payOutID.name') || record.get('payRetentionID.payOutID.name') || record.get('employeePayOutID.payOutID.name')
                    }
                  }
                },
                { name: 'paidSum' },
                { name: 'depSum' },
                { name: 'depName',
                  columnConfig: {
                    text: UB.i18n('Підрозділ'),
                    filterBy: 'string',
                    width: 150
                  }
                },
                {
                  name: 'posName',
                  columnConfig: {
                    text: UB.i18n('Посада'),
                    filterBy: 'string',
                    width: 150
                  }
                },
                {
                  name: 'reason',
                  columnConfig: {
                    hidden: true,
                    text: UB.i18n('Примітка'),
                    width: 300,
                    renderer: (value, metaData, record) => {
                      let result = null
                      switch (value) {
                        case '0':
                          if (record.get('flagsFix') & (1 << 1)) {
                            result = `Сума "До виплати" відкоригована користувачем`
                          } else if (record.get('flagsFix') & (1 << 3)) {
                            result = `Сума "До виплати" відкоригована Контролем виходу на борг`
                          } else {
                            result = 'Виплата'
                          }
                          break
                        case '1':
                          result = `Сума "До виплати" дорівнює нулю`
                          break
                        case '2':
                          result = `Вихідне сальдо менше або дорівнює нулю`
                          break
                        case '3':
                          result = `Виплату відмінено у постійних нарахуваннях працівника`
                          break
                        case '4':
                          result = `Працівника включено у іншу відомість виплати`
                          break
                      }
                      return result
                    }
                  },
                  filterBy: 'string'
                }
              ]
            }
          ]
        },
        {
          title: UB.i18n('Платіжні інструкції'),
          layout: 'fit',
          items: [
            {
              xtype: 'acGrid',
              name: 'payOrder',
              stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_payRollWithIn_payOrder'),
              autoScroll: true,
              readOnly: true,
              flex: 1,
              cellEditing: false,
              notWriteChanges: true,
              storeType: 'local',
              showToolBar: true,
              enableMultifilter: true,
              hideDefaultAction: true,
              exportExcel: {
                title: UB.i18n('Платіжні інструкції'),
                fileName: UB.i18n('Платіжні інструкції')
              },
              disablePaging: true,
              loadMaskMessage: UB.i18n('Завантаження даних...'),
              summary: { paySum: 'sum' },
              summaryDataOnClient: true,
              hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion', 'audit', 'itemSelect', 'history', 'prefilter'],
              includeCustomReadOnly: [],
              includeContextMenuReadOnly: [],
              onItemDoubleClick: function (row, record) {
                const me = this.up('form')
                me.showPaymentOrder(me, record)
              },
              customPopupMenuItems: [
                {
                  text: UB.i18n('Аналітика'),
                  iconCls: 'el-icon-notebook-2',
                  name: 'dimension',
                  cls: 'blue-action',
                  handler: (context) => {
                    const grid = context.up('').grid
                    const me = grid.up('form')
                    const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                    if (record) {
                      const accrualDt = record.get('paymentOrderAccDt')
                      if (accrualDt) {
                        $App.connection.run({
                          entity: 'hr_rl',
                          method: 'getDimension',
                          params: JSON.stringify(accrualDt),
                          orgID: me.record.get('organizationID')
                        }).then(response => {
                          const data = JSON.parse(response.resultData)
                          $App.doCommand({
                            cmdType: 'showForm',
                            formCode: 'hr_rlDimension',
                            isModal: true,
                            cmpInitConfig: {
                              defaultValues: data,
                              typeData: 'orderRegistryDt'
                            }
                          })
                        })
                      }
                    }
                  }
                }
              ],
              customToolBarActions: [
                {
                  xtype: 'button',
                  name: 'payOutBtn',
                  tooltip: UB.i18n('Шаблон виплати'),
                  iconCls: 'fas fa-eye',
                  cls: 'blue-action',
                  scale: 'medium',
                  handler: function (btn) {
                    const me = btn.up('form')
                    me.settings.isPayOut = !me.settings.isPayOut
                    btn.addCls(!me.settings.isPayOut ? 'blue-action' : 'green-action')
                    btn.removeCls(me.settings.isPayOut ? 'blue-action' : 'green-action')
                    UB.core.UBLocalStorageManager.setItem('hr_payRollPayOrder', JSON.stringify(me.settings))
                    me.setPayOrder(me, me.attr.payRollDt.getData())
                  }
                }
              ],
              fields: [
                { name: 'ID' },
                { name: 'periodCalcID' },
                { name: 'payRollID' },
                { name: 'postedDate' },
                { name: 'payObligatoryID' },
                { name: 'payObligatoryID.orgName' },
                { name: 'paymentOrderDt' },
                { name: 'paymentOrderAccDt' },
                { name: 'payObligatoryID.name',
                  columnConfig: {
                    text: UB.i18n('Призначення платежу'),
                    filterBy: 'string',
                    flex: 1
                  }
                },
                {
                  name: 'contrAccountID.organizationID.name',
                  columnConfig: {
                    text: UB.i18n('Отримувач'),
                    filterBy: 'string',
                    flex: 1
                  }
                },
                {
                  name: 'contrAccountID.description',
                  columnConfig: {
                    text: UB.i18n('Р/р отримувача'),
                    filterBy: 'string',
                    flex: 1
                  }
                },
                {
                  name: 'payOutID.name',
                  columnConfig: {
                    text: UB.i18n('Шаблон виплати'),
                    filterBy: 'string',
                    hidden: true,
                    width: 200
                  }
                },
                {
                  name: 'paySum',
                  columnConfig: {
                    text: UB.i18n('Сума'),
                    width: 150,
                    floatFormat: 2,
                    align: 'right',
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                }
              ]
            }
          ]
        },
        {
          title: UB.i18n('Підписанти'),
          xtype: 'ubdetailgrid',
          name: 'dictSigners',
          autoScroll: true,
          hideActions: ['addNew', 'showPreview', 'itemLink', 'commandLink', 'detail'],
          flex: 1,
          entityConfig: {
            entity: 'hr_dictSigners',
            method: 'select',
            fieldList: [
              {
                name: 'orderN',
                description: UB.i18n('№ з/п'),
                simpleFilter: true
              },
              {
                name: 'signerName',
                description: UB.i18n('Назва підписанта'),
                simpleFilter: true
              },
              {
                name: 'employeeNumberID.description',
                description: UB.i18n('Працівник'),
                simpleFilter: true
              },
              {
                name: 'positionName',
                description: UB.i18n('Назва посади'),
                simpleFilter: true
              }
            ],
            orderList: { orderBy: { 'expression': 'orderN', 'order': 'asc' } },
            whereList: {
              signerCode: {
                expression: '[signerCode]',
                condition: 'equal',
                value: 'PAYROLLWITHINBANK'
              }
            }
          },
          cmpInitConfig: {
            disableAutoLoadStore: true,
            afterInit: function () {
              AC.gridUtils.setGlobalOrganization(this, 'orgID')
            }
          },
          customActions: [
            {
              text: UB.i18n('Додати'),
              iconCls: 'u-icon-add',
              scale: 'medium',
              cls: 'add-new-action',
              handler: function sync (ctrl) {
                const me = ctrl.up('form')
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode: 'hr_dictSigners',
                  entity: 'hr_dictSigners',
                  sender: me.down('[name=dictSigners]'),
                  isModal: true,
                  cmpInitConfig: {
                    defaultValues: {
                      orgID: appAC.globalOrganization(),
                      departmentID: me.attr.departmentID.getValue(),
                      signerCode: 'PAYROLLWITHINBANK'
                    }
                  }
                })
              }
            },
            {
              xtype: 'button',
              iconCls: 'fas fa-angle-double-down',
              cls: 'fill-action',
              text: UB.i18n('Заповнити за замовчуванням'),
              handler: function sync (ctrl) {
                const me = ctrl.up('form')
                let departmentID = me.attr.departmentID.getValue()
                let orgID = appAC.globalOrganization()
                let dictSignerStore = me.down('[name=dictSigners]').getStore()

                UB.Repository('hr_dictSigners')
                  .attrs(['ID', 'departmentID', 'employeePositionID', 'employeeNumberID', 'positionName'])
                  .where('orgID', '=', orgID)
                  .where('signerCode', '=', 'PAYROLLWITHINBANK')
                  .whereIf(!departmentID, 'departmentID', 'isNull')
                  .whereIf(departmentID, 'departmentID', '=', departmentID)
                  .orderBy('orderN')
                  .selectAsObject().then(resp => {
                    if (resp && resp.length) {
                      $App.dialogYesNo(UB.i18n('Попередження!'), UB.i18n('Видалити існуючих підписантів?'))
                        .then(function (isYes) {
                          if (isYes) {
                            me.setLoading(true)
                            $App.connection.run({
                              entity: 'hr_dictSigners',
                              method: 'fillSignersByDefault',
                              params: JSON.stringify({
                                organizationID: orgID,
                                departmentID: departmentID,
                                signerCode: 'PAYROLLWITHINBANK'
                              })
                            }).then(({ resp }) => {
                              dictSignerStore.load()
                              me.setLoading(false)
                            }, function (err) {
                              me.setLoading(false)
                              throw err
                            })
                          }
                        })
                    } else {
                      me.setLoading(true)
                      $App.connection.run({
                        entity: 'hr_dictSigners',
                        method: 'fillSignersByDefault',
                        params: JSON.stringify({
                          organizationID: orgID,
                          departmentID: departmentID,
                          signerCode: 'PAYROLLWITHINBANK',
                          insertByDef: true
                        })
                      }).then(({ resp }) => {
                        dictSignerStore.load()
                        me.setLoading(false)
                      }, function (err) {
                        me.setLoading(false)
                        throw err
                      })
                    }
                  })
              }
            },
            {
              xtype: 'button',
              iconCls: 'fas fa-pencil-alt',
              cls: 'blue-action',
              text: UB.i18n('Оновити назви посади'),
              handler: function sync (ctrl) {
                const me = ctrl.up('form')
                let departmentID = me.attr.departmentID.getValue()
                let orgID = appAC.globalOrganization()
                let dictSignersStore = me.down('[name=dictSigners]').getStore()

                me.setLoading(true)
                $App.connection.run({
                  entity: 'hr_dictSigners',
                  method: 'updateSignersPos',
                  params: JSON.stringify({
                    organizationID: orgID,
                    departmentID: departmentID,
                    onDate: appAC.globalApplicationDate(),
                    signerCode: 'PAYROLLWITHINBANK'
                  })
                }).then(({ resp }) => {
                  dictSignersStore.load()
                  me.setLoading(false)
                }, function (err) {
                  me.setLoading(false)
                  throw err
                })
              }
            }
          ],
          customContextActions: [
            {
              text: UB.i18n('Оновити запис'),
              handler: () => {

              }
            }
          ]
        }
      ]
    }
  ]
}
