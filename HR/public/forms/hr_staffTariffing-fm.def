/* global HR AC UB appAC Ext $App */
exports.formDef = {
  requiredFields: ['orderState', 'description', 'orgName', 'reportSettings',
    'document', 'empOrderType', 'respEmployeeNumID.description', 'docText',
    'respPosDescription', 'respPos2Description', 'respPos3Description',
    'respPos4Description', 'respPos5Description'
  ],
  parentConfig: {
    hideActions: ['docActiondocument'],
    postOnlySimpleAttributes: true,
    layout: {
      type: 'vbox',
      align: 'stretch'
    }
  },
  size: {
    width: 1100,
    height: 650
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 6,
          actionId: 'postingAction'
        },
        {
          orderId: 7,
          actionId: 'cancelPostingAction'
        },
        {
          orderId: 8,
          actionId: 'printReports'
        },
        {
          orderId: 9,
          actionId: 'startReconciliation'
        },
        {
          orderId: 10,
          actionId: 'stopReconciliation'
        },
        {
          orderId: 11,
          actionId: 'toCompletion'
        },
        {
          orderId: 12,
          actionId: 'renewTask'
        },
        {
          orderId: 13,
          actionId: 'calculateTariffing'
        },
        {
          orderId: 14,
          actionId: 'checkData'
        },
        {
          xtype: 'checkbox',
          name: 'showOnlyVacancy',
          boxLabel: UB.i18n('Лише вакансії'),
          orderId: 15,
          listeners: {
            change: (ctrl) => {
              const me = ctrl.up('form')
              me.reloadData(me)
            }
          }
        }
      ]
    }],
  items: [
    {
      xtype: 'tabpanel',
      flex: 1,
      listeners: {
        tabchange: function (tabPanel, activeTab) {
          const me = tabPanel.up('form')
          if (activeTab.ubID === 'report') {
            if (!me.isPdfCreated) {
              if (!me.record.get('docText') && !['ON_RECONCILATION', 'RECONCILED', 'POSTED'].includes(me.record.get('orderState'))) {
                HR.reportTab.editHtml(me)
              } else {
                HR.reportTab.setReportMode(me, 'view')
              }
              me.isPdfCreated = true
            } else {
              HR.reportTab.setReportMode(me, ['ON_RECONCILATION', 'RECONCILED', 'POSTED'].includes(me.record.get('orderState')) ? 'view' : 'edit')
            }
          } else if (me.isNewInstance) {
            me.saveForm().then(result => {
              if (result === -1) {
                me.down('tabpanel').setActiveTab(0)
              }
            })
          }
        }
      },
      items: [
        {
          title: UB.i18n('Загальне'),
          layout: { type: 'vbox', align: 'stretch' },
          defaults: { labelWidth: 170 },
          autoScroll: true,
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              defaults: { labelWidth: 165 },
              items: [
                {
                  layout: { type: 'hbox' },
                  items: [
                    {
                      attributeName: 'orderNumber',
                      allowBlank: true,
                      labelWidth: 165,
                      width: 350
                    },
                    {
                      attributeName: 'orderDate',
                      fieldLabel: UB.i18n('Дата'),
                      labelWidth: 80
                    },
                    {
                      attributeName: 'entryDate',
                      fieldLabel: UB.i18n('Станом на'),
                      labelWidth: 120
                    }
                  ]
                },
                {
                  attributeName: 'name'
                },
                {
                  attributeName: 'orgID',
                  readOnly: true,
                  fieldList: ['mi_data_id', 'description'],
                  displayField: 'description',
                  __mip_recordhistory_all: true,
                  whereList: {
                    state: {
                      expression: '[state]',
                      condition: 'equal',
                      values: {
                        state: 'ACTIVE'
                      }
                    }
                  }
                },
                {
                  layout: { type: 'hbox' },
                  items: [
                    {
                      attributeName: 'departmentID',
                      fieldList: ['ID', 'mi_data_id', 'description', 'state', 'orgID'],
                      gridFieldList: ['description', 'state', 'orgID'],
                      hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink'],
                      hideEntityItemInContext: true,
                      disableModifyEntity: true,
                      valueField: 'mi_data_id',
                      displayField: 'description',
                      labelWidth: 165,
                      flex: 1,
                      whereList: {
                        orgID: {
                          expression: '[orgID]',
                          condition: 'equal',
                          value: appAC.globalOrganization()
                        },
                        state: {
                          expression: '[state]',
                          condition: '=',
                          values: {
                            state: 'ACTIVE'
                          }
                        }
                      },
                      listeners: {
                        change: function (ctrl, value) {
                          const me = ctrl.up('form')
                          me.down('[name=includeChildDepts]').setValue(!!value)
                        }
                      }
                    },
                    {
                      xtype: 'checkboxfield',
                      name: 'includeChildDepts',
                      boxLabel: UB.i18n('з підлеглими'),
                      labelWidth: 100,
                      width: 120,
                      checked: false,
                      readOnly: true
                    }
                  ]
                },
                { attributeName: 'orgStructureID', hidden: true },
                {
                  attributeName: 'textOrder'
                },
                {
                  attributeName: 'comment'
                },
                {
                  attributeName: 'respEmployeeNumID',
                  xtype: 'empNumComboBox',
                  showEntityName: 'hr_employee',
                  showFormCode: 'hr_employee',
                  instanceAttr: 'employeeID',
                  fieldList: ['ID', 'description', 'employeeID'],
                  hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                  gridFieldList: ['description'],
