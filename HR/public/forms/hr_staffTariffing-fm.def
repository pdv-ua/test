              '${me.hideSigner4 ? `` : `<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;' + UB.i18n('Затвердив 2') + '&nbsp;</span> ${get("respPos4Description")} ${get("respEmployeePosition4ID.description")}<br>`}',
