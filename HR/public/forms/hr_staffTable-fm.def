                    $App.dialogYesNo('Увага', 'Очистити всі записи?').then(result => {
                      if (result) {
                        me.deleteAccrualChanges()
                      }
                    })
                  }
                },
                {
                  xtype: 'button',
                  name: 'applyAccrualsBtn',
                  text: UB.i18n('Застосувати зміни'),
                  iconCls: 'fas fa-check',
                  cls: 'green-action',
                  disabled: true,
                  hidden: !AC.entityUtils.verifyRightsMethod('hr_massAccrualChange', 'applyChanges'),
                  handler: function (btn) {
                    const me = btn.up('form')
                    $App.dialogYesNo('Увага', 'Застосувати зміни до Штатного розпису?').then(result => {
                      if (result) {
                        me.applyAccrualChanges()
                      }
                    })
                  }
                },
                {
                  xtype: 'button',
                  name: 'cancelAccrualsBtn',
                  text: UB.i18n('Видалити зміни'),
                  iconCls: 'fas fa-times', // 'fas fa-redo',
                  cls: 'red-action',
                  disabled: true,
                  hidden: !AC.entityUtils.verifyRightsMethod('hr_massAccrualChange', 'applyChanges'),
                  handler: function (btn) {
                    const me = btn.up('form')
                    $App.dialogYesNo('Увага', 'Відмінити всі зміни?').then(result => {
                      if (result) {
                        me.cancelAccrualChanges()
                      }
                    })
                  }
                },
                {
                  xtype: 'button',
                  name: 'sortByTreePath',
                  text: UB.i18n('Сортування згідно з ШР'),
                  iconCls: 'fas fa-sort-amount-down-alt',
                  cls: 'fill-action',
                  handler: function (btn) {
                    const me = btn.up('form')
                    const massAccrualChange = me.down('[name=massAccrualChange]')
                    const store = massAccrualChange.getStore()
                    store.ubRequest.orderList = { orderBy: { 'expression': 'positionID.treePath', 'order': 'asc' } }
                    store.sorters.clear()
                    massAccrualChange.onRefresh()
                  }
                }
              ],
              onBeforeEdit: (rowEditor, context) => {
                const me = context.grid.up('form')
                if (['ON_RECONCILATION', 'RECONCILED', 'POSTED', 'PROCESSED'].includes(me.record.get('orderState'))) {
                  return false
                }
                if (context.record.get('action') === 'CANCEL') return false
                const editor = rowEditor.editor
                const valuationCtrl = editor.query(`[name=valuation]`)[0]
                valuationCtrl.store.filter({
                  filterFn: function (item) { return ['SUM', 'PRC'].includes(item.get('code')) }
                })
              },
              listeners: {
                edit: (control, context) => {
                  const me = context.grid.up('form')
                  me.onAfterMassAccrualChange(context, control)
                }
              },
              cmpInitConfig: {
                customInit: function () {
                  const notShowSalary = AC.entityUtils.verifyRightsMethod('hr_service', 'notShowSalary') && !AC.entityUtils.isAdmin()
                  const grid = this
                  const renderer = {
                    valueOld: {
                      renderer: function (value, meta, record) {
                        const valuation = record.get ? record.get('valuationOld') : ''
                        const valuationText = valuation === 'SUM' ? UB.i18n('грн.') : (valuation === 'PRC' ? '%' : '')
                        return `${notShowSalary ? 0 : (value || '')} ${valuationText}`
                      }
                    }
                  }
                  if (notShowSalary) {
                    renderer.valueNew = {
                      renderer: function (value) {
                        return 0
                      }
                    }
                  }
                  AC.gridUtils.tuneGridColumns(grid, renderer)
                }
              }
            }
          ]
        },
        {
          title: UB.i18n('Зміна параметрів'),
          layout: {
            type: 'border'
          },
          items: [
            {
              xtype: 'panel',
              region: 'north',
              layout: { type: 'vbox', align: 'stretch' },
              items: [
                {
                  layout: { type: 'hbox' },
                  items: [
                    {
                      xtype: 'ubcombobox',
                      fieldLabel: UB.i18n('Тип посади'),
                      labelWidth: 195,
                      margin: '10 5 0 15',
                      name: 'positionType',
                      disabledIf: (ctrl, me) => me.checkReadOnly(),
                      hideEntityItemInContext: true,
                      valueField: 'code',
                      ubRequest: {
                        entity: 'ubm_enum',
                        method: UB.core.UBCommand.methodName.SELECT,
                        fieldList: ['ID', 'name', 'code', 'eGroup'],
                        whereList: {
                          enumGroupFilter: {
                            expression: '[eGroup]',
                            condition: 'equal',
                            values: {
                              val: 'HR_POSITION_TYPE'
                            }
                          }
                        }
                      },
                      listeners: {
                        change: (ctrl, value) => {
                          const me = ctrl.up('form')
                          HR.orderManager.showIf(me)
                          HR.orderManager.disabledIf(me)
                          HR.orderManager.requiredIf(me)
                          if (ctrl.skipChange) {
                            delete ctrl.skipChange
                            return
                          }
                          me.down('[name=massPosChange]').getStore().load().then(store => {
                            const askPromise = store.getCount() === 0 ? Promise.resolve(true) : $App.dialogYesNo(UB.i18n('Увага'), UB.i18n('Список посад буде очищено. Продовжити?'))
                            askPromise.then(result => {
                              if (result) {
                                const attrsToClear = ['1', '5', '6'].includes(value)
                                  ? ['checkDictSpecialtyID', 'dictSpecialtyID', 'checkDictEmpCategoryID', 'dictEmpCategoryID', 'checkDictTarifCoeffID', 'dictTarifCoeffID']
                                  : ['checkDictWagePayID', 'dictWagePayID', 'checkPsCategory', 'psCategory', 'checkDictStatePayID', 'dictStatePayID', 'checkReformer', 'reformer']
                                attrsToClear.forEach(attr => {
                                  if (me.attr[attr].setValueById) {
                                    me.attr[attr].setValueById()
                                  } else {
                                    me.attr[attr].setValue()
                                  }
                                })
                                ctrl.oldValue = value
                                me.setIsDirty(true)
                                me.deletePosChanges(true)
                              } else {
                                ctrl.skipChange = true
                                ctrl.setValue(ctrl.oldValue)
