                                    }
                                  },
                                  flex: 1
                                }
                              ]
                            },
                            {
                              layout: { type: 'hbox' },
                              disabledIf: (ctrl, me) => me.checkReadOnly(),
                              items: [
                                {
                                  xtype: 'checkbox',
                                  name: 'checkDictCostTypeID',
                                  width: 20,
                                  listeners: {
                                    change: (ctrl, value) => {
                                      if (ctrl.skipChange) {
                                        delete ctrl.skipChange
                                        return
                                      }
                                      const me = ctrl.up('form')
                                      if (!value) me.attr.dictCostTypeID.setValue()
                                      me.setIsDirty(true)
                                    }
                                  }
                                },
                                {
                                  xtype: 'ubcombobox',
                                  fieldLabel: UB.i18n('Місце виникнення виробничих витрат'),
                                  labelWidth: 140,
                                  disableModifyEntity: true,
                                  displayField: 'description',
                                  name: 'dictCostTypeID',
                                  ubRequest: {
                                    entity: 'ac_dictCostType',
                                    method: UB.core.UBCommand.methodName.SELECT,
                                    fieldList: ['ID', 'name', 'code', 'description']
                                  },
                                  listeners: {
                                    select: (ctrl) => {
                                      const me = ctrl.up('form')
                                      me.attr.checkDictCostTypeID.setValue(true)
                                    },
                                    change: (ctrl, value) => {
                                      if (ctrl.skipChange) {
                                        delete ctrl.skipChange
                                        return
                                      }
                                      const me = ctrl.up('form')
                                      me.attr.checkDictCostTypeID.setValue(!!value)
                                      me.setIsDirty(true)
                                    }
                                  },
                                  flex: 1
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              xtype: 'ubdetailgrid',
              name: 'massPosChange',
              hideActions: ['addNew', 'addNewByCurrent', 'edit'],
              region: 'center',
              entityConfig: {
                entity: 'hr_massPosChange',
                method: 'select',
                fieldList: [
                  { name: 'selfStructDepName', description: UB.i18n('Назва самостійного підрозділу') },
                  { name: 'depName', description: UB.i18n('Підрозділ') },
                  { name: 'posName', description: UB.i18n('Посада') },
                  { name: 'accrualSum' },
                  { name: 'fundTotal' },
                  { name: 'workScheduleID.name', description: UB.i18n('Графік роботи') },
                  { name: 'positionType', description: UB.i18n('Тип посади') },
                  { name: 'positionCategory', description: UB.i18n('Категорія посади') },
                  { name: 'dictStaffCatID.name', description: UB.i18n('Категорія персоналу') },
                  { name: 'dictStaffSubCatID.name', description: UB.i18n('Підкатегорія персоналу') },
                  { name: 'dictCostTypeID.description', description: UB.i18n('Місце виникнення виробничих витрат') },
                  { name: 'positionID', visibility: false },
                  { name: 'mi_modifyDate', visibility: false },
                  { name: 'positionID.treePath', visibility: false }
                ],
                orderList: {
                  orderBy: { 'expression': 'positionID.treePath', 'order': 'asc' }
                }
              },
              masterFields: ['ID'],
              detailFields: ['staffTableID'],
              cmpInitConfig: {
                onItemDblClick: () => {},
                customInit: function () {
                  const grid = this
                  const notShowSalary = AC.entityUtils.verifyRightsMethod('hr_service', 'notShowSalary') && !AC.entityUtils.isAdmin()
                  if (notShowSalary) {
                    const renderer = {}
                    renderer.accrualSum = { renderer: function (value) { return 0 } }
                    renderer.fundTotal = { renderer: function (value) { return 0 } }
                    AC.gridUtils.tuneGridColumns(grid, renderer)
                  }
                }
              },
              customActions: [
                {
                  xtype: 'button',
                  name: 'selectPosition',
                  text: UB.i18n('Відібрати посади'),
                  iconCls: 'fas fa-angle-double-down',
                  cls: 'fill-action',
                  handler: function (btn) {
                    const me = btn.up('form')
                    if (!me.attr.positionType.getValue()) {
                      $App.dialogError(UB.i18n('Потрібно вибрати тип посади'))
                      return
                    }
                    $App.doCommand({
                      cmdType: 'showForm',
                      formCode: 'hr_massPosSearch',
                      isModal: true,
                      customParams: {
                        positionType: [{ value: me.attr.positionType.getValue(), description: me.attr.positionType.rawValue }],
                        sender: me,
                        onSelectData: (data) => {
                          if (data) {
                            me.loadPosChanges(data)
                          }
                        }
                      }
                    })
                  }
                },
                {
                  xtype: 'button',
                  name: 'deletePosChangesBtn',
                  text: UB.i18n('Очистити всі'),
                  iconCls: 'fas fa-eraser',
                  cls: 'fill-action',
                  handler: function (btn) {
                    const me = btn.up('form')
                    $App.dialogYesNo('Увага', 'Очистити всі записи?').then(result => {
                      if (result) {
                        me.deletePosChanges()
                      }
                    })
                  }
                },
                {
                  xtype: 'button',
                  name: 'applyPosChangesBtn',
                  text: UB.i18n('Застосувати зміни'),
                  iconCls: 'fas fa-check',
                  cls: 'green-action',
                  disabled: true,
                  hidden: !AC.entityUtils.verifyRightsMethod('hr_massPosChange', 'applyChanges'),
                  handler: function (btn) {
                    const me = btn.up('form')
                    $App.dialogYesNo('Увага', 'Застосувати зміни до Штатного розпису?').then(result => {
                      if (result) {
                        me.applyPosChanges()
                      }
                    })
                  }
                },
                {
                  xtype: 'button',
                  name: 'cancelPosChangesBtn',
                  text: UB.i18n('Видалити зміни'),
                  iconCls: 'fas fa-times',
                  cls: 'red-action',
                  disabled: true,
                  hidden: !AC.entityUtils.verifyRightsMethod('hr_massPosChange', 'applyChanges'),
                  handler: function (btn) {
                    const me = btn.up('form')
                    $App.dialogYesNo('Увага', 'Відмінити всі зміни?').then(result => {
                      if (result) {
                        me.cancelPosChanges()
                      }
                    })
                  }
                },
                {
                  xtype: 'button',
                  name: 'sortByTreePath',
                  text: UB.i18n('Сортування згідно з ШР'),
                  iconCls: 'fas fa-sort-amount-down-alt',
                  cls: 'fill-action',
                  handler: function (btn) {
                    const me = btn.up('form')
                    const massPosChangeGrid = me.down('[name=massPosChange]')
                    const store = massPosChangeGrid.getStore()
                    store.ubRequest.orderList = { orderBy: { 'expression': 'positionID.treePath', 'order': 'asc' } }
                    store.sorters.clear()
                    massPosChangeGrid.onRefresh()
                  }
                }
              ]
            }
          ]
        },
        HR.reportTab.getTabConfig({ getRepName: 'getReportName', repTabIndex: 5, addExcel: true }),
        {
          title: UB.i18n('Маршрут'),
          autoScroll: true,
          layout: 'fit',
          flex: 1,
          items: [
            {
              xtype: 'recpanel',
              name: 'recpanel'
            }
          ]
        },
        {
          title: UB.i18n('Історія змін'),
          autoScroll: true,
          layout: 'fit',
          flex: 1,
          items: [
            {
              name: 'stateHistory',
              xtype: 'ubdetailgrid',
              disableSearchBar: true,
              readOnly: true,
              flex: 1,
              entityConfig: {
                entity: 'hr_orderStateHistory',
                method: 'select',
                fieldList: [
                  { name: 'actionType' },
                  { name: 'comments' },
                  { name: 'orderState' },
                  { name: 'userID.name', description: UB.i18n('Користувач') },
                  { name: 'actionDateTime' }
                ]
              },
              masterFields: ['ID'],
              detailFields: ['orderID'],
              cmpInitConfig: {
                onItemDblClick: () => {}
              }
            }
          ]
        }
      ]
    }
  ]
}
