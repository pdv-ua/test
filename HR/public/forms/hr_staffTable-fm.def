                  { name: 'depName', description: UB.i18n('Підрозділ'), editor: { readOnly: true } },
                  { name: 'payElID.description', description: UB.i18n('Вид оплати'), editor: { readOnly: true } },
                  { name: 'valuation', description: UB.i18n('Оцінка') },
                  { name: 'valueNew', description: UB.i18n('Значення'), editor: { allowBlank: false } },
                  { name: 'valueOld', description: UB.i18n('Попереднє значення'), editor: { readOnly: true } },
                  { name: 'positionType', description: UB.i18n('Тип посади'), editor: { readOnly: true } },
                  { name: 'positionCategory', description: UB.i18n('Категорія посади'), editor: { readOnly: true } },
                  { name: 'dictStaffCatName', description: UB.i18n('Категорія персоналу'), editor: { readOnly: true } },
                  { name: 'positionID', visibility: false },
                  { name: 'mi_modifyDate', visibility: false },
                  { name: 'valuationOld', visibility: false },
                  { name: 'positionID.treePath', visibility: false }
                ],
