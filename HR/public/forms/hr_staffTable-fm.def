                  const notShowSalary = AC.entityUtils.verifyRightsMethod('hr_service', 'notShowSalary') && !AC.entityUtils.isAdmin()
                  const renderer = {
                    'mi_modifyUser.employeeNumberID.description': {
                      renderer: function (value, meta, record) {
                        return record.get ? `${value} (${AC.dateService.formatDate(record.get('mi_modifyDate'))})` : value
                      }
                    }
                  }
                  if (notShowSalary) {
                    renderer.accrualSum = { renderer: function (value) { return 0 } }
                    renderer.accrualSumCur = { renderer: function (value) { return 0 } }
                    renderer.rateDelta = { renderer: function (value) { return 0 } }
                    renderer.sumDelta = { renderer: function (value) { return 0 } }
                  }
                  AC.gridUtils.tuneGridColumns(grid, renderer)
                }
              }
            }
          ]
        },
