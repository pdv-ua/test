                    const massSalaryChange = me.down('[name=massSalaryChange]')
                    const store = massSalaryChange.getStore()
                    store.ubRequest.orderList = { orderBy: { 'expression': 'positionID.treePath', 'order': 'asc' } }
                    store.sorters.clear()
                    massSalaryChange.onRefresh()
                  }
