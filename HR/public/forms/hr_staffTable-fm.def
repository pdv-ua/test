                    me.fillAccrualChanges()
                  }
                },
                {
                  xtype: 'button',
                  name: 'deleteAccrualsBtn',
                  text: UB.i18n('Очистити всі'),
                  iconCls: 'fas fa-eraser',
                  cls: 'fill-action',
                  handler: function (btn) {
