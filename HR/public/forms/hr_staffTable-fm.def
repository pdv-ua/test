/* global HR AC UB appAC Ext $App */
exports.formDef = {
  requiredFields: ['orderState', 'entryDate', 'description', 'entryOrderID.orderNumber', 'entryOrderID.orderDate',
    'entryOrderID.entryDate', 'entryOrderID.respEmployeePositionID.employeeID.fullFIO', 'orgName', 'reportSettings',
    'document', 'empOrderType', 'respEmployeeNumID.description', 'docText', 'docType.name', 'orgID.description',
    'salaryChangesApplied', 'accrualChangesApplied', 'respPosDescription', 'respPos2Description', 'respPos3Description',
    'respPos4Description', 'respPos5Description', 'massPosChangeParam', 'posChangesApplied'
  ],
  parentConfig: {
    hideActions: ['docActiondocument'],
    postOnlySimpleAttributes: true,
    layout: {
      type: 'vbox',
      align: 'stretch'
    }
  },
  size: {
    width: 1100,
    height: 650
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 6,
          actionId: 'createOrder'
        },
        {
          orderId: 7,
          actionId: 'printReports',
          iconCls: 'fas fa-print',
          cls: 'blue-action'
        },
        {
          orderId: 8,
          actionId: 'startReconciliation'
        },
        {
          orderId: 9,
          actionId: 'stopReconciliation'
        },
        {
          orderId: 10,
          actionId: 'toCompletion'
        },
        {
          orderId: 11,
          actionId: 'renewTask'
        },
        {
          orderId: 12,
          actionId: 'checkQuantity'
        }
      ]
    }],
  items: [
    {
      xtype: 'tabpanel',
      flex: 1,
      listeners: {
        tabchange: function (tabPanel, activeTab) {
          const me = tabPanel.up('form')
          if (activeTab.ubID === 'report') {
            if (!me.isPdfCreated) {
              if (!me.record.get('docText') && !['ON_RECONCILATION', 'RECONCILED', 'POSTED'].includes(me.record.get('orderState'))) {
                HR.reportTab.editHtml(me)
              } else {
                HR.reportTab.setReportMode(me, 'view')
              }
              me.isPdfCreated = true
            } else {
              HR.reportTab.setReportMode(me, ['ON_RECONCILATION', 'RECONCILED', 'POSTED'].includes(me.record.get('orderState')) ? 'view' : 'edit')
            }
          } else if (me.isNewInstance) {
            me.saveForm().then(result => {
              if (result === -1) {
                me.down('tabpanel').setActiveTab(0)
              }
            })
          }
        }
      },
      items: [
        {
          title: UB.i18n('Загальне'),
          layout: { type: 'vbox', align: 'stretch' },
          defaults: { labelWidth: 170 },
          autoScroll: true,
          items: [
            /* eslint-disable no-template-curly-in-string */
            AC.viewUtils.getCollapsiblePanel(
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;№</span> ${get("orderNumber")} <span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Організація")}</span> ${get("orgID.description")}<br>' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Назва")}</span> ${get("name")} ' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Опис")}</span> ${get("textOrder")} <span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Коментар")} </span> ${get("comment")}<br>' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Наказ про введення в дію")} </span> ${get("entryOrderID.description") || ""} ' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${get("entryOrderID") ? UB.i18n("Дата введення в дію") : ""}</span> ${get("entryOrderID.entryDate") ? moment(get("entryOrderID.entryDate")).format("DD.MM.YYYY") : "" }',
              {
                layout: { type: 'hbox' },
                collapsedOnInsert: true,
                items: [
                  {
                    layout: { type: 'vbox', align: 'stretch' },
                    defaults: { labelWidth: 165 },
                    flex: 1,
                    items: [
                      {
                        layout: { type: 'hbox' },
                        items: [
                          {
                            attributeName: 'orderNumber',
                            allowBlank: true,
                            flex: 1,
                            labelWidth: 165
                          },
                          {
                            attributeName: 'orderDate',
                            fieldLabel: UB.i18n('Дата вступу в дію останніх змін'),
                            labelWidth: 220,
                            width: 340,
                            hidden: true
                          }
                        ]
                      },
                      {
                        attributeName: 'name'
                      },
                      {
                        attributeName: 'orgID',
                        readOnly: true,
                        fieldList: ['mi_data_id', 'description'],
                        displayField: 'description',
                        __mip_recordhistory_all: true,
                        whereList: {
                          state: {
                            expression: '[state]',
                            condition: 'equal',
                            values: {
                              state: 'ACTIVE'
                            }
                          }
                        }
                      },
                      { attributeName: 'orgStructureID', hidden: true },
                      {
                        attributeName: 'textOrder'
                      },
                      {
                        attributeName: 'comment'
                      }
