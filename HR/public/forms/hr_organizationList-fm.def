/* global Ext appAC $App UB */

exports.formDef = 'HR.organizationList'

Ext.define('HR.organizationList', {
  extend: 'Ext.panel.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.organizationList',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  mainPanel: {
    xtype: 'panel',
    header: false,
    region: 'center',
    flex: 1,
    layout: 'fit',
    items: [
      {
        xtype: 'ubdetailgrid',
        autoScroll: true,
        layout: 'fit',
        flex: 1,
        hideActions: ['addNew', 'addNewByCurrent', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
        stateful: true,
        stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_organizationList_grid'),
        cmdType: 'showList',
        description: UB.i18n('Організація'),
        entity: 'hr_organization',
        cmdData: {
          params: [{
            entity: 'hr_organization',
            method: 'select',
            fieldList: [{ name: 'code', description: UB.i18n('Код') },
              { name: 'name', description: UB.i18n('Назва') },
              { name: 'fullName', description: UB.i18n('Повна назва') },
              { name: 'nameGen', description: UB.i18n('Родовий (кого, чого)') },
              { name: 'conditionalName', description: UB.i18n('Умовна назва') },
              { name: 'shortName', description: UB.i18n('Скорочена назва') },
              { name: 'tarifGroupID.code', description: UB.i18n('Тарифна група') },
              { name: 'parentUnitID.name', description: UB.i18n('Підпорядкування') },
              { name: 'parentUnitTypeID', description: UB.i18n('Тип підпорядкування') },
              { name: 'jurisdiction', description: UB.i18n('Юрисдикція держоргану') },
              { name: 'dictGovernmTypeID', description: UB.i18n('Тип державного органу') },
              { name: 'webAddress', description: UB.i18n('Адреса офіційного сайту') },
              { name: 'dictFundSourceID', description: UB.i18n('Джерело фінансування') },
              { name: 'depClassExpID', description: UB.i18n('Відомча класифікація видатків') },
              { name: 'dictAreasActivityID', description: UB.i18n('Напрям діяльності') },
              { name: 'powerBranch', description: UB.i18n('Гілка влади') },
              { name: 'limitEmpDocBasis', description: UB.i18n('Документ-підстава') },
              { name: 'limitEmpCivServ', description: UB.i18n('Держслужбовців') },
              { name: 'limitEmpNum', description: UB.i18n('Всього працівників') },
              { name: 'doNotTransfer', description: UB.i18n('Не передавати структуру до Порталу') },
              { name: 'nameEng', description: UB.i18n('Назва (англ)') },
              { name: 'EDRPOUCode', description: UB.i18n('ЄДРПОУ') },
              { name: 'taxCode', description: UB.i18n('Податковий номер') },
              { name: 'state', description: UB.i18n('Стан') },
              { name: 'mi_dateFrom', description: UB.i18n('Дата початку дії'), format: 'd.m.Y' },
              { name: 'dateToEmpty', description: UB.i18n('Дата закінчення дії'), format: 'd.m.Y' },
              { name: 'entryOrderID.description', description: UB.i18n('Наказ') },
              { name: 'staffOrderID.description', description: UB.i18n('Штатний розпис') },
              { name: 'description', description: UB.i18n('Опис'), visibility: false }
            ],
            __mip_recordhistory_all: true,
            whereList: {
              parentIsNull: {
                expression: '[parentUnitID]',
                condition: 'isNull'
              },
              parentDateFrom: {
                expression: '[parentUnitID.mi_dateFrom]',
                condition: 'lessEqual',
                value: appAC.globalApplicationDate()
              },
              parentDateTo: {
                expression: '[parentUnitID.mi_dateTo]',
                condition: 'moreEqual',
                value: appAC.globalApplicationDate()
              },
              parentState: {
                expression: '[parentUnitID.state]',
                condition: '=',
                value: 'ACTIVE'
              },
              dateFrom: {
                expression: '[mi_dateFrom]',
                condition: 'lessEqual',
                value: appAC.globalApplicationDate()
              },
              dateTo: {
                expression: '[mi_dateTo]',
                condition: 'moreEqual',
                value: appAC.globalApplicationDate()
              },
              state: {
                expression: '[state]',
                condition: '=',
                value: 'ACTIVE'
              }
            },
            logicalPredicates: ['([parentIsNull] OR ([parentState] AND [parentDateFrom] AND [parentDateTo]))']
          }]
        },
        cmpInitConfig: {
          customInit: function () {
          }
        }
      }
    ]
  },

  initComponent: function () {
    let me = this
    me.items = [
      me.mainPanel
    ]
    me.changeGlobal = function () {
      const store = me.down('ubdetailgrid').getStore()
      const globalDate = appAC.globalApplicationDate()
      store.ubRequest.whereList.parentDateFrom.value = globalDate
      store.ubRequest.whereList.parentDateTo.value = globalDate
      store.ubRequest.whereList.dateFrom.value = globalDate
      store.ubRequest.whereList.dateTo.value = globalDate
      store.load()
    }

    me.on('afterrender', () => {
      $App.on('ac:app:operationDateChanged', me.changeGlobal)
    }, me)
    me.on('destroy', () => {
      $App.un('ac:app:operationDateChanged', me.changeGlobal)
    }, me)
    me.callParent(arguments)
  }
})
