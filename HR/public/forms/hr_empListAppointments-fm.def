/* global Ext AC appAC HR UB $App */
exports.formDef = 'HR.empListAppointments'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.empListAppointments', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.empListAppointments',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox' },
            collapsed: false,
            items: [
              {
                layout: { type: 'vbox' },
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getOrgCombo({
                        labelWidth: 130,
                        width: 700,
                        flex: 1,
                        readOnly: !accMainReportsSubOrg,
                        ubRequest: {
                          entity: 'hr_organization',
                          fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              values: {
                                state: 'ACTIVE'
                              }
                            },
                            path: {
                              expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                              condition: accMainReportsSubOrg ? 'like' : '=',
                              values: {
                                state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                              }
                            }
                          },
                          orderList: { orderBy: { expression: 'description' } },
                          __mip_ondate: appAC.globalApplicationDate()
                        },
                        listeners: {
                          change: function (ctrl) {
                            const form = ctrl.up('form')
                            HR.controlService.onChangeIncludeChildOrgs(form)
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildOrgs(accMainReportsSubOrg)
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getDepCombo({
                        labelWidth: 130,
                        width: 700,
                        displayField: 'description',
                        flex: 1,
                        listeners: {
                          change: function (ctrl, value) {
                            const form = ctrl.up('form')
                            form.down('[name=includeChildDepts]').setReadOnly(!value)
                            if (!value) {
                              form.down('[name=includeChildDepts]').setValue()
                            }
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildDepts()
                    ]
                  },
                  {
                    xtype: 'ubdatefield',
                    labelWidth: 130,
                    name: 'dateFrom',
                    fieldLabel: UB.i18n('Станом на'),
                    allowBlank: false
                  },

                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubboxselect',
                        name: 'dictStaffCatID',
                        ubID: 'dictStaffCatID',
                        labelWidth: 130,
                        width: 700,
                        fieldLabel: UB.i18n('Категорія персоналу'),
                        displayField: 'name',
                        valueField: 'ID',
                        ubRequest: {
                          entity: 'hr_dictStaffCat',
                          fieldList: ['ID', 'code', 'name'],
                          orderList: { orderBy: { expression: 'name' } }
                        }
                      },
                      {
                        xtype: 'label',
                        name: 'dayCount',
                        text: '',
                        cls: 'x-form-item-label field-label-blue',
                        margin: '10 10 5 15'
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubboxselect',
                        name: 'dictFundSourceID',
                        ubID: 'dictFundSourceID',
                        labelWidth: 130,
                        width: 700,
                        fieldLabel: UB.i18n('Джерело фінансування'),
                        displayField: 'description',
                        valueField: 'ID',
                        ubRequest: {
                          entity: 'ac_fundSource',
                          fieldList: ['ID', 'code', 'description'],
                          orderList: { orderBy: { expression: 'name' } }
                        }
                      },
                      {
                        xtype: 'label',
                        name: 'dayCountDFS',
                        text: '',
                        cls: 'x-form-item-label field-label-blue',
                        margin: '10 10 5 15'
                      }
                    ]
                  },

                  {
                    xtype: 'ubboxselect',
                    name: 'workPlace',
                    fieldLabel: UB.i18n('Місце роботи'),
                    hideEntityItemInContext: true,
                    enumGroupFilter: 'HR_WORKER_PLACE',
                    valueField: 'code',
                    displayField: 'name',
                    labelWidth: 130,
                    width: 700,
                    ubRequest: {
                      entity: 'ubm_enum',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                      whereList: {
                        eGroup: {
                          expression: '[eGroup]',
                          condition: 'equal',
                          values: { 'eGroup': 'HR_WORKER_PLACE' }
                        }
                      }
                    }
                  }
                ]
              },
              {
                layout: { type: 'hbox' },
                padding: '35 0 0 0',
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Шукати'),
                    iconCls: 'fas fa-search',
                    width: 30,
                    cls: 'green-action',
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.searchEmployee()
                      me.searchEmployeeMtCountSum()
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Очистити'),
                    iconCls: 'fas fa-eraser',
                    width: 30,
                    cls: 'fill-action',
                    margin: '5 0 0 0',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.clearSearch()
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        xtype: 'ubdetailgrid',
        name: 'employeeNumberListGrid',
        region: 'center',
        flex: 1,
        autoScroll: true,
        loadStoreImmediately: false,
        forceDataLoad: true,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink',
          'commandLink', 'showDetail', 'audit'],
        cmdData: {
          params: [{
            entity: 'hr_empListAppointments',
            method: 'search',
            fieldList: [
              { name: 'tabNum' },
              { name: 'tabNumSort', visibility: false },
              { name: 'employeeNumberID', visibility: false },
              { name: 'employeeID', visibility: false },
              { name: 'fullFIO', description: UB.i18n('ПІБ') },
              { name: 'lastName', description: UB.i18n('Прізвище') },
              { name: 'firstName', description: UB.i18n('Ім\'я') },
              { name: 'middleName', description: UB.i18n('По батькові') },
              { name: 'sexType', description: UB.i18n('Стать') },
              { name: 'taxCode', description: UB.i18n('РНОКПП') },
              { name: 'depName' },
              { name: 'dictPositionName', description: UB.i18n('Посада') },
              { name: 'posStaffName', description: UB.i18n('Штатна посада') },
              { name: 'actualPositionName' },
              { name: 'dictWagePayName', description: UB.i18n('Тип посади держслужбовця') },
              { name: 'dateFrom' },
              { name: 'dateToEmpty' },
              { name: 'dateNew' },
              { name: 'workScheduleName', description: UB.i18n('Графік роботи') },
              { name: 'mtCount', format: '0.00' },
              { name: 'dictStaffCatName', description: UB.i18n('Категорія персоналу') },
              { name: 'workerType' },
              { name: 'workPlace' },
              { name: 'dictTrialPeriodIDName', description: UB.i18n('Випробувальний строк') },
              { name: 'dateTrialEnd' },
              { name: 'dictFundSourceIDName', description: UB.i18n('Джерело фінансування') },
              { name: 'dictFundSourceMtCount', description: UB.i18n('Кількість ставок (за джерелом фінансування)'), format: '0.00' },
              { name: 'dictCategoryECBIDName', description: UB.i18n('Категорія застрахованої особи') },
              { name: 'accountIDDescription', description: UB.i18n('Рахунок витрат') },
              { name: 'dictCostTypeDescription', description: UB.i18n('Місце виникнення витрат') },
              { name: 'contractType' },
              { name: 'dictContractKindIDName', description: UB.i18n('Вид договору') },
              { name: 'dictTarifCoeffIDName', description: UB.i18n('Тарифний розряд') },
              { name: 'orderIDDescription', description: UB.i18n('Наказ') },
              { name: 'changeOrderIDDescription', description: UB.i18n('Документ-підстава скасування') },
              { name: 'payElIDName', description: UB.i18n('Вид оплати') },
              { name: 'accrualSum' },
              { name: 'raiseSalary' },
              { name: 'isIndex' },
              { name: 'vacancyDateFrom' },
              { name: 'vacancyDateToEmpty' },
              { name: 'dictRankIDName', description: UB.i18n('Ранг') },
              { name: 'isResponsible' },
              { name: 'planDateTo' },
              { name: 'isFactWorkSchedule' },
              { name: 'dictPositionGroupIDName', description: UB.i18n('Група посади') },
              { name: 'positionCategory', description: UB.i18n('Категорія посади (за посадою)') },
              { name: 'positionDictStaffCatIDName', description: UB.i18n('Категорія персоналу (за посадою)') },
              { name: 'positionDictStaffSubCatIDName', description: UB.i18n('Підкатегорія персоналу (за посадою)') },
              { name: 'psCategory', description: UB.i18n('Категорія посади держслужбовця (за посадою)') },
              { name: 'positionDictStatePayIDName', description: UB.i18n('Група оплати праці держслужбовця (за посадою)') },
              { name: 'reformer', description: UB.i18n('Фахівці з питань реформ (за посадою)') },
              { name: 'workScheduleIDName', description: UB.i18n('Графік роботи (за посадою)') },
              { name: 'planHours', format: '0.00' },
              { name: 'selfStructDepName', description: UB.i18n('Самостійний структурний підрозділ') },
              { name: 'parentUnitDepName', description: UB.i18n('Підпорядкування підрозділу') },
              { name: 'orgName', description: UB.i18n('Організація') }
            ]
          }]
        },
        cmpInitConfig: {
          onDeterminateForm: HR.employeeTabs.onDeterminateCard,
          listeners: {
            render: (grid) => {
              grid.menu.removeAll()
              grid.menu.add([HR.employeeTabs.getEmpCardMenu(grid)])
              const useActualPositionName = AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization()) === true
              const colActualPositionName = AC.gridUtils.getColumnByIndex(grid, 'actualPositionName')
              colActualPositionName.setVisible(useActualPositionName)
            }
          }
        },
        getExportTitle: function () {
          return UB.i18n(`Список призначень`)
        }
      }
    ]

    me.clearSearch = () => {
      me.attr.dateFrom.setValue(new Date())
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.includeChildOrgs.setValue()
      me.attr.departmentID.setValue()
      me.attr.includeChildDepts.setValue()
      me.attr.dictStaffCatID.setValue()
      me.attr.dictFundSourceID.setValue()
      me.attr.workPlace.setValue()
    }

    me.searchEmployee = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      const store = me.attr.grid.getStore()
      let req = store.ubRequest
      req.onDate = appAC.globalApplicationDate()
      req.dateFrom = AC.dateService.shiftDate(me.attr.dateFrom.getValue())
      req.organizationID = me.attr.organizationID.getValue()
      req.includeChildOrgs = me.attr.includeChildOrgs.getValue()
      req.departmentID = me.attr.departmentID.getValue()
      req.includeChildDepts = me.attr.includeChildDepts.getValue()
      req.dictStaffCatID = me.attr.dictStaffCatID.getValue().split(',').map(q => q.trim().replace(/"/g, '')).join(',')
      req.dictFundSourceID = me.attr.dictFundSourceID.getValue().split(',').map(q => q.trim().replace(/"/g, '')).join(',')
      req.workPlace = me.attr.workPlace.getValue().split(',').map(q => q.trim().replace(/"/g, '')).join(',')
      req.orderList = { orderBy: { expression: 'tabNumSort', order: 'ASC' } }
      store.load()
    }

    me.searchEmployeeMtCountSum = () => {
      $App.connection.run({
        entity: 'hr_empListAppointments',
        method: 'searchMtCountSum',
        params: JSON.stringify({
          onDate: appAC.globalApplicationDate(),
          dateFrom: AC.dateService.shiftDate(me.attr.dateFrom.getValue()),
          organizationID: me.attr.organizationID.getValue(),
          includeChildOrgs: me.attr.includeChildOrgs.getValue(),
          departmentID: me.attr.departmentID.getValue(),
          includeChildDepts: me.attr.includeChildDepts.getValue(),
          dictStaffCatID: me.attr.dictStaffCatID.getValue().split(',').map(q => q.trim().replace(/"/g, '')).join(','),
          dictFundSourceID: me.attr.dictFundSourceID.getValue().split(',').map(q => q.trim().replace(/"/g, '')).join(','),
          workPlace: me.attr.workPlace.getValue().split(',').map(q => q.trim().replace(/"/g, '')).join(',')
        })
      }).then((response) => {
        if (response && response.resultData && response.resultData.data.length) {
          me.attr.dayCountDFS.setText(`Кількість ставок (за ДФ): ${response.resultData.data[0][1] || '0'}`, false)
          me.attr.dayCount.setText(`Кількість ставок (всього): ${response.resultData.data[0][2] || '0'}`, false)
        }
      })
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[name=employeeNumberListGrid]'),
        dateFrom: me.down('[name=dateFrom]'),
        organizationID: me.down('[name=organizationID]'),
        includeChildOrgs: me.down('[name=includeChildOrgs]'),
        departmentID: me.down('[name=departmentID]'),
        includeChildDepts: me.down('[name=includeChildDepts]'),
        dictStaffCatID: me.down('[name=dictStaffCatID]'),
        dictFundSourceID: me.down('[name=dictFundSourceID]'),
        workPlace: me.down('[name=workPlace]'),
        dayCountDFS: me.down('[name=dayCountDFS]'),
        dayCount: me.down('[name=dayCount]')
      }
      me.attr.dateFrom.setValue(new Date())
      me.attr.organizationID.setValue(appAC.globalOrganization())
    }, me)

    me.validateParams = () => {
      let res
      let params = []
      let dateFromCtrl = me.attr.dateFrom
      let dateFrom = dateFromCtrl.getValue()
      if (!dateFrom || !dateFromCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Cтаном на"')))
      }

      if (!me.attr.organizationID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Організація"')))
      }
      return res
    }

    me.callParent(arguments)
  }
})
