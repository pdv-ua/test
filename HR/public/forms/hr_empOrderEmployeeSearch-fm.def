                              })
                              $App.doCommand({
                                cmdType: 'showForm',
                                formCode: 'hr_elementSelectEx',
                                cmpInitConfig: {
                                  sourceData,
                                  selectedData: me.params.positionType,
                                  onSelectData: (data) => {
                                    me.params.positionType = data.selected
                                    me.params.positionTypeText = data.selected.reduce((res, item) => {
                                      res += item.description + ';'
                                      return res
                                    }, '')
                                    me.attr.positionTypeText.setValue(me.params.positionTypeText)
                                  }
                                }
                              })
                            }
                          },
                          {
                            xtype: 'textfield',
                            flex: 1,
                            name: 'positionTypeText',
                            readOnly: true
                          }
