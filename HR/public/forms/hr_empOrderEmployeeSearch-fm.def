// @isModal true
/* global UB Ext appAC UB $App _ AC */

exports.formDef = 'HR.empOrderEmployeeSearch'

Ext.define('HR.empOrderEmployeeSearch', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.empOrderEmployeeSearch',
  initComponent: function () {
    const me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        layout: 'accordion',
