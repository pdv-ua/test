          { name: 'dictPositionID' },
          { name: 'dictStaffCatID.name' },
          { name: 'dictStaffCatID' },
          { name: 'employeePositionID' },
          { name: 'employeeID' }
        ],
        getRowClass: function (row) {
          const seletedRow = me.selected.find(o => o === row.get(me.field === 'employeeNumberID' ? 'employeeNumberID' : 'employeePositionID'))
          if (seletedRow) {
            return 'grd-color-blue-italic'
          }
        }
      },
      {
        xtype: 'panel',
        layout: { type: 'hbox', pack: 'end' },
        region: 'south',
        style: 'border-top: 1px solid #BFBFBF',
        items: [
          {
            xtype: 'button',
            text: UB.i18n('Відмінити'),
            width: 120,
            height: 30,
            iconCls: 'u-icon-close',
            cls: 'red-action',
            margin: '10 10 10 0',
            style: 'border: 1px solid #BFBFBF; border-radius: 4px;',
            handler: function () {
              me.up('window').close()
            }
          },
          {
            xtype: 'button',
            text: UB.i18n('Замінити'),
            height: 30,
            margin: '10 10 10 0',
            iconCls: 'fas fa-exchange-alt',
            cls: 'green-action',
            style: 'border: 1px solid #BFBFBF; border-radius: 4px;',
            handler: function () {
              me.closeAndLoad(true)
            }
          },
          {
            xtype: 'button',
            text: UB.i18n('Додати'),
            width: 120,
            height: 30,
            margin: '10 10 10 0',
            iconCls: 'fas fa-plus',
            cls: 'blue-action',
            style: 'border: 1px solid #BFBFBF; border-radius: 4px;',
            handler: function () {
              me.closeAndLoad(false)
            }
          }
        ]
      }
    ]

    me.closeAndLoad = function (isDelete = false) {
      const selection = me.attr.grid.getSelectionModel().selected.items
      if (!selection.length) {
        $App.dialogInfo(UB.i18n('Не вибраний жодний працівник'), UB.i18n('Увага'))
        return
      }
      let saver
      if (me.entityID) {
        if (!me.params.ID) {
          saver = $App.connection.insert({
            entity: 'hr_empFilterParam',
            execParams: {
              entityID: me.entityID,
              params: me.params
            }
          })
        } else {
          saver = $App.connection.update({
            entity: 'hr_empFilterParam',
            execParams: {
              ID: me.params.ID,
              params: me.params
            }
          })
        }
      } else {
        saver = Promise.resolve()
      }
      saver.then(() => {
        if (me.onSelectData && _.isFunction(me.onSelectData)) {
          const data = []
          selection.forEach(item => {
            data.push(item.getData())
          })
          me.onSelectData(data, isDelete)
        }
        me.up('window').close()
      })
    }

    me.selectEmployeeNumbers = async (empNumIDs = []) => {
      me.setLoading(true)
      const onDate = me.onDate || appAC.globalApplicationDate()
      const excludeEmpNumIDs = []
      if (!me.attr.withLongTermAbsc.getValue()) {
        const longTermAbscEmpNum = await UB.Repository('hr_empLongTermAbsc')
          .attrs('employeeNumberID')
          .where('organizationID', '=', me.orgID || appAC.globalOrganization())
          .where('dateFrom', '<=', onDate)
          .where('dateTo', '>=', onDate)
          .where('employeeNumberID.mi_deleteDate', '>=', '#maxdate')
          .selectAsObject()
        excludeEmpNumIDs.push(...longTermAbscEmpNum.map(o => o.employeeNumberID))
      }
      const empPosition = UB.Repository('hr_employeePositionS')
        .attrs(['ID', 'tabNum', 'employeeNumberID', 'employeeID', 'employeeID.lastName', 'employeeID.firstName', 'employeeID.middleName',
          'posName', 'depName', 'workPlace', 'dateFrom', 'dateTo', 'description', 'employeeID.fullFIO', 'contractType', 'contractType.name', 'employeeID.sexType.name',
          'fundSourceNames', 'employeeNumberID.dateFrom', 'employeeNumberID.description', 'dictStaffCatID', 'dictStaffCatID.name', 'positionTypeName', 'dictPositionID'
        ])
        .where('organizationID', '=', me.orgID || appAC.globalOrganization())
        .where('employeeNumberID.mi_deleteDate', '>=', '#maxdate')
        .orderBy('employeeID.fullFIO', 'ASC')
      if (me.attr.dateFired.getValue()) {
        empPosition.where('employeeNumberID.dateTo', '>=', me.attr.dateFired.getValue())
          .where('employeeNumberID.dateTo', '<=', appAC.globalApplicationDate())
          .where('[dateTo]=[maxDateTo]', 'custom')
      } else {
        empPosition.where('dateFrom', '<=', me.dateTo ? me.dateTo : onDate)
          .where('dateTo', '>=', me.dateFrom ? me.dateFrom : onDate)
      }
      if (empNumIDs.length) {
        empPosition.where('employeeNumberID', 'in', empNumIDs)
      } else {
        if (excludeEmpNumIDs.length) {
          empPosition.where('employeeNumberID', 'notIn', excludeEmpNumIDs)
        }
        if (me.attr.hideSelected.getValue()) {
          empPosition.where(me.field === 'employeeNumberID' ? 'employeeNumberID' : 'ID', 'notIn', me.selected)
        }
        if (me.params.positionType.length) {
          empPosition.where('positionType', 'in', me.params.positionType.map(o => o.value))
        }
        if (me.params.dictStaffCat.length) {
          empPosition.where('dictStaffCatID', 'in', me.params.dictStaffCat.map(o => o.value))
        }
        if (me.params.workPlace.length) {
          empPosition.where('workPlace', 'in', me.params.workPlace.map(o => o.value))
        }
        if (me.params.position.length) {
          empPosition.exists(
            UB.Repository('hr_position')
              .attrs('mi_data_id')
              .where('dictPositionID', 'in', me.params.position.map(o => o.value))
              .where('mi_dateFrom', '<=', onDate)
              .where('mi_dateTo', '>=', onDate)
              .where('mi_deleteDate', '>=', '#maxdate')
              .where('state', '=', 'ACTIVE')
              .correlation('mi_data_id', 'positionID')
          )
        }
        if (me.params.contractType.length) {
          empPosition.where('contractType', 'in', me.params.contractType.map(o => o.value))
        }
        if (me.params.sexType.length) {
          empPosition.where('employeeID.sexType', 'in', me.params.sexType.map(o => o.value))
        }
        if (me.params.dictFundSource.length) {
          empPosition.exists(UB.Repository('hr_empPosFundSource')
            .correlation('employeePositionID', 'ID')
            .where('dictFundSourceID', 'in', me.params.dictFundSource.map(o => o.value))
          )
        }
        if (me.params.department.length || me.params.depGroup.length) {
          let depIDList = []

          if (me.params.department.length) {
            depIDList = depIDList.concat(me.params.department.map(o => o.value))
          }
          if (me.params.depGroup.length) {
            let dictMultiGroupDepsID = await UB.Repository('hr_dictMultiGroupDep')
              .attrs('departmentID')
              .where('dictMultiGroupID', 'in', me.params.depGroup.map(o => o.value))
              .selectAsArrayOfValues()
            if (dictMultiGroupDepsID.length) {
              depIDList = depIDList.concat(dictMultiGroupDepsID)
            }
          }
          if (me.attr.includeSubDepGroup.getValue() && depIDList.length) {
            let subDepList = []
            for (let i = 0; i < depIDList.length; i++) {
              let childDep = await UB.Repository('hr_department')
                .attrs('mi_data_id')
                .where('mi_treePath', 'like', `%${depIDList[i]}%`)
                .where('state', '=', 'ACTIVE')
                .misc({ __mip_ondate: onDate })
                .selectAsArrayOfValues()
              subDepList = subDepList.concat(childDep)
            }
            depIDList = depIDList.concat(subDepList)
          }
          empPosition.whereIf(depIDList.length, 'departmentID', 'in', depIDList)
        }
      }
      if (me.params.empGroup.length) {
        empPosition.where('employeeNumberID', 'in', UB.Repository('hr_employeeGroupDet')
          .attrs('employeeNumberID')
          .where('employeeGroupID', 'in', me.params.empGroup.map(o => o.value))
        )
      }
      if (me.employeeLimitedAccess && !AC.entityUtils.verifyRightsMethod('hr_employeeNumber', 'employeeLimitedAccess')) {
        empPosition.where('employeeNumberID.limitedAccess', '=', 0)
      }
      if (me.attr.posAccrualCheck.getValue() !== 'ALL') {
        const datePosCheck = me.attr.datePosCheck.getValue() || onDate || appAC.globalApplicationDate()
        if (!me.attr.datePosCheck.getValue()) {
          me.attr.datePosCheck.setValue(datePosCheck)
        }
        if (me.attr.posAccrualCheck.getValue() === 'CORRESPOND') {
          empPosition.where('[positionID.accrualSum] = [accrualSum]', 'custom')
        }
        if (me.attr.posAccrualCheck.getValue() === 'NOT_CORRESPOND') {
          empPosition.where('[positionID.accrualSum] <> [accrualSum]', 'custom')
        }
        empPosition
          .joinCondition('positionID.mi_dateFrom', '<=', AC.dateService.shiftDate(datePosCheck))
          .joinCondition('positionID.mi_dateTo', '>=', AC.dateService.shiftDate(datePosCheck))
          .joinCondition('positionID.mi_deleteDate', '>=', '#maxdate')
          .joinCondition('positionID.state', '=', 'ACTIVE')
      }
      try {
        const data = await empPosition.selectAsObject({
          'ID': 'employeePositionID'
        })
        let resultData = []
        data.forEach(item => {
          item['fundSourceName'] = (item['fundSourceNames'] || []).map(row => `${row.name} (${row.mtCount})`).join(', ')
          if (me.uniqueEmployeeNumbers) {
            let e = resultData.find(e => e.employeeNumberID === item.employeeNumberID)
            if (!e) {
              resultData.push(item)
            } else {
              if (AC.dateService.shiftDate(item.dateFrom) > AC.dateService.shiftDate(e.dateFrom)) {
                for (const fld in item) {
                  if (item.hasOwnProperty(fld)) {
                    e[fld] = item[fld]
                  }
                }
              }
            }
          }
        })
        me.setLoading(false)
        if (empNumIDs.length) {
          const notExistedIDs = []
          _.uniq(empNumIDs).forEach(empNumID => {
            if (!data.find(o => o.employeeNumberID === empNumID)) {
              notExistedIDs.push(empNumID)
            }
          })
          if (notExistedIDs.length) {
            const emps = await UB.Repository('hr_employeeNumberS').attrs('description').where('ID', 'in', _.uniq(notExistedIDs)).selectAsObject()
            $App.dialogInfo(UB.i18n('Неможливо додати наступних працівників: {0}. Не має діючого призначення', emps.map(o => o.description).join('<br />')), UB.i18n('Увага'))
          }
        }
        const store = me.attr.grid.getStore()
        me.attr.grid.removeAll()
        store.insert(store.data.length, me.uniqueEmployeeNumbers ? resultData : data)
        me.attr.panel.collapse()
      } catch (e) {
        me.setLoading(false)
      }
      me.loaded = true
    }

    me.on('afterrender', () => {
      const me = this
      const panel = me.down('[name=paramsPanel]')
      panel.header.add({ xtype: 'component', flex: 1 })
      panel.header.add(
        {
          xtype: 'button',
          tooltip: UB.i18n('Пошук працівників'),
          iconCls: 'fa fa-search',
          cls: 'blue-action',
          handler: function () {
            me.attr.panel.collapse()
            $App.doCommand({
              cmdType: 'showForm',
              formCode: 'hr_searchEmployee',
              customParams: {
                showSelectButton: true
              },
              cmpInitConfig: {
                onSelectData: function (data, isDelete) {
                  const empNumIDs = data.map(o => o.employeeNumberID)
                  me.selectEmployeeNumbers(empNumIDs)
                }
              }
            })
          }
        }
      )
      me.attr = {
        panel,
        grid: me.down('[name=employeeList]'),
        positionTypeText: me.down('[name=positionTypeText]'),
        dictStaffCatText: me.down('[name=dictStaffCatText]'),
        departmentText: me.down('[name=departmentText]'),
        depGroupText: me.down('[name=depGroupText]'),
        workPlaceText: me.down('[name=workPlaceText]'),
        positionText: me.down('[name=positionText]'),
        dictFundSourceText: me.down('[name=dictFundSourceText]'),
        contractTypeText: me.down('[name=contractTypeText]'),
        sexTypeText: me.down('[name=sexTypeText]'),
        hideSelected: me.down('[name=hideSelected]'),
        withLongTermAbsc: me.down('[name=withLongTermAbsc]'),
        includeSubDepGroup: me.down('[name=includeSubDepGroup]'),
        dateFired: me.down('[name=dateFired]'),
        posAccrualCheck: me.down('[name=posAccrualCheck]'),
        datePosCheck: me.down('[name=datePosCheck]'),
        empGroupText: me.down('[name=empGroupText]')
      }
      if (me.params.department.length) {
        me.params.departmentText = me.params.department.reduce((res, item) => {
          res += item.description + ';'
          return res
        }, '')
        me.attr.departmentText.setValue(me.params.departmentText)
      }
      if (me.params.depGroup.length) {
        me.params.depGroupText = me.params.depGroup.reduce((res, item) => {
          res += item.description + ';'
          return res
        }, '')
        me.attr.depGroupText.setValue(me.params.depGroupText)
      }
      if (me.params.workPlace.length) {
        me.params.workPlaceText = me.params.workPlace.reduce((res, item) => {
          res += item.description + ';'
          return res
        }, '')
        me.attr.workPlaceText.setValue(me.params.workPlaceText)
      }
      if (me.params.position.length) {
        me.params.positionText = me.params.position.reduce((res, item) => {
          res += item.description + ';'
          return res
        }, '')
        me.attr.positionText.setValue(me.params.positionText)
      }
      if (me.params.positionType.length) {
        me.params.positionTypeText = me.params.positionType.reduce((res, item) => {
          res += item.description + ';'
          return res
        }, '')
        me.attr.positionTypeText.setValue(me.params.positionTypeText)
      }
      if (me.params.dictStaffCat.length) {
        me.params.dictStaffCatText = me.params.dictStaffCat.reduce((res, item) => {
          res += item.description + ';'
          return res
        }, '')
        me.attr.dictStaffCatText.setValue(me.params.dictStaffCatText)
      }
      if (me.params.contractType.length) {
        me.params.contractTypeText = me.params.contractType.reduce((res, item) => {
          res += item.description + ';'
          return res
        }, '')
        me.attr.contractTypeText.setValue(me.params.contractTypeText)
      }
      if (me.params.empGroup.length) {
        me.params.empGroupText = me.params.empGroup.reduce((res, item) => {
          res += item.name + ';'
          return res
        }, '')
        me.attr.empGroupText.setValue(me.params.empGroupText)
      }
      const hideSelectedChkBox = me.down('[name=hideSelected]')
      if (hideSelectedChkBox) {
        hideSelectedChkBox.inputEl.el.setStyle('margin-top', '2px')
      }
      me.attr.posAccrualCheck.setValue('ALL')
      if (me.onDate) {
        me.attr.datePosCheck.setValue(AC.dateService.addDays(me.onDate, -1))
      } else {
        me.attr.datePosCheck.setValue(appAC.globalApplicationDate())
      }
    }, me)

    me.params = {
      ID: null,
      positionType: me.positionType || [],
      dictStaffCat: me.dictStaffCat || [],
      workPlace: me.workPlace || [],
      department: me.department || [],
      depGroup: me.depGroup || [],
      position: me.position || [],
      dictFundSource: me.dictFundSource || [],
      contractType: me.contractType || [],
      sexType: me.sexType || [],
      empGroup: me.empGroup || [],
      positionTypeText: '',
      dictStaffCatText: '',
      workPlaceText: '',
      departmentText: '',
      depGroupText: '',
      positionText: '',
      dictFundSourceText: '',
      contractTypeText: '',
      sexTypeText: '',
      empGroupText: ''
    }
    me.selected = me.selected || []
    me.loaded = false

    if (me.entityID) {
      UB.Repository('hr_empFilterParam')
        .attrs('ID', 'params')
        .where('entityID', '=', me.entityID)
        .selectSingle().then(data => {
          if (data) {
            me.params = _.merge(me.params, data.params)
            me.params.ID = data.ID
            if (me.department && me.department.length) {
              me.params.department = me.department
            } else {
              me.attr.departmentText.setValue(me.params.departmentText)
            }
            if (me.depGroup && me.depGroup.length) {
              me.params.depGroup = me.depGroup
            } else {
              me.attr.depGroupText.setValue(me.params.depGroupText)
            }
            if (me.workPlace && me.workPlace.length) {
              me.params.workPlace = me.workPlace
            } else {
              me.attr.workPlaceText.setValue(me.params.workPlaceText)
            }
            if (me.position && me.position.length) {
              me.params.position = me.position
            } else {
              me.attr.positionText.setValue(me.params.positionText)
            }
            if (me.dictStaffCat && me.dictStaffCat.length) {
              me.params.dictStaffCat = me.dictStaffCat
            } else {
              me.attr.dictStaffCatText.setValue(me.params.dictStaffCatText)
            }
            if (me.positionType && me.positionType.length) {
              me.params.positionType = me.positionType
            } else {
              me.attr.positionTypeText.setValue(me.params.positionTypeText)
            }
            if (me.dictFundSource && me.dictFundSource.length) {
              me.params.dictFundSource = me.dictFundSource
            } else {
              me.attr.dictFundSourceText.setValue(me.params.dictFundSourceText)
            }
            if (me.contractType && me.contractType.length) {
              me.params.contractType = me.contractType
            } else {
              me.attr.contractTypeText.setValue(me.params.contractTypeText)
            }
            if (me.sexType && me.sexType.length) {
              me.params.sexType = me.sexType
            } else {
              me.attr.sexTypeText.setValue(me.params.sexTypeText)
            }
            if (me.empGroup && me.empGroup.length) {
              me.params.empGroup = me.empGroup
            } else {
              me.attr.empGroupText.setValue(me.params.empGroupText)
            }
          }
        })
    }
    me.callParent(arguments)
  }
})
