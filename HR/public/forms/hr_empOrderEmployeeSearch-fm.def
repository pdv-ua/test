                    padding: '0 0 5 5',
                    flex: 1,
                    items: [
                      {
                        layout: { type: 'hbox' },
                        items: [
                          {
                            xtype: 'button',
                            name: 'selectPosType',
                            margin: '5 5 5 5',
                            height: 30,
                            style: 'border: 1px solid #BFBFBF; border-radius: 4px;',
                            iconCls: 'fas fa-filter',
                            cls: 'fill-action',
                            handler: function () {
                              UB.Repository('hr_department')
                                .attrs(['mi_data_id', 'name', 'description'])
