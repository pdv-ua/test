// @isModal true

/* global Ext appAC AC $App UB */
exports.formDef = 'HR.positionListVacContest'

Ext.define(exports.formDef, {
  extend: 'Ext.panel.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.positionListVacContest',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this

    me.items = [
      {
        xtype: 'panel',
        header: false,
        region: 'center',
        flex: 1,
        layout: 'fit',
        items: [{
          name: 'posVac',
          xtype: 'ubdetailgrid',
          autoScroll: true,
          layout: 'fit',
          flex: 1,
          hideActions: ['addNew', 'addNewByCurrent', 'del', 'audit', 'newVersion', 'history', 'showPreview', 'itemLink',
            'commandLink', 'showDetail'],
          stateful: true,
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_positionVacContest_grid'),
          cmdType: 'showList',
          description: UB.i18n('Вакантні посади'),
          entity: 'hr_position',
          disableAutoLoadStore: true,
          cmdData: {
            params: [{
              entity: 'hr_positionVacContest',
              method: 'selectVacancies',
              orgID: appAC.globalOrganization(),
              onDate: appAC.globalApplicationDate(),
              fieldList: [
                { name: 'ID', visibility: false },
                { name: 'positionID', description: UB.i18n('ID Посади'), visibility: false },
                { name: 'code', description: UB.i18n('Код'), config: { align: 'center', width: 80 } },
                { name: 'name', description: UB.i18n('Назва'), config: { width: 200 } },
                { name: 'parentUnitID', description: UB.i18n('ID Підпорядкування'), visibility: false },
                { name: 'parentUnitIDName', description: UB.i18n('Підпорядкування'), config: { width: 200 } },
                { name: 'fundSourceName', description: UB.i18n('Джерело фінансування'), config: { width: 200 } },
                { name: 'quantity', config: { align: 'center', width: 100 }, format: '0.00' },
                { name: 'mtCount', description: UB.i18n('Зайнятих ставок'), config: { align: 'center', width: 100 }, format: '0.00' },
                { name: 'vacCount', description: UB.i18n('Вакантних ставок'), config: { align: 'center', width: 100 }, format: '0.00' },
                { name: 'dictProfessionCode', description: UB.i18n('Державний класифікатор'), config: { width: 150 } },
                { name: 'isTempVac', description: UB.i18n('Тимчасово вакантна'), config: { align: 'center', width: 150 } },
                { name: 'indepStructUnit', description: UB.i18n('Самостійний підрозділ'), config: { width: 200 } },
                { name: 'empList', description: UB.i18n('Працівник тимчасово відсутній'), config: { width: 200 } },
                { name: 'vacancyDateFrom', description: UB.i18n('Вакантна з'), config: { align: 'center', width: 100 } },
                { name: 'vacancyDateTo', description: UB.i18n('Вакантна по'), config: { align: 'center', width: 100 } },
                { name: 'vacancyDays', description: UB.i18n('Днів вакантності'), config: { align: 'center', width: 100 } },
                { name: 'staffOrderID', description: UB.i18n('ID Наказ'), visibility: false },
                { name: 'staffOrderDescription', description: UB.i18n('Наказ'), config: { width: 250 } },
                { name: 'contestID', description: UB.i18n('ID конкурсу'), visibility: false },
                { name: 'contestOrder', description: UB.i18n('Наказ про оголошення конкурсу'), config: { width: 200 } },
                { name: 'contestState', description: UB.i18n('Стан конкурсу'), config: { width: 120 } },
                { name: 'contestPortal', description: UB.i18n('Код порталу вакансій'), config: { width: 100 } }
              ],
              __mip_recordhistory_all: true
            }]
          },
          cmpInitConfig: {
            customInit: function () {},
            afterInit: function () {
              let grid = this
              this.menu.add([
                {
                  text: UB.i18n('Переглянути результат Конкурсу'),
                  scale: 'medium',
                  iconCls: 'fa fa-table',
                  cls: 'delete-action',
                  handler: () => {
                    let reco = AC.gridUtils.getCurrentRecord(grid)
                    if (!reco.get('contestID')) {
                      AC.viewUtils.showToast(UB.i18n('По даній посаді конкурс не проводився або відсутні результати'))
                    } else {
                      $App.doCommand({
                        cmdType: 'showForm',
                        formCode: 'hr_listPosContest',
                        entity: 'hr_listPosContest',
                        instanceID: reco.get('contestID'),
                        tabId: 'hr_listPosContest' + Ext.id(null, 'addNew'),
                        target: $App.getViewport().centralPanel
                      })
                    }
                  }
                }
              ])
            },
            customActions: [
              {
                text: UB.i18n('Друкувати'),
                itemId: 'printDocumentAction',
                iconCls: 'fas fa-print',
                cls: 'blue-action',
                margin: '5 0 0 0',
                handler: function (btn) {
                  me.doReport()
                }
              }
            ],
            onDeterminateForm: function (grid) {
              const reco = AC.gridUtils.getCurrentRecord(grid)
              return {
                entityName: 'hr_position',
                formCode: 'hr_position',
                instanceID: reco.get('positionID')
              }
            },
            getRowClass: function (row) {
              return row.get('isTempVac') ? 'ub-row-yellow' : ''
            },
            optimizeColumnWidth: function () {}
          }
        }]
      }
    ]

    me.report_code = 'hr_vacanciesList'
    me.doReport = () => {
      $App.doCommand({
        cmdType: 'showReport',
        caption: UB.i18n('Друкована форма'),
        tabId: 'printDocument' + me.report_code + Date.now(),
        target: $App.getViewport().centralPanel,
        cmdData: {
          reportCode: me.report_code,
          reportType: 'html',
          reportOptions: {
            allowExportToExcel: true,
            isModal: false
          }
        }
      })
    }
    me.changeGlobal = function () {
      const grid = me.down('ubdetailgrid')
      const store = grid.getStore()
      store.ubRequest.onDate = appAC.globalApplicationDate()
      store.ubRequest.orgID = appAC.globalOrganization()
      const funcOrgType = AC.settings.get('hrFuncOrgType', appAC.globalOrganization())
      let contestOrder = AC.gridUtils.getColumnByIndex(grid, 'contestOrder')
      let contestState = AC.gridUtils.getColumnByIndex(grid, 'contestState')
      let contestPortal = AC.gridUtils.getColumnByIndex(grid, 'contestPortal')
      if (funcOrgType === '1') {
        /* Сфера діяльності організації = Загальна */
        contestOrder.hide()
        contestState.hide()
        contestPortal.hide()
      } else {
        contestOrder.show()
        contestState.show()
        contestPortal.show()
      }
      store.load()
    }
    me.on('afterrender', () => {
      $App.on('ac:app:organizationChanged', me.changeGlobal)
      $App.on('ac:app:operationDateChanged', me.changeGlobal)
      me.changeGlobal()
    }, me)

    me.on('destroy', () => {
      $App.un('ac:app:organizationChanged', me.changeGlobal)
      $App.un('ac:app:operationDateChanged', me.changeGlobal)
    }, me)
    me.callParent(arguments)
  }
})
