// @isModal true
/* global appAC UB Ext _ */

exports.formDef = 'HR.dictMaterialList'

Ext.define('HR.dictMaterialList', {
  extend: 'Ext.form.Panel',
  alias: 'widget.dictMaterialList',
  width: 1100,
  height: 600,
  layout: { type: 'border' },
  viewConfig: {
    toggleOnDblClick: false
  },
  isModal: true,
  initComponent: function () {
    const me = this
    me.items = [
      {
        region: 'center',
        layout: { type: 'vbox', align: 'stretch' },
        items: [
          {
            xtype: 'ubdetailgrid',
            region: 'center',
            flex: 1,
            name: 'gridDictMaterialList',
            autoScroll: true,
            disableSearchBar: true,
            forceDataLoad: true,
            disableAutoLoadStore: true,
            hideActions: ['addNew', 'addNewByCurrent', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
            stateful: true,
            stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_dictMaterialList'),
            disableMenuItemDetails: true,
            margin: '5, 10, 0, 10',
            cmdType: 'showList',
            entityName: 'ac_nomeclature',
            description: UB.i18n('Технологічні карти'),
            cmdData: {
              params: [{
                entity: 'ac_nomenclature',
                method: 'select',
                fieldList: [
                  { name: 'ID', visibility: false },
                  { name: 'code', config: { width: 120 } },
                  { name: 'name', config: { width: 240 } },
                  { name: 'description', visibility: false },
                  { name: 'dictMeasureID.symbolUkr', description: UB.i18n('Одиниця виміру'), tooltip: UB.i18n('Одиниця виміру'), config: { width: 120 } }
                ]
              }]
            },
            cmpInitConfig: {
              disableAutoLoadStore: true,
              hideActions: ['showDetail', 'addNew', 'refresh', 'edit', 'del', 'addNewByCurrent'],
              selModel: {
                selectionMode: 'MULTI',
                showHeaderCheckbox: false,
                checkOnly: true,
                selType: 'checkboxmodel'
              },
              onItemDblClick: function () {
                return false
              },
              customInit: function () {
              },
              afterInit: function () {
                const me = this
                function setFilters (me) {
                  const req = me.store.ubRequest
                  req.orgID = appAC.globalOrganization()
                  if (!req.whereList) {
                    req.whereList = {}
                  }
                  // me.store.reload()
                }
                setFilters(me)
              },
              customActions: [
                {
                  text: UB.i18n('Відмітити всі'),
                  iconCls: 'u-icon-check',
                  cls: 'green-action',
                  handler: function (btn) {
                    const grid = btn.up('ubdetailgrid')
                    const sm = grid.getSelectionModel()
                    sm.selectAll(true)
                    me.calcTotal()
                  }
                },
                {
                  text: UB.i18n('Виключити всі'),
                  iconCls: 'u-icon-close',
                  cls: 'red-action',
                  handler: function (btn) {
                    const grid = btn.up('ubdetailgrid')
                    const sm = grid.getSelectionModel()
                    sm.deselectAll(true)
                    me.calcTotal()
                  }
                },
                {
                  text: UB.i18n('Зберегти та закрити'),
                  iconCls: 'u-icon-save-and-close',
                  cls: 'save-action',
                  handler: function (btn) {
                    const grid = btn.up('ubdetailgrid')
                    if (me.onSelect) {
                      const data = []
                      const selModel = grid.getSelectionModel()
                      selModel.selected.each(record => {
                        data.push(record.getData())
                      })
                      me.onSelect(data)
                    }
                    me.up('window').close()
                  }
                }
              ],
              listeners: {
                selectionchange: () => {
                  this.calcTotal()
                }
              }
            }
          },
          {
            xtype: 'ubfieldset',
            border: false,
            region: 'south',
            layout: { type: 'vbox', align: 'right' },
            margin: '10 10 10 10',
            items: [
              {
                xtype: 'textfield',
                fieldLabel: UB.i18n('Вибрано позицій'),
                labelWidth: 180,
                name: 'totalCount',
                readOnly: true,
                value: '0',
                fieldStyle: 'text-align: right;'
              }
            ]
          }
        ]
      }
    ]

    me.calcTotal = () => {
      let count = 0
      const selModel = this.attr.grid.getSelectionModel()
      selModel.selected.each(record => {
        count++
      })
      this.attr.totalCount.setValue(count)
    }

    me.filterDictMaterialList = async () => {
      const req = this.attr.grid.store.ubRequest
      req.orgID = appAC.globalOrganization()
      req.whereList.dateTo = {
        expression: '[nomType]',
        condition: '=',
        value: 'MATERIAL'
      }
      this.attr.grid.store.load()
      this.attr.grid.getSelectionModel().deselectAll()
      this.calcTotal()
    }

    me.on('afterrender', () => {
      const me = this
      me.up('window').setTitle(UB.i18n('Вибір сировини'))
      me.attr = {
        grid: me.down('[name=gridDictMaterialList]'),
        totalCount: me.down('[name=totalCount]')
      }
      if (me.defaultValues) {
        _.forEach(me.attr, attr => {
          if (me.defaultValues[attr.name]) {
            attr[attr.setValueById ? 'setValueById' : 'setValue'](attr.xtype === 'ubdatefield' ? new Date(me.defaultValues[attr.name]) : me.defaultValues[attr.name])
          }
        })
      }
      if (me.readOnlyAttr) {
        me.readOnlyAttr.forEach(attrName => {
          me.attr[attrName].setReadOnly(true)
        })
      }
      me.filterDictMaterialList()
    }, me)

    me.callParent(arguments)
  }
})
