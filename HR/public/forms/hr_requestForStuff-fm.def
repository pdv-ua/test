                        }
                      },
                      {
                        name: 'requirement',
                        config: { flex: 1 },
                        editor: {
                          xtype: 'textBox',
                          hideEntityItemInContext: true,
                          gridFieldList: ['code', 'name', 'requirement', 'organizationID'],
                          ubRequest: {
                            entity: 'hr_dictRequiredPosition',
                            fieldList: ['requirement', 'dictRequiredParaID', 'organizationID', 'dictRequiredParaID.requirementKind']
                          },
                          displayField: 'requirement',
                          valueField: 'requirement',
                          allowCustomText: true,
                          triggerCls: 'hr-list-trigger'
                        }
                      }
                    ]
                  },
                  masterFields: ['ID'],
                  detailFields: ['requestForStuffID'],
                  cmpInitConfig: {
                    onBeforeEdit: function (editor, context) {
                      context.grid.optimizeColumnWidth(true)
                      const me = context.grid.up('form')
                      me.attr[`requestStuffProfi.dictRequiredParaID.name`].field.on('change', (ctrl, value) => {
                        AC.viewUtils.setFilterValue(me.attr[`requestStuffProfi.requirement`].field, {
                          dictRequiredParaID: ctrl.getFieldValue('ID')
                        }, ['clearValue'])
                      })

                      AC.viewUtils.setWhereListProperty(me.attr[`requestStuffProfi.dictRequiredParaID.name`].field,
                        [
                          ['requirementKind', '=', '1'],
                          ['organizationID', '=', me.record.get('organizationID'), 'org'],
                          ['organizationID', 'isNull', me.record.get('organizationID'), 'notOrg']

                        ],
                        ['([org] OR [notOrg])'],
                        ['clearWhereList']
                      )

                      me.setIsDirty(true)
                    }
                  }
