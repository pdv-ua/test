/* global HR AC */
exports.formDef = {
  requiredFields: ['requestNumber', 'organizationID', 'departmentID.mi_treePath', 'orderState',
    'reportSettings', 'document', 'empOrderType'],
  parentConfig: {
    hideActions: ['docActiondocument'],
    postOnlySimpleAttributes: true,
    layout: {
      type: 'vbox',
      align: 'stretch'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 6,
          iconCls: 'fas fa-angle-double-down',
          cls: 'fill-action',
          text: UB.i18n('Завантажити згідно вибраним параметрам'),
          actionId: 'startReconciliation'
        },
        {
          orderId: 7,
          iconCls: 'fas fa-angle-double-down',
          cls: 'fill-action',
          text: UB.i18n('Завантажити згідно вибраним параметрам'),
          actionId: 'stopReconciliation'
        },
        {
          orderId: 8,
          iconCls: 'fas fa-angle-double-down',
          cls: 'fill-action',
          text: UB.i18n('Завантажити згідно вибраним параметрам'),
          actionId: 'toCompletion'
        },
        {
          orderId: 9,
          iconCls: 'fas fa-angle-double-down',
          cls: 'fill-action',
          text: UB.i18n('Завантажити згідно вибраним параметрам'),
          actionId: 'renewTask'
        }
      ]
    }
  ],
  items: [
    {
      xtype: 'tabpanel',
      flex: 1,
      listeners: {
        tabchange: function (tabPanel, activeTab) {
          let me = tabPanel.up('form')
          if (activeTab.ubID === 'report') {
            if (!me.isPdfCreated) {
              if (!me.record.get('docText') && !['ON_RECONCILATION', 'RECONCILED', 'POSTED'].includes(me.record.get('orderState'))) {
                HR.reportTab.editHtml(me)
              } else {
                HR.reportTab.setReportMode(me, 'view')
              }
              me.isPdfCreated = true
            } else {
              HR.reportTab.setReportMode(me, ['ON_RECONCILATION', 'RECONCILED', 'POSTED'].includes(me.record.get('orderState')) ? 'view' : 'edit')
            }
          } else if (me.isNewInstance) {
            me.saveForm().then(result => {
              if (result === -1) {
                me.down('tabpanel').setActiveTab(0)
              }
            })
          }
        }
      },
      items: [
        {
          title: UB.i18n('Інформація про посаду'),
          region: 'center',
          layout: { type: 'vbox', align: 'stretch' },
          items: [
            { attributeName: 'requestNumber', hidden: true },
            { attributeName: 'requestDate', hidden: true },
            HR.controlService.getAttrDepPosBlock({
              valueField: 'mi_data_id',
              labelWidth: 140,
              showPosCategory: true
            }),
            { attributeName: 'assignmentType', labelWidth: 140 },
            {
              layout: { type: 'hbox' },
              items: [
                {
                  attributeName: 'positionResp',
                  labelWidth: 140,
                  flex: 1
                },
                {
                  xtype: 'button',
                  width: 30,
                  iconCls: 'fas fa-angle-double-down',
                  cls: 'fill-action',
                  tooltip: UB.i18n('Завантажити записи'),
                  handler: (btn) => {
                    const me = btn.up('form')
                    me.loadRespPosition(me, 'positionResp')
                  }
                }
              ]
            },
            {
              layout: { type: 'hbox' },
              items: [
                {
                  attributeName: 'positionInstruction',
                  labelWidth: 140,
                  flex: 1
                },
                {
                  xtype: 'button',
                  width: 30,
                  iconCls: 'fas fa-angle-double-down',
                  cls: 'fill-action',
                  tooltip: UB.i18n('Завантажити записи'),
                  handler: (btn) => {
                    const me = btn.up('form')
                    me.loadRespPosition(me, 'positionInstruction')
                  }
                }
              ]
            },
            { attributeName: 'sphereOfResp', labelWidth: 140 },
            { attributeName: 'futuresOfWork', labelWidth: 140 },
            { attributeName: 'descOfExtRelatins', labelWidth: 140 }
          ]
        },
        {
          title: UB.i18n('Вимоги до особи'),
          split: true,
          flex: 1,
          layout: 'accordion',
          layoutConfig: {
            collapsible: true,
            collapsed: false
          },
          items: [
            {
              xtype: 'panel',
              hidden: true,
              collapsed: false
            },
            {
              title: UB.i18n('Освіта'),
