/* global Ext AC $App HR Blob */
exports.formDef = 'HR.repParamEmpInfo'

Ext.define('HR.repParamEmpInfo', {
  extend: 'Ext.form.Panel',
  height: 190,
  width: 700,
  layout: 'border',
  alias: 'widget.repParamEmpInfo',
  isModal: true,
  initComponent: function () {
    const me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'center',
        layout: { type: 'vbox', align: 'stretch' },
        items: [
          {
            xtype: 'ubcombobox',
            name: 'respPositionID',
            fieldLabel: UB.i18n('Підписант (посада)'),
            valueField: 'mi_data_id',
            displayField: 'description',
            hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
            gridFieldList: ['description'],
            labelWidth: 160,
            width: 650,
            disableContextMenu: true,
            disableModifyEntity: true,
            ubRequest: {
              entity: 'hr_position',
              fieldList: ['mi_data_id', 'description', 'nameGen'],
              whereList: {
                orgID: {
                  expression: '[orgID]',
                  condition: '=',
                  value: appAC.globalOrganization()
                },
                state: {
                  expression: '[state]',
                  condition: '=',
                  value: 'ACTIVE'
                },
                mi_dateFrom: {
                  expression: '[mi_dateFrom]',
                  condition: '<=',
                  value: appAC.globalApplicationDate()
                },
                mi_dateTo: {
                  expression: '[mi_dateTo]',
                  condition: '>=',
                  value: appAC.globalApplicationDate()
                },
                isSigner: {
                  expression: '',
                  condition: 'subquery',
                  subQueryType: 'exists',
                  value: {
                    entity: 'hr_orgRespPosition',
                    fieldList: ['ID'],
                    method: 'select',
                    whereList: {
                      cond: {
                        expression: '[positionID]=[{master}.mi_data_id]',
                        condition: 'custom'
                      },
                      mi_deleteDate: {
                        condition: 'equal',
                        expression: '[mi_deleteDate]',
                        value: '#maxdate'
                      },
                      organizationID: {
                        condition: 'custom',
                        expression: '[organizationID]=[{master}.orgID]'
                      },
                      signer4Ref: {
                        expression: '[respPosition]',
                        condition: 'equal',
                        value: 'signer4Ref'
                      }
                    }
                  }
                }
              },
              orderList: { orderBy: { expression: 'description' } }
            },
            listeners: {
              render: function (ctrl) {
                const store = ctrl.store
                function setDefVal () {
                  const orgID = appAC.globalOrganization()
                  const onDate = appAC.globalApplicationDate()
                  HR.reportUtils.getRefSignerInfo(orgID, onDate, undefined, undefined, me.defaultRefSigner ? 'fakeSigner4Ref' : '').then(empPos => {
                    if (empPos) {
                      ctrl.setValueById(empPos.positionID)
                      const form = ctrl.up('form')
                      filterRespEmp(form, empPos.positionID)
                    }
                  })
                  store.un('load', setDefVal)
                }
                store.on('load', setDefVal)
                store.load()
              },
              change: function (ctrl) {
                const form = ctrl.up('form')
                let posID = ctrl.getValue() || 0
                filterRespEmp(form, posID)
              }
            }
          },
          {
            xtype: 'ubcombobox',
            name: 'respEmp',
            fieldLabel: UB.i18n('Підписав'),
            displayField: 'description',
            hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
            gridFieldList: ['description'],
            labelWidth: 160,
            width: 650,
            disableContextMenu: true,
            disableModifyEntity: true,
            ubRequest: {
              entity: 'hr_employeePositionS',
              fieldList: ['ID', 'description', 'employeeID.shortFIO', 'positionID'],
              orderList: { orderBy: { expression: 'description' } }
            },
            listeners: {
              render: function (ctrl) {
                const store = ctrl.store
                function setFirstVal () {
                  const form = ctrl.up('form')
                  const respPositionIDCtrl = form.down('[name=respPositionID]')
                  const posID = respPositionIDCtrl.getValue() || 0

                  const storeItems = ctrl.store.data.items
                  const selItem = _.find(storeItems, { data: { positionID: posID } })
                  if (selItem) {
                    ctrl.setValue(selItem.data.ID)
                  }
                  // store.un('load', setFirstVal)
                }
                store.on('load', setFirstVal)
                store.load()
              }
            }
          },
          {
            name: 'orgTo',
            xtype: 'ubtextareafield',
            labelWidth: 160,
            fieldLabel: UB.i18n('Організація, куди подається довідка (в знахідному відмінку)'),
            listeners: {
              render: function (ctrl) {
                const orgToName = Ext.util.Cookies.get('hrRepParams_orgTo')
                if (orgToName) {
                  ctrl.setValue(orgToName)
                }
              }
            }
          },
          {
            name: 'executor',
            xtype: 'checkboxfield',
            labelWidth: 160,
            fieldLabel: UB.i18n('Вивести Виконавця'),
            value: false,
            hidden: true
          },
          {
            layout: { type: 'vbox', align: 'center' },
            items: [
              {
                layout: { type: 'hbox' },
                items: [
                  {
                    xtype: 'button',
                    text: UB.i18n('Формувати'),
                    iconCls: 'iconDoc',
                    width: 120,
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      const me = btn.up('form')
                      if (me.runReport()) {
                        me.closeForm()
                      }
                    }
                  },
                  {
                    xtype: 'button',
                    text: UB.i18n('Відмінити'),
                    iconCls: 'fa fa-ban',
                    width: 120,
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.closeForm()
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]

    me.runReport = () => {
      const notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return false
      }

      if (me.reportCode === 'docx') {
        me.formPrintDocument(me.reportViewCode)
      } else {
        const report = Ext.create('UBS.UBReport', {
          code: me.reportCode,
          type: 'html',
          params: {
            reportViewCode: me.reportViewCode,
            employeeID: me.employeeID,
            employeeNumberID: me.employeeNumberID,
            respPositionID: me.attr.respPos.getValue(),
            respEmployeePositionID: me.attr.respEmp.getValue(),
            orgToName: me.attr.orgTo.getValue(),
            needExecutorCheck: me.attr.executor.getValue()
          }
        })
        report.init().then(function () {
          const config = {
            cmdType: 'showForm',
            formCode: 'ac_documentViewer',
            caption: UB.i18n('Друкована форма'),
            cmpInitConfig: { report: report },
            tabId: 'printDocument_' + me.reportCode + '_' + me.reportIdx + '_' + me.employeeID,
            description: me.reportDescription,
            target: $App.getViewport().centralPanel
          }
          $App.doCommand(config)
        })
      }

      return true
    }

    me.closeForm = () => {
      Ext.util.Cookies.set('hrRepParams_orgTo', me.attr.orgTo.getValue())
      me.up('window').close()
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        respPos: me.down('[name=respPositionID]'),
        respEmp: me.down('[name=respEmp]'),
        orgTo: me.down('[name=orgTo]'),
        executor: me.down('[name=executor]')
      }
      const wnd = me.up('window')
      switch (me.reportViewCode) {
        case 'dovidkaZMiscyaRoboty':
          wnd.setTitle(UB.i18n(`Звіт 'Довідка з місця роботи'`))
          me.attr.executor.setValue(true)
          me.attr.executor.show()
          me.setHeight(290)
          break
        case 'dovidkaZMiscyaRobotyPregnVac':
          wnd.setTitle(UB.i18n(`Звіт 'Довідка з місця роботи (декретна відпустка)'`))
          me.attr.executor.setValue(true)
          me.attr.executor.show()
          me.setHeight(290)
          break
        case 'dovidkaZMiscyaRobotyMission':
          wnd.setTitle(UB.i18n(`Звіт 'Довідка з місця роботи (відрядження)'`))
          me.attr.executor.setValue(true)
          me.attr.executor.show()
          me.setHeight(290)
          break
        case 'povidomZminaOblikData':
          wnd.setTitle(UB.i18n(`Повідомлення про зміну облікових даних`))
          me.attr.executor.setValue(false)
          me.attr.executor.hide()
          me.height = 190
          break
        case 'biografDovidka':
          wnd.setTitle(UB.i18n(`Бiографiчна довiдка`))
          me.attr.executor.setValue(false)
          me.attr.executor.hide()
          me.height = 190
          break
      }
      initComponentDone(me)
    }, me)

    me.validateParams = () => {
      let res
      const params = []
      if ((!me.attr.respEmp.getValue() && !me.attr.respEmp.allowBlank)) {
        params.push(AC.viewUtils.formatFieldLabel(`"${me.attr.respEmp.fieldLabel}"`))
      }
      if ((!me.attr.respPos.getValue() && !me.attr.respPos.allowBlank)) {
        params.push(AC.viewUtils.formatFieldLabel(`"${me.attr.respPos.fieldLabel}"`))
      }
      if (params.length) {
        res = {
          msg: `Не вибрано наступні параметри:<br/>${params.join(',<br/>')}`
        }
      }
      return res
    }

    me.callParent(arguments)

    me.formPrintDocument = (code) => {
      me.setLoading(true)
      $App.connection.run({
        entity: 'hr_employee',
        method: 'docPrintForm',
        params: {
          code: code,
          type: 'docx',
          instanceID: me.instanceID,
          // onDate: appAC.globalApplicationDate(),
          orgID: appAC.globalOrganization(),
          tabNumID: me.employeeNumberID,
          onDate: me.onDate,

          employeeID: me.employeeID,
          employeeNumberID: me.employeeNumberID,
          respPositionID: me.attr.respPos.getValue(),
          respEmployeePositionID: me.attr.respEmp.getValue(),
          orgToName: me.attr.orgTo.getValue()
        }
      }).then(function (result) {
        me.setLoading(false)

        if (result.docs) {
          const docs = JSON.parse(result.docs)
          _.forEach(docs, function (item) {
            const fileContent = JSON.parse(item.fileContent)
            const contentLength = fileContent.length
            const pdfArray = new Uint8Array(new ArrayBuffer(contentLength))
            const filename = item.fileName + '.docx'
            for (let i = 0; i < contentLength; i++) {
              pdfArray[i] = fileContent.charCodeAt(i)
            }
            const dBlob = new Blob([pdfArray], { type: 'application/msword' })
            saveAs(dBlob, filename)
          })
        }
      }).then(function () {
        me.setLoading(false)
      })
    }
  }
})

function initComponentDone (form) {
  const signerAllowBlank = form.signerAllowBlank || false
  form.attr.respEmp.setAllowBlank(signerAllowBlank)
}

function filterRespEmp (form, posID) {
  const organizationID = appAC.globalOrganization()
  const onDate = appAC.globalApplicationDate()
  const respEmpIDCtrl = form.down('[name=respEmp]')
  UB.Repository('hr_dictTempExecution')
    .attrs(['employeePositionID'])
    .where('organizationID', '=', organizationID)
    .where('dateFrom', '<=', onDate)
    .where('dateTo', '>=', onDate)
    .where('employeePositionTempID.positionID', '=', posID, 'w1')
    .where('positionTempID', '=', posID, 'w2')
    .logic('([w1] or [w2])')
    .selectAsObject()
    .then(tempExecData => {
      let whereArray = [
        ['positionID', '=', posID, 'posID'],
        ['organizationID', '=', organizationID, ''],
        ['dateFrom', '<=', onDate, ''],
        ['dateTo', '>=', onDate, '']
      ]
      let logicalPredicates = null
      if (tempExecData.length) {
        whereArray.push(['ID', 'in', tempExecData.map(itm => itm.employeePositionID), 'IDList'])
        logicalPredicates = ['([posID] OR [IDList])']
      }
      AC.viewUtils.setWhereListProperty(respEmpIDCtrl, whereArray, logicalPredicates, ['clearStore', 'clearWhereList', 'clearValue'])
    })
}
