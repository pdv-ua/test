    function getOrganizationCtrl (labelWidth = 115, width = 640, readOnly = false) {
      return Ext.create('UB.ux.form.field.UBComboBox', {
        name: 'organizationID',
        fieldLabel: UB.i18n('Організація'),
        labelWidth: labelWidth,
        width: width,
        valueField: 'mi_data_id',
        displayField: 'description',
        allowBlank: false,
        disableContextMenu: true,
        readOnly: readOnly,
        ubRequest: {
          entity: 'hr_organization',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['mi_data_id', 'name', 'description', 'mi_treePath'],
          whereList: {
            mi_treePath: {
              expression: '[mi_treePath]',
              condition: 'startWith',
              value: `/${appAC.globalOrganization()}/`
            },
            isActive: {
              expression: '[state]',
              condition: 'equal',
              value: 'ACTIVE'
            }
          }
        },
        listeners: {
          change: function (fld) {
            me.record['organizationID'] = fld.getValue()
            me.record['organizationName'] = me.record['organizationID'] ? fld.getRawValue() : ''
            const depCtrl = me.down('[name=departmentID]')
            depCtrl && depCtrl.setValue()
            me.clearPrintForm()
          }
        }
      })
    }

    function getPayElCtrl (labelWidth = 115) {
      return {
        xtype: 'ubboxselect',
        name: 'payElID',
        fieldLabel: UB.i18n('Вид оплати'),
        labelWidth,
        width: 640,
        gridFieldList: ['ID', 'description'],
        valueField: 'ID',
        displayField: 'description',
        allowBlank: true,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
        disableModifyEntity: true,
        ubRequest: {
          entity: 'hr_payEl',
          fieldList: ['ID', 'description'],
          whereList: {
            methodId: {
              expression: '[methodID.methodGroupID.code]',
              condition: '=',
              values: {
                value: '3'
              }
            }
          },
          orderList: { orderBy: { expression: 'codeSort' } }
        },
        listeners: {
          blur: (fld) => {
            me.record['payElID'] = fld.getValue() ? fld.getValue().split(',').map(id => parseInt(id)) : []
            me.clearPrintForm()
          },
          change: (fld) => {
            me.record['payElID'] = fld.getValue() ? fld.getValue().split(',').map(id => parseInt(id)) : []
            me.clearPrintForm()
          }
        }
      }
    }

