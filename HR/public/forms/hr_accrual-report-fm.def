    function getDepartmentCtrl (labelWidth = 115, hidden = false, width = 640) {
      return Ext.create('UB.ux.form.field.UBComboBox', {
        name: 'departmentID',
        fieldLabel: UB.i18n('Підрозділ'),
        labelWidth: labelWidth,
        width: width,
        valueField: 'mi_data_id',
        displayField: 'caption',
        disableContextMenu: true,
        hidden: hidden,
        ubRequest: {
          entity: 'hr_department',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['mi_data_id', 'name', 'orgID', 'description', 'mi_treePath', 'caption'],
          whereList: {
            isActive: {
              expression: '[state]',
              condition: 'equal',
              value: 'ACTIVE'
            }
          }
        },
        listeners: {
          beforeQuerySend: function () {
            if (me.attr.periodID) {
              me.record.periodTo ? this.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.periodTo)
                : this.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()
            } else if (me.attr.objPeriodTo) {
              me.record.objPeriodToDateTo ? this.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.objPeriodToDateTo)
                : this.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()
            } else if (me.attr.year) {
              me.record.periodTo ? this.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.periodTo)
                : this.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()
            } else {
              this.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()
            }
            const includeSubOrg = me.down('[name=includeSubOrg]') ? me.down('[name=includeSubOrg]').getValue() : false
            const orgCtrl = (me.down('[name=organizationID]') && me.down('[name=organizationID]').getValue()) ? me.down('[name=organizationID]').getValue() : appAC.globalOrganization()

            if (includeSubOrg) {
              this.store.ubRequest.whereList = {
                miTreePath: {
                  expression: '[mi_treePath]',
                  condition: 'like',
                  value: `%/${orgCtrl}/%`
                },
                isActive: {
                  expression: '[state]',
                  condition: 'equal',
                  value: 'ACTIVE'
                }
              }
            } else {
              this.store.ubRequest.whereList = {
                orgID: {
                  expression: '[orgID]',
                  condition: 'equal',
                  value: orgCtrl
                },
                isActive: {
                  expression: '[state]',
                  condition: 'equal',
                  value: 'ACTIVE'
                }
              }
            }
            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
          },
          change: function (fld) {
            if (!fld.getValue()) {
              me.attr.includeSubDep.setValue(false)
              me.record.includeSubDep = false
            } else {
              me.attr.facultyID && me.attr.facultyID.setValue()
              me.attr.dictMultiGroupID && me.attr.dictMultiGroupID.setValue()
            }
            me.attr.includeSubDep.setReadOnly(!fld.getValue())
            me.record.departmentID = fld.getValue()

            if (me.attr.employeePositionID && !me.defaultEmployeeNumberID) {
              me.attr.employeePositionID.setValue()
            }

            me.clearPrintForm()
          }
        }
      })
    }

