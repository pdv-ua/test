    // makeHtmlData - prepeare Data from ubdetailGridData and queryData
    function makeHtmlData (grid, addData) {
      const gridStore = grid.getStore()

      const resultData = Object.assign({
        accrual: [],
        allSum: {},
        notes: []
      }, addData)

      resultData.accrual = gridStore && gridStore.data && gridStore.data.items && gridStore.data.items.length > 0 ? gridStore.data.items.map(item => item.data) : null

      if (grid.summary) {
        for (const prop in grid.summary) {
          resultData.allSum[prop] = 0
        }
      }

      if (resultData.accrual) {
        resultData.accrual.forEach((item, i) => {
          item.num = i + 1
          for (const prop in resultData.allSum) {
            item[prop] = item[prop] ? AC.currencyService.round(item[prop], 2) : 0 // round
            resultData.allSum[prop] = AC.currencyService.round(resultData.allSum[prop] += item[prop], 2)
            // resultData.allSum[prop] += item[prop]
          }
        })
      }

      const filter = grid.getStore().filters
      resultData.notes = []
      filter.items.forEach(filt => {
        const curFilter = grid.extendedFieldList.find(el => el.name === filt.property)
        resultData.notes.push({ filterName: `${curFilter.description}:`, value: filt.value })
      })

      if (gridStore.sorters.items[0]) {
        resultData.sorter = gridStore.sorters.items[0].property
      }

      return resultData
    }

    function createReport (type, reportCode, params) {
      me.report = Ext.create('UBS.UBReport', {
        code: reportCode,
        type,
        params: params,
        language: $App.connection.userLang()
      })

      if (type === 'xlsx') {
        me.report.makeReport().then(function (data) {
          const blobData = new Blob(
            [data.reportData], {
              type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
            }
          )
          const repName = reportCode.split('-').slice(-1)
          const fileName = `${repName}.xlsx`
          window.saveAs(blobData, fileName)
          me.setLoading(false)

          me.reportType = 'html'
        })
      } else {
        me.report
          .init()
          .then(function () {
            return me.report.makeReport()
          })
          .then(function (data) {
            if (data && data.reportData) {
              if (data.reportData.length > 10000000) {
                data = null
                me.report = Ext.create('UBS.UBReport', {
                  code: reportCode,
                  type: 'xlsx',
                  params: params,
                  language: $App.connection.userLang()
                })
                me.report.makeReport().then(function (xlsxData) {
                  const blobData = new Blob(
                    [xlsxData.reportData], {
                      type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    }
                  )
                  const repName = reportCode.split('-').slice(-1)
                  const fileName = `${repName}.xlsx`
                  window.saveAs(blobData, fileName)
                  me.setLoading(false)
                  $App.dialogInfo(UB.i18n('Занадто великий обсяг інформації. Звіт було вивантажено у Excel'))
                })
              } else {
                me.showReport(data.reportData)
                me.setLoading(false)
              }
            } else {
              me.setLoading(false)
              me.reportDone = true
            }
          })
      }
    }

    function makeReport (type, grid = false) {
      if (grid) {
        me.record.extendedFieldList = me.listUbdetailgrid ? JSON.stringify(me.listUbdetailgrid.extendedFieldList) : null
        me.record.gridData = me.listUbdetailgrid ? JSON.stringify(me.listUbdetailgrid.getData()) : null
        me.record.filtersItems = me.listUbdetailgrid ? JSON.stringify(me.listUbdetailgrid.getStore().filters.items) : null
        me.record.sortersItems = me.listUbdetailgrid ? JSON.stringify(me.listUbdetailgrid.getStore().sorters.items) : null
      }
      $App.connection.run({
        entity: 'hr_accrualReport',
        method: reportMethod[reportCode],
        execParams: Object.assign({
          reportCode,
          reportType: type,
          orgID: appAC.globalOrganization(),
          currDate: appAC.globalApplicationDate(),
          userID: $App.connection.userData().userID,
          selectedRows: JSON.stringify(me.accrualGrid ? me.accrualGrid.getCheckedRows() : [])
        },
        me.record)
      }).then(mParams => {
        let resultData = JSON.parse(mParams.resultData)

        if (getHtmlMethod[reportCode]) me[getHtmlMethod[reportCode]](resultData, mParams)
        type = me.reportType

        if (grid) {
          resultData = makeHtmlData(grid, resultData)
          type = me.reportType
        }
        createReport(type, reportCode, resultData)
      }, e => {
        me.setLoading(false)
        throw e
      })
    }

    async function makeReportAsync (type, reportCode, params, isAdd) {
      me.report = Ext.create('UBS.UBReport', {
        code: reportCode,
        type,
        params: params,
        language: $App.connection.userLang()
      })

      if (type === 'xlsx') {
        const data = await me.report.makeReport()
        const blobData = new Blob(
          [data.reportData], {
            type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          }
        )
        const repName = reportCode.split('-').slice(-1)
        const fileName = `${repName}.xlsx`
        window.saveAs(blobData, fileName)
        me.setLoading(false)
        me.reportType = 'html'
        return ''
      } else {
        await me.report.init()
        const data = await me.report.makeReport()
        me.setLoading(false)
        return data && data.reportData ? data.reportData : ''
      }
    }

    async function makeGroupReport (type) {
      try {
        me.setLoading(true)
        const mParams = await $App.connection.run({
          entity: 'hr_accrualReport',
          method: reportMethod[reportCode],
          execParams: Object.assign({
            reportCode,
            reportType: type,
            orgID: appAC.globalOrganization(),
            currDate: appAC.globalApplicationDate(),
            selectedRows: JSON.stringify(me.accrualGrid ? me.accrualGrid.getCheckedRows() : [])
          },
          me.record)
        })
        let resultReportData = JSON.parse(mParams.resultData)
        if (getHtmlMethod[reportCode]) me[getHtmlMethod[reportCode]](resultReportData, mParams)
        type = me.reportType
        const reportList = await UB.Repository('hr_groupReportDt')
          .attrs('ID', 'dictReportID', 'dictReportID.code', 'dictReportID.name', 'dictReportID.isExternal')
          .where('groupReportID', '=', me.record['groupReportID'] || 0)
          .orderBy('orderN')
          .selectAsObject()
        resultReportData.reports = []
        for (let i = 0; i < reportList.length; i++) {
          me.setLoading(true)
          const reportCode = reportList[i]['dictReportID.code']
          let resultData = me.record
          if (!reportList[i]['dictReportID.isExternal']) {
            const result = await $App.connection.run({
              entity: 'hr_accrualReport',
              method: reportMethod[reportCode],
              execParams: Object.assign({
                reportCode,
                reportType: type,
                orgID: appAC.globalOrganization(),
                currDate: appAC.globalApplicationDate(),
                isGroupReport: true,
                selectedRows: JSON.stringify(me.accrualGrid ? me.accrualGrid.getCheckedRows() : [])
              },
              me.record)
            })
            resultData = JSON.parse(result.resultData)
            if (getHtmlMethod[reportCode]) me[getHtmlMethod[reportCode]](resultData, result)
          }
          type = me.reportType
          resultData.hideHeader = true
          resultData.isGroupReport = true
          const data = await makeReportAsync(type, reportCode, resultData, true)
          resultReportData.reports.push({
            reportData: data,
            reportTitle: reportList[i]['dictReportID.name']
          })
        }
        createReport(type, reportCode, resultReportData)
      } catch (e) {
        me.setLoading(false)
        throw e
      }
    }

    me.createHtmlTableForIncTax = function (resultData, mParams) {
      const { accrual, allRates } = resultData
      const rateCols = allRates.length
      resultData.dataAccrual = []

      const headerRates = []
      const widthRates = []
      allRates.forEach(rate => {
        headerRates.push({ name: `${rate.rate}%` })
        widthRates.push({ name: '' })
      })

      let npp = 1
      for (let i = 0; i <= 1; i++) {
        const allSum = {
          paySum: 0,
          sumOnESV: 0,
          sumESV: 0,
          accrued: 0
        }
        const rateSum = {}
        const rateSum2 = {}

        const accrualGrouped = {}
        accrual.filter(item => item.isRecSum === i).forEach(item => {
          if (!accrualGrouped[item.description]) {
            accrualGrouped[item.description] = {
              description: item.description,
              paySum: 0,
              sumOnESV: 0,
              sumESV: 0,
              accrued: 0
            }
          }
          const currAccrualGrouped = accrualGrouped[item.description]
          const sumOnESVStr = `sumOnESV${item.rate}`
          const sumESVStr = `sumESV${item.rate}`
          allRates.forEach(rate => {
            const currRate = `sumOnESV${rate.rate}`
            if (!currAccrualGrouped[currRate]) currAccrualGrouped[currRate] = 0
          })
          allRates.forEach(rate => {
            const currRate = `sumESV${rate.rate}`
            if (!currAccrualGrouped[currRate]) currAccrualGrouped[currRate] = 0
          })

          item.sumOnESV = item.sumOnESV ? AC.currencyService.round(item.sumOnESV, 2) : 0
          item.sumESV = item.sumESV ? AC.currencyService.round(item.sumESV, 2) : 0

          currAccrualGrouped[sumOnESVStr] = AC.currencyService.round(currAccrualGrouped[sumOnESVStr] += item.sumOnESV, 2)
          if (!rateSum[sumOnESVStr]) {
            rateSum[sumOnESVStr] = 0
          }
          rateSum[sumOnESVStr] = AC.currencyService.round(rateSum[sumOnESVStr] += item.sumOnESV, 2)

          currAccrualGrouped[sumESVStr] = AC.currencyService.round(currAccrualGrouped[sumESVStr] += item.sumESV, 2)
          if (!rateSum2[sumESVStr]) {
            rateSum2[sumESVStr] = 0
          }
          rateSum2[sumESVStr] = AC.currencyService.round(rateSum2[sumESVStr] += item.sumESV, 2)

          Object.keys(allSum).forEach(sum => {
            currAccrualGrouped[sum] = AC.currencyService.round(currAccrualGrouped[sum] += item[sum] || 0, 2)
            allSum[sum] = AC.currencyService.round(allSum[sum] += item[sum] || 0, 2)
          })
        })

        const allAccrual = []

        Object.keys(accrualGrouped).forEach(item => {
          const currAccrual = accrualGrouped[item]
          currAccrual.num = npp++
          currAccrual.rateSums = []
          currAccrual.rateSums2 = []
          allRates.forEach(rate => {
            currAccrual.rateSums.push({ sum: currAccrual[`sumOnESV${rate.rate}`] || 0 })
            currAccrual.rateSums2.push({ sum: currAccrual[`sumESV${rate.rate}`] || 0 })
          })
          allAccrual.push(currAccrual)
        })

        allSum.rateSumArr = []
        allSum.rateSumArr2 = []

        allRates.forEach(rate => {
          allSum.rateSumArr.push({ sum: rateSum[`sumOnESV${rate.rate}`] || 0 })
          allSum.rateSumArr2.push({ sum: rateSum2[`sumESV${rate.rate}`] || 0 })
        })
        if (allAccrual.length) {
          resultData.dataAccrual.push({
            titleRow: i === 1 ? 'Крім того не входить у нараховано' : '',
            accrual: allAccrual,
            allSum
          })
        }
      }

      Object.assign(resultData, {
        tabWidth: rateCols * 2 * 90 + 580,
        rateCols,
        allCols: (rateCols * 2) + 6,
        rateWidth: rateCols * 90,
        headerRates,
        widthRates,
        isRates: !!rateCols,
        isDep: mParams.execParams.departmentID ? { depName: `${resultData.departmentName} ${resultData.departmentName && mParams.execParams.includeSubDep ? '(з підлеглими)' : ''}` } : null
      })
    }

    me.createDataForAliment = function (resultData, mParams) {
      const grid = me.listUbdetailgrid
      const gridData = grid.getData()
      const gridStore = grid.getStore()
      let accrual = []
      const allSum = {
        incomingDebtSum: 0,
        calculatedSum: 0,
        paySum: 0,
        debt: 0
      }
      const notes = []
      let sorter

      let allColumnCount = 13
      let partTitleColCount = 3
      let sheetWidth = 1240
      let addDep
      let depts = []

      function orgTreeCalcDepSum (curNode) {
        curNode.calcSum = {
          allSum: { incomingDebtSum: 0, calculatedSum: 0, paySum: 0, debt: 0 }
        }

        if (curNode.isNotEmpty) {
          if (curNode.emps && curNode.emps.length > 0) {
            curNode.emps.forEach(el => {
              curNode.calcSum.allSum.incomingDebtSum = AC.currencyService.round(curNode.calcSum.allSum.incomingDebtSum += el.incomingDebtSum || 0, 2)
              curNode.calcSum.allSum.calculatedSum = AC.currencyService.round(curNode.calcSum.allSum.calculatedSum += el.calculatedSum || 0, 2)
              curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += el.paySum || 0, 2)
              curNode.calcSum.allSum.debt = AC.currencyService.round(curNode.calcSum.allSum.debt += el.debt || 0, 2)
            })
          }

          curNode.childs.forEach(cur => {
            orgTreeCalcDepSum(cur)

            curNode.calcSum.allSum.incomingDebtSum = AC.currencyService.round(curNode.calcSum.allSum.incomingDebtSum += cur.calcSum.allSum.incomingDebtSum || 0, 2)
            curNode.calcSum.allSum.calculatedSum = AC.currencyService.round(curNode.calcSum.allSum.calculatedSum += cur.calcSum.allSum.calculatedSum || 0, 2)
            curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += cur.calcSum.allSum.paySum || 0, 2)
            curNode.calcSum.allSum.debt = AC.currencyService.round(curNode.calcSum.allSum.debt += cur.calcSum.allSum.debt || 0, 2)
          })
        }
      }
      function orgTreeDataToReport (curNode, depts) {
        if (curNode.isNotEmpty) {
          let depart = {
            emps: curNode.emps
          }
          if (curNode.name) {
            depart.dept = { colCount: allColumnCount, deptName: curNode.name }
          }

          depts.push(depart)
        }
        curNode.childs.forEach(ep => {
          orgTreeDataToReport(ep, depts)
        })

        if ((curNode.isNotEmpty && curNode.name) || curNode.mi_data_id === mParams.execParams.orgID) {
          let depart = {
            emps: [],
            depSum: { title: curNode.name + `&nbsp;&nbsp;&nbsp;${UB.i18n('Всього')}`, dsum: [] }
          }
          depart.depSum.dsum = curNode.calcSum.allSum
          depts.push(depart)
        }
      }
      const filter = grid.getStore().filters
      filter.items.forEach(filt => {
        const curFilter = grid.extendedFieldList.find(el => el.name === filt.property)
        notes.push({ filterName: `${curFilter.description}:`, value: filt.value })
      })

      // round and num
      gridData.forEach(item => {
        item.incomingDebtSum = item.incomingDebtSum ? AC.currencyService.round(item.incomingDebtSum, 2) : 0
        item.calculatedSum = item.calculatedSum ? AC.currencyService.round(item.calculatedSum, 2) : 0
        item.paySum = item.paySum ? AC.currencyService.round(item.paySum, 2) : 0
        item.debt = item.debt ? AC.currencyService.round(item.debt, 2) : 0

        // const sumsArr = ['incomingDebtSum', 'calculatedSum', 'paySum', 'debt']
        allSum.incomingDebtSum = AC.currencyService.round(allSum.incomingDebtSum += item.incomingDebtSum, 2)
        allSum.calculatedSum = AC.currencyService.round(allSum.calculatedSum += item.calculatedSum, 2)
        allSum.paySum = AC.currencyService.round(allSum.paySum += item.paySum, 2)
        allSum.debt = AC.currencyService.round(allSum.debt += item.debt, 2)
      })

      if (gridStore.sorters.items[0]) sorter = gridStore.sorters.items[0].property

      if ((sorter && sorter === 'depName') || (!sorter)) {
        let orgTree = HR.treeUtils.orgTree(mParams.execParams.orgID, gridData, AC.dateService.shiftDate(mParams.execParams.periodTo), resultData.orgStruct)
        orgTreeCalcDepSum(orgTree[0])
        orgTreeDataToReport(orgTree[0], depts)
      } else {
        allColumnCount++
        addDep = UB.i18n('Підрозділ')
        partTitleColCount++
        sheetWidth += 100
        depts.push({ emps: gridData })
        depts.push({ depSum: { title: UB.i18n('Всього'), dsum: allSum } })
      }
      let num = 0
      depts.forEach((item) => { item.emps.forEach((emp) => { emp.num = num + 1; num++ }) })
      Object.assign(resultData, {
        accrual,
        allSum,
        notes,
        sorter,
        depts,
        allColumnCount,
        partTitleColCount,
        addDep,
        sheetWidth
      })
    }
    me.createDataForUnionPay = function (resultData, mParams) {
      const grid = me.listUbdetailgrid
      const gridData = grid.getData()
      const gridStore = grid.getStore()
      let accrual = []
      const allSum = {
        incomeSum: 0,
        incomeNoSum: 0,
        incomeWithSum: 0,
        paySum: 0
      }
      const notes = []
      let sorter
      let allColumnCount = 11
      let partTitleColCount = 4
      let addDep
      let depts = []

      function orgTreeCalcDepSum (curNode) {
        curNode.calcSum = {
          allSum: { incomeSum: 0, incomeNoSum: 0, incomeWithSum: 0, paySum: 0 }
        }

        if (curNode.isNotEmpty) {
          if (curNode.emps && curNode.emps.length > 0) {
            curNode.emps.forEach(el => {
              curNode.calcSum.allSum.incomeSum = AC.currencyService.round(curNode.calcSum.allSum.incomeSum += el.incomeSum || 0, 2)
              curNode.calcSum.allSum.incomeNoSum = AC.currencyService.round(curNode.calcSum.allSum.incomeNoSum += el.incomeNoSum || 0, 2)
              curNode.calcSum.allSum.incomeWithSum = AC.currencyService.round(curNode.calcSum.allSum.incomeWithSum += el.incomeWithSum || 0, 2)
              curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += el.paySum || 0, 2)
            })
          }

          curNode.childs.forEach(cur => {
            orgTreeCalcDepSum(cur)

            curNode.calcSum.allSum.incomeSum = AC.currencyService.round(curNode.calcSum.allSum.incomeSum += cur.calcSum.allSum.incomeSum || 0, 2)
            curNode.calcSum.allSum.incomeNoSum = AC.currencyService.round(curNode.calcSum.allSum.incomeNoSum += cur.calcSum.allSum.incomeNoSum || 0, 2)
            curNode.calcSum.allSum.incomeWithSum = AC.currencyService.round(curNode.calcSum.allSum.incomeWithSum += cur.calcSum.allSum.incomeWithSum || 0, 2)
            curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += cur.calcSum.allSum.paySum || 0, 2)
            // curNode.calcSum.allSum.incomeSum += cur.calcSum.allSum.incomeSum || 0
            // curNode.calcSum.allSum.incomeNoSum += cur.calcSum.allSum.incomeNoSum || 0
            // curNode.calcSum.allSum.incomeWithSum += cur.calcSum.allSum.incomeWithSum || 0
            // curNode.calcSum.allSum.paySum += cur.calcSum.allSum.paySum || 0
          })
        }
      }
      function orgTreeDataToReport (curNode, depts) {
        if (curNode.isNotEmpty) {
          let depart = {
            emps: curNode.emps
          }
          if (curNode.name) {
            depart.dept = { colCount: allColumnCount, deptName: curNode.name }
          }

          depts.push(depart)
        }
        curNode.childs.forEach(ep => {
          orgTreeDataToReport(ep, depts)
        })

        // if (curNode.isNotEmpty && curNode.name) {
        if ((curNode.isNotEmpty && curNode.name) || curNode.mi_data_id === mParams.execParams.orgID) {
          let depart = {
            emps: [],
            depSum: { title: curNode.name + `&nbsp;&nbsp;&nbsp;${UB.i18n('Всього')}`, dsum: [] }
          }
          depart.depSum.dsum = curNode.calcSum.allSum
          depts.push(depart)
        }
      }
      const filter = grid.getStore().filters
      filter.items.forEach(filt => {
        const curFilter = grid.extendedFieldList.find(el => el.name === filt.property)
        notes.push({ filterName: `${curFilter.description}:`, value: filt.value })
      })

      // round and num
      gridData.forEach((item, i) => {
        item.incomeSum = item.incomeSum ? AC.currencyService.round(item.incomeSum, 2) : 0
        item.incomeNoSum = item.incomeNoSum ? AC.currencyService.round(item.incomeNoSum, 2) : 0
        item.incomeWithSum = item.incomeWithSum ? AC.currencyService.round(item.incomeWithSum, 2) : 0
        item.paySum = item.paySum ? AC.currencyService.round(item.paySum, 2) : 0
        item.num = i + 1

        // не такие как в грид (для грида лежат в resultData.allSum)
        allSum.incomeSum = AC.currencyService.round(allSum.incomeSum += item.incomeSum, 2)
        allSum.incomeNoSum = AC.currencyService.round(allSum.incomeNoSum += item.incomeNoSum, 2)
        allSum.incomeWithSum = AC.currencyService.round(allSum.incomeWithSum += item.incomeWithSum, 2)
        allSum.paySum = AC.currencyService.round(allSum.paySum += item.paySum, 2)
        // allSum.incomeSum += item.incomeSum
        // allSum.incomeNoSum += item.incomeNoSum
        // allSum.incomeWithSum += item.incomeWithSum
        // allSum.paySum += item.paySum
      })

      if (gridStore.sorters.items[0]) sorter = gridStore.sorters.items[0].property

      // const sumsArr = ['incomeSum', 'incomeNoSum', 'incomeWithSum', 'paySum']
      if ((sorter && sorter === 'depName') || (!sorter)) {
        let orgTree = HR.treeUtils.orgTree(mParams.execParams.orgID, gridData, AC.dateService.shiftDate(mParams.execParams.periodTo), resultData.orgStruct)
        orgTreeCalcDepSum(orgTree[0])
        orgTreeDataToReport(orgTree[0], depts)
      } else {
        allColumnCount = 12
        addDep = UB.i18n('Підрозділ')
        partTitleColCount = 5
        depts.push({ emps: gridData })
        depts.push({ depSum: { title: UB.i18n('Всього'), dsum: allSum } })
      }

      Object.assign(resultData, {
        accrual,
        allSum,
        notes,
        sorter,
        depts,
        allColumnCount,
        partTitleColCount,
        addDep
      })
    }
    me.createDataForSickness = function (resultData, mParams) {
      const grid = me.listUbdetailgrid
      const gridData = grid.getData()
      const gridStore = grid.getStore()
      const allSum = { days: 0, paySum: 0 }
      const notes = []
      let sorter
      let depts = []
      let allColumnCount = 13
      let npp = 1

      function orgTreeCalcDepSum (curNode) {
        curNode.calcSum = {
          allSum: { days: 0, paySum: 0 }
        }

        if (curNode.isNotEmpty) {
          if (curNode.emps && curNode.emps.length > 0) {
            curNode.emps.forEach(el => {
              curNode.calcSum.allSum.days = AC.currencyService.round(curNode.calcSum.allSum.days += el.days || 0, 2)
              curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += el.paySum || 0, 2)
            })
          }

          curNode.childs.forEach(cur => {
            orgTreeCalcDepSum(cur)
            curNode.calcSum.allSum.days = AC.currencyService.round(curNode.calcSum.allSum.days += cur.calcSum.allSum.days || 0, 2)
            curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += cur.calcSum.allSum.paySum || 0, 2)
          })
        }
      }
      function orgTreeDataToReport (curNode, depts, organizationID) {
        if (curNode.isNotEmpty) {
          let depart = {
            emps: curNode.emps.map(row => {
              return Object.assign({}, row, {
                num: npp++
              })
            })
          }
          if (curNode.name) {
            depart.dept = { colCount: allColumnCount, deptName: curNode.name }
          }
          depts.push(depart)
        }
        curNode.childs.forEach(ep => {
          orgTreeDataToReport(ep, depts, organizationID)
        })
        if ((curNode.isNotEmpty && curNode.name) || curNode.mi_data_id === organizationID) {
          let depart = {
            emps: [],
            depSum: { title: curNode.name + `&nbsp;&nbsp;&nbsp;${UB.i18n('Всього')}`, dsum: [] }
          }
          depart.depSum.dsum = curNode.calcSum.allSum
          depts.push(depart)
        }
      }
      function showDataByPayEl (data) {
        if (!data || !data.length) return
        let gridDataByPayEl = [...data]
        gridDataByPayEl.sort((a, b) => (a.payElCode > b.payElCode) ? 1 : -1)
        gridDataByPayEl = _.groupBy(gridDataByPayEl, 'payElID')
        depts.push({ paySum: { title: UB.i18n('У тому числі в розрізі видів оплати:'), isTitle: true } })
        _.forEach(gridDataByPayEl, items => {
          depts.push({ paySum: { title: items[0].payElName, dsum: { days: items.reduce((res, item) => res + item.days || 0, 0), paySum: items.reduce((res, item) => res + item.paySum || 0, 0) } } })
        })
      }

      const filter = grid.getStore().filters
      filter.items.forEach(filt => {
        const curFilter = grid.extendedFieldList.find(el => el.name === filt.property)
        notes.push({ filterName: `${curFilter.description}:`, value: filt.value })
      })

      // round and num
      // baseSum paySum rate days
      gridData.forEach((item, i) => {
        item.baseSum = item.baseSum ? AC.currencyService.round(item.baseSum, 2) : 0
        item.paySum = item.paySum ? AC.currencyService.round(item.paySum, 2) : 0
        item.rate = item.rate ? AC.currencyService.round(item.rate, 2) : 0
        item.num = i + 1

        allSum.days = AC.currencyService.round(allSum.days += item.days, 2)
        allSum.paySum = AC.currencyService.round(allSum.paySum += item.paySum, 2)
      })

      if (gridStore.sorters.items[0]) {
        sorter = gridStore.sorters.items[0].property
      }

      if ((sorter && sorter === 'depName') || (!sorter)) {
        resultData.orgNames.forEach(org => {
          if (gridData.filter(el => el.organizationID === org.ID).length) {
            if (mParams.execParams.organizationID && mParams.execParams.includeSubOrg) {
              depts.push({
                isOrg: true,
                dept: { colCount: allColumnCount, deptName: org.description }
              })
            }
            let gridDatabyOrg = gridData.filter(el => el.organizationID === org.ID)
            let orgTree = HR.treeUtils.orgTree(org.ID, gridDatabyOrg, AC.dateService.shiftDate(mParams.execParams.periodTo), resultData.orgStruct.filter(el => el.orgID === org.ID))
            orgTreeCalcDepSum(orgTree[0])
            orgTreeDataToReport(orgTree[0], depts, org.ID)
            showDataByPayEl(gridDatabyOrg)
          }
        })
        if (mParams.execParams.organizationID && mParams.execParams.includeSubOrg) {
          depts.push({ depSum: { title: UB.i18n('Всього'), dsum: allSum } })
          showDataByPayEl(gridData)
        }
      } else {
        depts.push({ emps: gridData })
        depts.push({ depSum: { title: UB.i18n('Всього'), dsum: allSum } })
        showDataByPayEl(gridData)
      }

      Object.assign(resultData, {
        notes,
        depts
      })
    }
    me.createDataForBonus = function (resultData, mParams) {
      const grid = me.listUbdetailgrid
      const gridData = grid.getData()
      const gridStore = grid.getStore()
      // let accrual = []
      const allSum = { paySum: 0 }
      const notes = []
      let sorter
      let depts = []
      let allColumnCount = 12

      function orgTreeCalcDepSum (curNode) {
        curNode.calcSum = {
          allSum: { paySum: 0 }
        }

        if (curNode.isNotEmpty) {
          if (curNode.emps && curNode.emps.length > 0) {
            curNode.emps.forEach(el => {
              curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += el.paySum || 0, 2)
            })
          }

          curNode.childs.forEach(cur => {
            orgTreeCalcDepSum(cur)
            curNode.calcSum.allSum.paySum = AC.currencyService.round(curNode.calcSum.allSum.paySum += cur.calcSum.allSum.paySum || 0, 2)
          })
        }
      }

      function orgTreeDataToReport (curNode, depts) {
        if (curNode.isNotEmpty) {
          let depart = {
            emps: curNode.emps
          }
          if (curNode.name) {
            depart.dept = { colCount: allColumnCount, deptName: curNode.name }
          }
          depts.push(depart)
        }
        curNode.childs.forEach(ep => {
          orgTreeDataToReport(ep, depts)
        })
        if ((curNode.isNotEmpty && curNode.name) || curNode.mi_data_id === mParams.execParams.orgID) {
          let depart = {
            emps: [],
            depSum: { title: curNode.name + `&nbsp;&nbsp;&nbsp;${UB.i18n('Всього')}`, dsum: [] }
          }
          depart.depSum.dsum = curNode.calcSum.allSum
          depts.push(depart)
        }
      }
      const filter = grid.getStore().filters
      filter.items.forEach(filt => {
        const curFilter = grid.extendedFieldList.find(el => el.name === filt.property)
        notes.push({ filterName: `${curFilter.description}:`, value: filt.value })
      })

      // round and num
      gridData.forEach((item, i) => {
        item.paySum = item.paySum ? AC.currencyService.round(item.paySum, 2) : 0
        item.num = i + 1
        allSum.paySum = AC.currencyService.round(allSum.paySum += item.paySum, 2)
      })

      if (gridStore.sorters.items[0]) sorter = gridStore.sorters.items[0].property

      if ((sorter && sorter === 'depName') || (!sorter)) {
        let orgTree = HR.treeUtils.orgTree(mParams.execParams.orgID, gridData, AC.dateService.shiftDate(mParams.execParams.periodTo), resultData.orgStruct)
        orgTreeCalcDepSum(orgTree[0])
        orgTreeDataToReport(orgTree[0], depts)
      } else {
        depts.push({ emps: gridData })
        depts.push({ depSum: { title: UB.i18n('Всього'), dsum: allSum } })
      }

      Object.assign(resultData, {
        // accrual,
        allSum,
        notes,
        sorter,
        depts
      })
    }

    me.makeHtmlReport_OLD = function (type = 'html') {
      me.setLoading(true)
      // onCalcFunc()
      $App.connection.run({
        entity: 'hr_accrualReport',
        method: reportMethod[reportCode],
        execParams: Object.assign({
          reportCode,
          orgID: appAC.globalOrganization(),
          currDate: appAC.globalApplicationDate(),
          selectedRows: JSON.stringify(me.accrualGrid ? me.accrualGrid.getCheckedRows() : [])
        },
        me.record)
      }).then(mParams => {
        let resultData = JSON.parse(mParams.resultData)
        if (getHtmlMethod[reportCode]) me[getHtmlMethod[reportCode]](resultData, mParams)

        //
        const listUbdetailgrid = me.listUbdetailgrid
        if (listUbdetailgrid) {
          resultData = makeHtmlData(listUbdetailgrid, resultData)
        }

        me.report = Ext.create('UBS.UBReport', {
          code: reportCode,
          type,
          params: resultData,
          language: $App.connection.userLang()
        })

        const listGrid = me.queryById('listGrid')
        if (listGrid) {
          listGrid.setLocalStoreData(resultData.accrual)
        }

        if (type === 'xlsx') {
          me.report.makeReport().then(function (data) {
            const blobData = new Blob(
              [data.reportData], {
                type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
              }
            )
            const repName = reportCode.split('-').slice(-1)
            const fileName = `${repName}.xlsx`
            window.saveAs(blobData, fileName)
            me.setLoading(false)
          })
        } else {
          me.report
            .init()
            .then(function () {
              return me.report.makeReport()
            })
            .then(function (data) {
              if (data && data.reportData) {
                if (data.reportData.length > 10000000) {
                  data = null
                  me.report = Ext.create('UBS.UBReport', {
                    code: reportCode,
                    type: 'xlsx',
                    params: resultData,
                    language: $App.connection.userLang()
                  })
                  me.report.makeReport().then(function (xlsxData) {
                    const blobData = new Blob(
                      [xlsxData.reportData], {
                        type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                      }
                    )
                    const repName = reportCode.split('-').slice(-1)
                    const fileName = `${repName}.xlsx`
                    window.saveAs(blobData, fileName)
                    me.setLoading(false)
                    $App.dialogInfo(UB.i18n('Занадто великий обсяг інформації. Звіт було вивантажено у Excel'))
                  })
                } else {
                  me.showReport(data.reportData)
                  me.setLoading(false)
                }
              } else {
                me.setLoading(false)
                me.reportDone = true
              }
            })
        }
      })
    }

    me.makeHtmlReport = function (type = 'html') {
      me.reportType = type
      me.setLoading(true)
      // onCalcFunc()
      const tabReport = me.queryById('tabReport')
      const cmpTabPanel = me.queryById('cmpTabPanel')
      cmpTabPanel.setActiveTab(tabReport)

      const listUbdetailgrid = me.listUbdetailgrid
      if (listUbdetailgrid) {
        const store = listUbdetailgrid.getStore()
        let req = store.ubRequest
        const objParam = Object.assign({
          reportCode,
          orgID: appAC.globalOrganization(),
          currDate: appAC.globalApplicationDate(),
          selectedRows: JSON.stringify(me.accrualGrid ? me.accrualGrid.getCheckedRows() : [])
        },
        me.record)
        req = Object.assign(req, objParam)
        // store.load()
        store.load({ start: 0, limit: 10000, page: 1 })
        me.setLoading(false)
      } else {
        if (reportCode === 'hr_accrual-groupReport') {
          makeGroupReport(type)
        } else {
          makeReport(type)
        }
      }
    }

    me.clearPrintForm = function () {
      if (me.report && me.reportControl) {
        const iFrame = me.reportControl.getEl().dom
        const iFrameDoc = iFrame.contentDocument
        iFrameDoc.body.innerHTML = ''
      }
      const listUbdetailgrid = me.listUbdetailgrid
      if (listUbdetailgrid && listUbdetailgrid.store && listUbdetailgrid.store.data) {
        let ubgStore = listUbdetailgrid.getStore()
        ubgStore.data.items = []
        listUbdetailgrid.view.refresh()

        listUbdetailgrid.GridSummary.items.each(function (item) {
          let el
          if (item.baseColumn.summaryType) {
            el = item.getEl()
            el.setHTML('')
          }
        })
      }
    }

    me.callParent(arguments)
  },

  onSaveTemplate: function (me, reportCode, saveAs) {
    const params = {}
    if (me.templateAttrs[reportCode]) {
      me.templateAttrs[reportCode].forEach(attrName => {
        const ctrl = me.down(`[name=${attrName}]`)
        if (ctrl) {
          params[attrName] = ctrl.getGridValue ? ctrl.getGridValue(ctrl) : ctrl.getValue()
        }
      })
    }
    if (!me.down(`[name=reportTemplate]`).getValue() || saveAs) {
      $App.doCommand({
        cmdType: 'showForm',
        formCode: 'ac_reportTemplates',
        entity: 'ac_reportTemplates',
        cmpInitConfig: {
          reportCode,
          organizationID: appAC.globalOrganization(),
          params,
          onSave: (ID) => {
            me.down(`[name=reportTemplate]`).setValueById(ID)
          }
        }
      })
    } else {
      AC.reportService.updateReportTemplate({ ID: me.down(`[name=reportTemplate]`).getValue(), params })
    }
  },

  onDeleteTemplate: function (me, reportCode) {
    const ctrl = me.down(`[name=reportTemplate]`)
    if (ctrl.getValue() && (ctrl.getFieldValue('userID') === $App.connection.userData().userID || AC.entityUtils.isAdmin())) {
      $App.connection.run({
        entity: 'ac_reportTemplates',
        method: 'delete',
        execParams: {
          ID: ctrl.getValue()
        }
      }).then(() => {
        $App.dialogInfo(UB.i18n('Видалено'))
        ctrl.getStore().load()
        ctrl.setValueById()
      })
    }
  },
  onHideShowParams: function (me, reportCode) {
    const btn = me.down(`[name=hideShowButton]`)
    me.isShowParam = !me.isShowParam
    // btn.setTooltip(me.isShowParam ? UB.i18n('Приховати умови відбору') : UB.i18n('Показати умови відбору'))

    if (me.hideShowAttrs[reportCode]) {
      me.hideShowAttrs[reportCode].forEach(attrName => {
        me.attr[attrName][me.isShowParam ? 'show' : 'hide']()
      })
    }
  },
  onButtonRefresh: function (me) {
    me.validateFields() && me.makeHtmlReport()
  },

  showReport: function (data) {
    const me = this
    const HTML_PAGEBREAK_RE = new RegExp('<!-- pagebreak -->', 'gi')
    const HTML_PAGEBREAK_EL = '<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" class="mce-pagebreak"/>'
    const iFrame = me.reportControl.getEl().dom
    const iFrameDoc = iFrame.contentDocument
    const style = [getStyle()]
    const orientation = me.report.reportOptions.pageOrientation
    if (orientation === 'landscape') {
      style.push('@page{size: landscape;}')
    } else if (orientation === 'portrait') {
      style.push('@page{size: portrait;}')
    }
    const styleText = `<style type="text/css"> ${style.join('\n')} </style>`
    me.report.reportOptions.html = data
    iFrameDoc.body.innerHTML = data.replace(HTML_PAGEBREAK_RE, HTML_PAGEBREAK_EL)
    iFrameDoc.head.innerHTML = styleText

    const reportCode = me.report.reportCode
    const dictFundSourceIDs = me.attr.dictFundSourceID && me.attr.dictFundSourceID.getValue()
    const dictProgClassIDs = me.attr.dictProgClassID && me.attr.dictProgClassID.getValue()
    me.report.onReportClick = (e) => {
      switch (reportCode) {
        case 'hr_report_averageStatistics':
          e.preventDefault()
          $App.doCommand({
            cmdType: 'showForm',
            entity: 'hr_employeeNumber',
            instanceID: parseInt(e.target.dataset.id, 10)
          })
          break
        case 'hr_accrual-sickRegister':
          let docRegSicknessID = e.target.dataset['cellorderid'] ? parseInt(e.target.dataset['cellorderid']) : 0
          let reportCode = 'hr_docRegSickness_1'

          let report = Ext.create('UBS.UBReport', {
            code: reportCode,
            type: 'html',
            params: {
              instanceID: docRegSicknessID,
              dictFundSourceIDs,
              dictProgClassIDs,
              selectList: true
            }
          })
          report.init().then(function () {
            let transformToXlsx = true
            let config = {
              cmdType: 'showForm',
              formCode: 'ac_documentViewer',
              caption: UB.i18n('Друкована форма'),
              cmpInitConfig: { report: report, transformToXlsx },
              tabId: 'printDocument' + reportCode + docRegSicknessID,
              description: UB.i18n('Лікарняний лист'),
              target: $App.getViewport().centralPanel,
              filterMenu: true
            }
            $App.doCommand(config)
          })
          break
      }
      e.preventDefault()
    }

    if (me.report.onReportClick) { // add onclick handler for all <a href="">
      let refs = iFrameDoc.getElementsByTagName('a')
      for (let i = 0, L = refs.length; i < L; i++) {
        refs[i].addEventListener('click', me.report.onReportClick.bind(me), true)
      }
    }

    me.setLoading(false)
  },
  afterRender: function () {
    const me = this
    me.callParent(arguments)

    const titleByReport = {
      'hr_accrual-N6': UB.i18n('Форма № П-6 "Розрахунково-платіжна відомість працівника"'),
      'hr_accrual-N7': UB.i18n('Форма № П-7 "Розрахунково-платіжна відомість (зведена)"'),
      'hr_accrual-income': UB.i18n('Довідка про доходи для субсидії'),
      'hr_accrual-incomeTax': UB.i18n('Довідка про доходи для податкової'),
      'hr_accrual-payment': UB.i18n('Звіт про здійснені відрахування та виплати'),
      'hr_accrual-credit': UB.i18n('Довідка про заробітну плату для отримання кредиту'),
      'hr_accrual-incTax': UB.i18n('Звіт про дохід, з якого вираховується ЄСВ за видами нарахувань'),
      'hr_accrual-FOP': UB.i18n('Звіт з ФОП'),
