    function getTimeCostExtraTab (opts = {}) {
      if (typeof opts !== 'object') opts = {}
      return {
        itemId: 'tabReportExtra',
        title: opts.title || UB.i18n('Додаткові параметри'),
        autoScroll: true,
        margin: '5, 0, 0, 0',
        hidden: opts.hidden,
        layout: {
          type: 'hbox'
        },
        items: [
          {
            layout: {
              type: 'vbox',
              align: 'stretch'
            },
            width: 480,
            autoScroll: true,
            items: [
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Відображати періоди'),
                labelWidth: 420,
                name: 'showPeriod',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['showPeriod'] = value
                    if (!value && me.record['setOrderBy'] && me.record['setOrderBy'] === '1') {
                      me.attr.setOrderBy.setValue('2')
                    }
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Відображати періоди, в яких були додані елементи обліку'),
                labelWidth: 420,
                name: 'showPeriodElInput',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['showPeriodElInput'] = value
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Групувати в розрізі структурних підрозділів'),
                labelWidth: 420,
                name: 'groupReportByDep',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['groupReportByDep'] = value
                    if (!value && me.record['setOrderBy'] && me.record['setOrderBy'] === '4') {
                      me.attr.setOrderBy.setValue('1')
                    }
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Враховувати зміну посади та підрозділу у місяцях періоду'),
                labelWidth: 420,
                name: 'checkPosDepChange',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['checkPosDepChange'] = value
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Виводити рядки з нульовими сумами'),
                labelWidth: 420,
                name: 'showZeroSumRows',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['showZeroSumRows'] = value
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Відображати накази'),
                labelWidth: 420,
                name: 'showOrder',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['showOrder'] = value
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'ubcombobox',
                dataType: 'Enum',
                enumGroupFilter: 'HR_ORDER_BY',
                fieldLabel: UB.i18n('Впорядкувати'),
                name: 'setOrderBy',
                labelWidth: 220,
                valueField: 'code',
                displayField: 'name',
                disableContextMenu: true,
                hideEntityItemInContext: true,
                ubRequest: {
                  entity: 'ubm_enum',
                  method: UB.core.UBCommand.methodName.SELECT,
                  fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                  whereList: {
                    eGroup: {
                      expression: '[eGroup]',
                      condition: 'equal',
                      values: { 'eGroup': 'HR_ORDER_BY' }
                    }
                  }
                },
                listeners: {
                  change: function (ctrl, value) {
                    me.record['setOrderBy'] = value
                    if (value === '1') {
                      me.attr.showPeriod.setValue(true)
                    } else if (value === '4') {
                      me.attr.groupReportByDep.setValue(true)
                    }
                    me.clearPrintForm()
                  }
                }
              }
            ]
          },
          getExtraColumnsGrid()
        ]
      }
    }

    function getControlCalcVacReserveExtraTab () {
      return {
        itemId: 'tabReportExtra',
        title: UB.i18n('Додаткові параметри'),
        autoScroll: true,
        margin: '5, 0, 0, 0',
        layout: {
          type: 'hbox'
        },
        items: [
          {
            layout: {
              type: 'vbox',
              align: 'stretch'
            },
            width: 480,
            autoScroll: true,
            items: [
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Враховувати зміну посади та підрозділу у місяцях періоду'),
                labelWidth: 420,
                name: 'checkPosDepChange',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['checkPosDepChange'] = value
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Виводити рядки з нульовими сумами'),
                labelWidth: 420,
                name: 'showZeroSumRows',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['showZeroSumRows'] = value
                    const el = me.down('[name=showZeroSumRows]')
                    if (value) {
                      el.setValue(true)
                    }
                    me.clearPrintForm()
                  }
                }
              },
              {
                xtype: 'checkbox',
                fieldLabel: UB.i18n('Групувати в розрізі структурних підрозділів'),
                labelWidth: 420,
                name: 'groupReportByDep',
                listeners: {
                  change: function (ctrl, value) {
                    me.record['groupReportByDep'] = value
                    me.clearPrintForm()
                  }
                }
              }
            ]
          },
          {
            xtype: 'acGrid',
            name: 'extraColumnsList',
            width: 450,
            autoScroll: true,
            storeType: 'local',
            disablePaging: true,
            notWriteChanges: true,
            showToolBar: false,
            useCheckBoxColumn: true,
            hideActions: ['edit', 'del', 'addNewByCurrent', 'addNew'],
            fields: [
              { name: 'code' },
              { name: 'description', columnConfig: { text: UB.i18n('Додаткові стовбці'), flex: 1 } }
            ],
            getRowClass: function (record) {
              if (record.get('isChecked')) {
                return 'ub-grid-row-selected'
              }
            },
            onAfterRender: async (grid) => {
              const storeData = [
                { code: 'sexType', description: UB.i18n('Стать') },
                { code: 'birthDate', description: UB.i18n('Дата народження') },
                { code: 'dateFrom', description: UB.i18n('Дата прийому на роботу') },
                { code: 'dateTo', description: UB.i18n('Дата звільнення') },
                { code: 'workerType', description: UB.i18n('Форма зайнятості') },
                { code: 'workScheduleID', description: UB.i18n('Графік роботи') },
                { code: 'workPlace', description: UB.i18n('Місце роботи') },
                { code: 'dictStaffCatID', description: UB.i18n('Категорія персоналу') },
                { code: 'mtCount', description: UB.i18n('Кількість ставок') },
                { code: 'dictCategoryECBID', description: UB.i18n('Категорія застрахованої особи') },
                { code: 'accountID', description: UB.i18n('Рахунок витрат') }
              ]
              const costType = await UB.Repository('hr_payDim')
                .attrs('ID')
                .where('dimension.entityName', '=', 'ac_dictCostType')
                .where('dimension.mi_deleteDate', '=', '#maxdate')
                .selectSingle()
              if (costType) {
                storeData.push({ code: 'dictCostType', description: UB.i18n('Місце виникнення витрат') })
              }
              grid.setLocalStoreData(storeData)
            },
            onRowChecked: (grid, record) => {
              if (!me.record['extraColumns']) me.record['extraColumns'] = []
              me.record['extraColumns'].push(record.get('code'))
            },
            onRowUnchecked: (grid, record) => {
              if (me.record['extraColumns']) {
                const idx = me.record['extraColumns'].indexOf(record.get('code'))
                if (idx >= 0) me.record['extraColumns'].splice(idx, 1)
              }
            }
          }
        ]
      }
    }

    function getExtraColumnsGrid () {
      return {
        xtype: 'acGrid',
        name: 'extraColumnsList',
        width: 450,
        autoScroll: true,
        storeType: 'local',
        disablePaging: true,
        notWriteChanges: true,
        showToolBar: false,
        style: 'border: 1px solid #BFBFBF; border-radius: 4px;',
        useCheckBoxColumn: true,
        hideActions: ['edit', 'del', 'addNewByCurrent', 'addNew'],
        fields: [
          { name: 'code' },
          { name: 'description', columnConfig: { text: UB.i18n('Додаткові стовбці'), flex: 1 } }
        ],
        getRowClass: function (record) {
          if (record.get('isChecked')) {
            return 'ub-grid-row-selected'
          }
        },
        onAfterRender: async (grid) => {
          const storeData = [
            { code: 'sexType', description: UB.i18n('Стать') },
            { code: 'birthDate', description: UB.i18n('Дата народження') },
            { code: 'dateFrom', description: UB.i18n('Дата прийому на роботу') },
            { code: 'dateTo', description: UB.i18n('Дата звільнення') },
            { code: 'workerType', description: UB.i18n('Форма зайнятості') },
            { code: 'workScheduleID', description: UB.i18n('Графік роботи') },
            { code: 'workPlace', description: UB.i18n('Місце роботи') },
            { code: 'dictStaffCatID', description: UB.i18n('Категорія персоналу') },
            { code: 'mtCount', description: UB.i18n('Кількість ставок') },
            { code: 'dictCategoryECBID', description: UB.i18n('Категорія застрахованої особи') },
            { code: 'accountID', description: UB.i18n('Рахунок витрат') }
          ]
          const costType = await UB.Repository('hr_payDim')
            .attrs('ID')
            .where('dimension.entityName', '=', 'ac_dictCostType')
            .where('dimension.mi_deleteDate', '=', '#maxdate')
            .selectSingle()
          if (costType) {
            storeData.push({ code: 'dictCostType', description: UB.i18n('Місце виникнення витрат') })
          }
          grid.setLocalStoreData(storeData)
        },
        onRowChecked: (grid, record) => {
          if (!me.record['extraColumns']) me.record['extraColumns'] = []
          me.record['extraColumns'].push(record.get('code'))
        },
        onRowUnchecked: (grid, record) => {
          if (me.record['extraColumns']) {
            const idx = me.record['extraColumns'].indexOf(record.get('code'))
            if (idx >= 0) me.record['extraColumns'].splice(idx, 1)
          }
        }
      }
    }

