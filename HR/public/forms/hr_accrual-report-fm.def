    function getDateFromToCtrl (labelWidth = 115) {
      return {
        layout: { type: 'hbox' },
        items: [
          {
            xtype: 'datefield',
            name: 'dateFrom',
            labelWidth,
            width: 300,
            fieldLabel: UB.i18n('За період з'),
            allowBlank: false,
            value: AC.dateService.firstDayOfMonth(new Date()),
            validator: function () {
              const ctrl = this
              if (ctrl) {
                let form = ctrl.up('form')
                const f = form.down('[name=dateFrom]').getValue()
                const t = form.down('[name=dateTo]').getValue()
                return (f && t && f > t)
                  ? UB.i18n('Дата кінця періоду повинна перевищувати дату початку')
                  : true
              }
            },
            listeners: {
              change: function (fld) {
                me.record['dateFrom'] = AC.dateService.shiftDate(fld.getValue())
                me.clearPrintForm()
              }
            }
          },
          {
            xtype: 'datefield',
            name: 'dateTo',
            labelWidth: 30,
            width: 100,
            fieldLabel: UB.i18n('по'),
            allowBlank: false,
            value: AC.dateService.lastDayOfMonth(new Date()),
            validator: function () {
              const ctrl = this
              if (ctrl) {
                let form = ctrl.up('form')
                const f = form.down('[name=dateFrom]').getValue()
                const t = form.down('[name=dateTo]').getValue()
                return (f && t && f > t)
                  ? UB.i18n('Дата кінця періоду повинна перевищувати дату початку')
                  : true
              }
            },
            listeners: {
              change: function (fld) {
                me.record['dateTo'] = AC.dateService.shiftDate(fld.getValue())
                me.clearPrintForm()
              }
            }
          }
        ]
      }
    }

    function getDateCtrl (width = 300, labelWidth = 115, hidden = true, allowBlank = true) {
      return {
        xtype: 'datefield',
        name: 'onDate',
        labelWidth,
        width,
        fieldLabel: UB.i18n('Станом на'),
        allowBlank: allowBlank,
        hidden: hidden,
        value: appAC.globalApplicationDate(),
        listeners: {
          change: function (fld) {
            me.record['onDate'] = AC.dateService.shiftDate(fld.getValue())
            me.clearPrintForm()
          }
        }
      }
    }

    function getUpMarginCtrl () {
      return {
        xtype: 'numberfield',
        name: 'upMarginValue',
        labelWidth: 115,
        width: 200,
        fieldLabel: UB.i18n('Відступ зверху'),
        allowDecimals: true,
        vtype: 'floatValidator',
        floatFormat: 2,
        decimalPrecision: 2,
        listeners: {
          change: function (fld) {
            me.record['upMarginValue'] = fld.getValue()
            const settings = JSON.parse(UB.core.UBLocalStorageManager.getItem('hr_accrualReport_margin') || '{}')
            settings['upMarginValue'] = fld.getValue()
            UB.core.UBLocalStorageManager.setItem('hr_accrualReport_margin', JSON.stringify(settings))
            me.clearPrintForm()
          }
        }
      }
    }

    function getLeftMarginCtrl () {
      return {
        xtype: 'numberfield',
        name: 'leftMarginValue',
        labelWidth: 115,
        width: 200,
        fieldLabel: UB.i18n('Відступ зліва'),
        allowDecimals: true,
        vtype: 'floatValidator',
        floatFormat: 2,
        decimalPrecision: 2,
        listeners: {
          change: function (fld) {
            me.record['leftMarginValue'] = fld.getValue()
            const settings = JSON.parse(UB.core.UBLocalStorageManager.getItem('hr_accrualReport_margin') || '{}')
            settings['leftMarginValue'] = fld.getValue()
            UB.core.UBLocalStorageManager.setItem('hr_accrualReport_margin', JSON.stringify(settings))
            me.clearPrintForm()
          }
        }
      }
    }

