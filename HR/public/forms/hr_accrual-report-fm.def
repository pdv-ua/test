                    listeners: {
                      change: function (ctrl, value) {
                        me.record['showZeroSumRowsWithAcc'] = value
                        const el = me.down('[name=showZeroPayElSumRows]')
                        if (value) {
                          el.setValue(true)
                        }
                        me.clearPrintForm()
