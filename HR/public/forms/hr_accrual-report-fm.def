    function getDatePeriodsCtrl (onChange = () => true) {
      return {
        layout: { type: 'hbox' },
        items: [
          {
            xtype: 'datefield',
            name: 'periodFrom',
            labelWidth: 120,
            width: 240,
            allowBlank: false,
            fieldLabel: UB.i18n('Період з'),
            validator: function () {
              const f = me.down('[name=periodFrom]').getValue()
              const t = me.down('[name=periodTo]').getValue()
              if (f && t) {
                me.down('[name=periodTo]').clearInvalid()
                return (f > t)
                  ? UB.i18n('Дата кінця періоду повинна перевищувати дату початку')
                  : true
              }
              return true
            },
            listeners: {
              change: function (fld) {
                me.record.periodFrom = fld.getValue() || null
                onChange({ dateFrom: me.record.periodFrom, orgID: appAC.globalOrganization() }) &&
                  me.clearPrintForm()
                // me.validateFields() && me.makeHtmlReport()
              }
            }
          },
          {
            xtype: 'datefield',
            name: 'periodTo',
            labelWidth: 30,
            maxWidth: 150,
            allowBlank: false,
            fieldLabel: UB.i18n('по'),
            validator: function () {
              const f = me.down('[name=periodFrom]').getValue()
              const t = me.down('[name=periodTo]').getValue()
              if (f && t) {
                me.down('[name=periodFrom]').clearInvalid()
                return (f > t)
                  ? UB.i18n('Дата кінця періоду повинна перевищувати дату початку')
                  : true
              }
              return true
            },
            listeners: {
              change: function (fld) {
                me.record.periodTo = fld.getValue() || null
                onChange({ dateTo: me.record.periodTo, orgID: appAC.globalOrganization() }) &&
                  me.clearPrintForm()
                // me.validateFields() && me.makeHtmlReport()
              }
            }
          }
        ]
      }
    }

    function getListParamTabs (currTabs, tabListToAdd, fieldList = [], formCode, formListCode = null, enablePayElOrderN = false,
      btAddListName = UB.i18n('Додати списком'), isEditable = false, otherParams = {}) {
      if (!me.listParamTabs) me.listParamTabs = {}
      const tabsCode = tabListToAdd.map(tab => tab.code)
      UB.Repository('hr_listParam')
        .attrs('ID', 'code')
        .where('code', 'in', tabsCode)
        .selectAsObject().then(res => {
          res.forEach(item => {
            me.listParamTabs[item.code] = item.ID
          })
        })
      const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
      tabListToAdd.forEach(({ code, title, hidden = false }) => {
        currTabs.push({
          itemId: code,
          title: title,
          hidden: hidden,
          layout: {
            type: 'vbox',
            align: 'stretch'
          },
          items: [
            {
              xtype: 'entitygridpanel',
              cmdType: 'showList',
              autoScroll: true,
              pageSize: 10000,
              flex: 1,
              // hideActions: ['showPreview', 'itemLink', 'commandLink', 'addNewByCurrent', 'detail', 'edit', formListCode ? 'addNew' : ''],
              hideActions: ['showPreview', 'itemLink', 'commandLink', 'addNewByCurrent', 'detail', !isEditable ? 'edit' : '', formListCode ? 'addNew' : ''],
              openForm: function () { },
              entityConfig: {
                entity: 'hr_idParam',
                method: 'select',
                fieldList,
                whereList: {
                  byTab: {
                    expression: '[listParamID.code]',
                    condition: 'equal',
                    values: { code: code }
                  },
                  byOrgID: {
                    expression: '[orgID]',
                    condition: 'equal',
                    values: { orgID: Number(parentOrgID || appAC.globalOrganization()) }
                  }
                }
              },
              onAddNew: function () {
                const grid = this
                const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode,
                  entity: 'hr_idParam',
                  initialFieldValues: {
                    listParamID: me.listParamTabs[code],
                    orgID: Number(parentOrgID || appAC.globalOrganization())
                  },
                  cmpInitConfig: {
                    tabsCode
                  },
                  store: grid.getStore()
                })
              },

              onEdit: function () {
                const grid = this
                const record = AC.gridUtils.getCurrentRecord(grid)

                $App.doCommand({
                  cmdType: 'showForm',
                  formCode,
                  entity: 'hr_idParam',
                  instanceID: record.get('ID'),
                  cmpInitConfig: {
                    tabsCode,
                    editFld: 'dopName'
                  },
                  store: grid.getStore(),
                  sender: grid
                })
              },
              onItemDblClick: function (grid, record) {
                if (!formListCode) {
                  const item = this
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode,
                    entity: 'hr_idParam',
                    instanceID: record.get('ID'),
                    cmpInitConfig: {
                      tabsCode,
                      byUser: otherParams.byUser
                    },
                    store: grid.getStore(),
                    sender: item
                  })
                }
              },
              customActions: [
                {
                  itemId: 'addList',
                  text: btAddListName,
                  actionId: 'addByList',
                  iconCls: 'u-icon-edit-alt',
                  scale: 'medium',
                  cls: 'fill-action',
                  hidden: !formListCode,
                  handler: function (btn) {
                    const grid = btn.up('entitygridpanel')
                    const sourceData = (grid.getStore().snapshot || grid.getStore().data).items.map(o => o.getData())
                    const selectData = sourceData.map(o => o.valuesID)
                    const sourceAttr = formListCode === 'hr_payElSelect' ? 'valuesID' : null
                    const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
                    $App.doCommand({
                      cmdType: 'showForm',
                      formCode: formListCode,
                      entity: 'hr_idParam',
                      cmpInitConfig: {
                        selectData,
                        sourceData,
                        sourceAttr,
                        byUser: otherParams.byUser,
                        exclude: ['OTHER'],
                        isAutoCalc: otherParams.isAutoCalc && otherParams.isAutoCalc === 1 ? 1 : null,
                        methodGroupCode: otherParams.methodGroupCode || null,
                        methodCode: otherParams.methodCode || null,
                        payElEntryType: ['FOZP', 'FDZP', 'ZKV'].includes(code) ? ['PAYMENT'] : null,
                        listParamID: me.listParamTabs[code],
                        tabsCode,
                        orgID: Number(parentOrgID || appAC.globalOrganization()),
                        enableOrderN: enablePayElOrderN,
                        onSelectData: (data) => {
                          if (data.remove.length || data.add.length || data.update.length) {
                            $App.connection.run({
                              entity: 'hr_idParam',
                              method: 'updateValuesIDs',
                              listParamID: me.listParamTabs[code],
                              orgID: Number(parentOrgID || appAC.globalOrganization()),
                              byUser: otherParams.byUser,
                              userID: $App.connection.userData().userID,
                              data: JSON.stringify(data)
                            }).then(() => {
                              grid.getStore().load()
                            })
                          }
                        }
                      },
                      store: grid.getStore()
                    })
                  }
                },
                {
                  itemId: 'deleteAll',
                  text: UB.i18n('Видалити все'),
                  actionId: 'deleteAll',
                  iconCls: 'fa fa-eraser',
                  cls: 'add-list-action',
                  hidden: !!formListCode,
                  handler: function (btn) {
                    const grid = btn.up('entitygridpanel')
                    const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
                    grid.store.data.items.length && $App.dialogYesNo('Попередження', UB.i18n('Видалити всі записи?'))
                      .then(res => {
                        if (res) {
                          $App.connection.run({
                            entity: 'hr_idParam',
                            method: 'deleteRecordsByCode',
                            execParams: {
                              code,
                              orgID: Number(parentOrgID || appAC.globalOrganization()),
                              byUser: otherParams.byUser,
                              userID: $App.connection.userData().userID
                            }
                          }).then(() => {
                            grid.onRefresh()
                          })
                        }
                      })
                  }
                }
              ],
              afterInit: function () {
                if (otherParams.byUser) {
                  this.store.ubRequest.whereList.byUserID = {
                    expression: '[userID]',
                    condition: 'equal',
                    value: $App.connection.userData().userID
                  }
                }
              },
              listeners: {
                refresh: function () {
                  if (!otherParams.byUser) {
                    const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
                    this.store.ubRequest.whereList.byOrgID.values.orgID = Number(parentOrgID || appAC.globalOrganization())
                  } else {
                    this.store.ubRequest.whereList.byOrgID.values.orgID = appAC.globalOrganization()
                    this.store.ubRequest.whereList.byUserID = {
                      expression: '[userID]',
                      condition: 'equal',
                      value: $App.connection.userData().userID
                    }
                  }
                },
                beforeQuerySend: function () {
                  if (!otherParams.byUser) {
                    const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
                    this.store.ubRequest.whereList.byOrgID.values.orgID = Number(parentOrgID || appAC.globalOrganization())
                  } else {
                    this.store.ubRequest.whereList.byOrgID.values.orgID = appAC.globalOrganization()
                    this.store.ubRequest.whereList.byUserID = {
                      expression: '[userID]',
                      condition: 'equal',
                      value: $App.connection.userData().userID
                    }
                  }
                }
              }
            }
          ]
        })
      })
    }

    function getDictSignersTab (signerCode) {
      return {
        title: UB.i18n('Підписанти'),
        xtype: 'ubdetailgrid',
        name: 'dictSigners',
        autoScroll: true,
        hideActions: ['addNew', 'showPreview', 'itemLink', 'commandLink', 'detail'],
        flex: 1,
        entityConfig: {
          entity: 'hr_dictSigners',
          method: 'select',
          fieldList: [
            {
              name: 'orderN',
              description: UB.i18n('№ з/п'),
              simpleFilter: true
            },
            {
              name: 'signerName',
              description: UB.i18n('Назва підписанта'),
              simpleFilter: true
            },
            {
              name: 'employeeNumberID.description',
              description: UB.i18n('Працівник'),
              simpleFilter: true
            },
            {
              name: 'positionName',
              description: UB.i18n('Назва посади'),
              simpleFilter: true
            }
          ],
          orderList: { orderBy: { 'expression': 'orderN', 'order': 'asc' } },
          whereList: {
            signerCode: {
              expression: '[signerCode]',
              condition: 'equal',
              value: signerCode
            }
          }
        },
        cmpInitConfig: {
          disableAutoLoadStore: true,
          afterInit: function () {
              let orgID = AC.settings.get('hrUseSignersParentOrg', appAC.globalOrganization())
              if (!orgID) orgID =appAC.globalOrganization()
            AC.gridUtils.setGlobalOrganization(this, 'orgID',true,orgID)
          }
        },
        customActions: [
          {
            text: UB.i18n('Додати'),
            iconCls: 'u-icon-add',
            scale: 'medium',
            cls: 'add-new-action',
            handler: function sync (ctrl) {
              const me = ctrl.up('form')
              let organizationID = AC.settings.get('hrUseSignersParentOrg', appAC.globalOrganization())
              if (!organizationID) organizationID =appAC.globalOrganization()
              $App.doCommand({
                cmdType: 'showForm',
                formCode: 'hr_dictSigners',
                entity: 'hr_dictSigners',
                sender: me.down('[name=dictSigners]'),
                isModal: true,
                cmpInitConfig: {
                  defaultValues: {
                    orgID: organizationID,
                    departmentID: null,
                    signerCode: signerCode
                  }
                }
              })
            }
          },
          {
            xtype: 'button',
            iconCls: 'fas fa-angle-double-down',
            cls: 'fill-action',
            text: UB.i18n('Заповнити за замовчуванням'),
            handler: function sync (ctrl) {
              const me = ctrl.up('form')

              const isParentSigners = AC.settings.get('isParentSigners', appAC.globalOrganization())
              let orgID = appAC.globalOrganization()
              if (isParentSigners) orgID = AC.settings.get('hrUseSignersParentOrg', appAC.globalOrganization())

              let dictSignerStore = me.down('[name=dictSigners]').getStore()

              UB.Repository('hr_dictSigners')
                .attrs(['ID', 'departmentID', 'employeePositionID', 'employeeNumberID', 'positionName'])
                .where('orgID', '=', orgID)
                .where('signerCode', '=', signerCode)
                .where('departmentID', 'isNull')
                .orderBy('orderN')
                .selectAsObject().then(resp => {
                  if (resp && resp.length) {
                    $App.dialogYesNo(UB.i18n('Попередження!'), UB.i18n('Видалити існуючих підписантів?'))
                      .then(function (isYes) {
                        if (isYes) {
                          me.setLoading(true)
                          $App.connection.run({
                            entity: 'hr_dictSigners',
                            method: 'fillSignersByDefault',
                            params: JSON.stringify({
                              organizationID: orgID,
                              departmentID: null,
                              signerCode: signerCode
                            })
                          }).then(() => {
                            dictSignerStore.load()
                            me.setLoading(false)
                          }, function (err) {
                            me.setLoading(false)
                            throw err
                          })
                        }
                      })
                  } else {
                    me.setLoading(true)
                    $App.connection.run({
                      entity: 'hr_dictSigners',
                      method: 'fillSignersByDefault',
                      params: JSON.stringify({
                        organizationID: orgID,
                        departmentID: null,
                        signerCode: signerCode,
                        insertByDef: true
                      })
                    }).then(() => {
                      dictSignerStore.load()
                      me.setLoading(false)
                    }, function (err) {
                      me.setLoading(false)
                      throw err
                    })
                  }
                })
            }
          },
          {
            xtype: 'button',
            iconCls: 'fas fa-pencil-alt',
            cls: 'blue-action',
            text: UB.i18n('Оновити назви посади'),
            handler: function sync (ctrl) {
              const me = ctrl.up('form')
              let orgID = appAC.globalOrganization()
              let dictSignersStore = me.down('[name=dictSigners]').getStore()

              me.setLoading(true)
              $App.connection.run({
                entity: 'hr_dictSigners',
                method: 'updateSignersPos',
                params: JSON.stringify({
                  organizationID: orgID,
                  departmentID: null,
                  onDate: appAC.globalApplicationDate(),
                  signerCode: signerCode
                })
              }).then(() => {
                dictSignersStore.load()
                me.setLoading(false)
              }, function (err) {
                me.setLoading(false)
                throw err
              })
            }
          }
        ],
        customContextActions: [
          {
            text: UB.i18n('Оновити запис'),
            handler: () => {

            }
          }
        ]
      }
    }

    function getListParamDictStaffCatTab () {
      const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
      return {
        itemId: 'listParamDictStaffCat',
        title: UB.i18n('Категорії персоналу'),
        layout: 'fit',
        items: [
          {
            xtype: 'entitygridpanel',
            cmdType: 'showList',
            autoScroll: true,
            flex: 1,
            hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
            entityConfig: {
              entity: 'hr_idParam',
              method: 'select',
              fieldList: [
                {
                  name: 'listParamID',
                  visibility: false
                },
                {
                  name: 'orgID',
                  visibility: false
                },
                {
                  name: 'dictStaffCatID.name',
                  description: UB.i18n('Категорія персоналу')
                },
                {
                  name: 'valuesID',
                  visibility: false
                },
                {
                  name: 'orderN',
                  description: UB.i18n('Порядок відображення'),
                  config: {
                    flex: 1
                  }
                }
              ],
              orderList: { orderBy: { expression: 'orderN' } },
              whereList: {
                byTab: {
                  expression: '[listParamID.code]',
                  condition: 'equal',
                  values: { code: 'ReportRstStaffCat' }
                },
                byOrgID: {
                  expression: '[orgID]',
                  condition: 'equal',
                  values: { orgID: Number(parentOrgID || appAC.globalOrganization()) }
                }
              }
            },
            onItemDblClick: function (grid) {

            },
            customActions: [
              {
                itemId: 'addList',
                text: UB.i18n('Редагувати список'),
                actionId: 'addByList',
                iconCls: 'u-icon-edit-alt',
                scale: 'medium',
                cls: 'fill-action',
                handler: function (btn) {
                  const grid = btn.up('entitygridpanel')
                  const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
                  UB.Repository('hr_dictStaffCat')
                    .attrs(['ID', 'code', 'name', 'description'])
                    .orderBy('code')
                    .selectAsObject().then(sourceData => {
                      UB.Repository('hr_listParam')
                        .attrs('ID')
                        .where('code', '=', 'ReportRstStaffCat')
                        .selectScalar()
                        .then(listParamID => {
                          UB.Repository('hr_idParam')
                            .attrs(['ID', 'dictStaffCatID', 'orderN'])
                            .where('listParamID.code', '=', 'ReportRstStaffCat')
                            .where('orgID', '=', Number(parentOrgID || appAC.globalOrganization()))
                            .selectAsObject({
                              'dictStaffCatID': 'value'
                            })
                            .then(result => {
                              $App.doCommand({
                                cmdType: 'showForm',
                                formCode: 'hr_dictStaffCatSelect',
                                cmpInitConfig: {
                                  sourceData,
                                  selectData: result,
                                  onSelectData: (data) => {
                                    if (data.remove.length || data.add.length || data.update.length) {
                                      $App.connection.run({
                                        entity: 'hr_idParam',
                                        method: 'updateValuesIDs',
                                        listParamID: listParamID,
                                        orgID: Number(parentOrgID || appAC.globalOrganization()),
                                        data: JSON.stringify(data)
                                      }).then(() => {
                                        grid.getStore().load()
                                      })
                                    }
                                  }
                                }
                              })
                            })
                        })
                    })
                }
              }
            ],
            listeners: {
              refresh: function () {
                const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
                this.store.ubRequest.whereList.byOrgID.values.orgID = Number(parentOrgID || appAC.globalOrganization())
              },
              beforeQuerySend: function () {
                const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
                this.store.ubRequest.whereList.byOrgID.values.orgID = Number(parentOrgID || appAC.globalOrganization())
              }
            }
          }
        ]
      }
    }

    function getListVacTab () {
      // onCalcFunc = () => {
      //   const tabReport = me.queryById('tabReport')
      //   const cmpTabPanel = me.queryById('cmpTabPanel')
      //   cmpTabPanel.setActiveTab(tabReport)
      // }
      return {
        itemId: 'vacListTab',
        title: UB.i18n('Список'),
        layout: 'fit',
        items: [
          {
            xtype: 'ubdetailgrid',
            itemId: 'listUbdetailgrid',
            region: 'center',
            flex: 1,
            autoScroll: true,
            name: 'listUbdetailgrid',

            loadStoreImmediately: false,
            forceDataLoad: true,
            hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink',
              'commandLink', 'showDetail', 'audit', 'refresh'],

            summary: { days: 'sum', paySum: 'sum' },
            cmdData: {
              params: [{
                entity: 'hr_accrualReportPayVacation',
                method: 'getPayVacationDataGrid',
                fieldList: [
                  { name: 'tabNum', description: UB.i18n('Таб.№'), config: { width: 60 } },
                  { name: 'fullFIO', description: UB.i18n('ПІБ'), config: { flex: 2 } },
                  { name: 'payElName', description: UB.i18n('Вид оплати'), config: { width: 150 } },
                  { name: 'oblPeriod', description: UB.i18n('Обліковий період'), config: { width: 150 } },
                  { name: 'dateFrom', description: UB.i18n('Дата початку'), format: 'd.m.Y', config: { align: 'center', width: 100 } },
                  { name: 'dateTo', description: UB.i18n('Дата кiнця'), format: 'd.m.Y', config: { align: 'center', width: 100 } },
                  { name: 'period', description: UB.i18n('Період'), config: { align: 'center', width: 200 }, visibility: false },
                  { name: 'baseSum', description: UB.i18n('Середня'), format: '0.00', config: { align: 'right', width: 100 } },
                  { name: 'days', description: UB.i18n('Кількість днів'), format: '0', config: { align: 'right', width: 120 } },
                  { name: 'paySum', description: UB.i18n('Сума'), format: '0.00', config: { align: 'right', width: 100 } },
                  { name: 'posName', description: UB.i18n('Посада'), config: { width: 150 } },
                  { name: 'depName', description: UB.i18n('Підрозділ'), config: { flex: 1 } },
                  { name: 'selfStructDepName', description: UB.i18n('Структурний підрозділ'), config: { flex: 1 } },
                  { name: 'orgName', description: UB.i18n('Організація'), config: { flex: 1 } },
                  { name: 'orgID', visibility: false },
                  { name: 'payElCode', visibility: false },
                  { name: 'payElID', visibility: false },
                  { name: 'departmentID', visibility: false },
                  { name: 'tabNumSort', visibility: false }
                ]
              }]
            },
            cmpInitConfig: {
              onItemDblClick: function () {
                return false
              },
              afterInit: function () {
                const grid = this

                grid.getStore().on('load', (store, data) => {
                  const currencyRecNames = ['baseSum', 'days', 'paySum', 'rate']
                  if (data && data.length) {
                    data.forEach(record => {
                      currencyRecNames.forEach(name => {
                        if (!record.get(name)) {
                          record.set(name, 0)
                        }
                      })
                    })
                  }
                  makeReport('html', grid)
                })
              }
            }
          }
        ]
      }
    }

