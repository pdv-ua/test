      'hr_report_averageStatistics': UB.i18n('Звіт по середньообліковій чисельності та середньомісячній зарплаті'), // ????
      'hr_accrual-individualEmpContract': UB.i18n('Звіт по індивідуальним трудовим договорам (контракт)'), // ????
      'hr_accrual-payrollEmbassy': UB.i18n('Довідка про заробітну плату для посольства'),
      'hr_accrual-payrollRequire': UB.i18n('Довідка про заробітну плату за місцем вимоги'),
      'hr_accrual-avgSalary13': UB.i18n('Довідка про середню заробітну плату (для призначення допомоги) (Додаток 1 до Постанови № 13)'),
      'hr_accrual-avgSalaryMain': UB.i18n('Довідка про середню заробітну плату за основним місцем роботи'),
      'hr_accrual-avgSalaryFSS': UB.i18n('Довідка для СС (безробіття)'),
      'hr_accrual-calcFunds': UB.i18n('Відомість розрахунку нарахувань у фонди'),
      'hr_accrual-minWage': UB.i18n('Звіт про нарахування працівникові доплати до мінімальної заробітної плати'),
      'hr_accrual-payIndexSalary': UB.i18n('Довідка про розрахунок індексації заробітної плати'),
      'hr_accrual-vacation': UB.i18n('Звіт про розрахункові суми оплати відпусток та компенсації за невикористані відпустки'),
      'hr_accrual-bonus': UB.i18n('Звіт про сплату премій'),
      'hr_reportDeducTax': UB.i18n('Звіт про відрахування податку з доходів фізичних осіб'),
      'hr_reportDeducMilitaryTax': UB.i18n('Звіт про відрахування військового збору працівників'),
      'hr_reportAccrualReleased': UB.i18n('Звіт про нарахування звільненим'),
      'hr_accrual-sickness': UB.i18n('Звіт про розрахункові суми оплати праці за хворобою'),
      'hr_accrual-aliment': UB.i18n(`Звіт про розрахунок аліментів, виконавчих листів та погашення забов'язань`),
      'hr_accrual-unionPay': UB.i18n('Звіт про відрахування профспілкових внесків'),
      // 'hr_accrual-consolCateg': 'Консолідований звіт про нарахування та відрахування по категоріям',
      'hr_accrual-consolCateg': UB.i18n('Зведена відомість видів оплати по категоріям персоналу'),
      'hr_accrual-paySummary': UB.i18n('Розрахункова відомість (довільна форма)'),
      'hr_accrual-timeCost': UB.i18n('Список працівників з елементами обліку у табелі'),
      'hr_accrual-sickRegister': UB.i18n('Реєстр листів непрацездатності'),
      'hr_accrual-rl': UB.i18n('Розрахунковий лист за період'),
      'hr_accrual-rlMonth': UB.i18n('Розрахунковий лист списком'), // ????
      'hr_accrual-rlMonthEdu': UB.i18n('Розрахунковий лист списком (Освіта)'),
      'hr_accrual-infoCard': UB.i18n('Картка-довідка'),
      'hr_accrual-workReport': UB.i18n('Звіт з праці'),
      'hr_accrual-generalRegistry': UB.i18n('Загальний реєстр нараховано/утримано'),
      'hr_accrual-1NC': UB.i18n('Звіт 1НС'),
      'hr_accrual-groupReport': UB.i18n('Протокол групи звітів'),
      'hr_accrual-debtEmployees': UB.i18n('Список працівників, які мають заборгованість на кінець місяця'),
      'hr_accrual-listStudents': UB.i18n('Список студентів'),
      'hr_accrual-listEmployees': UB.i18n('Список працівників, що були прийняті або звільнені у періоді'),
      'hr_empListByLongVacation': UB.i18n('Список працівників, що знаходяться у довготривалих відпустках'),
      'hr_accrual-listAppointDismissEmp': UB.i18n('Список працівників, що були прийняті або звільнені у періоді'),
      'hr_accrual-costItems': UB.i18n('Зведена вiдомiсть по статтях затрат'),
      'hr_accrual-employeeAccrualList': UB.i18n('Список працівників по записах у постійних нарахуваннях/утриманнях')
    }

    me.templateAttrs = {
      'hr_accrual-generalRegistry': ['includeSubOrg', 'dictMultiGroupID', 'includeSubMultiGroup', 'departmentID', 'includeSubDep', 'facultyID', 'yearStudy', 'typeGroupReport',
        'payElListParams', 'payElGroupParams', 'hideZeroRow', 'groupPay', 'showPayName', 'extraColumnsListGR', 'studGroup'],
      'hr_accrual-employeeAccrualList': ['includeSubOrg', 'dictMultiGroupID', 'includeSubMultiGroup', 'departmentID', 'includeSubDep', 'payElListParams',
        'orgAccrual', 'indAccrual', 'tarifAccrual', 'showWithDateTo', 'showEmptyDateTo', 'checkPosDepChange', 'groupReportByDep', 'setOrderBy', 'extraColumnsListGR']
    }

    me.setTitle(titleByReport[me.commandData.reportCode])

    const fieldsAfterrender = {
      accEmployeePositionID: fld => {
        me.setAccEmployeePositionValue(fld, appAC.globalOrganization())
      },
      periodID: fld => {
        me.setPeriodValue(fld, appAC.globalOrganization())
      },
      reportDate: fld => {
        fld.setValue(appAC.globalApplicationDate())
        me.record.reportDate = appAC.globalApplicationDate()
      },
      issueDate: fld => {
        fld.setValue(appAC.globalApplicationDate())
        me.record.issueDate = appAC.globalApplicationDate()
      },
      periodFrom: fld => {
        if (['hr_accrual-payrollEmbassy', 'hr_accrual-payrollRequire', 'hr_accrual-credit'].includes(me.commandData.reportCode) && me.defaultEmployeeNumberID) {
          Promise.all([appHR.getCurrentPeriod(appAC.globalOrganization()),
            UB.Repository('hr_employeeNumberSR').attrs('dateFrom', 'dateToEmpty').where('ID', '=', me.defaultEmployeeNumberID).selectSingle({ 'dateToEmpty': 'dateTo' })])
            .then(res => {
              const currPeriod = res[0]
              const employeePeriod = res[1]

              const currPeriodY = currPeriod.dateFrom.getFullYear()
              const currPeriodM = currPeriod.dateFrom.getMonth()

              let periodFromSet = new Date(currPeriodY, currPeriodM - 13, 1)
              const periodToSet = new Date(currPeriodY, currPeriodM, 0)
              if (periodFromSet.getTime() < employeePeriod.dateFrom.getTime()) {
                periodFromSet = employeePeriod.dateFrom
              }
              if (employeePeriod.dateTo && periodToSet.getTime() < employeePeriod.dateTo.getTime()) {
                periodFromSet = employeePeriod.dateFrom
              }

              fld.setValue(periodFromSet)
              me.record.periodFrom = periodFromSet
              me.attr.periodTo.setValue(periodToSet)
              me.record.dateTo = periodToSet
            })
        } else {
          appHR.getCurrentPeriod(appAC.globalOrganization()).then(res => {
            fld.setValue(res.dateFrom)
            me.record.periodFrom = res.dateFrom
            me.attr.periodTo.setValue(res.dateTo)
            me.record.dateTo = res.dateTo
          })
        }
      },
      headEmployeePositionID: fld => {
        me.setHeadEmployeePositionValue(fld, appAC.globalOrganization())
      },
      employeePositionID: fld => {
        me.setEmployeePositionValue(fld, appAC.globalOrganization())
      },
      includeSubDep: fld => {
        fld.setValue(0)
        me.attr.includeSubDep.setReadOnly(true)
      },
      isIncludeOnlyWoman: fld => {
        fld.setValue(0)
        me.attr.isIncludeOnlyWoman.setReadOnly(false)
      },
      periodFromID: fld => {
        me.setPeriodValue(fld, appAC.globalOrganization())
      },
      periodToID: fld => {
        me.setPeriodToIDValue(fld, appAC.globalOrganization())
      },
      onDate: fld => {
        fld.setValue(appAC.globalApplicationDate())
      },
      dateFrom: fld => {
        fld.setValue(AC.dateService.firstDayOfMonth(new Date()))
      },
      dateTo: fld => {
        fld.setValue(AC.dateService.lastDayOfMonth(new Date()))
      },
      organizationID: fld => {
        me.setOrganizationIDValue(fld, appAC.globalOrganization())
      },
      includeSubOrg: fld => {
        if (!AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')) {
          fld.hide()
          fld.setValue(0)
        } else {
          if (['hr_accrual-sickness', 'hr_report_averageStatistics', 'hr_accrual-FOP', 'hr_accrual-1NC'].includes(me.commandData.reportCode)) {
            fld.setValue(0)
          } else {
            fld.setValue(1)
          }
        }
      },
      objPeriodFrom: fld => {
        me.setObjPeriodFromValue(fld, appAC.globalOrganization())
      },
      objPeriodTo: fld => {
        me.setPeriodValue(fld, appAC.globalOrganization())
      },
      accPeriodCode: fld => {
        UB.Repository('ubm_enum').attrs(['ID', 'code', 'name', 'eGroup'])
          .where('[code]', '=', me.commandData.reportCode === 'hr_accrual-income' ? 'SALARY' : 'CALC')
          .where('[eGroup]', '=', 'HR_ACCPERIOD_TYPE')
          .selectSingle().then(res => {
            if (res) {
              fld.setValueById(res.ID)
            }
          })
      },
      sorterType: fld => {
        fld.setValueById('PERIODCALC')
      },
      year: fld => {
        me.setYearFieldValue(fld, appAC.globalOrganization())
      },
      upMarginValue: fld => {
        const settings = JSON.parse(UB.core.UBLocalStorageManager.getItem('hr_accrualReport_margin') || '{}')
        fld.setValue(settings['upMarginValue'] || 0.00)
      },
      leftMarginValue: fld => {
        const settings = JSON.parse(UB.core.UBLocalStorageManager.getItem('hr_accrualReport_margin') || '{}')
        fld.setValue(settings['leftMarginValue'] || 0.00)
      },
      withSumNotNull: fld => {
        fld.setValue(1)
      },
      withRlNotNull: fld => {
        fld.setValue(1)
      },
      sortByRl: fld => {
        fld.setValue('1')
      },
      withComb: fld => {
        fld.setValue(1)
      },
      showSalaryPeriod: fld => {
        fld.setValue(0)
      },
      joinEmpAccounts: fld => {
        fld.setValue(0)
      },
      showTrfPosition: fld => {
        fld.setValue(0)
      },
      showSumPlus: fld => {
        fld.setValue(0)
      },
      showSumMinus: fld => {
        fld.setValue(0)
      },
      showSumPay: fld => {
        fld.setValue(0)
      },
      showSumBalRes: fld => {
        fld.setValue(0)
      },
      groupReportByDep: fld => {
        if (['hr_accrual-paySummary'].includes(me.commandData.reportCode)) {
          fld.setValue(0)
        } else {
          fld.setValue(1)
        }
      },
      groupDataByDep: fld => {
        fld.setValue(1)
      },
      checkPosDepChange: fld => {
        fld.setValue(0)
      },
      showZeroSumRows: fld => {
        fld.setValue(0)
      },
      reqReport: fld => {
        fld.setValue(1)
      },
      showZeroPayElSumRows: fld => {
        if (['hr_accrual-paySummary'].includes(me.commandData.reportCode)) {
          fld.setValue(0)
        } else {
          fld.setValue(1)
        }
      },
      showOnlyZeroPayElSumRows: fld => {
        if (['hr_accrual-paySummary'].includes(me.commandData.reportCode)) {
          fld.setValue(0)
        } else {
          fld.setValue(1)
        }
      },
      showZeroSumRowsWithAcc: fld => {
        fld.setValue(0)
      },
      showSaldo: fld => {
        fld.setValue(1)
      },
      setOrderBy: fld => {
        if (me.commandData.reportCode === 'hr_accrual-employeeAccrualList') {
          fld.setValueById('2')
        } else {
          fld.setValueById('4')
        }
      },
      showCalcPeriod: fld => {
        fld.setValue(1)
      },
      typeData: fld => {
        fld.setValueById('byPos')
      },
      typeReport: fld => {
        fld.setValueById('type1')
      },
      typeGroupReport: fld => {
        fld.setValueById('2')
      },
      showPersons: fld => {
        fld.setValue()
      },
      showDebtByEmployee: fld => {
        fld.setValue(true)
      },
      groupPay: fld => {
        fld.setValue(true)
      },
      hideZeroRow: fld => {
        fld.setValue(true)
      },
      orgAccrual: fld => {
        fld.setValue(true)
      },
      indAccrual: fld => {
        fld.setValue(true)
      },
      tarifAccrual: fld => {
        fld.setValue(true)
      },
      showWithDateTo: fld => {
        fld.setValue(true)
      },
      showEmptyDateTo: fld => {
        fld.setValue(true)
      }
    }
    me.accrualGrid = me.queryById('accrualGrid')
    me.listUbdetailgrid = me.queryById('listUbdetailgrid')
    me.getForm().getFields().getRange().forEach(item => {
      me.attr[item.name] = item
      !item.allowBlank && !item.hidden && me.requiredAttr.push(item)
    })

    Object.keys(fieldsAfterrender).forEach(item => {
      me.attr[item] && fieldsAfterrender[item](me.attr[item])
    })

    // let wnd = me.up('window')
    me.actionsKeyMap = {}
    me.actionsKeyMap[me.actionId.refresh] = new Ext.util.KeyMap({
      target: me.getEl(),
      // target: (wnd && wnd.getEl()) || me,
      binding: [{
        key: me.hotKeys[me.actionId.refresh].key,
        ctrl: me.hotKeys[me.actionId.refresh].ctrl,
        shift: me.hotKeys[me.actionId.refresh].shift,
        fn: function (keyCode, e) {
          e.stopEvent()
          me.onButtonRefresh(me)
        }
      }] })
    if (me.attr.showTrfPosition) {
      me.attr.showTrfPosition[AC.settings.get('hrTariffingEducational', appAC.globalOrganization()) ? 'show' : 'hide']()
    }

    if (['hr_accrual-generalRegistry', 'hr_accrual-employeeAccrualList'].includes(me.commandData.reportCode)) {
      const ctrl = me.down(`[name=extraColumnsListGR]`)
      if (ctrl) {
        if (ctrl.loadColumns) {
          ctrl.loadColumns(ctrl)
          // loadColumns:  async (grid)
        }
      }
    }

    $App.on('ac:app:organizationChanged', me.changeGlobal)
  }
})

function getStyle () {
  return `
    body {
      background-color: #FFFFFF;
      color: #000000;
      font-family: Times New Roman, Verdana, Arial, Helvetica, sans-serif;
      font-size: 12pt;
      line-height: 1.3;
    }
    .word-wrap {
      word-wrap: break-word;
      hyphens: auto
    }
    td {
      padding: 0 2px 0 2px;
    }
    .mce-pagebreak {
      cursor: default;
      display: block;
      border: 0;
      width: 100%;
      height: 5px;
      border: 1px dashed #666;
      margin-top: 15px;
      page-break-before: always
    }
    table.layout-portrait {
      width:750px;
    }
    table.layout-landscape {
      width:1100px !important;
    }
    @media print {
      .mce-pagebreak {
        border: 0
      }
      a {
        text-decoration: none
      }
      table.layout-landscape {
        width:1300px;
      }
    }
  `
}
