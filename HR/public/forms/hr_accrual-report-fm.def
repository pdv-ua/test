    function getReportTemplateCtrl (labelWidth = 120, fieldLabel = UB.i18n('Назва реєстру')) {
      return Ext.create('UB.ux.form.field.UBComboBox', {
        name: 'reportTemplate',
        fieldLabel: fieldLabel,
        labelWidth: labelWidth,
        width: 840,
        hideEntityItemInContext: true,
        ubRequest: {
          entity: 'ac_reportTemplates',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['ID', 'name', 'reportCode', 'params', 'userID'],
          whereList: {
            organizationID: {
              expression: '[organizationID]',
              condition: 'equal',
              value: appAC.globalOrganization()
            },
            reportCode: {
              expression: '[reportCode]',
              condition: 'equal',
              value: reportCode
            },
            userID: {
              expression: '[userID]',
              condition: 'equal',
              value: $App.connection.userData().userID
            },
            userIDNull: {
              expression: '[userID]',
              condition: 'isNull'
            }
          },
          logicalPredicates: ['([userID] or [userIDNull])']
        },
        listeners: {
          change: function (fld) {
            me.record['reportTemplateName'] = fld.getFieldValue('name')
            if (fld.getFieldValue('params')) {
              const params = (typeof fld.getFieldValue('params') === 'string') ? JSON.parse(fld.getFieldValue('params')) : fld.getFieldValue('params')
              if (me.templateAttrs[reportCode]) {
                me.templateAttrs[reportCode].forEach(attrName => {
                  const ctrl = me.down(`[name=${attrName}]`)
                  if (ctrl) {
                    if (ctrl.setGridValue) {
                      ctrl.setGridValue(ctrl, params[attrName] || [])
                    } else {
                      ctrl[ctrl.setValueById ? 'setValueById' : 'setValue'](params[attrName] || null)
                    }
                  }
                })
              }
            }
            me.clearPrintForm()
          }
        }
      })
    }

