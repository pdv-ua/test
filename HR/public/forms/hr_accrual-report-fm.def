    function getObjPeriodCtrl (name, fieldLabel, labelWidth = 115, width = 340) {
      return {
        xtype: 'ubcombobox',
        allowBlank: false,
        name: name,
        fieldLabel: fieldLabel,
        labelWidth: labelWidth,
        width: width,
        hideEntityItemInContext: true,
        selectOnFocus: true,
        ubRequest: {
          entity: 'hr_dictPeriod',
          fieldList: ['ID', 'name', 'description', 'dateFrom', 'dateTo', 'orgID'],
          orderList: { orderBy: { expression: 'dateFrom', order: 'asc' } }
        },
        pageSize: 50,
        listeners: {
          beforeQuerySend: function () {
            this.store.ubRequest.whereList = {
              orgID: {
                expression: '[orgID]',
                condition: 'equal',
                value: appAC.globalOrganization()
              }
            }
            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
          },
          change: function (fld) {
            const rec = AC.gridUtils.getCurrentRecord(fld)
            me.record[name] = fld.getRawValue()
            me.record[`${name}ID`] = fld.getValue()
            me.record[`${name}DateFrom`] = rec ? rec.get('dateFrom') : null
            me.record[`${name}DateTo`] = rec ? rec.get('dateTo') : null

            if (me.attr.objPeriodFrom && me.attr.objPeriodTo) {
              let relFld = name === 'objPeriodFrom' ? me.attr.objPeriodTo : me.attr.objPeriodFrom

              if (me.record['objPeriodFromDateFrom'] > me.record['objPeriodToDateFrom'] && fld.getValue()) {
                relFld.clearValue()
              }

              if (name === 'objPeriodTo') {
                if (me.attr.departmentID && me.attr.departmentID.getValue()) {
                  let depID = me.attr.departmentID.getValue()
                  if (depID) me.attr.departmentID.clearValue()

                  me.record.objPeriodToDateTo ? me.attr.departmentID.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.objPeriodToDateTo)
                    : me.attr.departmentID.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()

                  me.attr.departmentID.store.load().then(() => {
                    if (depID) {
                      if (me.attr.departmentID.store && me.attr.departmentID.store.data &&
                        me.attr.departmentID.store.data.items.length > 0) {
                        let newDep = me.attr.departmentID.store.data.items.find(el => el.data.mi_data_id === depID)
                        if (newDep) {
                          me.attr.departmentID.setValueById(newDep.data.mi_data_id)
                        }
                      }
                    }
                  })
                  return
                }
              }
            }
            me.clearPrintForm()
            // me.validateFields() ? me.makeHtmlReport() : me.clearPrintForm()
          },
          expand: appHR.periodExpand
        }
      }
    }

