    function getReportDateCtrl (fieldLabel = UB.i18n('Дата звіту'), recordKey = 'reportDate', labelWidth = 120, allowBlank = true) {
      return {
        xtype: 'datefield',
        name: recordKey,
        labelWidth,
        width: labelWidth + 120,
        fieldLabel: fieldLabel,
        allowBlank,
        listeners: {
          /* afterrender: function (crtl) {
            crtl.setValue(appAC.globalApplicationDate())
            me.record.reportDate = appAC.globalApplicationDate()
          }, */
          change: function (fld) {
            me.record[recordKey] = fld.getValue() || appAC.globalApplicationDate()
            me.clearPrintForm()
            // me.validateFields() && me.makeHtmlReport()
          }
        }
      }
    }

    function getEmbassyCtrl () {
      return {
        xtype: 'textarea',
        name: 'embassy',
        labelWidth: 120,
        width: 240,
        rows: 2,
        fieldLabel: UB.i18n('Посольство'),
        listeners: {
