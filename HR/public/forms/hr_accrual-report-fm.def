          whereList: {
            eGroup: {
              expression: '[eGroup]',
              condition: 'equal',
              values: { 'eGroup': 'HR_TYPE_REPORT' }
            }
          }
        },
        listeners: {
          change: function (fld) {
            if (fld.getValue() === 'type3') {
              fld.up('form').down('[name=onDate]').show()
              fld.up('form').down('[name=dateFrom]').hide()
              fld.up('form').down('[name=dateTo]').hide()
            } else {
              fld.up('form').down('[name=onDate]').hide()
              fld.up('form').down('[name=dateFrom]').show()
              fld.up('form').down('[name=dateTo]').show()
            }
            fld.up('form').down('[name=dateFrom]').setAllowBlank(fld.getValue() === 'type3')
            fld.up('form').down('[name=dateTo]').setAllowBlank(fld.getValue() === 'type3')
            fld.up('form').down('[name=onDate]').setAllowBlank(fld.getValue() !== 'type3')
            me.record['typeReport'] = fld.getValue()
            me.record['typeReportName'] = fld.getFieldValue('name')
            me.clearPrintForm()
          }
        }
      })
    }

