/* global appAC appHR Ext $App Blob AC HR UB _ */

exports.formDef = 'HR.accrualReport'
Ext.define('HR.accrualReport', {
  extend: 'Ext.form.Panel',
  requires: [
    'UBS.UBReport',
    'UB.ux.PDFComponent'
  ],
  layout: { type: 'vbox', align: 'stretch' },
  width: 1100,
  height: 600,
  items: [{}],

  actionId: {
    refresh: 'refresh'
  },
  eventId: {
    refresh: 'refresh'
  },
  hotKeys: {
    refresh: {
      key: Ext.EventObject.R,
      ctrl: true,
      shift: false,
      text: ' (Ctrl+R)'
    }
  },

  initComponent: function () {
    const me = this
    me.record = {}
    me.attr = {}
    me.requiredAttr = []
    me.reportType = 'html'
    me.isShowParam = false // true

    let container
    let control
    let items
    let tabs = []

    const { reportCode, reportOptions } = me.commandData
    // let onCalcFunc = () => {}

    me.hideShowAttrs = {
      'hr_accrual-generalRegistry': ['typeGroupReport'],
      'hr_accrual-employeeAccrualList': ['dictMultiGroupID', 'includeSubMultiGroup', 'departmentID', 'includeSubDep']
    }

    me.changeGlobal = () => {
      const globalOrganizationID = appAC.globalOrganization()
      const organizationIDControl = me.down('[name=organizationID]')
      const periodFromIDControl = me.down('[name=periodFromID]')
      const periodToIDControl = me.down('[name=periodToID]')
      const dictFundSourceIDControl = me.down('[name=dictFundSourceID]')
      const dictProgClassIDControl = me.down('[name=dictProgClassID]')
      const yearCtrl = me.down('[name=year]')
      const employeePositionCrtl = me.down('[name=employeePositionID]')
      const headEmployeePositionCrtl = me.down('[name=headEmployeePositionID]')
      const periodIDCrtl = me.down('[name=periodID]')
      const accEmployeePositionCrtl = me.down('[name=accEmployeePositionID]')

      if (organizationIDControl) me.setOrganizationIDValue(organizationIDControl, globalOrganizationID)
      if (periodFromIDControl) me.setPeriodValue(periodFromIDControl, globalOrganizationID)
      if (periodToIDControl) me.setPeriodToIDValue(periodToIDControl, globalOrganizationID)
      if (dictFundSourceIDControl) me.setDictFundSourceIDValue(dictFundSourceIDControl, globalOrganizationID)
      if (yearCtrl) me.setYearFieldValue(yearCtrl, globalOrganizationID)
      if (employeePositionCrtl) me.setEmployeePositionValue(employeePositionCrtl, globalOrganizationID)
      if (headEmployeePositionCrtl) me.setHeadEmployeePositionValue(headEmployeePositionCrtl, globalOrganizationID)
      if (periodIDCrtl) me.setPeriodValue(periodIDCrtl, globalOrganizationID)
      if (accEmployeePositionCrtl) me.setAccEmployeePositionValue(accEmployeePositionCrtl, globalOrganizationID)
      if (dictProgClassIDControl) me.setDictProgClassIDValue(dictProgClassIDControl, globalOrganizationID)

      me.clearPrintForm()
    }
    me.on('destroy', () => {
      $App.un('ac:app:organizationChanged', me.changeGlobal)
    }, me)
    me.setDictFundSourceIDValue = function (crtl, organizationID) {
      crtl.store.ubRequest.orgID = organizationID
    }
    me.setDictProgClassIDValue = function (crtl, organizationID) {
      crtl.store.ubRequest.organizationID = organizationID
    }
    me.setOrganizationIDValue = function (crtl, organizationID) {
      if (!AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')) {
        crtl.setValueById(organizationID)
        crtl.hide()
      } else {
        UB.Repository('hr_organization')
          .attrs('mi_treePath')
          .where('mi_data_id', '=', organizationID)
          .where('state', '=', 'ACTIVE')
          .misc({ __mip_ondate: appAC.globalApplicationDate() })
          .selectSingle().then(org => {
            if (org) {
              AC.viewUtils.setWhereListProperty(crtl, [
                ['mi_treePath', 'startWith', org.mi_treePath],
                ['state', 'equal', 'ACTIVE']
              ], null, ['clearWhereList'])
            }
            crtl.setValueById(organizationID)
          })
      }
    }
    me.setPeriodValue = function (crtl, organizationID) {
      appHR.getCurrentPeriod(organizationID).then(res => {
        if (res && res.ID) crtl.setValueById(res.ID)
      })
    }
    me.setPeriodToIDValue = function (crtl, organizationID) {
      appHR.getCurrentPeriod(organizationID).then(curPeriod => {
        if (['hr_accrual-workReport'].includes(me.commandData.reportCode)) {
          if (curPeriod) {
            if (curPeriod.dateFrom.getMonth() !== 0) {
              const beginOfYear = AC.dateService.firstDayOfYear(curPeriod.dateFrom)
              appHR.getPeriodOnDate(organizationID, beginOfYear).then(res => {
                if (res && res.ID) {
                  me.attr.periodFromID.setValueById(res.ID)
                }
              })
            }
          }
        }
        if (curPeriod && curPeriod.ID) crtl.setValueById(curPeriod.ID)
      })
    }
    me.setYearFieldValue = function (crtl, organizationID) {
      appHR.getCurrentPeriod(organizationID).then(res => {
        crtl.setValue(res.dateTo.getFullYear())
        me.fillWhereExperienceCtrl(true)
      })
    }
    me.setObjPeriodFromValue = function (crtl, organizationID) {
      UB.Repository('hr_dictPeriod').attrs(['ID', 'dateFrom', 'dateTo', 'pYear'])
        .where('orgID', '=', organizationID)
        .where('isCurrent', '=', true)
        .selectSingle().then(response => {
          if (response) {
            UB.Repository('hr_dictPeriod').attrs(['ID', 'dateFrom', 'dateTo', 'pYear'])
              .where('orgID', '=', organizationID)
              .where('pYear', '=', response.pYear)
              .orderBy('dateFrom', 'asc')
              .selectSingle().then(resp => {
                if (resp) {
                  crtl.setValueById(resp.ID)
                }
              })
          }
        })
    }
    me.setEmployeePositionValue = function (crtl, organizationID) {
      if (me.defaultEmployeeNumberID) {
        UB.Repository('hr_employeePositionS')
          .attrs('ID')
          .where('employeeNumberID', '=', me.defaultEmployeeNumberID)
          .where('organizationID', '=', organizationID)
          .orderByDesc('dateTo')
          .selectScalar().then(res => {
            res && crtl.setValueById(res)
          })
      }
    }
    me.setAccEmployeePositionValue = function (crtl, organizationID) {
      const globalDate = appAC.globalApplicationDate()
      UB.Repository('hr_employeePositionS').attrs('ID').where('positionID', 'in', UB.Repository('hr_orgRespPosition')
        .attrs(['positionID'])
        .where('organizationID', '=', organizationID)
        .where('respPosition', '=', 'accChief')
        .where('dateFrom', '<=', globalDate)
        .where('dateTo', '>=', globalDate)
        .where('mi_deleteDate', '>=', '#maxdate'))
        .where('dateFrom', '<=', globalDate)
        .where('dateTo', '>=', globalDate)
        .selectScalar().then(res => {
          res && crtl.setValueById(res)
        })
    }
    me.setHeadEmployeePositionValue = function (crtl, organizationID) {
      const globalDate = appAC.globalApplicationDate()
      UB.Repository('hr_employeePositionS').attrs('ID').where('positionID', 'in', UB.Repository('hr_orgRespPosition')
        .attrs(['positionID'])
        .where('organizationID', '=', organizationID)
        .where('respPosition', '=', 'mainChief')
        .where('dateFrom', '<=', globalDate)
        .where('dateTo', '>=', globalDate)
        .where('mi_deleteDate', '>=', '#maxdate'))
        .where('dateFrom', '<=', globalDate)
        .where('dateTo', '>=', globalDate)
        .selectScalar().then(res => {
          res && crtl.setValueById(res)
        })
    }

    me.validateFields = function () {
      let isValid = true

      me.requiredAttr.forEach(field => {
        isValid = isValid && field.validate()
      })
      return isValid
    }

    me.fillWhereExperienceCtrl = function (setLocalExpType = false) {
      let expID = me.attr.dictExperienceID.getValue()
      // if (expID) me.attr.dictExperienceID.clearValue()

      let globalDate = appAC.globalApplicationDate()
      let onDate = globalDate > me.record.periodTo ? me.record.periodTo
        : globalDate < me.record.periodFrom ? me.record.periodFrom
          : appAC.globalApplicationDate()
      // console.log('* onDate', onDate)

      if (me.record.employeeNumberID) {
        $App.connection.run({
          entity: 'hr_employeeExperience',
          method: 'loadEmployeeExperience',
          execParams: {
            employeeNumberID: me.record.employeeNumberID,
            onDate: onDate,
            organizationID: appAC.globalOrganization()
          }
        }).then(function (result) {
          let experience = JSON.parse(result.experience)
          experience = experience.filter(exp => exp.totalDays > 0)
          // if (expID) me.attr.dictExperienceID.clearValue()
          let dexps = experience && experience.length > 0 ? experience.map(el => el.dictExperienceID).filter((el, index, arr) => arr.indexOf(el) === index) : null
          if (dexps) {
            me.attr.dictExperienceID.store.ubRequest.whereList = {
              dictExp: {
                expression: '[ID]',
                condition: 'in',
                value: dexps
              }
            }

            me.attr.dictExperienceID.store.load().then(resLoad => {
              if (expID) {
                if (me.attr.dictExperienceID.store && me.attr.dictExperienceID.store.data &&
                  me.attr.dictExperienceID.store.data.items.length > 0) {
                  let newExp = me.attr.dictExperienceID.store.data.items.find(el => el.data.ID === expID)
                  // if (newExp) {
                  //   me.attr.dictExperienceID.setValueById(newExp.data.ID)
                  // }
                  if (!newExp) {
                    me.attr.dictExperienceID.clearValue()
                  }
                } else {
                  me.attr.dictExperienceID.clearValue()
                }
              }
              if (setLocalExpType) {
                const localExpTypeID = JSON.parse(UB.core.UBLocalStorageManager.getItem('infoCardExpType'))
                me.attr.dictExperienceID.setValueById(localExpTypeID)
              }
            })
          }
        })
      } else {
        me.attr.dictExperienceID.store.ubRequest.whereList = {}
        me.attr.dictExperienceID.store.load().then(res => {
          if (setLocalExpType) {
            const localExpTypeID = JSON.parse(UB.core.UBLocalStorageManager.getItem('infoCardExpType'))
            me.attr.dictExperienceID.setValueById(localExpTypeID)
          }
        })
      }
    }

    function getAccEmployeePositionCtrl (fieldLabel = UB.i18n('Головний бухгалтер'), width = 640) {
      let orgID = AC.settings.get('hrUseSignersParentOrg', appAC.globalOrganization())
      if (!orgID) orgID =appAC.globalOrganization()
      return Ext.create('HR.controls.empPositionCombobox', {
        name: 'accEmployeePositionID',
        fieldLabel: fieldLabel,
        labelWidth: 120,
        width: width,
        valueField: 'ID',
        displayField: 'description',
        disableModifyEntity: true,
        disableContextMenu: true,
        ubRequest: {
          entity: 'hr_employeePositionS',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['ID', 'description', 'employeeNumberID'],
          whereList: {}
        },
        listeners: {
          beforeQuerySend: function () {
            let issueDate = me.record.issueDate
            this.store.ubRequest.whereList = {
              orgID: {
                expression: '[organizationID]',
                condition: 'equal',
                value: orgID
              },
              dateTo: { expression: '[dateTo]', condition: '>=', value: issueDate ? AC.dateService.shiftDate(issueDate) : appAC.globalApplicationDate() },
              dateFrom: { expression: '[dateFrom]', condition: '<=', value: issueDate ? AC.dateService.shiftDate(issueDate) : appAC.globalApplicationDate() }
            }

            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
          },
          change: function (fld) {
            const rec = AC.gridUtils.getCurrentRecord(fld)
            me.record.accEmployeePositionID = fld.getValue()
            me.record.accEmployeeNumberID = rec ? rec.get('employeeNumberID') : null
            me.clearPrintForm()
            // me.validateFields() && me.makeHtmlReport()
          }
        }
      })
    }

    function getHeadEmployeePositionCtrl (fieldLabel = UB.i18n('Керівник')) {

      let orgID = AC.settings.get('hrUseSignersParentOrg', appAC.globalOrganization())
      if (!orgID) orgID =appAC.globalOrganization()

      return Ext.create('HR.controls.empPositionCombobox', {
        name: 'headEmployeePositionID',
        fieldLabel: fieldLabel,
        disableModifyEntity: true,
        disableContextMenu: true,
        labelWidth: 120,
        width: 640,
        valueField: 'ID',
        displayField: 'description',
        ubRequest: {
          entity: 'hr_employeePositionS',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['ID', 'description', 'employeeNumberID'],
          whereList: {}
        },
        listeners: {
          beforeQuerySend: function () {
            let issueDate = me.record.issueDate
            this.store.ubRequest.whereList = {
              orgID: {
                expression: '[organizationID]',
                condition: 'equal',
                value: orgID
              },
              dateTo: { expression: '[dateTo]', condition: '>=', value: issueDate ? AC.dateService.shiftDate(issueDate) : appAC.globalApplicationDate() },
              dateFrom: { expression: '[dateFrom]', condition: '<=', value: issueDate ? AC.dateService.shiftDate(issueDate) : appAC.globalApplicationDate() }
            }

            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
          },
          change: function (fld) {
            const rec = AC.gridUtils.getCurrentRecord(fld)
            me.record.headEmployeePositionID = fld.getValue()
            me.record.headEmployeeNumberID = rec ? rec.get('employeeNumberID') : null
            me.clearPrintForm()
            // me.validateFields() && me.makeHtmlReport()
          }
        }
      })
    }

    function getEmployeePositionCtrl ({ isNotCheckPeriod = false, dateFrom = 'periodFrom', dateTo = 'periodTo', labelWidth = 120,
      allowBlank = false, isOnDateTo = false, fieldLabel = UB.i18n('Працівник'), width = 640, isOnFromTo = false,
      entityName = 'hr_employeePositionSR', showDismissed = false, limitedAccess = false, addWorkerTypeCondition = false,
      isDateFromToNow = false, mainWorkPlace = false
    }) {
      return Object.assign({
        xtype: 'ubcombobox',
        name: 'employeePositionID',
        fieldLabel: fieldLabel,
        labelWidth: labelWidth,
        width: width,
        hideEntityItemInContext: true,
        disableContextMenu: true,
        selectOnFocus: true,
        allowBlank: allowBlank,
        readOnly: !!me.defaultEmployeeNumberID,
        ubRequest: {
          entity: entityName,
          fieldList: ['ID', 'description', 'employeeNumberID', 'employeeID']
        },
        listeners: {
          beforeQuerySend: function () {
            this.store.ubRequest.whereList = {
              orgID: {
                expression: '[organizationID]',
                condition: 'equal',
                value: appAC.globalOrganization()
              }
            }
            if (mainWorkPlace) {
              Object.assign(this.store.ubRequest.whereList, {
                empWorkPlace: {
                  expression: '[employeeNumberID.empWorkPlace]',
                  condition: 'isNull'
                }
              })
            }

            let issueDate = me.record.issueDate
            if (showDismissed) {
              Object.assign(this.store.ubRequest.whereList, {
                dateTo: {
                  expression: '[dateTo]=[maxDateTo]',
                  condition: 'custom'
                }
              })
            } else if (isDateFromToNow) {
              Object.assign(this.store.ubRequest.whereList, {
                dateTo: {
                  expression: '[dateTo]',
                  condition: '>=',
                  value: me.record[dateFrom] ? AC.dateService.shiftDate(me.record[dateFrom]) : appAC.globalApplicationDate()
                },
                dateFrom: {
                  expression: '[dateFrom]',
                  condition: '<=',
                  value: appAC.globalApplicationDate()
                }
              })
            } else {
              Object.assign(this.store.ubRequest.whereList, ((me.record.periodID || (me.record[dateFrom] && me.record[dateTo])) &&
                !isNotCheckPeriod && !isOnFromTo) ? {
                  dateTo: {
                    expression: '[dateTo]',
                    condition: '>=',
                    value: AC.dateService.shiftDate(me.record[dateFrom])
                  },
                  dateFrom: {
                    expression: '[dateFrom]',
                    condition: '<=',
                    value: AC.dateService.shiftDate(me.record[dateTo])
                  }
                } : isNotCheckPeriod ? {
                  dateTo: {
                    expression: '[dateTo]',
                    condition: '>=',
                    value: issueDate ? AC.dateService.shiftDate(issueDate) : appAC.globalApplicationDate()
                  },
                  dateFrom: {
                    expression: '[dateFrom]',
                    condition: '<=',
                    value: issueDate ? AC.dateService.shiftDate(issueDate) : appAC.globalApplicationDate()
                  }
                } : isOnDateTo ? {
                  dateTo: {
                    expression: '[dateTo]',
                    condition: '>=',
                    value: me.record[dateTo] ? AC.dateService.shiftDate(me.record[dateTo]) : appAC.globalApplicationDate()
                  },
                  dateFrom: {
                    expression: '[dateFrom]',
                    condition: '<=',
                    value: me.record[dateTo] ? AC.dateService.shiftDate(me.record[dateTo]) : appAC.globalApplicationDate()
                  }
                } : { noData: { expression: '[ID]', condition: '<=', value: -1 }
                })
            }
            if (me.attr.departmentID) {
              let depID = me.attr.departmentID.getValue()
              let deptIDs = [depID]
              const rec = AC.gridUtils.getCurrentRecord(me.attr.departmentID)

              if (me.attr.includeSubDep && me.attr.includeSubDep.getValue() && depID) {
                let departmentsQuery = UB.Repository('hr_department')
                  .attrs(['mi_data_id'])
                  .where('orgID', '=', appAC.globalOrganization())
                  .where('state', '=', 'ACTIVE')
                  .where('mi_treePath', 'startsWith', rec.get('mi_treePath'))
                  .groupBy('mi_data_id')

                me.record.objPeriodToDateTo ? departmentsQuery.__mip_ondate = AC.dateService.shiftDate(me.record.objPeriodToDateTo)
                  : departmentsQuery.__mip_ondate = appAC.globalApplicationDate()

                departmentsQuery.selectAsObject().then(departments => {
                  if (departments.length) {
                    deptIDs = departments.map(o => o.mi_data_id)
                  } else {
                    deptIDs = [depID]
                  }

                  Object.assign(this.store.ubRequest.whereList,
                    { department: { expression: '[departmentID]', condition: 'in', value: deptIDs } }
                  )
                  // if (!this.whereListIsSet) this.whereListIsSet = true
                  // else this.store.reload()
                  this.store.reload()
                })
              } else if (me.attr.includeSubDep && !me.attr.includeSubDep.getValue() && depID) {
                Object.assign(this.store.ubRequest.whereList,
                  { department: { expression: '[departmentID]', condition: '=', value: depID } }
                )
              }
            }
            if (limitedAccess) {
              if (!AC.entityUtils.verifyRightsMethod('hr_employeeNumber', 'employeeLimitedAccess')) {
                Object.assign(this.store.ubRequest.whereList,
                  { limitedAccess: { expression: '[employeeNumberID.limitedAccess]', condition: '=', value: 0 } }
                )
              }
            }

            if (addWorkerTypeCondition) {
              Object.assign(this.store.ubRequest.whereList, {
                workerType: {
                  expression: '[workerType]',
                  condition: `equal`,
                  values: { 'workerType': '4' }
                }
              })
            }

            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
          },
          change: function (fld) {
            const rec = AC.gridUtils.getCurrentRecord(fld)
            me.record.employeePosRaw = fld.getRawValue()
            me.record.employeePositionID = fld.getValue()
            me.record.employeeNumberID = rec ? rec.get('employeeNumberID') : null
            me.record.employeeID = rec ? rec.get('employeeID') : null

            if (me.attr.dictExperienceID) { me.fillWhereExperienceCtrl() }

            me.clearPrintForm()
            // me.validateFields() && me.makeHtmlReport()
          }
        }
      }, width === 0 ? { flex: 1 } : {})
    }

    function getYearCtrl (width = 200, labelWidth = 120, allowBlank = false) {
      return {
        xtype: 'numberfield',
        name: 'year',
        fieldLabel: UB.i18n('Рік'),
        allowBlank,
        minValue: 2000,
        maxValue: 9999,
        vtype: 'numberValidator',
        labelWidth: labelWidth,
        width: width,
        listeners: {
          change: function (fld) {
            me.record.year = fld.getValue()
            me.record.periodFrom = AC.dateService.truncTimeToUtcNull(new Date(me.record.year, 0, 1, 0, 0, 0))
            me.record.periodTo = AC.dateService.truncTimeToUtcNull(new Date(me.record.year, 11, 31, 0, 0, 0))

            if (me.attr.departmentID && me.attr.departmentID.getValue()) {
              let depID = me.attr.departmentID.getValue()
              if (depID) me.attr.departmentID.clearValue()

              me.record.periodTo ? me.attr.departmentID.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.periodTo)
                : me.attr.departmentID.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()

              me.attr.departmentID.store.load().then(() => {
                if (depID) {
                  if (me.attr.departmentID.store && me.attr.departmentID.store.data &&
                    me.attr.departmentID.store.data.items.length > 0) {
                    let newDep = me.attr.departmentID.store.data.items.find(el => el.data.mi_data_id === depID)
                    if (newDep) {
                      me.attr.departmentID.setValueById(newDep.data.mi_data_id)
                    }
                  }
                }
              })
              return
            }

            if (!me.defaultEmployeeNumberID && me.attr.employeePositionID && me.attr.employeePositionID.getValue()) {
              let empID = me.attr.employeePositionID.getValue()
              if (empID) me.attr.employeePositionID.clearValue()
              Object.assign(me.attr.employeePositionID.store.ubRequest, me.record.periodTo ? {
                whereList: {
                  dateTo: {
                    expression: '[dateTo]',
                    condition: '>=',
                    value: me.record.periodFrom ? AC.dateService.shiftDate(me.record.periodFrom) : appAC.globalApplicationDate()
                  },
                  dateFrom: {
                    expression: '[dateFrom]',
                    condition: '<=',
                    value: me.record.periodTo ? AC.dateService.shiftDate(me.record.periodTo) : appAC.globalApplicationDate()
                  }
                }
              } : { whereList: { noData: { expression: '[ID]', condition: '<=', value: -1 } } })
              me.attr.employeePositionID.store.load().then(() => {
                if (empID) {
                  if (me.attr.employeePositionID.store && me.attr.employeePositionID.store.data &&
                    me.attr.employeePositionID.store.data.items.length > 0) {
                    let newEmp = me.attr.employeePositionID.store.data.items.find(el => el.data.ID === empID)
                    if (newEmp) {
                      me.attr.employeePositionID.setValueById(newEmp.data.ID)
                    }
                  }
                }
              })
              return
            }

            if (me.attr.dictExperienceID && me.attr.employeePositionID && me.attr.employeePositionID.getValue()) {
              me.fillWhereExperienceCtrl()
            }
            me.clearPrintForm()
          }
        }
      }
    }

    function getDictExperienceCtrl (width = 640, labelWidth = 120, allowBlank = false) {
      return {
        xtype: 'ubcombobox',
        name: 'dictExperienceID',
        fieldLabel: UB.i18n('Вид стажу'),
        labelWidth: labelWidth,
        width: width,
        // hideEntityItemInContext: true,
        // disableContextMenu: true,
        // selectOnFocus: true,
        allowBlank: allowBlank,
        ubRequest: {
          entity: 'hr_dictExperience',
          fieldList: ['ID', 'name', 'code']
        },
        listeners: {
          beforeQuerySend: function () {
            // me.fillWhereExperienceCtrl()
          },
          change: function (fld) {
            me.record.dictExperienceID = fld.getValue()
            if (me.record.dictExperienceID) UB.core.UBLocalStorageManager.setItem('infoCardExpType', me.record.dictExperienceID)
            me.clearPrintForm()
          }
        }
      }
    }

    function getPeriodCtrl (labelWidth = 115, cfg) {
      cfg = cfg || {}
      return {
        layout: { type: 'hbox' },
        items: [
          {
            xtype: 'label',
            text: cfg.label || UB.i18n('Період:'),
            cls: 'x-form-item-label',
            margin: '8 0 0 15',
            width: labelWidth
          },
          {
            xtype: 'button',
            text: '<',
            margin: '2 0 0 0',
            tooltip: UB.i18n('Попередній період'),
            width: 30,
            handler: () => {
              const priorID = me.attr.periodID.getFieldValue('priorPeriodID')
              if (priorID) {
                me.attr.periodID.setValueById(priorID)
              }
            },
            hidden: cfg.hidePriorBtn
          },
          {
            xtype: 'ubcombobox',
            allowBlank: false,
            name: 'periodID',
            fieldLabel: '',
            labelWidth: 130,
            margin: '2 0 0 5',
            pageSize: 50,
            width: cfg.width || 300,
            hideEntityItemInContext: true,
            disableContextMenu: true,
            selectOnFocus: true,
            ubRequest: {
              entity: 'hr_dictPeriod',
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'priorPeriodID', 'nextPeriodID', 'name'],
              orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
            },
            listeners: {
              beforeQuerySend: function () {
                this.store.ubRequest.whereList = {
                  orgID: {
                    expression: '[orgID]',
                    condition: 'equal',
                    value: appAC.globalOrganization()
                  }
                }
                if (!this.whereListIsSet) this.whereListIsSet = true
                else this.store.reload()
              },
              change: function (fld) {
                me.record.periodRaw = fld.getFieldValue('name')
                me.record.periodID = fld.getValue()
                const rec = AC.gridUtils.getCurrentRecord(fld)
                me.record.periodFrom = rec ? rec.get('dateFrom') : null
                me.record.periodTo = rec ? rec.get('dateTo') : null

                if (me.attr.departmentID && me.attr.departmentID.getValue()) {
                  let depID = me.attr.departmentID.getValue()
                  if (depID) me.attr.departmentID.clearValue()

                  me.record.periodTo ? me.attr.departmentID.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.periodTo)
                    : me.attr.departmentID.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()

                  me.attr.departmentID.store.load().then(() => {
                    if (depID) {
                      if (me.attr.departmentID.store && me.attr.departmentID.store.data &&
                        me.attr.departmentID.store.data.items.length > 0) {
                        let newDep = me.attr.departmentID.store.data.items.find(el => el.data.mi_data_id === depID)
                        if (newDep) {
                          me.attr.departmentID.setValueById(newDep.data.mi_data_id)
                        }
                      }
                    }
                  })
                  return
                }
                me.clearPrintForm()
                // me.validateFields() && me.makeHtmlReport()
              },
              expand: appHR.periodExpand
            }
          },
          {
            xtype: 'button',
            text: '>',
            margin: '2 15 0 0',
            tooltip: UB.i18n('Наступний період'),
            width: 30,
            handler: () => {
              const nextID = me.attr.periodID.getFieldValue('nextPeriodID')
              if (nextID) {
                me.attr.periodID.setValueById(nextID)
              }
            },
            hidden: cfg.hideNextBtn
          }
        ]
      }
    }

