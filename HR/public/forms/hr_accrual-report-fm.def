                  if (depID) me.attr.departmentID.clearValue()

                  me.record.periodToDateTo ? me.attr.departmentID.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.periodToDateTo)
                    : me.attr.departmentID.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()

                  me.attr.departmentID.store.load().then(() => {
