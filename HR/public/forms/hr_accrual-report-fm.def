    function getDateFieldCtrl (name = 'datefield', fieldLabel = UB.i18n('Дата'), labelWidth = 120, width = 300, fieldToClear) {
      return {
        xtype: 'datefield',
        name: name,
        labelWidth,
        width,
        fieldLabel: fieldLabel,
        listeners: {
          change: function (fld) {
            const value = AC.dateService.shiftDate(fld.getValue())
            me.record[name] = value
            if (value && fieldToClear) {
              const ctrl = me.down(`[name=${fieldToClear}]`)
              if (ctrl && ctrl.getValue()) {
                ctrl.setValue()
              }
            }
            me.clearPrintForm()
          }
        }
      }
    }

    function getCheckBoxCtrl (name = 'showCheckbox', fieldLabel, labelWidth = 475) {
      return {
        xtype: 'checkbox',
        fieldLabel: fieldLabel,
        labelWidth: labelWidth,
        name: name,
        listeners: {
          change: function (ctrl, value) {
            me.record[name] = value
            me.clearPrintForm()
          }
        }
      }
    }

