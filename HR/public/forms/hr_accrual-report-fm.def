              },
              change: function (fld) {
                me.record.periodToRaw = fld.getFieldValue('name')
                me.record.periodToID = fld.getValue()
                const rec = AC.gridUtils.getCurrentRecord(fld)
                me.record.periodToDateFrom = rec ? AC.dateService.shiftDate(rec.get('dateFrom')) : null
                me.record.periodToDateTo = rec ? AC.dateService.shiftDate(rec.get('dateTo')) : null

                if (!me.record.periodFromID) {
                  me.attr.periodFromID.setValueById(fld.getValue())
                } else if (me.record.periodToID && me.record.periodToDateFrom < me.record.periodFromDateFrom) {
                  me.attr.periodFromID.setValue()
                }

                if (me.attr.departmentID && me.attr.departmentID.getValue()) {
