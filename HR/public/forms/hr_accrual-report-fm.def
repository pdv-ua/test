            } else if (me.attr.objPeriodTo) {
              me.record.objPeriodToDateTo ? this.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.objPeriodToDateTo)
                : this.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()
            } else if (me.attr.year) {
              me.record.periodTo ? this.store.ubRequest.__mip_ondate = AC.dateService.shiftDate(me.record.periodTo)
                : this.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()
            } else {
              this.store.ubRequest.__mip_ondate = appAC.globalApplicationDate()
            }
            const includeSubOrg = me.down('[name=includeSubOrg]') ? me.down('[name=includeSubOrg]').getValue() : false
            const orgCtrl = (me.down('[name=organizationID]') && me.down('[name=organizationID]').getValue()) ? me.down('[name=organizationID]').getValue() : appAC.globalOrganization()

            if (includeSubOrg) {
              this.store.ubRequest.whereList = {
                miTreePath: {
                  expression: '[mi_treePath]',
                  condition: 'like',
                  value: `%/${orgCtrl}/%`
                },
                isActive: {
                  expression: '[state]',
                  condition: 'equal',
                  value: 'ACTIVE'
                }
              }
            } else {
              this.store.ubRequest.whereList = {
                orgID: {
                  expression: '[orgID]',
                  condition: 'equal',
                  value: orgCtrl
                },
                isActive: {
                  expression: '[state]',
                  condition: 'equal',
                  value: 'ACTIVE'
                }
              }
            }
            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
          },
          change: function (fld) {
            if (fld.getValue()) {
              me.attr.includeSubDep && me.attr.includeSubDep.setValue(false)
              me.attr.departmentID && me.attr.departmentID.setValue()

              me.attr.includeSubMultiGroup && me.attr.includeSubMultiGroup.setValue(false)
              me.attr.dictMultiGroupID && me.attr.dictMultiGroupID.setValue()
            }
            me.record.facultyID = fld.getValue()
            me.record.facultyName = fld.getRawValue()
            me.clearPrintForm()
          }
        }
      })
    }

    function setTabVisible (me, tabName, visible) {
      const tabs = me.down('[itemId=cmpTabPanel]')
      const child = tabs.child(`[itemId=${tabName}]`)
      const { tab } = child
      if (tab) {
        if (visible) {
          tab.show()
        } else {
          const activeTab = tabs.getActiveTab()
          if (activeTab.name === tabName) {
            tabs.setActiveTab(0)
          }
          tab.hide()
        }
      }
    }

    function getGroupReportCtrl (labelWidth = 115) {
      return {
        xtype: 'ubcombobox',
        name: 'groupReportID',
        fieldLabel: UB.i18n('Протокол групи звітів'),
        labelWidth: labelWidth,
        width: 640,
        gridFieldList: ['ID', 'name'],
        valueField: 'ID',
        displayField: 'name',
        allowBlank: false,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
        disableModifyEntity: true,
        ubRequest: {
          entity: 'hr_groupReport',
          fieldList: ['ID', 'name'],
          orderList: { orderBy: { expression: 'code' } }
        },
        listeners: {
          change: (fld) => {
            const groupReportID = fld.getValue()
            me.record['groupReportID'] = groupReportID
            me.clearPrintForm()
            if (groupReportID) {
              UB.Repository('hr_groupReportDt')
                .attrs('dictReportID.code')
                .where('groupReportID', '=', groupReportID)
                .where('dictReportID.showExtraParam', '=', 1)
                .selectAsArrayOfValues()
                .then(codes => {
                  setTabVisible(me, 'tabReportExtra', codes.includes('hr_accrual-timeCost'))
                  setTabVisible(me, 'tabReportListDebtEmployeesExtra', codes.includes('hr_accrual-debtEmployees'))
                })
            } else {
              setTabVisible(me, 'tabReportExtra', false)
              setTabVisible(me, 'tabReportListDebtEmployeesExtra', false)
            }
          }
        }
      }
    }
    function getReportTitleCtrl (labelWidth = 120, width = 640, value) {
      return {
        xtype: 'textfield',
        name: 'reportTitle',
        labelWidth: labelWidth,
        width: width,
        fieldLabel: UB.i18n('Назва'),
        value: value || UB.i18n('Назва'),
        allowBlank: false,
        listeners: {
          change: function (fld) {
            me.record.reportTitle = fld.getValue()
          }
        }
      }
    }

    function getFormStudyCtrl (labelWidth = 115, width = 640) {
      return Ext.create('UB.ux.form.field.UBComboBox', {
