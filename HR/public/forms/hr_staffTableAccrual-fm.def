              onBeforeEdit: (control, context) => {
                const me = context.grid.up('form')
                if (['ON_RECONCILATION', 'RECONCILED', 'POSTED'].includes(me.record.get('orderState'))) {
                  return false
                }
                me.setIsDirty(true)
              },
              edit: function (control, context) {
                context.store.snapshot.each(record => {
                  if (record.get('staffTableAccrualID') === context.record.get('ID')) {
                    record.set('accrualSum', context.record.get('accrualSum'))
                  }
                })
                /* const plugin = context.grid.getPlugin('rowexpander')
                plugin.collapseRow(context.rowIdx)
                plugin.expandRow(context.rowIdx) */
              },
              getRowClass: () => {},
              fields: [
                { name: 'ID' },
                { name: 'staffTableID' },
                { name: 'mi_modifyDate' },
                { name: 'staffTableAccrualID' },
                { name: 'positionID' },
                { name: 'dictFundSourceID' },
                { name: 'employeePositionID' },
                { name: 'employeePositionID.employeeID.fullFIO' },
                { name: 'positionID.fullName' },
                {
                  name: 'positionType',
                  columnConfig: {
                    dataType: 'Enum',
                    enumGroup: 'HR_POSITION_TYPE',
                    text: UB.i18n('Тип посади'),
                    sortByRendered: true,
                    sortBy: 'String',
                    filterBy: 'string',
                    width: 200
                  }
                },
                {
                  name: 'dictPositionID.name',
                  columnConfig: {
                    text: UB.i18n('Назва посади'),
                    sortBy: 'String',
                    filterBy: 'string',
                    flex: 1
                  }
                },
                { name: 'dictPositionID' },
                {
                  name: 'dictTarifCoeffID.description',
                  columnConfig: {
                    text: UB.i18n('Тарифний розряд'),
                    sortBy: 'String',
                    filterBy: 'string',
                    width: 200
                  }
                },
                { name: 'dictTarifCoeffID' },
                {
                  name: 'dictStatePayID.description',
                  columnConfig: {
                    text: UB.i18n('Група оплати праці'),
                    filterBy: 'string',
                    width: 200
                  }
                },
                { name: 'dictStatePayID' },
                {
                  name: 'quantity',
                  columnConfig: {
                    text: UB.i18n('Кількість посад'),
                    width: 100,
                    floatFormat: 2,
                    align: 'right',
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                },
                {
                  name: 'previousAccrualSum',
                  columnConfig: {
                    text: UB.i18n('Оклад'),
                    width: 150,
                    floatFormat: 2,
                    align: 'right',
                    sortBy: 'Number',
                    filterBy: 'float'
                  }
                },
                {
                  name: 'accrualSum',
                  columnConfig: {
                    text: UB.i18n('Новий оклад'),
                    width: 150,
                    floatFormat: 2,
                    align: 'right',
                    sortBy: 'Number',
                    filterBy: 'float',
                    editor: {
                      dataType: 'Currency',
                      decimalPrecision: 2,
                      minValue: 0
                    }
                  }
                }
              ],
              enableExpandableRows: true,
              expandedRowConfig: {
                rowBodyTpl: ['<div id="NestedGridRow-{ID}" ></div>'],
                onExpandBody: function (rowNode, record, body, rowIndex) {
                  const me = this.up('form')
                  me.onExpandGridRow(me, rowNode, record, body, rowIndex)
                }
              },
              customToolBarActions: [
                {
                  xtype: 'button',
                  scale: 'medium',
                  iconCls: 'fas fa-file-excel',
                  tooltip: UB.i18n('Сформувати XLSX'),
                  cls: 'green-action',
                  handler: (btn) => {
                    const me = btn.up('form')
                    me.exportXLSX(me)
                  }
                },
                {
                  xtype: 'button',
                  scale: 'medium',
                  iconCls: 'fas fa-sort-amount-down',
                  tooltip: UB.i18n('Встановити оклади за тарифом'),
                  hidden: true,
                  cls: 'add-new-action',
                  handler: (btn) => {
                    const me = btn.up('form')
                    me.setAccrualSumByTarif(me)
                  }
                }
                /*,
                {
                  xtype: 'textfield',
                  name: 'searchText',
                  flex: 1,
                  emptyText: UB.i18n('Пошук'),
                  margin: '2 15 0 30',
                  listeners: {
                    change: (ctrl, value) => {
                      const me = ctrl.up('form')

                      // if (value && value !== '') {
                      me.attr.staffTableAccrual.getStore().filter(me.approvedFilter)
                      // } else {
                      //   me.attr.staffTableAccrual.getStore().removeFilter(me.approvedFilter)
                      // }

                      if (me.attr.staffTableAccrual.getStore().filters.items.length > 1) {
                        me.attr.staffTableAccrual.getStore().removeFilter(me.attr.staffTableAccrual.getStore().filters.items[1])
                      }
                      if (value && value !== '') {
                        me.attr.staffTableAccrual.getStore().addFilter(row =>
                          (row.get('dictPositionID.name') || '').toUpperCase().includes(me.attr.searchText.getValue().toUpperCase()) ||
                          (row.get('positionType') || '').toUpperCase().includes(me.attr.searchText.getValue().toUpperCase())
                        )
                      }
                    }
                  }
                } */
              ]
            }
          ]
        },
        HR.reportTab.getTabConfig({ getRepName: 'getReportName', repTabIndex: 2, addExcel: true }),
        {
          title: UB.i18n('Маршрут'),
          autoScroll: true,
          layout: 'fit',
          flex: 1,
          items: [
            {
              xtype: 'recpanel',
              name: 'recpanel'
            }
          ]
        },
        {
          title: UB.i18n('Історія змін'),
          autoScroll: true,
          layout: 'fit',
          flex: 1,
          items: [
            {
              name: 'stateHistory',
              xtype: 'ubdetailgrid',
              disableSearchBar: true,
              readOnly: true,
              flex: 1,
              entityConfig: {
                entity: 'hr_orderStateHistory',
                method: 'select',
                fieldList: [
                  { name: 'actionType' },
                  { name: 'comments' },
                  { name: 'orderState' },
                  { name: 'userID.name', description: UB.i18n('Користувач') },
                  { name: 'actionDateTime' }
                ]
              },
              masterFields: ['ID'],
              detailFields: ['orderID'],
              cmpInitConfig: {
                onItemDblClick: () => {}
              }
            }
          ]
        }
      ]
    }
  ]
}
