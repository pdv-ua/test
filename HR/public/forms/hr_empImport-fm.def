function removeData (me, ids, dictEntityName, currentIndex = 0, chunkSize = 1000) {
  let allErrors = []
  $App.connection.run({
    entity: 'ac_service',
    method: 'removeData',
    params: {
      type: 'emp',
      entityName: dictEntityName,
      data: ids
    }
  }).then(({ state, errors }) => {
    errors = errors && JSON.parse(errors)
    if (errors && errors.length) {
      allErrors = allErrors.concat(errors)
    }
    currentIndex += chunkSize
    if (currentIndex >= ids.length) {
      me.setLoading(false)
      return Promise.resolve()
    }
    removeData(me, ids, dictEntityName, currentIndex, chunkSize)
    return Promise.resolve()
  }).then(() => {
    if (allErrors.length) {
      AC.filesService.saveAsPlain(allErrors.map(err => err.message).join(`\r\n`), `Error list ${dictEntityName}.txt`, {
        type: 'text/plain'
      })
      $App.dialogInfo(UB.i18n('При видаленні даних виникли помилки, див. лог файл'))
    } else {
      AC.viewUtils.showToast(UB.i18n('Видалення даних виконано успішно'))
    }
  })
}

async function insertData (me, data, dictEntityName, currentIndex, chunkSize, isCheckOnly, impSourceID) {
  let impSourceCtrl = me.mode === 'EMP' ? me.down('[name=impOrgID]') : me.down('[name=impSourceID]')
  if (!impSourceID) {
    if (impSourceCtrl.allowBlank) {
      impSourceID = null
    } else {
      impSourceID = me.getImpSourceID({
        isShowError: true
      })
      if (!impSourceID) {
        me.setLoading(false)
        return false
      }
    }
  }
  if (!impSourceID) {
    if (!await $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n(`Буде виконано {0} даних для Організації <b>{1}</b>. Продовжити?`,
      isCheckOnly ? UB.i18n('перевірку') : UB.i18n('завантаження'), appAC.globalOrganizationName()))) {
      me.setLoading(false)
      return false
    }
    impSourceID = appAC.globalOrganization()
  }
  data = data.map((item, index) => {
    return item
  })

  const params = {
    type: 'emp',
    entityName: dictEntityName,
    currentIndex,
    chunkSize,
    data: JSON.stringify(data.slice(currentIndex, currentIndex + chunkSize)),
    impSourceID: impSourceID,
    isUpdateExisting: me.down('[name=isUpdateExisting]').getValue()
  }
  me.setLoading(UB.i18n('Завантаження...') + currentIndex)
  return $App.connection.run({
    entity: 'ac_service',
    method: 'insertData',
    validate: isCheckOnly,
    'checkUnique': false,
    params
  }).then(({
    state,
    errors,
    errorsCount,
    existing
  }) => {
    me.setLoading(false)
    me.existing = me.existing.concat(JSON.parse(existing))
    currentIndex += chunkSize
    if (errors) {
      const errorMessages = JSON.parse(errors)
      errorMessages.forEach(error => {
        me.errorMessages.push(error)
      })
      me.errorsCount += errorsCount
    }
    if (currentIndex >= data.length) {
      // validation is finished
      let msg = isCheckOnly ? UB.i18n('Перевірка виконана') : UB.i18n('Завантаження виконано')
      if (me.errorsCount > 0) {
        AC.filesService.saveAsPlain(me.errorMessages.join(`\r\n`), `Error list ${dictEntityName}.txt`, {
          type: 'text/plain'
        })
        AC.viewUtils.showToast(UB.i18n('Помилка'), msg + UB.i18n(' з помилками. Детальну інформацію дивіться в файлі помилок.'))
      } else {
        AC.viewUtils.showToast(msg)
      }
      me.setLoading(false)
      return Promise.resolve(true)
    }
    return insertData(me, data, dictEntityName, currentIndex, chunkSize, isCheckOnly, impSourceID)
  }).catch(e => {
    AC.viewUtils.showToast(UB.i18n('Помилка'), e.message)
    me.setLoading(false)
    return Promise.resolve(false)
  })
}
