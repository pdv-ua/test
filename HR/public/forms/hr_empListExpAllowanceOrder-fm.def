/* global Ext UB $App AC HR appAC UB _ */
exports.formDef = 'HR.empListExpAllowanceOrder'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.empListExpAllowanceOrder', {
  extend: 'Ext.panel.Panel',
  alias: 'widget.empListExpAllowanceOrder',
  layout: { type: 'border' },
  width: 1100,
  height: 600,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        name: 'paramPanel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox', align: 'middle' },
            collapsed: false,
            items: [
              {
                xtype: 'panel',
                layout: { type: 'vbox', align: 'stretch' },
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getOrgCombo({
                        labelWidth: 145,
                        width: 700,
                        flex: 1,
                        readOnly: !accMainReportsSubOrg,
                        ubRequest: {
                          entity: 'hr_organization',
                          fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              values: {
                                state: 'ACTIVE'
                              }
                            },
                            path: {
                              expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                              condition: accMainReportsSubOrg ? 'like' : '=',
                              values: {
                                state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                              }
                            }
                          },
                          orderList: { orderBy: { expression: 'description' } },
                          __mip_ondate: appAC.globalApplicationDate()
                        },
                        listeners: {
                          change: function (ctrl) {
                            const form = ctrl.up('[name=paramPanel]')
                            HR.controlService.onChangeIncludeChildOrgs(form)
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildOrgs(accMainReportsSubOrg)
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getDepCombo({
                        labelWidth: 145,
                        width: 700,
                        displayField: 'description',
                        flex: 1,
                        listeners: {
                          change: function (ctrl, value) {
                            const form = ctrl.up('[name=paramPanel]')
                            // let me = btn.up('[name=paramPanel]').ownerCt

                            form.down('[name=includeChildDepts]').setReadOnly(!value)
                            if (!value) {
                              form.down('[name=includeChildDepts]').setValue()
                            }
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildDepts()
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'datefield',
                        name: 'dateFrom',
                        labelWidth: 145,
                        width: 277,
                        fieldLabel: UB.i18n('За період з'),
                        allowBlank: false,
                        listeners: {
                          change: function (fld) {
                            me.clearData()
                          }
                        }
                      },
                      {
                        xtype: 'datefield',
                        name: 'dateTo',
                        labelWidth: 80,
                        width: 200,
                        fieldLabel: UB.i18n('по'),
                        allowBlank: false,
                        listeners: {
                          change: function (fld) {
                            me.clearData()
                          }
                        }
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    flex: 1,
                    items: [
                      {
                        xtype: 'ubcombobox',
                        name: 'payElID',
                        fieldLabel: UB.i18n('Вид нарахування'),
                        labelWidth: 145,
                        flex: 1,
                        gridFieldList: ['description', 'dictExperienceID'],
                        displayField: 'description',
                        allowBlank: false,
                        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                        disableModifyEntity: true,
                        ubRequest: {
                          entity: 'hr_payEl',
                          fieldList: ['ID', 'description', 'dictExperienceID'],
                          whereList: {
                            methodId: {
                              expression: '[methodID.code]',
                              condition: '=',
                              values: {
                                value: '6'
                              }
                            }
                          },
                          orderList: { orderBy: { expression: 'codeSort' } }
                        },
                        listeners: {
                          change: function (ctrl, value) {
                            let expCtrl = me.down('[name=experience]')
                            const rec = AC.gridUtils.getCurrentRecord(ctrl)
                            if (rec && rec.data && rec.data.dictExperienceID) {
                              UB.Repository('hr_dictExperience')
                                .attrs(['ID', 'name', 'methodExpID.code'])
                                .where('ID', '=', rec.data.dictExperienceID)
                                .orderBy('dateFrom', 'desc')
                                .selectSingle()
                                .then(res => {
                                  if (res) {
                                    expCtrl.setValue(res.name)
                                  }

                                  me.attr.labelAlert.setText(((res && res['methodExpID.code'] && res['methodExpID.code'] === '6')
                                    ? `Увага! Для розрахунку надбавки за стаж державної служби, стаж працівників розраховується за правилом:<br><ul><li>якщо приведена дата стажу державної служби більша або рівна 01.05.2016 року, то стаж це стаж державної служби</li> <li>якщо приведена дата стажу державної служби менша за 01.05.2016 року, то стаж це максимальне значення із значень стажу державної служби та стажу за вислугу в державних органах</li></ul>` : ''
                                  ), false)
                                })
                            }
                            me.clearData()
                          }
                        }
                      },
                      {
                        xtype: 'textfield',
                        name: 'experience',
                        readOnly: true,
                        labelWidth: 80,
                        width: 350,
                        fieldLabel: UB.i18n('Вид стажу:'),
                        listeners: {
                          change: function (fld) {
                            me.clearData()
                          }
                        }
                      }
                    ]
                  },
                  {
                    xtype: 'ubcombobox',
                    name: 'positionType',
                    labelWidth: 145,
                    width: 900,
                    fieldLabel: UB.i18n('Тип посади'),
                    hideEntityItemInContext: true,
                    enumGroupFilter: 'HR_POSITION_TYPE',
                    valueField: 'code',
                    displayField: 'name',
                    ubRequest: {
                      entity: 'ubm_enum',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                      whereList: {
                        eGroup: {
                          expression: '[eGroup]',
                          condition: 'equal',
                          values: { 'eGroup': 'HR_POSITION_TYPE' }
                        }
                      }
                    },
                    listeners: {
                      change: function (fld) {
                        me.clearData()
                      }
                    }
                  },
                  {
                    xtype: 'ubcombobox',
                    name: 'workPlace',
                    labelWidth: 145,
                    width: 900,
                    fieldLabel: UB.i18n('Місце роботи'),
                    hideEntityItemInContext: true,
                    enumGroupFilter: 'HR_WORKER_PLACE',
                    valueField: 'code',
                    displayField: 'name',
                    ubRequest: {
                      entity: 'ubm_enum',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                      whereList: {
                        eGroup: {
                          expression: '[eGroup]',
                          condition: 'equal',
                          values: { 'eGroup': 'HR_WORKER_PLACE' }
                        }
                      }
                    },
                    listeners: {
                      change: function (fld) {
                        me.clearData()
                      }
                    }
                  },
                  HR.controlService.getRespEmpCombo({
                    name: 'respID',
                    fieldLabel: UB.i18n('Відповідальний'),
                    labelWidth: 145,
                    width: 900,
                    allowBlank: true,
                    defaultOrgBoss: false,
                    listeners: {
                      change: function (fld) {
                        me.clearData()
                      }
                    }
                  })
                ]
              },
              {
                xtype: 'panel',
                layout: { type: 'vbox', align: 'stretch' },
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'button',
                        tooltip: UB.i18n('Сформувати'),
                        iconCls: 'fas fa-search',
                        width: 30,
                        cls: 'green-action',
                        margin: '5 0 0 0',
                        handler: function (btn) {
                          let me = btn.up('[name=paramPanel]').ownerCt
                          me.refreshData(me)
                        }
                      },
                      {
                        xtype: 'button',
                        tooltip: UB.i18n('Очистити'),
                        iconCls: 'fas fa-eraser',
                        width: 30,
                        cls: 'fill-action',
                        margin: '5 0 0 0',
                        handler: function (btn) {
                          me.clearSearch()
                        }
                      },
                      {
                        xtype: 'button',
                        iconCls: 'fas fa-print',
                        width: 30,
                        cls: 'blue-action',
                        margin: '5 0 0 0',
                        tooltip: UB.i18n('Друкувати'),
                        handler: function () {
                          me.doReport()
                        }
                      }
                    ]
                  },
                  {
                    xtype: 'label',
                    name: 'labelAlert',
                    text: '',
                    cls: 'x-form-item-label field-label-red',
                    margin: '10 0 10 10',
                    width: 350
                  }
                ]
              }

            ]
          }
        ]
      },
      {
        xtype: 'acGrid',
        name: 'allowanceGrid',
        region: 'center',
        autoScroll: true,
        pageSize: 10000,
        storeType: 'local',
        showToolBar: true,
        disablePaging: true,
        enableMultifilter: true,
        exportExcel: {
          title: UB.i18n('Список осіб щодо встановлення надбавки за вислугу років'),
          fileName: UB.i18n('Список осіб щодо встановлення надбавки за вислугу років')
        },
        checkColumn: {},
        flex: 1,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail', 'audit', 'refresh'],
        fields: [
          { name: 'tabNum', columnConfig: { text: UB.i18n('Таб. №'), tooltip: UB.i18n('Табельний номер'), filterBy: 'string' } },
          { name: 'fullFIO', columnConfig: { text: UB.i18n('ПІБ'), flex: 1, tooltip: UB.i18n('Прізвище, Ім\'я, По батькові'), filterBy: 'string' } },
          { name: 'addDescrPerson', columnConfig: { text: UB.i18n('Додаткова інформація'), filterBy: 'string' } },
          { name: 'stageYear', columnConfig: { text: UB.i18n('Років'), tooltip: UB.i18n('Стаж державної служби (в роках)'), filterBy: 'int' } },
          { name: 'rate', columnConfig: { text: UB.i18n('Відсоток'), tooltip: UB.i18n('Надбавка за стаж державної служби'), filterBy: 'float' } },
          { name: 'setDate', columnConfig: { text: UB.i18n('Дата встановлення'), tooltip: UB.i18n('Дата встановлення надбавки'), renderer: Ext.util.Format.dateRenderer('d.m.Y'), filterBy: 'date' } },
          { name: 'posName', columnConfig: { text: UB.i18n('Посада'), filterBy: 'string' } },
          { name: 'actualPositionName', columnConfig: { text: UB.i18n('Фактична посада'), filterBy: 'Фактична посада' } },
          { name: 'depName', columnConfig: { text: UB.i18n('Підрозділ'), filterBy: 'string' } },
          { name: 'structDepName', columnConfig: { text: UB.i18n('Структурний підрозділ'), filterBy: 'string' } },
          { name: 'workPlaceName', columnConfig: { text: UB.i18n('Місце роботи'), filterBy: 'string' } },
          { name: 'orgName', columnConfig: { text: UB.i18n('Організація'), filterBy: 'string' } },
          { name: 'employeePositionID' },
          { name: 'employeeNumberID' },
          { name: 'employeeID' },
          { name: 'positionID' },
          { name: 'departmentID' },
          { name: 'lastName' },
          { name: 'firstName' },
          { name: 'middleName' }
        ],
        customToolBarActions: [
          {
            cls: 'fill-action',
            itemId: 'addOrderMenu',
            iconCls: 'fa fa-pencil-square-o',
            tooltip: UB.i18n('Створити Наказ про встановлення надбавок'),
            actionId: 'addOrderMenu',
            handler: function (btn) {
              let grid = btn.up('[name=allowanceGrid]')
              let msgValidData
              let selRecords = []
              grid.getCheckedRow().forEach(record => {
                if (!record.data.positionID) {
                  msgValidData = UB.i18n(`У запису {0} не вказана Посада`, record.data.fullFIO)
                  return
                }
                selRecords.push(record.data)
              })
              if (msgValidData) {
                $App.dialogInfo(msgValidData, UB.i18n('Увага'))
                return
              }
              if (!selRecords.length) {
                $App.dialogInfo(UB.i18n('Не вибрано запис'), UB.i18n('Увага'))
                return
              }

              $App.connection.run({
                entity: 'hr_empListExpAllowance',
                method: 'createOrder',
                empData: JSON.stringify(selRecords),
                organizationID: me.attr.organizationID.getValue(),
                payElID: me.attr.payElID.getValue(),
                onDate: appAC.globalApplicationDate()
              }).then(mParams => {
                $App.doCommand({
                  cmdType: 'showForm',
                  entity: 'hr_empOrder',
                  sender: grid,
                  instanceID: mParams.orderID,
                  customParams: {
                    isGroup: false,
                    empOrderType: 'ADDSALARYGOV'
                  }
                })
              })
            }
          }
        ],
        onAfterRender: (grid) => {
          grid.menu.removeAll()
          grid.menu.add([HR.employeeTabs.getEmpCardMenu(grid)])
          const showAddDescrPerson = !!AC.settings.get('hrShowAddDescrPerson', appAC.globalOrganization())
          const colPersonDescr = _.find(grid.getView().getGridColumns(), { dataIndex: 'addDescrPerson' })
          colPersonDescr && colPersonDescr[showAddDescrPerson ? 'show' : 'hide']()
          const useActualPositionName = !!AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization())
          const colActualPositionName = _.find(grid.getView().getGridColumns(), { dataIndex: 'actualPositionName' })
          colActualPositionName && colActualPositionName[useActualPositionName ? 'show' : 'hide']()
        },
        onDeterminateForm: HR.employeeTabs.onDeterminateCard
      }
    ]

    me.refreshData = (me) => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      me.attr.grid.getSelectionModel().deselectAll()
      $App.connection.run({
        entity: 'hr_empListExpAllowance',
        method: 'getData',
        organizationID: me.attr.organizationID.getValue(),
        includeChildOrgs: me.attr.includeChildOrgs.getValue(),
        departmentID: me.attr.departmentID.getValue(),
        includeChildDepts: me.attr.includeChildDepts.getValue(),
        onDate: appAC.globalApplicationDate(),
        dateFrom: AC.dateService.shiftDate(me.attr.dateFrom.getValue()),
        dateTo: AC.dateService.shiftDate(me.attr.dateTo.getValue()),
        payElID: me.attr.payElID.getValue(),
        positionType: me.attr.positionType.getValue(),
        workPlace: me.attr.workPlace.getValue()
      }).then(({ data }) => {
        me.attr.grid.setLocalStoreData(JSON.parse(data) || [])
      })
    }

    me.globalOrganizationChange = () => {
      const orgCombo = me.down('[name=organizationID]')
      AC.viewUtils.deleteWhereListProperty(orgCombo, 'child')

      AC.viewUtils.setWhereListProperty(orgCombo, [
        ['mi_treePath', 'like', appAC.globalOrganization()]
      ], undefined, ['clearValue'])

      let orgStore = orgCombo.getStore() ? orgCombo.getStore() : orgCombo.store
      orgStore.load().then(res => {
        orgCombo.setValueById(appAC.globalOrganization())
        const respCombo = me.down('[name=respID]')
        AC.viewUtils.deleteWhereListProperty(respCombo, 'organizationID')
        AC.viewUtils.setWhereListProperty(respCombo, [
          ['organizationID', '=', appAC.globalOrganization()]
        ], undefined, ['clearValue'])

        me.setDefaultPositionTypeParam()

        let respStore = respCombo.getStore() ? respCombo.getStore() : respCombo.store
        respStore.load().then(res => {
          me.setDefaultRespParam(respCombo)
          me.refreshData(this)
        })
      })
    }

    me.on('afterrender', () => {
      const grid = me.down('[name=allowanceGrid]')
      me.attr = {
        grid: grid,
        organizationID: me.down('[name=organizationID]'),
        includeChildOrgs: me.down('[name=includeChildOrgs]'),
        departmentID: me.down('[name=departmentID]'),
        includeChildDepts: me.down('[name=includeChildDepts]'),
        dateFrom: me.down('[name=dateFrom]'),
        dateTo: me.down('[name=dateTo]'),
        payElID: me.down('[name=payElID]'),
        respID: me.down('[name=respID]'),
        positionType: me.down('[name=positionType]'),
        workPlace: me.down('[name=workPlace]'),
        labelAlert: me.down('[name=labelAlert]')
      }
      me.setDefaultParams()
    }, me)

    me.clearSearch = () => {
      me.setDefaultParams()
      me.clearData()
    }

    me.clearData = function () {
      me.attr.grid.setLocalStoreData([])
    }

    me.setDefaultParams = () => {
      const me = this
      me.attr.dateFrom.setValue(AC.dateService.addMonths(new Date((new Date()).getFullYear(), (new Date()).getMonth(), 1, 0, 0, 0, 0), +1))
      me.attr.dateTo.setValue(AC.dateService.lastDayOfMonth(AC.dateService.addMonths(new Date((new Date()).getFullYear(), (new Date()).getMonth(), 1, 0, 0, 0, 0), +1)))
      me.attr.organizationID.setValueById(appAC.globalOrganization())
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.includeChildOrgs.setValue()
      me.attr.departmentID.setValue()
      me.attr.includeChildDepts.setValue()

      UB.Repository('hr_payEl')
        .attrs(['ID', 'dictExperienceID'])
        .where('methodID.code', '=', '6')
        .selectAsObject()
        .then(payElRes => {
          payElRes && payElRes.length === 1 ? me.attr.payElID.setValueById(payElRes[0].ID) : me.attr.payElID.setValue(null)
        })

      me.setDefaultPositionTypeParam()
      me.setDefaultRespParam(me.attr.respID)
    }

    me.setDefaultPositionTypeParam = (ctrl) => {
      const funcOrgType = AC.settings.get('hrFuncOrgType', appAC.globalOrganization())
      /* Сфера діяльності організації - Бюджетна funcOrgType === '1' */
      funcOrgType && funcOrgType === '1' ? me.attr.positionType.setValueById('8')
        : funcOrgType && funcOrgType === '2' ? me.attr.positionType.setValueById('1')
          : me.attr.positionType.setValueById()
    }

    me.setDefaultRespParam = (ctrl) => {
      let empNumberID = $App.connection.userData().employeeNumberID
      UB.Repository('hr_employeePositionS')
        .attrs('ID', 'dateFrom')
        .where('employeeNumberID', '=', empNumberID)
        .where('isActive', '=', 1)
        .orderBy('dateFrom', 'desc')
        .selectSingle()
        .then(posInfo => {
          posInfo ? ctrl.setValueById(posInfo.ID) : ctrl.setValueById(null)
        })
    }

    me.report_code = 'hr_empListExpAllowanceOrder'
    me.doReport = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }

      const execParams = {
        organizationID: me.attr.organizationID.getValue(),
        includeChildOrgs: me.attr.includeChildOrgs.getValue(),
        departmentID: me.attr.departmentID.getValue(),
        includeChildDepts: me.attr.includeChildDepts.getValue(),
        onDate: appAC.globalApplicationDate(),
        dateFrom: AC.dateService.shiftDate(me.attr.dateFrom.getValue()),
        dateTo: AC.dateService.shiftDate(me.attr.dateTo.getValue()),
        payElID: me.attr.payElID.getValue(),
        respID: me.attr.respID.getValue(),
        positionType: me.attr.positionType.getValue(),
        workPlace: me.attr.workPlace.getValue(),
        selectedRows: me.attr.grid.getCheckedRow().map(o => o.get('employeePositionID'))
      }

      $App.doCommand({
        cmdType: 'showReport',
        caption: UB.i18n('Друкована форма'),
        tabId: 'printDocument' + me.report_code + Date.now(),
        target: $App.getViewport().centralPanel,
        cmdData: {
          reportCode: me.report_code,
          reportParams: execParams,
          reportOptions: {
            allowExportToExcel: true,
            isModal: false
          }
        }
      })
    }

    me.callParent(arguments)

    me.validateParams = () => {
      let res
      let params = []
      let dateFromCtrl = me.attr.dateFrom
      let dateFrom = dateFromCtrl.getValue()
      if (!dateFrom || !dateFromCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"За період з "')))
      }
      let dateToCtrl = me.attr.dateTo
      let dateTo = dateToCtrl.getValue()
      if (!dateTo || !dateToCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"по"')))
      }
      if (!me.attr.organizationID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Організація"')))
      }
      if (!me.attr.payElID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Вид нарахування"')))
      }
      if (params.length) {
        res = {
          msg: UB.i18n(`Не вибрано наступні параметри:<br/>{0}`, params.join(',<br/>'))
        }
      } else {
        if (dateFrom > dateTo) {
          res = {
            msg: UB.i18n(`Дата {0} не може перевищувати дату {1}`, AC.viewUtils.formatFieldLabel('"За період з"'), AC.viewUtils.formatFieldLabel('"по"'))
          }
        }
      }
      return res
    }
  }
})
