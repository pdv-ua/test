/* global UB */
exports.formDef = {
  requiredFields: ['description', 'orderRegistryID', 'orderRegistryID.organizationID', 'orderRegistryID.periodID',
    'orderRegistryID.periodID.dateFrom', 'flagsRec', 'flagsFix', 'orderState', 'empOrderID', 'empOrderID.description',
    'employeeFuneralID.employeeID', 'employeeFuneralID.workPlace', 'accrualDt' ],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'postingAction'
        },
        {
          orderId: 5,
          actionId: 'cancelPostingAction'
        },
        {
          orderId: 6,
          actionId: 'calcFuneral'
        },
        {
          orderId: 7,
          actionId: 'analytic'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'vbox', align: 'stretch' },
      defaults: { labelWidth: 140 },
      items: [
        { attributeName: 'employeeID', hidden: true },
        { attributeName: 'employeeNumberID', hidden: true },
        { attributeName: 'orderNumber', hidden: true },
        { attributeName: 'accrualDt', hidden: true },
        { attributeName: 'orderDate', fieldLabel: UB.i18n('Дата нарахування') },
        {
          attributeName: 'employeeFuneralID',
          fieldList: ['ID', 'description', 'organizationID', 'employeeID', 'employeeID.fullFIO', 'workPlace',
            'employeeNumberID', 'dateFrom', 'dateTo', 'employeeNumberID.dateFrom', 'employeeNumberID.dateTo'],
          orderList: { orderBy: { expression: 'employeeNumberID.tabNumSort' } },
          xtype: 'empPositionCombobox'
        },
        {
          attributeName: 'employeePositionID',
          fieldList: ['ID', 'description', 'organizationID', 'employeeID', 'workPlace', 'employeeNumberID', 'dateFrom', 'dateTo', 'vacancyDateFrom', 'vacancyDateTo'],
          orderList: { orderBy: { expression: 'employeeNumberID.tabNumSort' } },
          addWorkPlace: true,
          addDateTo: true,
          xtype: 'empPositionCombobox',
          whereList: {
            isWorcker: {
              expression: '[workPlace]',
              condition: 'notIn',
              values: { value: ['4'] }
            }
          },
          hidden: true
        },
        {
          attributeName: 'employeeFamilyID',
          fieldList: ['ID', 'description', 'employeeID'],
          hidden: true
        },
        { attributeName: 'dead', hidden: true },
        {
          attributeName: 'payElID',
          fieldList: ['ID', 'description', 'methodID.code', 'methodID.dayAccumCondition', 'codeSort'],
          orderList: { orderBy: { expression: 'codeSort' } }
        },
        {
          attributeName: 'dictFundSourceID',
          hideEntityItemInContext: true
        },
        {
          layout: { type: 'hbox' },
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              defaults: { labelWidth: 140, width: 300 },
              items: [
                { attributeName: 'dateDeath',
                  allowBlank: false
                },
                { attributeName: 'dateFuneral',
                  allowBlank: false
                },
                {
                  attributeName: 'paySum',
                  flagsFix: 1 << 1
                }
              ]
            },
            {
              xtype: 'fieldset',
              title: UB.i18n('Довідково:'),
              layout: { type: 'vbox' },
              margin: '0 10 0 10',
              padding: '0 0 10 10',
              defaults: { labelWidth: 210, width: 400 },
              items: [
                {
                  xtype: 'numberfield',
                  name: 'sumOnDateDeath',
                  flagsFix: 2,
                  fieldLabel: UB.i18n('Допомога на дату смерті'),
                  valueToRaw: UB.core.UBUtil.formatAsCurrency,
                  decimalPrecision: 2,
                  allowExponential: false,
                  hideTrigger: true,
                  readOnly: true
                },
                {
                  xtype: 'numberfield',
                  name: 'sumOnDateFuneral',
                  flagsFix: 2,
                  fieldLabel: UB.i18n('Допомога на дату поховання'),
                  valueToRaw: UB.core.UBUtil.formatAsCurrency,
                  decimalPrecision: 2,
                  allowExponential: false,
                  hideTrigger: true,
                  readOnly: true
                }
              ]
            }
          ]
        },
        {
          xtype: 'fieldset',
          title: UB.i18n('Свідоцтво про смерть'),
          layout: { type: 'hbox' },
          margin: '0 15 0 10',
          padding: '0 0 10 10',
          items: [
            {
              attributeName: 'seriaDoc',
