/* jshint maxerr: 10000 */

/* global $App AC Ext UB HR _ appAC */
const notGroupOrders = ['TASK', 'VACATIONLONG']

exports.formDef = (function () {
  return {
    customParams: {
      empOrderType: 'BONUS'
    },
    requiredFields: ['orderState', 'description', 'empOrderType', 'organizationID.mi_data_id', 'organizationID',
      'orderNumberFullView', 'organizationID.description', 'reportSettings', 'isGroup', 'positionType',
      'respEmployeePositionID.description', 'respEmployeePosition2ID.description', 'masterOrganizationID',
      'respEmployeeNumID', 'respEmployeeNumID.description', 'document', 'mi_createUser', 'particle', 'parentOrderID',
      'staffTableID.docType', 'masterOrganizationID.mi_treePath', 'masterOrganizationName', 'skipCancelReconciliation',
      'staffTariffingID', 'documentPrintable'
    ],
    parentConfig: {
      hideActions: ['docActiondocument', 'docActiondocumentPrintable'],
      postOnlySimpleAttributes: true,
      layout: {
        type: 'border'
      }
    },
    size: {
      width: 1100,
      height: 600
    },
    dockedItems: [{
      xtype: 'toolbar',
      dock: 'top',
      items: [{
        orderId: 6,
        actionId: 'postingAction'
      },
      {
        orderId: 6,
        actionId: 'cancelPostingAction'
      },
      {
        orderId: 6,
        actionId: 'setMarkAction',
        iconCls: 'fas fa-stamp',
        cls: 'green-action'
      },
      {
        orderId: 6,
        actionId: 'printDocumentAction',
        iconCls: 'fas fa-print',
        cls: 'blue-action'
      },
      {
        orderId: 6,
        actionId: 'showStructure',
        text: UB.i18n('Структура'),
        iconCls: 'iconParams',
        // showIf: (c, me) => me.isEditMode,
        hidden: true,
        handler: btn => {
          const me = btn.up('form')
          $App.doCommand({
            cmdType: 'showForm',
            entity: me.entity,
            formCode: 'hr_empOrder-tree',
            isModal: true,
            customParams: {
              orderID: me.record.get('ID'),
              orderForm: me
            }
          })
        }
      },
      {
        orderId: 6,
        actionId: 'startReconciliation'
      },
      {
        orderId: 6,
        actionId: 'stopReconciliation'
      },
      {
        orderId: 6,
        actionId: 'toCompletion'
      },
      {
        orderId: 6,
        actionId: 'renewTask'
      }
      ].reverse()
    }],
    items: [{
      xtype: 'tabpanel',
      region: 'center',
      listeners: {
        tabchange: async function (tabPanel, activeTab) {
          const me = tabPanel.up('form')
          if (me.isInternalTabSet) {
            return
          }
          if (activeTab.ubID === 'report') {
            if (!me.isPdfCreated) {
              if (!me.record.get('docText') && me.isEditable()) {
                HR.reportTab.editHtml(me)
              } else {
                HR.reportTab.setReportMode(me, 'view')
              }
            }
            me.isPdfCreated = true
          } else if (activeTab.ubID === 'orderstructure') {
            let orderStructure = activeTab.down('orderstructure')
            if (!orderStructure) {
              UB.inject('models/HR/controls/orderStructure.js').then(function () {
                orderStructure = Ext.create('HR.controls.orderStructure', {
                  orderID: me.instanceID,
                  orderForm: me
                })
                activeTab.add(orderStructure)
                orderStructure.appendItems()
              })
            }
          }
          if (activeTab.name === 'empOrdListAppruvItem') {
            const recparticipant = await me.getRecparticipant(me.instanceID)
            me.down('[actionId=addFromRoute]').setVisible(recparticipant.length)
          }
        }
      },
      items: [{
        title: UB.i18n('Загальне'),
        layout: {
          type: 'border'
        },
        items: [{
          region: 'north',
          autoScroll: false,
          // split: true,
          items: [
            /* eslint-disable no-template-curly-in-string */
            AC.viewUtils.getCollapsiblePanel(
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Організація")}</span> ${me.getField("organizationID").getRawValue()}' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("№ Наказу")}</span> ${orderNumberFullView} <span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Вид")}</span> ${UB.i18n("Про")} ${me.getOrderTypeName()} <br>' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Дата")}</span> ${get("orderDate") ? moment(get("orderDate")).format("DD.MM.YYYY") : UB.i18n("Без дати") } <span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${UB.i18n("Підписав")}</span> ${get("respEmployeePositionID.description")||UB.i18n("Без підпису")} ' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${get("isAppendix") ? UB.i18n("Наказ з додатком") : ""}</span> ${get("isAppendix") ? UB.i18n("Так") : "" } ' +
              '<span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${get("reason") ? UB.i18n("Підстава") : ""}</span> ${reason} <span style="color:#2196F3;">&nbsp;&nbsp;&nbsp;&nbsp;${get("comment") ? UB.i18n("Коментар") : ""}</span> ${comment} ', {
                expandTitle: UB.i18n('Інформація про наказ'),
                layout: {
                  type: 'hbox'
                },
                items: [{
                  flex: 1,
                  layout: {
                    type: 'vbox',
                    align: 'stretch'
                  },
                  items: [
                    {
                      attributeName: 'mOrganizationName',
                      xtype: 'ubtextfield',
                      readOnly: true,
                      fieldLabel: UB.i18n('Головна організація'),
                      flex: 1
                    },

                    {
                      attributeName: 'organizationID',
                      fieldList: ['mi_data_id', 'description', 'ID'],
                      valueField: 'mi_data_id',
                      displayField: 'description',
                      fieldLabel: UB.i18n('Організація'),
                      __mip_recordhistory_all: true,
                      whereList: {
                        state: {
                          expression: '[state]',
                          condition: 'equal',
                          values: {
                            state: 'ACTIVE'
                          }
                        }
                      }
                    },
                    {
                      xtype: 'ubtextfield',
                      ubID: 'orgName',
                      readOnly: true,
                      fieldLabel: UB.i18n('Організація'),
                      flex: 1,
                      hidden: true
                    },
                    // dictEmpOrderIndexID
                    {
                      layout: {
                        type: 'hbox',
                        align: 'middle'
                      },
                      items: [{
                        attributeName: 'orderNumber',
                        allowBlank: true,
                        fieldLabel: UB.i18n('Номер/індекс наказу'),
                        flex: 1
                      },
                      {
                        attributeName: 'dictEmpOrderIndexID',
                        fieldLabel: '',
                        allowBlank: true,
                        width: 150,
                        maxWidth: 150,
                        fieldList: ['ID', 'code'],
                        displayField: 'code',
                        valueField: 'ID'
                      }
                      ]
                    },
                    {
                      layout: {
                        type: 'hbox',
                        align: 'middle'
                      },
                      items: [{
                        attributeName: 'orderDate',
                        fieldLabel: UB.i18n('Дата наказу'),
                        listeners: {
                          focus: ctrl => {
                            ctrl._oldValue = ctrl.getValue()
                          },
                          _blur: ctrl => {
                            if (ctrl.isValid() && ctrl._oldValue.toString() !== ctrl.getValue().toString()) {
                              const me = ctrl.up('form')
                              me.filterEmployeePosition(me, {
                                attrToFilter: 'respEmployeePositionID',
                                clearValue: true
                              })
                              me.filterEmployeePosition(me, {
                                attrToFilter: 'respEmployeePosition2ID',
                                clearValue: true
                              })
                            }
                          }
                        }
                      },
                      {
                        attributeName: 'entryDate',
                        labelWidth: 140,
                        showIf: (ctrl, me) => ['STAFFLIST', 'ORGSTRUCTURE'].includes(me.record.get('empOrderType'))
                      }
                      ]
                    },
                    {
                      attributeName: 'periodID',
                      fieldLabel: UB.i18n('Період розрахунку'),
                      flex: 1,
                      orderList: {
                        orderBy: {
                          expression: 'dateFrom',
                          order: 'desc'
                        }
                      },
                      hidden: true
                    },
                    {
                      xtype: 'fieldset',
                      name: 'signer1',
                      layout: { type: 'vbox', align: 'stretch' },
                      margin: '5 0 5 10',
                      padding: '0 0 5 0',
                      style: 'border-color: #2f7c94',
                      items: [
                        {
                          attributeName: 'respPositionID',
                          disableContextMenu: true,
                          fieldList: ['mi_data_id', 'description', 'state'],
                          labelWidth: 100,
                          valueField: 'mi_data_id',
                          displayField: 'description',
                          hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                          gridFieldList: ['description'],
                          __mip_recordhistory_all: true,
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              value: 'ACTIVE'
                            },
                            isOrgBoss: {
                              expression: '',
                              condition: 'subquery',
                              subQueryType: 'exists',
                              value: {
                                entity: 'hr_orgRespPosition',
                                fieldList: ['ID'],
                                method: 'select',
                                whereList: {
                                  cond: {
                                    expression: '[positionID]=[{master}.mi_data_id]',
                                    condition: 'custom'
                                  },
                                  mi_deleteDate: {
                                    condition: 'equal',
                                    expression: '[mi_deleteDate]',
                                    value: '#maxdate'
                                  },
                                  dateFrom: {
                                    condition: '<=',
                                    expression: '[dateFrom]',
                                    value: appAC.globalApplicationDate()
                                  },
                                  dateTo: {
                                    condition: '>=',
                                    expression: '[dateTo]',
                                    value: appAC.globalApplicationDate()
                                  },
                                  organizationID: {
                                    condition: '=',
                                    expression: '[organizationID]',
                                    value: appAC.globalOrganization()
                                  },
                                  signer4EmpOrder: {
                                    expression: '[respPosition]',
                                    condition: '=',
                                    value: 'signer4EmpOrder'
                                  }
                                }
                              }
                            }
                          },
                          listeners: {
                            render: ctrl => {
                              setTimeout(function () { ctrl.clearIsPhantom() }, 1000)
                            }
                          }
                        },
                        {
                          attributeName: 'respEmployeePositionID',
                          disableContextMenu: true,
                          labelWidth: 100,
                          valueField: 'ID',
                          displayField: 'description',
                          fieldList: ['description', 'positionID', 'employeeID', 'employeeNumberID'],
                          hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                          gridFieldList: ['description']
                        }
                      ]
                    },
                    {
                      xtype: 'fieldset',
                      name: 'signer2',
                      layout: { type: 'vbox', align: 'stretch' },
                      margin: '5 0 5 10',
                      padding: '0 0 5 0',
                      style: 'border-color: #2f7c94',
                      items: [
                        {
                          attributeName: 'respPosition2ID',
                          disableContextMenu: true,
                          fieldList: ['mi_data_id', 'description', 'state'],
                          labelWidth: 100,
                          valueField: 'mi_data_id',
                          displayField: 'description',
                          hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                          gridFieldList: ['description'],
                          __mip_recordhistory_all: true,
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              value: 'ACTIVE'
                            },
                            isOrgBoss: {
                              expression: '',
                              condition: 'subquery',
                              subQueryType: 'exists',
                              value: {
                                entity: 'hr_orgRespPosition',
                                fieldList: ['ID'],
                                method: 'select',
                                whereList: {
                                  cond: {
                                    expression: '[positionID]=[{master}.mi_data_id]',
                                    condition: 'custom'
                                  },
                                  mi_deleteDate: {
                                    condition: 'equal',
                                    expression: '[mi_deleteDate]',
                                    value: '#maxdate'
                                  },
                                  dateFrom: {
                                    condition: '<=',
                                    expression: '[dateFrom]',
                                    value: appAC.globalApplicationDate()
                                  },
                                  dateTo: {
                                    condition: '>=',
                                    expression: '[dateTo]',
                                    value: appAC.globalApplicationDate()
                                  },
                                  organizationID: {
                                    condition: '=',
                                    expression: '[organizationID]',
                                    value: appAC.globalOrganization()
                                  },
                                  signer4EmpOrder: {
                                    expression: '[respPosition]',
                                    condition: '=',
                                    value: 'signer4EmpOrderSecond'
                                  }
                                }
                              }
                            }
                          },
                          listeners: {
                            render: ctrl => {
                              setTimeout(function () { ctrl.clearIsPhantom() }, 1000)
                            }
                          }
                        },
                        {
                          attributeName: 'respEmployeePosition2ID',
                          disableContextMenu: true,
                          labelWidth: 100,
                          valueField: 'ID',
                          displayField: 'description',
                          fieldList: ['description', 'positionID', 'employeeID', 'employeeNumberID'],
                          hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                          gridFieldList: ['description']
                        }
                      ]
                    },
                    {
                      xtype: 'empNumComboBox',
                      showEntityName: 'hr_employee',
                      showFormCode: 'hr_employee',
                      instanceAttr: 'employeeID',
                      attributeName: 'respEmployeeNumID',
                      fieldList: ['ID', 'description', 'employeeID'],
                      hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                      gridFieldList: ['description'],
                      allowBlank: true
                    },
                    {
                      xtype: 'ubtextfield',
                      attributeName: 'comment',
                      flex: 1
                    }
                  ]
                },
                { // Права частина
                  layout: {
                    type: 'vbox',
                    align: 'stretch'
                  },
                  flex: 1,
                  items: [{
                    layout: {
                      type: 'vbox',
                      align: 'stretch'
                    },
                    defaults: {
                      labelWidth: 120,
                      flex: 1
                    },
                    items: [{
                      layout: {
                        type: 'hbox',
                        align: 'middle'
                      },
                      items: [{
                        attributeName: 'titleOrder',
                        margin: '15 15 0 8',
                        labelWidth: 120,
                        disabled: true,
                        emptyText: UB.i18n('Виберіть значення із довідника "Заголовок та преамбула"'),
                        flex: 1,
                        rows: 1
                      },
                      {
                        xtype: 'button',
                        cls: 'list-icon',
                        name: 'preambleButton',
                        tooltip: UB.i18n('Заповнити'),
                        width: 35,
                        height: 35,
                        margin: '0 2 0 -14',
                        handler: btn => {
                          btn.up('form').selectPreamble()
                        }
                      }
                      ]
                    },
                    {
                      attributeName: 'preamble',
                      margin: '0 15 0 8',
                      emptyText: UB.i18n('Внесіть текст преамбули або виберіть із довідника "Заголовок та преамбула"'),
                      rows: 7,
                      flex: 1,
                      listeners: {
                        afterrender: (ctrl) => {
                          ctrl.getEl().on('dblclick', () => {
                            const preambleEditor = Ext.widget('textareawindow', {
                              width: 800,
                              height: 400,
                              title: UB.i18n('Преамбула'),
                              value: ctrl.getValue(),
                              onOk: (editedText) => {
                                if (!ctrl.readOnly && !ctrl.disabled) {
                                  ctrl.setValue(editedText)
                                }
                              }
                            })
                            preambleEditor.center()
                            preambleEditor.show()
                          })
                        }
                      }
                    },
                    {
                      layout: {
                        type: 'hbox'
                      },
                      items: [{
                        layout: {
                          type: 'hbox',
                          align: 'top'
                        },
                        flex: 1,
                        items: [{
                          attributeName: 'reason',
                          flex: 1,
                          margin: '5 13 0 15'
                        },
                        {
                          xtype: 'button',
                          cls: 'list-icon',
                          name: 'reasonButton',
                          tooltip: UB.i18n('Вибрати'),
                          width: 35,
                          height: 35,
                          margin: '0 13 0 -45',
                          handler: btn => btn.up('form').getField('reason').selectHandler(btn)
                        }
                        ]
                      },
                      {
                        xtype: 'button',
                        scale: 'small',
                        name: 'generateReason',
                        iconCls: 'fas fa-angle-double-left',
                        margin: '15 10 15 0',
                        width: 30,
                        showIf: (ctrl, me) => ['VACATION'].includes(me.record.get('empOrderType')),
                        tooltip: UB.i18n('Згенерувати підставу'),
                        cls: 'add-new-action',
                        handler: function (btn) {
                          const me = btn.up('form')
                          me.fillReason(me)
                        }
                      }
                      ]
                    },
                    {
                      layout: {
                        type: 'hbox'
                      },
                      items: [
                        {
                          layout: {
                            type: 'vbox'
                          },
                          items: [
                            {
                              attributeName: 'isAppendix',
                              labelWidth: 150,
                              flex: 1,
                              disabled: true
                            },
                            {
                              attributeName: 'isGroupDepart',
                              labelWidth: 150,
                              flex: 1,
                              disabled: true
                            }
                          ]
                        },
                        {
                          attributeName: 'sortItems',
                          labelWidth: 150,
                          flex: 1,
                          disableContextMenu: false,
                          hideEntityItemInContext: true
                        }
                      ]
                    },
                    {
                      layout: {
                        type: 'vbox',
                        align: 'stretch'
                      },
                      items: [
                        {
                          attributeName: 'documentOrderType',
                          labelWidth: 110,
                          flex: 1,
                          disableContextMenu: false,
                          hideEntityItemInContext: true
                        }
                      ]
                    }
                    ]
                  }]
                }
                ]
              })
          ]
        },
        {
          xtype: 'tabpanel',
          region: 'center',
          items: [{
            title: UB.i18n('Опис пунктів'),
            name: 'hr_empOrderDet',
            xtype: 'ubdetailgrid',
            paraGrid: true,
            autoScroll: true,
            hideActions: ['addNew', 'addNewByCurrent'],
            flex: 1,
            forceDataLoad: true,
            disableAutoLoadStore: true,
            entityConfig: {
              entity: 'hr_empOrderDet',
              method: 'select',
              fieldList: [
                {
                  name: 'employeeNumberID.tabNum',
                  description: UB.i18n('Таб.'),
                  visibility: true,
                  simpleFilter: true
                },
                {
                  name: 'employeeFullName',
                  description: UB.i18n('ПІБ'),
                  visibility: true
                },
                {
                  name: 'lastName',
                  visibility: false
                },
                {
                  name: 'firstName',
                  visibility: false
                },
                {
                  name: 'middleName',
                  visibility: false
                },
                {
                  name: 'employeeID',
                  visibility: false
                },
                {
                  name: 'employeeNumberID',
                  visibility: false
                },
                {
                  name: 'mi_unityEntity',
                  visibility: false
                },
                {
                  name: 'title',
                  description: UB.i18n('Посада')
                },
                {
                  name: 'description',
                  description: UB.i18n('Інформація')
                },
                {
                  name: 'dateFrom',
                  description: UB.i18n('Дата початку'),
                  visibility: true
                },
                {
                  name: 'dateToEmpty',
                  description: UB.i18n('Дата закінчення'),
                  visibility: true
                },
                {
                  name: 'departmentID.name',
                  description: UB.i18n('Підрозділ'),
                  visibility: true
                },
                {
                  name: 'itemIdx',
                  description: '№',
                  visibility: false
                },
                {
                  name: 'empOrderType',
                  description: UB.i18n('Тип пункту'),
                  visibility: true
                },
                {
                  name: 'paraID',
                  description: UB.i18n('З групового'),
                  visibility: false
                },
                {
                  name: 'isGroup',
                  visibility: false
                },
                {
                  name: 'detailCount',
                  visibility: false
                },
                {
                  name: 'orderState',
                  visibility: false
                },
                {
                  name: 'employeePositionID',
                  visibility: false
                }
              ],
              whereList: {
                isGroup: {
                  expression: '[isGroup]',
                  condition: 'notEqual',
                  value: 1
                },
                entityExclusion: {
                  expression: '[mi_unityEntity]',
                  condition: 'notIn',
                  value: ['hr_empOrderInternshipListDet']
                },
                empOrderType: {
                  expression: '[empOrderType]',
                  condition: 'notEqual',
                  value: 'ACTING'
                },
                notGroupOrders: {
                  expression: '[empOrderType]',
                  condition: 'in',
                  value: notGroupOrders
                }
              },
              logicalPredicates: ['([isGroup] OR [notGroupOrders])'],
              orderList: {
                itemIdx: {
                  expression: '[itemIdx]'
                }
              }
            },
            masterFields: ['ID'],
            detailFields: ['orderID'],
            filterOrderDetGroup: function (grid, menuItem) {
              AC.viewUtils.setWhereListProperty(grid, [
                ['isGroup', 'notEqual', menuItem.checked ? 0 : 1]
              ], grid.store.ubRequest.logicalPredicates)
              grid.onRefresh()
              grid.menu.down('[ubID=showIsGroup]').setChecked(menuItem.checked)
            },
            listeners: {
              render: grid => {
                const me = grid.up('form')
                grid.menu.add([{
                  text: UB.i18n('Відкрити картку працівника'),
                  iconCls: 'fa fa-male',
                  ubID: 'itemShowEmployee',
                  hidden: !AC.entityUtils.verifyRightsMethod('hr_employee', 'view'),
                  handler: function () {
                    // let orderDate = AC.dateService.truncTimeToUtcNull(me.record.get('orderDate'))
                    const reco = AC.gridUtils.getCurrentRecord(grid)
                    let message
                    if (!reco) {
                      message = UB.i18n('Не вибраний запис')
                    }
                    if (!reco.get('employeeID')) {
                      message = UB.i18n(`{0} {1} {2} не є працівником`, reco.get('lastName'), reco.get('firstName'), reco.get('middleName'))
                    }
                    if (message) {
                      AC.viewUtils.showToast(UB.i18n('Помилка'), message)
                      return
                    }
                    $App.doCommand({
                      cmdType: 'showForm',
                      formCode: 'hr_employee',
                      entity: 'hr_employee',
                      instanceID: reco.get('employeeID'),
                      sender: grid,
                      cmpInitConfig: {
                        employeeNumberID: reco.get('employeeNumberID')
                      }
                    })
                  }
                },
                {
                  text: UB.i18n('Перемістити вище'),
                  iconCls: 'fa fa-arrow-up',
                  ubID: 'itemMoveUp',
                  handler: function () {
                    const reco = AC.gridUtils.getCurrentRecord(grid)
                    let message
                    if (!reco) {
                      message = UB.i18n('Не вибраний запис')
                    }
                    if (message) {
                      AC.viewUtils.showToast(UB.i18n('Помилка'), message)
                      return
                    }
                    const ID = reco.get('ID')
                    $App.connection.run({
                      entity: 'hr_empOrderDet',
                      method: 'moveItemUp',
                      orderID: me.instanceID,
                      ID: ID,
                      mi_unityEntity: reco.get('mi_unityEntity'),
                      itemIdx: reco.get('itemIdx')
                    }).then(mParams => {
                      if (mParams.isMoved) {
                        const store = grid.getStore()
                        store.load(() => {
                          grid.getSelectionModel().select(store.find('ID', ID), true)
                        })
                      }
                    })
                  }
                },
                {
                  text: UB.i18n('Перемістити нижче'),
                  iconCls: 'fa fa-arrow-down',
                  ubID: 'itemMoveDown',
                  handler: function () {
                    const reco = AC.gridUtils.getCurrentRecord(grid)
                    let message
                    if (!reco) {
                      message = UB.i18n('Не вибраний запис')
                    }
                    if (message) {
                      AC.viewUtils.showToast(UB.i18n('Помилка'), message)
                      return
                    }
                    const ID = reco.get('ID')
                    $App.connection.run({
                      entity: 'hr_empOrderDet',
                      method: 'moveItemDown',
                      orderID: me.instanceID,
                      ID: ID,
                      mi_unityEntity: reco.get('mi_unityEntity'),
                      itemIdx: reco.get('itemIdx')
                    }).then(() => {
                      const store = grid.getStore()
                      store.load(() => {
                        grid.getSelectionModel().select(store.find('ID', ID), true)
                      })
                    })
                  }
                },
                {
                  text: UB.i18n('Оновити нумерацію'),
                  iconCls: 'u-icon-refresh',
                  hidden: true,
                  ubID: 'enumerateItems',
                  handler: function () {
                    $App.connection.run({
                      entity: 'hr_empOrderDet',
                      method: 'enumerateItems',
                      orderID: me.instanceID
                    }).then(() => {
                      grid.getStore().load()
                    })
                  }
                },
                {
                  text: UB.i18n('Заголовки групових пунктів'),
                  xtype: 'menucheckitem',
                  ubID: 'showIsGroup',
                  handler: function (item) {
                    grid.filterOrderDetGroup(grid, item)
                  }
                }
                ])
              }
            },
            cmpInitConfig: {
              getRowClass: function (record) {
                return record.get('empOrderType') === 'MISSION' && record.get('isGroup') && record.get('detailCount') === 0 ? 'grd-bold' : (record.get('orderState') === 'CANCELED' ? 'ub-row-red' : '')
              },

              afterInit: function () { },
              customInit: function () {
                const grid = this
                const _doOnEdit = grid.doOnEdit
                const allActions = grid.down('[menuId=AllActions]')
                if (!allActions) {
                  return
                }
                allActions.menu.add({
                  xtype: 'menucheckitem',
                  ubID: 'showIsGroup',
                  text: UB.i18n('Заголовки групових'),
                  handler: function (item) {
                    grid.filterOrderDetGroup(grid, item)
                  }
                })
                grid.HR_EMPORDRETYPE_STORE = UB.core.UBEnumManager.getStore('HR_EMPORDRETYPE')
                AC.gridUtils.tuneGridColumns(grid, {
                  empOrderType: {
                    title: UB.i18n('Вид пункту'),
                    renderer: function (value, metadata, record) {
                      value = grid.HR_EMPORDRETYPE_STORE.getById(value).get('name')
                      if (!record || !_.isFunction(record.get)) {
                        return value
                      }
                      if (record.get('isGroup')) {
                        return `${value} (${record.get('detailCount')})`
                      }
                      if (record.get('paraID') !== record.get('ID')) {
                        return value + UB.i18n(' (гр)')
                      }
                      return value
                    }
                  },
                  description: {
                    renderer: function (value) {
                      return /^\.+$/.test(value) ? '' : value
                    }
                  }
                })
                grid.doOnEdit = function () {
                  grid.isEditMode = true
                  _doOnEdit.call(grid)
                }
              },
              onDeterminateForm: function (grid) {
                const form = grid.up('form')
                if (!grid.isEditMode) {
                  return {
                    entityName: form.getDetailEntityName({
                      tail: 'Det',
                      byItemType: false
                    })
                  }
                }
                grid.isEditMode = false
                const reco = AC.gridUtils.getCurrentRecord(grid)
                if (reco.get('paraID')) {
                  if (reco.get('paraID') !== reco.get('ID')) {
                    return {
                      entityName: form.getDetailEntityName({
                        tail: 'Det',
                        empOrderType: reco.get('empOrderType')
                      }),
                      instanceID: reco.get('paraID')
                    }
                  }
                }
                return {
                  entityName: reco.get('mi_unityEntity')
                }
              },
              customActions: [{
                text: UB.i18n('Додати новий'),
                actionId: 'addByType',
                iconCls: 'u-icon-add',
                cls: 'add-new-action',
                orderId: 0,
                listeners: {
                  render: addByTypeButton => {
                    const me = addByTypeButton.up('form')
                    me.on('recordloaded', () => {
                      addByTypeButton.up('form').makeOrderItemsMenu(addByTypeButton)
                    })
                  }
                },
                menu: [{
                  text: UB.i18n('держслужбовці'),
                  handler: () => { }
                }]
              },
              {
                text: UB.i18n('Завантажити дані'),
                actionId: 'addFromStaffTable',
                iconCls: 'fas fa-angle-double-down',
                cls: 'fill-action',
                hidden: true,
                menu: [
                  {
                    text: UB.i18n('Завантажити дані за змінами ШР'),
                    handler: btn => {
                      const me = btn.up('form')
                      me.addAccrualChangesFromStaffTable()
                    }
                  },
                  {
                    text: UB.i18n('Завантажити дані з тарифікаційного списку'),
                    handler: btn => {
                      const me = btn.up('form')
                      me.addAccrualChangesFromTariffing()
                    }
                  }
                ]
              }]
            }
          }]
        }
        ]
