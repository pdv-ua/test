                {
                  name: 'copies',
                  editor: {
                  }
                },
                {
                  name: 'note',
                  config: {
                    width: 600
                  },
                  editor: {
                  }
                }
              ]
            },
            masterFields: ['ID'],
            detailFields: ['empOrderID'],
            cmpInitConfig: {
            },
            onBeforeEdit: function (editor, context) {
              const me = context.grid.up('form')
              const onDate = appAC.globalApplicationDate()
              AC.viewUtils.setWhereListProperty(editor.editor.query('[name=employeePositionID.description]')[0], [
                ['organizationID', '=', me.record.get('organizationID')],
                ['dateFrom', '<=', onDate],
                ['dateTo', '>=', onDate]
              ])
              context.record.set('organizationID', me.record.get('organizationID'))
              return true
            },
            optimizeColumnWidth: function () {
              // /!* do nothing for manual column width tunning *!/
            }
          }
        ]
      },
      {
        title: UB.i18n('Підписувачі'),
        autoScroll: true,
        layout: 'fit',
        hidden: true,
        flex: 1,
        ubID: 'empOrderSigners',
        items: [
          {
            xtype: 'ubdetailgrid',
            name: 'empOrderSignersGrid',
            rowEditing: true,
            disableAutoLoadStore: true,
            hideActions: ['showPreview', 'itemLink', 'commandLink', 'addNewByCurrent', 'newVersion', 'audit', 'history', 'showDetail'],
            flex: 1,
            lineNumberColumn: 'respNum',
            entityConfig: {
              entity: 'hr_empOrderSignDet',
              method: 'select',
              fieldList: [
                {
                  name: 'respNum',
                  description: UB.i18n('№'),
                  config: {
                    width: 50
                  },
                  editor: {
                    allowBlank: true
                  }
                },
                {
                  name: 'respPosition',
                  description: UB.i18n('Відповідальна особа'),
                  config: {
                    width: 300
                  },
                  editor: {
                    allowBlank: true
                  }
                },
                {
                  name: 'respPositionID.description',
                  description: UB.i18n('Підписант (посада)'),
                  config: {
                    width: 300
                  },
                  editor: {
                    allowBlank: false,
                    disableContextMenu: true,
                    fieldList: ['ID', 'description', 'mi_data_id'],
                    displayField: 'description',
                    hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                    gridFieldList: ['description'],
                    __mip_recordhistory_all: true,
                    whereList: {
                      state: {
                        expression: '[state]',
                        condition: '=',
                        value: 'ACTIVE'
                      }
                    }
                  }
                },
                {
                  name: 'respEmployeePositionID.description',
                  description: UB.i18n('Підписав'),
                  config: {
                    width: 400
                  },
                  editor: {
                    fieldList: ['ID', 'description'],
                    gridFieldList: ['description'],
                    allowBlank: true,
                    hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion']
                  }
                }
              ]
            },
            masterFields: ['ID'],
            detailFields: ['orderID'],
            cmpInitConfig: {
            },
            onBeforeEdit: function (editor, context) {
              const me = context.grid.up('form')
              const onDate = AC.dateService.truncTimeToUtcNull(me.record.get('orderDate')) || appAC.globalApplicationDate()
              const employeePositionCtrl = editor.editor.query('[name=respEmployeePositionID.description]')[0]
              if (context.record.get('respPositionID')) {
                const store = employeePositionCtrl.getStore()
                store.ubRequest.positionID = context.record.get('respPositionID')
                store.ubRequest.onDate = onDate
                store.ubRequest.currTime = Date.now() // monkey request prevention
                store.ubRequest.method = 'getTempExecution'
              }
              const respPositionCtrl = editor.editor.query('[name=respPosition]')[0]
              const respPositionIDCtrl = editor.editor.query('[name=respPositionID.description]')[0]
              respPositionIDCtrl.storeAttributeValueField = undefined
              AC.viewUtils.setWhereListProperty(employeePositionCtrl, [
                ['organizationID', '=', me.record.get('organizationID')],
                ['dateFrom', '<=', onDate],
                ['dateTo', '>=', onDate]
              ], undefined, [])
              respPositionIDCtrl.store.ubRequest.__mip_ondate = onDate
              AC.viewUtils.setWhereListProperty(respPositionIDCtrl, [
                ['orgID', '=', me.record.get('organizationID')],
                ['state', '=', 'ACTIVE']
              ], undefined, ['clearStore', 'clearWhereList'])
              respPositionIDCtrl.on('change', (ctrl, value) => {
                context.record.set('respPositionID', ctrl.getFieldValue('mi_data_id'))
                if (value) {
                  const store = employeePositionCtrl.getStore()
                  store.ubRequest.positionID = ctrl.getFieldValue('mi_data_id')
                  store.ubRequest.onDate = onDate
                  store.ubRequest.currTime = Date.now() // monkey request prevention
                  store.ubRequest.method = 'getTempExecution'
                  employeePositionCtrl.setValue(null)
                  store.load().then(() => {
                    employeePositionCtrl.clearIsPhantom()
                  })
                  employeePositionCtrl.clearIsPhantom()
                } else {
                  employeePositionCtrl.setValue(null)
                }
              })
              respPositionCtrl.on('change', (ctrl, value) => {
                if (value) {
                  respPositionIDCtrl.getStore().ubRequest.whereList = {
                    state: {
                      expression: '[state]',
                      condition: '=',
                      value: 'ACTIVE'
                    },
                    dateFrom: {
                      condition: '<=',
                      expression: '[mi_dateFrom]',
                      value: onDate
                    },
                    dateTo: {
                      condition: '>=',
                      expression: '[mi_dateTo]',
                      value: onDate
                    },
                    orgID: {
                      condition: '=',
                      expression: '[orgID]',
                      value: me.record.get('organizationID')
                    },
                    isRespPosition: {
                      expression: '',
                      condition: 'subquery',
                      subQueryType: 'exists',
                      value: {
                        entity: 'hr_orgRespPosition',
                        fieldList: ['ID'],
                        method: 'select',
                        whereList: {
                          cond: {
                            expression: '[positionID]=[{master}.mi_data_id]',
                            condition: 'custom'
                          },
                          mi_deleteDate: {
                            condition: 'equal',
                            expression: '[mi_deleteDate]',
                            value: '#maxdate'
                          },
                          dateFrom: {
                            condition: '<=',
                            expression: '[dateFrom]',
                            value: onDate
                          },
                          dateTo: {
                            condition: '>=',
                            expression: '[dateTo]',
                            value: onDate
                          },
                          organizationID: {
                            condition: '=',
                            expression: '[organizationID]',
                            value: me.record.get('organizationID')
                          },
                          signer4EmpOrder: {
                            expression: '[respPosition]',
                            condition: '=',
                            value
                          }
                        }
                      }
                    }
                  }
                  respPositionIDCtrl.clearValue()
                } else {
                  AC.viewUtils.setWhereListProperty(respPositionIDCtrl, [
                    ['orgID', '=', me.record.get('organizationID')],
                    ['state', '=', 'ACTIVE'],
                    ['mi_dateFrom', '<=', onDate],
                    ['mi_dateTo', '>=', onDate]
                  ], undefined, ['clearStore', 'clearWhereList'])
                }
              })
              return true
            },
            optimizeColumnWidth: function () {
              // /!* do nothing for manual column width tunning *!/
            }
          }
        ]
      },
      {
        title: UB.i18n('Структура'),
        ubID: 'orderstructure',
        disabled: true,
        hidden: true,
        enabledIf: (c, me) => me.isEditMode,
        layout: 'fit'
      },
      {
        title: UB.i18n('Штатний розпис'),
        ubID: 'staffTable',
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        // showIf: (ctrl, me) => me.record.get('empOrderType') === 'STAFFLIST',
        items: [
          {
            layout: {
              type: 'hbox',
              aling: 'stretch'
            },
            items: [
              {
                attributeName: 'staffTableID',
                flex: 1,
                hidden: true,
                fieldList: ['ID', 'description', 'orderState', 'entryDate', 'orgID'],
                valueField: 'ID',
                displayFieldField: 'description',
                showIf: (ctrl, me) => me.record.get('empOrderType') === 'STAFFLIST'
              },
              {
                xtype: 'button',
                iconCls: 'fas fa-sign-in-alt',
                tooltip: UB.i18n('Відкрити ШР'),
                margin: '0 5 0 0',
                height: 30,
                showIf: (ctrl, me) => me.record.get('empOrderType') === 'STAFFLIST',
                handler: btn => {
                  const reco = btn.up('form').record
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: ['ACCRUAL', 'ACCRUAL_CHANGES'].includes(reco.get('staffTableID.docType')) ? 'hr_staffTableAccrual' : 'hr_staffTable',
                    entity: 'hr_staffTable',
                    instanceID: reco.get('staffTableID'),
                    tabId: `hr_staffTableOrgStructure-${['ACCRUAL', 'ACCRUAL_CHANGES'].includes(reco.get('staffTableID.docType')) ? 'hr_staffTableAccrual' : 'hr_staffTable'}`,
                    target: $App.getViewport().centralPanel,
                    cmpInitConfig: {
                    }
                  })
                }
              }
            ]
          },
          {
            layout: {
              type: 'hbox',
              aling: 'stretch'
            },
            items: [
              {
                attributeName: 'staffTableOrgStructureID',
                flex: 1,
                hidden: true,
                fieldList: ['ID', 'description', 'orderState', 'entryDate', 'orgID'],
                valueField: 'ID',
                displayFieldField: 'description',
                showIf: (ctrl, me) => me.record.get('empOrderType') === 'ORGSTRUCTURE'
              },
              {
                xtype: 'button',
                iconCls: 'fas fa-sign-in-alt',
                tooltip: UB.i18n('Відкрити структуру'),
                margin: '0 5 0 0',
                height: 30,
                showIf: (ctrl, me) => me.record.get('empOrderType') === 'ORGSTRUCTURE',
                handler: btn => {
                  const reco = btn.up('form').record
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode: 'hr_staffTableOrgStructure',
                    entity: 'hr_staffTableOrgStructure',
                    instanceID: reco.get('staffTableOrgStructureID'),
                    tabId: `hr_staffTableOrgStructure-${reco.get('staffTableOrgStructureID')}`,
                    target: $App.getViewport().centralPanel
                  })
                }
              }
            ]
          },
          {
            region: 'center',
            flex: 4,
            xtype: 'container',
            layout: 'fit',
            items: [
              Ext.create('UB.ux.PDFComponent', {
                flex: 1,
                height: '100%',
                name: 'staffTablePdf'
              })
            ]
          }
        ]
      }]
    }]
  }
})()
