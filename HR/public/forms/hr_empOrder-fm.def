      {
        title: UB.i18n('Лист погодження'),
        autoScroll: true,
        name: 'empOrdListAppruvItem',
        layout: 'fit',
        flex: 1,
        items: [
          {
            name: 'empOrdListAppruv',
            xtype: 'ubdetailgrid',
            rowEditing: true,
            disableSearchBar: true,
            enableColumnHide: false,
            hideActions: ['showPreview', 'itemLink', 'commandLink', 'addNewByCurrent', 'newVersion', 'audit', 'history', 'showDetail'],
            flex: 1,
            masterFields: ['ID'],
            entityConfig: {
              entity: 'hr_empOrdListAppruv',
              method: 'select',
              fieldList: [
                {
                  name: 'stageKind',
                  allowBlank: false
                },
                {
                  name: 'respPositionID.description',
                  description: UB.i18n('Посада погоджувача'),
                  editor: {
                    allowBlank: false,
                    disableContextMenu: true,
                    fieldList: ['ID', 'description', 'mi_data_id'],
                    hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                    whereList: {
                      state: {
                        expression: '[state]',
                        condition: '=',
                        value: 'ACTIVE'
                      }
                    }
                  }
                },
                {
                  name: 'respEmployeePositionID.description',
                  description: UB.i18n('Погодив'),
                  disableContextMenu: true,
                  editor: {
                    hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                    fieldList: ['ID', 'description', 'positionID'],
                    gridFieldList: ['description']
                  }
                },
                { name: 'dateAppruv', format: 'd.m.Y' },
                {
                  name: 'KEP',
                  editor: {
                    readOnly: true
                  }
                }
              ]
            },
            detailFields: ['orderID'],
            cmpInitConfig: {
              customActions: [{
                tooltip: UB.i18n('Заповнити з маршруту'),
                text: UB.i18n('Заповнити з маршруту'),
                iconCls: 'fas fa-tasks',
                actionId: 'addFromRoute',
                handler: async function (btn) {
                  const me = btn.up('form')
                  await me.fillEmpOrdListAppruvList(me)
                }
              }]
            },
            onBeforeEdit: function (editor, context) {
              const me = context.grid.up('form')
              const onDate = AC.dateService.truncTimeToUtcNull(me.record.get('orderDate')) || appAC.globalApplicationDate()
              const employeePositionCtrl = editor.editor.query('[name=respEmployeePositionID.description]')[0]
              employeePositionCtrl.getStore().reload()
              if (context.record.get('respPositionID')) {
                const store = employeePositionCtrl.getStore()
                store.ubRequest.positionID = context.record.get('respPositionID')
                store.ubRequest.onDate = onDate
                store.ubRequest.currTime = Date.now() // monkey request prevention
                store.ubRequest.method = 'getTempExecution'
              }
              const respPositionIDCtrl = editor.editor.query('[name=respPositionID.description]')[0]
              respPositionIDCtrl.storeAttributeValueField = undefined
              respPositionIDCtrl.store.ubRequest.__mip_ondate = onDate
              AC.viewUtils.setWhereListProperty(employeePositionCtrl, [
                ['organizationID', '=', me.record.get('organizationID')],
                ['dateFrom', '<=', onDate],
                ['dateTo', '>=', onDate]
              ], undefined, ['clearStore', 'clearWhereList', 'clearValue'])
              AC.viewUtils.setWhereListProperty(respPositionIDCtrl, [
                ['orgID', '=', me.record.get('organizationID')],
                ['state', '=', 'ACTIVE'],
                ['mi_dateFrom', '<=', onDate],
                ['mi_dateTo', '>=', onDate]
              ], undefined, ['clearStore', 'clearWhereList', 'clearValue'])
              respPositionIDCtrl.on('select', (ctrl, value) => {
                context.record.set('respPositionID', ctrl.getFieldValue('mi_data_id'))
                if (value) {
                  const store = employeePositionCtrl.getStore()
                  store.ubRequest.positionID = ctrl.getFieldValue('mi_data_id')
                  store.ubRequest.onDate = onDate
                  store.ubRequest.currTime = Date.now() // monkey request prevention
                  store.ubRequest.method = 'getTempExecution'
                  employeePositionCtrl.setValue(null)
                  store.load().then(() => {
                    employeePositionCtrl.clearIsPhantom()
                  })
                  employeePositionCtrl.clearIsPhantom()
                } else {
                  const store = employeePositionCtrl.getStore()
                  if (store.ubRequest.positionID) delete store.ubRequest.positionID
                  store.ubRequest.method = 'select'
                  AC.viewUtils.setWhereListProperty(employeePositionCtrl, [
                    ['organizationID', '=', me.record.get('organizationID')],
                    ['dateFrom', '<=', onDate],
                    ['dateTo', '>=', onDate]
                  ], undefined, ['clearStore', 'clearWhereList'])
                }
              })
              AC.viewUtils.setWhereListProperty(editor.editor.query('[name=stageKind]')[0], [['code', 'in', ['VISA', 'ONLAW']]], undefined, ['clearStore', 'clearWhereList'])
              employeePositionCtrl.on('select', async (ctrl, value) => {
                const selectEmployeePosition = ctrl.getStore().data.items.find(o => o.data.ID === value[0].data.ID)
                if (selectEmployeePosition && selectEmployeePosition.data.positionID) {
                  const position = await UB.Repository('hr_position')
                    .attrs(['ID', 'description'])
                    .where('ID', '=', selectEmployeePosition.data.positionID)
                    .selectSingle()
                  context.record.set('respPositionID', position.ID)
                  respPositionIDCtrl.setValue(position.description)
                } else {
                  respPositionIDCtrl.setValue('')
                }
              })
              respPositionIDCtrl.getStore().reload()
              return true
            }
          }
        ]
      },
      {
        title: UB.i18n('Лист ознайомлення'),
