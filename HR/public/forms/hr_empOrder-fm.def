                }
              },
              {
                name: 'evaluationType',
                config: {
                  hidden: true
                }
              },
              {
                name: 'dictEventKnowledgID.name',
                description: UB.i18n('Подія ознайомлення'),
                config: {
                  width: 150,
                  whereList: {
                    notAdmin: {
                      expression: '[dictEventKnowledgID.organizationID]',
                      condition: '=',
                      value: appAC.globalOrganization()
                    }
                  }
                },
                editor: {
                  allowBlank: false,
                  fieldList: ['name'],
                  gridFieldList: ['name']
                }
              },
              {
                name: 'acquaintanceStatus',
                config: {
                  width: 150
                },
                editor: {
                  fieldList: ['code', 'name'],
                  gridFieldList: ['name'],
                  hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                  readOnly: true
                }
              },
              {
                name: 'introductionDate',
                config: {
                  width: 150
                },
                editor: {
                  readOnly: true
                },
                format: 'd.m.Y'
              },
              {
                name: 'comment',
                config: {
                  width: 300
                },
                editor: {
                  readOnly: true
                }
              }
              ]
            },
            masterFields: ['ID'],
            detailFields: ['orderID'],
            cmpInitConfig: {
              customActions: [
                {
                  tooltip: UB.i18n('Додати з наказу'),
                  text: UB.i18n('Додати з наказу'),
                  iconCls: 'fas fa-tasks',
                  actionId: 'addFromOrder',
                  handler: async function (btn) {
                    const me = btn.up('form')
                    await me.fillAcquaintanceList(me)
                  }
                },
                {
                  xtype: 'button',
                  actionText: UB.i18n('Ознайомити всіх'),
                  showText: true,
                  actionId: 'acquaintAll',
                  handler: async function (btn) {
                    const me = btn.up('form')
                    await me.reviewEmpl(me)
                  }
                }
              ],
              getRowClass: function (record) {
                const { acquaintanceStatus } = record.data
                let rowClass = ''
                switch (acquaintanceStatus) {
                  case 'GETTING_KNOW':
                    rowClass = 'ub-row-blue'
                    break
                  case 'ACQUAINTED':
                    rowClass = 'ub-row-green'
                    break
                  case 'APPEALED':
                    rowClass = 'ub-row-red'
                    break
                }
                return rowClass
              }
            },
            onBeforeEdit: function (editor, context) {
              const evaluationType = context.record.get('evaluationType')
              const me = context.grid.up('form')
              const onDate = appAC.globalApplicationDate()
              const employee = editor.editor.query('[name=employeeID.description]')[0]
              const employeePosition = editor.editor.query('[name=employeePositionID.description]')[0]
              const dictEventKnowledg = editor.editor.query('[name=dictEventKnowledgID.name]')[0]
              const employeeResponsible = editor.editor.query('[name=employeeResponsibleID.description]')[0]
              if (me.record.get('orderState') !== 'PROJECT') {
                dictEventKnowledg.setReadOnly(true)
                employee.setReadOnly(true)
                context.record.data && context.record.data.employeeResponsibleID ? employeePosition.setReadOnly(true) : employeePosition.setReadOnly(false)
                context.record.data && context.record.data.employeePositionID ? employeeResponsible.setReadOnly(true) : employeeResponsible.setReadOnly(false)
              }
              AC.viewUtils.setWhereListProperty(employeePosition, [
                ['organizationID', '=', me.record.get('organizationID')],
                ['dateFrom', '<=', onDate],
                ['dateTo', '>=', onDate]
              ])
              AC.viewUtils.setWhereListProperty(dictEventKnowledg, [
                ['organizationID', '=', me.record.get('organizationID')]
              ])
              AC.viewUtils.setWhereListProperty(employeeResponsible, [
                ['organizationID', '=', me.record.get('organizationID')],
                ['dateFrom', '<=', onDate],
                ['dateTo', '>=', onDate]
              ])
              if (!evaluationType) context.record.set('evaluationType', 'INFO')
              employee.on('select', () => employeePosition.setValue())
              employeePosition.on('select', () => employee.setValue())
              employeeResponsible.setReadOnly((context.record.data['employeePositionID.description'] && context.record.data['employeePositionID.description'].length) || (context.record.data['employeeID.description'] && context.record.data['employeeID.description'].length))
              employeePosition.setReadOnly((context.record.data['employeeResponsibleID.description'] && context.record.data['employeeResponsibleID.description'].length) || (context.record.data['employeeID.description'] && context.record.data['employeeID.description'].length))
              employee.setReadOnly((context.record.data['employeePositionID.description'] && context.record.data['employeePositionID.description'].length) || (context.record.data['employeeID.description'] && context.record.data['employeeID.description'].length) || (context.record.data['employeeResponsibleID.description'] && context.record.data['employeeResponsibleID.description'].length))
              employeeResponsible.on('change', (ctrl, value) => {
                employeePosition.setReadOnly(ctrl.getRawValue())
                employee.setReadOnly(ctrl.getRawValue())
              })
              employeePosition.on('change', (ctrl, value) => {
                employeeResponsible.setReadOnly(ctrl.getRawValue())
                employee.setReadOnly(ctrl.getRawValue())
              })
              employee.on('change', (ctrl, value) => {
                employeeResponsible.setReadOnly(ctrl.getRawValue())
                employeePosition.setReadOnly(ctrl.getRawValue())
              })
              return true
            },
            afterInit: function () {
              const grid = this
              let actCol = Ext.create('Ext.grid.column.Column', {
                xtype: 'actioncolumn',
                dataIndex: 'ID',
                padding: '0 0 0 0',
                align: 'center',
                filterable: false,
                sortable: false,
                width: 120,
                text: UB.i18n('Відправити на ознайомлення'),
                renderer: function (value, meta, record) {
                  let id = Ext.id()
                  const me = this.up('form')
                  Ext.defer(function () {
                    Ext.widget('button', {
                      renderTo: Ext.query('#' + id)[0],
                      tooltip: !['ACQUAINTED', 'GETTING_KNOW'].includes(record.data.acquaintanceStatus) ? UB.i18n('Відправити на ознайомлення') : UB.i18n('Відмінити ознайомлення'),
                      iconCls: !['ACQUAINTED', 'GETTING_KNOW'].includes(record.data.acquaintanceStatus) ? 'far fa-paper-plane' : 'u-icon-close',
                      cls: !['ACQUAINTED', 'GETTING_KNOW'].includes(record.data.acquaintanceStatus) ? 'blue-action' : 'red-action',
                      margin: '0 0 0 0',
                      name: 'sendReview',
                      padding: '0 0 0 0',
                      scale: 'small',
                      // disabled: !['POSTED', 'PROCESSED'].includes(me.record.get('orderState')) || (record.data.acquaintanceStatus === 'ACQUAINTED'),
                      disabled: !['POSTED', 'PROCESSED'].includes(me.record.get('orderState')),
                      handler: function () {
                        me.setLoading(true)
                        let method
                        record.data.selectRowID = record.data.ID
                        method = !['ACQUAINTED', 'GETTING_KNOW'].includes(record.data.acquaintanceStatus) ? 'sendReview' : 'exchangeReview'
                        $App.connection.run({
                          entity: 'hr_empOrder',
                          method,
                          params: JSON.stringify(record.data),
                          docID: me.record.get('ID')
                        }).then(res => {
                          me.attr.acquaintanceList.store.reload()
                          me.setLoading(false)
                        })
                      }
                    })
                  }, 50)
                  return Ext.String.format('<div id="{0}"></div>', id)
                }
              })
              grid.headerCt.insert(grid.columns.length - 2, actCol)
              grid.columns.unshift(actCol)
            },
            optimizeColumnWidth: function () {
              // /!* do nothing for manual column width tunning *!/
            }
          }
        ]
      },
      {
        title: UB.i18n('Лист розсилки'),
        autoScroll: true,
        layout: 'fit',
        flex: 1,
        items: [
