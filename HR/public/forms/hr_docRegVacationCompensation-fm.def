                      iconCls: 'fas fa-angle-double-down',
                      cls: 'fill-action',
                      handler: function (btn) {
                        const me = btn.up('form')
                        me.setAvgDataFromPriorDocument(me)
                      }
                    }
                  ]
                },
                {
                  xtype: 'acGrid',
                  title: '',
                  name: 'accrualAvg',
                  stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_docRegVacationCompensation_accrualAvg'),
                  stateHiddenColumn: false,
                  region: 'center',
                  flex: 1,
                  autoScroll: true,
                  cellEditing: true,
                  notWriteChanges: true,
                  storeType: 'local',
                  showToolBar: false,
                  disablePaging: true,
                  loadMaskMessage: UB.i18n('Завантаження даних...'),
                  summary: {
                    opSum: (store, dataIndex) => {
                      const allRecord = store.data
                      return allRecord.items.reduce((sum, row) => {
                        return sum + (row.get(dataIndex) ? (row.get(dataIndex) || 0) : 0)
                      }, 0)
                    },
                    opDays: (store, dataIndex) => {
                      const allRecord = store.data
                      return allRecord.items.reduce((sum, row) => {
                        return sum + (row.get(dataIndex) ? (row.get(dataIndex) || 0) : 0)
                      }, 0)
                    },
                    baseSum: (store, dataIndex) => {
                      const allRecord = store.data
                      return allRecord.items.reduce((sum, row) => {
                        return sum + (row.get(dataIndex) ? (row.get(dataIndex) || 0) : 0)
                      }, 0)
                    }
                  },
                  // summary: { opSum: 'sum', opDays: 'sum', baseSum: 'sum' },
                  summaryDataOnClient: true,
                  ignoreAttr: ['posName', 'depName'],
                  hideActions: ['addNew', 'del', 'addNewByCurrent'],
                  includeContextMenuReadOnly: [],
                  onBeforeEdit: (control, context) => {
                    context.column.field.prevValue = context.value
                    if (context.record.phantom && context.record.dirtySave !== null) {
                      context.record.dirtySave = null
                    }
                  },
                  edit: (control, context) => {
                    const me = context.grid.up('form')
                    me.onGridEdit(me, 'accrualAvg', context, control)
                    me.setIsDirty(true)
                  },
                  fields: [
                    { name: 'ID' },
                    { name: 'dateFrom' },
                    { name: 'dateTo' },
                    { name: 'orderID' },
                    { name: 'periodID' },
                    { name: 'flagsFix' },
                    { name: 'accrualDt' },
                    {
                      name: 'periodID.name',
                      columnConfig: {
                        text: UB.i18n('Місяць'),
                        sortable: false,
                        flex: 1
                      }
                    },
                    {
                      name: 'opDays',
                      columnConfig: {
                        text: UB.i18n('Днів'),
                        sortable: false,
                        flex: 1,
                        align: 'right',
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 6) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          return value
                        },
                        editor: {
                          dataType: 'Currency',
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 6
                        }
                      }
                    },
                    {
                      name: 'baseSum',
                      columnConfig: {
                        text: UB.i18n('Заробіток, що індексується'),
                        sortable: false,
                        flex: 1,
                        align: 'right',
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          if (_.isNumber(value)) {
                            return Ext.util.Format.currency(value, '', 2).replace(/ /g, '')
                          } else return value
                        },
                        editor: {
                          dataType: 'Currency',
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1
                        }
                      }
                    },
                    {
                      name: 'opKoef',
                      columnConfig: {
                        text: UB.i18n('Коеф. індексації'),
                        flex: 1,
                        sortable: false,
                        align: 'right',
                        floatFormat: 6,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 12) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          if (_.isNumber(value)) {
                            return Ext.util.Format.currency(value, '', 6).replace(/ /g, '')
                          } else return value
                        },
                        editor: {
                          dataType: 'Float',
                          decimalPrecision: 6,
                          minValue: 0,
                          flagsFix: 1 << 12
                        }
                      }
                    },
                    {
                      name: 'baseSumNotIndex',
                      columnConfig: {
                        text: UB.i18n('Заробіток, що не індексується'),
                        flex: 1,
                        align: 'right',
                        sortable: false,
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 13) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          if (_.isNumber(value)) {
                            return Ext.util.Format.currency(value, '', 2).replace(/ /g, '')
                          } else return value
                        },
                        editor: {
                          dataType: 'Currency',
                          sortable: false,
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 13
                        }
                      }
                    },
                    {
                      name: 'opSum',
                      columnConfig: {
                        text: UB.i18n('Сума до розрахунку'),
                        flex: 1,
                        sortable: false,
                        align: 'right',
                        floatFormat: 2
                      }
                    }
                  ],
                  customPopupMenuItems: [
                    {
                      text: UB.i18n('Розрахунковий лист'),
                      iconCls: 'el-icon-tickets',
                      ubID: 'itemShowRl',
                      handler: function (context) {
                        const grid = context.up('').grid
                        const me = grid.up('form')
                        const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                        if (record) {
                          appHR.showRl(me.attr.employeeNumberID.getValue(), record.get('periodID'))
                        }
                      }
                    },
                    {
                      text: UB.i18n('Аналітика'),
                      iconCls: 'el-icon-notebook-2',
                      name: 'dimension',
                      cls: 'blue-action',
                      handler: (context) => {
                        const grid = context.up('').grid
                        const me = grid.up('form')
                        // flagsFix 1 << 0 | 1 << 6 | 1 << 12 | 1 << 13
                        appHR.showtAvgDimensinEdit(me, context.up('').record || AC.gridUtils.getCurrentRecord(grid), 12481, 'calcVacationCompensation')
                      }
                    },
                    {
                      text: UB.i18n('Коригування сум за аналітиками'),
                      name: 'avgDimensionRow',
                      iconCls: 'u-icon-layers',
                      cls: 'blue-action',
                      handler: function (context) {
                        const grid = context.up('').grid
                        const me = grid.up('form')
                        appHR.setAvgDimensionRowEdit(me, context.up('').record || AC.gridUtils.getCurrentRecord(grid), 143553, 'calcVacationCompensation')
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          xtype: 'acGrid',
          name: 'vacationDt',
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_docRegVacationCompensation_vacationDt'),
          title: UB.i18n('Використання відпустки'),
          region: 'center',
          flex: 1,
          autoScroll: true,
          cellEditing: true,
          notWriteChanges: true,
          storeType: 'local',
          showToolBar: true,
          disablePaging: true,
          loadMaskMessage: UB.i18n('Завантаження даних...'),
          hideActions: ['addNewByCurrent', 'addNew', 'del'],
          customToolBarActions: [
            {
              xtype: 'button',
              name: 'fillBtn',
              tooltip: UB.i18n('Заповнити'),
              iconCls: 'fas fa-angle-double-down',
              cls: 'fill-action',
              handler: function (btn) {
                const me = btn.up('form')
                if (me.attr.vacationDt.getStore().count()) {
                  $App.dialogYesNo('Попередження', UB.i18n('Раніше додані записи будуть видалені. Продовжити?'))
                    .then(res => {
                      if (res) {
                        me.recalcVacationDt(true)
                      }
                    })
                } else {
                  me.addVacationPeriods(true)
                }
              }
            },
            {
              xtype: 'button',
              name: 'clearBtn',
              tooltip: UB.i18n('Очистити'),
              iconCls: 'fas fa-eraser',
              cls: 'fill-action',
              handler: function (btn) {
                const me = btn.up('form')
                if (me.attr.vacationDt.getStore().count()) {
                  $App.dialogYesNo('Попередження', UB.i18n('Раніше додані записи будуть видалені. Продовжити?'))
                    .then(function (res) {
                      if (res) {
                        me.attr.vacationDt.removeAll()
                        me.setIsDirty(true)
                        if (!me.isNewInstance) {
                          return me.saveForm()
                        }
                      }
                    })
                }
              }
            }
          ],
          fields: [
            { name: 'ID' },
            { name: 'mi_modifyDate' },
            { name: 'orderID' },
            { name: 'empVacationPeriodID' },
            { name: 'empVacationPeriodID.empVacationPlanID.dictVacationKindID' },
            { name: 'empVacationPeriodID.dateFrom' },
