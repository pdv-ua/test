                text: UB.i18n('Вид відпустки'),
                sortable: false,
                flex: 1
              }
            },
            {
              name: 'empVacationPeriodID.descriptionEx',
              columnConfig: {
                text: UB.i18n('За період роботи'),
                sortable: false,
                flex: 1
              }
            },
            {
              name: 'dayDiff',
              columnConfig: {
                text: UB.i18n('Залишок днів'),
                sortable: false,
                width: 150,
                dataType: 'Int'
              }
            },
            {
              name: 'dayComp',
              columnConfig: {
                text: UB.i18n('Компенсувати днів'),
                sortable: false,
                width: 150,
                dataType: 'Int',
                editor: {
                  dataType: 'Int',
                  allowBlank: false
                }
              }
            }
          ],
          summary: { dayDiff: 'sum', dayComp: 'sum' },
          summaryDataOnClient: true,
          getRowClass: function (record) {
            return record.get('dayDiff') < record.get('dayComp') ? 'grd-color-red' : ''
          },
          edit: (control, context) => {
            const me = context.grid.up('form')
            me.onVacationGridEdit(context.grid)
            me.setIsDirty(true)
          }
        },
        {
          title: UB.i18n('Отримувач'),
          ubID: 'contrAccountTab',
          autoScroll: true,
          layout: { type: 'vbox', align: 'stretch' },
