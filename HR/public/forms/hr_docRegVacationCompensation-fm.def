            },
            {
              layout: { type: 'border' },
              region: 'center',
              items: [
                {
                  region: 'north',
                  layout: { type: 'hbox' },
                  items: [
                    {
                      xtype: 'button',
                      name: 'avgDimension',
                      iconCls: 'u-icon-layers',
                      cls: 'blue-action',
                      tooltip: UB.i18n('Коригування сум за аналітиками'),
                      handler: function (btn) {
                        const me = btn.up('form')
                        appHR.setAvgDimensionEdit(me, 'accrualAvg', 143553, 'calcVacationCompensation')
                      }
                    },
                    {
                      xtype: 'button',
                      name: 'fillBtn',
                      text: UB.i18n('Додати суми з попереднього документу'),
