/* global Ext $App AC HR UB appAC */
exports.formDef = 'HR.hr_empListdictPosition'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.hr_empListdictPosition', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.hr_empListdictPosition',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox' },
            collapsed: false,
            items: [
              {
                layout: { type: 'vbox' },
                xtype: 'panel',
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getOrgCombo({
                        labelWidth: 160,
                        width: 700,
                        flex: 1,
                        readOnly: !accMainReportsSubOrg,
                        ubRequest: {
                          entity: 'hr_organization',
                          fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              values: {
                                state: 'ACTIVE'
                              }
                            },
                            path: {
                              expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                              condition: accMainReportsSubOrg ? 'like' : '=',
                              values: {
                                state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                              }
                            }
                          },
                          orderList: { orderBy: { expression: 'description' } },
                          __mip_ondate: appAC.globalApplicationDate()
                        },
                        listeners: {
                          change: function (ctrl) {
                            const form = ctrl.up('form')
                            HR.controlService.onChangeIncludeChildOrgs(form)
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildOrgs(accMainReportsSubOrg, {
                        listeners: {
                          change: function (ctrl, value) {
                            const form = ctrl.up('form')
                            HR.controlService.onChangeIncludeChildOrgs(form)
                          }
                        }
                      })
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getDepCombo({
                        labelWidth: 160,
                        width: 700,
                        displayField: 'description',
                        flex: 1,
                        listeners: {
                          change: function (ctrl, value) {
                            const form = ctrl.up('form')
                            form.down('[name=includeChildDepts]').setReadOnly(!value)
                            if (!value) {
                              form.down('[name=includeChildDepts]').setValue()
                            }
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildDepts()
                    ]
                  },
                  {
                    xtype: 'panel',
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubdatefield',
                        labelWidth: 160,
                        name: 'dateTo',
                        fieldLabel: UB.i18n('Станом на'),
                        allowBlank: false
                      }
                    ]
                  },
                  {
                    xtype: 'combo',
                    labelWidth: 160,
                    editable: false,
                    name: 'Verify',
                    fieldLabel: UB.i18n('Перевірити'),
                    width: 700,
                    allowBlank: false,
                    store: Ext.create('Ext.data.Store', { fields: ['text', 'value'],
                      data: [
                        { text: 'Довідник посад', value: 'hr_dictPosition' },
                        { text: 'Тип посади держслужбовця', value: 'hr_dictWagePay' },
                        { text: 'Категорія персоналу', value: 'hr_dictStaffCat' },
                        { text: 'Підкатегорія персоналу', value: 'hr_dictStaffSubCat' },
                        { text: 'Група оплати праці держслужбовців', value: 'hr_dictStatePay' },
                        { text: 'Вид оплати', value: 'hr_payEl' },
                        { text: 'Джерело фінансування', value: 'hr_positionfundsource' },
                        { text: 'Графік роботи', value: 'hr_workSchedule' },
                        { text: 'Спеціальність', value: 'hr_specialty' },
                        { text: 'Кваліфікаційна категорія', value: 'hr_dictEmpCategory' },
                        { text: 'Тарифний розряд', value: 'hr_dictTarifCoeff' },
                        { text: 'Вид посади', value: 'hr_dictPositionKind' },
                        { text: 'Група посади', value: 'hr_dictPositionGroup' },
                        { text: 'Група (рівень) за схемою посадових окладів', value: 'hr_dictSalarySchemeLevel' },
                        { text: 'Місце виникнення виробничих витрат', value: 'ac_dictCostType' },
                        { text: 'Військове звання', value: 'hr_dictMilitaryRank' },
                        { text: 'Військово-облікова спеціальність', value: 'hr_dictMilitarySpeciality' },
                        { text: 'Вчене звання', value: 'hr_dictAcademStatus' },
                        { text: 'Науковий ступінь', value: 'hr_dictDegree' }
                      ]
                    })
                  }
                ]
              },
              {
                layout: { type: 'hbox' },
                margin: '60 0 0 0',
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Шукати'),
                    iconCls: 'fas fa-search',
                    width: 30,
                    cls: 'green-action',
                    margin: '5 5 0 15',
                    handler: async function (btn) {
                      if (!me.attr.Verify.getValue() || !me.attr.dateTo.getValue() || !me.attr.organizationID.getValue()) {
                        $App.dialogError(UB.i18n('Не задані параметри пошуку!'), UB.i18n('Помилка'))
                      } else {
                        const myEntity = me.attr.Verify.getStore().findRecord('text', me.attr.Verify.getValue()).get('value')
                        const dateTo = me.attr.dateTo.getValue()
                        let orgIDs = []

                        if (me.attr.organizationID.getValue()) {
                          orgIDs = [me.attr.organizationID.getValue()]
                          if (me.attr.includeChildOrgs.getValue()) {
                            const orgs = await UB.Repository('hr_organization')
                              .attrs(['mi_data_id'])
                              .where('state', '=', 'ACTIVE')
                              .where('mi_treePath', 'like', `%/${me.attr.organizationID.getValue()}/%`)
                              .groupBy('mi_data_id')
                              .misc({ __mip_recordhistory_all: true })
                              .selectAsObject()
                            if (orgs.length) {
                              orgIDs = orgs.map(o => o.mi_data_id)
                            }
                          }
                        } else {
                          orgIDs = [me.attr.orgID.getValue()]
                        }

                        let depName = ''
                        let deptIDs = null
                        if (me.attr.departmentID.getValue()) {
                          const dept = await UB.Repository('hr_department')
                            .attrs(['description', 'fullName', 'mi_treePath'])
                            .where('mi_data_id', '=', me.attr.departmentID.getValue())
                            .where('state', '=', 'ACTIVE')
                            .misc({ __mip_ondate: me.attr.dateTo.getValue() })
                            .selectSingle()
                          depName = dept.description || dept.fullName

                          if (me.attr.includeChildDepts.getValue()) {
                            depName += ' (з підлеглими)'
                            const departments = await UB.Repository('hr_department')
                              .attrs(['mi_data_id'])
                              .where('orgID', '=', me.attr.organizationID.getValue())
                              .where('state', '=', 'ACTIVE')
                              .where('mi_treePath', 'startsWith', dept.mi_treePath)
                              .misc({ __mip_recordhistory_all: true })
                              .groupBy('mi_data_id')
                              .selectAsObject()
                            if (departments.length) {
                              deptIDs = departments.map(o => o.mi_data_id)
                            } else {
                              deptIDs = [me.attr.departmentID.getValue()]
                            }
                          } else {
                            deptIDs = [me.attr.departmentID.getValue()]
                          }
                        }

                        const mParams = {
                          deptIDs,
                          orgIDs,
                          myEntity,
                          dateTo
                        }

                        const result = await $App.connection.run({
                          entity: 'hr_report',
                          method: 'getListControlDictPosition',
                          resultData: '',
                          params: mParams
                        })

                        const resoultQuerry = JSON.parse(result.params.resultData)

                        me.attr.accrual.setLocalStoreData(resoultQuerry)
                      }
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Очистити'),
                    iconCls: 'fas fa-eraser',
                    width: 30,
                    cls: 'fill-action',
                    margin: '5 0 0 0',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.clearSearch()
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        xtype: 'acGrid',
        name: 'accrual',
        region: 'center',
        autoScroll: true,
        hideActions: ['addNew', 'del', 'addNewByCurrent', 'edit'],
        loadStoreImmediately: false,
        forceDataLoad: true,
        exportExcel: true,
        flex: 1,
        storeType: 'local',
        disablePaging: true,
        showToolBar: true,
        onItemDoubleClick: function (row, record) {
          $App.doCommand({
            cmdType: 'showForm',
            formCode: 'hr_position',
            entity: 'hr_position',
            tabId: 'hr_position' + '-' + record.get('ID'),
            target: $App.getViewport().centralPanel,
            instanceID: record.get('ID')
          })
        },
        customPopupMenuItems: [
          {
            text: UB.i18n('Відкрити картку посади'),
            ubID: 'itemShowRl',
            handler: function (context) {
              const grid = context.up('').grid
              const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
              $App.doCommand({
                cmdType: 'showForm',
                formCode: 'hr_position',
                entity: 'hr_position',
                tabId: 'hr_position' + '-' + record.get('ID'),
                target: $App.getViewport().centralPanel,
                instanceID: record.get('ID')
              })
            }
          }
        ],
        pageSize: 10000,
        hidePagingBar: true,
        fields: [
          {
            name: 'ID',
            columnConfig: {
              text: UB.i18n('ID'),
              flex: 1
            }
          },
          {
            name: 'code',
            columnConfig: {
              text: UB.i18n('Код посади'),
              flex: 1
            }
          },
          {
            name: 'name',
            columnConfig: {
              text: UB.i18n('Назва посади'),
              flex: 1
            }
          },
          {
            name: 'depName',
            columnConfig: {
              text: UB.i18n('Підрозділ'),
              flex: 1
            }
          },
          {
            name: 'orgName',
            columnConfig: {
              text: UB.i18n('Організація'),
              flex: 1
            }
          },
          {
            name: 'DescriptionProblem',
            columnConfig: {
              text: UB.i18n('Опис проблеми'),
              flex: 1
            }
          }
        ]
      }
    ]

    me.clearData = function () {
      const epmGrid = me.down('[name=employeeNumberListGrid]')
      if (epmGrid && epmGrid.store && epmGrid.store.data) {
        epmGrid.store.data.items = []
        epmGrid.view.refresh()
      }
    }

    me.setDefaultParams = () => {
      const me = this
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.includeChildOrgs.setValue()
      me.attr.departmentID.setValue()
      me.attr.includeChildDepts.setValue()
      me.attr.dateTo.setValue(appAC.globalApplicationDate())
      me.attr.Verify.setValue()
    }

    me.clearSearch = () => {
      me.setDefaultParams(false)
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        accrual: me.down('[name=accrual]'),
        dateTo: me.down('[name=dateTo]'),
        organizationID: me.down('[name=organizationID]'),
        includeChildOrgs: me.down('[name=includeChildOrgs]'),
        departmentID: me.down('[name=departmentID]'),
        includeChildDepts: me.down('[name=includeChildDepts]'),
        Verify: me.down('[name=Verify]')
      }
      me.setDefaultParams(true)
    }, me)

    me.callParent(arguments)
  }
})
