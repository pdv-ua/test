/* global Ext UB appAC $App AC */

exports.formDef = 'HR.contenderPosition'

Ext.define('HR.contenderPosition', {
  extend: 'Ext.panel.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.contenderPosition',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,

  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        header: false,
        region: 'center',
        flex: 1,
        layout: 'fit',
        items: [
          {
            xtype: 'ubdetailgrid',
            name: 'contenderPositionGrid',
            autoScroll: true,
            flex: 1,
            hideActions: ['addNewByCurrent', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
            stateful: true,
            stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_contenderPosition_grid'),
            cmdType: 'showList',
            description: UB.i18n('Кандидати на посаду'),
            entity: 'hr_contenderPosition',
            cmdData: {
              params: [{
                entity: 'hr_contenderPosition',
                method: 'select',
                fieldList: [
                  { name: 'fullName', description: UB.i18n('ПІБ особи кандидата') },
                  { name: 'positionName', description: UB.i18n('Опис вакансії') },
                  { name: 'supervisorID.employeeID.fullFIO', description: UB.i18n('Безпосередній керівник') },
                  { name: 'recruterID.employeeID.fullFIO', description: UB.i18n('Рекрутер') },
                  { name: 'typeID.name', description: UB.i18n('Вид найму') },
                  { name: 'sourceID.name', description: UB.i18n('Джерело найму') },
                  { name: 'workerType', description: UB.i18n('Форма зайнятості') },
                  { name: 'dateApprove', description: UB.i18n('Дата призначення'), format: 'd.m.Y' },
                  { name: 'note', visibility: false },
                  { name: 'dateFrom', format: 'd.m.Y' },
                  { name: 'dateTo', format: 'd.m.Y' },
                  { name: 'resume', visibility: false },
                  { name: 'status' }
                ],
                __mip_recordhistory_all: true,
                whereList: {
                  organizationID: {
                    expression: '[organizationID]',
                    condition: '=',
                    value: appAC.globalOrganization()
                  }
                }
              }]
            }
          }
        ]
      }
    ]
    me.changeGlobal = function () {
      const store = me.down('ubdetailgrid').getStore()
      const globalOrganization = appAC.globalOrganization()
      AC.viewUtils.setWhereListProperty(me.down('ubdetailgrid'), [['organizationID', 'equal', globalOrganization]], undefined, ['clearStore', 'clearWhereList'])
      store.load()
    }
    me.on('afterrender', () => {
      $App.on('ac:app:organizationChanged', me.changeGlobal)
    })
    me.on('destroy', () => {
      $App.un('ac:app:organizationChanged', me.changeGlobal)
    }, me)
    me.callParent(arguments)
  }
})
