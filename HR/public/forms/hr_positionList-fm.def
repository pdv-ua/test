/* global Ext AC $App appAC UB */

exports.formDef = 'HR.positionList'

Ext.define('HR.positionList', {
  extend: 'Ext.panel.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.positionList',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,

  initComponent: function () {
    const me = this
    me.items = [
      {
        xtype: 'panel',
        header: false,
        region: 'center',
        flex: 1,
        layout: 'fit',
        items: [
          {
            xtype: 'ubdetailgrid',
            autoScroll: true,
            layout: 'fit',
            flex: 1,
            hideActions: ['addNew', 'addNewByCurrent', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
            stateful: true,
            stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_positionList_grid'),
            cmdType: 'showList',
            description: UB.i18n('Посада'),
            entity: 'hr_position',
            cmdData: {
              params: [{
                entity: 'hr_position',
                method: 'select',
                fieldList: [
                  { name: 'name', description: UB.i18n('Назва') },
                  { name: 'nameAddition', description: UB.i18n('Доповнення до назви') },
                  { name: 'fullName', description: UB.i18n('Назва штатної позиції') },
                  { name: 'reformer', description: UB.i18n('Фахівець з питань реформ') },
                  { name: 'fullNameGen', description: UB.i18n('Повна назва у родовому відмінку') },
                  { name: 'fullNameDat', description: UB.i18n('Повна назва у давальному відмінку') },
                  { name: 'fullNameAcc', description: UB.i18n('Повна назва у знахідному відмінку') },
                  { name: 'fullNameOr', description: UB.i18n('Повна назва у орудному відмінку') },
                  { name: 'fullNameLoc', description: UB.i18n('Повна назва у місцевому відмінку') },
                  { name: 'dictPositionID.name', description: UB.i18n('Довідник посад - назва посади') },
                  { name: 'dictPositionID.nameNom', description: UB.i18n('Довідник посад - назва посади в називному') },
                  { name: 'workScheduleID.caption', description: UB.i18n('Графік роботи') },
                  { name: 'parentUnitID.name', description: UB.i18n('Підпорядкування') },
                  { name: 'positionType', description: UB.i18n('Тип посади') },
                  { name: 'dictWagePayID.name', description: UB.i18n('Тип посади держслужбовця') },
                  { name: 'psCategory', description: UB.i18n('Категорія посади держслужбовця') },
                  { name: 'dictStatePayID.name', description: UB.i18n('Група оплати праці держслужбовців') },
                  { name: 'payElID.name', description: UB.i18n('Вид оплати') },
                  { name: 'accrualSum', description: UB.i18n('Сума') },
                  { name: 'dictPositionID.dictProfessionID.code', description: UB.i18n('Державний класифікатор') },
                  { name: 'code', description: UB.i18n('Код') },
                  { name: 'state', description: UB.i18n('Стан') },
                  { name: 'mi_dateFrom', description: UB.i18n('Дата початку дії'), format: 'd.m.Y' },
                  { name: 'dateToEmpty', description: UB.i18n('Дата закінчення дії'), format: 'd.m.Y' },
                  { name: 'entryOrderID.description', description: UB.i18n('Наказ') },
                  { name: 'staffOrderID.description', description: UB.i18n('Штатний розпис') },
                  { name: 'description', description: UB.i18n('Опис'), visibility: false },
                  { name: 'dictTarifCoeffID.name', description: UB.i18n('Тарифний розряд') },
                  { name: 'dictSpecialtyID.name', description: UB.i18n('Спеціальність') },
                  { name: 'dictEmpCategoryID.name', description: UB.i18n('Кваліфікаційна категорія') },
                  { name: 'dictStaffCatID.name', description: UB.i18n('Категорія персоналу') },
                  { name: 'dictStaffSubCatID.name', description: UB.i18n('Підкатегорія персоналу') },
                  { name: 'positionCategory', description: UB.i18n('Категорія посади') },
                  { name: 'paymentType', description: UB.i18n('Тип оплати') },
                  { name: 'dictSalarySchemeLevelID.name', description: UB.i18n('Схема посадових окладів') },
                  { name: 'dictCostTypeID.description', description: UB.i18n('Місце виникнення витрат') },
                  { name: 'dictCostTypeID.accountID.description', description: UB.i18n('Рахунок витрат') },
                  { name: 'quantity', description: UB.i18n('Кількість посад') },
                  { name: 'dictPositionKindID', description: UB.i18n('Вид посади') },
                  { name: 'dictPositionGroupID', description: UB.i18n('Група посади') },
                  { name: 'fundSourceName', description: UB.i18n('Джерело фінансування') },
                  { name: 'parentUnitDepName', description: UB.i18n('Підпорядкування підрозділу') },
                  { name: 'fundBasePay', description: UB.i18n('Фонд основної заробітної плати') },
                  { name: 'fundAddPay', description: UB.i18n('Фонд додаткової заробітної плати') },
                  { name: 'fundOtherPay', description: UB.i18n('Інші заохочувальні та компенсаційні виплати') },
                  { name: 'fundTotal', description: UB.i18n('Сума доплат та надбавок') },
                  { name: 'addDescrPosition', description: UB.i18n('Додаткова інформація') },
                  { name: 'comment', description: UB.i18n('Примітка') },
                  { name: 'dictMilitaryRankID.description', description: UB.i18n('Військове звання') },
                  { name: 'dictAcademStatusID.name', description: UB.i18n('Вчене звання') },
                  { name: 'dictDegreeID.name', description: UB.i18n('Науковий ступінь') }
                ],
                __mip_recordhistory_all: true,
                whereList: {
                  parentIsNull: {
                    expression: '[parentUnitID]',
                    condition: 'isNull'
                  },
                  parentDateFrom: {
                    expression: '[parentUnitID.mi_dateFrom]',
                    condition: 'lessEqual',
                    value: appAC.globalApplicationDate()
                  },
                  parentDateTo: {
                    expression: '[parentUnitID.mi_dateTo]',
                    condition: 'moreEqual',
                    value: appAC.globalApplicationDate()
                  },
                  parentState: {
                    expression: '[parentUnitID.state]',
                    condition: '=',
                    value: 'ACTIVE'
                  },
                  dateFrom: {
                    expression: '[mi_dateFrom]',
                    condition: 'lessEqual',
                    value: appAC.globalApplicationDate()
                  },
                  dateTo: {
                    expression: '[mi_dateTo]',
                    condition: 'moreEqual',
                    value: appAC.globalApplicationDate()
                  },
                  state: {
                    expression: '[state]',
                    condition: '=',
                    value: 'ACTIVE'
                  }
                },
                logicalPredicates: ['([parentIsNull] OR ([parentState] AND [parentDateFrom] AND [parentDateTo]))']
              }]
            },
            cmpInitConfig: {
              afterInit: function () {
                AC.gridUtils.setGlobalOrganization(this, 'orgID')
                if (!AC.entityUtils.verifyRightsMethod(this.entityName, 'delete')) {
                  this.hideAction('del', true)
                }
              }
            }
          }
        ]
      }
    ]

    me.setGridVisibile = function () {
      const funcOrgType = AC.settings.get('hrFuncOrgType', appAC.globalOrganization())
      switch (funcOrgType) {
        case '1':
          AC.gridUtils.setGridColumnVisible(me, ['dictEmpCategoryID.name'], true)
          AC.gridUtils.setGridColumnVisible(me, ['dictSpecialtyID.name'], true)
          AC.gridUtils.setGridColumnVisible(me, ['dictWagePayID.name'], false)
          AC.gridUtils.setGridColumnVisible(me, ['psCategory'], false)
          AC.gridUtils.setGridColumnVisible(me, ['dictStatePayID.name'], false)
          AC.gridUtils.setGridColumnVisible(me, ['dictStaffCatID.name'], true)
          AC.gridUtils.setGridColumnVisible(me, ['dictStaffSubCatID.name'], true)
          break
        default:
          AC.gridUtils.setGridColumnVisible(me, ['dictEmpCategoryID.name'], false)
          AC.gridUtils.setGridColumnVisible(me, ['dictSpecialtyID.name'], false)
          AC.gridUtils.setGridColumnVisible(me, ['dictWagePayID.name'], true)
          AC.gridUtils.setGridColumnVisible(me, ['psCategory'], true)
          AC.gridUtils.setGridColumnVisible(me, ['dictStatePayID.name'], true)
          AC.gridUtils.setGridColumnVisible(me, ['dictStaffCatID.name'], false)
          AC.gridUtils.setGridColumnVisible(me, ['dictStaffSubCatID.name'], false)
          break
      }
    }

    me.changeGlobal = function () {
      const store = me.down('ubdetailgrid').getStore()
      const globalDate = appAC.globalApplicationDate()
      store.ubRequest.whereList.parentDateFrom.value = globalDate
      store.ubRequest.whereList.parentDateTo.value = globalDate
      store.ubRequest.whereList.dateFrom.value = globalDate
      store.ubRequest.whereList.dateTo.value = globalDate
      store.load()
    }

    me.on('afterrender', () => {
      $App.on('ac:app:operationDateChanged', me.changeGlobal)
      $App.on('ac:app:organizationChanged', me.setGridVisibile)
      me.setGridVisibile()
    }, me)
    me.on('destroy', () => {
      $App.un('ac:app:operationDateChanged', me.changeGlobal)
      $App.un('ac:app:organizationChanged', me.setGridVisibile)
    }, me)
    me.callParent(arguments)
  }

})
