/* global Ext AC appAC $App HR UB */
exports.formDef = 'HR.empListProfEducation'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.empListProfEducation', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.empListProfEducation',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox' },
            autoScroll: true,
            collapsed: false,
            items: [
              {
                layout: { type: 'vbox', align: 'stretch' },
                items: [
                  {
                    layout: { type: 'vbox' },
                    items: [
                      {
                        layout: { type: 'hbox' },
                        items: [
                          HR.controlService.getOrgCombo({
                            labelWidth: 230,
                            width: 700,
                            flex: 1,
                            readOnly: !accMainReportsSubOrg,
                            ubRequest: {
                              entity: 'hr_organization',
                              fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                              whereList: {
                                state: {
                                  expression: '[state]',
                                  condition: '=',
                                  values: {
                                    state: 'ACTIVE'
                                  }
                                },
                                path: {
                                  expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                                  condition: accMainReportsSubOrg ? 'like' : '=',
                                  values: {
                                    state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                                  }
                                }
                              },
                              orderList: { orderBy: { expression: 'description' } },
                              __mip_ondate: appAC.globalApplicationDate()
                            },
                            listeners: {
                              change: function (ctrl) {
                                const form = ctrl.up('form')
                                HR.controlService.onChangeIncludeChildOrgs(form)
                              }
                            }
                          }),
                          HR.controlService.getIncludeChildOrgs(accMainReportsSubOrg)
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        items: [
                          HR.controlService.getDepCombo({
                            labelWidth: 230,
                            width: 700,
                            displayField: 'description',
                            flex: 1,
                            listeners: {
                              change: function (ctrl, value) {
                                const form = ctrl.up('form')
                                form.down('[name=includeChildDepts]').setReadOnly(!value)
                                if (!value) {
                                  form.down('[name=includeChildDepts]').setValue()
                                }
                              }
                            }
                          }),
                          HR.controlService.getIncludeChildDepts()
                        ]
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubdatefield',
                        labelWidth: 230,
                        name: 'dateFrom',
                        fieldLabel: UB.i18n('Дата початку з '),
                        allowBlank: false
                      },
                      {
                        xtype: 'ubdatefield',
                        labelWidth: 40,
                        name: 'dateTo',
                        fieldLabel: UB.i18n('по'),
                        allowBlank: false
                      },
                      {
                        xtype: 'checkboxfield',
                        labelWidth: 90,
                        name: 'foreign',
                        fieldLabel: UB.i18n('Закордонні'),
                        listeners: {
                          change: function (fld) {
                            const me = fld.up('form')
                            me.attr.grid.getStore().ubRequest.foreign = me.attr.foreign.getValue() ? 1 : 0
                          }
                        }
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubcombobox',
                        name: 'dictProfCompDevelopFormID',
                        fieldLabel: UB.i18n('Вид професійного навчання'),
                        labelWidth: 230,
                        width: 700,
                        ubRequest: {
                          entity: 'hr_dictProfCompDevelopForm',
                          fieldList: ['ID', 'name']
                        }
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubcombobox',
                        name: 'dictProfCompetencyID',
                        fieldLabel: UB.i18n('Найменування професійної компетентності'),
                        labelWidth: 230,
                        width: 700,
                        ubRequest: {
                          entity: 'hr_dictProfCompetency',
                          fieldList: ['ID', 'name']
                        }
                      }
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'ubcombobox',
                        gridFieldList: ['ID', 'name'],
                        name: 'dictTrainingTopicName',
                        fieldLabel: UB.i18n('Тематика містить'),
                        ubRequest: {
                          entity: 'hr_dictTrainingTopic',
                          fieldList: ['ID', 'name'],
                          orderList: { orderBy: { 'expression': 'name', 'order': 'asc' } }
                        },
                        isFormField: true,
                        displayField: 'name',
                        allowCustomText: true,
                        maxLength: 500,
                        margin: '5 15 10 15',
                        labelWidth: 230,
                        width: 700,
                        triggerCls: 'hr-list-trigger',
                        listeners: {
                          blur: ctrl => {
                            ctrl.setValue(ctrl.rawValue)
                          },
                          focus: ctrl => {
                            ctrl.inputEl.dom.setAttribute('maxlength', 500)
                          },
                          select: ctrl => {
                            ctrl.setValue(ctrl.rawValue)
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                layout: { type: 'hbox' },
                padding: '55 0 0 0',
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Шукати'),
                    iconCls: 'fas fa-search',
                    width: 30,
                    cls: 'green-action',
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.searchEmployee()
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Очистити'),
                    iconCls: 'fas fa-eraser',
                    width: 30,
                    cls: 'fill-action',
                    margin: '5 0 0 0',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.clearSearch()
                    }
                  },
                  {
                    xtype: 'button',
                    iconCls: 'fas fa-print',
                    width: 30,
                    cls: 'blue-action',
                    margin: '5 0 0 0',
                    tooltip: UB.i18n('Друкувати'),
                    handler: function () {
                      me.doReport()
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        xtype: 'ubdetailgrid',
        name: 'empListGrid',
        region: 'center',
        flex: 1,
        autoScroll: true,
        loadStoreImmediately: false,
        forceDataLoad: true,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink',
          'commandLink', 'showDetail', 'audit'],
        cmdData: {
          params: [{
            entity: 'hr_empListProfEducation',
            method: 'search',
            fieldList: [
              { name: 'employeeID', visibility: false },
              // { name: 'employeeNumberID', visibility: false },
              { name: 'fullFIO', description: UB.i18n('ПІБ (Таб. №)'), tooltip: UB.i18n('Прізвище, Ім\'я, По батькові, Таб. №'), config: { width: 200 } },
              { name: 'dictTrainingTopicName', description: UB.i18n('Тематика'), tooltip: UB.i18n('Тематика навчання') },
              { name: 'dateFrom', description: UB.i18n('Дата з'), tooltip: UB.i18n('Дата початку навчання'), format: 'd.m.Y', config: { align: 'center', width: 100 } },
              { name: 'dateTo', description: UB.i18n('Дата по'), tooltip: UB.i18n('Дата закінчення навчання'), format: 'd.m.Y', config: { align: 'center', width: 100 } },
              { name: 'educationName', description: UB.i18n('Заклад освіти'), tooltip: UB.i18n('Заклад освіти') },
              { name: 'dictProfCompDevelopFormName', description: UB.i18n('Вид навчання'), tooltip: UB.i18n('Вид професійного навчання') },
              { name: 'hours', description: UB.i18n('Кількість годин'), tooltip: UB.i18n('Кількість годин') },
              { name: 'ects', description: UB.i18n('Кредит ЄКТС'), tooltip: UB.i18n('Кредит ЄКТС') },
              { name: 'groupCategory', description: UB.i18n('Категорія'), tooltip: UB.i18n('Категорія') },
              { name: 'addDescrPerson', description: UB.i18n('Додаткова інформація') },
              { name: 'posName', description: UB.i18n('Посада'), tooltip: UB.i18n('Посада') },
              { name: 'actualPositionName', description: UB.i18n('Фактична посада'), tooltip: UB.i18n('Фактична посада') },
              { name: 'country', description: UB.i18n('Країна'), tooltip: UB.i18n('Країна, де проходить навчання') },
              { name: 'depName', description: UB.i18n('Підрозділ'), tooltip: UB.i18n('Підрозділ') },
              { name: 'selfStructDepName', description: UB.i18n('Самостійний структурний підрозділ') },
              { name: 'orgName', description: UB.i18n('Організація') }
            ]
          }]
        },
        cmpInitConfig: {
          onDeterminateForm: HR.employeeTabs.onDeterminateCard,

          onItemDblClick: function (grid, record) {
            HR.employeeTabs.runEmpCard({
              employeeID: record.get('employeeID'),
              employeeNumberID: record.get('employeeNumberID'),
              isModal: false,
              nodeId: 'hr_empCertificatnUp',
              customParams: {
                readOnlyExceptActive: true
              }
            })
          },

          listeners: {
            render: (grid) => {
              grid.menu.removeAll()
              grid.menu.add([HR.employeeTabs.getEmpCardMenu(grid)])
              const showAddDescrPerson = !!AC.settings.get('hrShowAddDescrPerson', appAC.globalOrganization())
              const colPersonDescr = AC.gridUtils.getColumnByIndex(grid, 'addDescrPerson')
              colPersonDescr.setVisible(showAddDescrPerson)
              const useActualPositionName = AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization()) === true
              const colActualPositionName = AC.gridUtils.getColumnByIndex(grid, 'actualPositionName')
              colActualPositionName.setVisible(useActualPositionName)
            }
          }
        },
        getExportTitle: function () {
          return UB.i18n('Працівники за професійним навчанням')
        }
      }
    ]

    me.setDefaultParams = (isInit) => {
      const me = this
      me.attr.dateFrom.setValue(AC.dateService.firstDayOfMonth(new Date()))
      me.attr.dateTo.setValue(AC.dateService.lastDayOfMonth(new Date()))
      me.attr.foreign.setValue()
      me.attr.dictProfCompDevelopFormID.setValue()
      me.attr.dictProfCompetencyID.setValue()
      me.attr.dictTrainingTopicName.setValue()
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.includeChildOrgs.setValue()
      me.attr.departmentID.setValue()
      me.attr.includeChildDepts.setValue()
    }

    me.clearSearch = () => {
      me.setDefaultParams(false)
    }

    me.searchEmployee = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      const store = me.attr.grid.getStore()
      let req = store.ubRequest
      req.organizationID = me.attr.organizationID.getValue()
      req.includeChildOrgs = me.attr.includeChildOrgs.getValue()
      req.departmentID = me.attr.departmentID.getValue()
      req.includeChildDepts = me.attr.includeChildDepts.getValue()
      req.dateFrom = me.attr.dateFrom.getValue()
      req.dateTo = me.attr.dateTo.getValue()
      req.foreign = me.attr.foreign.getValue()
      req.dictProfCompDevelopFormID = me.attr.dictProfCompDevelopFormID.getValue()
      req.dictProfCompetencyID = me.attr.dictProfCompetencyID.getValue()
      req.dictTrainingTopicName = me.attr.dictTrainingTopicName.getValue()
      req.onDate = appAC.globalApplicationDate()
      store.load()
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[name=empListGrid]'),
        dateFrom: me.down('[name=dateFrom]'),
        dateTo: me.down('[name=dateTo]'),
        foreign: me.down('[name=foreign]'),
        dictProfCompDevelopFormID: me.down('[name=dictProfCompDevelopFormID]'),
        dictProfCompetencyID: me.down('[name=dictProfCompetencyID]'),
        dictTrainingTopicName: me.down('[name=dictTrainingTopicName]'),
        organizationID: me.down('[name=organizationID]'),
        includeChildOrgs: me.down('[name=includeChildOrgs]'),
        departmentID: me.down('[name=departmentID]'),
        includeChildDepts: me.down('[name=includeChildDepts]')
      }
      me.setDefaultParams(true)
    }, me)

    me.validateParams = () => {
      let res
      let params = []
      let dateFromCtrl = me.attr.dateFrom
      let dateFrom = dateFromCtrl.getValue()
      if (!dateFrom || !dateFromCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Дата початку з"')))
      }
      let dateToCtrl = me.attr.dateTo
      let dateTo = dateToCtrl.getValue()
      if (!dateTo || !dateToCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"по"')))
      }
      if (!me.attr.organizationID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Організація"')))
      }
      if (params.length) {
        res = {
          msg: UB.i18n(`Не вибрано наступні параметри:<br/>{0}`, params.join(',<br/>'))
        }
      } else {
        if (dateFrom > dateTo) {
          res = {
            msg: UB.i18n(`{0} не може перевищувати дату {1}`, AC.viewUtils.formatFieldLabel('"Дата початку з "'), AC.viewUtils.formatFieldLabel('"по"'))
          }
        }
      }
      return res
    }

    me.report_code = 'hr_empListProfEducation'
    me.doReport = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }

      const execParams = {
        organizationID: me.attr.organizationID.getValue(),
        includeChildOrgs: me.attr.includeChildOrgs.getValue(),
        departmentID: me.attr.departmentID.getValue(),
        includeChildDepts: me.attr.includeChildDepts.getValue(),
        dateFrom: me.attr.dateFrom.getValue(),
        dateTo: me.attr.dateTo.getValue(),
        foreign: me.attr.foreign.getValue(),
        dictProfCompDevelopFormID: me.attr.dictProfCompDevelopFormID.getValue(),
        dictProfCompetencyID: me.attr.dictProfCompetencyID.getValue(),
        dictTrainingTopicName: me.attr.dictTrainingTopicName.getValue(),
        onDate: appAC.globalApplicationDate()
      }

      let gridStore = me.attr.grid.getStore()
      let gridData = gridStore && gridStore.data && gridStore.data.items && gridStore.data.items.length > 0 ? gridStore.data.items.map(item => item.data) : null

      $App.doCommand({
        cmdType: 'showReport',
        caption: UB.i18n('Друкована форма'),
        tabId: 'printDocument' + me.report_code + Date.now(),
        target: $App.getViewport().centralPanel,
        cmdData: {
          reportCode: me.report_code,
          reportParams: {
            execParams,
            gridData,
            orgID: appAC.globalOrganization(),
            onDate: appAC.globalApplicationDate()
          },
          reportOptions: {
            allowExportToExcel: true,
            isModal: false
          }
        }
      })
    }

    me.callParent(arguments)
  }
})
