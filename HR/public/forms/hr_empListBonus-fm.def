/* global Ext AC $App appAC HR UB */
exports.formDef = 'HR.empListBonus'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.empListBonus', {
  extend: 'Ext.form.Panel',
  height: 600,
  width: 800,
  layout: 'border',
  alias: 'widget.empListBonus',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox' },
            autoScroll: true,
            collapsed: false,
            items: [
              {
                layout: { type: 'vbox' },
                xtype: 'panel',
                autoScroll: true,
                items: [
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getOrgCombo({
                        labelWidth: 160,
                        width: 700,
                        flex: 1,
                        readOnly: !accMainReportsSubOrg,
                        ubRequest: {
                          entity: 'hr_organization',
                          fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              values: {
                                state: 'ACTIVE'
                              }
                            },
                            path: {
                              expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                              condition: accMainReportsSubOrg ? 'like' : '=',
                              values: {
                                state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                              }
                            }
                          },
                          orderList: { orderBy: { expression: 'description' } },
                          __mip_ondate: appAC.globalApplicationDate()
                        },
                        listeners: {
                          change: function (ctrl) {
                            const form = ctrl.up('form')
                            HR.controlService.onChangeIncludeChildOrgs(form)
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildOrgs(accMainReportsSubOrg)
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      HR.controlService.getDepCombo({
                        labelWidth: 160,
                        width: 700,
                        displayField: 'description',
                        flex: 1,
                        listeners: {
                          change: function (ctrl, value) {
                            const form = ctrl.up('form')
                            form.down('[name=includeChildDepts]').setReadOnly(!value)
                            if (!value) {
                              form.down('[name=includeChildDepts]').setValue()
                            }
                          }
                        }
                      }),
                      HR.controlService.getIncludeChildDepts()
                    ]
                  },
                  {
                    layout: { type: 'hbox' },
                    items: [
                      {
                        xtype: 'datefield',
                        name: 'dateFrom',
                        labelWidth: 160,
                        width: 300,
                        fieldLabel: UB.i18n('За період з'),
                        allowBlank: false
                      },
                      {
                        xtype: 'datefield',
                        name: 'dateTo',
                        labelWidth: 80,
                        width: 220,
                        fieldLabel: UB.i18n('по'),
                        allowBlank: false
                      }
                    ]
                  },
                  {
                    xtype: 'ubboxselect',
                    name: 'dictBonusType',
                    fieldLabel: UB.i18n('Тип нагороди'),
                    labelWidth: 160,
                    width: 700,
                    multiSelect: true,
                    valueField: 'ID',
                    displayField: 'name',
                    ubRequest: {
                      entity: 'hr_dictBonusType',
                      fieldList: ['ID', 'name']
                    }
                  },
                  {
                    xtype: 'ubcombobox',
                    name: 'positionCategory',
                    fieldLabel: UB.i18n('Категорія посади'),
                    labelWidth: 160,
                    width: 700,
                    valueField: 'code',
                    displayField: 'name',
                    ubRequest: {
                      entity: 'ubm_enum',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['ID', 'name', 'code', 'eGroup'],
                      whereList: {
                        enumGroupFilter: {
                          expression: '[eGroup]',
                          condition: 'equal',
                          values: {
                            val: 'HR_POSITION_CATEGORY'
                          }
                        }
                      }
                    }
                  },
                  {
                    xtype: 'ubcombobox',
                    name: 'workPlace',
                    labelWidth: 160,
                    width: 700,
                    fieldLabel: UB.i18n('Місце роботи'),
                    hideEntityItemInContext: true,
                    enumGroupFilter: 'HR_WORKER_PLACE',
                    valueField: 'code',
                    displayField: 'name',
                    ubRequest: {
                      entity: 'ubm_enum',
                      method: UB.core.UBCommand.methodName.SELECT,
                      fieldList: ['code', 'name', 'eGroup', 'sortOrder'],
                      whereList: {
                        eGroup: {
                          expression: '[eGroup]',
                          condition: 'equal',
                          values: { 'eGroup': 'HR_WORKER_PLACE' }
                        }
                      }
                    },
                    listeners: {
                      render: function (ctrl) {
                        ctrl.store.on('load', () => {
                          if (!ctrl.store.isLoaded) {
                            ctrl.setValue('1')
                            ctrl.store.isLoaded = true
                          }
                        })
                        ctrl.store.load()
                      }
                    }
                  },
                  {
                    xtype: 'ubcombobox',
                    name: 'dictFundSource',
                    fieldLabel: UB.i18n('Джерело фінансування'),
                    labelWidth: 160,
                    width: 700,
                    hideEntityItemInContext: true,
                    valueField: 'ID',
                    displayField: 'description',
                    hidden: AC.settings.get('hrFundSourceAccounting', appAC.globalOrganization()) !== 'STAFF',
                    ubRequest: {
                      entity: 'ac_fundSource',
                      method: 'selectByOrg',
                      fieldList: ['ID', 'description']
                    }
                  }
                ]
              },
              {
                xtype: 'panel',
                layout: { type: 'hbox' },
                padding: '35 0 0 0',
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Шукати'),
                    iconCls: 'fas fa-search',
                    width: 30,
                    cls: 'green-action',
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.searchEmployee()
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Очистити'),
                    iconCls: 'fas fa-eraser',
                    width: 30,
                    cls: 'fill-action',
                    margin: '5 0 0 0',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.clearSearch()
                    }
                  },
                  {
                    xtype: 'button',
                    iconCls: 'fas fa-print',
                    width: 30,
                    cls: 'blue-action',
                    margin: '5 0 0 0',
                    tooltip: UB.i18n('Друкувати'),
                    handler: function () {
                      me.doReport()
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        xtype: 'ubdetailgrid',
        name: 'empBonusListGrid',
        region: 'center',
        flex: 1,
        autoScroll: true,
        loadStoreImmediately: false,
        forceDataLoad: true,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink',
          'commandLink', 'showDetail', 'audit'],
        cmdData: {
          params: [{
            entity: 'hr_empListBonus',
            method: 'search',
            fieldList: [
              { name: 'employeeID', visibility: false },
              { name: 'employeeNumberID', visibility: false },
              { name: 'tabNum' },
              { name: 'fullFIO', description: UB.i18n('ПIБ') },
              { name: 'taxCode', description: UB.i18n('РНОКПП'), config: { align: 'center', width: 100 } },
              { name: 'sexType', description: UB.i18n('Стать'), config: { align: 'center', width: 100 } },
              { name: 'docIssuedDate', description: UB.i18n('Дата видачі'), format: 'd.m.Y', config: { align: 'center', width: 100 } },
              { name: 'bonusName' },
              { name: 'addDescrPerson', description: UB.i18n('Додаткова інформація') },
              { name: 'posCategory' },
              { name: 'workPlace' },
              { name: 'posName' },
              { name: 'actualPositionName' },
              { name: 'depName' },
              { name: 'structDepName' },
              { name: 'orgName', description: UB.i18n('Організація') },
              { name: 'fundSourceName' }
            ]
          }]
        },
        cmpInitConfig: {
          onDeterminateForm: HR.employeeTabs.onDeterminateCard,
          listeners: {
            render: (grid) => {
              grid.menu.removeAll()
              grid.menu.add([HR.employeeTabs.getEmpCardMenu(grid)])
              const showAddDescrPerson = !!AC.settings.get('hrShowAddDescrPerson', appAC.globalOrganization())
              const colPersonDescr = AC.gridUtils.getColumnByIndex(grid, 'addDescrPerson')
              colPersonDescr.setVisible(showAddDescrPerson)

              const useActualPositionName = AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization()) === true
              const colActualPositionName = AC.gridUtils.getColumnByIndex(grid, 'actualPositionName')
              colActualPositionName.setVisible(useActualPositionName)

              const useFundSource = AC.settings.get('hrFundSourceAccounting', appAC.globalOrganization()) === 'STAFF'
              const colFundSource = AC.gridUtils.getColumnByIndex(grid, 'fundSourceName')
              colFundSource.setVisible(useFundSource)
            }
          }
        },
        getExportTitle: function () {
          return UB.i18n('Список нагороджених працівників')
        }
      }
    ]

    me.clearSearch = () => {
      me.attr.dateTo.setValue(new Date())
      me.attr.dateFrom.setValue(new Date())
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.includeChildOrgs.setValue()
      me.attr.departmentID.setValue()
      me.attr.includeChildDepts.setValue()
      me.attr.dictBonusType.setValue()
      me.attr.workPlace.setValue()
      me.attr.positionCategory.setValue()
      me.attr.dictFundSource.setValue()
    }

    me.searchEmployee = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      const store = me.attr.grid.getStore()
      let req = store.ubRequest
      req.organizationID = me.attr.organizationID.getValue()
      req.includeChildOrgs = me.attr.includeChildOrgs.getValue()
      req.departmentID = me.attr.departmentID.getValue()
      req.includeChildDepts = me.attr.includeChildDepts.getValue()
      req.onDate = appAC.globalApplicationDate()
      req.dateFrom = AC.dateService.shiftDate(me.attr.dateFrom.getValue())
      req.dateTo = AC.dateService.shiftDate(me.attr.dateTo.getValue())
      req.dictBonusType = me.attr.dictBonusType.getValue()
      req.workPlace = me.attr.workPlace.getValue()
      req.positionCategory = me.attr.positionCategory.getValue()
      req.dictFundSource = me.attr.dictFundSource.getValue()
      store.load()
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[name=empBonusListGrid]'),
        dateTo: me.down('[name=dateTo]'),
        dateFrom: me.down('[name=dateFrom]'),
        organizationID: me.down('[name=organizationID]'),
        includeChildOrgs: me.down('[name=includeChildOrgs]'),
        departmentID: me.down('[name=departmentID]'),
        includeChildDepts: me.down('[name=includeChildDepts]'),
        dictBonusType: me.down('[name=dictBonusType]'),
        workPlace: me.down('[name=workPlace]'),
        positionCategory: me.down('[name=positionCategory]'),
        dictFundSource: me.down('[name=dictFundSource]')
      }
      me.attr.dateTo.setValue(new Date())
      me.attr.dateFrom.setValue(new Date())
      // me.attr.dictBonusType.setValue(null)
    }, me)

    me.validateParams = () => {
      let res
      const params = []
      if (!me.attr.organizationID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Організація"')))
      }
      let dateFromCtrl = me.attr.dateFrom
      const dateFrom = dateFromCtrl.getValue()
      if (!dateFrom || !dateFromCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Період з"')))
      }

      dateFromCtrl = me.attr.dateTo
      const dateTo = dateFromCtrl.getValue()
      if (!dateTo || !dateFromCtrl.isValid()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Період по"')))
      }

      if (params.length) {
        res = {
          msg: UB.i18n(`Не вибрано наступні параметри:<br/>{0}`, params.join(',<br/>'))
        }
      } else {
        if (dateFrom > dateTo) {
          res = {
            msg: UB.i18n(`Дата {0} не може перевищувати дату {1}`, AC.viewUtils.formatFieldLabel('"Період з"'), AC.viewUtils.formatFieldLabel('"по"'))
          }
        }
      }
      return res
    }

    me.report_code = 'hr_empListBonus_1'
    me.doReport = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      let reportParams = {
        organizationID: me.attr.organizationID.getValue(),
        includeChildOrgs: me.attr.includeChildOrgs.getValue(),
        departmentID: me.attr.departmentID.getValue(),
        includeChildDepts: me.attr.includeChildDepts.getValue(),
        onDate: appAC.globalApplicationDate(),
        dateFrom: AC.dateService.shiftDate(me.attr.dateFrom.getValue()),
        dateTo: AC.dateService.shiftDate(me.attr.dateTo.getValue()),
        dictBonusType: me.attr.dictBonusType.getValue(),
        dictBonusTypeName: me.attr.dictBonusType.getRawValue(),
        workPlace: me.attr.workPlace.getValue(),
        workPlaceName: me.attr.workPlace.getRawValue(),
        positionCategory: me.attr.positionCategory.getValue(),
        positionCategoryName: me.attr.positionCategory.getRawValue(),
        dictFundSource: me.attr.dictFundSource.getValue(),
        dictFundSourceName: me.attr.dictFundSource.getRawValue()
      }

      $App.doCommand({
        cmdType: 'showReport',
        caption: UB.i18n('Друкована форма'),
        tabId: 'printDocument' + me.report_code + Date.now(),
        target: $App.getViewport().centralPanel,
        cmdData: {
          reportCode: me.report_code,
          reportParams: reportParams,
          reportOptions: {
            allowExportToExcel: true,
            isModal: false
          }
        }
      })
    }

    me.callParent(arguments)
  }
})
