/* global Ext UB $App _ AC appAC */
exports.formDef = 'HR.dictListOrgstructure'

Ext.define('HR.dictListOrgstructure', {
  extend: 'Ext.Panel',
  requires: [
    'UB.core.UBCommand',
    'UB.core.UBUtil'
  ],
  width: 1280,
  height: 800,
  flex: 1,
  layout: { type: 'vbox', align: 'stretch' },
  items: [
    {
      xtype: 'panel',
      region: 'center',
      name: 'reportPanel',
      flex: 1,
      items: []
    }
  ],
  initComponent: function () {
    const me = this
    const control = Ext.create('Ext.Component', {
      flex: 1,
      margin: 0,
      autoEl: {
        tag: 'iframe'
      }
    })
    const container = Ext.create('Ext.panel.Panel', {
      layout: { type: 'vbox', align: 'stretch' },
      flex: 1,
      items: [
        {
          flex: 1,
          autoScroll: true,
          layout: { type: 'hbox', pack: 'center', align: 'stretch' },
          bodyCls: 'ub-panel-gray',
          items: [control]
        }
      ]
    })
    me.items = [container]
    me.reportControl = control
    me.on('afterrender', function () {
      const me = this
      me.showDesktop()
    })
    me.callParent(arguments)
  },
  showDesktop: async function () {
    const me = this
    me.setLoading(true)
    const iFrame = me.reportControl.getEl().dom
    const iFrameDoc = iFrame.contentDocument
    let shTemplate = ''
    let por = 0
    me.onReportClick = me.onReportClick.bind(me)
    const shortcutData = await me.prepareShortcut()
    while (shortcutData[por]) {
      const data = {
        shData1: shortcutData[por] || [],
        shData2: shortcutData[por + 1] || [],
        shData3: shortcutData[por + 2] || []
      }
      for (let r = 0, l = _.max([data.shData1.length, data.shData2.length, data.shData3.length]); r < l; r++) {
        shTemplate += '<tr>'
        for (let i = 1; i <= 3; i++) {
          shTemplate += `<td 
            style="width:400px;font-size:14px;${data[`shData${i}`][r] && data[`shData${i}`][r].isFolder ? '' : ''}height:24px;padding-left: 0px;">
            ${data[`shData${i}`][r] && data[`shData${i}`][r].isFolder ? '<b>' : '<a href="#" data-id=' + (data[`shData${i}`][r] ? data[`shData${i}`][r].ID : '') + ' >'}
            ${data[`shData${i}`][r] ? (data[`shData${i}`][r].caption === '-' ? '<hr  align="left" width="300"  size="2">' : data[`shData${i}`][r].caption) : ''}
            ${data[`shData${i}`][r] && data[`shData${i}`][r].isFolder ? '</b>' + (data[`shData${i}`][r].caption === '-' ? '' : '') : '</a>'}
          </td>`
        }
        shTemplate += '</tr>'
      }
      shTemplate += '<tr><td style="height:10px;"></td><td></td><td></td><td></td></tr>'
      por += 3
    }

    iFrameDoc.head.innerHTML = `
      <style type="text/css">
        body {
          background-color: #FFFFFF;
          color: #000000;
          font-family: Roboto, Arial, Helvetica, sans-serif;
          font-size: 14px;
          line-height: 1.3;
        }
        a {
          text-decoration: none;
          color: #2f7c94;
          word-wrap: break-word;
          word-break: break-word;
        }
        td,th {
          font-family: Roboto,Arial,Helvetica,sans-serif;
          font-size: 14px;
          word-wrap: break-word;
          word-break: break-word;          
        }
      </style>`
    iFrameDoc.body.innerHTML = `
      <table
        style="
          border-collapse: collapse;
          width: 100%;
          word-break: break-all;
        "
        border="0px"
        cellspacing="0"
        cellpadding="3px"
      >
        <tbody>
          ${shTemplate}
        </tbody>
      </table>`

    const refs = iFrameDoc.getElementsByTagName('a')
    for (let i = 0, L = refs.length; i < L; i++) {
      refs[i].addEventListener('click', me.onReportClick, true)
    }
    me.setLoading(false)
  },
  prepareShortcut: async function () {
    const result = []
    const parentCodes = ['accStaffFolderPositions', 'accStaffFolderTerritory',
      'accStaffFolderOrgsAndDeps', 'accStaffFolderOther', 'accStaffFolderTariffing']

    const parents = await UB.Repository('ubm_navshortcut')
        .attrs('ID', 'caption', 'displayOrder')
        .where('code', 'in', parentCodes)
        .selectAsObject()

    const shortcuts = UB.core.UBStoreManager.getNavigationShortcutStore().data.items
        .filter(o => parentCodes.indexOf(o.get('code')) !== -1 || parents.map(item => item.ID).indexOf(o.get('parentID')) !== -1)

    const folders = _.sortBy(shortcuts.filter(o => o.get('isFolder')), 'displayOrder')

    let colIdx = 1
    let leftColumnList = []
    let rightColumnList = []
    function uaSort(s1, s2) {
      return s1.get('caption').localeCompare(s2.get('caption'));
    }
    folders.forEach(folder => {
      const shcuts = shortcuts.filter(o => { return o.get('parentID') === folder.get('ID') })
      if (shcuts.length) {
        if (folder.get('code') === 'accStaffFolderOther') colIdx = 2
        switch (colIdx) {
          case 1:
            leftColumnList.push({
              ID: '',
              caption: folder.get('caption'),
              isFolder: true
            })
            shcuts.sort(uaSort).forEach(sh => {
              leftColumnList.push({
                ID: sh.get('ID'),
                caption: sh.get('caption'),
                isFolder: false
              })
            })
            break
          case 2:
            rightColumnList.push({
              ID: '',
              caption: folder.get('caption'),
              isFolder: true
            })
            shcuts.sort(uaSort).forEach(sh => {
              rightColumnList.push({
                ID: sh.get('ID'),
                caption: sh.get('caption'),
                isFolder: false
              })
            })
            break
        }
      }
    })
    result.push(leftColumnList, rightColumnList)

    return result
  },
  onReportClick: function (e) {
    e.preventDefault()
    if (e.target.dataset.id && e.target.dataset.id !== '') {
      const store = UB.core.UBStoreManager.getNavigationShortcutStore()
      const shortcut = _.find(store.data.items, item => { return item.get('ID') === Number(e.target.dataset.id) })
      $App.runShortcutCommand(shortcut.get('code'), shortcut.get('inWindow'))
    }
  }
})
