/* global $App AC HR UB */
exports.formDef = {
  requiredFields: ['orderID', 'orderID.orderState', 'empOrderType', 'organizationID', 'isGroup', 'organizationID.mi_data_id',
    'employeeNumberID', 'errorText'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: {
      type: 'border'
    }
  },
  defaults: {
    layout: 'fit'
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'addIntComb'
        }
      ]
    }
  ],
  items: [{
    xtype: 'tabpanel',
    region: 'center',
    items: [{
      title: UB.i18n('Загальне'),
      ubID: 'tabMain',
      layout: {
        type: 'vbox',
        align: 'stretch'
      },
      items: [{
        layout: {
          type: 'hbox',
          align: 'stretch'
        },
        padding: '10 0 0 0',
        items: [
          {
            layout: {
              type: 'vbox',
              align: 'stretch'
            },
            flex: 1,
            items: [
              {
                attributeName: 'employeePositionID',
                xtype: 'empPositionCombobox',
                addWorkPlace: true,
                fieldList: ['ID', 'description', 'employeeNumberID', 'workPlace', 'organizationID', 'vacancyDateFrom', 'vacancyDateTo'],
                orderList: { orderBy: { expression: 'employeeNumberID.tabNumSort' } },
                labelWidth: 160
              },
              {
                layout: {
                  type: 'hbox'
                },
                items: [{
                  attributeName: 'dateFrom',
                  fieldLabel: UB.i18n('Відкликати з'),
                  labelWidth: 160
                }
                ]
              },
              {
                attributeName: 'dateTo',
                fieldLabel: UB.i18n('По'),
                labelWidth: 160
              },
              {
                layout: {
                  type: 'hbox'
                },
                items: [{
                  width: 232,
                  maxWidth: 232,
                  minWidth: 232,
                  attributeName: 'dayCount',
                  fieldLabel: UB.i18n('Тривалість'),
                  labelWidth: 160
                }
                ]
              },
              {
                xtype: 'label',
                name: 'holidayInfo',
                text: '',
                cls: 'x-form-item-label field-label-red',
                margin: '10 10 5 15'
              }
            ]
          },
          {
            layout: {
              type: 'vbox',
              align: 'stretch'
            },
            flex: 1,
            items: [
              {
                layout: { type: 'hbox', align: 'top' },
                flex: 1,
                items: [
                  {
                    attributeName: 'reason',
                    fieldLabel: UB.i18n('Причина відкликання з відпустки'),
                    flex: 1
                  },
                  {
                    xtype: 'button',
                    cls: 'list-icon',
                    name: 'reasonButton',
                    tooltip: UB.i18n('Вибрати'),
                    width: 35,
                    height: 35,
                    margin: '0 2 0 -45',
                    handler: btn => btn.up('form').getField('reason').selectHandler(btn)
                  }
                ]
              },
              {
                layout: { type: 'hbox', align: 'top' },
                flex: 1,
                hidden: true,
                items: [
                  {
                    attributeName: 'reasonDoc',
                    flex: 1
                  },
                  {
                    xtype: 'button',
                    cls: 'list-icon',
                    name: 'reasonDocButton',
                    tooltip: UB.i18n('Вибрати'),
                    width: 35,
                    height: 35,
                    margin: '0 2 0 -45',
                    handler: btn => btn.up('form').getField('reasonDoc').selectHandler(btn)
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        name: 'errorText',
        xtype: 'label',
        cls: 'x-form-item-label field-label-red',
        margin: '10 10 5 15'
      },
      {
        xtype: 'tabpanel',
        region: 'center',
        layout: 'fit',
        ubID: 'tpDetail',
        flex: 1,
        items: [{
          title: UB.i18n('Види відпусток'),
          name: 'empOrderVacationListDet',
          xtype: 'ubdetailgrid',
          paraGrid: true,
          autoScroll: true,
          hideActions: ['addNew', 'addNewByCurrent', 'del', 'audit', 'newVersion', 'history', 'showPreview', 'itemLink',
            'commandLink', 'showDetail', 'edit'
          ],
          flex: 1,
          customActions: [{
            text: UB.i18n('Завантажити відпустки'),
            iconCls: 'fas fa-angle-double-down',
            cls: 'fill-action',
            actionId: 'cloneVacationList',
            handler: function (btn) {
              const me = btn.up('form')
              const grid = btn.up('entitygridpanel')
              return HR.controlService.checkAndSaveForm(me, () => {
                return $App.connection.run({
                  entity: 'hr_empOrderVacationListDet',
                  method: 'cloneVacationList',
                  paraID: me.instanceID,
                  orderID: me.record.get('orderID'),
                  dateFrom: me.record.get('dateFrom'),
                  dateTo: me.record.get('dateTo'),
                  dayCount: me.record.get('dayCount'),
                  empOrderType: me.record.get('empOrderType'),
                  employeePositionID: me.record.get('employeePositionID'),
                  employeeNumberID: me.record.get('employeeNumberID')
                }).then(() => {
                  grid.getStore().load(() => {
                    me.validate(2)
                  })
                })
              })
            }
          }],
          entityConfig: {
            entity: 'hr_empOrderVacationListDet',
            method: 'select',
            fieldList: [
              {
                name: 'dictVacationKindID.name',
                description: UB.i18n('Вид відпустки'),
                editor: {
                  fieldList: ['ID', 'name']
                }
              },
              { name: 'dateFrom' },
              { name: 'dateTo' },
              {
                name: 'dayCount',
                readOnly: true,
                config: { align: 'center', config: { width: 80 } },
                editor: { readOnly: true, allowBlank: true }
              },
              { name: 'empOrderType' },
              {
                name: 'empVacationPeriodID.description',
                editor: {
                  fieldList: ['ID', 'description'],
                  hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion']
                },
                description: UB.i18n('За період')
              },
              { name: 'employeeNumberID', visibility: false },
              { name: 'dictVacationKindID', visibility: false }
            ]
          },
          masterFields: ['ID', 'orderID'],
          detailFields: ['paraID', 'orderID'],
          cmpInitConfig: {
            onItemDblClick: function () {
            },
            customInit: function () {
              let grid = this
              AC.gridUtils.tuneGridColumns(grid, {})
            },
            onItemContextMenu: function (grid, record, item, index, event) {
              event.stopEvent()
            }
          }
        }]
      }
      ]
    }]
  }]
}
