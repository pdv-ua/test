// @isModal true
/* jshint maxerr: 10000 */

/* global HR AC appAC UB */
exports.formDef = (function () {
  return {
    customParams: {
      empOrderType: 'PROLONGATION'
    },
    requiredFields: ['orderID', 'empOrderType', 'tabDate', 'organizationID', 'contractType.name', 'dictContractKindID.name',
      'dateToEmpty', 'workPlace.name', 'workerType.name', 'dictStaffCatID.name', 'tabNum', 'workScheduleID.name', 'mtCount', 'accrualSumPrev',
      'positionID.mi_data_id', 'dictContractKindID.isTerm', 'isOutStaff'
    ],
    parentConfig: {
      postOnlySimpleAttributes: true,
      layout: {
        type: 'border'
      }
    },
    defaults: {
      layout: 'fit'
    },
    size: {
      width: 1100,
      height: 600
    },
    items: [{
      xtype: 'tabpanel',
      region: 'center',
      items: [{
        title: UB.i18n('Загальне'),
        ubID: 'tabMain',
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        autoScroll: true,
        items: [{
          layout: {
            type: 'hbox'
          },
          items: [{
            flex: 1,
            layout: {
              type: 'vbox',
              align: 'stretch'
            },
            defaults: {
              labelWidth: 130
            },
            items: [{
              attributeName: 'employeePositionID',
              fieldLabel: UB.i18n('Працівник'),
              displayField: 'description',
              labelWidth: 130,
              margin: '5 15 2 15',
              fieldList: ['ID', 'description', 'organizationID', 'workPlace', 'employeeNumberID', 'employeeID',
                'employeeID.dictTarifCoeffID', 'vacancyDateFrom', 'vacancyDateTo', 'accrualSum', 'dictCategoryECBID',
                'contractType', 'dictContractKindID', 'dictStaffCatID', 'payElID', 'workScheduleID', 'workerType',
                'positionID', 'departmentID', 'dictFundSourceID', 'dictCostTypeID', 'dictEmpCategoryID',
                'dictTarifCoeffID', 'posNameAddition', 'dictPositionID'
              ],
              xtype: 'empPositionCombobox',
              addWorkPlace: true,
              gridFieldList: ['description'],
              hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
              disableModifyEntity: true
            },
            {
              attributeName: 'destOrganizationID',
              hidden: true,
              allowBlank: false,
              fieldList: ['name', 'ID', 'mi_data_id'],
              displayField: 'name'
            },
            {
              flex: 1,
              layout: {
                type: 'hbox',
                align: 'stretch'
              },
              items: [
                {
                  attributeName: 'dateFrom',
                  labelWidth: 130,
                  width: 250
                },
                {
                  attributeName: 'dateToEmpty',
                  fieldLabel: UB.i18n('По'),
                  labelWidth: 60
                }
              ]
            },
            HR.controlService.getAttrDepPosBlock({
              valueField: 'ID',
              labelWidth: 130,
              showPosCategory: false,
              // showFundSource: true,
              posFieldLabel: UB.i18n('Штатна посада')
            }),
            {
              xtype: 'ubfieldset',
              border: true,
              hidden: true,
              ubID: 'factPositionBlock',
              layout: {
                type: 'vbox',
                align: 'stretch'
              },
              margins: {
                right: 10,
                left: 10
              },
              items: [
                {
                  attributeName: 'dictPositionID',
                  allowBlank: true,
                  fieldLabel: UB.i18n('Посада'),
                  hidden: true
                },
                {
                  attributeName: 'posNameAddition',
                  fieldLabel: UB.i18n('Доповнення')
                },
                {
                  attributeName: 'dictEmpCategoryID',
                  margin: '5 15 10 15',
                  hidden: true
                },
                {
                  attributeName: 'dictTarifCoeffID',
                  margin: '5 15 10 15',
                  hidden: true
                }
              ]
            },
            {
              attributeName: 'vacPositionID',
              hidden: true,
              fieldList: ['ID', 'description'],
              whereList: {
                organizationID: {
                  expression: '[organizationID]',
                  condition: 'equal',
                  value: appAC.globalOrganization()
                }
              }
            },
            {
              attributeName: 'dictReasonMovingKindID',
              fieldList: ['ID', 'name', 'notStoreInWorkBook']
            },
            {
              layout: {
                type: 'hbox'
              },
              flex: 1,
              items: [
                {
                  attributeName: 'contractNumber',
                  flex: 1,
                  labelWidth: 130
                },
                {
                  attributeName: 'contractDate',
                  width: 250
                }
              ]
            },
            {
              layout: {
                type: 'hbox'
              },
              flex: 1,
              items: [
                {
                  attributeName: 'dictTermAppointID',
                  filedList: ['name', 'years'],
                  flex: 1,
                  labelWidth: 130
                },
                { xtype: 'component', width: 280 }
              ]
            },
            {
              layout: {
                type: 'hbox',
                align: 'top'
              },
              flex: 1,
              name: 'reasonDocPanel',
              items: [{
                fieldLabel: UB.i18n('Підстава (до пункту наказу)'),
                margin: '5 25 5 15',
                labelWidth: 130,
                attributeName: 'reason',
                flex: 1
              },
              {
                xtype: 'button',
                cls: 'list-icon',
                name: 'reasonButton',
                tooltip: UB.i18n('Вибрати'),
                width: 35,
                height: 35,
                margin: '0 15 0 -25',
                handler: btn => btn.up('form').getField('reason').selectHandler(btn)
              }
              ]
            },
            {
              layout: {
                type: 'hbox'
              },
              flex: 1,
              items: [
                {
                  attributeName: 'isPreservExistCharges',
                  labelWidth: 250,
                  flex: 1
                }
              ]
            },
            HR.controlService.getOrderFundSourceGrid()
            ]
          },
          {
            layout: {
              type: 'vbox',
              align: 'stretch'
            },
            width: 450,
            items: [
              AC.viewUtils.getCollapsiblePanel(
                /* eslint-disable */
                '<span style="color:#2196F3; padding-left: 16px">${UB.i18n("Тип договору")}:</span> ${contractType.name} <br>' +
                '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Вид договору")}:</span> ${dictContractKindID.name} <br>' +
                '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Місце роботи")}:</span> ${workPlace.name} <br>' +
                '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Форма зайнятості")}:</span> ${workerType.name} <br>' +
                '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Категорія персоналу для розрахунків")}:</span> ${dictStaffCatID.name} <br>' +
                '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Табельний номер")}:</span> ${tabNum} <br>' +
                '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Графік роботи")}:</span> ${workScheduleID.name} <br>' +
                '<span style="color:#2196F3;padding-left: 16px">${UB.i18n("Кількість ставок")}:</span> ${mtCount} <br>',
                /* eslint-enable */
                {
                  name: 'panelMoveDetInfo',
                  expandTitle: UB.i18n('Інформація'),
                  layout: {
                    type: 'vbox',
                    align: 'stretch'
                  },
                  items: [{
                    attributeName: 'contractType'
                  },
                  {
                    attributeName: 'dictContractKindID',
                    fieldList: ['ID', 'name', 'isTerm', 'code']
                  },
                  {
                    attributeName: 'workPlace',
                    allowBlank: false
                  },
                  {
                    attributeName: 'workerType',
                    allowBlank: false
                  },
                  {
                    attributeName: 'dictStaffCatID',
                    fieldLabel: UB.i18n('Категорія персоналу для розрахунків'),
                    hidden: false,
                    allowBlank: false
                  },
                  {
                    attributeName: 'workScheduleID',
                    allowBlank: false,
                    gridFieldList: ['code', 'name', 'dateFrom', 'dateTo', 'begins', 'isPayDayOff', 'isPayHoliday', 'isHoliday', 'isLastHoliday', 'isChangeDay', 'isCalendar']
                  },
                  {
                    attributeName: 'dictCategoryECBID',
                    gridFieldList: ['code', 'name'],
                    disableModifyEntity: !AC.entityUtils.verifyRightsMethod('hr_dictCategoryECB', 'addnew'),
                    allowBlank: false
                  },
                  {
                    attributeName: 'dictCostTypeID',
                    disableModifyEntity: !AC.entityUtils.verifyRightsMethod('ac_dictCostType', 'addnew')
                  },
                  {
                    layout: {
                      type: 'hbox',
                      align: 'middle'
                    },
                    items: [{
                      attributeName: 'mtCount',
                      flex: 1,
                      decimalPrecision: 2
                    },
                    {
                      attributeName: 'isResponsible',
                      flex: 1
                    }
                    ]
                  },
                  {
                    attributeName: 'notStoreInWorkBook',
                    labelWidth: 200,
                    flex: 1
                  }
                  ]
                }),
              {
                xtype: 'ubfieldset',
                title: UB.i18n('Оклад'),
                border: true,
                layout: {
                  type: 'vbox',
                  align: 'stretch'
                },
                margins: '0 5 0 5',
                padding: '0 0 10 5',
                items: [{
                  attributeName: 'payElID',
                  allowBlank: false,
                  fieldList: ['ID', 'name', 'description', 'methodID.code', 'codeSort'],
                  whereList: {
                    isSalary: {
                      expression: '[methodID.methodGroupID.code]',
                      condition: 'equal',
                      value: '1'
                    },
                    tariff: {
                      expression: '[methodID.code]',
                      condition: 'notIn',
                      value: ['143', '144', '145', '146', '147', '156']
                    }
                  },
                  orderList: {
                    orderBy: {
                      expression: 'codeSort'
                    }
                  },
                  fieldLabel: UB.i18n('Вид оплати')
                },
                {
                  layout: {
                    type: 'hbox',
                    align: 'middle'
                  },
                  items: [{
                    attributeName: 'accrualSum',
                    fieldLabel: UB.i18n('Сума'),
                    allowBlank: false,
                    minWidth: 220,
                    maxWidth: 220
                  },
                  {
                    name: 'prevAccrualSumLabel',
                    xtype: 'label',
                    html: UB.i18n('<span style: { align: "center" }>Попередній оклад <br> </span>')
                  }
                  ]
                },
                {
                  xtype: 'label',
                  text: '',
                  cls: 'x-form-item-label grd-italic',
                  margin: '5 0 0 15',
                  width: 160,
                  ubID: 'accrualLabel',
                  hidden: true
                }
                ]
              }
            ]
          }
          ]
        }]
      },
      {
        title: UB.i18n('Нарахування'),
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        items: [HR.orderManager.getOrderAccrualGrid('hr_empOrderProlongationDet')]
      }
      ]
    }]
  }
})()
