              xtype: 'ubdetailgrid',
              name: 'docRegSicknessDt',
              stateful: true,
              stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_docRegSickness_docRegSicknessDt'),
              rowEditing: true,
              notWriteChanges: true,
              autoScroll: true,
              forceDataLoad: true,
              disableSearchBar: true,
              hidePagingBar: true,
              sortableColumns: false,
              enableColumnHide: false,
              pageSize: 10000,
              hideActions: [],
              flex: 1,
              entityConfig: {
                entity: 'hr_docRegSicknessDt',
                method: 'select',
                fieldList: [
                  {
                    name: 'dateFrom',
                    columnConfig: { width: 130 },
                    editor: { width: 110 }
                  },
                  {
                    name: 'dateTo',
                    columnConfig: { width: 130 },
                    editor: { width: 110 }
                  },
                  {
                    name: 'illnessRegime',
                    columnConfig: { flex: 1 }
                  }
                ],
                orderList: { dateFrom: { expression: 'dateFrom', order: 'ASC' } }
              },
              masterFields: ['ID'],
              detailFields: ['docRegSicknessID'],
              onValidateEdit: (editor, context) => {
                const sicknessFrom = AC.dateService.truncTimeToUtcNull(editor.editor.up('form').attr.dateFrom.getValue())
                const sicknessTo = AC.dateService.truncTimeToUtcNull(editor.editor.up('form').attr.dateTo.getValue())
                const newPeriodFrom = AC.dateService.truncTimeToUtcNull(editor.editor.form.findField('dateFrom').getValue())
                const newPeriodTo = AC.dateService.truncTimeToUtcNull(editor.editor.form.findField('dateTo').getValue())
                if (newPeriodFrom < sicknessFrom) {
                  const errorMessage = UB.i18n('Не може бути менше ніж "дата початку"')
                  editor.editor.form.findField('dateFrom').markInvalid(errorMessage)
                  $App.dialogError(errorMessage)
                  editor.editor.form.findField('dateFrom').setValue(sicknessFrom)
                  return false
                }
                if (newPeriodTo > sicknessTo) {
                  const errorMessage = UB.i18n('Не може бути більше ніж "дата закінчення"')
                  editor.editor.form.findField('dateTo').markInvalid(errorMessage)
                  $App.dialogError(errorMessage)
                  editor.editor.form.findField('dateTo').setValue(sicknessTo)
                }

                const store = context.grid.getStore()

                if (store.getCount() > 0) {
                  let hasError = false
                  store.each(record => {
                    if ((context.record.data.ID && context.record.data.ID === record.get('ID')) || context.record.internalId === record.internalId) return
                    const recordDateFrom = AC.dateService.truncTimeToUtcNull(record.get('dateFrom'))
                    const recordDateTo = AC.dateService.truncTimeToUtcNull(record.get('dateTo'))
                    if (!(newPeriodTo < recordDateFrom || newPeriodFrom > recordDateTo)) {
                      hasError = true
                    }
                  })
                  if (hasError) {
                    const errorMessage = UB.i18n(`Періоди перетинаються. Виправіть перед збереженням`)
                    $App.dialogError(errorMessage)
                    return false
                  }
                }
                return true
              },
              onBeforeEdit: (control, context) => {
                const me = context.grid.up('form')
                me.attr['docRegSicknessDt.dateFrom'].field.setMinValue(me.attr.dateFrom.getValue())
                me.attr['docRegSicknessDt.dateFrom'].field.setMaxValue(me.attr.dateTo.getValue())
                me.attr['docRegSicknessDt.dateTo'].field.setMinValue(me.attr.dateFrom.getValue())
                me.attr['docRegSicknessDt.dateTo'].field.setMaxValue(me.attr.dateTo.getValue())
                me.setIsDirty(true)
              },
              onAddNewByCurrent: function () {
                const me = this
                const selection = me.getSelectionModel().getSelection()
                if (selection.length < 1) {
                  $App.dialogInfo('selectRowFirst')
                  return
                }
                if (!me.rowEditing) {
                  const eOpt = {
                    addByCurrent: true,
                    instanceID: selection[0].get('ID')
                  }
                  me.openForm(eOpt)
                } else {
                  if (!me.editingPlugin.editing) {
                    const selectedData = { ...selection[0].getData() }
                    selectedData.dateFrom = AC.dateService.addDays(selectedData.dateTo, 1)
                    selectedData.dateTo = AC.dateService.addDays(selectedData.dateTo, 4)
                    const parentForm = me.up('basepanel')
                    if (parentForm && (parentForm.isDirty() || parentForm.isNewInstance) && !me.notWriteChanges) {
                      parentForm.saveForm().then(function (result) {
                        if (result !== -1) {
                          me.addNewRecord(selectedData, true)
                        }
                      })
                    } else {
                      me.addNewRecord(selectedData, true)
                    }
                  } else {
                    $App.dialogInfo('rowEditing')
                  }
                }
              },
              listeners: {
                changeData: function (grid) {
                  const me = grid.up('form')
                  me.recalSickness()
                }
              }
            }

          ]
        },
        {
          title: UB.i18n(`Пов'язані документи`),
          layout: { type: 'hbox' },
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              defaults: {
                labelWidth: 150
              },
              flex: 1,
              items: [
                {
                  fieldLabel: UB.i18n('Продовження листа'),
                  xtype: 'textfield',
                  name: 'childOrderDescription',
                  fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
                  readOnly: true
                },
                {
                  fieldLabel: UB.i18n('Заява СС'),
                  xtype: 'textfield',
                  name: 'sicknessRequisDescription',
                  fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
                  readOnly: true
                },
                {
                  fieldLabel: UB.i18n('Платіжна відомість'),
                  xtype: 'textfield',
                  name: 'payRollDescription',
                  fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
                  readOnly: true
                }
              ]
            }
          ]
        },
        {
          title: UB.i18n('Додатки'),
          autoScroll: true,
          layout: { type: 'vbox', align: 'stretch' },
          flex: 1,
          items: [
            {
              xtype: 'docAttachment',
              entity: 'hr_orderAttachment',
              detailFields: 'documentID',
              masterFields: 'ID',
              showOriginal: true,
              minHeight: 55,
              maxHeight: 140,
              height: 95
            }
          ]
        }
      ]
    }
  ]
}
