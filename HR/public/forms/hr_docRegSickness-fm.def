/* global Ext $App AC _ UB appHR */

exports.formDef = {
  requiredFields: ['description', 'orderRegistryID', 'orderRegistryID.organizationID', 'orderRegistryID.periodID',
    'orderRegistryID.periodID.dateFrom', 'flagsRec', 'flagsFix', 'orderState', 'dictIllnessReasonID.code',
    'employeeNumberID.dateFrom', 'employeeNumberID.dateTo', 'employeeSickLimitID', 'dayFSSU', 'empOrderSicknessID',
    'empOrderID.description', 'empOrderID', 'parentAccrualID', 'parentSicknessID', 'dictIllnessReasonID.payElFSSUID.methodID.code',
    'employeePositionID.workPlace', 'dictIllnessReasonID.payElFSSUID.includeSecondJobs', 'parentSicknessID.illnessKind'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'empNumAction'
        },
        {
          orderId: 5,
          actionId: 'rlAction'
        },
        {
          orderId: 6,
          actionId: 'subEmpAction'
        },
        {
          orderId: 7,
          actionId: 'calcSickness'
        },
        {
          orderId: 8,
          actionId: 'postingAction'
        },
        {
          orderId: 9,
          actionId: 'cancelPostingAction'
        },
        {
          orderId: 10,
          actionId: 'printDocumentAction'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'hbox' },
      items: [
        {
          layout: { type: 'vbox', align: 'stretch' },
          defaults: { labelWidth: 130 },
          flex: 2,
          items: [
            { attributeName: 'empOrderID', hidden: true },
            { attributeName: 'employeeID', hidden: true },
            { attributeName: 'employeeNumberID', hidden: true },
            {
              layout: { type: 'hbox' },
              defaults: { labelWidth: 130 },
              items: [
                { attributeName: 'illnessKind', flex: 2, labelWidth: 130 },
                {
                  attributeName: 'seria',
                  minWidth: 160,
                  labelWidth: 50,
                  flex: 1,
                  maskRe: AC.validators.maskRe('charset11'),
                  maxLength: 11,
                  vType: 'charset11'
                },
                {
                  attributeName: 'orderNumber',
                  readOnly: false,
                  minWidth: 100,
                  labelWidth: 25,
                  flex: 1
                },
                {
                  attributeName: 'orderDate',
                  labelWidth: 90,
                  flex: 1
                }
              ]
            },
            {
              fieldLabel: UB.i18n('Документ-підстава'),
              xtype: 'textfield',
              name: 'orderDescription',
              fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
              flex: 1,
              hidden: true,
              readOnly: true
            },
            {
              layout: { type: 'hbox' },
              items: [
                {
                  attributeName: 'employeePositionID',
                  fieldList: ['ID', 'description', 'organizationID', 'employeeID', 'employeeNumberID', 'dateFrom', 'dateTo',
                    'employeeNumberID.dateFrom', 'employeeNumberID.dateTo', 'workPlace', 'vacancyDateFrom', 'vacancyDateTo'],
                  orderList: { orderBy: { expression: 'employeeNumberID.tabNumSort' } },
                  addWorkPlace: true,
                  addDateTo: true,
                  labelWidth: 130,
                  flex: 1,
                  xtype: 'empPositionCombobox'
                },
                {
                  attributeName: 'workPlaceOnly',
                  labelWidth: 150,
                  width: 170
                },
                {
                  name: 'dismissed',
                  xtype: 'checkbox',
                  labelWidth: 100,
                  fieldLabel: UB.i18n('звільнені'),
                  listeners: {
                    change: (ctrl, value) => {
                      const me = ctrl.up('form')
                      me.record.set('employeePositionID')
                      me.attr.employeePositionID.setValue()
                      me.record.set('employeeID')
                      me.record.set('employeeNumberID')
                      me.record.set('employeeFamilyID')
                      me.record.set('parentAccrualID', null)
                      me.record.set('parentSicknessID', null)
                      me.attr.parentSicknessID.setValue()
                      me.record.set('standingYearMonth')
                      me.record.set('standingAllYear')
                      me.record.set('standingAllInYear')
                      me.record.set('percentWork')
                      me.attr.dateFrom.setValue()
                      me.attr.dateTo.setValue()
                      me.attr.dateFirst.setValue()
                      me.attr.dateFrom.setMaxValue()
                      me.attr.dateTo.setMinValue()
                      me.attr.docRegSicknessDt.store.removeAll()
                      me.setEmployeeFilter(value)
                    }
                  }
                }
              ]
            },
            {
              xtype: 'ubcombobox',
              name: 'parentSicknessID',
              valueField: 'ID',
              fieldLabel: UB.i18n('Попередній лист'),
              ubRequest: {
                entity: 'hr_docRegSickness',
                method: 'getParentSickness',
                fieldList: ['ID', 'description', 'employeePositionID', 'dateFrom', 'employeeNumberID', 'dateTo',
                  'dictIllnessReasonID', 'employeeFamilyID', 'avgCalcType', 'standingAll', 'standingYearMonth', 'rate',
                  'dateFromAvg', 'dateToAvg', 'avgSum', 'calcSum', 'source', 'isOnlyFOP', 'illnessKind'],
                orderList: {
                  orderBy: { expression: 'dateFrom', order: 'desc' }
                }
              },
              listeners: {
                change: ctrl => {
                  const me = ctrl.up('form')
                  me.setParentData(ctrl)
                  me.skipRecalcByParent = false
                },
                afterrender: ctrl => {
                  ctrl.onShowContextMenu = function () {
                    let ctrl = this
                    const me = ctrl.up('form')
                    const parentSicknessID = me.record.get('parentSicknessID')
                    let menu = ctrl.contextMenu
                    let editItem = menu.down('[itemID=editItem]')
                    editItem.disabled = !parentSicknessID
                    if (editItem.text === UB.i18n('Попередній лист')) {
                      return
                    }
                    editItem.iconCls = 'u-icon-file-export'
                    editItem.text = UB.i18n('Попередній лист')
                    editItem.handler = function () {
                      const ctrl = this
                      const me = ctrl.up('form')
                      const parentSicknessID = me.record.get('parentSicknessID')
                      if (parentSicknessID) {
                        $App.doCommand({
                          cmdType: 'showForm',
                          formCode: 'hr_docRegSickness',
                          entity: 'hr_docRegSickness',
                          instanceID: parentSicknessID || 0,
                          tabId: 'hr_docRegSickness' + (parentSicknessID || 0),
                          target: $App.getViewport().centralPanel
                        })
                      }
                    }
                  }
                }
              }
            },
            {
              layout: { type: 'hbox' },
              defaults: { labelWidth: 130 },
              items: [
                {
                  attributeName: 'dateFrom',
                  enableKeyEvents: true
                },
                {
                  attributeName: 'dateTo',
                  enableKeyEvents: true,
                  labelWidth: 105
                },
                {
                  attributeName: 'dateFirst',
                  labelWidth: 180
                }
              ]
            },
            {
              attributeName: 'isOnlyFOP',
              labelWidth: 250
            },
            {
              attributeName: 'dictIllnessReasonID',
              fieldList: ['ID', 'name', 'code', 'payElFSSUID', 'payElFSSUID.methodID.code', 'illnessKind', 'payElFSSUID.includeSecondJobs', 'dateFrom', 'dateTo', 'maxDayFOP'],
              orderList: {
                orderBy: { expression: 'orderN', order: 'asc' }
              }
            },
            {
              attributeName: 'employeeFamilyID',
              fieldList: ['ID', 'description', 'employeeID']
            }
          ]
        },
        {
          layout: { type: 'vbox', align: 'stretch' },
          flex: 1,
          defaults: { labelWidth: 140 },
          items: [
            {
              attributeName: 'calendarDayCount',
              fieldLabel: UB.i18n('Календарних днів'),
              readOnly: true
            },
            {
              attributeName: 'notPay'
            },
            {
              layout: { type: 'hbox', align: 'middle' },
              items: [
                {
                  attributeName: 'standingYearMonth',
                  fieldLabel: UB.i18n('Страховий стаж за попередній рік (місяців)'),
                  flagsFix: 1 << 20,
                  enableKeyEvents: true,
                  labelWidth: 140,
                  flex: 1
                },
                {
                  xtype: 'label',
                  name: 'workLess6monthsLabel',
                  flex: 0.7,
                  style: {
                    color: 'red'
                  }
                }
              ]
            },
            {
              layout: { type: 'hbox', align: 'middle' },
              items: [
                {
                  attributeName: 'standingAll',
                  fieldLabel: UB.i18n('Страховий стаж всього (місяців)'),
                  flagsFix: 1 << 21,
                  enableKeyEvents: true,
                  labelWidth: 140,
                  flex: 1
                },
                { attributeName: 'standingAllInYear', hidden: true },
                {
                  xtype: 'label',
                  name: 'standingAllInYearLabel',
                  cls: 'x-form-item-label',
                  flex: 0.7
                }
              ]
            },
            {
              attributeName: 'dayCount',
              fieldLabel: UB.i18n('Днів до сплати'),
              readOnly: true
            },
            {
              xtype: 'numberfield',
              name: 'rateLabel',
              fieldLabel: UB.i18n('Відсоток'),
