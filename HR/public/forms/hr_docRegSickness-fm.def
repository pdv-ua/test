              hideTrigger: true,
              valueToRaw: UB.core.UBUtil.formatAsCurrency,
              decimalPrecision: 2,
              readOnly: true
            },
            {
              attributeName: 'paySum',
              readOnly: true
            }
          ]
        }
      ]
