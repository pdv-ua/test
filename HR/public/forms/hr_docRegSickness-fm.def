                      tooltip: UB.i18n('Коригування сум за аналітиками'),
                      handler: function (btn) {
                        const me = btn.up('form')
                        appHR.setAvgDimensionEdit(me, 'accrualAvg', 143553, 'calcSickness')
                      }
                    },
                    {
                      xtype: 'button',
                      name: 'fillBtn',
                      text: UB.i18n('Додати суми з попереднього документу'),
                      tooltip: UB.i18n('Додати суми з попереднього документу'),
                      iconCls: 'fas fa-angle-double-down',
                      cls: 'fill-action',
                      padding: '10px 0px 10px 10px',
                      handler: function (btn) {
                        const me = btn.up('form')
                        me.setAvgDataFromPriorDocument(me)
                      }
                    }
                  ]
                },
                {
                  xtype: 'acGrid',
                  title: '',
                  name: 'accrualAvg',
                  stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_docRegSickness_accrualAvg'),
                  stateHiddenColumn: false,
                  region: 'center',
                  flex: 1,
                  autoScroll: true,
                  cellEditing: true,
                  notWriteChanges: true,
                  storeType: 'local',
                  showToolBar: false,
                  disablePaging: true,
                  loadMaskMessage: UB.i18n('Завантаження даних...'),
                  summary: { opSum: 'sum', opDays: 'sum', baseSum: 'sum' },
                  summaryDataOnClient: true,
                  ignoreAttr: ['posName', 'depName'],
                  hideActions: ['addNew', 'del', 'addNewByCurrent'],
                  includeContextMenuReadOnly: [],
                  onBeforeEdit: (control, context) => {
                    const me = context.grid.up('form')
                    if (me.attr.parentSicknessID.getValue()) {
                      return false
                    }
                    if (context.record.phantom && context.record.dirtySave !== null) {
                      context.record.dirtySave = null
                    }
                    context.column.field.prevValue = context.value
                  },
                  edit: (control, context) => {
                    const me = context.grid.up('form')
                    me.onGridEdit(me, 'orderRegistryDt', context, control)
                    me.setIsDirty(true)
                  },
                  fields: [
                    { name: 'ID' },
                    { name: 'dateFrom' },
                    { name: 'dateTo' },
                    { name: 'orderID' },
                    { name: 'periodID' },
                    { name: 'flagsFix' },
                    { name: 'accrualDt' },
                    {
                      name: 'periodID.name',
                      columnConfig: {
                        text: UB.i18n('Місяць'),
                        sortable: false,
                        flex: 1
                      }
                    },
                    {
                      name: 'opDays',
                      columnConfig: {
                        text: UB.i18n('Днів'),
                        sortable: false,
                        flex: 1,
                        align: 'right',
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 6) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          return value
                        },
                        editor: {
                          dataType: 'Currency',
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 6
                        }
                      }
                    },
                    {
                      name: 'baseSum',
                      columnConfig: {
                        text: UB.i18n('Заробіток'),
                        sortable: false,
                        flex: 1,
                        align: 'right',
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          if (_.isNumber(value)) {
                            return Ext.util.Format.currency(value, '', 2).replace(/ /g, '')
                          } else return value
                        },
                        editor: {
                          dataType: 'Currency',
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 0
                        }
                      }
                    },
