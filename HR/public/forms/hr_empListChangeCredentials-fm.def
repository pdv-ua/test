/* global Ext AC appAC $App HR UB */
exports.formDef = 'HR.empListChangeCredentials'
const accMainReportsSubOrg = AC.entityUtils.verifyRightsMethod('ac_service', 'subOrg')

Ext.define('HR.empListChangeCredentials', {
  extend: 'Ext.form.Panel',
  height: 600,
  width: 800,
  layout: 'border',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,
  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        region: 'north',
        split: true,
        layout: 'accordion',
        layoutConfig: {
          collapsible: true,
          collapsed: false
        },
        items: [
          {
            xtype: 'panel',
            hidden: true
          },
          {
            title: UB.i18n('Параметри'),
            layout: { type: 'hbox' },
            collapsed: false,
            items: [
              {
                layout: { type: 'hbox' },
                items: [
                  {
                    xtype: 'ubdatefield',
                    name: 'dateFrom',
                    fieldLabel: UB.i18n('Дата з'),
                    allowBlank: true
                  },
                  {
                    xtype: 'ubdatefield',
                    name: 'dateTo',
                    fieldLabel: UB.i18n('Дата по'),
                    allowBlank: true
                  }
                ]
              },
              {
                layout: { type: 'vbox' },
                items: [
                  {
                    layout: { type: 'vbox' },
                    items: [
                      {
                        layout: { type: 'hbox' },
                        items: [
                          HR.controlService.getOrgCombo({
                            labelWidth: 185,
                            width: 500,
                            flex: 1,
                            readOnly: !accMainReportsSubOrg,
                            ubRequest: {
                              entity: 'hr_organization',
                              fieldList: ['mi_data_id', 'description', 'mi_treePath'],
                              whereList: {
                                state: {
                                  expression: '[state]',
                                  condition: '=',
                                  values: {
                                    state: 'ACTIVE'
                                  }
                                },
                                path: {
                                  expression: accMainReportsSubOrg ? '[mi_treePath]' : '[mi_data_id]',
                                  condition: accMainReportsSubOrg ? 'like' : '=',
                                  values: {
                                    state: accMainReportsSubOrg ? `/${appAC.globalOrganization()}/` : appAC.globalOrganization()
                                  }
                                }
                              },
                              orderList: { orderBy: { expression: 'description' } },
                              __mip_ondate: appAC.globalApplicationDate()
                            }
                          })
                        ]
                      },
                      {
                        layout: { type: 'hbox' },
                        items: [
                          {
                            xtype: 'checkbox',
                            name: 'onOrderDate',
                            fieldLabel: UB.i18n('За датою наказу')
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                layout: { type: 'hbox' },
                padding: '50 0 0 0',
                items: [
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Шукати'),
                    iconCls: 'fas fa-search',
                    width: 30,
                    cls: 'green-action',
                    margin: '5 5 0 15',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.searchEmployee()
                    }
                  },
                  {
                    xtype: 'button',
                    tooltip: UB.i18n('Очистити'),
                    iconCls: 'fas fa-eraser',
                    width: 30,
                    cls: 'fill-action',
                    margin: '5 0 0 0',
                    handler: function (btn) {
                      let me = btn.up('form')
                      me.clearSearch()
                    }
                  },
                  {
                    xtype: 'button',
                    iconCls: 'fas fa-print',
                    width: 30,
                    cls: 'blue-action',
                    margin: '5 0 0 0',
                    tooltip: UB.i18n('Друкувати'),
                    handler: function () {
                      me.doReport()
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        xtype: 'ubdetailgrid',
        name: 'employeeNumberListGrid',
        region: 'center',
        flex: 1,
        autoScroll: true,
        loadStoreImmediately: false,
        forceDataLoad: true,
        hideActions: ['addNew', 'addNewByCurrent', 'edit', 'newVersion', 'del', 'history', 'showPreview', 'itemLink',
          'commandLink', 'showDetail', 'audit'],
        cmdData: {
          params: [{
            entity: 'hr_employeeChange',
            method: 'search',
            fieldList: [
              { name: 'employeeID.taxCode', description: UB.i18n('ІПН') },
              { name: 'fullFIO', description: UB.i18n('ПІБ (нове)') },
              { name: 'fullFIOOld', description: UB.i18n('ПІБ (попереднє)') },
              { name: 'orderDate', description: UB.i18n('Дата наказу') },
              { name: 'additInform', description: UB.i18n('Додаткова інформація') }
            ]
          }]
        },
        onItemDblClick: HR.employeeTabs.openEmpCard,
        cmpInitConfig: {
          afterInit: function () {
            const me = this
            const store = me.getStore()
            store.autoLoad = false
          },
          onDeterminateForm: HR.employeeTabs.onDeterminateCard,

          listeners: {
            render: (grid) => {
              grid.menu.removeAll()
              grid.menu.add([HR.employeeTabs.getEmpCardMenu(grid)])
            }
          }
        },
        getExportTitle: function () {
          return UB.i18n('Список працівників, за зміною облікових данних')
        }
      }
    ]

    me.setDefaultParams = (isInit) => {
      const me = this
      me.attr.dateFrom.setValue(new Date((new Date()).getFullYear(), (new Date()).getMonth(), 1, 0, 0, 0, 0))
      me.attr.dateTo.setValue(AC.dateService.lastDayOfMonth(new Date((new Date()).getFullYear(), (new Date()).getMonth(), 1, 0, 0, 0, 0)))
      me.attr.organizationID.setValue(appAC.globalOrganization())
      me.attr.onOrderDate.setValue(false)
    }

    me.clearSearch = () => {
      me.setDefaultParams(false)
    }

    me.searchEmployee = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      const store = me.attr.grid.getStore()
      let req = store.ubRequest
      req.organizationID = me.attr.organizationID.getValue()
      req.dateFrom = AC.dateService.shiftDate(me.attr.dateFrom.getValue())
      req.dateTo = AC.dateService.shiftDate(me.attr.dateTo.getValue())
      req.onOrderDate = me.attr.organizationID.getValue()
      store.load()
    }

    me.on('afterrender', () => {
      const me = this
      me.attr = {
        grid: me.down('[name=employeeNumberListGrid]'),
        dateFrom: me.down('[name=dateFrom]'),
        dateTo: me.down('[name=dateTo]'),
        organizationID: me.down('[name=organizationID]'),
        onOrderDate: me.down('[name=onOrderDate]')
      }
      me.setDefaultParams(true)
    }, me)

    me.validateParams = () => {
      let res
      const params = []

      let ctrl = me.attr.dateFrom
      const dateFrom = ctrl.getValue()
      ctrl = me.attr.dateTo
      const dateTo = ctrl.getValue()

      if (!me.attr.organizationID.getValue()) {
        params.push(AC.viewUtils.formatFieldLabel(UB.i18n('"Організація"')))
      }
      if (params.length) {
        res = {
          msg: UB.i18n(`Не вибрано наступні параметри:<br/>{0}`, params.join(',<br/>'))
        }
      } else {
        if (dateFrom && dateTo && dateFrom > dateTo) {
          res = {
            msg: UB.i18n(`Дата {0} не може перевищувати дату {1}`, AC.viewUtils.formatFieldLabel('"Дпата з "'), AC.viewUtils.formatFieldLabel('"по"'))
          }
        }
      }
      return res
    }

    me.report_code = 'hr_empListChangeCredentials'
    me.doReport = () => {
      let notValidParams = me.validateParams()
      if (notValidParams) {
        AC.viewUtils.showToast(UB.i18n('Інформація'), notValidParams.msg)
        return
      }
      let reportParams = {
        organizationID: me.attr.organizationID.getValue(),
        dateFrom: AC.dateService.shiftDate(me.attr.dateFrom.getValue()),
        dateTo: AC.dateService.shiftDate(me.attr.dateTo.getValue()),
        onOrderDate: me.attr.onOrderDate.getValue()
      }

      $App.doCommand({
        cmdType: 'showReport',
        caption: UB.i18n('Друкована форма'),
        tabId: 'printDocument' + me.report_code + Date.now(),
        target: $App.getViewport().centralPanel,
        cmdData: {
          reportCode: me.report_code,
          reportParams: reportParams,
          reportOptions: {
            allowExportToExcel: true,
            isModal: false
          }
        }
      })
    }

    me.callParent(arguments)
  }
})
