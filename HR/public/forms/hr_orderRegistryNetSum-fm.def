/* global appHR UB AC HR Ext */
exports.formDef = {
  requiredFields: ['orderState', 'description', 'organizationID', 'filterParams', 'empOrderID', 'hasPosted', 'hasProject',
    'payElID.methodID.valuation', 'payElID.methodID.code', 'empOrderID', 'empOrderID.description'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'filterButtonAction'
        },
        {
          orderId: 5,
          actionId: 'postingAction'
        },
        {
          orderId: 6,
          actionId: 'cancelPostingAction'
        },
        {
          orderId: 7,
          actionId: 'exportExcel'
        },
        {
          orderId: 8,
          actionId: 'printDocumentAction'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        {
          layout: { type: 'hbox' },
          flex: 1,
          items: [
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              defaults: { labelWidth: 130 },
              items: [
                {
                  layout: { type: 'hbox' },
                  flex: 1,
                  items: [
                    {
                      attributeName: 'name',
                      xtype: 'textfield',
                      labelWidth: 130,
                      flex: 2
                    },
                    {
                      attributeName: 'orderNumber',
                      fieldLabel: UB.i18n('Номер'),
                      labelWidth: 60,
                      allowBlank: true,
                      flex: 1
                    },
                    {
                      attributeName: 'orderType',
                      hidden: true,
                      flex: 1
                    }
                  ]
                },
                {
                  attributeName: 'payElID',
                  allowBlank: false,
                  fieldList: ['ID', 'description', 'periodType', 'methodID.methodGroupID.code', 'methodID.code',
                    'methodID.valuation', 'calcSumType', 'codeSort', 'isIndividualRate', 'useKPI'],
                  orderList: { orderBy: { expression: 'codeSort' } },
                  skipSetReadOnly: true
                },
                {
                  attributeName: 'periodSalaryID',
                  allowBlank: false,
                  pageSize: 50,
                  fieldList: ['ID', 'description', 'name', 'dateFrom', 'dateTo', 'orgID'],
                  orderList: {
                    orderBy: {
                      expression: 'dateFrom',
                      order: 'desc'
                    }
                  },
                  listeners: {
                    expand: appHR.periodExpand
                  }
                },
                {
                  layout: { type: 'hbox' },
                  flex: 1,
                  items: [
                    {
                      attributeName: 'docNumber',
                      allowBlank: false,
                      fieldLabel: UB.i18n('Наказ №'),
                      labelWidth: 130,
                      flex: 1,
                      skipSetReadOnly: true
                    },
                    {
                      attributeName: 'orderDate',
                      fieldLabel: UB.i18n('від'),
                      labelWidth: 40,
                      flex: 1,
                      skipSetReadOnly: true
                    }
                  ]
                },
                {
                  fieldLabel: UB.i18n('Документ-підстава'),
                  xtype: 'textfield',
                  name: 'orderDescription',
                  fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
                  flex: 1,
                  hidden: true,
                  readOnly: true
                },
                {
                  xtype: 'panel',
                  name: 'filterPanel',
                  padding: '0 0 8 0',
                  flex: 1,
                  layout: { type: 'vbox', align: 'stretch' },
                  items: [

                    {
                      layout: { type: 'hbox' },
                      items: [
                        {
                          attributeName: 'dictMultiGroupID',
                          fieldList: ['ID', 'name', 'orgID'],
                          labelWidth: 130,
                          flex: 1,
                          whereList: {
                            isClose: {
                              expression: '[isClose]',
                              condition: '=',
                              value: false
                            }
                          }
                        },
                        {
                          attributeName: 'includeSubDepGroup',
                          boxLabelAlign: 'after',
                          width: 120,
                          labelWidth: 90
                        }
                      ]
                    },
                    {
                      layout: { type: 'hbox' },
                      items: [
                        {
                          attributeName: 'departmentID',
                          fieldList: ['mi_data_id', 'name', 'orgID'],
                          valueField: 'mi_data_id',
                          displayField: 'name',
                          labelWidth: 130,
                          flex: 1,
                          __mip_recordhistory_all: false,
                          whereList: {
                            state: {
                              expression: '[state]',
                              condition: '=',
                              values: {
                                state: 'ACTIVE'
                              }
                            }
                          }
                        },
                        {
                          attributeName: 'includeSubDep',
                          boxLabelAlign: 'after',
                          width: 120,
                          labelWidth: 90
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              layout: { type: 'vbox', align: 'stretch' },
              flex: 1,
              defaults: { labelWidth: 200 },
              items: [
                {
                  attributeName: 'periodID',
                  fieldLabel: UB.i18n('Період створення'),
                  flex: 2,
                  pageSize: 50,
                  fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID'],
                  orderList: {
                    orderBy: {
                      expression: 'dateFrom',
                      order: 'desc'
                    }
                  },
                  listeners: {
                    expand: appHR.periodExpand
                  }
                },
                {
                  attributeName: 'limitSum',
                  enableKeyEvents: true,
                  decimalPrecision: 2,
                  flex: 1,
                  skipSetReadOnly: true
                },
                {
                  attributeName: 'baseSum',
                  fieldLabel: UB.i18n('Сума премії (чиста)'),
                  enableKeyEvents: true,
                  decimalPrecision: 2,
                  flagsFix: 1,
                  flex: 1,
                  skipSetReadOnly: true
                },
                /* {
                  attributeName: 'rate',
                  enableKeyEvents: true,
                  decimalPrecision: 2,
                  flagsFix: 1 << 9,
                  flex: 1,
                  skipSetReadOnly: true
                }, */
                {
                  attributeName: 'dictFundSourceID',
                  flex: 1
                },
                {
                  layout: { type: 'hbox' },
                  flex: 1,
                  items: [
                    {
                      attributeName: 'periodFromAvg',
                      fieldLabel: UB.i18n('Розрахунок з'),
                      labelWidth: 100,
                      flex: 1,
                      // flagsFix: 1 << 10,
                      pageSize: 80,
                      // hidden: true,
                      fieldList: ['ID', 'name', 'dateFrom', 'dateTo', 'orgID'],
                      orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } },
                      listeners: {
                        expand: appHR.periodExpand
                      }
                    },
                    {
                      attributeName: 'periodToAvg',
                      fieldLabel: UB.i18n('по'),
                      labelWidth: 100,
                      flex: 1,
                      // flagsFix: 1 << 11,
                      pageSize: 80,
                      // hidden: true,
                      fieldList: ['ID', 'name', 'dateFrom', 'dateTo', 'orgID'],
                      orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } },
                      listeners: {
                        expand: appHR.periodExpand
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      xtype: 'acGrid',
      name: 'orderRegistryDt',
      stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_orderRegistryNetSum_orderRegistryDt'),
      region: 'center',
      flex: 1,
      autoScroll: true,
      cellEditing: true,
      notWriteChanges: true,
      storeType: 'local',
      showToolBar: true,
      disablePaging: true,
      loadMaskMessage: UB.i18n('Завантаження даних...'),
      summary: { baseSum: 'sum', paySum: 'sum', paySumAccrual: 'sum', paySumOff: 'sum', paySumAvg: 'sum', calculatedSum: 'sum', sumAvg: 'sum' },
      baseSummary: true,
      summaryDataOnClient: true,
      ignoreAttr: ['posName', 'depName'],
      hideActions: ['addNewByCurrent'],
      includeContextMenuReadOnly: [],
      ignoreAttrNewByCurrent: ['posName', 'depName', 'employeeNumberID.description', 'employeeNumberID'],
      onBeforeEdit: (control, context) => {
        const me = context.grid.up('form')
        return me.beforeGridEdit(me, context)
      },
      edit: (control, context) => {
        const me = context.grid.up('form')
        return me.onGridEdit(me, context)
      },
      customContextActions: [
        HR.orderManager.getOrderRegistryRlAction(null),
        HR.orderManager.getOrderRegistryEmployeeAction(null),
        HR.orderManager.getOrderRegistryDimensionAction()
      ],
      getRowClass: function (record) {
        let cls = ''
        const dateToEmpty = record.data['employeeNumberID.dateToEmpty']
        const workPlaceCode = record.data['employeeNumberID.workPlaceCode']
        const miDeleteUser = record.data.mi_deleteUser
        if (miDeleteUser) cls = 'grd-color-grey'
        else if (workPlaceCode) {
          if (['1', '3'].includes(workPlaceCode)) cls = dateToEmpty ? 'grd-color-blue' : ''
          else if (workPlaceCode === '2') cls = dateToEmpty ? 'grd-color-blue-italic' : 'grd-italic'
          else if (workPlaceCode === '4') cls = dateToEmpty ? 'grd-color-blue' : 'grd-color-lightgreen'
        }
        return cls
      },
      customToolBarActions: [
        {
          name: 'addList',
          iconCls: 'u-icon-list-success',
          cls: 'fill-action',
          scale: 'medium',
          tooltip: UB.i18n('Додати списком'),
          handler: function (btn) {
            const me = btn.up('form')
            me.setEmployeeNumbers(me)
          }
        },
        {
          name: 'importList',
          iconCls: 'el-icon-upload2',
          cls: 'fill-action',
          scale: 'medium',
          tooltip: UB.i18n('Завантажити список працівників'),
          handler: function (ctrl) {
            const me = ctrl.up('form')
            me.loadCsv(ctrl)
          }
        },
        {
          name: 'calc',
          iconCls: 'fas fa-calculator',
          cls: 'fill-action',
          scale: 'medium',
          tooltip: UB.i18n('Розрахувати'),
          handler: function (btn) {
            const me = btn.up('form')
            me.updateIndividuslRate(me)
          }
        }
      ],
      dockedItemsCreated: function (grid) {
        const toolBarItems = grid.dockedItems[0].items
        const oldIdx = toolBarItems.findIndex(item => item.name === 'addNew')
        const newIdx = toolBarItems.findIndex(item => item.name === 'addList')
        if (oldIdx >= 0 && newIdx >= 0) {
          AC.dataService.arraymove(toolBarItems, oldIdx, newIdx)
        }
      },
      enableMultifilter: true,
      fields: [
        { name: 'ID' },
        { name: 'employeeNumberID.dateToEmpty' },
        { name: 'employeeNumberID.workPlaceCode' },
        { name: 'employeeNumberID.mi_deleteUser' },
        {
          name: 'tabNum',
          columnConfig: {
            text: UB.i18n('Таб.№'),
            width: 70,
            filterBy: 'string'
          }
        },
        {
          name: 'employeeNumberID.description',
          columnConfig: {
            text: UB.i18n('Працівник'),
            flex: 1,
            editor: {
              dataType: 'Entity',
              hideEntityItemInContext: true,
              associatedEntity: 'hr_employeeNumberSR',
              storeAttributeValueField: 'employeeNumberID',
              allowBlank: false,
              fieldList: ['ID', 'description', 'orgID', 'dateFrom', 'dateTo', 'posName', 'depName', 'employeeID', 'dateToEmpty', 'workPlaceCode', 'mi_deleteUser', 'tabNum']
            },
            filterBy: 'string'
          }
        },
        { name: 'employeeNumberID' },
        {
          name: 'payElID.description',
          columnConfig: {
            text: UB.i18n('Вид оплати'),
            flex: 1,
            hidden: true,
            filterBy: 'string'
          }
        },
        { name: 'periodCalcID' },
        {
          name: 'periodCalcID.name',
          columnConfig: {
            text: UB.i18n('Розрахунковий період'),
            flex: 1,
            hidden: true,
            filterBy: 'string'
          }
        },
        { name: 'periodSalaryID' },
        {
          name: 'periodSalaryID.name',
          columnConfig: {
            text: UB.i18n('Обліковий період'),
            hidden: true,
            flex: 1,
            filterBy: 'string'
          }
        },
        {
          name: 'dictFundSourceID.name',
          columnConfig: {
            text: UB.i18n('Джерело фінансування'),
            hidden: true,
            flex: 1,
            editor: {
              dataType: 'Entity',
              associatedEntity: 'ac_fundSource',
              storeAttributeValueField: 'dictFundSourceID',
              fieldList: ['ID', 'name']
            },
            filterBy: 'string'
          }
        },
        { name: 'payElID' },
        { name: 'payElID.methodID.code' },
        {
          name: 'planSumAvg',
          columnConfig: {
            text: UB.i18n('Сума обмеження (чиста)'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            filterBy: 'float',
            editor: {
              dataType: 'Currency',
              decimalPrecision: 2,
              flagsFix: 1
            }
          }
        },
        {
          name: 'baseSum',
          columnConfig: {
            text: UB.i18n('Сума премії (чиста)'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            editor: {
              dataType: 'Currency',
              decimalPrecision: 2,
              flagsFix: 1
            },
            filterBy: 'float'
          }
        },
        {
          name: 'calculatedSum',
          columnConfig: {
            text: UB.i18n('Вже нараховано (чиста)'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            filterBy: 'float'
          }
        },
        {
          name: 'paySumAccrual',
          columnConfig: {
            text: UB.i18n('Фактична сума премії (чиста до зняття)'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            editor: {
              dataType: 'Currency',
              decimalPrecision: 2,
              flagsFix: 1 << 21
            },
            filterBy: 'float'
          }
        },
        {
          name: 'rateOff',
          columnConfig: {
            text: UB.i18n('% зняття'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            editor: {
              dataType: 'Currency',
              decimalPrecision: 2,
              flagsFix: 1 << 12
            },
            filterBy: 'float'
          }
        },
        { name: 'paySumOff',
          columnConfig: {
            text: UB.i18n('Сума зняття'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            editor: {
              dataType: 'Currency',
              decimalPrecision: 2,
              flagsFix: 1 << 20
            },
            filterBy: 'float'
          }
        },
        {
          name: 'paySumAccrual.paySumOff',
          columnConfig: {
            text: UB.i18n('Сума до нарахування (чиста)'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            filterBy: 'float',
            renderer: (value, meta, record) => {
              return Ext.util.Format.currency((record.get('paySumAccrual') || 0) - (record.get('paySumOff') || 0), '', 2).replace(/ /g, '')
            }
          }
        },
        {
          name: 'sumAvg'
        },
        {
          name: 'paySum',
          columnConfig: {
            text: UB.i18n('До нарахування'),
            width: 150,
            floatFormat: 2,
            align: 'right',
            sortBy: 'Number',
            filterBy: 'float'
          }
        },
        {
          name: 'posName',
          columnConfig: {
            text: UB.i18n('Посада'),
            width: 150,
            filterBy: 'string'
          }
        },
        { name: 'depName',
          columnConfig: {
            text: UB.i18n('Підрозділ'),
            width: 150,
            filterBy: 'string'
          }
        },
        {
          name: 'mi_createDate',
          columnConfig: {
            text: UB.i18n('Дата створення'),
            dateFormat: 'd.m.Y H:i:s',
            dataType: 'Date',
            hidden: true,
            width: 120,
            editor: {
              dataType: 'Date',
              allowBlank: false
            },
            filterBy: 'date'
          }
        },
        {
          name: 'mi_createUser.fullName',
          columnConfig: {
            text: UB.i18n('Користувач, що створив'),
            hidden: true,
            width: 150,
            filterBy: 'string'
          }
        },
        {
          name: 'mi_modifyDate',
          columnConfig: {
            text: UB.i18n('Дата останнього коригування'),
            hidden: true,
            dateFormat: 'd.m.Y H:i:s',
            dataType: 'Date',
            width: 120,
            editor: {
              dataType: 'Date',
              allowBlank: false
            },
            filterBy: 'date'
          }
        },
        {
          name: 'mi_modifyUser.fullName',
          columnConfig: {
            text: UB.i18n('Користувач, що останнім коригував'),
            hidden: true,
            width: 150,
            filterBy: 'string'
          }
        },
        { name: 'periodCalcID' },
        { name: 'periodCalc' },
        { name: 'periodSalaryID' },
        { name: 'periodSalary' },
        { name: 'flagsFix' },
        { name: 'flagsRec' },
        { name: 'dateFrom' },
        { name: 'dateTo' },
        { name: 'mask' },
        { name: 'days' },
        { name: 'hours' },
        { name: 'planHours' },
        { name: 'planDays' },
        { name: 'dateFromAvg' },
        { name: 'dateToAvg' },
        { name: 'extraRate' },
        { name: 'calcSum' },
        { name: 'dictFundSourceID' },
        { name: 'accrualDt' },
        { name: 'calcParams' }

      ]
    }
  ]
}
