                          flex: 1
                        }
                      ]
                    },
                    {
                      attributeName: 'trfPositionID',
                      fieldLabel: UB.i18n('на посаді'),
                      fieldList: ['ID', 'description', 'workPlaceID.employeeNumberID', 'dictTarifCoeffID',
                        'dictFundSourceID', 'dictFundSourceID.name',
                        'dictProgClassID', 'dictProgClassID.description',
                        'workPlaceID.state', 'workPlaceID.documentID.type',
                        'workPlaceID.dateFrom', 'workPlaceID.dateTo'
                      ],
                      orderList: {
                        orderBy: {
                          expression: 'description',
                          order: 'desc'
                        }
                      },
                      hidden: true
                    },
                    {
                      layout: { type: 'hbox' },
                      defaults: { labelWidth: 100 },
                      items: [
                        {
                          attributeName: 'orderDate',
                          fieldLabel: UB.i18n('Дата наказу'),
                          enableKeyEvents: true,
                          width: 250
                        },
                        {
                          attributeName: 'orderNumber',
                          fieldLabel: UB.i18n('Номер'),
                          enableKeyEvents: true,
