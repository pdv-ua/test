                      hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
                      gridFieldList: ['description'],
                      allowBlank: true,
                      hidden: true
                    },
                    {
                      attributeName: 'dictPositionID',
                      fieldLabel: UB.i18n('Посада'),
                      selectOnFocus: true,
                      fieldList: ['ID', 'caption', 'positionType', 'dictStaffCatID.accCategory'],
                      readOnly: true,
                      skipSetReadOnly: true
