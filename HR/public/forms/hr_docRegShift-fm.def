    },
    {
      xtype: 'tabpanel',
      region: 'center',
      margin: '4, 0, 0, 0',
      items: [
        {
          xtype: 'acGrid',
          name: 'orderRegistryDt',
          title: UB.i18n('Розрахунок'),
          region: 'center',
          flex: 1,
          autoScroll: true,
          notWriteChanges: true,
          storeType: 'local',
          showToolBar: true,
          disablePaging: true,
          loadMaskMessage: UB.i18n('Завантаження даних...'),
          includeCustomReadOnly: ['fillBtn', 'addBtn'],
          includeContextMenuReadOnly: [],
          summary: { paySum: 'sum' },
          summaryDataOnClient: true,
          hideActions: ['addNewByCurrent'],
          entity: 'hr_orderRegistryDt',
          formCode: 'hr_docRegShiftDt',
          viewConfig: {
            markDirty: false
          },
          enableMultifilter: true,
          onSaveEditData: function (me, grid, record, formData) {
            me.setAccrual(me, grid, record, formData)
          },
          beforeOpenForm: function (grid) {
            const me = grid.up('form')
            return (me.attr.dateFrom.getValue() && me.attr.dateTo.getValue() && me.attr.employeePositionID.getValue())
          },
          customToolBarActions: [
            {
              xtype: 'button',
              name: 'fillBtn',
              tooltip: UB.i18n('Заповнити'),
              iconCls: 'fas fa-angle-double-down',
              cls: 'fill-action',
              handler: function (btn) {
                const me = btn.up('form')
                const count = me.attr.orderRegistryDt.getStore().snapshot ? me.attr.orderRegistryDt.getStore().snapshot.getCount() : me.attr.orderRegistryDt.getStore().count()
                if (count) {
                  $App.dialogYesNo('Попередження', UB.i18n('Увага! Наявні записи будуть видалені! Продовжити?'))
                    .then(res => {
                      if (res) {
                        me.addAutoAccruals = true
                        me.calcShift({ me, reload: true })
                      }
                    })
                } else {
                  me.addAutoAccruals = true
                  me.calcShift({ me, reload: true })
                }
              }
            },
            {
              xtype: 'button',
              name: 'addBtn',
              iconCls: 'u-icon-list-success',
              cls: 'fill-action',
              scale: 'medium',
              tooltip: UB.i18n('Додати списком'),
              handler: function (btn) {
                const me = btn.up('form')
                me.setPayElList(me)
              }
            }
          ],
          customPopupMenuItems: [
            {
              text: UB.i18n('Аналітика'),
              iconCls: 'el-icon-notebook-2',
              name: 'dimension',
              cls: 'blue-action',
              handler: (context) => {
                const me = context.up('').grid.up('form')
                let record = context.up('').record || AC.gridUtils.getCurrentRecord(me.attr.orderRegistryDt)
                me.getDimension(me, record)
              }
            },
            {
              xtype: 'menuseparator'
            },
            {
              text: UB.i18n('Видалити запис'),
              iconCls: 'fa fa-trash-o',
              ubID: 'itemDelete',
              handler: function (context) {
                const me = context.up('').grid.up('form')
                const grid = me.attr.orderRegistryDt
                const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                if (record) {
                  $App.dialogYesNo(UB.i18n('Видалення'), UB.i18n('Видалити запис?'))
                    .then(res => {
                      if (res) {
                        Ext.suspendLayouts()
                        grid.suspendEvents()
                        grid.getStore().suspendEvents()
                        grid.getStore().remove(record)
                        grid.getStore().removed = grid.getStore().removed.concat(record.getData())
                        // grid.down('[name=delBtn]').setDisabled(grid.getCheckedRow().length === 0)
                        grid.resumeEvents()
                        grid.getStore().resumeEvents()
                        Ext.resumeLayouts(true)
                        grid.getView().refreshView()
                        grid.GridSummary.dataBind()
                        me.setIsDirty(true)
                      }
                    })
                }
              }
            }
          ],
          fields: [
            { name: 'ID' },
            { name: 'mi_modifyDate' },
            { name: 'orderRegistryID' },
            { name: 'orderID' },
            { name: 'orderNumber' },
            { name: 'employeeNumberID' },
            { name: 'periodCalcID' },
            { name: 'periodSalaryID' },
            { name: 'periodCalc' },
            { name: 'periodSalary' },
            { name: 'payElID' },
            { name: 'mask' },
            { name: 'maskAdd' },
            { name: 'flagsFix' },
            { name: 'flagsRec' },
            { name: 'accrualDt' },
            { name: 'payElID.methodID.code' },
            { name: 'payElID.codeSort' },
            {
              name: 'payElID.description',
              columnConfig: {
                text: UB.i18n('Нарахування'),
                filterBy: 'string',
                flex: 1
              }
            },
            {
              name: 'dateFrom'
              /*   columnConfig: {
                text: UB.i18n('З'),
                width: 50,
                dateFormat: 'd',
                dataType: 'Date'
              } */
            },
            {
              name: 'dateTo'
              /* columnConfig: {
                text: UB.i18n('По'),
                width: 50,
                dateFormat: 'd',
                dataType: 'Date'
              } */
            },
            {
              name: 'dictFundSourceID.name',
              columnConfig: {
                text: UB.i18n('Фінансування'),
                filterBy: 'string',
                flex: 1
              }
            },
            { name: 'dictFundSourceID' },
            {
              name: 'dictProgClassID.description',
              columnConfig: {
                text: UB.i18n('КПК'),
                filterBy: 'string',
                flex: 1
              }
            },
            { name: 'dictProgClassID' },
            {
              name: 'baseSum',
              columnConfig: {
                text: UB.i18n('Сума для розрахунку'),
                width: 150,
                floatFormat: 2,
                sortBy: 'Number',
                filterBy: 'float',
                align: 'right',
                dataType: 'Currency'
              }
            },
            {
              name: 'planDays',
              columnConfig: {
                text: UB.i18n('Норма днів'),
                width: 150,
                floatFormat: 2,
                sortBy: 'Number',
                filterBy: 'float',
                align: 'right',
                dataType: 'Currency',
                hidden: true
              }
            },
            {
              name: 'days',
              columnConfig: {
                text: UB.i18n('Тривалість днів'),
                width: 150,
                floatFormat: 2,
                sortBy: 'Number',
                filterBy: 'float',
                align: 'right',
                dataType: 'Currency',
                hidden: true
              }
            },
            {
              name: 'planHours',
              columnConfig: {
                text: UB.i18n('Норма годин'),
                width: 150,
                floatFormat: 2,
                sortBy: 'Number',
                filterBy: 'float',
                align: 'right',
                dataType: 'Currency'
              }
            },
            {
              name: 'hours',
              columnConfig: {
                text: UB.i18n('Тривалість годин'),
                width: 150,
                floatFormat: 2,
                sortBy: 'Number',
                filterBy: 'float',
                align: 'right',
                dataType: 'Currency'
              }
            },
            {
              name: 'rate',
              columnConfig: {
                text: '%',
                width: 100,
                floatFormat: 2,
                sortBy: 'Number',
                filterBy: 'float',
                align: 'right'
              }
            },
            {
              name: 'paySum',
              columnConfig: {
                text: UB.i18n('Сума'),
                width: 150,
                floatFormat: 2,
                sortBy: 'Number',
                filterBy: 'float',
                align: 'right',
                dataType: 'Currency'
              }
            }
          ]
        },
        {
          title: UB.i18n('Додатки'),
          autoScroll: true,
          layout: { type: 'vbox', align: 'stretch' },
          flex: 1,
          items: [
            {
              xtype: 'docAttachment',
              entity: 'hr_orderAttachment',
              detailFields: 'documentID',
              masterFields: 'ID',
              showOriginal: true,
              minHeight: 55,
              maxHeight: 140,
              height: 95
            }
          ]
        }
      ]
    }
  ]
