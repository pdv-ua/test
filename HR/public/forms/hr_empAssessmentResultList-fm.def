/* global Ext, AC, appAC $App UB */

exports.formDef = 'HR.empAssessmentResultList'

Ext.define('HR.empAssessmentResultList', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  autoScroll: true,
  alias: 'widget.empAssessmentResultList',
  viewConfig: {
    toggleOnDblClick: false
  },
  mainPanel: {
    xtype: 'panel',
    header: false,
    region: 'center',
    flex: 1,
    layout: 'fit',
    items: [
      {
        xtype: 'ubdetailgrid',
        autoScroll: true,
        layout: 'fit',
        flex: 1,
        hideActions: ['addNewByCurrent', 'newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
        stateful: true,
        stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_empAssessmentResultList_grid'),
        cmdType: 'showList',
        cmdData: {
          params: [{
            entity: 'hr_empAssessmentResult',
            method: 'select',
            fieldList: [
              { name: 'assessmentID.assessmentType', description: UB.i18n('Тип оцінювання') },
              { name: 'assessmentID.assessmentTaskType', description: UB.i18n('Тип завдання') },
              { name: 'assessmentID.year', description: UB.i18n('Рік') },
              { name: 'assessmentID.employeeNumberID.description', description: UB.i18n('Працівник'), simpleFilter: true },
              { name: 'assessmentID.positionID.name', description: UB.i18n('Посада'), simpleFilter: true },
              { name: 'assessmentID.positionID.psCategory', description: UB.i18n('Категорія посади') },
              { name: 'assessmentID.departmentID.name', description: UB.i18n('Підрозділ'), simpleFilter: true },
              { name: 'assessmentValue' },
              { name: 'avgValue' },
              { name: 'agreementState' },
              { name: 'appealDate' }
            ]
          }]
        },
        cmpInitConfig: {
          disableAutoLoadStore: true,
          afterInit: function () {
            const grid = this
            AC.gridUtils.setGlobalOrganization(grid, 'organizationID')
            const whereList = grid.getStore().ubRequest.whereList
            whereList.posDateFrom = {
              expression: '[assessmentID.positionID.mi_dateFrom]',
              condition: '<=',
              value: appAC.globalApplicationDate()
            }
            whereList.posDateTo = {
              expression: '[assessmentID.positionID.mi_dateTo]',
              condition: '>=',
              value: appAC.globalApplicationDate()
            }
            whereList.depDateFrom = {
              expression: '[assessmentID.departmentID.mi_dateFrom]',
              condition: '<=',
              value: appAC.globalApplicationDate()
            }
            whereList.depDateTo = {
              expression: '[assessmentID.departmentID.mi_dateTo]',
              condition: '>=',
              value: appAC.globalApplicationDate()
            }
            whereList.posDateDelete = {
              expression: '[assessmentID.positionID.mi_deleteDate]',
              condition: '=',
              value: '#maxdate'
            }
            whereList.posState = {
              expression: '[assessmentID.positionID.state]',
              condition: '=',
              value: 'ACTIVE'
            }
            whereList.depDateDelete = {
              expression: '[assessmentID.departmentID.mi_deleteDate]',
              condition: '=',
              value: '#maxdate'
            }
            whereList.depState = {
              expression: '[assessmentID.departmentID.state]',
              condition: '=',
              value: 'ACTIVE'
            }
            whereList.posIsNull = {
              expression: '[assessmentID.positionID]',
              condition: 'isNull'
            }
            whereList.depIsNull = {
              expression: '[assessmentID.departmentID]',
              condition: 'isNull'
            }
            grid.getStore().ubRequest.logicalPredicates = ['[organizationID] AND (([posDateDelete] AND [posState] AND [posDateFrom] AND [posDateTo]) OR [posIsNull]) AND (([depDateDelete] AND [depState] AND [depDateFrom] AND [depDateTo]) OR [depIsNull])']
          }
        },
        getRowClass: (data) => {
          switch (data.get('assessmentValue')) {
            case 'PERFECT': return 'ub-row-green'
            case 'POSITIVE': return 'ub-row-yellow'
            case 'NEGATIVE': return 'ub-row-red'
            default: return 'ub-row-lightgrey'
          }
        }

      }
    ]
  },
  initComponent: function () {
    let me = this
    me.items = [
      me.mainPanel
    ]
    me.changeGlobal = function () {
      const store = me.down('ubdetailgrid').getStore()
      const globalDate = appAC.globalApplicationDate()
      store.ubRequest.whereList.parentDateFrom.value = globalDate
      store.ubRequest.whereList.parentDateTo.value = globalDate
      store.ubRequest.whereList.dateFrom.value = globalDate
      store.ubRequest.whereList.dateTo.value = globalDate
      store.load()
    }

    me.on('afterrender', () => {
      $App.on('ac:app:operationDateChanged', me.changeGlobal)
    }, me)
    me.on('destroy', () => {
      $App.un('ac:app:operationDateChanged', me.changeGlobal)
    }, me)

    me.callParent(arguments)
  }
})
