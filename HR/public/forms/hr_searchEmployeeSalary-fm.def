/* global Ext UB HR */
exports.formDef = 'HR.searchEmployeeSalaryForm'

Ext.define('HR.searchEmployeeSalaryForm', {
  extend: 'Ext.form.Panel',
  autoScroll: true,
  layout: 'card',
  initComponent: function () {
    let me = this
    me.srchEmpParams = {
      baseEntity: 'hr_employeeNumberSR',
      baseEntityAlias: 'en',
      baseJoinField: 'employeeNumberID',
      joinExclusions: {
        hr_employeeSickLimit: { type: 'changeKeyFields', joinBaseAlias: 'emp', joinBaseField: 'ID', joinParentField: 'employeeID' },
        hr_employeeDisability: { type: 'changeKeyFields', joinBaseAlias: 'emp', joinBaseField: 'ID', joinParentField: 'employeeID' },
        hr_employeeFamily: { type: 'changeKeyFields', joinBaseAlias: 'emp', joinBaseField: 'ID', joinParentField: 'employeeID' },
        hr_employeeExperience: { type: 'changeKeyFields', joinBaseAlias: 'emp', joinBaseField: 'ID', joinParentField: 'employeeID' },
        ac_address: { type: 'changeKeyFields', joinBaseAlias: 'emp', joinBaseField: 'ID', joinParentField: 'ownerID' },
        hr_employeeDocs: { type: 'changeKeyFields', joinBaseAlias: 'emp', joinBaseField: 'ID', joinParentField: 'employeeID' },
        hr_employeeNumber: { type: 'changeKeyFields', joinBaseAlias: 'en', joinBaseField: 'ID', joinParentField: 'ID' }
      },
      searchEntity: 'hr_searchEmployeeSalary',
      getSqlMethod: 'getSearchSql',
      templateEntity: 'hr_employeeSalary',
      categoryValueField: 'categoryCode',
      categoryDisplayField: 'categoryName',
      categoryGroupField: 'parentGroupCode',
      categoryRequest: {
        entity: 'hr_searchAttr',
        method: 'selectCategories4salary',
        fieldList: HR.searchAttrFieldList.getSearchParamsFields('category')
      },
      attrValueField: 'attributeCode',
      attrDisplayField: 'attributeDesc',
      attrRequest: {
        entity: 'hr_searchAttr',
        method: 'selectAttr4salary',
        fieldList: HR.searchAttrFieldList.getSearchParamsFields('attribute')
      },
      addCatInAttrEntity: null,
      mainPanel: null,
      attrPanel: null,
      condPanel: null,
      attrBlockParams: null,
      condBlockParams: null,
      dataPanel: null,
      searchGrid: null,
      sqlLabel: null
    }
    me.tabs = Ext.create('Ext.tab.Panel', {
      items: [
        {
          title: UB.i18n('Форма пошуку'),
          autoScroll: true,
          iconCls: 'fa fa-search-plus',
          layout: {
            type: 'vbox',
            align: 'stretch'
          },
          items: [
            {
              xtype: 'toolbar',
              dock: 'top',
              items: HR.searchUtils.get('toolbar_items', me.srchEmpParams)
            },
            {
              autoScroll: true,
              layout: {
                type: 'hbox',
                align: 'stretch'
              },
              items: [
                {
                  xtype: 'panel',
                  ubID: 'condPanel',
                  autoScroll: true,
                  width: '100%',
                  margins: '0 0 10 0',
                  bodyStyle: { 'background-color': '#f3f2d7' },
                  layout: {
                    type: 'vbox',
                    align: 'stretch'
                  },
                  items: []
                }
              ]
            },
            {
              xtype: 'panel',
              ubID: 'attrPanel',
              autoScroll: true,
              bodyStyle: { 'background-color': '#e8eee9' },
              layout: {
                type: 'hbox',
                align: 'stretch'
              },
              items: []
            }
          ]
        },
        {
          xtype: 'panel',
          ubID: 'dataPanel',
          title: UB.i18n('Результат пошуку'),
          layout: 'card',
          iconCls: 'fa fa-list',
          items: [
            {
              xtype: 'ubdetailgrid',
              ubID: 'searchGrid',
              cmdType: 'showList',
              description: UB.i18n('Працівники'),
              entity: 'hr_searchEmployee',
              emptyText: UB.i18n('За вказаними умовами не знайдено жодного запису'),
              hideActions: ['addNew', 'addNewByCurrent', 'edit', 'del', 'newVersion'],
              cmdData: {
                params: [
                  {
                    entity: 'hr_searchEmployee',
                    method: 'select4search',
                    fieldList: [
                      { name: 'ID', visibility: false },
                      { name: 'tabNum' },
                      { name: 'taxCode' },
                      { name: 'sexType' },
                      { name: 'lastName' },
                      { name: 'firstName' },
                      { name: 'middleName' },
                      { name: 'fullFIO', visibility: false },
                      { name: 'birthDate', format: 'd.m.Y' },
                      { name: 'citizenshipName' },
                      { name: 'educationLevelName', visibility: false },
                      { name: 'depName' },
                      { name: 'posName' },
                      { name: 'dateFrom', format: 'd.m.Y' },
                      { name: 'dateTo', format: 'd.m.Y' },
                      { name: 'mtCount', format: '0.00' },
                      { name: 'payElName' },
                      { name: 'accrualSum' },
                      { name: 'workScheduleName' },
                      { name: 'orgID', visibility: false },
                      { name: 'phoneMobile' },
                      { name: 'phoneWorking' },
                      { name: 'phoneHome' },
                      { name: 'email' },
                      { name: 'employeeID', visibility: false },
                      { name: 'employeeNumberID', visibility: false }
                    ],
                    __totalRecCount: false
                  }
                ]
              },
              cmpInitConfig: {
                selModel: {
                  selectionMode: 'MULTI',
                  showHeaderCheckbox: true,
                  checkOnly: false,
                  selType: 'checkboxmodel'
                }
              },
              onDeterminateForm: HR.employeeTabs.onDeterminateEmpNumberCard,
              contextMenuType: 'employee',
              customActions: HR.searchUtils.get('results_toolbar', me.srchEmpParams)
            }
          ]
        },
        {
          title: 'SQL',
          hidden: true,
          autoScroll: true,
          iconCls: 'fa fa-eye',
          layout: 'card',
          items: [
            {
              xtype: 'label',
              ubID: 'sqlLabel',
              margin: '10 5 0 10',
              fieldStyle: {
                fontWeight: 'bold',
                border: 'none'
              }
            }
          ]
        }
      ]
    })
    me.items = [
      me.tabs
    ]
    me.callParent(arguments)
    me.srchEmpParams.mainPanel = me.tabs
    me.srchEmpParams.dataPanel = me.down('[ubID=dataPanel]')
    me.srchEmpParams.searchGrid = me.down('[ubID=searchGrid]')
    me.srchEmpParams.sqlLabel = me.down('[ubID=sqlLabel]')
    me.srchEmpParams.attrPanel = me.down('[ubID=attrPanel]')
    me.srchEmpParams.condPanel = me.down('[ubID=condPanel]')
    if (me.customParams) {
      me.srchEmpParams.searchAllOrg = me.customParams.searchAllOrg
      me.srchEmpParams.senderParams = me.customParams.senderParams
    }
    HR.searchUtils.initNewSearch(me.srchEmpParams)
    if (me.customParams && me.customParams.searchParams) {
      HR.searchUtils.addCondItems(me.srchEmpParams, me.customParams.searchParams)
    }
  }
})
