/* global Ext _ UB  AC appHR */

exports.formDef = {
  requiredFields: ['description', 'orderRegistryID', 'orderRegistryID.organizationID', 'orderRegistryID.periodID',
    'orderRegistryID.periodID.dateFrom', 'flagsRec', 'orderState', 'flagsFix', 'empOrderID', 'accrualDt', 'empOrderID.description'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'postingAction'
        },
        {
          orderId: 5,
          actionId: 'cancelPostingAction'
        },
        {
          orderId: 6,
          actionId: 'printDocumentAction'
        },
        {
          orderId: 7,
          actionId: 'calcSeverance'
        },
        {
          orderId: 8,
          actionId: 'analytic'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'hbox' },
      items: [
        {
          layout: { type: 'vbox', align: 'stretch' },
          defaults: { labelWidth: 130 },
          flex: 2,
          items: [
            { attributeName: 'employeeID', hidden: true },
            { attributeName: 'employeeNumberID', hidden: true },
            {
              layout: { type: 'hbox' },
              defaults: { labelWidth: 130 },
              items: [
                {
                  attributeName: 'employeePositionID',
                  fieldList: ['ID', 'description', 'organizationID', 'employeeID', 'employeeNumberID', 'dateFrom', 'dateTo',
                    'employeeNumberID.dateFrom', 'employeeNumberID.dateTo', 'workPlace', 'vacancyDateFrom', 'vacancyDateTo'],
                  orderList: { orderBy: { expression: 'employeeNumberID.tabNumSort' } },
                  addWorkPlace: true,
                  addDateTo: true,
                  xtype: 'empPositionCombobox',
                  flex: 1
                },
                {
                  attributeName: 'workPlaceOnly',
                  labelWidth: 150,
                  width: 170
                }
              ]
            },
            {
              attributeName: 'payElID',
              fieldList: ['ID', 'description', 'methodID.code', 'methodID.dayAccumCondition', 'codeSort', 'calcEarnings'],
              orderList: { orderBy: { expression: 'codeSort' } },
              flex: 1
            },
            {
              layout: { type: 'hbox' },
              defaults: { labelWidth: 130 },
              items: [
                {
                  attributeName: 'orderNumber',
                  readOnly: false,
                  allowBlank: true,
                  width: 300
                },
                {
                  attributeName: 'orderDate',
                  labelWidth: 130
                }
              ]
            },
            {
              fieldLabel: UB.i18n('Документ-підстава'),
              xtype: 'textfield',
              name: 'orderDescription',
              fieldStyle: 'text-decoration: none; color: #2f7c94; cursor:pointer; border: 0px;',
              flex: 1,
              hidden: true,
              readOnly: true
            }
          ]
        },
        {
          layout: { type: 'vbox', align: 'stretch' },
          defaults: { labelWidth: 130 },
          items: [
            {
              attributeName: 'dateFrom',
              skipSetReadOnly: true,
              labelWidth: 130,
              width: 260
            },
            {
              attributeName: 'countMonth',
              skipSetReadOnly: true,
              labelWidth: 130,
              width: 260
            },
            {
              attributeName: 'paySum',
              skipSetReadOnly: true,
              readOnly: false,
              labelWidth: 130,
              width: 260
            }
          ]
        }
      ]
    },
    {
      xtype: 'tabpanel',
      region: 'center',
      items: [
        {
          title: UB.i18n('Середній заробіток'),
          layout: { type: 'border' },
          items: [
            {
              xtype: 'panel',
              region: 'west',
              split: true,
              width: 400,
              margin: '0 5 0 0',
              layout: { type: 'vbox', align: 'stretch' },
              defaults: { labelWidth: 130 },
              items: [
                {
                  attributeName: 'avgCalcType',
                  width: 500,
                  readOnly: false,
                  skipSetReadOnly: true,
                  enableKeyEvents: true
                },
                {
                  attributeName: 'dateFromAvg',
                  flagsFix: 1 << 10,
                  skipSetReadOnly: true,
                  enableKeyEvents: true
                },
                {
                  attributeName: 'dateToAvg',
                  flagsFix: 1 << 11,
                  skipSetReadOnly: true,
                  enableKeyEvents: true
                },
                {
                  attributeName: 'avgSumRst',
                  flagsFix: 1 << 0,
                  skipSetReadOnly: true,
                  enableKeyEvents: true,
                  dataType: 'Currency',
                  decimalPrecision: 2
                },
                {
                  attributeName: 'avgDayRst',
                  skipSetReadOnly: true,
                  enableKeyEvents: true,
                  flagsFix: 1 << 13,
                  dataType: 'Currency',
                  decimalPrecision: 2
                },
                {
                  attributeName: 'avgSumWork',
                  skipSetReadOnly: true,
                  enableKeyEvents: true,
                  flagsFix: 1 << 18,
                  dataType: 'Currency',
                  decimalPrecision: 2
                },
                {
                  attributeName: 'calcEarnings',
                  flagsFix: 1 << 23,
                  width: 500,
                  enableKeyEvents: true
                }
              ]
            },
            {
              layout: { type: 'border' },
              region: 'center',
              items: [
                {
                  region: 'north',
                  layout: { type: 'hbox' },
                  items: [
                    {
                      xtype: 'button',
                      name: 'avgDimension',
                      iconCls: 'u-icon-layers',
                      cls: 'blue-action',
                      tooltip: UB.i18n('Коригування сум за аналітиками'),
                      handler: function (btn) {
                        const me = btn.up('form')
                        appHR.setAvgDimensionEdit(me, 'accrualAvg', 143553, 'calcSeverance')
                      }
                    }
                  ]
                },
                {
                  xtype: 'acGrid',
                  title: '',
                  name: 'accrualAvg',
                  stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_docRegSeverancePay_accrualAvg'),
                  stateHiddenColumn: false,
                  region: 'center',
                  flex: 1,
                  autoScroll: true,
                  cellEditing: true,
                  notWriteChanges: true,
                  storeType: 'local',
                  showToolBar: false,
                  disablePaging: true,
                  loadMaskMessage: UB.i18n('Завантаження даних...'),
                  summary: { opSum: 'sum', opDays: 'sum', baseSum: 'sum' },
                  summaryDataOnClient: true,
                  ignoreAttr: ['posName', 'depName'],
                  hideActions: ['addNew', 'del', 'addNewByCurrent'],
                  includeContextMenuReadOnly: [],
                  onBeforeEdit: (control, context) => {
                    if (context.record.phantom && context.record.dirtySave !== null) {
                      context.record.dirtySave = null
                    }
                    context.column.field.prevValue = context.value
                  },
                  edit: (control, context) => {
                    const me = context.grid.up('form')
                    me.onGridEdit(me, 'orderRegistryDt', context, control)
                    me.setIsDirty(true)
                  },
                  fields: [
                    { name: 'ID' },
                    { name: 'dateFrom' },
                    { name: 'dateTo' },
                    { name: 'orderID' },
                    { name: 'periodID' },
                    { name: 'flagsFix' },
                    { name: 'accrualDt' },
                    {
                      name: 'periodID.name',
                      columnConfig: {
                        text: UB.i18n('Місяць'),
                        sortable: false,
                        flex: 1
                      }
                    },
                    {
                      name: 'opDays',
                      columnConfig: {
                        text: UB.i18n('Днів'),
                        sortable: false,
                        flex: 1,
                        align: 'right',
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 6) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          return value
                        },
                        editor: {
                          dataType: 'Currency',
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 6
                        }
                      }
                    },
                    {
                      name: 'opHours',
                      columnConfig: {
                        text: UB.i18n('Годин'),
                        sortable: false,
                        flex: 1,
                        align: 'right',
                        floatFormat: 3,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1 << 7) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          return value
                        },
                        editor: {
                          dataType: 'Float',
                          decimalPrecision: 3,
                          minValue: 0,
                          flagsFix: 1 << 7
                        }
                      }
                    },
                    {
                      name: 'baseSum',
                      columnConfig: {
                        text: UB.i18n('Заробіток'),
                        flex: 1,
                        sortable: false,
                        align: 'right',
                        floatFormat: 2,
                        renderer: (value, meta, record) => {
                          if (record.get('flagsFix') & 1) {
                            meta.tdCls = 'grd-color-blue'
                          }
                          if (_.isNumber(value)) {
                            return Ext.util.Format.currency(value, '', 2).replace(/ /g, '')
                          } else return value
                        },
                        editor: {
                          dataType: 'Currency',
                          decimalPrecision: 2,
                          minValue: 0,
                          flagsFix: 1 << 0
                        }
                      }
                    },
                    {
                      name: 'opSum',
                      columnConfig: {
                        text: UB.i18n('Сума до розрахунку'),
                        sortable: false,
                        flex: 1,
                        align: 'right',
                        floatFormat: 2
                      }
                    }
                  ],
                  customPopupMenuItems: [
                    {
                      text: UB.i18n('Розрахунковий лист'),
                      iconCls: 'el-icon-tickets',
                      ubID: 'itemShowRl',
                      handler: function (context) {
                        const grid = context.up('').grid
                        const me = grid.up('form')
                        const record = context.up('').record || AC.gridUtils.getCurrentRecord(grid)
                        if (record) {
                          appHR.showRl(me.attr.employeeNumberID.getValue(), record.get('periodID'))
                        }
                      }
                    },
                    {
                      text: UB.i18n('Аналітика'),
                      iconCls: 'el-icon-notebook-2',
                      name: 'dimension',
                      cls: 'blue-action',
                      handler: (context) => {
                        const grid = context.up('').grid
                        const me = grid.up('form')
                        appHR.showtAvgDimensinEdit(me, context.up('').record || AC.gridUtils.getCurrentRecord(grid), 12481, 'calcSeverance')
                      }
                    },
                    {
                      text: UB.i18n('Коригування сум за аналітиками'),
                      name: 'avgDimensionRow',
                      iconCls: 'u-icon-layers',
                      cls: 'blue-action',
                      handler: function (context) {
                        const grid = context.up('').grid
                        const me = grid.up('form')
                        appHR.setAvgDimensionRowEdit(me, context.up('').record || AC.gridUtils.getCurrentRecord(grid), 143553, 'calcSeverance')
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          title: UB.i18n('Додаткові параметри'),
          autoScroll: true,
          layout: { type: 'vbox', align: 'stretch' },
          flex: 1,
          items: [
            {
              attributeName: 'dictFundSourceID',
              hideEntityItemInContext: true
            }
          ]
        },
        {
          title: UB.i18n('Додатки'),
          autoScroll: true,
          layout: { type: 'vbox', align: 'stretch' },
          flex: 1,
          items: [
            {
              xtype: 'docAttachment',
              entity: 'hr_orderAttachment',
              detailFields: 'documentID',
              masterFields: 'ID',
              showOriginal: true,
              minHeight: 55,
              maxHeight: 140,
              height: 95
            }
          ]
        }
      ]
    }
  ]
}
