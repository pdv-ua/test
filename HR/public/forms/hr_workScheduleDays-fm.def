exports.formDef = {
  requiredFields: ['numDay'],
  size: {
    width: 1100,
    height: 600
  },
  parentConfig: {
    layout: { type: 'vbox', align: 'stretch' }
  },
  items: [
    {
      attributeName: 'numDay'
    },
    {
      attributeName: 'dictTimeCostID',
      fieldList: ['ID', 'name', 'orderClassID'],
      whereList: {
        orderClassID: {
          expression: '[orderClassID]',
          condition: 'isNull'
        }
      }
    },
    { attributeName: 'hoursWork',
      dataType: 'Float',
      decimalPrecision: 2 },
    { attributeName: 'hoursWorkNight',
      dataType: 'Float',
      decimalPrecision: 2 },
    { attributeName: 'hoursWorkEvening',
      dataType: 'Float',
      decimalPrecision: 2 }
  ]
}
