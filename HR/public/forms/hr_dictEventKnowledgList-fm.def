/* global Ext AC appAC $App UB */

exports.formDef = 'HR.dictEventKnowledgList'

Ext.define('HR.dictEventKnowledgList', {
  extend: 'Ext.panel.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  alias: 'widget.dictEventKnowledgList',
  viewConfig: {
    toggleOnDblClick: false
  },
  autoScroll: true,
  isModal: true,

  initComponent: function () {
    let me = this
    me.items = [
      {
        xtype: 'panel',
        header: false,
        region: 'center',
        flex: 1,
        layout: 'fit',
        items: [
          {
            xtype: 'ubdetailgrid',
            autoScroll: true,
            layout: 'fit',
            flex: 1,
            hideActions: ['newVersion', 'history', 'showPreview', 'itemLink', 'commandLink', 'showDetail'],
            stateful: true,
            stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_dictEventKnowledg_grid'),
            cmdType: 'showList',
            description: UB.i18n('Події ознайомлення'),
            entity: 'hr_dictEventKnowledg',
            cmdData: {
              params: [{
                entity: 'hr_dictEventKnowledg',
                method: 'select',
                fieldList: [
                  { name: 'code', description: UB.i18n('Код'), config: { width: 100 } },
                  { name: 'name', description: UB.i18n('Назва'), config: { width: 250 } },
                  { name: 'nameM', description: UB.i18n('Назва події для друку (чол.)'), config: { width: 250 } },
                  { name: 'nameW', description: UB.i18n('Назва події для друку (жін.)'), config: { width: 250 } }
                ],
                __mip_recordhistory_all: true,
                whereList: {}
              }]
            },
            cmpInitConfig: {
              afterInit: function () {
                AC.gridUtils.setGlobalOrganization(this, 'organizationID')
              }
            }
          }
        ]
      }
    ]
    me.changeGlobal = function () {
      const store = me.down('ubdetailgrid').getStore()
      store.ubRequest.whereList.organizationID.value = appAC.globalOrganization()
      store.load()
    }

    me.on('afterrender', () => {
      $App.on('ac:app:operationDateChanged', me.changeGlobal)
    }, me)
    me.on('destroy', () => {
      $App.un('ac:app:operationDateChanged', me.changeGlobal)
    }, me)

    me.callParent(arguments)
  }
})
