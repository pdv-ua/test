exports.formDef = {
  requiredFields: ['dateFrom', 'dateTo', 'mi_deleteUser', 'employeeID.fullFIO', 'description', 'mi_deleteUser', 'mainEmpNumberID', 'empWorkPlace', 'empDictPositionID'],
  size: {
    width: 1100,
    height: 600
  },
  parentConfig: {
    layout: {
      type: 'hbox',
      align: 'stretch'
    },
    defaults: {
      layout: 'fit'
    }
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [

        {
          orderId: 4,
          actionId: 'rlAction'
        },
        {
          orderId: 5,
          actionId: 'timeSheetAction'
        },
        {
          orderId: 6,
          actionId: 'printAction'
        },
        {
          xtype: 'tbtext',
          text: '',
          orderId: 7,
          ubID: 'personInfo',
          style: {
            'font-style': 'bold',
            'color': '#2196f3',
            'font-size': '20px',
            'margin-left': '0px'
          }
        }
      ]
    }
  ],
  items: [
    {
      width: '100%',
      layout: { type: 'hbox', align: 'stretch' },
      items: [
        {
          xtype: 'panel',
          collapsible: true,
          ubId: 'menuPanel',
          flex: 1.5,
          style: { border: 'solid 1px lightgray' },
          animate: true,
          collapseDirection: 'left',
          layout: 'fit',
          activateTab: function (nodeId, me) {
            me.activateTab(nodeId, me)
          },
          layoutConfig: {
            titleCollapse: true,
            animate: true,
            activeOnTop: false
          },
          items: [
            {
              collapsed: false,
              xtype: 'treepanel',
              rootVisible: false,
              multiSelect: false,
              hideCollapseTool: true,
              lines: false,
              hideHeaders: true,
              hideIcons: true,
              ubID: 'treeInfo',
              listeners: {
                render: function (tree) {
                  const me = tree.view.up('form')
                  me.checkNodeSelection(tree, me)
                },
                select: function (tree, record) {
                  const me = tree.view.up('form')
                  me.treepanelSelect(tree, record)
                }
              },
              findNodeId: function (nodeId) {
                let rootNode = this.getRootNode()
                return rootNode.findChildBy(function (node) {
                  return node.raw.nodeId === nodeId
                }, null, true)
              },
              filters: [],
              addFilterRemoveNodeId: function (nodeId) {
                const me = this
                me.filters.push(nodeId)
              },
              clearFilter: function () {
                const me = this
                while (me.filters.length) {
                  me.filters.pop()
                }
              },
              updateNodes: function () {
                const me = this
                let rootNode = me.getRootInitial()
                let filters = me.filters

                let deleteNodeId = function (rootNode, nodeId) {
                  if (rootNode.children) {
                    let removeItems = []
                    rootNode.children.forEach(node => {
                      if (node.nodeId === nodeId) {
                        removeItems.push(node)
                      } else {
                        deleteNodeId(node, nodeId)
                      }
                    })
                    removeItems.forEach(item => {
                      let index = rootNode.children.indexOf(item)
                      rootNode.children.splice(index, 1)
                    })
                  }
                }
                filters.forEach(item => {
                  deleteNodeId(rootNode, item)
                })

                me.setRootNode(rootNode)
              },
              getRootInitial: function () {
                return {
                  expanded: true,
                  text: UB.i18n('Розділи'),
                  children: [
                    {
                      text: UB.i18n('<span style="font-weight: bold">Основні відомості</span>'),
                      nodeId: 'hr_basicInfo',
                      expanded: true,
                      children: [
                        { text: UB.i18n('Пільги лікарняних'), leaf: true, nodeId: 'hr_employeeSickLimit' },
                        { text: UB.i18n('Пільги ПДФО'), leaf: true, nodeId: 'hr_employeeTaxLimit' },
                        { text: UB.i18n('Інвалідність'), leaf: true, nodeId: 'hr_employeeDisability' }
                      ]
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Призначення</span>'),
                      nodeId: 'hr_employeeNumberPositionEdit',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Інші особові рахунки</span>'),
                      nodeId: 'hr_employeeNumber',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Неявки</span>'),
                      nodeId: 'hr_orderRegistryDt',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Відпустки</span>'),
                      expanded: true,
                      nodeId: 'grpVac',
                      children: [
                        {
                          text: UB.i18n('Право на відпустки, відгули'),
                          leaf: true,
                          nodeId: 'hr_empVacationPlan'
                        },
                        {
                          text: UB.i18n('Відпустки'),
                          leaf: true,
                          nodeId: 'hr_employeeVacation'
                        },
                        {
                          text: UB.i18n('Довготривала відсутність'),
                          leaf: true,
                          nodeId: 'hr_empLongTermAbsc'
                        }
                      ]
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Тарифікація</span>'),
                      nodeId: 'trf_position',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">KPI</span>'),
                      nodeId: 'hr_employeeKpi',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Заробітна плата</span>'),
                      nodeId: 'hr_accrualBalance',
                      expanded: true,
                      children: [
                        { text: UB.i18n('Постійні нарахування'), leaf: true, nodeId: 'hr_employeeAccrualEdit' },
                        { text: UB.i18n('Постійні утримання'), leaf: true, nodeId: 'hr_payRetention' },
                        { text: UB.i18n('Виплата зарплати'), leaf: true, nodeId: 'hr_payOut' }
                      ]
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Накази</span>'),
                      nodeId: 'hr_empOrder',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Договори ЦПХ</span>'),
                      nodeId: 'hr_employeeCPH',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Стаж роботи</span>'),
                      nodeId: 'hr_employeeExperience',
                      expanded: true,
                      children: [
                        { text: UB.i18n('Трудова книжка'), leaf: true, nodeId: 'hr_employeeWorkbook' }
                      ]
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Державна служба</span>'),
                      nodeId: 'hr_employeeNumberServ',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Дипломатична служба</span>'),
                      nodeId: 'hr_employeeNumberDipl',
                      expanded: true,
                      children: []
                    },
                    {
                      text: UB.i18n('<span style="font-weight: bold">Додаткові відомості</span>'),
                      nodeId: 'hr_employeeExtra',
                      expanded: true,
                      children: [
                        { text: UB.i18n('Зміна облікових даних'), leaf: true, nodeId: 'hr_employeeCgh' },
                        { text: UB.i18n('Додаткові гарантії працевлаштування'), leaf: true, nodeId: 'hr_empAddGuarantees' },
                        { text: UB.i18n('Контакти'), leaf: true, nodeId: 'hr_employeeNumberContactAddress' },
                        { text: UB.i18n('Документи'), leaf: true, nodeId: 'hr_employeeDocs' },
                        { text: UB.i18n('Члени сім\'ї'), leaf: true, nodeId: 'hr_employeeFamily' }
                      ]
                    }
                  ]
                }
              }
            }
          ]
