            {
              title: UB.i18n('Виплата зарплати'),
              nodeId: 'hr_payOut',
              hidden: true,
              autoScroll: true,
              flex: 1,
              layout: 'border',
              items: [
                {
                  region: 'north',
                  layout: { type: 'vbox', align: 'stretch' },
                  items: [
                    {
                      xtype: 'toolbar',
                      dock: 'top',
                      ubID: 'mainToolbar',
                      enableOverflow: true,
                      items: [
                        {
                          xtype: 'button',
                          tooltip: UB.i18n('Заповнити банківськи атрибути'),
                          name: 'employeePayrollTemplates',
                          iconCls: 'fas fa-angle-double-down',
                          cls: 'fill-action',
                          handler: function (btn) {
                            const me = btn.up('form')
                            const organizationID = appAC.globalOrganization()
                            const employeePayrollTemplates = AC.settings.get('employeePayrollTemplates', organizationID)
                            UB.Repository('hr_employeeNumber')
                              .attrs('ID', 'payOutID', 'payOutID.name', 'personalAccount', 'bankSubAccount', 'tabNum', 'dateFrom', 'orgID')
                              .where('employeeID', '=', me.record.data.employeeID)
                              .where('ID', '<>', me.instanceID)
                              .where('payOutID', 'isNotNull', undefined, 'w1')
                              .where('personalAccount', 'isNotNull', undefined, 'w2')
                              .where('bankSubAccount', 'isNotNull', undefined, 'w3')
                              .logic('(([w1]) or ([w2]) or ([w3]))')
                              .orderByDesc('dateFrom')
                              .selectAsObject().then(result => {
                                if (!result.length) {
                                  AC.viewUtils.showToast(UB.i18n('Відсутній іншій особовий рахунок з заповненими банковськими атрибутами!'))
                                  return
                                }
                                let empPayroll = result.filter(o => o.orgID === organizationID)
                                if (empPayroll.length && !employeePayrollTemplates) {
                                  empPayroll = result[0]
                                  $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n(`Знайдено особовий рахунок {0} з банківськими атрибутами Шаблон виплати = {1} Номер особового рахунку = {2}, Номер субрахунку = {3}. Замінити?`, empPayroll.tabNum, empPayroll['payOutID.name'], empPayroll.personalAccount, empPayroll.bankSubAccount))
                                    .then(function (choice) {
                                      if (choice) {
                                        me.attr.payOutID.setValue(empPayroll.payOutID)
                                        me.attr.personalAccount.setValue(empPayroll.personalAccount)
                                        me.attr.bankSubAccount.setValue(empPayroll.bankSubAccount)
                                      }
                                    })
                                } else {
                                  if (employeePayrollTemplates) {
                                    empPayroll = result.find(o => o.ID > 0)
                                    $App.dialogYesNo(UB.i18n('Попередження'), UB.i18n(`Знайдено особовий рахунок {0} з банківськими атрибутами Шаблон виплати = {1} Номер особового рахунку = {2}, Номер субрахунку = {3}. Замінити?`, empPayroll.tabNum, empPayroll['payOutID.name'], empPayroll.personalAccount, empPayroll.bankSubAccount))
                                      .then(function (choice) {
                                        if (choice) {
                                          UB.Repository('hr_payOut')
                                            .attrs('ID')
                                            .where('organizationID', '=', organizationID)
                                            .where('name', 'like', `${empPayroll['payOutID.name']}`)
                                            .selectSingle().then(payOutID => {
                                              payOutID ? me.attr.payOutID.setValue(payOutID.ID) : me.attr.payOutID.setValue(null)
                                            })
                                          me.attr.personalAccount.setValue(empPayroll.personalAccount)
                                          me.attr.bankSubAccount.setValue(empPayroll.bankSubAccount)
                                        }
                                      })
                                  } else {
                                    AC.viewUtils.showToast(UB.i18n('Відсутній іншій особовий рахунок з заповненими банковськими атрибутами!'))
                                  }
                                }
                              })
                          }
                        }
                      ]
                    },
                    {
                      attributeName: 'payOutID',
                      fieldList: ['ID', 'name', 'organizationID']
                    },
                    {
                      attributeName: 'personalAccount'
                    },
                    {
                      attributeName: 'bankSubAccount'
                    }
                  ]
                },
                AC.gridUtils.getDefaultGridConfig({
                  title: UB.i18n('Інші способи виплати зарплати'),
                  region: 'center',
                  flex: 1,
                  entityName: 'hr_employeePayOut',
                  fieldList: [
                    { name: 'dateFromEmpty', description: UB.i18n('Початок') },
                    { name: 'dateToEmpty', description: UB.i18n('Кінець') },
                    { name: 'paymentMethod' },
                    { name: 'bankAccount', description: UB.i18n('Номер р/р') },
                    { name: 'personalAccount', description: UB.i18n('Номер о/р') },
                    { name: 'personalSubAccount', description: UB.i18n('Номер c/р') },
                    { name: 'bankID.name', description: UB.i18n('Банк') },
                    { name: 'employeeNumberID', visibility: false },
                    { name: 'isDefault', visibility: false }
                  ],
                  masterEntityName: 'hr_employeeNumber',
