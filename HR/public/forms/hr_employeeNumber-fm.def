                  },
                  flex: 1,
                  items: [
                    {
                      xtype: 'ubcombobox',
                      name: 'sexType',
                      fieldLabel: UB.i18n('Стать'),
                      recordValue: 'employeeID.sexType',
                      formParams: true,
                      hideEntityItemInContext: true,
                      enumGroupFilter: 'HR_SEX_TYPE',
                      valueField: 'code',
                      displayField: 'name',
                      ubRequest: {
