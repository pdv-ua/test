/* global appHR $App UB HR AC */

exports.formDef = {
  requiredFields: ['ID', 'description', 'filterParams', 'orderType', 'orderNumber', 'hasPosted', 'hasProject'],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: { type: 'border' },
    defaults: {
      layout: 'fit'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  dockedItems: [
    {
      xtype: 'toolbar',
      dock: 'top',
      items: [
        {
          orderId: 4,
          actionId: 'postingAction'
        },
        {
          orderId: 5,
          actionId: 'cancelPostingAction'
        }
      ]
    }
  ],
  items: [
    {
      region: 'north',
      autoScroll: true,
      split: true,
      layout: { type: 'vbox', align: 'stretch' },
      items: [
        {
          layout: { type: 'hbox' },
          flex: 1,
          items: [
            { attributeName: 'orderDate', hidden: true },
            { attributeName: 'orderType', hidden: true, readOnly: false },
            { attributeName: 'organizationID', hidden: true },
            {
              attributeName: 'orderNumber',
              fieldLabel: UB.i18n('Номер'),
              allowBlank: false,
              labelWidth: 100,
              width: 300
            },
            {
              attributeName: 'periodID',
              fieldLabel: UB.i18n('Період створення'),
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'name'],
              width: 420,
              labelWidth: 160,
              pageSize: 50,
              orderList: {
                orderBy: {
                  expression: 'dateFrom',
                  order: 'desc'
                }
              },
              listeners: {
                expand: appHR.periodExpand
              }
            },
            {
              attributeName: 'orderState',
              allowBlank: false,
              readOnly: true,
              flex: 1,
              hidden: true,
              labelWidth: 90,
              width: 300
            }
          ]
        },
        {
          attributeName: 'name',
          labelWidth: 100,
          xtype: 'ubtextfield',
          fieldLabel: UB.i18n('Назва'),
          flex: 1
        }
      ]
    },
    {
      xtype: 'panel',
      region: 'center',
      items: [
        {
          xtype: 'ubdetailgrid',
          name: 'orderRegistryDt',
          autoScroll: true,
          hideActions: ['addNew', 'del', 'addNewByCurrent', 'prefilter', 'exportXls', 'exportCsv', 'exportHtml',
            'showPreview', 'itemLink', 'commandLink', 'history', 'edit'
          ],
          stateful: true,
          stateId: UB.core.UBLocalStorageManager.getKeyUI('hr_orderRegistryDogCPHP_orderRegistryDt'),
          disableMenuItemDetails: true,
          flex: 1,
          entityConfig: {
            entity: 'hr_orderRegistryDt',
            method: 'select',
            fieldList: [
              { name: 'ID', visibility: false },
              { name: 'employeeNumberID', visibility: false },
              { name: 'orderID', visibility: false },
              { name: 'orderID.orderState', visibility: false },
              { name: 'orderID.orderClass.entityName', visibility: false },
              { name: 'employeeNumberID.tabNum', description: UB.i18n('Таб.№') },
              { name: 'employeeNumberID.description', description: UB.i18n('ПІБ') },
              { name: 'payElID.name', description: UB.i18n('Вид оплати') },
              { name: 'periodSalaryID.name', description: UB.i18n('Обліковий період') },
              { name: 'paySum', description: UB.i18n('Сума') },
              { name: 'orderNumber', description: UB.i18n('Номер акта') },
              { name: 'orderDate', description: UB.i18n('Дата акта') },
              { name: 'employeeCPHID.orderNumber', description: UB.i18n('Номер договору') },
              { name: 'employeeCPHID.orderDate', description: UB.i18n('Дата договору') },
              { name: 'posName', description: UB.i18n('Посада') },
              { name: 'depName', description: UB.i18n('Підрозділ') },
              { name: 'mi_createDate', description: UB.i18n('Дата створення'), tooltip: UB.i18n('Дата створення') },
              { name: 'mi_createUser.fullName', description: UB.i18n('Користувач, що створив'), tooltip: UB.i18n('Користувач, що створив') },
              { name: 'mi_modifyDate', description: UB.i18n('Дата останнього коригування'), tooltip: UB.i18n('Дата останнього коригування') },
              { name: 'mi_modifyUser.fullName', description: UB.i18n('Користувач, що останнім коригував'), tooltip: UB.i18n('Користувач, що останнім коригував') }
            ],
            orderList: { orderBy: { expression: 'employeeNumberID.tabNumSort' } }
          },
          summary: { paySum: 'sum' },
          masterFields: ['ID'],
          detailFields: ['orderRegistryID'],
          cmpInitConfig: {
            getRowClass: function (row) {
              return row.get('orderID.orderState') === 'POSTED' ? 'ub-row-green' : 'ub-row-lightgrey'
            },
            customActions: [
              {
                text: UB.i18n(`Додати Оплата за договором ЦПХ`),
                iconCls: 'u-icon-add',
                scale: 'medium',
                actionId: 'addNewOrder',
                cls: 'add-new-action',
                handler: function (btn) {
                  const me = btn.up('form')
                  const grid = btn.up('ubdetailgrid')
                  me.saveForm()
                    .then(function (result) {
                      if (result !== -1) {
                        $App.doCommand({
                          cmdType: 'showForm',
                          formCode: 'hr_docRegDogCPHPay',
                          entity: 'hr_docRegDogCPHPay',
                          tabId: 'hr_docRegDogCPHPayNew' + Date.now(),
                          title: UB.i18n(`Оплата за договором ЦПХ`),
                          description: UB.i18n(`Оплата за договором ЦПХ`),
                          target: $App.getViewport().centralPanel,
                          sender: grid.getView(),
                          store: grid.store,
                          cmpInitConfig:
                            {
                              defaultValues: {
                                orderRegistryID: me.record.get('ID'),
                                'orderRegistryID.organizationID': me.record.get('organizationID'),
                                'orderRegistryID.periodID': me.record.get('periodID'),
                                'orderRegistryID.periodID.dateFrom': me.attr.periodID.getFieldValue('dateFrom')
                              }
                            }
                        })
                      } else {
                        $App.dialogInfo(UB.i18n('Необхідно спочатку зберегти Реєстр документів'))
                      }
                    })
                }
              },
              {
                itemId: 'addList',
                text: UB.i18n('Додати списком'),
                actionId: 'addByList',
                iconCls: 'u-icon-edit-alt',
                scale: 'medium',
                cls: 'fill-action',
                handler: function (btn) {
                  const me = btn.up('form')
                  me.saveForm().then(function (result) {
                    if (result === -1) {
                      $App.dialogInfo(UB.i18n('Необхідно спочатку зберегти Реєстр документів'))
                    } else {
                      const grid = btn.up('ubdetailgrid')
                      const sourceData = (grid.getStore().snapshot || grid.getStore().data).items
                      const selectData = sourceData.map(o => o.data['orderID'])
                      $App.doCommand({
                        cmdType: 'showForm',
                        formCode: 'hr_employeeCPHSearch',
                        isModal: true,
                        cmpInitConfig: {
                          dateFrom: me.attr.periodID.getFieldValue('dateFrom'),
                          dateTo: me.attr.periodID.getFieldValue('dateTo'),
                          selectData,
                          onSelect: (data) => {
                            let add = data.filter(d => !selectData.includes(d.dogCPHPayID))
                            let remove = sourceData.filter(o => !data.some(d => o.data.orderID === d.dogCPHPayID)).map(o => o.data.ID)

                            Promise.all(
                              add.map(el => new Promise(resolve =>
                                me.getEmployeePositionID(el.employeeNumberID).then(employeePos => {
                                  if (employeePos) {
                                    $App.connection.insert({
                                      entity: 'hr_docRegDogCPHPay',
                                      fieldList: [
                                        'orderRegistryID',
                                        'orderNumber',
                                        'orderDate',
                                        'employeeID',
                                        'employeeNumberID',
                                        'employeePositionID',
                                        'payElID',
                                        'employeeCPHID',
                                        'paySum'
                                      ],
                                      execParams: {
                                        orderRegistryID: me.record.get('ID'),
                                        orderNumber: el.orderNumber,
                                        orderDate: el.orderDate ? el.orderDate : AC.dateService.todayDate(),
                                        employeeID: el['employeeNumberID.employeeID'],
                                        employeeNumberID: el.employeeNumberID,
                                        employeePositionID: employeePos.ID,
                                        payElID: el.payElID,
                                        employeeCPHID: el.ID,
                                        paySum: el.paySum
                                      }
                                    }).then(() => resolve())
                                  } else {
                                    resolve()
                                  }
                                })
                              )).concat(
                                remove.map(ID =>
                                  $App.connection.doDelete({
                                    entity: 'hr_orderRegistryDt',
                                    fieldList: ['ID'],
                                    execParams: { ID }
                                  })
                                )
                              )
                            ).then(() => grid.getStore().load())
                          }
                        }
                      })
                    }
                  })
                }
              }
            ],
            onItemDblClick: function (grid, record) {
              if (record.get('orderID')) {
                let ubdetailgrid = grid.up('ubdetailgrid')
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode: 'hr_docRegDogCPHPay',
                  entity: 'hr_docRegDogCPHPay',
                  title: UB.i18n(`Оплата за договором ЦПХ`),
                  isModal: false,
                  instanceID: record.get('orderID'),
                  tabId: 'hr_docRegDogCPHPay' + record.get('ID'),
                  target: $App.getViewport().centralPanel,
                  sender: ubdetailgrid.getView(),
                  store: ubdetailgrid.store
                })
              }
            }
          },
          listeners: {
            render: grid => {
              grid.menu.add([
                HR.orderManager.getOrderRegistryDeleteAction(grid),
                HR.orderManager.getOrderRegistryRlAction(grid),
                HR.orderManager.getOrderRegistryEmployeeAction(grid)
              ])
            }
          }
        }
      ]
    }
  ]
}
