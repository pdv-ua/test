/* global Ext UB $App appAC */

exports.formDef = 'HR.employeeCabSelect'

Ext.define('HR.employeeCabSelect', {
  extend: 'Ext.form.Panel',
  width: 1100,
  height: 600,
  layout: 'border',
  initComponent: function () {
    const me = this
    const queryDelay = 500
    let allGrid
    let selGrid
    const storeMain = Ext.create('Ext.data.Store', {
      groupField: 'groupCode',
      columnName: 'caption',
      remoteSort: true,
      fields: [
        { name: 'idx' },
        { name: 'code' },
        { name: 'groupCode' },
        { name: 'caption' },
        { name: 'sortNum' }
      ],
      data: []
    })
    storeMain.sort('sortNum', 'ASC')
    function setFilter () {
      storeMain.filter({
        id: 'searchTask',
        property: 'caption',
        condition: UB.core.UBCommand.condition.sqlecLike,
        value: searchCtrl.getValue(),
        anyMatch: true,
        caseSensitive: false
      })
    }
    function clearFilter () {
      storeMain.filters.removeAtKey('searchTask')
      storeMain.clearFilter()
    }
    const doQueryTask = new Ext.util.DelayedTask(function () {
      const value = searchCtrl.getValue()
      if (value === '') {
        clearFilter()
      } else {
        setFilter()
      }
    }, me)
    const searchCtrl = Ext.widget('textfield', {
      labelWidth: 60,
      fieldLabel: UB.i18n('filter')
    })
    searchCtrl.on('change', function () {
      doQueryTask.delay(queryDelay)
    })
    const storeSel = Ext.create('Ext.data.ArrayStore', {
      fields: [
        { name: 'idx' },
        { name: 'code' },
        { name: 'groupCode' },
        { name: 'caption' },
        { name: 'sortNum' }
      ],
      data: []
    })
    me.items = [
      allGrid = Ext.create('Ext.grid.Panel', {
        xtype: 'grid',
        store: storeMain,
        features: [{
          id: 'group',
          ftype: 'grouping',
          groupHeaderTpl: ['<input class="grpCheckbox" {[values.rows[0].data.isGroupChecked ? "checked" : ""]} type="checkbox"> {[this.styleFunc(values)]}{[this.nameFunc(values)]}</span></font>', {
            styleFunc: function (values) {
              return values.rows.filter(row => (row.get('isChecked') !== '' && row.get('isChecked'))).length ? '<span  style="color: blue; ">' : '<span  style="color: black; ">'
            },
            nameFunc: function (values) {
              switch (values.groupValue) {
                case 'grpEmplCard':
                  return UB.i18n('Облікова картка')
                case 'grpInfo':
                  return UB.i18n('Інформація')
                case 'grpMessage':
                  return UB.i18n('Повідомлення')
                case 'grpSubordinateEmployees':
                  return UB.i18n('Підпорядковані працівники')
                case 'grpSystemFunctions':
                  return UB.i18n('Функції системи')
              }
            }
          }],
          enableGroupingMenu: false,
          hideGroupHeader: true,
          startCollapsed: true
        }],
        viewConfig: {
          markDirty: false
        },
        listeners: {
          groupclick: function (grid, node, group, event, eOpts) {
            if (event && grid) {
              const store = allGrid.getStore()
              const storeSel = selGrid.getStore()
              Ext.suspendLayouts()
              allGrid.suspendEvents()
              store.suspendEvents()
              selGrid.suspendEvents()
              storeSel.suspendEvents()
              const target = event.getTarget('.grpCheckbox')
              const groupRecord = store.groups.getByKey(group)
              if (target && store && groupRecord) {
                const checked = target.checked
                allGrid.updatingRecords = true
                selGrid.updatingRecords = true
                groupRecord.records.forEach(function (rec) {
                  rec.beginEdit()
                  if (checked) {
                    if (!rec.get('isChecked')) {
                      rec.set('isChecked', checked)
                      storeSel.add(rec)
                    }
                  } else {
                    if (rec.get('isChecked')) {
                      rec.set('isChecked', checked)
                      const selRec = storeSel.data.find(row => row.data.code === rec.get('code'))
                      if (selRec) {
                        storeSel.remove(selRec)
                      }
                    }
                  }
                  rec.set('isGroupChecked', checked)
                  rec.endEdit(true)
                })
                allGrid.updatingRecords = false
                selGrid.updatingRecords = false
                if (allGrid.view.features[0].isExpanded(group)) {
                  allGrid.view.features[0].collapse(group)
                } else {
                  allGrid.view.features[0].expand(group)
                }
              }
              allGrid.resumeEvents()
              store.resumeEvents()
              selGrid.resumeEvents()
              storeSel.resumeEvents()
              Ext.resumeLayouts(true)
              allGrid.getView().refreshView()
              selGrid.getView().refreshView()

              me.down('[name=saveBtn]').setDisabled(false)
            }
          },
          scope: me
        },
        autoScroll: true,
        flex: 1,
        split: true,
        region: 'west',
        title: UB.i18n('Всі вкладки'),
        collapsible: true,
        columnLines: true,
        plugins: [Ext.create('Ext.grid.plugin.CellEditing', {
          clicksToEdit: 1
        })],
        tbar: Ext.create('Ext.toolbar.Toolbar', {
          height: 40,
          items: [
            {
              xtype: 'button',
              tooltip: UB.i18n('Відмітити всі'),
              iconCls: 'u-icon-check',
              cls: 'green-action',
              listeners: {
                click: function () {
                  const store = allGrid.getStore()
                  const storeSel = selGrid.getStore()
                  Ext.suspendLayouts()
                  allGrid.suspendEvents()
                  store.suspendEvents()
                  selGrid.suspendEvents()
                  storeSel.suspendEvents()

                  if (searchCtrl.getValue() !== '') {
                    clearFilter()
                  }
                  allGrid.updatingRecords = true
                  selGrid.updatingRecords = true

                  allGrid.getStore().each(rec => {
                    rec.beginEdit()
                    if (!rec.get('isChecked')) {
                      rec.set('isChecked', true)
                      storeSel.add(rec)
                    }
                    rec.endEdit(true)
                  })
                  allGrid.updatingRecords = false
                  selGrid.updatingRecords = false
                  store.groups.each(group => {
                    setGroupChecked(me, group.records[0].get('groupCode'))
                  })
                  allGrid.resumeEvents()
                  store.resumeEvents()
                  selGrid.resumeEvents()
                  storeSel.resumeEvents()
                  Ext.resumeLayouts(true)
                  selGrid.getView().refreshView()

                  me.down('[name=saveBtn]').setDisabled(false)
                }
              }
            },
            {
              xtype: 'button',
              tooltip: UB.i18n('Виключити всі'),
              iconCls: 'u-icon-close',
              cls: 'red-action',
              listeners: {
                click: function () {
                  const store = allGrid.getStore()
                  const storeSel = selGrid.getStore()
                  Ext.suspendLayouts()
                  allGrid.suspendEvents()
                  store.suspendEvents()
                  selGrid.suspendEvents()
                  storeSel.suspendEvents()
                  if (searchCtrl.getValue() !== '') {
                    clearFilter()
                  }
                  allGrid.updatingRecords = true
                  selGrid.updatingRecords = true

                  allGrid.getStore().each(rec => {
                    rec.beginEdit()
                    rec.set('isChecked', false)
                    const selRec = storeSel.data.find(row => row.data.code === rec.get('code'))
                    if (selRec) {
                      storeSel.remove(selRec)
                    }
                    rec.endEdit(true)
                  })
                  allGrid.updatingRecords = false
                  selGrid.updatingRecords = false
                  store.groups.each(group => {
                    setGroupChecked(me, group.records[0].get('groupCode'))
                  })
                  allGrid.resumeEvents()
                  store.resumeEvents()
                  selGrid.resumeEvents()
                  storeSel.resumeEvents()
                  Ext.resumeLayouts(true)
                  selGrid.getView().refreshView()

                  me.down('[name=saveBtn]').setDisabled(false)
                }
              }
            },
            searchCtrl
          ]

        }),
        columns: [
          { xtype: 'checkcolumn', dataIndex: 'isChecked' },
          {
            header: UB.i18n('Розділ'),
            dataIndex: 'caption',
            flex: 1
          }
        ]
      }),
      selGrid = Ext.widget('grid', {
        xtype: 'grid',
        stripeRows: true,
        store: storeSel,
        autoScroll: true,
        region: 'center',
        flex: 1,
        title: UB.i18n('Вибрані вкладки'),
        columns: [{
          header: UB.i18n('Сторінка'),
          dataIndex: 'caption',
          flex: 1
        }],
        tbar: Ext.create('Ext.toolbar.Toolbar', { height: 40 }),

        listeners: {
          itemdblclick: function (row, record) {
            if (searchCtrl.getValue() !== '') {
              clearFilter()
            }
            storeSel.remove(record)
            const rec = storeMain.data.find(row => row.data.code === record.get('code'))
            rec.set('isChecked', false)
            if (searchCtrl.getValue() !== '') {
              setFilter()
            }
          }
        }
      })
    ]
    me.tbar = [
      {
        xtype: 'button',
        scale: 'medium',
        name: 'saveBtn',
        iconCls: 'u-icon-save',
        tooltip: UB.i18n('save'),
        disabled: true,
        cls: 'save-action',
        handler: function (btn) {
          const codes = []
          storeSel.data.each(record => {
            codes.push({ code: record.get('code'), caption: record.get('caption'), groupCode: record.get('groupCode') })
          })
          me.setLoading(true)
          $App.connection.run({
            entity: 'hr_employeeCardSetting',
            method: 'saveSelection',
            codes: JSON.stringify(codes),
            orgID: appAC.globalOrganization()
          }).then(() => {
            me.down('[name=saveBtn]').setDisabled(true)
            me.isFormSaving = true
            me.setLoading(false)
          })
        }
      }
    ]
    me.bbar = [
      '->'
    ]
    me.allGrid = allGrid
    me.selGrid = selGrid
    me.on('afterrender', function () {
      loadData(me, storeMain)
    })
    me.callParent(arguments)
  }
})

async function loadData (me, store) {
  const storeSel = me.selGrid.getStore()
  store.un('update', me.onStoreUpdate)
  let codeList = await UB.Repository('hr_employeeCardSetting')
    .attrs(['params'])
    .where('orgID', '=', appAC.globalOrganization())
    .selectSingle()
  let codeListBaze = await UB.Repository('hr_employeeCardSetting')
    .attrs(['params'])
    .where('orgID', '=', 0)
    .where('isDefault', '=', true)
    .selectSingle()
  const result = []
  codeListBaze.params.forEach(row => {
    result.push({
      groupCode: row.groupCode,
      code: row.code,
      caption: row.caption
    })
  })
  store.loadData(result)

  const allRecord = store.snapshot || store.data
  if (!codeList) {
    allRecord.items.forEach((row, idx) => {
      row.set('isChecked', true)
      storeSel.add(row)
    })

    store.on('update', onStoreUpdate, me)

    store.groups.each(group => {
      setGroupChecked(me, group.records[0].get('groupCode'))
    })
  } else {
    const params = typeof codeList.params === 'string' ? JSON.parse(codeList.params) : codeList.params
    allRecord.items.forEach((row, idx) => {
      if (params.find(el => el.code === row.get('code'))) {
        row.set('isChecked', true)
        storeSel.add(row)
      }
    })

    store.on('update', onStoreUpdate, me)

    store.groups.each(group => {
      setGroupChecked(me, group.records[0].get('groupCode'))
    })
  }

  me.setLoading(false)
}

function onStoreUpdate (store, record) {
  const me = this
  const storeSel = me.selGrid.getStore()
  if (record.get('isChecked')) {
    storeSel.add(record)
  } else {
    const rec = storeSel.data.find(row => row.data.code === record.get('code'))
    if (rec) {
      storeSel.remove(rec)
    }
  }
  setGroupChecked(me, record.get('groupCode'))
  me.down('[name=saveBtn]').setDisabled(false)
}

function setGroupChecked (me, groupName) {
  let isGroupChecked = true
  const store = me.allGrid.getStore()
  const groupRecord = store.groups.getByKey(groupName)
  groupRecord.records.forEach(rec => {
    if (!rec.get('isChecked')) {
      isGroupChecked = false
    }
  })
  me.allGrid.updatingRecords = true

  groupRecord.records.forEach(function (rec) {
    rec.beginEdit()
    rec.set('isGroupChecked', isGroupChecked)
    rec.endEdit(true)
  })
  me.allGrid.updatingRecords = false
  me.allGrid.getView().refreshView()
}
