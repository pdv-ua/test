    function getSignatoryEmpl (title = UB.i18n('Підписанти')) {
      return {
        itemId: 'tabSettings',
        title,
        autoScroll: true,
        margin: '5,0,0,0',
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        items: [
          {
            region: 'north',
            autoScroll: true,
            split: false,
            layout: { type: 'hbox' },
            items: [
              {
                layout: { type: 'vbox', align: 'stretch' },
                flex: 1,
                items: [
                  {
                    xtype: 'panel',
                    region: 'south',
                    items: [
                      {
                        xtype: 'button',
                        name: 'btnSave',
                        tooltip: UB.i18n('Зберегти підписантів'),
                        iconCls: 'u-icon-save',
                        cls: 'save-action',
                        margin: '0 0 0 5',
                        handler: function (ctrl) {
                          const me = ctrl.up('form')
                          const tradeUnionCommitteeID = me.attr.tradeUnionCommitteeID && me.attr.tradeUnionCommitteeID.getValue() ? me.attr.tradeUnionCommitteeID.getValue() : null
                          const headTradeUnionCommittee = me.attr.headTradeUnionCommittee && me.attr.headTradeUnionCommittee.getValue() ? me.attr.headTradeUnionCommittee.getValue() : null
                          const orgID = me.attr.organization && me.attr.organization.getValue() ? me.attr.organization.getValue() : appAC.globalOrganization()
                          const report = me.commandData.reportCode
                          const headEmployeePositionShortFIO = me.attr.headEmployeePositionID && me.attr.headEmployeePositionID.getRawValue() ? me.attr.headEmployeePositionID.getRawValue() : null
                          const leaderDepartmentShortFIO = me.attr.leaderDepartment && me.attr.leaderDepartment.getRawValue() ? me.attr.leaderDepartment.getRawValue() : null
                          me.setLoading(true)
                          $App.connection.run({
                            entity: 'trf_constructorReportsSetting',
                            method: 'saveSetting',
                            orgID,
                            report,
                            execParams: JSON.stringify({
                              tradeUnionCommitteeID,
                              headTradeUnionCommittee,
                              orgID,
                              report,
                              headEmployeePositionShortFIO,
                              leaderDepartmentShortFIO
                            })
                          }).then((res, reg) => {
                            me.setLoading(false)
                          })
                        }
                      }
                    ]
                  },
                  getHeadEmployeePositionCtrl(),
                  setLeaderDepartment(),
                  setTradeUnionCommittee(),
                  setHeadTradeUnionCommittee()
                ]
              },
              {
                layout: { type: 'vbox', align: 'stretch' },
                flex: 1,
                items: []
              }
            ]
          }
        ]
      }
    }
    function onParamSelect (selectedRow) {
      const store = me.attr.reportValuesGrid.getStore()
      let orgID = appAC.globalOrganization()
      const parentOrdID = AC.settings.get('hrUseReportSettingsParentOrg', orgID)
      if (parentOrdID) {
        orgID = Number(parentOrdID)
      }
      if (!selectedRow || !selectedRow.get('ID')) {
        me.attr.currentParamFld.setValue('')
        me.attr.reportValuesGrid.parentContext = {
          listParamID: null,
          orgID: null
        }
        store.ubRequest.tableNameForMapping = null
        store.ubRequest.whereList.byParam = {
          expression: '[listParamID]',
          condition: 'isNull'
        }
        store.ubRequest.whereList.byOrg = {
          expression: '[orgID]',
          condition: 'isNull'
        }
        me.attr.reportValuesPanel.hide()
      } else {
        me.attr.currentParamFld.setValue(selectedRow.get('listParamID.fullName'))
        me.attr.reportValuesGrid.parentContext = {
          listParamID: selectedRow.get('listParamID'),
          listParamCode: selectedRow.get('listParamID.code'),
          orgID: orgID
        }
        store.ubRequest.tableNameForMapping = selectedRow.get('listParamID.tableName')
        store.ubRequest.whereList.byParam = {
          expression: '[listParamID]',
          condition: 'equal',
          values: { paramID: me.attr.reportValuesGrid.parentContext.listParamID }
        }
        store.ubRequest.whereList.byOrg = {
          expression: '[orgID]',
          condition: 'equal',
          values: { orgID: me.attr.reportValuesGrid.parentContext.orgID }
        }
        me.attr.reportValuesPanel.show()
      }
      me.attr.reportValuesGrid.onRefresh()
    }
    function getPayElGroupListParamTabs (me, currTabs, title) {
      currTabs.push(
        {
          title,
          xtype: 'panel',
          layout: 'fit',
          align: 'stretch',
          border: 2,
          layoutConfig: {
            collapsible: true,
            collapsed: true
          },
          flex: 1,
          items: [
            {
              xtype: 'panel',
              layout: { type: 'hbox', align: 'stretch' },
              items: [
                {
                  xtype: 'panel',
                  layout: 'fit',
                  width: 300,
                  items: [
                    {
                      xtype: 'entitygridpanel',
                      itemId: 'reportParamGrid',
                      cmdType: 'showList',
                      formCode: 'hr_groupParamConsol',
                      entityConfig: {
                        entity: 'hr_reportParam',
                        method: 'select',
                        fieldList: [
                          {
                            name: 'listParamID',
                            visibility: false
                          },
                          {
                            name: 'listParamID.shortName',
                            description: UB.i18n('Назва показника'),
                            editor: {
                              maxWidth: 300,
                              width: 300,
                              whereList: {
                                byTable: {
                                  expression: '[tableName]',
                                  condition: 'isNotNull'
                                }
                              }
                            },
                            config: {
                              width: 300,
                              maxWidth: 300,
                              resizable: false
                            }
                          },
                          {
                            name: 'listParamID.fullName',
                            visibility: false
                          },
                          {
                            name: 'listParamID.code',
                            visibility: false
                          },
                          {
                            name: 'listParamID.tableName',
                            visibility: false
                          }
                        ],
                        whereList: {
                          byActualParam: {
                            expression: '[listParamID.mi_deleteUser]',
                            condition: 'isNull'
                          },
                          byReport: {
                            expression: '[reportCode]',
                            condition: 'equal',
                            value: 'consolidatedStatement'
                          }
                        }
                      },
                      parentContext: {
                        reportCode: me.reportCode
                      },
                      detailFields: ['reportCode'],
                      disableSearchBar: true,
                      hideMenuAllActions: true,
                      menuAllActionsActionList: [],
                      toolbarActionList: ['addNew', 'del'],
                      afterInit: function () {
                        this.plugins.filter(p => p.alias.indexOf('plugin.rowediting') >= 0).forEach(p => { p.clicksToEdit = 2 })
                      },
                      listeners: {
                        afterRender: (grid) => {
                          me.attr.reportParamGrid.on('selectionchange', (selectionModel, selected) => {
                            onParamSelect(selected && selected[0])
                          })
                          me.attr.reportParamGrid.store.on('load', () => {
                            if (!me.attr.reportParamGrid.getSelectionModel().getSelection().length && me.attr.reportParamGrid.store.count()) {
                              onParamSelect(me.attr.reportParamGrid.store.getAt(0))
                            }
                          })
                      
                          me.attr.reportParamGrid.on('changeData', () => {
                            me.attr.reportParamGrid.store.reload()
                          })
                        }
                      },
                      onItemDblClick: function (grid, record) {
                        $App.doCommand({
                          cmdType: 'showForm',
                          entity: 'hr_listParam',
                          formCode: 'hr_groupParamConsol',
                          instanceID: record.get('listParamID'),
                          sender: me.attr.reportParamGrid,
                          cmpInitConfig: {
                            currTabs
                          },
                          store: grid.getStore()
                        })
                      },
                      onAddNew: function () {
                        $App.doCommand({
                          cmdType: 'showForm',
                          entity: 'hr_listParam',
                          formCode: 'hr_groupParamConsol',
                          sender: me.attr.reportParamGrid,
                          cmpInitConfig: {
                            bindToReport: 'consolidatedStatement',
                            hideEntityRow: true,
                            hideCodeRow: true
                          }
                        })
                      },
                      onItemContextMenu: function () {}
                    }
                  ]
                },
                {
                  xtype: 'panel',
                  layout: 'fit',
                  flex: 1,
                  items: [
                    {
                      xtype: 'panel',
                      itemId: 'reportValuesPanel',
                      layout: 'border',
                      bodyStyle: { backgroundColor: 'white' },
                      items: [
                        {
                          xtype: 'textfield',
                          itemId: 'currentParamFld',
                          disabled: true,
                          region: 'north'
                        },
                        {
                          xtype: 'panel',
                          layout: 'fit',
                          padding: '0 15 0 15',
                          region: 'center',
                          items: [
                            {
                              xtype: 'entitygridpanel',
                              itemId: 'reportValuesGrid',
                              flex: 1,
                              rowEditing: true,
                              cmdType: 'showList',
                              entityConfig: {
                                entity: 'hr_idParam',
                                method: 'select',
                                fieldList: [
                                  {
                                    name: 'entryOperationID',
                                    visibility: false
                                  },
                                  {
                                    name: 'entryOperationID.code',
                                    description: UB.i18n('Код'),
                                    config: {
                                      align: 'center'
                                    }
                                  },
                                  {
                                    name: 'entryOperationID.name',
                                    description: UB.i18n('Назва'),
                                    config: {
                                      align: 'center'
                                    }
                                  }
                                ],
                                whereList: {
                                  byParam: {
                                    expression: '[listParamID]',
                                    condition: 'isNull'
                                  },
                                  byOrg: {
                                    expression: '[orgID]',
                                    condition: '=',
                                    value: AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) || appAC.globalOrganization()
                                  }
                                },
                                orderList: {
                                  byOrderN: { expression: '[orderN]' }
                                }
                              },
                              disableSearchBar: true,
                              hideMenuAllActions: true,
                              menuAllActionsActionList: [],
                              toolbarActionList: ['refresh'],
                              customActions: [{
                                itemId: 'valuesList',
                                text: UB.i18n('Додати списком'),
                                actionId: 'addByList',
                                iconCls: 'fas fa-edit',
                                scale: 'medium',
                                cls: 'fill-action',
                                handler: function (btn) {
                                  let payElEntryType = ['PAYMENT']
                                  if (me.attr.reportValuesGrid.parentContext.listParamCode.indexOf('_TaxPaid') > 0 || me.attr.reportValuesGrid.parentContext.listParamCode.indexOf('_PaySum') > 0) {
                                    payElEntryType = ['PAYMENT', 'OFFTAKE', 'FORPAY']
                                  }
                                  UB.Repository('hr_idParam')
                                    .where('[listParamID]', '=', me.attr.reportValuesGrid.parentContext.listParamID)
                                    .where('[orgID]', '=', me.attr.reportValuesGrid.parentContext.orgID)
                                    .attrs(['listParamID', 'valuesID', 'ID'])
                                    .selectAsObject()
                                    .then(result => {
                                      $App.doCommand({
                                        cmdType: 'showForm',
                                        formCode: 'hr_entryOperationList',
                                        cmpInitConfig: {
                                          withPeriod: true,
                                          enableOrderN: true,
                                          payElEntryType: payElEntryType,
                                          selectData: result.map(o => o.valuesID),
                                          sourceData: result,
                                          sourceAttr: 'valuesID',
                                          listParamID: me.attr.reportValuesGrid.parentContext.listParamID,
                                          orgID: me.attr.reportValuesGrid.parentContext.orgID,
                                          onSelectData: (data) => {
                                            if ((data.remove && data.remove.length) || (data.add && data.add.length)) {
                                              $App.connection.run({
                                                entity: 'hr_idParam',
                                                method: 'updateEntryOperationIDs',
                                                listParamID: me.attr.reportValuesGrid.parentContext.listParamID,
                                                orgID: me.attr.reportValuesGrid.parentContext.orgID,
                                                data: JSON.stringify(data)
                                              }).then(() => {
                                                me.attr.reportValuesGrid.getStore().load()
                                              })
                                            }
                                          }
                                        }
                                      })
                                    })
                                }
                              }],
                              detailFields: ['listParamID', 'orgID'],
                              afterInit: function () {
                                this.plugins.filter(p => p.alias.indexOf('plugin.rowediting') >= 0).forEach(p => { p.clicksToEdit = 2 })
                              },
                              onItemContextMenu: function () {}
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        })
    }

