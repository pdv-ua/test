          getReportTab(),
          getReportSalaryCostsSetting(),
          getOrgSetting()
        ]
        break
      case 'trf_statement':
        tabs = [
          getReportTab()
        ]
        getListParamPos(tabs, [{ code: 'ReportStatement', title: UB.i18n('Перелік посад') }],
          [
            {
              name: 'listParamID',
              visibility: false
            },
            {
              name: 'orgID',
              visibility: false
            },
            {
              name: 'valuesID',
              visibility: false
            },
            {
              name: 'dictPositionID.name',
              description: UB.i18n('Посада'),
              config: {
                flex: 1
              }
            },
            {
              name: 'orderN',
              config: {
                flex: 0.5,
                align: 'center'
              }
            },
            {
              name: 'dictPositionID.positionCategory',
              description: UB.i18n('Категорія посади'),
              config: {
                flex: 0.5,
                align: 'center'
              }
            },
            {
              name: 'dictPositionID.dictStaffSubCatID.name',
              description: UB.i18n('Підкатегорія персоналу'),
              config: {
                flex: 0.5,
                align: 'center'
              }
            }
          ],
          'hr_idParam-dictPosition',
          'hr_posReportSelect',
          true,
          UB.i18n('Редагувати список'),
          false,
          { byUser: false }
        )
        tabs.push(getOrgSetting())
        break
      case 'trf_reportSummaryStatementRates':
        tabs = [
          getReportTab(),
          getOrgSetting()
        ]
        break
      case 'trf_payrollEducation':
        tabs = [
          getReportTab(),
          getPayrollEducationSetting(),
          getOrgSetting()
        ]
        break
      case 'trf_annexMemorialOrder':
        tabs = [
          getReportTab(),
          getannexMemorialOrderSetting(),
          getOrgSetting()
        ]
        break
      case 'trf_consolidatedStatementDeductions':
      case 'trf_consolidatedStatementDictProgClass':
      case 'trf_consolidatedStatementDepartment':
        tabs = [
          getReportTab()
        ]
        getListParamTabs(tabs, [{ code: 'ReportСSD', title: UB.i18n('Види оплат') }],
          [
            {
              name: 'listParamID',
              visibility: false
            },
            {
              name: 'orgID',
              visibility: false
            },
            {
              name: 'valuesID',
              visibility: false
            },
            {
              name: 'payElID.name',
              description: UB.i18n('Вид оплати'),
              config: {
                flex: 1
              }
            },
            {
              name: 'orderN',
              config: {
                flex: 0.5,
                align: 'center'
              }
            },
            {
              name: 'payElID.methodID.methodGroupID.groupType',
              description: UB.i18n('Тип'),
              config: {
                flex: 1
              }
            },
            {
              name: 'payElID.methodID.methodGroupID.name',
              description: UB.i18n('Група'),
              config: {
                flex: 1
              }
            }
          ],
          'hr_idParam-payEl',
          'hr_payElSelect',
          true,
          UB.i18n('Редагувати список'),
          false,
          { byUser: false }
        )
        getPayElGroupListParamTabs(me, tabs, UB.i18n('Групи для нарахування на заробітню плату'))
        tabs.push(getOrgSetting())
        break
      default:
        tabs = [
          getReportTab()
        ]
        break
    }

    const buttons = [
      {
        xtype: 'button',
        scale: 'medium',
        tooltip: UB.i18n('Сформувати звіт'),
        iconCls: 'fas fa-calculator',
        cls: 'green-action',
        handler: function () {
          if (me.down('acGrid') && (me.down('acGrid').name === 'employeeList') && !me.down('acGrid').getCheckedRow().length) {
            me.clearPrintForm()
            return $App.dialogInfo(UB.i18n('Не обрано жодного працівника для створення звіту'), UB.i18n('Увага'))
          }
          me.onButtonRefresh(me)
        }
      },
      {
        tooltip: UB.i18n('Друкувати'),
        iconCls: 'fas fa-print',
        cls: 'blue-action',
        handler: function () {
          const iFrame = me.reportControl.getEl()
          if (!iFrame) {
            $App.dialogInfo(UB.i18n('Необхідно спочатку сформувати звіт.'))
            return
          }
          iFrame.dom.contentWindow.print()
        }
      },
      {
        tooltip: UB.i18n('Редагувати'),
        iconCls: 'u-icon-edit-alt',
        scale: 'medium',
        cls: 'fill-action',
        handler: function () {
          $App.doCommand({
            cmdType: 'showForm',
            formCode: 'ac_documentEdit',
            caption: UB.i18n('Редагування друкованої форми'),
            cmpInitConfig: {
              reportData: me.report ? me.report.reportOptions.html : null,
              reportOptions: me.report ? me.report.reportOptions : null,
              hiddenActions: ['actionPDF']
            },
            tabId: 'printDocumentEdit' + (new Date()).getTime(),
            description: me.initialConfig.commandConfig.description,
            target: $App.getViewport().centralPanel
          })
        }
      },
      {
        tooltip: 'XLSX',
        iconCls: 'fas fa-file-excel',
        cls: 'green-action',
        hidden: !(reportOptions && reportOptions.allowExportToExcel),
        handler: item => {
          me.validateFields() && me.makeHtmlReport('xlsx')
        }
      }
    ]
    container = Ext.create('Ext.panel.Panel', {
      layout: {
        type: 'vbox',
        align: 'stretch'
      },
      flex: 1,
      items: [
        {
          xtype: 'toolbar',
          items: buttons
        },
        {
          xtype: 'panel',
          layout: { type: 'vbox', align: 'stretch' },
          items
        },
        {
          xtype: 'tabpanel',
          itemId: 'cmpTabPanel',
          flex: 1,
          minWidth: 250,
          margin: '10 10 10 10',
          plain: true,
          items: tabs
        }
      ]
    })
    me.items = [
      container
    ]
    me.reportControl = control

    const reportMethod = {
      trf_reportEmpList: 'getBaseReport',
      trf_reportEmpDNZList: 'getBaseReport',
      trf_reportList: 'getReportList',
      trf_reportSummaryStatementRates: 'getSammaryRates',
      trf_statement: 'getStatement',
      trf_wholeSchoolIndicators: 'getWholeSchoolIndicators',
      trf_salaryCosts: 'getSalaryCosts',
      trf_annexMemorialOrder: 'getAnnexMemorialOrder5',
      trf_consolidatedStatementDeductions: 'getConsolidatedStatementDeductions',
      trf_consolidatedStatementDictProgClass: 'getConsolidatedStatementDictProgClass',
      trf_consolidatedStatementDepartment: 'getConsolidatedStatementDepartment',
      trf_reportsTimesheet: 'getTimesheet',
      trf_reportsTimesheetTechnicalStaff: 'getTimesheet',
      trf_payrollEducation: 'getPayrollEducation'
    }
    const reportEntity = {
      getBaseReport: 'trf_constructorReports',
      getReportList: 'trf_constructorReports',
      getConsolidatedStatementDepartment: 'trf_constructorReports',
      getSammaryRates: 'trf_constructorReports',
      getStatement: 'trf_constructorReports',
      getWholeSchoolIndicators: 'trf_constructorReports',
      getSalaryCosts: 'trf_constructorReports',
      getConsolidatedStatementDeductions: 'trf_constructorReports',
      getConsolidatedStatementDictProgClass: 'trf_constructorReports',
      getAnnexMemorialOrder5: 'hr_memorialOrder5',
      getTimesheet: 'trf_constructorReports',
      getTimesheetTechnicalStaff: 'trf_constructorReports',
      getPayrollEducation: 'trf_constructorReports'
    }

    function makeHtmlData (grid, addData) {
      const gridStore = grid.getStore()

      const resultData = Object.assign({
        accrual: [],
        allSum: {},
        notes: []
      }, addData)

      resultData.accrual = gridStore && gridStore.data && gridStore.data.items && gridStore.data.items.length > 0 ? gridStore.data.items.map(item => item.data) : null

      if (grid.summary) {
        for (const prop in grid.summary) {
          resultData.allSum[prop] = 0
        }
      }

      if (resultData.accrual) {
        resultData.accrual.forEach((item, i) => {
          item.num = i + 1
          for (const prop in resultData.allSum) {
            item[prop] = item[prop] ? AC.currencyService.round(item[prop], 2) : 0 // round
            resultData.allSum[prop] = AC.currencyService.round(resultData.allSum[prop] += item[prop], 2)
          }
        })
      }

      const filter = grid.getStore().filters
      filter.items.forEach(filt => {
        const curFilter = grid.extendedFieldList.find(el => el.name === filt.property)
        resultData.notes.push({ filterName: `${curFilter.description}:`, value: filt.value })
      })

      if (gridStore.sorters.items[0]) {
        resultData.sorter = gridStore.sorters.items[0].property
      }

      return resultData
    }

    function makeReport (type, grid = false) {
      function createReport (type, reportCode, params) {
        me.report = Ext.create('UBS.UBReport', {
          code: reportCode,
          type,
          params,
          language: $App.connection.userLang()
        })
        if (type === 'xlsx') {
          me.report.makeReport().then(function (data) {
            const blobData = new Blob(
              [data.reportData], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' })
            const repName = reportCode.split('-').slice(-1)
            const fileName = `${repName}.xlsx`
            window.saveAs(blobData, fileName)
            me.setLoading(false)

            me.reportType = 'html'
          })
        } else {
          me.report
            .init()
            .then(function () {
              return me.report.makeReport()
            })
            .then(function (data) {
              if (data && data.reportData) {
                if (data.reportData.length > 10000000) {
                  data = null
                  me.report = Ext.create('UBS.UBReport', {
                    code: reportCode,
                    type: 'xlsx',
                    params,
                    language: $App.connection.userLang()
                  })
                  me.report.makeReport().then(function (xlsxData) {
                    const blobData = new Blob(
                      [xlsxData.reportData], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' })
                    const repName = reportCode.split('-').slice(-1)
                    const fileName = `${repName}.xlsx`
                    window.saveAs(blobData, fileName)
                    me.setLoading(false)
                  })
                } else {
                  me.showReport(data.reportData)
                  me.setLoading(false)
                }
              }
              me.setLoading(false)
              me.reportDone = true
            })
        }
      }
      const headEmployeePositionShortFIO = me.attr.headEmployeePositionID && me.attr.headEmployeePositionID.getValue() ? me.attr.headEmployeePositionID.getRawValue() : me.savedSettings && me.savedSettings.params && me.savedSettings.params.headEmployeePositionShortFIO ? me.savedSettings.params.headEmployeePositionShortFIO : ''

      const leaderDepartmentShortFIO = me.attr.leaderDepartment && me.attr.leaderDepartment.getValue() ? me.attr.leaderDepartment.getRawValue() : me.savedSettings && me.savedSettings.params && me.savedSettings.params.leaderDepartmentShortFIO ? me.savedSettings.params.leaderDepartmentShortFIO : ''

      const headTradeUnionCommitteeShortFIO = me.attr.headTradeUnionCommittee && me.attr.headTradeUnionCommittee.getValue() ? me.attr.headTradeUnionCommittee.getRawValue() : me.savedSettings && me.savedSettings.params && me.savedSettings.params.headTradeUnionCommittee ? me.savedSettings.params.headTradeUnionCommittee : ''

      const tradeUnionCommitteeShortFIO = me.record.tradeUnionCommitteeID && me.record.tradeUnionCommitteeID.length ? me.record.tradeUnionCommitteeID : me.savedSettings && me.savedSettings.params && me.savedSettings.params.tradeUnionCommitteeID ? me.savedSettings.params.tradeUnionCommitteeID : ''
      $App.connection.run({
        entity: reportEntity[reportMethod[reportCode]],
        method: reportMethod[reportCode],
        orgID: appAC.globalOrganization(),
        periodID: me.record.periodID,
        dictFundSourceID: me.attr.dictFundSourceID ? me.attr.dictFundSourceID.getValue() : '',
        isIncludeEmpty: false,
        execParams: Object.assign({
          reportParams: me.commandData.cmpInitConfig ? me.commandData.cmpInitConfig.reportParams : null,
          reportCode,
          reportType: type,
          reportColum,
          tarificationType: me.attr.tarificationType ? me.attr.tarificationType.getValue() : 'FACT',
          currDate: appAC.globalApplicationDate(),
          orgID: appAC.globalOrganization(),
          orgName: appAC.globalOrganizationName(),
          organizationName: me.attr.organization ? me.attr.organization.getRawValue() : null,
          dictFundSourceID: me.attr.dictFundSourceID ? me.attr.dictFundSourceID.getValue() : null,
          dictFundSourceName: me.attr.dictFundSourceID ? me.attr.dictFundSourceID.getRawValue() : '',
          positionCategory: me.attr.positionCategory ? me.attr.positionCategory.value : null,
          workPlaceType: me.attr.workPlaceType ? me.attr.workPlaceType.getValue() : '1',
          dictExperienceID: me.attr.dictExperienceID ? me.attr.dictExperienceID.getValue() : null,
          orgIDs: me.down('[name=subDepList]') ? JSON.stringify(me.down('[name=subDepList]').getCheckedRow().map(o => o.data.mi_data_id)) : null,
          empGrid: me.down('[name=employeeList]') ? JSON.stringify(me.down('[name=employeeList]').getCheckedRow().map(o => o.data.ID)) : null,
          dictProgClassID: me.attr.dictProgClassID ? me.attr.dictProgClassID.getValue() : null,
          joinReport: me.attr.joinReport ? me.attr.joinReport.getValue() : null,
          showJoinReport: me.attr.joinReport ? me.attr.joinReport.hidden : null,
          headEmployeePositionShortFIO,
          leaderDepartmentShortFIO,
          tradeUnionCommitteeShortFIO,
          headTradeUnionCommitteeShortFIO
        }, me.record)
      }).then(mParams => {
        let resultData = JSON.parse(mParams.resultData)
        type = me.reportType

        if (grid) {
          resultData = makeHtmlData(grid, resultData)
          type = me.reportType
        }
        createReport(type, reportCode, resultData)
      }, e => {
        me.setLoading(false)
        throw e
      })
    }

    me.makeHtmlReport_OLD = function (type = 'html') {
      me.setLoading(true)
      $App.connection.run({
        entity: 'trf_constructorReports',
        method: reportMethod[reportCode],
        execParams: Object.assign({
          reportCode,
          orgID: appAC.globalOrganization(),
          currDate: appAC.globalApplicationDate()
        }, me.record)
      }).then(mParams => {
        let resultData = JSON.parse(mParams.resultData)
        const listUbdetailgrid = me.listUbdetailgrid
        if (listUbdetailgrid) {
          resultData = makeHtmlData(listUbdetailgrid, resultData)
        }

        me.report = Ext.create('UBS.UBReport', {
          code: reportCode,
          type,
          params: resultData,
          language: $App.connection.userLang()
        })

        const listGrid = me.queryById('listGrid')
        if (listGrid) {
          listGrid.setLocalStoreData(resultData.accrual)
        }

        if (type === 'xlsx') {
          me.report.makeReport().then(function (data) {
            const blobData = new Blob(
              [data.reportData], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' })
            const repName = reportCode.split('-').slice(-1)
            const fileName = `${repName}.xlsx`
            window.saveAs(blobData, fileName)
            me.setLoading(false)
          })
        } else {
          me.report
            .init()
            .then(function () {
              return me.report.makeReport()
            })
            .then(function (data) {
              if (data && data.reportData) {
                if (data.reportData.length > 10000000) {
                  data = null
                  me.report = Ext.create('UBS.UBReport', {
                    code: reportCode,
                    type: 'xlsx',
                    params: resultData,
                    language: $App.connection.userLang()
                  })
                  me.report.makeReport().then(function (xlsxData) {
                    const blobData = new Blob(
                      [xlsxData.reportData], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' })
                    const repName = reportCode.split('-').slice(-1)
                    const fileName = `${repName}.xlsx`
                    window.saveAs(blobData, fileName)
                    me.setLoading(false)
                  })
                } else {
                  me.showReport(data.reportData)
                  me.setLoading(false)
                }
              } else {
                me.setLoading(false)
                me.reportDone = true
              }
            })
        }
      })
    }

    me.makeHtmlReport = function (type = 'html') {
      me.reportType = type

      me.setLoading(true)
      const tabReport = me.queryById('tabReport')
      const cmpTabPanel = me.queryById('cmpTabPanel')
      cmpTabPanel.setActiveTab(tabReport)

      const listUbdetailgrid = me.listUbdetailgrid
      if (listUbdetailgrid) {
        const store = listUbdetailgrid.getStore()
        let req = store.ubRequest
        const objParam = Object.assign({
          reportCode,
          orgID: appAC.globalOrganization(),
          currDate: appAC.globalApplicationDate()
        }, me.record)
        req = Object.assign(req, objParam)
        store.load({ start: 0, limit: 10000, page: 1 })
        me.setLoading(false)
      } else {
        makeReport(type)
      }
    }

    me.clearPrintForm = function () {
      if (me.report && me.reportControl) {
        const iFrame = me.reportControl.getEl().dom
        const iFrameDoc = iFrame.contentDocument
        iFrameDoc.body.innerHTML = ''
      }
      const listUbdetailgrid = me.listUbdetailgrid
      if (listUbdetailgrid && listUbdetailgrid.store && listUbdetailgrid.store.data) {
        const ubgStore = listUbdetailgrid.getStore()
        ubgStore.data.items = []
        listUbdetailgrid.view.refresh()

        listUbdetailgrid.GridSummary.items.each(function (item) {
          let el
          if (item.baseColumn.summaryType) {
            el = item.getEl()
            el.setHTML('')
          }
        })
      }
    }

    me.callParent(arguments)
  },
  onSaveTemplate: function (me, reportCode, saveAs) {
    const params = {}
    if (me.templateAttrs[reportCode]) {
      me.templateAttrs[reportCode].forEach(attrName => {
        const ctrl = me.down(`[name=${attrName}]`)
        if (ctrl) {
          params[attrName] = ctrl.getGridValue ? ctrl.getGridValue(ctrl) : ctrl.getValue()
        }
      })
    }
    if (!me.down(`[name=reportTemplate]`).getValue() || saveAs) {
      $App.doCommand({
        cmdType: 'showForm',
        formCode: 'ac_reportTemplates',
        entity: 'ac_reportTemplates',
        cmpInitConfig: {
          reportCode,
          organizationID: appAC.globalOrganization(),
          params,
          onSave: (ID) => {
            me.down(`[name=reportTemplate]`).setValueById(ID)
          }
        }
      })
    } else {
      AC.reportService.updateReportTemplate({ ID: me.down(`[name=reportTemplate]`).getValue(), params })
    }
  },
  onButtonRefresh: function (me) {
    me.validateFields() && me.makeHtmlReport()
  },
  showReport: function (data) {
    const me = this
    const HTML_PAGEBREAK_RE = new RegExp('<!-- pagebreak -->', 'gi')
    const HTML_PAGEBREAK_EL = '<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" class="mce-pagebreak"/>'
    const iFrame = me.reportControl.getEl().dom
    const iFrameDoc = iFrame.contentDocument
    const style = [getStyle()]
    const orientation = me.report.reportOptions.pageOrientation
    if (orientation === 'landscape') {
      style.push('@page{size: landscape;}')
    } else if (orientation === 'portrait') {
      style.push('@page{size: portrait;}')
    }
    const styleText = `<style type="text/css"> ${style.join('\n')} </style>`
    me.report.reportOptions.html = data
    iFrameDoc.body.innerHTML = data.replace(HTML_PAGEBREAK_RE, HTML_PAGEBREAK_EL)
    iFrameDoc.head.innerHTML = styleText
    me.setLoading(false)
  },
  afterRender: function () {
    const me = this
    me.callParent()
    const titleByReport = {
      trf_reportList: UB.i18n('Тарифікаційний листок'),
      trf_reportListOneColum: UB.i18n('Тарифікаційний листок'),
      trf_reportEmpList: UB.i18n('Тарифікаційний список працівників'),
      trf_reportEmpDNZList: UB.i18n('Тарифікаційний список працівників ДНЗ'),
      trf_reportSummaryStatementRates: UB.i18n('Зведена відомість фактично зайнятих ставок'),
      trf_statement: UB.i18n('Зведена тарифікаційна відомість'),
      trf_wholeSchoolIndicators: UB.i18n('Загальношкільні показники'),
      trf_salaryCosts: UB.i18n('Зведена відомість фактичних витрат на заробітну плату працівникам освіти'),
      trf_annexMemorialOrder: UB.i18n('Додаток до меморіального ордеру №5'),
      trf_consolidatedStatementDeductions: UB.i18n('Зведена відомість нарахувань та утримань (Організації та КПК)'),
      trf_consolidatedStatementDictProgClass: UB.i18n('Зведена відомість нарахувань та утримань (КПК)'),
      trf_consolidatedStatementDepartment: UB.i18n('Зведена відомість нарахувань та утримань (Підрозділи)'),
      trf_reportsTimesheet: UB.i18n('Табель обліку використання робочого часу (педперсонал)'),
      trf_reportsTimesheetTechnicalStaff: UB.i18n('Табель обліку використання робочого часу (сади та тех.персонал шкіл)'),
      trf_payrollEducation: UB.i18n('Розрахункова відомість (освіта)')
    }
    me.templateAttrs = {
      'trf_consolidatedStatementDeductions': ['payElListParams'],
      'trf_consolidatedStatementDictProgClass': ['payElListParams'],
      'trf_consolidatedStatementDepartment': ['payElListParams']
    }
    me.setTitle(titleByReport[me.commandData.reportCode])

    const fieldsAfterrender = {
      periodID: fld => {
        appHR.getCurrentPeriod(appAC.globalOrganization()).then(res => {
          fld.setValueById(res.ID)
        })
      },
      periodFromID: fld => {
        if (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams && me.commandData.cmpInitConfig.reportParams.periodFrom) {
          appHR.getPeriodOnDate(appAC.globalOrganization(), me.commandData.cmpInitConfig.reportParams.periodFrom).then(res => {
            if (res && res.ID) {
              me.record.reportDate = res.ID
              fld.setValueById(res.ID)
            }
          })
        } else {
          appHR.getCurrentPeriod(appAC.globalOrganization()).then(res => {
            if (res && res.ID) {
              me.record.reportDate = res.ID
              fld.setValueById(res.ID)
            }
          })
        }
      },
      periodToID: fld => {
        if (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams && me.commandData.cmpInitConfig.reportParams.periodFrom) {
          appHR.getPeriodOnDate(appAC.globalOrganization(), me.commandData.cmpInitConfig.reportParams.periodFrom).then(res => {
            if (res && res.ID) {
              me.record.reportDate = res.ID
              fld.setValueById(res.ID)
            }
          })
        } else {
          appHR.getCurrentPeriod(appAC.globalOrganization()).then(res => {
            if (res && res.ID) {
              me.record.reportDate = res.ID
              fld.setValueById(res.ID)
            }
          })
        }
      },
      reportDate: fld => {
        if (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams && me.commandData.cmpInitConfig.reportParams.dateReport) {
          fld.setValue(me.commandData.cmpInitConfig.reportParams.dateReport)
          me.record.reportDate = me.commandData.cmpInitConfig.reportParams.dateReport
        } else {
          fld.setValue(appAC.globalApplicationDate())
          me.record.reportDate = appAC.globalApplicationDate()
        }
      },
      issueDate: fld => {
        if (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams && me.commandData.cmpInitConfig.reportParams.dateReport) {
          fld.setValue(me.commandData.cmpInitConfig.reportParams.dateReport)
          me.record.issueDate = me.commandData.cmpInitConfig.reportParams.dateReport
        } else {
          fld.setValue(appAC.globalApplicationDate())
          me.record.issueDate = appAC.globalApplicationDate()
        }
      },
      tarificationType: fld => {
        if (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams && me.commandData.cmpInitConfig.reportParams.tarificationType) {
          fld.setValueById(me.commandData.cmpInitConfig.reportParams.tarificationType)
          me.record.tarificationType = me.commandData.cmpInitConfig.reportParams.tarificationType
        } else {
          fld.setValueById('FACT')
          me.record.tarificationType = 'FACT'
        }
      }
    }
    me.listUbdetailgrid = me.queryById('listUbdetailgrid')
    me.getForm().getFields().getRange().forEach(item => {
      me.attr[item.name] = item
      !item.allowBlank && !item.hidden && me.requiredAttr.push(item)
    })

    Object.keys(fieldsAfterrender).forEach(item => {
      me.attr[item] && fieldsAfterrender[item](me.attr[item])
    })

    me.actionsKeyMap = {}
    me.actionsKeyMap[me.actionId.refresh] = new Ext.util.KeyMap({
      target: me.getEl(),
      binding: [{
        key: me.hotKeys[me.actionId.refresh].key,
        ctrl: me.hotKeys[me.actionId.refresh].ctrl,
        shift: me.hotKeys[me.actionId.refresh].shift,
        fn: function (keyCode, e) {
          e.stopEvent()
          me.onButtonRefresh(me)
        }
      }]
    })
  }
})

function getStyle () {
  return `
    body {
      background-color: #FFFFFF;
      color: #000000;
      font-family: Times New Roman, Verdana, Arial, Helvetica, sans-serif;
      font-size: 11pt;
      line-height: 1.3;
    }
    .word-wrap {
      word-wrap: break-word;
      hyphens: auto
    }
    td {
      padding: 0 2px 0 2px;
    }
    .mce-pagebreak {
      cursor: default;
      display: block;
      border: 0;
      width: 100%;
      height: 5px;
      margin-top: 15px;
      page-break-before: always
    }
    table.layout-portrait {
      width:750px;
    }
    table.layout-landscape {
      width:1100px !important;
    }
    @media print {
      .mce-pagebreak {
        border: 0
      }
      a {
        text-decoration: none
      }
      table.layout-landscape {
        width:1300px;
      }
    }
  `
}
