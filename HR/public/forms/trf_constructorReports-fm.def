/* global UB Ext AC _ appAC appHR Blob $App */
exports.formDef = 'HR.constructorReport'
Ext.define('HR.constructorReport', {
  extend: 'Ext.form.Panel',
  requires: [
    'UBS.UBReport',
    'UB.ux.PDFComponent'
  ],
  layout: { type: 'vbox', align: 'stretch' },
  width: 1100,
  height: 600,
  items: [{}],

  actionId: {
    refresh: 'refresh'
  },
  eventId: {
    refresh: 'refresh'
  },
  hotKeys: {
    refresh: {
      key: Ext.EventObject.R,
      ctrl: true,
      shift: false,
      text: ' (Ctrl+R)'
    }
  },

  initComponent: function () {
    const me = this
    me.record = {}
    me.attr = {}
    me.requiredAttr = []
    me.reportType = 'html'

    let container
    let control
    let items
    let tabs = []

    const { reportCode, reportOptions, reportColum } = me.commandData

    me.changeGlobal = () => {
      const globalOrganization = appAC.globalOrganization()
      me.down('[name=employeeList]') && loadDataReportGrid()
      me.down('[name=subDepList]') && loadDataStatementGrid(me.down('[name=joinReport]'))
      const headEmployeePosition = me.down('[name=headEmployeePositionID]')
      const organization = me.down('[name=organization]')
      headEmployeePosition && !organization && loadSavedDataEmployee(headEmployeePosition, globalOrganization)
      if (organization) {
        AC.viewUtils.setWhereListProperty(organization, [['mi_treePath', 'like', `%/${globalOrganization}/%`], ['state', 'equal', 'ACTIVE']], null, ['clearWhereList', 'clearStore'])
        organization.setValueById(globalOrganization)
      }
      if (me.attr.periodFromID && me.attr.periodFromID.getValue() && me.attr.periodToID && me.attr.periodToID.getValue()) {
        appHR.getCurrentPeriod(globalOrganization).then(({ ID }) => {
          me.attr.periodFromID.setValueById(ID)
          me.attr.periodToID.setValueById(ID)
        })
      }
      if (me.attr.periodID && me.attr.periodID.getValue()) {
        appHR.getCurrentPeriod(globalOrganization).then(({ ID }) => {
          me.attr.periodID.setValueById(ID)
        })
      }
      me.clearPrintForm()
      me.attr.organizationID = globalOrganization
    }
    me.on('destroy', () => {
      $App.un('ac:app:organizationChanged', me.changeGlobal)
    }, me)
    me.on('afterrender', () => {
      const me = this
      $App.on('ac:app:organizationChanged', me.changeGlobal)
      me.attr = {
        periodToID: me.down('[name=periodToID]'),
        periodFromID: me.down('[name=periodFromID]'),
        dictProgClassID: me.down('[name=dictProgClassID]'),
        issueDate: me.down('[name=issueDate]'),
        positionCategory: me.down('[name=positionCategory]'),
        dictFundSourceID: me.down('[name=dictFundSourceID]'),
        dictExperienceID: me.down('[name=dictExperienceID]'),
        workPlaceType: me.down('[name=workPlaceType]'),
        tarificationType: me.down('[name=tarificationType]'),
        joinReport: me.down('[name=joinReport]'),
        subDivision: me.down('[name=subDivision]'),
        headEmployeePositionID: me.down('[name=headEmployeePositionID]'),
        periodID: me.down('[name=periodID]'),
        organization: me.down('[name=organization]'),
        tradeUnionCommitteeID: me.down('[name=tradeUnionCommitteeID]'),
        leaderDepartment: me.down('[name=leaderDepartment]'),
        headTradeUnionCommittee: me.down('[name=headTradeUnionCommittee]'),
        payElListParams: me.down('[name=payElListParams]'),
        reportParamGrid: me.queryById('reportParamGrid'),
        reportValuesPanel: me.queryById('reportValuesPanel'),
        reportValuesGrid: me.queryById('reportValuesGrid'),
        currentParamFld: me.queryById('currentParamFld'),
        valuesListBtn: me.queryById('valuesList')
      }
    })

    me.validateFields = function () {
      let isValid = true

      me.requiredAttr.forEach(field => {
        isValid = isValid && field.validate()
      })
      return isValid
    }
    function getSavedSettings (orgID, reportCode) {
      const result = UB.Repository('trf_constructorReportsSetting')
        .attrs(['params'])
        .where('organizationID', '=', orgID)
        .where('reportCode', '=', reportCode)
        .selectSingle()
      return result
    }
    async function loadSavedDataEmployee (ctrl, globalOrganization) {
      if (!me.savedSettings) {
        me.savedSettings = await getSavedSettings(appAC.globalOrganization(), me.commandConfig.cmdData.reportCode)
      }
      if (!me.savedSettings) {
        switch (ctrl.name) {
          case 'headEmployeePositionID':
            UB.Repository('hr_employeeNumber')
              .attrs(['employeeID.shortFIO', 'empWorkPlace', 'mainEmpNumberID', 'ID', 'mainEmpNumberID.empWorkPlace', 'tabNum'])
              .where('orgID', '=', globalOrganization)
              .where('empDictPositionID.positionCategory', '=', '1')
              .where('mainEmpNumberID.empWorkPlace', '=', '1')
              .where('dateFrom', '<=', AC.dateService.currentDate())
              .where('dateTo', '>=', AC.dateService.currentDate())
              .selectAsObject().then(res => {
                if (res && res.length) {
                  ctrl.setValue(res[0]['employeeID.shortFIO'])
                } else {
                  ctrl.setValue()
                }
              })
            break
          case 'leaderDepartment':
            const orgRespPerson = await UB.Repository('ac_orgRespPerson')
              .attrs(['ID', 'emponstaffID.employeeID.shortFIO'])
              .where('organizationID', '=', appAC.globalOrganization())
              .where('dateFrom', '<=', AC.dateService.currentDate())
              .where('dateTo', '>=', AC.dateService.currentDate(), 'dateTo')
              .where('dateTo', 'isNull', undefined, 'dateToIsNull')
              .logic('(([dateTo]) or ([dateToIsNull]))')
              .selectAsObject({ 'emponstaffID.employeeID.shortFIO': 'shortFIO' })
            if (orgRespPerson[0]) {
              ctrl.setValue(orgRespPerson[0]['shortFIO'])
            }
            break
        }
      } else {
        switch (ctrl.name) {
          case 'headEmployeePositionID':
            ctrl.setValue(me.savedSettings.params.headEmployeePositionShortFIO)
            break
          case 'leaderDepartment':
            ctrl.setValue(me.savedSettings.params.leaderDepartmentShortFIO)
            break
          case 'tradeUnionCommitteeID':
            const tradeUnionCommitteeID = me.savedSettings.params.tradeUnionCommitteeID
            if (tradeUnionCommitteeID && tradeUnionCommitteeID.length) {
              ctrl.setValue(tradeUnionCommitteeID)
            }
            break
          case 'headTradeUnionCommittee':
            const headEmployeePositionShortFIO = me.savedSettings.params.headTradeUnionCommittee
            if (headEmployeePositionShortFIO && headEmployeePositionShortFIO.length) {
              ctrl.setValue(headEmployeePositionShortFIO)
            }
            break
        }
      }
    }

    function getReportTab (title = UB.i18n('Звіт')) {
      return {
        itemId: 'tabReport',
        title,
        autoScroll: true,
        margin: '5, 0, 0, 0',
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        items: [
          {
            flex: 1,
            autoScroll: true,
            layout: {
              type: 'vbox',
              pack: 'center',
              align: 'stretch'
            },
            bodyCls: 'ub-panel-gray',
            items: [control]
          }
        ]
      }
    }

    function getReportDateCtrl () {
      return {
        xtype: 'datefield',
        name: 'issueDate',
        width: 250,
        fieldLabel: UB.i18n('Дата'),
        listeners: {
          change: function (fld) {
            me.record.issueDate = fld.getValue() || appAC.globalApplicationDate()
            me.clearPrintForm()
          }
        }
      }
    }

    function setSubDivision (labelWidth = 130) {
      return {
        xtype: 'ubboxselect',
        name: 'subDivision',
        fieldLabel: UB.i18n('Підрозділ'),
        labelWidth,
        disableContextMenu: true,
        pageSize: 50,
        displayField: 'name',
        valueField: 'mi_data_id',
        ubRequest: {
          entity: 'hr_department',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['mi_data_id', 'name', 'orgID', 'description', 'mi_treePath'],
          whereList: {
            state: {
              expression: '[state]',
              condition: '=',
              values: {
                state: 'ACTIVE'
              }
            },
            parentUnitID: {
              expression: '[parentUnitID]',
              condition: 'equal',
              value: me.attr.orgID ? me.attr.orgID.getValue() : appAC.globalOrganization()
            }
          }
        },
        listeners: {
          change: function (fld) {
            me.record.subDivision = fld.getValue()
            me.clearPrintForm()
          },
          afterrender: function (ctrl) {
            ctrl.store.ubRequest.orgID = appAC.globalOrganization()
            me.record.subDivision = ''
          }
        }
      }
    }
    function setOrganization (labelWidth = 130) {
      return {
        xtype: 'ubcombobox',
        name: 'organization',
        fieldLabel: UB.i18n('Організація'),
        labelWidth,
        disableContextMenu: true,
        pageSize: 50,
        displayField: 'name',
        valueField: 'mi_data_id',
        ubRequest: {
          entity: 'hr_organization',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['mi_data_id', 'name'],
          whereList: {
            state: {
              expression: '[state]',
              condition: '=',
              values: {
                state: 'ACTIVE'
              }
            },
            mi_data_id: {
              expression: '[mi_treePath]',
              condition: 'like',
              value: `%/${appAC.globalOrganization()}/%`
            }
          }
        },
        listeners: {
          change: function (fld, newVal, oldVal) {
            me.attr.organization.setValueById(fld.getValue())
            if ((oldVal !== newVal)) {
              if (me.attr.headEmployeePositionID) {
                loadSavedDataEmployee(me.attr.headEmployeePositionID, fld.getValue())
              }
              if (me.attr.leaderDepartment) {
                const store = me.attr.leaderDepartment.getStore()
                me.attr.leaderDepartment.store.ubRequest.organizationID = fld.getValue()
                store.load()
              }
            }
            me.clearPrintForm()
          },
          afterrender: function (ctrl) {
            ctrl.setValueById(appAC.globalOrganization())
            me.record.organization = appAC.globalOrganization()
          }
        }
      }
    }
    function setTarificationType (labelWidth = 130, width = 340) {
      return Ext.create('UB.ux.form.field.UBComboBox', {
        name: 'tarificationType',
        fieldLabel: UB.i18n('Тип тарифікації'),
        labelWidth,
        width,
        disableContextMenu: true,
        defaultValue: 100,
        pageSize: 50,
        valueField: 'code',
        displayField: 'name',
        allowBlank: false,
        ubRequest: {
          entity: 'ubm_enum',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['code', 'name', 'eGroup'],
          whereList: {
            eGroup: {
              expression: '[eGroup]',
              condition: 'equal',
              values: { eGroup: 'HR_DOCUMENT_TYPE' }
            }
          }
        },
        listeners: {
          change: function (fld) {
            me.clearPrintForm()
            const grid = me.down('[name=employeeList]')
            if (grid) loadDataReportGrid()
            me.record.tarificationType = fld.getValue()
          }
        }
      })
    }
    function setFundSourse (labelWidth = 130, width = 340) {
      return {
        xtype: 'ubboxselect',
        name: 'dictFundSourceID',
        fieldLabel: UB.i18n('Джерело фінансування'),
        labelWidth,
        width,
        displayField: 'name',
        valueField: 'ID',
        ubRequest: {
          entity: 'ac_fundSource',
          method: 'selectByOrg',
          fieldList: ['ID', 'name']
        },
        listeners: {
          change: (fld) => {
            me.clearPrintForm()
            const grid = me.down('[name=employeeList]')
            if (grid) loadDataReportGrid()
          },
          afterrender: function (ctrl) {
            ctrl.store.ubRequest.orgID = appAC.globalOrganization()
            ctrl.store.ubRequest.emptyValue = true
          }
        }
      }
    }
    function setPositionCategory (labelWidth = 130, width = 340) {
      return {
        xtype: 'ubboxselect',
        name: 'positionCategory',
        fieldLabel: UB.i18n('Категорії посад'),
        labelWidth,
        width,
        valueField: 'code',
        displayField: 'name',
        ubRequest: {
          entity: 'ubm_enum',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['code', 'name', 'eGroup'],
          whereList: {
            eGroup: {
              expression: '[eGroup]',
              condition: 'equal',
              values: { eGroup: 'HR_POSITION_CATEGORY' }
            }
          }
        },
        listeners: {
          change: () => {
            me.clearPrintForm()
            const grid = me.down('[name=employeeList]')
            if (grid) loadDataReportGrid()
          }
        }
      }
    }

    function getDictExperienceCtrl (labelWidth = 130, width = 340, allowBlank = true) {
      return {
        xtype: 'ubboxselect',
        name: 'dictExperienceID',
        fieldLabel: UB.i18n('Стаж'),
        labelWidth,
        width,
        allowBlank,
        valueField: 'ID',
        displayField: 'name',
        ubRequest: {
          entity: 'hr_dictExperience',
          fieldList: ['ID', 'name', 'code']
        },
        listeners: {
          change: function (fld) {
            me.clearPrintForm()
            const grid = me.down('[name=employeeList]')
            if (grid) loadDataReportGrid()
          }
        }
      }
    }
    function setWorkPlaceType (labelWidth = 130, width = 340) {
      return Ext.create('UB.ux.form.field.UBComboBox', {
        name: 'workPlaceType',
        fieldLabel: UB.i18n('Робочі місця'),
        labelWidth,
        width,
        displayField: 'name',
        valueField: 'code',
        listeners: {
          change: function (fld) {
            me.clearPrintForm()
            const grid = me.down('[name=employeeList]')
            if (grid) loadDataReportGrid()
          }
        },
        ubRequest: {
          entity: 'ubm_enum',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['code', 'name', 'eGroup'],
          whereList: {
            eGroup: {
              expression: '[eGroup]',
              condition: 'equal',
              values: { eGroup: 'TRF_REPORTS_WORKPLACE' }
            }
          }
        }
      })
    }

    function getPeriodFromToCtrl (labelWidth = 130) {
      return {
        layout: { type: 'hbox' },
        items: [
          {
            xtype: 'ubcombobox',
            allowBlank: false,
            name: 'periodFromID',
            fieldLabel: 'Період звіту:',
            labelWidth,
            pageSize: 50,
            width: labelWidth + 222,
            hideEntityItemInContext: true,
            disableContextMenu: true,
            selectOnFocus: true,
            ubRequest: {
              entity: 'hr_dictPeriod',
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'priorPeriodID', 'nextPeriodID', 'name'],
              orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
            },
            listeners: {
              beforeQuerySend: function () {
                this.store.ubRequest.whereList = {
                  orgID: {
                    expression: '[orgID]',
                    condition: 'equal',
                    value: appAC.globalOrganization()
                  }
                }
                if (!this.whereListIsSet) this.whereListIsSet = true
                else this.store.reload()
              },
              change: function (fld) {
                me.record.periodFromRaw = fld.getFieldValue('name')
                me.record.periodFromID = fld.getValue()
                const rec = AC.gridUtils.getCurrentRecord(fld)
                me.record.periodFromDateFrom = rec ? rec.get('dateFrom') : null
                me.record.periodFromDateTo = rec ? rec.get('dateTo') : null

                if (!me.record.periodToID) {
                  me.attr.periodToID.setValueById(fld.getValue())
                } else if (me.record.periodFromID && ((me.record.periodToDateFrom.getFullYear() < me.record.periodFromDateFrom.getFullYear()) || (me.record.periodToDateFrom.getFullYear() > me.record.periodFromDateFrom.getFullYear()))) {
                  me.attr.periodToID.setValue()
                }
                me.clearPrintForm()
              },
              expand: appHR.periodExpand
            }
          },
          {
            xtype: 'label',
            text: UB.i18n('-'),
            cls: 'x-form-item-label',
            margin: '8 15 0 20',
            width: 10
          },
          {
            xtype: 'ubcombobox',
            allowBlank: false,
            name: 'periodToID',
            fieldLabel: '',
            width: 222,
            hideEntityItemInContext: true,
            disableContextMenu: true,
            selectOnFocus: true,
            ubRequest: {
              entity: 'hr_dictPeriod',
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'priorPeriodID', 'nextPeriodID', 'name'],
              orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
            },
            listeners: {
              beforeQuerySend: function () {
                this.store.ubRequest.whereList = {
                  orgID: {
                    expression: '[orgID]',
                    condition: 'equal',
                    value: appAC.globalOrganization()
                  },
                  pYear: {
                    expression: '[pYear]',
                    condition: '=',
                    value: me.record.periodFromDateFrom.getFullYear()
                  }
                }
                if (!this.whereListIsSet) this.whereListIsSet = true
                else this.store.reload()
              },
              change: function (fld) {
                me.record.periodToRaw = fld.getFieldValue('name')
                me.record.periodToID = fld.getValue()
                const rec = AC.gridUtils.getCurrentRecord(fld)
                me.record.periodToDateFrom = rec ? rec.get('dateFrom') : null
                me.record.periodToDateTo = rec ? rec.get('dateTo') : null

                if (!me.record.periodFromID) {
                  me.attr.periodFromID.setValueById(fld.getValue())
                } else if (me.record.periodToID && me.record.periodToDateFrom < me.record.periodFromDateFrom) {
                  me.attr.periodFromID.setValue()
                }

                me.clearPrintForm()
              },
              expand: appHR.periodExpand
            }
          }
        ]
      }
    }
    function setPeriodCtrl (labelWidth = 140, width = 350) {
      return {
        xtype: 'ubcombobox',
        allowBlank: false,
        name: 'periodID',
        fieldLabel: UB.i18n('Період звіту'),
        labelWidth,
        width,
        selectOnFocus: true,
        ubRequest: {
          entity: 'hr_dictPeriod',
          fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'name'],
          orderList: { orderBy: { expression: 'dateFrom', order: 'asc' } }
        },
        pageSize: 50,
        listeners: {
          afterrender: function (ctrl) {
            appHR.getCurrentPeriod(appAC.globalOrganization()).then(response => {
              ctrl.setValueById(response.ID)
              me.record.periodID = response.ID
              me.record.periodName = response.name
              me.record.periodFrom = response.dateFrom
              me.record.periodTo = response.dateTo
            })
          },
          beforeQuerySend: function (ctrl) {
            this.store.ubRequest.whereList = {
              orgID: {
                expression: '[orgID]',
                condition: 'equal',
                value: appAC.globalOrganization()
              }
            }
            if (!this.whereListIsSet) this.whereListIsSet = true
            else this.store.reload()
            me.record.periodID = ctrl.combo.getValue()
          },
          change: function (fld) {
            me.record.periodID = fld.getValue()
            me.record.periodName = fld.getFieldValue('name')
            me.record.periodFrom = fld.getFieldValue('dateFrom')
            me.record.periodTo = fld.getFieldValue('dateTo')
            me.clearPrintForm()
          },
          expand: appHR.periodExpand
        }
      }
    }

    function getPeriodCtrl (labelWidth = 115, cfg) {
      cfg = cfg || {}
      return {
        layout: { type: 'hbox' },
        items: [
          {
            xtype: 'label',
            text: cfg.label || UB.i18n('Період:'),
            cls: 'x-form-item-label',
            margin: '8 0 0 15',
            width: labelWidth
          },
          {
            xtype: 'button',
            text: '<',
            margin: '2 0 0 0',
            tooltip: UB.i18n('Попередній період'),
            width: 30,
            handler: () => {
              const priorID = me.attr.periodID.getFieldValue('priorPeriodID')
              if (priorID) {
                me.attr.periodID.setValueById(priorID)
              }
            },
            hidden: cfg.hidePriorBtn
          },
          {
            xtype: 'ubcombobox',
            allowBlank: false,
            name: 'periodID',
            fieldLabel: '',
            labelWidth: 130,
            margin: '2 0 0 5',
            pageSize: 50,
            width: cfg.width || 300,
            hideEntityItemInContext: true,
            disableContextMenu: true,
            selectOnFocus: true,
            ubRequest: {
              entity: 'hr_dictPeriod',
              fieldList: ['ID', 'description', 'dateFrom', 'dateTo', 'orgID', 'priorPeriodID', 'nextPeriodID', 'name'],
              orderList: { orderBy: { expression: 'dateFrom', order: 'desc' } }
            },
            listeners: {
              beforeQuerySend: function () {
                this.store.ubRequest.whereList = {
                  orgID: {
                    expression: '[orgID]',
                    condition: 'equal',
                    value: appAC.globalOrganization()
                  }
                }
                if (!this.whereListIsSet) this.whereListIsSet = true
                else this.store.reload()
              },
              change: function (fld) {
                me.record.periodRaw = fld.getFieldValue('name')
                me.record.periodID = fld.getValue()
                const rec = AC.gridUtils.getCurrentRecord(fld)
                me.record.periodFrom = rec ? rec.get('dateFrom') : null
                me.record.periodTo = rec ? rec.get('dateTo') : null

                me.clearPrintForm()
              },
              expand: appHR.periodExpand
            }
          },
          {
            xtype: 'button',
            text: '>',
            margin: '2 15 0 0',
            tooltip: UB.i18n('Наступний період'),
            width: 30,
            handler: () => {
              const nextID = me.attr.periodID.getFieldValue('nextPeriodID')
              if (nextID) {
                me.attr.periodID.setValueById(nextID)
              }
            },
            hidden: cfg.hideNextBtn
          }
        ]
      }
    }
    function setDictProgClass (labelWidth = 130, width = 340, allowBlank = true) {
      return {
        xtype: 'ubboxselect',
        name: 'dictProgClassID',
        fieldLabel: UB.i18n('КПК'),
        labelWidth,
        width,
        allowBlank,
        valueField: 'ID',
        displayField: 'description',
        ubRequest: {
          entity: 'ac_dictProgClass',
          method: 'selectWithTrfAccrual',
          fieldList: ['ID', 'description']
        },
        listeners: {
          afterRender: function () {
            this.store.ubRequest.organizationID = appAC.globalOrganization()
          },
          focus: function () {
            this.store.ubRequest.organizationID = appAC.globalOrganization()
            //add pdv 26.11.24
            this.store.ubRequest.periodFrom = me.record.periodFrom
            if (me.attr.joinReport && me.attr.joinReport.getValue()) {
              const grid = me.down('[name=subDepList]')
              this.store.ubRequest.joinReport = true
              this.store.ubRequest.organizationList = JSON.stringify(grid.getCheckedRow().map(o => o.data.mi_data_id))
            } else {
              this.store.ubRequest.joinReport = false
            }
          },
          change: function (fld) {
            me.clearPrintForm()
            const grid = me.down('[name=employeeList]')
            me.record.dictProgClassID = fld.getValue()
            if (grid) loadDataReportGrid()
          }
        }
      }
    }

    function setRoundSum (labelWidth = 130, width = 340) {
      return {
        xtype: 'ubcombobox',
        fieldLabel: UB.i18n('Округлювати суму:'),
        labelWidth,
        width,
        name: 'roundUpTo',
        hideEntityItemInContext: true,
        valueField: 'code',
        ubRequest: {
          entity: 'ubm_enum',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['ID', 'name', 'code', 'eGroup'],
          whereList: {
            enumGroupFilter: {
              expression: '[eGroup]',
              condition: 'equal',
              values: {
                val: 'TRF_ROUND'
              }
            }
          },
          orderList: {
            orderBy: { expression: 'code', order: 'asc' }
          }
        },
        listeners: {
          change: function (crtl, value) {
            me.record.roundUpTo = crtl.getValue()
            me.clearPrintForm()
          }
        }
      }
    }

