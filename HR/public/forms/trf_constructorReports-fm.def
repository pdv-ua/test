    function dateReport (labelWidth = 100) {
      return {
        xtype: 'datefield',
        name: 'dateReport',
        width: 240,
        labelWidth,
        allowBlank: false,
        fieldLabel: UB.i18n('Дата звіту'),
        listeners: {
          afterrender: function (crtl) {
            crtl.setValue(appAC.globalApplicationDate())
            me.record.dateReport = crtl.getValue()
          },
          change: function (crtl) {
            if (crtl.getValue() && crtl.isValid()) {
              me.clearPrintForm()
              const form = crtl.up('form')
              const accountantID = form.down('[name=accountantID]')
              if (accountantID) {
                const reportDate = AC.dateService.shiftDate(crtl.getValue())
                const whereList = [
                  ['dateFrom', '<=', reportDate || appAC.globalApplicationDate()],
                  ['dateTo', '>=', reportDate || appAC.globalApplicationDate()],
                  ['organizationID', '=', appAC.globalOrganization()]
                ]
                AC.viewUtils.setWhereListProperty(accountantID, whereList, null, ['clearStore', 'clearWhereList', 'clearValue'])
                accountantID.store.isChange = false
                me.record.dateReport = crtl.getValue()
              } else {
                me.record.dateReport = crtl.getValue()
              }
            }
          }
        }
      }
    }
    function setChiefBooker (labelWidth = 140) {
      return {
        xtype: 'ubcombobox',
        name: 'accountantID',
        fieldLabel: UB.i18n('Головний бухгалтер'),
        labelWidth,
        valueField: 'ID',
        displayField: 'description',
        ubRequest: {
          entity: 'hr_employeePositionS',
          method: UB.core.UBCommand.methodName.SELECT,
          fieldList: ['ID', 'description', 'positionID', 'employeeID.shortFIO', 'positionID.dictPositionID.name', 'dictPositionID.name', 'factPosition'],
          orderList: { name: { expression: 'description', order: 'ASC' } }
        },
        listeners: {
          render: function (ctrl) {
            ctrl.store.on('load', () => {
              if (!ctrl.store.isChange) {
                UB.Repository('hr_orgRespPosition').attrs(['positionID'])
                  .where('organizationID', '=', appAC.globalOrganization())
                  .where('mi_deleteDate', '>=', '#maxdate')
                  .where('dateFrom', '<=', AC.dateService.currentDate())
                  .where('dateTo', '>=', AC.dateService.currentDate())
                  .where('respPosition', '=', 'accountantChief')
                  .selectSingle().then(response => {
                    if (response && response.positionID && ctrl.store && ctrl.store.data && ctrl.store.data.items && ctrl.store.data.items.length > 0) {
                      const filterEmpOfPos = ctrl.store.data.items.filter(emp => emp.data.positionID === response.positionID)
                      ctrl.setValueById(response.positionID)
                      const useActualPositionName = AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization()) === true
                      me.record.fullFIO = filterEmpOfPos[0].data['employeeID.fullFIO']
                      me.record.dictPosition = useActualPositionName
                        ? filterEmpOfPos[0].data['factPosition']
                        : filterEmpOfPos[0].data['positionID.dictPositionID.name']
                    }
                  })
              }
            })
          },
          change: function (crtl) {
            const useActualPositionName = AC.settings.get('hrOrderActualPositionName', appAC.globalOrganization()) === true
            me.record.shortFIO = crtl.getFieldValue('employeeID.shortFIO')
            me.record.dictPosition = useActualPositionName
              ? crtl.getFieldValue('factPosition')
              : crtl.getFieldValue('positionID.dictPositionID.name') || crtl.getFieldValue('dictPositionID.name')
            me.clearPrintForm()
          }
        }
      }
    }
