    function loadDataReportGrid () {
      me.setLoading(true)
      me.clearPrintForm()
      const orgID = appAC.globalOrganization()
      const getEmployees = UB.Repository('trf_position')
        .attrs(['workPlaceID.employeeNumberID', 'workPlaceID.employeeNumberID.tabNum', 'workPlaceID.employeeNumberID.employeeID.fullFIO', 'workPlaceID.description', 'workPlaceID.position', 'workPlaceID.depName', 'workPlaceID.dateFrom', 'workPlaceID.dictPositionID.name', 'dictFundSourceID.name', 'workPlaceID.employeeNumberID.depID', 'workPlaceID.employeeNumberID.employeePositionID.payElID', 'workPlaceID.employeeNumberID.employeeID', 'dictPositionID.positionCategory', 'dictFundSourceID'])
        .whereIf(!me.commandData.cmpInitConfig || (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams.showPostedWorkPlace), 'workPlaceID.state', '=', 'POSTED')
        .whereIf(!me.commandData.cmpInitConfig || (me.commandData.cmpInitConfig && (me.commandData.cmpInitConfig.reportParams.tarificationType === 'FACT')), 'workPlaceID.documentID.type', '=', 'FACT')
        .where('workPlaceID.documentID.orgID', '=', orgID)
        .where('mi_deleteDate', '>=', '#maxdate')
        .where('workPlaceID.mi_deleteDate', '>=', '#maxdate')
        .where('workPlaceID.dateFrom', '<=', AC.dateService.shiftDate(me.attr.issueDate ? me.attr.issueDate.getValue() : AC.dateService.currentDate()))
        .where('workPlaceID.dateTo', '>=', AC.dateService.shiftDate(me.attr.issueDate ? me.attr.issueDate.getValue() : AC.dateService.currentDate()))
      if (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams.employeeNumberID) {
        getEmployees.where('workPlaceID.employeeNumberID', '=', me.commandData.cmpInitConfig.reportParams.employeeNumberID)
      }
      if (me.commandData.cmpInitConfig && me.commandData.cmpInitConfig.reportParams.documentID) {
        getEmployees.where('workPlaceID.documentID', '=', me.commandData.cmpInitConfig.reportParams.documentID)
      }
      if (me.attr.subDivision && me.attr.subDivision.getValue()) {
        const depIDs = me.attr.subDivision.getValue().split(',')
        getEmployees.where('workPlaceID.employeeNumberID.depID', 'in', depIDs)
      }
      if (me.attr.positionCategory && me.attr.positionCategory.getValue()) {
        const positionCategorys = me.attr.positionCategory.value
        getEmployees.where('dictPositionID.positionCategory', 'in', positionCategorys)
      }
      if (me.attr.dictFundSourceID && me.attr.dictFundSourceID.getValue()) {
        const dictFundSourceIDs = me.attr.dictFundSourceID.getValue().split(',')
        getEmployees.where('dictFundSourceID', 'in', dictFundSourceIDs)
      }
      if (me.attr.dictProgClassID && me.attr.dictProgClassID.getValue()) {
        const dictProgClassIDs = me.attr.dictProgClassID.getValue().split(',')
        getEmployees.where('dictProgClassID', 'in', dictProgClassIDs)
      }
      if (me.attr.tarificationType && me.attr.tarificationType.getValue()) {
        getEmployees.where('workPlaceID.documentID.type', '=', me.attr.tarificationType.getValue())
      }
      if (me.attr.workPlaceType && (me.attr.workPlaceType.getValue() === '3')) {
        getEmployees.where('workPlaceID.employeeNumberID', 'isNull')
      }
      if (me.attr.workPlaceType && (me.attr.workPlaceType.getValue() === '2')) {
        getEmployees.where('workPlaceID.employeeNumberID', '!==', null)
      }
      getEmployees.selectAsObject(
        { 'workPlaceID.employeeNumberID.employeeID': 'ID' }
      ).then(data => {
        if (me.attr.dictExperienceID.getValue()) {
          const employeers = data.filter(o => o.ID !== null).map(o => { return { employeeNumberID: o['workPlaceID.employeeNumberID'], onDate: AC.dateService.shiftDate(o['workPlaceID.dateFrom']), employee: o } })
          $App.connection.run({
            entity: 'trf_constructorReports',
            method: 'calcEmployeeExperience',
            params: JSON.stringify(employeers)
          }).then((mParams) => {
            const empArr = []
            const employeers = JSON.parse(mParams.employeeExperience)
            employeers.forEach(o => {
              const dictExperienceIDs = me.attr.dictExperienceID.getValue().split(',')
              const expList = JSON.parse(o.employeeExperience)
              const params = o.employee
              if (expList && expList.length && dictExperienceIDs.some(o => expList.find(k => Number(o) === k.ID))) empArr.push(params)
              const claerEmpArr = isMaxDateFrom(empArr).map(o => {
                return { ...o, 'workPlaceID.dateFrom': AC.dateService.shiftDate(o['workPlaceID.dateFrom']) }
              })
              me.down('acGrid').getStore().loadData(claerEmpArr)
              me.down('acGrid').checkedRow()
              me.setLoading(false)
            })
          }, (err) => {
            me.setLoading(false)
            throw err
          })
        } else {
          data.forEach(o => { if (!o['workPlaceID.employeeNumberID']) o['workPlaceID.employeeNumberID.employeeID.fullFIO'] = 'Вакансія' })
          const claerData = isMaxDateFrom(data)
          me.down('acGrid').getStore().loadData(claerData)
          me.down('acGrid').checkedRow()
          me.setLoading(false)
        }
      })

      function isMaxDateFrom (array) {
        return array.reduce((o, i) => {
          if (!o.find(v => v.ID === i.ID)) {
            const findDuplicatePos = array.filter(v => (v.ID === i.ID))
            if (findDuplicatePos.length > 1) {
              const empMaxDateFrom = findDuplicatePos.reduce((prev, cur) => {
                if (prev['workPlaceID.dateFrom'] > cur['workPlaceID.dateFrom']) return prev
                return cur
              })
              o.push(empMaxDateFrom)
            } else {
              o.push(...findDuplicatePos)
            }
          }
          return o
        }, [])
      }
    }
    function getReportSetting (title = UB.i18n('Вибір працівників')) {
      return {
        itemId: 'tabSetting',
        title,
        autoScroll: true,
        margin: '5, 0, 0, 0',
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        items: [
          {
            region: 'north',
            autoScroll: true,
            split: false,
            layout: { type: 'hbox' },
            items: [
              {
                layout: { type: 'vbox', align: 'stretch' },
                flex: 1,
                items: [
                  setTarificationType(),
                  setDictProgClass(),
                  setPositionCategory()
                ]
              },
              {
                layout: { type: 'vbox', align: 'stretch' },
                flex: 1,
                items: [
                  setWorkPlaceType(),
                  getDictExperienceCtrl(),
                  setFundSourse()
                ]
              }
            ]
          },
          {
            xtype: 'acGrid',
            name: 'employeeList',
            region: 'center',
            flex: 1,
            autoScroll: true,
            notWriteChanges: true,
            storeType: 'local',
            showToolBar: true,
            disablePaging: true,
            loadMaskMessage: UB.i18n('Завантаження даних...'),
            stripeRows: true,
            ignoreAttr: ['posName', 'depName', 'depCaption'],
            hideActions: ['edit', 'del', 'addNewByCurrent', 'addNew'],
            checkColumn: {},
            viewConfig: {
              markDirty: false
            },
            pagerConfig: {
              pageSize: 10
            },
            customToolBarActions: [
              {
                xtype: 'textfield',
                name: 'searchBox',
                skipSetReadOnly: true,
                labelWidth: 60,
                fieldLabel: UB.i18n('filter'),
                listeners: {
                  change: function (ctrl, value) {
                    const store = ctrl.up('acGrid').getStore()
                    store.clearFilter()
                    if (value === '') {
                      return
                    }
                    if (store.sorters.items.length) {
                      store.sorters.removeAll()
                    }
                    store.filter(row => {
                      return (row.get('workPlaceID.employeeNumberID.description') && row.get('workPlaceID.employeeNumberID.description').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('workPlaceID.dictPositionID.name') && row.get('workPlaceID.dictPositionID.name').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('workPlaceID.employeeNumberID.employeeID.fullFIO') && row.get('workPlaceID.employeeNumberID.employeeID.fullFIO').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('workPlaceID.depName') && row.get('workPlaceID.depName').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('workPlaceID.employeeNumberID.tabNum') && row.get('workPlaceID.employeeNumberID.tabNum').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('dictFundSourceID.name') && row.get('dictFundSourceID.name').toUpperCase().includes(value.toUpperCase()))
                    })
                  }
                }
              }
            ],
            fields: [
              { name: 'workPlaceID.employeeNumberID.employeePositionID.payElID' },
              { name: 'ID' },
              { name: 'workPlaceID.employeeNumberID.depID' },
              { name: 'dictFundSourceID' },
              {
                name: 'workPlaceID.employeeNumberID.tabNum',
                columnConfig: {
                  text: UB.i18n('Таб. №'),
                  sortBy: 'Number',
                  width: 80
                }
              },
              {
                name: 'workPlaceID.employeeNumberID.employeeID.fullFIO',
                columnConfig: {
                  text: UB.i18n('Працівник'),
                  flex: 1
                }
              },
              {
                name: 'workPlaceID.dictPositionID.name',
                columnConfig: {
                  text: UB.i18n('Посада'),
                  flex: 1
                }
              },
              {
                name: 'workPlaceID.depName',
                columnConfig: {
                  text: UB.i18n('Підрозділ'),
                  flex: 1
                }
              },
              {
                name: 'dictFundSourceID.name',
                columnConfig: {
                  text: UB.i18n('Джерело фінансування'),
                  flex: 1
                }
              },
              {
                name: 'workPlaceID.dateFrom',
                columnConfig: {
                  text: UB.i18n('Дата початку'),
                  sortBy: 'Date',
                  flex: 1,
                  renderer: (value) => {
                    if (_.isDate(value)) {
                      if (AC.dateService.shiftDate(value) < AC.dateService.maxDate()) {
                        return AC.dateService.formatDate(value)
                      } else {
                        return ''
                      }
                    } else {
                      return value
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
    function getJoinReport (labelWidth = 150) {
      return {
        xtype: 'checkbox',
        fieldLabel: UB.i18n('Консолідований звіт'),
        labelWidth,
        name: 'joinReport',
        value: 0,
        listeners: {
          change: function (crtl, fld) {
            const tabReport = me.down('[itemId=tabReport]')
            const cmpTabPanel = me.down('[itemId=cmpTabPanel]')
            const subDepList = me.down('[name=subDepList]')
            const tabSettings = me.down('[itemId=tabSettings]')
            const dictProgClassID = me.down('[name=dictProgClassID]')
            fld && subDepList.show()
            !fld && subDepList.hide()
            fld && tabSettings.tab.show()
            !fld && tabSettings.tab.hide()
            !fld && cmpTabPanel.setActiveTab(tabReport)
            fld && cmpTabPanel.setActiveTab(tabSettings)
            if (!fld && dictProgClassID) dictProgClassID.clearValue()
            me.clearPrintForm()
          },
          afterRender: function () {
            me.down('[itemId=tabSettings]').tab.hide()
            me.down('[name=subDepList]').hide()
            me.setLoading(true)
            me.clearPrintForm()
          },
          render: function (crtl) {
            loadDataStatementGrid(crtl)
          }
        }
      }
    }
    async function getOrganigation (parentUnitID) {
      let org = await UB.Repository('hr_organization')
        .attrs(['name', 'mi_data_id', 'EDRPOUCode', 'code', 'mi_dateFrom'])
        .where('state', '=', 'ACTIVE')
        .where('parentUnitID', 'in', parentUnitID)
        .selectAsObject()
      if (org) return org
    }
    async function loadDataStatementGrid (crtl) {
      me.setLoading(true)
      const orgID = appAC.globalOrganization()
      if (!crtl) { crtl = me.down('[name=joinReport]') }
      const data = await getOrganigation(orgID)
      const tabReport = me.down('[itemId=tabReport]')
      const cmpTabPanel = me.down('[itemId=cmpTabPanel]')
      const subDepList = me.down('[name=subDepList]')
      const tabSettings = me.down('[itemId=tabSettings]')
      if (data.length) {
        crtl.show()
        subDepList.getStore().loadData(data)
      } else {
        crtl.hide()
        crtl.setValue()
      }
      !crtl.hidden && crtl.getValue() ? subDepList.show() : subDepList.hide()
      !crtl.hidden && crtl.getValue() ? tabSettings.tab.show() : tabSettings.tab.hide()
      crtl.hidden && cmpTabPanel.setActiveTab(tabReport)
      me.setLoading(false)
    }

    function getOrgSetting () {
      return {
        itemId: 'tabSettings',
        title: UB.i18n('Організації'),
        autoScroll: true,
        margin: '5,0,0,0',
        layout: {
          type: 'vbox',
          align: 'stretch'
        },
        items: [
          {
            xtype: 'acGrid',
            name: 'subDepList',
            region: 'center',
            flex: 1,
            loadMaskMessage: UB.i18n('Завантаження даних...'),
            autoScroll: true,
            notWriteChanges: true,
            storeType: 'local',
            showToolBar: true,
            disablePaging: true,
            stripeRows: true,
            hideActions: ['edit', 'del', 'addNewByCurrent', 'addNew'],
            checkColumn: {},
            pagerConfig: {
              pageSize: 20
            },
            viewConfig: {
              markDirty: false
            },
            entityConfig: {
              entity: 'hr_organization',
              method: 'select',
              fieldList: ['mi_data_id', 'code', 'name', 'EDRPOUCode', 'mi_dateFrom'],
              customParams: {
                mi_treePath: appAC.globalOrganization(),
                state: 'ACTIVE'
              }
            },
            customToolBarActions: [
              {
                xtype: 'textfield',
                name: 'searchBox',
                skipSetReadOnly: true,
                labelWidth: 60,
                fieldLabel: UB.i18n('filter'),
                listeners: {
                  change: function (ctrl, value) {
                    const store = ctrl.up('acGrid').getStore()
                    store.clearFilter()
                    if (value === '') {
                      return
                    }
                    if (store.sorters.items.length) {
                      store.sorters.removeAll()
                    }
                    store.filter(row => {
                      return (row.get('name') && row.get('name').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('EDRPOUCode') && row.get('EDRPOUCode').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('staffOrderID.description') && row.get('staffOrderID.description').toUpperCase().includes(value.toUpperCase())) ||
                        (row.get('code') && row.get('code').toUpperCase().includes(value.toUpperCase()))
                    })
                  }
                }
              }
            ],
            fields: [
              { name: 'mi_data_id' },
              {
                name: 'code',
                columnConfig: {
                  text: UB.i18n('Код організації'),
                  align: 'center',
                  flex: 1
                }
              },
              {
                name: 'name',
                columnConfig: {
                  text: UB.i18n('Назва організації'),
                  align: 'center',
                  flex: 2
                }
              },
              {
                name: 'EDRPOUCode',
                columnConfig: {
                  text: UB.i18n('ЄДРПОУ'),
                  align: 'center',
                  width: 120
                }
              },
              {
                name: 'mi_dateFrom',
                columnConfig: {
                  text: UB.i18n('Дата початку дії'),
                  align: 'center',
                  width: 150,
                  sortBy: 'Date',
                  renderer: (value) => {
                    return AC.dateService.formatDate(value)
                  }
                }
              }
            ]
          }
        ]
      }
    }
    function getListParamTabs (currTabs, tabListToAdd, fieldList = [], formCode, formListCode = null, enablePayElOrderN = true, btAddListName = UB.i18n('Додати списком'), isEditable = false, otherParams = {}) {
      if (!me.listParamTabs) me.listParamTabs = {}
      const tabsCode = tabListToAdd.map(tab => tab.code)
      UB.Repository('hr_listParam')
        .attrs('ID', 'code')
        .where('code', 'in', tabsCode)
        .selectAsObject().then(res => {
          res.forEach(item => {
            me.listParamTabs[item.code] = item.ID
          })
        })
      const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
      tabListToAdd.forEach(({ code, title, hidden = false }) => {
        currTabs.push({
          itemId: code,
          title: title,
          hidden: hidden,
          layout: {
            type: 'vbox',
            align: 'stretch'
          },
          items: [
            {
              xtype: 'entitygridpanel',
              cmdType: 'showList',
              autoScroll: true,
              pageSize: 10000,
              flex: 1,
              name: 'sortAccrGrid',
              hideActions: ['showPreview', 'itemLink', 'commandLink', 'addNewByCurrent', 'detail', !isEditable ? 'edit' : '', formListCode ? 'addNew' : ''],
              openForm: function () { },
              entityConfig: {
                entity: 'hr_idParam',
                method: 'select',
                fieldList,
                whereList: {
                  byTab: {
                    expression: '[listParamID.code]',
                    condition: 'equal',
                    values: { code: code }
                  },
                  byOrgID: {
                    expression: '[orgID]',
                    condition: 'equal',
                    values: { orgID: Number(parentOrgID || appAC.globalOrganization()) }
                  }
                }
              },
              onAddNew: function () {
                const grid = this
                const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
                $App.doCommand({
                  cmdType: 'showForm',
                  formCode,
                  entity: 'hr_idParam',
                  initialFieldValues: {
                    listParamID: me.listParamTabs[code],
                    orgID: Number(parentOrgID || appAC.globalOrganization())
                  },
                  cmpInitConfig: {
                    tabsCode
                  },
                  store: grid.getStore()
                })
              },
              onEdit: function () {
                const grid = this
                const record = AC.gridUtils.getCurrentRecord(grid)

                $App.doCommand({
                  cmdType: 'showForm',
                  formCode,
                  entity: 'hr_idParam',
                  instanceID: record.get('ID'),
                  cmpInitConfig: {
                    tabsCode,
                    editFld: 'dopName'
                  },
                  store: grid.getStore(),
                  sender: grid
                })
              },
              onItemDblClick: function (grid, record) {
                if (!formListCode) {
                  const item = this
                  $App.doCommand({
                    cmdType: 'showForm',
                    formCode,
                    entity: 'hr_idParam',
                    instanceID: record.get('ID'),
                    cmpInitConfig: {
                      tabsCode,
                      byUser: otherParams.byUser
                    },
                    store: grid.getStore(),
                    sender: item
                  })
                }
              },
              customActions: [
                {
                  itemId: 'addList',
                  text: btAddListName,
                  actionId: 'addByList',
                  iconCls: 'u-icon-edit-alt',
                  scale: 'medium',
                  cls: 'fill-action',
                  hidden: !formListCode,
                  handler: function (btn) {
                    const grid = btn.up('entitygridpanel')
                    const sourceData = (grid.getStore().snapshot || grid.getStore().data).items.map(o => o.getData())
                    const selectData = sourceData.map(o => o.valuesID)
                    const sourceAttr = formListCode === 'hr_payElSelect' ? 'valuesID' : null
                    const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
                    $App.doCommand({
                      cmdType: 'showForm',
                      formCode: formListCode,
                      entity: 'hr_idParam',
                      cmpInitConfig: {
                        selectData,
                        sourceData,
                        sourceAttr,
                        byUser: otherParams.byUser,
                        exclude: ['OTHER'],
                        isAutoCalc: otherParams.isAutoCalc && otherParams.isAutoCalc === 1 ? 1 : null,
                        methodGroupCode: otherParams.methodGroupCode || null,
                        methodCode: otherParams.methodCode || null,
                        payElEntryType: ['PAYMENT'],
                        listParamID: me.listParamTabs[code],
                        tabsCode,
                        orgID: Number(parentOrgID || appAC.globalOrganization()),
                        enableOrderN: enablePayElOrderN,
                        onSelectData: (data) => {
                          if (data.remove.length || data.add.length || data.update.length) {
                            $App.connection.run({
                              entity: 'hr_idParam',
                              method: 'updateValuesIDs',
                              listParamID: me.listParamTabs[code],
                              orgID: Number(parentOrgID || appAC.globalOrganization()),
                              byUser: otherParams.byUser,
                              userID: $App.connection.userData().userID,
                              data: JSON.stringify(data)
                            }).then(() => {
                              grid.getStore().load()
                              me.clearPrintForm()
                            })
                          }
                        }
                      },
                      store: grid.getStore()
                    })
                  }
                },
                {
                  itemId: 'deleteAll',
                  text: UB.i18n('Видалити все'),
                  actionId: 'deleteAll',
                  iconCls: 'fa fa-eraser',
                  cls: 'add-list-action',
                  hidden: !!formListCode,
                  handler: function (btn) {
                    const grid = btn.up('entitygridpanel')
                    const parentOrgID = !otherParams.byUser ? AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization()) : null
                    grid.store.data.items.length && $App.dialogYesNo('Попередження', UB.i18n('Видалити всі записи?'))
                      .then(res => {
                        if (res) {
                          $App.connection.run({
                            entity: 'hr_idParam',
                            method: 'deleteRecordsByCode',
                            execParams: {
                              code,
                              orgID: Number(parentOrgID || appAC.globalOrganization()),
                              byUser: otherParams.byUser,
                              userID: $App.connection.userData().userID
                            }
                          }).then(() => {
                            grid.onRefresh()
                          })
                        }
                      })
                  }
                }
              ],
              afterInit: function () {
                if (otherParams.byUser) {
                  const userID = $App.connection.userData().userID
                  this.store.ubRequest.whereList.byUserID = {
                    expression: '[userID]',
                    condition: 'equal',
                    value: userID
                  }
                  me.record.sortAccrGrid = code
                  me.record.userID = userID
                }
                me.record.sortAccrGrid = code
              },
              listeners: {
                refresh: function () {
                  if (!otherParams.byUser) {
                    const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
                    this.store.ubRequest.whereList.byOrgID.values.orgID = Number(parentOrgID || appAC.globalOrganization())
                  } else {
                    this.store.ubRequest.whereList.byOrgID.values.orgID = appAC.globalOrganization()
                    this.store.ubRequest.whereList.byUserID = {
                      expression: '[userID]',
                      condition: 'equal',
                      value: $App.connection.userData().userID
                    }
                  }
                },
                beforeQuerySend: function () {
                  if (!otherParams.byUser) {
                    const parentOrgID = AC.settings.get('hrUseReportSettingsParentOrg', appAC.globalOrganization())
                    this.store.ubRequest.whereList.byOrgID.values.orgID = Number(parentOrgID || appAC.globalOrganization())
                  } else {
                    this.store.ubRequest.whereList.byOrgID.values.orgID = appAC.globalOrganization()
                    this.store.ubRequest.whereList.byUserID = {
                      expression: '[userID]',
                      condition: 'equal',
                      value: $App.connection.userData().userID
                    }
                  }
                }
              }
            }
          ]
        })
      })
    }
