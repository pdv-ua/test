exports.formDef = {
  requiredFields: ['employeeID','assetsID',
    'assetsID.code',
    'assetsID.categAssetsID.description',
    'assetsID.groupAssetsID.description',
    'assetsID.typeAssetsID.description',
    'assetsID.SN',
    'assetsID.organizationID.description'
  ],
  parentConfig: {
    postOnlySimpleAttributes: true,
    layout: {
      type: 'vbox',
      align: 'stretch'
    }
  },
  size: {
    width: 1100,
    height: 600
  },
  items: [
    { 
      attributeName: 'assetsID',
      fieldLabel: UB.i18n('Видано майно'),
      fieldList: ['description','code','categAssetsID.description', 'groupAssetsID.description',
          'typeAssetsID.description','SN','organizationID.description'],
      whereList: {
        organizationID: {
          expression: '[organizationID]',
          condition: 'equal',
          value: appAC.globalOrganization()
        }
      },
      labelWidth: 120 
    },
    {
      name: 'assetNumber',
      xtype: 'textfield',
      fieldLabel: UB.i18n('Інв.№'), 
      disabled: true,
      labelWidth: 120 
    },    
    {
      name: 'assetCateg',
      xtype: 'textfield',
      fieldLabel: UB.i18n('Категорія майна'), 
      disabled: true,
      labelWidth: 120 
    },    
    {
      name: 'assetGroup',
      xtype: 'textfield',
      fieldLabel: UB.i18n('Група майна'), 
      disabled: true,
      labelWidth: 120 
    },    
    {
      name: 'assetType',
      xtype: 'textfield',
      fieldLabel: UB.i18n('Вид майна'), 
      disabled: true,
      labelWidth: 120 
    },    
    {
      name: 'assetSN',
      xtype: 'textfield',
      fieldLabel: UB.i18n('Серійний номер'), 
      disabled: true,
      labelWidth: 120 
    },    
    {
      name: 'assetOrg',
      xtype: 'textfield',
      fieldLabel: UB.i18n('Організація'), 
      disabled: true,
      labelWidth: 120 
    },    
    {
      attributeName: 'employeeID', 
      fieldList: ['ID', 'description'],
      fieldLabel: UB.i18n('Відповідальний'), 
      disabled: true,
      labelWidth: 120 
    },    
    { attributeName: 'dateFrom', labelWidth: 120  },
    { attributeName: 'dateTo', labelWidth: 120  }
  ]
}
