        <td style="width: 106px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 106px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; " colspan="2">Підприємство</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; " colspan="4">{{orgName}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; border-top: 1px solid black; border-bottom: 1px solid black; " >Таб. №</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt; border-top: 1px solid black; border-bottom: 1px solid black; font-weight:bold; " >{{tabNum}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; border-top: 1px solid black; border-bottom: 1px solid black; " >ПІБ</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt; border-top: 1px solid black; border-bottom: 1px solid black; font-weight:bold; " colspan="3">{{employeeName}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-top: 1px solid black; border-bottom: 1px solid black; " colspan="2">Підрозділ</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-top: 1px solid black; border-bottom: 1px solid black; " colspan="4">{{depName}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-top: 1px solid black; border-bottom: 1px solid black; " colspan="2">Посада</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-top: 1px solid black; border-bottom: 1px solid black; " colspan="4">{{posName}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; " colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 14pt; font-weight:bold; " colspan="2">Наказ</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 14pt; font-weight:bold; " colspan="2">№ {{orderNumber}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 14pt; font-weight:bold; " colspan="2">від {{orderDate}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; " colspan="6">&nbsp;</td>
