        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; ">Дні для розрахунку</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; ">Сума фактичного заробітку</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; ">Сума заробітка для розрахунку</td>
    </tr>
    <!--{{#avg}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"index","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; ">{{periodName}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"totalDays","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"opDays","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: right;">{{#$fs}}"baseSum","decimal2"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; border-right: 1px solid black; text-align: right;">{{#$fs}}"opSum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/avg}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; " colspan="2">Всього</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"totalAvg.totalDays","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"totalAvg.opDays","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: right;">{{#$fs}}"totalAvg.baseSum","decimal2"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; border-right: 1px solid black; text-align: right;">{{#$fs}}"totalAvg.opSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-top: 1px solid black; border-bottom: 1px solid black; " colspan="4">Середньомісячний заробіток</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-top: 1px solid black; border-bottom: 1px solid black; " colspan="2">{{#$fs}}"avgSumWork","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; " colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 14pt; font-weight:bold; text-align: center;" colspan="6">Нарахування</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; ">Вид оплати</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; ">Період</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; ">Кількість</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; " colspan="2">Середньомісячний заробіток</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; border-right: 1px solid black; text-align: center; ">Сума</td>
    </tr>
    <!--{{#dt}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; ">{{payElName}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; ">{{description}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"days","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: right;" colspan="2">{{#$fs}}"baseSum","decimal2"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: right;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/dt}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; ">Всього</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; ">&nbsp;</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"totalDt.days","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; " colspan="2">&nbsp;</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; border-right: 1px solid black; text-align: right;">{{#$fs}}"totalDt.paySum","decimal2"{{/$fs}}</td>
    </tr>
    </tbody>
</table>