<!--%pageOrientation:portrait-->
<table style="font-family: TimesNewRoman; font-size: 14pt; line-height: 1.2; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 80px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
    <tr>
        <td style="width: 50px; padding: 0;">&nbsp;</td>
        <td style="width: 175px; padding: 0;">&nbsp;</td>
        <td style="width: 55px; padding: 0;">&nbsp;</td>
        <td style="width: 70px; padding: 0px 1px 0px 1px; text-align: center;">&nbsp;</td>
        <td style="width: 55px; padding: 0;">&nbsp;</td>
        <td style="width: 175px; padding: 0;">&nbsp;</td>
        <td style="width: 50px; padding: 0;">&nbsp;</td>
    </tr>
    <tr style="padding: 0; margin: 0;">
        <td colspan="7" style="text-align:center;" align="center"><img  src="{{emblem}}" data-style-pdf="padding-left:{{logoPaddingLeft}}px;" alt="emblem" width="{{logoWidthPx}}" height="{{logoHeightPx}}" /></td>
    </tr>
    <tr style="height: 18px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: center; {{boldOrganizationName}}" colspan="7">{{{organizationName}}}</td>
    </tr>
    <tr style="height: 48px; padding: 0; margin: 0;">
        <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="7">Н А К А З</td>
    </tr>
    <!--Дата та номер наказу-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="2">{{fromDate}}{{orderDate}}</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="3">{{city}}</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: right;" colspan="2">№ {{orderNumber}}{{orderIndex}}</td>
    </tr>
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: left; font-weight: bold;" colspan="3">Про надання відпустки{{{titleOrder}}}</td>
        <td style="padding: 0px 1px 0px 1px;" colspan="4">&nbsp;</td>
    </tr>
    <tr style="height: 48px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="7">{{{preamble}}}</td>
    </tr>
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="7"><strong>НАКАЗУЮ: </strong></td>
    </tr>
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <!--{{#items}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="7">
            {{{text}}}
        </td>
    </tr>
    <!--{{#matTransfer}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="7">
            {{{text}}}
        </td>
    </tr>
    <!--{{/matTransfer}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <!--{{/items}}-->
    <!--{{#unrefMatTransfer}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: justify;" colspan="7">
            {{index}}. {{{text}}}
        </td>
    </tr>
    <!--{{/unrefMatTransfer}}-->
    <!--{{#tasks}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 38px;" colspan="7">{{{task}}}</td>
    </tr>
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <!--{{/tasks}}-->
    <!--{{#orderReason}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0 1px 0px 1px; text-align: justify; " colspan="7">{{{reason}}}</td>
    </tr>
    <!--{{/orderReason}}-->

    <!--{{#responsiblesInfo}}-->
    <tr style="height: 41px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; font-weight:bold; padding: 0px 25px 0px 1px; text-align: left; vertical-align: top;" colspan="4">{{respPos}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; font-weight:bold; padding: 0px 1px 0px 25px; text-align: {{align}}; vertical-align: bottom;" colspan="3">{{respFirstName}}</td>
    </tr>
    <!--{{/responsiblesInfo}}-->

    </tbody>
</table>