<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; overflow-wrap: break-word; border-collapse: collapse; width: {{tableWidth}}px;">

  <tr style="height: 20px;">
    <td style="text-align: center; font-weight: bold; font-size: 12pt; height: 20px;" colspan="{{colSpan}}">Список працівників, які перебували у відпустці в періоді з {{dateFrom}} по {{dateTo}}</td>
  </tr>

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; padding-bottom: 10px;" colspan="{{colSpan}}">{{organizationName}}</td>
  </tr>
  <!-- {{#departmentName}} -->
  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; padding-bottom: 10px;" colspan="{{colSpan}}">{{departmentName}}</td>
  </tr>
  <!-- {{/departmentName}} -->

  <tr style="font-weight: bold; font-size: 11pt;">
    <td style="width: 50px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">№ з/п</td>
    <td style="width: 200px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Прізвище, ім'я,<br/>по батькові</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="width: 200px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Додаткова інформація</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="width: 80px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Категорія<br/>посади</td>
    <td style="width: 70px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Ранг</td>
    <td style="width: 200px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Посада</td>
    <!-- {{#useActualPositionName}} -->
        <td style="width: 200px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Фактична посада</td>
    <!-- {{/useActualPositionName}} -->
    <td style="width: 200px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Підрозділ</td>
    <td style="width: 200px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Самостійний<br/>структурний підрозділ</td>
    <td style="width: 120px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Організація</td>
    <td style="width: 150px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Місце роботи</td>
    <td style="width: 120px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Вид відпустки</td>
    <!-- {{#showDetails}} -->
    <td style="width: 150px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Період</td>
    <!-- {{/showDetails}} -->
    <td style="width: 80px; text-align: center;font-family: TimesNewRoman; border: 1px solid;">Дата<br/>початку</td>
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Дата<br/>закінчення</td>
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Кількість днів за наказом</td>
  </tr>

  <tr style="font-size: 10pt;">
    <!-- {{#colNums}} -->
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{name}}</td>
    <!-- {{/colNums}} -->
  </tr>

  <!-- {{#rows}} -->
  <tr style="font-size: 10pt; vertical-align: top;">
    <td style="width: 50px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{index}}</td>
    <td style="width: 200px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{fullFIO}}</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="width: 200px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{addDescrPerson}}</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{posCategory}}</td>
    <td style="width: 70px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{rankCur}}</td>
    <td style="width: 200px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{posName}}</td>
    <!-- {{#useActualPositionName}} -->
      <td style="width: 200px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{actualPositionName}}</td>
    <!-- {{/useActualPositionName}} -->
    <td style="width: 200px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{depName}}</td>
    <td style="width: 200px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{selfStructDepName}}</td>
    <td style="width: 150px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{orgName}}</td>
    <td style="width: 120px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{workPlaceName}}</td>
    <td style="width: 120px; text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{dictVacationKindName}}</td>
    <!-- {{#showDetails}} -->
    <td style="width: 150px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{periodValue}}</td>
    <!-- {{/showDetails}} -->
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{dateFrom}}</td>
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{dateTo}}</td>
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{vacDayCount}}</td>
  </tr>
  <!-- {{/rows}} -->

  <tr>
    <td colspan="{{colSpan}}" style="height: 50px"></td>
  </tr>
  <tr style="font-size: 10pt;">
    <td></td>
    <td colspan="{{colSpan2}}" style="height: 20px; border-top: 1px solid; text-align: center;">(Посада)</td>
    <td></td>
    <td colspan="{{colSpan3}}" style="height: 20px; border-top: 1px solid; text-align: center;">(Прiзвище I.Б.)</td>
    <td></td>
  </tr>
</table>