<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; line-height: 1.35; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 8px 0px 66px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
<tbody>
    <tr style="height: 14px; padding: 0; margin: 0;">
        <td style="width: 225px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 90px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 200px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 125px; padding: 0; font-size: 1pt;">&nbsp;</td>
    </tr>
    <tr style="padding: 0; margin: 0;">
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt; text-align: center; font-weight:bold;" colspan="4">Аркуш погодження до документа</td>
    </tr>
    <tr style="padding: 0; margin: 0;">
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt; text-align: center; font-weight:bold;" colspan="4">{{docInfo}}</td>
    </tr>
    </tr>
        <td style="padding: 0px 1px 0px 1px;" colspan="4">&nbsp;</td>
    </tr>

    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid black;">Посада, ПІБ</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid black;">Етап погодження</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid black;">КЕП</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid black;">Серійний номер</td>
    </tr>

    <!--{{#rows}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; border: 1px solid black;">{{{name}}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid black;">{{{stageAndDate}}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; border: 1px solid black;">{{{kep}}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; border: 1px solid black; word-break: break-all;">{{serial}}</td>
    </tr>
    <!--{{/rows}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px;" colspan="4">&nbsp;</td>
    </tr>
    </tr>
        <td style="padding: 0px 1px 0px 1px;" colspan="4">&nbsp;</td>
    </tr>

    <tr>
        <td style="vertical-align: top; text-align: center;" ><img src="{{qrCode}}" alt="emblem" width="100" height="100" /></td>
        <td style="vertical-align: top; text-align: center; font-size: 10pt;" colspan="2">{{organizationName}}<br/>{{docNumber}}<img src="{{barCode}}" alt="emblem" width="200" height="50" /> </td>
        <td style="vertical-align: top; text-align: left; font-size: 10pt;" >&nbsp;</td>
        <td style="vertical-align: top; text-align: left; font-size: 10pt;" >&nbsp;</td>
    </tr>
</tbody>
</table>