<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; line-height: {{lineHeight}}; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
    <tr>
        <td style="width: 50px; padding: 0;">&nbsp;</td>
        <td style="width: 180px; padding: 0;">&nbsp;</td>
        <td style="width: 55px; padding: 0;">&nbsp;</td>
        <td style="width: 70px; padding: 0px 1px 0px 1px; text-align: center;">&nbsp;</td>
        <td style="width: 55px; padding: 0;">&nbsp;</td>
        <td style="width: 180px; padding: 0;">&nbsp;</td>
        <td style="width: 50px; padding: 0;">&nbsp;</td>
    </tr>
    <tr style="padding: 0; margin: 0;">
        <td colspan="7" style="text-align:center;" align="center"><img  src="{{emblem}}" data-style-pdf="padding-left:{{logoPaddingLeft}}px;" alt="emblem" width="{{logoWidthPx}}" height="{{logoHeightPx}}" /></td>
    </tr>
    <tr style="height: 15px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; {{boldOrganizationName}}" colspan="7">{{{ organizationName }}}</td>
    </tr>
    <tr style="height: 48px; padding: 0; margin: 0;">
        <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="7">Н А К А З</td>
    </tr>
    <!--Дата та номер наказу-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="2">{{fromDate}}{{orderDate}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="3">{{city}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: right;" colspan="2">№ {{orderNumber}}{{orderIndex}}</td>
    </tr>
    <!--{{#titleOrder}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left; {{titleOrderParams}}" colspan="3">{{{titleOrder}}}</td>
        <td style="padding: 0px 1px 0px 1px;" colspan="4">&nbsp;</td>
    </tr>
    <!--{{/titleOrder}}-->
    <!--{{#preamble}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="7">{{{preamble}}}</td>
    </tr>
    <!--{{/preamble}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="7"><strong>НАКАЗУЮ: </strong></td>
    </tr>
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <!--{{#items}}-->
    <tr>
        <!--{{#indent}}-->
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="7">{{{text}}}</td>
        <!--{{/indent}}-->
        <!--{{^indent}}-->
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify;" colspan="7">{{{text}}}</td>
        <!--{{/indent}}-->

    </tr>
    <!--{{/items}}-->
    <!--{{#tasks}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="7">{{{task}}}</td>
    </tr>
    <!--{{/tasks}}-->
    <!--{{#orderReason}}-->
    <tr style="padding: 0; margin: 0;">
        <td style="height: 26px; padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; " colspan="7">{{{reason}}}</td>
    </tr>
    <!--{{/orderReason}}-->
    <!--{{#responsiblesInfo}}-->
    <tr style="height: 45px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; font-weight:bold; padding: 0px 25px 0px 1px; text-align: left; vertical-align: top;" colspan="4">{{respPos}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; font-weight:bold; padding: 0px 1px 0px 25px; text-align: {{align}}; vertical-align: bottom;" colspan="3">{{respFirstName}}</td>
    </tr>
    <!--{{/responsiblesInfo}}-->

    </tbody>
</table>
<!--{{#details}}-->
<p>
    <!-- pagebreak -->
</p>
<table style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; line-height: 1.1; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="2">Додаток 1</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="2">до наказу {{organizationName}}</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="2">від {{orderDate}} №{{orderNumber}}&nbsp;{{orderIndex}}</td>
        </tr>
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="4">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"
                colspan="2">
                <!--{{#isApparat}}-->
                    <b>Посади державної служби <br /> апарату {{organizationName}}, <br />на які оголошується конкурс</b>
                <!--{{/isApparat}}-->
                <!--{{^isApparat}}-->
                    <b>Посади державної служби <br />{{organizationName}},<br /> на які оголошується конкурс</b>
                <!--{{/isApparat}}-->
            </td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;"></td>
        </tr>
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="4">&nbsp;</td>
        </tr>
    </tbody>
</table>

<table style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; line-height: 1.1; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
        <tr>
            <td style="width: 60px; font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; border: 1px solid black; text-align: center;"><b>№ з/п</b></td>
            <td style="width: 430px; font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; border: 1px solid black; text-align: center;"><b>Назва посади</b></td>
            <td style="width: 150px; font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; border: 1px solid black; text-align: center;"><b>Категорія посади</b></td>
        </tr>
        <!--{{#positions}}-->
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; border: 1px solid black; text-align: center;">{{indexPos}}</td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; border: 1px solid black; text-align: left;">{{{ name }}}</td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; border: 1px solid black; text-align: center;">{{positionCategory}}</td>
        </tr>
        <!--{{/positions}}-->
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 0px; " colspan="3">&nbsp;</td>
          </td>
        </tr>
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px; border: 0px; " colspan="3">{{line}}</td>
          </td>
        </tr>
    </tbody>
</table>

<!--{{/details}}-->