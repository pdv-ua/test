<!--%pageOrientation:portrait-->


<table style="font-family: TimesNewRoman; font-size: 14pt; line-height: 1.1; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="{{width}}px" cellspacing="0" cellpadding="0px"
       data-organizationid = "{{organizationID}}"
       data-organizationids = "{{organizationIDs}}"
       data-ondate = "{{onDate}}"
>
    <tbody>
    <tr style="font-size: 5pt; height: 5px">
    {{#columnNames}}
        <td style="padding: 0; width: {{colwidth}}px;">&nbsp;</td>
    {{/columnNames}}
    </tr>

    <tr>
        <td style="font-size: 12pt; font-family: 'Times New Roman'; font-weight: bold; border: 0px; text-align:center; " colspan="{{colSpan}}">Кількісний склад {{orgNameGen}}</td>
    </tr>
    <tr>
        <td style="font-size: 12pt; font-family: 'Times New Roman'; border: 0px; text-align:center; " colspan="{{colSpan}}">станом {{onDateStr}} року</td>
    </tr>
    <tr>
        <td style="font-size: 6pt; font-family: 'Times New Roman'; border: 0px; text-align:center; " colspan="{{colSpan}}">&nbsp;</td>
    </tr>
    <tr>
    {{#columnNames}}
        <td style="height: 50px; font-size: 12pt; font-family: 'Times New Roman'; border: 1px solid black; text-align:center; font-weight: bold;">{{name}}</td>
    {{/columnNames}}
    </tr>

    {{#rows}}
    <tr>
        {{#columns}}
            {{#onlyText}}
                <td style="font-size: 12pt; font-family: 'Times New Roman'; border: 1px solid black; text-align:left;padding: 1px 3px 1px 3px;" >{{value}}</td>
            {{/onlyText}}
            {{^onlyText}}
                <td style="font-size: 12pt; font-family: 'Times New Roman'; border: 1px solid black; text-align:center;"
                    data-categoryname = "{{categoryname}}" data-categoryid = "{{categoryid}}"
                    data-workplacename = "{{workplacename}}" data-workplace = "{{workplace}}"><a href="#">{{{valueStr}}}</a></td>
            {{/onlyText}}
        {{/columns}}
    </tr>
    {{/rows}}

    <tr>
    {{#totals}}
        {{#onlyText}}
            <td style="font-size: 12pt; font-family: 'Times New Roman'; border: 1px solid black; text-align:left; font-weight: bold;padding: 1px 3px 1px 3px;" >{{value}}</td>
        {{/onlyText}}
        {{^onlyText}}
        <td style="font-size: 12pt; font-family: 'Times New Roman'; border: 1px solid black; text-align:center; font-weight: bold;"
            data-categoryname = "" data-categoryid = ""
            data-workplacename = "{{workplacename}}" data-workplace = "{{workplace}}"><a href="#">{{{valueStr}}}</a></td>
        {{/onlyText}}
    {{/totals}}
    </tr>

    </tbody>
</table>