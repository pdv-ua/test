<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: 14pt; line-height: 1.1; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
    <!--{{#showCurrentAccrual}}-->
        <tr>
            <td style="width: 200px; padding: 0; font-size: 1pt;">&nbsp;</td>
            <td style="width: 95px; padding: 0; font-size: 1pt;">&nbsp;</td>
            <td style="width: 110px; padding: 0; font-size: 1pt;">&nbsp;</td>
            <td style="width: 110px; padding: 0; font-size: 1pt;">&nbsp;</td>
            <td style="width: 125px; padding: 0; font-size: 1pt;">&nbsp;</td>
        </tr>
    <!--{{/showCurrentAccrual}}-->

    <!--{{^showCurrentAccrual}}-->
        <tr>
            <td style="width: 260px; padding: 0; font-size: 1pt;">&nbsp;</td>
            <td style="width: 120px; padding: 0; font-size: 1pt;">&nbsp;</td>
            <td style="width: 125px; padding: 0; font-size: 1pt;">&nbsp;</td>
            <td style="width: 125px; padding: 0; font-size: 1pt;">&nbsp;</td>
        </tr>
    <!--{{/showCurrentAccrual}}-->
        <tr>
            <td style="font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="{{colSpan}}">Список</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="{{colSpan}}">посад {{organizationNameGen}}</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="{{colSpan}}">яким встановлюються посадові оклади</td>
        </tr>
        <tr>
            <td style="padding: 0; margin: 0;" colspan="{{colSpan}}">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; text-align: right; font-size: 14pt; padding: 0px 1px 0px 1px;" colspan="{{colSpan}}">Всього встановлено посадових окладів для {{numberPositions}} посад</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center;border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Назва посади</td>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Дата введення</td>
    <!--{{#showCurrentAccrual}}-->
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Оклад на початок планування</td>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Фактичний оклад станом на {{appDate}}</td>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Запланований оклад</td>
    <!--{{/showCurrentAccrual}}-->
    <!--{{^showCurrentAccrual}}-->
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Поточний оклад</td>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Новий оклад</td>
    <!--{{/showCurrentAccrual}}-->
        </tr>

        <!--{{#positions}}-->
        <tr>
            <td style="font-family: TimesNewRoman; text-transform: uppercase; color:blue; text-align: left; font-size: 14pt; border: 1px solid black; font-weight: bold;" colspan="{{colSpan}}">{{department}}</td>
        </tr>
        <!--{{#items}}-->
        <tr>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: left; border:1px solid black; padding: 0px 1px 0px 1px;" >{{name}}</td>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{dateFrom}}</td>
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{#$fs}}"previousAccrualSum","{{roundTo}}"{{/$fs}}</td>
    <!--{{#showCurrentAccrual}}-->
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{#$fs}}"oldValue","{{roundTo}}"{{/$fs}}</td>
    <!--{{/showCurrentAccrual}}-->
            <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{#$fs}}"newValue","{{roundTo}}"{{/$fs}}</td>
        </tr>
        <!--{{/items}}-->
        <tr>
            <td style="font-family: TimesNewRoman; text-align: left; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="{{colSpan}}">Всього по {{department}} {{total}}</td>
        </tr>
        <!--{{/positions}}-->
    </tbody>
</table>