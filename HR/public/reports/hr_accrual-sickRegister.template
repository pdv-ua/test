<td style="vertical-align: top; width: 70px; min-width: 70px; text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{fssuDays}}</td>
<td style="vertical-align: top; width: 70px; min-width: 70px; text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{standingAll}}</td>
<td style="vertical-align: top; width: 70px; min-width: 70px; text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{rate}}</td>
<td style="vertical-align: top; width: 70px; min-width: 70px; text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{#$fs}}"baseSum","decimal2"{{/$fs}}</td>
<td style="vertical-align: top; width: 70px; min-width: 70px; text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;"><a href="#" data-cellorderid="{{docRegSicknessID}}">{{#$f}}"paySum","decimal2"{{/$f}}</a></td>
<td style="vertical-align: top; width: 145px; min-width: 145px; text-align: left; border: 1px solid;">{{orgName}}</td>
