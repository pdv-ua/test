<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; line-height: {{lineHeight}}; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
        <tr>
          <td style="width: 40px; padding: 0;">&nbsp;</td>
          <td style="width: 130px; padding: 0;">&nbsp;</td>
          <td style="width: 100px; padding: 0;">&nbsp;</td>
          <td style="width: 50px; padding: 0;">&nbsp;</td>
          <td style="width: 50px; padding: 0;">&nbsp;</td>
          <td style="width: 50px; padding: 0;">&nbsp;</td>
          <td style="width: 220px; padding: 0;">&nbsp;</td>
        </tr>
        <tr style="padding: 0; margin: 0;">
            <td colspan="7" style="text-align:center;" align="center"><img  src="{{emblem}}" data-style-pdf="padding-left:{{logoPaddingLeft}}px;" alt="emblem" width="{{logoWidthPx}}" height="{{logoHeightPx}}" /></td>
        </tr>
        <!--{{#orderBlock}}-->
        <tr style="height: 18px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt;  text-align: center; padding: 0px 1px 0px 1px; {{boldOrganizationName}}" colspan="7">{{{organizationName}}}</td>
        </tr>
        <tr style="height: 48px; padding: 0; margin: 0;">
            <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <!--{{/orderBlock}}-->
        <!--{{#mainRespPos}}-->
        <tr style="height: 10px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{headFontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="7">{{{mainRespPos}}}</td>
        </tr>
        <tr style="padding: 0px; margin: 0px;">
            <td colspan="7" style="padding: 0; margin: 0;">
                <img width="{{appointmentLinesWidth}}" height="{{appointmentLinesHeight}}" data-style-pdf="padding: 0; margin: 0;"
                src="{{appointmentLinesFoto}}"/>
            </td>
        </tr>
        <tr style="height: 6px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <!--{{/mainRespPos}}-->
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{titleFontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="7">{{{orderType}}}</td>
        </tr>
        <!--Дата та номер наказу-->
        <!--{{#orderBlock}}-->
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left;  padding: 0px 1px 0px 1px;" colspan="3" >{{fromDate}}{{orderDate}}</td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px;" colspan="2" >{{city}}</td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: right; padding: 0px 1px 0px 1px;" colspan="2" >№ {{orderNumber}}{{orderIndex}}</td>
        </tr>
        <!--{{/orderBlock}}-->
        <!--{{#appointmentBlock}}-->
        <tr>
            <td colspan="7" style="font-family: TimesNewRoman; font-size: {{appointmentNumberFontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;">{{orderDate}}р. № {{orderNumber}}{{orderIndex}}</td>
        </tr>
        <!--{{/appointmentBlock}}-->
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left; {{titleOrderParams}}" colspan="4">{{{titleOrder}}}</td>
            <td style="padding: 0;" colspan="3">&nbsp;</td>
        </tr>

        <!--{{#preamble}}-->
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: justify; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="7">{{{preamble}}}</td>
        </tr>
        <!--{{/preamble}}-->
        <!--{{#orderBlock}}-->
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; font-weight:bold; padding: 0px 1px 0px 1px;" colspan="7">НАКАЗУЮ: </td>
        </tr>
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <!--{{/orderBlock}}-->
        <!--{{#orderDet}}-->
            <tr>
                <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: justify; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="7">
                    {{itemIdxTxt}}{{{text}}}
                </td>
            </tr>
            <!--{{#items}}-->
            <tr>
                <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: justify; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="7">{{{text}}}</td>
            </tr>
            <!--{{/items}}-->
            <!--{{#itemReason}}-->
            <tr>
                <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: justify; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="7">{{itemReason}}</td>
            </tr>
            <!--{{/itemReason}}-->
        <!--{{/orderDet}}-->
        <!--{{#tasks}}-->
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt;text-align: justify; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="7">
                {{{task}}}
            </td>
         </tr>
         <!--{{/tasks}}-->
        <!--{{#orderReason}}-->
        <tr style="height: 26px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; {{indent}}" colspan="7">{{{text}}}</td>
        </tr>
        <!--{{/orderReason}}-->
    <!--{{#responsiblesInfo}}-->
        <tr style="height: 45px; padding: 0; margin: 0;">
            <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; {{bold}} padding: 0px 25px 0px 1px; text-align: left; vertical-align: top;" colspan="4">{{respPos}}</td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; {{bold}} padding: 0px 1px 0px 25px; text-align: {{align}}; vertical-align: bottom;" colspan="3">{{respFirstName}}</td>
        </tr>
    <!--{{/responsiblesInfo}}-->

        <!--{{#isPrintAddon}}-->
        <tr style="page-break-after: always;">
            <td colspan="7">
                <p>&nbsp;<!-- pagebreak --></p>
            </td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px;" colspan="5">&nbsp;</td>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px;" colspan="2">Додаток <br />
до наказу {{organizationNameGen}}<br />від {{orderBlock.orderDate}} №{{orderBlock.orderNumber}}{{orderBlock.orderIndex}}</td>
        </tr>
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; font-weight:bold; padding: 0px 1px 0px 1px;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; font-weight:bold; padding: 0px 1px 0px 1px;" colspan="7">&nbsp;</td>
        </tr>
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: justify; font-weight:bold; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="7">{{positionType}}</td>
        </tr>
        <!--{{#addons}}-->
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: justify; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="7">{{{text}}}</td>
        </tr>
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;">№ <br />з/п</td>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" >ПІБ</td>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" colspan="3">Посада</td>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" colspan="2">ПІБ {{positionTypeActing}}, на якого покладено виконання обов’язків</td>
        </tr>
        <!--{{#items}}-->
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; ">{{index}}</td>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " >{{{empName}}}</td>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " colspan="3">{{posName}}</td>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " colspan="2"><!--{{#acting}}-->{{{text}}}<!--{{/acting}}-->
          </td>
        </tr>
        <!--{{/items}}-->
        <!--{{/addons}}-->
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 0px; " colspan="7">&nbsp;</td>
          </td>
        </tr>
        <tr>
          <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px; border: 0px; " colspan="7">{{line}}</td>
          </td>
        </tr>
        <!--{{/isPrintAddon}}-->

    </tbody>
</table>