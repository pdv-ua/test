<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; word-wrap: break-word; border-collapse: collapse; width: 1180px" border="0px" width="1180px" cellspacing="0" cellpadding="3px">
    <tbody>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt;" colspan="9">Звіт</td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt;" colspan="9">про додаткові витрати ЄСВ на мінімальну заробітну плату</td>
    </tr>
    <tr>
        <td style="text-align: right; font-weight: bold; font-size: 11pt;" colspan="3">за</td>
        <td style="text-align: center;font-weight: bold; font-size: 11pt; border-bottom: 1px solid;" colspan="3">{{periodName}}</td>
        <td style="text-align: left; font-weight: bold; font-size: 11pt;" colspan="3">року</td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt;" colspan="9"> </td>
    </tr>
    <tr>
        <td style="text-align: right; font-weight: bold; font-size: 11pt;" colspan="3">підрозділ</td>
        <td style="text-align: left;font-weight: bold; font-size: 11pt; border-bottom: 1px solid;" colspan="3">{{departmentName}}</td>
        <td style="text-align: left; font-weight: bold; font-size: 11pt;" colspan="3"></td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt; height: 24px" colspan="9"> </td>
    </tr>
    <tr style="font-weight: bold; font-size: 11pt;">
        <td style="width: 50px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">№ з/п</td>
        <td style="width: 100px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Таб.№</td>
        <td style="width: 200px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">ПIБ</td>
        <td style="width: 200px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Посада</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Період</td>
        <td style="width: 120px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Сума<br/>нарахована</td>
        <td style="width: 120px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Нараховано<br/>ЄСВ на суму</td>
        <td style="width: 120px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Додатково<br/>нараховане<br/>ЄСВ </td>
        <td style="width: 120px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">Всього<br/>нараховане<br/>ЄСВ</td>
    </tr>
    <!--{{#personTable}}-->
    <tr style="font-size: 11pt; vertical-align: bottom; page-break-inside: avoid;">
        <td style="width: 50px; text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{pn}}</td>
        <td style="width: 100px; text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{tabNum}}</td>
        <td style="width: 200px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{fullFIO}}</td>
        <td style="width: 200px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{posName}}</td>
        <td style="width: 150px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{period}}</td>
        <td style="width: 120px; text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"sum","decimal2"{{/$fs}}</td>
        <td style="width: 120px; text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"sumECB","decimal2"{{/$fs}}</td>
        <td style="width: 120px; text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"addECB","decimal2"{{/$fs}}</td>
        <td style="width: 120px; text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{#$fs}}"generalECB","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/personTable}}-->
    <tr style="font-weight: bold; font-size: 11pt;">
        <td style="text-align: right; font-weight: bold; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;" colspan="5">Всього</td>
        <td style="text-align: right; font-weight: bold; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{#$fs}}"totalSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; font-weight: bold; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{#$fs}}"totalSumECB","decimal2"{{/$fs}}</td>
        <td style="text-align: right; font-weight: bold; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{#$fs}}"totalAddECB","decimal2"{{/$fs}}</td>
        <td style="text-align: right; font-weight: bold; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">{{#$fs}}"totalGeneralECB","decimal2"{{/$fs}}</td>
    </tr>
    </tbody>
</table>