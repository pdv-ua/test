<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: 14px; table-layout: fixed; line-height: 1.3; border-collapse: collapse; width: 640px;  word-break: normal; margin: 0px 10px 0px 70px;"  border="0px" cellspacing="0" cellpadding="0px">
    <tbody>
    <tr>
        <td style="width: 130px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 130px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 93px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 93px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 97px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 97px; padding: 0; font-size: 1pt;">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="6">Список</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="6">працівників {{organizationNameGen}}</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="6">яким встановлюються посадові оклади</td>
    </tr>
    <tr>
        <td style="padding: 0; margin: 0;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; text-align: right; font-size: 14pt; padding: 0px 1px 0px 1px;" colspan="6">Всього встановлено {{numberPerson}} посадових окладів</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; text-align: right; font-size: 14pt; padding: 0px 1px 0px 1px;" colspan="6">загальною сумою {{{sumPerson}}} грн.</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center;border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Прізвище І. Б.</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center;border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Назва посади</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Поточний оклад</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Новий оклад</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Дата з</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px; font-weight: bold;" >Дата по</td>
    </tr>

    <!--{{#positions}}-->
    <tr>
        <td style="font-family: TimesNewRoman; text-transform: uppercase; color:blue; text-align: center; font-size: 14pt; border: 1px solid black; font-weight: bold;" colspan="6">{{department}}</td>
    </tr>
    <!--{{#items}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border:1px solid black; padding: 0px 1px 0px 1px;" >{{name}}</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border:1px solid black; padding: 0px 1px 0px 1px;" >{{nameDep}}</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{#$fs}}"oldValue","{{roundTo}}"{{/$fs}}</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{#$fs}}"newValue","{{roundTo}}"{{/$fs}}</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{data}}</td>
        <td style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; border: 1px solid black; padding: 0px 1px 0px 1px;" >{{dataTo}}</td>
    </tr>
    <!--{{/items}}-->
    <tr>
        <td style="font-family: TimesNewRoman; text-align: left; font-size: 14pt; font-weight: bold; padding: 0px 1px 0px 1px;" colspan="6">Всього по {{department}} {{total}}</td>
    </tr>
    <!--{{/positions}}-->

    </tbody>
</table>