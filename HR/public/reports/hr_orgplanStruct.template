<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: 14px; table-layout: fixed; line-height: 1.3; border-collapse: collapse; width: 640px;  word-break: normal;  margin: 0px 10px 0px 70px;" border="0px" cellspacing="0" cellpadding="0px">
<tbody>
    <tr>
        <td style="width: 60px;">&nbsp;</td>
        <td style="width: 250px;">&nbsp;</td>
        <td style="width: 20px;">&nbsp;</td>
        <td style="width: 200px;">&nbsp;</td>
        <td style="width: 110px;">&nbsp;</td>
    </tr>
    <tr>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold;" colspan="2">ПОГОДЖУЮ</td>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: left; font-size: 14pt; font-weight: bold;">&nbsp;</td>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold;" colspan="2">ЗАТВЕРДЖЕНО</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; text-align: left; font-size: 12pt; vertical-align: top;" colspan="2">
{{agreedDepName}} <br />
{{agreedOrgName}} <br />
{{agreedFIO}} <br />
{{agreedData}}
        </td>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: left; font-size: 12pt;">&nbsp;</td>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: left; font-size: 12pt; vertical-align: top;" colspan="2">Наказ {{{organizationName}}}<br />
від "_____"__________________ 20___ р.
        </td>
    </tr>
    <tr>
        <td style="height: 20px" colspan="5">&nbsp;</td>
    </tr>

    <tr>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold;" colspan="5">СТРУКТУРА АПАРАТУ</td>
    </tr>
    <tr>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: center; font-size: 14pt; font-weight: bold;" colspan="5">{{{organizationName}}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: center; font-size: 12pt; border: 1px solid;">№<br/>з/п</td>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: center; font-size: 12pt; border: 1px solid;" colspan="3">Найменування підрозділів</td>
        <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; text-align: center; font-size: 12pt; border: 1px solid;">Кількість<br/>штатних<br/>одиниць</td>
    </tr>
    <!--{{#data}}-->
        <tr >
            <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; font-size: 12pt; text-align: left; border: 1px solid black;">{{indexNum}}</td>
            <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; font-size: 12pt; {{style}} text-align: left; border: 1px solid black;" colspan="3">{{{name}}}</td>
            <td style="padding: 0px 3px 0px 3px; font-family: TimesNewRoman; font-size: 12pt; {{style}} text-align: center; border: 1px solid black;" data-format="number">{{{quantityStr}}}</td>
        </tr>
    <!--{{/data}}-->

    <!--{{#reconciliation}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; " colspan="5">&nbsp;</td>
    </tr>
    <tr>
        <td style="padding: 0px 3px 0px 3px; text-align: left; font-size: 12pt; font-family: TimesNewRoman; border: 0px solid;" colspan="2">{{nameDep}}</td>
        <td style="padding: 0px 3px 0px 3px; text-align: left; font-size: 12pt; font-family: TimesNewRoman; border: 0px solid;" >&nbsp;</td>
        <td style="padding: 0px 3px 0px 3px; text-align: left; font-size: 12pt; font-family: TimesNewRoman; border: 0px solid;" colspan="2">{{name}}</td>
    </tr>
    <!--{{/reconciliation}}-->

</tbody>
</table>