<!--%pageOrientation:landscape-->

<table style="font-family: Calibri; word-wrap: break-word; border-collapse: collapse;" border="0px" width="920" cellspacing="0" cellpadding="3px">
    <tbody>
    <tr>
        <td style="text-align: center; width: 100%; font-size: 11pt;" colspan="6">ДОВІДКА</td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-size: 11pt;" colspan="6">ПРО ІНДЕКСАЦІЮ ГРОШОВИХ ДОХОДІВ</td>
    </tr>
    <tr>
        <td style="height: 20px;" colspan="6"> </td>
    </tr>
    <tr>
        <td style="text-align: left; font-size: 11pt;">Видана</td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;" colspan="5">{{emp}}</td>
    </tr>
    <tr>
        <td style="text-align: left; font-size: 11pt;" colspan="3">в тому, що він/вона дійсно працює (навчається) в</td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;" colspan="3">{{orgName}}</td>
    </tr>

    <tr>
        <td style="text-align: left; font-size: 11pt;" colspan="2">Форма працевлаштування</td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;" colspan="4">{{workerType}}</td>
    </tr>
    <tr>
        <td style="text-align: left; font-size: 10pt;" colspan="2"> </td>
        <td style="vertical-align: top; text-align: center; font-size: 10pt; border-top: 1px solid;" colspan="4">зазначити: основне, за сумісництвом чи інше, для студентів - платне чи безплатне навчання</td>
    </tr>

    <tr>
        <td style="text-align: left; font-size: 11pt;">займає посаду</td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;" colspan="5">{{position}}</td>
    </tr>

    <tr>
        <td style="text-align: left; font-size: 11pt;" colspan="3">Індивідуальний ідентифікаційний номер</td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;" colspan="3">{{taxCode}}</td>
    </tr>

    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; height: 30px;" colspan="6"> </td>
    </tr>


    <tr style="text-align: center; font-size: 11pt;">
        <td style="border: 1px solid;">Місяці року</td>
        <td style="border: 1px solid;" colspan="2">Кількість<br/>ставок</td>
        <td style="border: 1px solid;">Заробітна плата, що<br/>підлягає індексації,<br/>гривень</td>
        <td style="border: 1px solid;">Величина приросту<br/>індексу споживчих<br />цін, %</td>
        <td style="border: 1px solid;">Сума індексації<br/>заробітної плати,<br/>гривень</td>
    </tr>

    <!--{{#payTable}}-->
    <tr style="font-size: 11pt;">
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{periodSalary}}</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid;" colspan="2">{{#$fs}}"mtCount","decimal1"{{/$fs}}</td>
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"baseSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"koef","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/payTable}}-->
    <tr style="font-size: 11pt;">
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Всього</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;" colspan="2"></td>
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{#$fs}}"totalBaseSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;"></td>
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">{{#$fs}}"totalPaySum","decimal2"{{/$fs}}</td>
    </tr>

    <tr>
        <td style="width: 120px; height: 20px;"> </td>
        <td style="width: 50px; height: 20px;"> </td>
        <td style="width: 150px; height: 20px;"> </td>
        <td style="width: 200px;"> </td>
        <td style="width: 200px;"> </td>
        <td style="width: 200px;"> </td>

    </tr>

    <tr>
        <td style="text-align: left; font-size: 11pt;" colspan="2">Місяць підвищення доходу   </td>
        <td style="text-align: left; font-size: 11pt;">{{raiseSalary}}</td>
        <td style="text-align: left; font-size: 11pt;" colspan="3"></td>
    </tr>
    <tr>
        <td style="height: 20px;" colspan="6"> </td>
    </tr>

    <tr>
        <td style="text-align: left; font-size: 11pt;" colspan="2">Заробітна плата на </td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;" colspan="2">{{dateTo}}</td>
        <td style="text-align: center; font-size: 11pt;">становить</td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;">{{#$fs}}"planSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td style="height: 20px;" colspan="6"> </td>
    </tr>

    <tr>
        <td style="text-align: left; font-size: 11pt;" colspan="2">Головний бухгалтер </td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;" colspan="2"></td>
        <td style="text-align: center; font-size: 11pt;"></td>
        <td style="text-align: left; font-size: 11pt; border-bottom: 1px solid;">{{accountantFIO}}</td>
    </tr>
    <tr>
        <td style="text-align: center; font-size: 10pt;" colspan="2"></td>
        <td style="vertical-align: top; text-align: center; font-size: 10pt;" colspan="2">(підпис)</td>
        <td style="text-align: center; font-size: 10pt;"></td>
        <td style="vertical-align: top; text-align: center; font-size: 10pt;">(ПІБ)</td>
    </tr>
    <tr>
        <td style="height: 20px;" colspan="6"> </td>
    </tr>

    <tr>
        <td style="text-align: left; font-size: 11pt;">{{dateReport}}</td>
        <td colspan="5"></td>
    </tr>

    </tbody>
</table>