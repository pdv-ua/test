<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: 11pt; line-height: 1.1; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 35px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
    <tr>
        <td style="width: 140px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 106px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 107px; padding: 0; font-size: 1pt;">&nbsp;</td>
        <td style="width: 110px; padding: 0; font-size: 1pt;">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-size: 12pt; font-weight:bold; text-align:center;" colspan="7">Розрахунок середньоденної зарплати</td>
    </tr>
    <tr>
        <td style="padding: 0px 10px 0px 1px; font-family: TimesNewRoman; font-size: 11pt;" colspan="7">Підприємство {{orgName}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt;" colspan="7">Підрозділ {{depName}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt;" colspan="7">Таб. № {{tabNum}} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{posName}}</td>
    </tr>
    
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 13pt; font-weight:bold; text-align: center;" colspan="7">{{employeeName}}</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; " colspan="7">&nbsp;</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black;  text-align: center;">Період</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black;  text-align: center;" colspan="2">Нараховано зарплати</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black;  text-align: center; ">Річна премія</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black;  text-align: center;" colspan="2">Сума  для середньої</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black;  text-align: center;">Календарні дні</td>
    </tr>
    <!--{{#avg}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  text-align: right;">{{periodName}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  text-align: right;" colspan="2">{{#$fs}}"baseSum","decimal2"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  text-align: center;"></td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  text-align: right;" colspan="2">{{#$fs}}"opSum","decimal2"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  text-align: center;">{{#$fs}}"opDays","numberGroup"{{/$fs}}</td>
    </tr>
    <!--{{/avg}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; ">Всього</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  text-align: right;" colspan="2">{{#$fs}}"totalAvg.baseSum","decimal2"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  border-right: 1px solid; text-align: right;"></td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  border-right: 1px solid; text-align: right;" colspan="2">{{#$fs}}"totalAvg.opSum","decimal2"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;  text-align: center;">{{#$fs}}"totalAvg.opDays","numberGroup"{{/$fs}}</td>
    </tr>
    <tr>
        <td style="padding: 10px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt;  border-bottom: 1px solid; text-align: right;" >Сума для середньої&nbsp;&nbsp;&nbsp;&nbsp;</td>
        <td style="padding: 10px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt;  border-bottom: 1px solid;">{{#$fs}}"totalAvg.baseSum","decimal2"{{/$fs}}</td>
        <td style="padding: 10px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-bottom: 1px solid; text-align: right;">Кількість днів&nbsp;&nbsp;&nbsp;&nbsp;</td>
        <td style="padding: 10px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-bottom: 1px solid;">{{#$fs}}"totalAvg.opDays","numberGroup"{{/$fs}}</td>
        <td style="padding: 10px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-bottom: 1px solid; text-align: right;" colspan="2" >Середньоденна зарплата&nbsp;&nbsp;&nbsp;&nbsp;</td>
        <td style="padding: 10px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border-bottom: 1px solid;">{{#$fs}}"avgSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td style="padding: 5px 1px 0px 1px;" colspan="1"></td>
        <td style="padding: 5px 1px 0px 1px; font-family: TimesNewRoman; font-weight: bold; font-size: 11pt; border-bottom: 1px solid;" colspan="4">Середньоденна зарплата прийнята для розрахунку</td>
        <td style="padding: 5px 1px 0px 1px; font-family: TimesNewRoman; font-weight: bold; font-size: 11pt; border-bottom: 1px solid;" >{{#$fs}}"avgSum","decimal2"{{/$fs}}</td>
        <td style="padding: 5px 1px 0px 1px;" colspan="1"></td>
    </tr>
    <tr>
        <td style="padding: 10px 1px 0px 1px; font-family: TimesNewRoman; font-size: 14pt; font-weight:bold; text-align: center;" colspan="7">Розрахунок суми {{payElGenName}}</td>
    </tr>
    <tr>
        <td style="padding: 5px 1px 0px 1px; font-family: TimesNewRoman; font-size: 12pt; text-align: center;" colspan="7">{{employeeName}}</td>
    </tr>
    <tr>
        <td style="padding: 5px 1px 10px 1px; font-family: TimesNewRoman; font-size: 12pt;  text-align: center;" colspan="7">( Підрозділ {{depName}}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Таб. № {{tabNum}})</td>
    </tr>
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center;" colspan="2">Період</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center;" colspan="2">Найменування</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center; ">Кількість днів</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; font-weight:bold; border: 1px solid black; text-align: center;" colspan="2">Сума</td>
    </tr>
    <!--{{#dt}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;" colspan="2">{{description}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black;" colspan="2">{{payElName}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"period","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; border-right: 1px solid; text-align: right;" colspan="2">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/dt}}-->
    <tr>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; " colspan="4">Всього</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; text-align: center;">{{#$fs}}"totalDt.period","numberGroup"{{/$fs}}</td>
        <td style="padding: 0px 1px 0px 1px; font-family: TimesNewRoman; font-size: 11pt; border: 1px solid black; border-right: 1px solid; text-align: right;" colspan="2">{{#$fs}}"totalDt.paySum","decimal2"{{/$fs}}</td>
    </tr>
    </tbody>
</table>