<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; font-size: 14pt; table-layout: fixed; border-collapse: collapse; word-break: normal; margin: 0px 10px 0px 70px;" width="{{tableWidth}}" cellspacing="0" cellpadding="3px" border="0px">
    <tbody>
    <tr style="font-size: 1pt;">
        <td style="width: 50px; "></td>
        <td style="width: 250px; "></td>
        <td style="width: 150px; "></td>
        <td style="width: 200px; "></td>
        <td style="width: 150px; "></td>
        <td style="width: 150px; "></td>
        <!-- {{#showAddDescrPerson}} -->
            <td style="width: 200px; "></td>
        <!-- {{/showAddDescrPerson}} -->
        <td style="width: 100px; "></td>
        <td style="width: 150px; "></td>
        <td style="width: 200px; "></td>
        <!-- {{#useActualPositionName}} -->
            <td style="width: 200px; "></td>
        <!-- {{/useActualPositionName}} -->
        <td style="width: 200px; "></td>
        <td style="width: 150px; "></td>
        <td style="width: 150px; "></td>

    </tr>
    <tr>
        <td style="text-align: left; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">СПИСОК КОНТАКТІВ ПРАЦІВНИКІВ</td>
    </tr>
    <tr>
        <td style="text-align: left; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">{{organizationName}}</td>
    </tr>
    <!-- {{#departmentName}} -->
    <tr>
        <td style="text-align: left; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">{{departmentName}}</td>
    </tr>
    <!-- {{/departmentName}} -->
    <!-- {{#psCategoryName}} -->
    <tr>
        <td style="text-align: left; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">{{psCategoryName}}</td>
    </tr>
    <!-- {{/psCategoryName}} -->
    <!-- {{#workPlaceName}} -->
    <tr>
        <td style="text-align: left; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">{{workPlaceName}}</td>
    </tr>
    <!-- {{/workPlaceName}} -->
    <tr>
        <td style="width: 100%; text-align: left; font-size: 12pt;" colspan="{{colSpan}}">Станом на {{dateFrom}}</td>
    </tr>
    <tr style="font-size: 12pt;">
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">№ з/п</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Прізвище, ім'я,<br/>по батькові</td>

        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Телефони</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Адреси</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Електронні адреси</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Інші контакти</td>
        <!-- {{#showAddDescrPerson}} -->
            <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Додаткова інформація</td>
        <!-- {{/showAddDescrPerson}} -->

        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Місце роботи</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{psCategoryTitle}}</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Посада</td>
        <!-- {{#useActualPositionName}} -->
            <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Фактична посада</td>
        <!-- {{/useActualPositionName}} -->
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Підрозділ</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; ">Самостійний<br/>структурний підрозділ </td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">Організація </td>

    </tr>
    <!--{{#personTable}}-->
    <tr style="font-size: 12pt; vertical-align: top; page-break-inside: avoid;">
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{pn}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{fullFIO}}</td>

        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{&phones}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{&address}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{&email}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{&contact}}</td>
        <!-- {{#showAddDescrPerson}} -->
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{addDescrPerson}}</td>
        <!-- {{/showAddDescrPerson}} -->

        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{workPlace}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{posCategory}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{posName}}</td>
        <!-- {{#useActualPositionName}} -->
            <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{actualPositionName}}</td>
        <!-- {{/useActualPositionName}} -->
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{depName}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{structDepName}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{orgName}}</td>
    </tr>
    <!--{{/personTable}}-->
    </tbody>
</table>