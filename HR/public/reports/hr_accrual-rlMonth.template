<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size:9pt; table-layout: fixed; line-height: 1; word-wrap: break-word; border-collapse: collapse; padding: 1px; margin: 0px;" border="0px" width="760px" cellspacing="0" cellpadding="0">
    <tbody>
    <tr style="font-size:1pt;" >
        <td style="width: 175px; padding: 1px;">&nbsp;</td>
        <td style="width: 30px; padding: 1px;">&nbsp;</td>
        <td style="width: 65px; padding: 1px;">&nbsp;</td>
        <td style="width: 85px; padding: 1px;">&nbsp;</td>
        <td style="width: 50px; padding: 1px;">&nbsp;</td>
        <td style="width: 175px; padding: 1px;">&nbsp;</td>
        <td style="width: 30px; padding: 1px;">&nbsp;</td>
        <td style="width: 65px; padding: 1px;">&nbsp;</td>
        <td style="width: 85px; padding: 1px;">&nbsp;</td>
    </tr>
    <!--{{#rls}}-->
    <tr>
        <td style="font-size:10pt; text-align: center;border-width:2px 0px 0px 2px;border-color:black;border-style:solid;" colspan="5"><strong>Розрахунковий лист за &nbsp;{{periodDescription}}</strong></td>
        <td style="font-size:12pt; padding: 1px; text-align: left;border-width:2px 2px 0px 0px;border-color:black;border-style:solid;" colspan="4">{{employee}}</td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: left;border-width:0px 0px 0px 2px;border-color:black;border-style:solid;" colspan="3">Норма роб. часу {{timeSheetsPlan}}</td>
        <td style="padding: 1px; text-align: left;border-width:0px 0px 0px 0px;border-color:black;border-style:solid;" colspan="3">Підрозділ {{departmentName}}</td>
        <td style="padding: 1px; text-align: left; border-width:0px 2px 0px 0px;border-color:black;border-style:solid;" colspan="3"></td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: left;border-width:0px 0px 0px 2px;border-color:black;border-style:solid;" colspan="3">Факт роб. часу {{timeSheetsFact}}</td>
        <td style="padding: 1px; text-align: left;border-width:0px 0px 0px 0px;border-color:black;border-style:solid;" colspan="3">Посада {{position}}</td>
        <td style="padding: 1px; text-align: left; border-width:0px 2px 0px 0px;border-color:black;border-style:solid;" colspan="3"></td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: left; border-width:0px 0px 0px 2px;border-color:black;border-style:solid;" colspan="3">Пільги ПДФО {{taxLimit}}</td>
        <td style="padding: 1px; text-align: left; border-width:0px 0px 0px 0px;border-color:black;border-style:solid;" colspan="3">Місце роботи {{workPlace}}</td>
        <td style="padding: 1px; text-align: left; border-width:0px 2px 0px 0px;border-color:black;border-style:solid;" colspan="3">Оклад {{sumAccrual}}</td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: left;border-width:0px 0px 0px 2px;border-color:black;border-style:solid;" colspan="3"><strong>Борг за підприємством (борг за робітником) на початок місяця</strong></td>
        <td style="padding: 1px; text-align: right;border-width:0px 0px 0px 0px;border-color:black;border-style:solid;" colspan="2">{{orgSumFrom}}</td>
        <td style="padding: 1px; text-align: left;border-width:0px 0px 0px 0px;border-color:black;border-style:solid;" colspan="2"><strong>Борг за СС на початок місяця</strong></td>
        <td style="padding: 1px; text-align: right;border-width:0px 2px 0px 0px;border-color:black;border-style:solid;" colspan="2">{{fssuSumFrom}}</td>
    </tr>




    <tr>
        <td style="padding: 1px; text-align: center;border-width:1px 1px 1px 2px;border-color:black;border-style:solid;" colspan="5"><strong>Нарахування</strong></td>
        <td style="padding: 1px; text-align: center;border-width:1px 2px 1px 1px;border-color:black;border-style:solid;" colspan="4"><strong>Утримання</strong></td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: center;border-width:1px 1px 1px 2px;border-color:black;border-style:solid;"><strong>Вид нарахування</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black;"><strong>%</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black;"><strong>Сума</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black;"><strong>Період</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black;"><strong>Дні/год.</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black;"><strong>Вид утримання</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black;"><strong>%</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black;"><strong>Сума</strong></td>
        <td style="padding: 1px; text-align: center;border-width:1px 2px 1px 1px;border-color:black;border-style:solid;"><strong>Період</strong></td>
    </tr>
    <!--{{#payEl}}-->
    <tr>
        <!--{{#periodSalaryAcc}}-->
        <td style="padding: 1px; text-align: left;border-width:1px 1px 1px 2px;border-color:black;border-style:solid; font-weight: bold;" colspan="5">{{perSalAccName}}</td>
        <!--{{/periodSalaryAcc}}-->

        <!--{{^periodSalaryAcc}}-->
        <td style="padding: 1px; text-align: left;border-width:1px 1px 1px 2px;border-color:black;border-style:solid;">{{payElNameAcc}}</td>
        <td style="font-size: 8pt; padding: 1px; text-align: right; border: 1px solid black;">{{payRate}}</td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;">{{paySumAcc}}</td>
        <td style="font-size: 8pt; padding: 1px; text-align: center; border: 1px solid black;">{{periodAcc}}</td>
        <td style="font-size: 8pt; padding: 1px; text-align: center; border: 1px solid black;">{{daysAcc}}</td>
        <!--{{/periodSalaryAcc}}-->

        <!--{{#periodSalaryKeep}}-->
        <td style="padding: 1px; text-align: left;border-width:1px 2px 1px 1px;border-color:black;border-style:solid; font-weight: bold;" colspan="4">{{perSalKeepName}}</td>
        <!--{{/periodSalaryKeep}}-->

        <!--{{^periodSalaryKeep}}-->
        <td style="padding: 1px; text-align: left; border: 1px solid black;">{{payElNameKeep}}</td>
        <td style="font-size: 8pt; padding: 1px; text-align: right; border: 1px solid black;" >{{keepRate}}</td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;">{{paySumKeep}}</td>
        <td style="font-size: 8pt; padding: 1px; text-align: center;border-width:1px 2px 1px 1px;border-color:black;border-style:solid;">{{periodKeep}}</td>
        <!--{{/periodSalaryKeep}}-->
    </tr>
    <!--{{/payEl}}-->
    <tr>
        <td style="padding: 1px; text-align: right;border-width:1px 1px 1px 2px;border-color:black;border-style:solid;"><strong>Всього</strong></td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;"></td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;">{{paySumAccTotal}}</td>
        <td style="padding: 1px; text-align: left; border: unset;">&nbsp;</td>
        <td style="padding: 1px; text-align: left; border: unset;">&nbsp;</td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;"><strong>Всього</strong></td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;"></td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;">{{paySumKeepTotal}}</td>
        <td style="padding: 1px; text-align: left;border-width:1px 2px 1px 1px;border-color:black;border-style:solid;">&nbsp;</td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: right;border-width:1px 0px 1px 2px;border-color:black;border-style:solid;" colspan="6"><strong>Належить до виплати</strong></td>
        <td style="padding: 1px; text-align: right;border-width:1px 2px 1px 0px;border-color:black;border-style:solid;" colspan="3">{{paySumTotal}}</td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: center;border-width:1px 1px 1px 2px;border-color:black;border-style:solid;" colspan="3"><strong>Виплата</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black"><strong>Дата виплати</strong></td>
        <td style="padding: 1px; text-align: center; border: 1px solid black" colspan="2"><strong>За період</strong></td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;"></td>
        <td style="padding: 1px; text-align: center;border-width:1px 2px 1px 1px;border-color:black;border-style:solid;" colspan="2"><strong>Сума</strong></td>
    </tr>
    <!--{{#payouts}}-->
    <tr>
        <td style="padding: 1px; text-align: left;border-width:1px 1px 1px 2px;border-color:black;border-style:solid;" colspan="3">{{payoutName}}</td>
	<!--{{#showpayoutdate}}-->
        <td style="font-size: 8pt; padding: 1px; text-align: center; border: 1px solid black;">{{payoutDate}}</td>
	<!--{{/showpayoutdate}}-->
	<!--{{^showpayoutdate}}-->
        <td style="font-size: 8pt; padding: 1px; text-align: center; border: 1px solid black;"></td>
	<!--{{/showpayoutdate}}-->
        <td style="font-size: 8pt; padding: 1px; text-align: center; border: 1px solid black;" colspan="2">{{payoutPeriod}}</td>
        <td style="padding: 1px; text-align: right; border: 1px solid black;"></td>
        <td style="padding: 1px; text-align: right;border-width:1px 2px 1px 1px;border-color:black;border-style:solid;" colspan="2">{{payoutSum}}</td>
    </tr>
    <!--{{/payouts}}-->
    <tr>
        <td style="padding: 1px; text-align: right;border-width:1px 1px 1px 2px;border-color:black;border-style:solid;" colspan="6"><strong>Разом виплачено</strong></td>
        <td style="padding: 1px; text-align: right;border-width:1px 2px 1px 1px;border-color:black;border-style:solid;" colspan="3">{{payoutSumTotal}}</td>
    </tr>
    <tr>
        <td style="padding: 1px; text-align: left;border-width:1px 0px 2px 2px;border-color:black;border-style:solid;" colspan="3"><strong>Борг за підприємством (борг за робітником) на кінець місяця</strong></td>
        <td style="padding: 1px; text-align: right;border-width:1px 0px 2px 0px;border-color:black;border-style:solid;" colspan="2">{{debtFirst}}</td>
        <td style="padding: 1px; text-align: left;border-width:1px 0px 2px 0px;border-color:black;border-style:solid;" colspan="2"><strong>Борг за СС на кінець місяця</strong></td>
        <td style="padding: 1px; text-align: right;border-width:1px 2px 2px 0px;border-color:black;border-style:solid;" colspan="2">{{debtSec}}</td>
    </tr>
    <!--{{#isPageBreak}}-->
    <tr style="height: 5px;">
        <td colspan="9"><p>&nbsp;<!-- pagebreak --></p></td>
    </tr>
    <tr>
        <td style="font-size:1pt; text-align: center;" colspan="9">&nbsp;</td>
    </tr>
    <!--{{/isPageBreak}}-->

    <!--{{/rls}}-->
    </tbody>
</table>