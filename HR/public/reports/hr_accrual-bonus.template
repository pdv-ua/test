<!--%pageOrientation:landscape-->
<table style="font-family: TimesNewRoman; font-size: 11pt; word-wrap: break-word; border-collapse: collapse;" border="0" width="1163" cellspacing="0" cellpadding="0">
    <tbody>
    <tr>
        <td style="font-weight: bold; text-align: center" colspan="12">Звіт з оплати премій</td>
    </tr>
    <tr>
        <td style="font-weight: bold; text-align: center" colspan="12">&nbsp;</td>
    </tr>
    <tr style="font-weight: bold;">
        <td style="width: 418px; text-align: right;" colspan="4"></td>
        <td style="width: 190px; border-bottom: 1px solid; text-align: center; vertical-align: bottom;" colspan="4">{{period}}</td>
        <td style="width: 555px;" colspan="4"></td>
    </tr>
    <tr>
        <td style="font-weight: bold; text-align: center" colspan="12">&nbsp;</td>
    </tr>
    <tr>
        <td style="width: 418px; text-align: right" colspan="4">Найменування організації</td>
        <td style="width: 190px; border-bottom: 1px solid; text-align: center; vertical-align: bottom;" colspan="4">{{orgName}}</td>
        <td style="width: 555px;" colspan="4">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-weight: bold; text-align: center" colspan="12">&nbsp;</td>
    </tr>
    <tr style="font-weight: bold;">
        <td style="width: 418px; text-align: right" colspan="4">підрозділ</td>
        <td style="width: 190px; border-bottom: 1px solid; text-align: center; vertical-align: bottom;" colspan="4">{{department}}</td>
        <td style="width: 555px;" colspan="4">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-weight: bold; text-align: center" colspan="12">&nbsp;</td>
    </tr>
    <tr style="text-align: center; background-color: #f0f0f0; font-weight: bold">
        <td style="width: 35px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">№<br/>з/п</td>
        <td style="width: 35px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Таб.<br/>№</td>
        <td style="width: 150px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">ПІБ</td>

        <td style="width: 150px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Посада</td>

        <td style="width: 140px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Організація</td>
        <td style="width: 140px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Підрозділ</td>
        <td style="width: 90px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Обліковий період</td>

        <td style="width: 90px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Вид оплати</td>
        <td style="width: 93px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Період</td>

        <td style="width: 80px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Заробіток</td>
        <td style="width: 80px; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Відсоток</td>
        <td style="width: 80px; border: 1px solid;">Сума</td>
    </tr>
    <!--{{#depts}}-->
    <!--{{#dept}}-->
    <tr style="page-break-inside: avoid; vertical-align: top;">
        <td style="font-family: TimesNewRoman; font-weight: bold; padding-left: 15px; text-align: left; border-width: 1px; border-style: solid; page-break-inside: avoid;" colspan="12">{{&deptName}}</td>
    </tr>
    <!--{{/dept}}-->

    <!--{{#emps}}-->
    <tr style="word-break: break-word;">
        <td style="width: 35px; text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{num}}</td>
        <td style="width: 35px; text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{tabNum}}</td>
        <td style="width: 150px; border-left: 1px solid; border-bottom: 1px solid;">{{fullFIO}}</td>

        <td style="width: 150px; border-left: 1px solid; border-bottom: 1px solid;">{{posName}}</td>

        <td style="width: 140px; border-left: 1px solid; border-bottom: 1px solid;">{{orgName}}</td>
        <td style="width: 140px; border-left: 1px solid; border-bottom: 1px solid;">{{depName}}</td>
        <td style="width: 90px; border-left: 1px solid; border-bottom: 1px solid">{{oblPeriod}}</td>

        <td style="width: 90px; border-left: 1px solid; border-bottom: 1px solid;">{{payElName}}</td>
        <td style="width: 93px; border-left: 1px solid; border-bottom: 1px solid;">{{period}}</td>

        <td style="width: 80px; text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"baseSum","decimal2"{{/$fs}}</td>
        <td style="width: 80px; text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"rate","decimal2"{{/$fs}}</td>
        <td style="width: 80px; text-align: right; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/emps}}-->
    <!--{{#depSum}}-->
    <tr style="background-color: #f0f0f0; font-weight: bold; page-break-inside: avoid; vertical-align: top;">
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid;" colspan="11">{{&title}} &nbsp;</td>
        <!--{{#dsum}}-->
        <td style="text-align: right; border: 1px solid;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
        <!--{{/dsum}}-->
    </tr>
    <!--{{/depSum}}-->

    <!--{{#payElSum}}-->
    <tr style="font-weight: bold; page-break-inside: avoid; vertical-align: top;">
        <!--{{#isTitle}}-->
        <td style="text-align: left; background-color: #f0f0f0;  font-weight: bold; page-break-inside: avoid; border: 1px solid;" colspan="12">{{&title}} &nbsp;</td>
        <!--{{/isTitle}}-->
        <!--{{^isTitle}}-->
        <td style="text-align: right; border-left: 1px solid; border-bottom: 1px solid;" colspan="11">{{&title}} &nbsp;</td>
        <!--{{#dsum}}-->
        <td style="text-align: right; border: 1px solid;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
        <!--{{/dsum}}-->
        <!--{{/isTitle}}-->
    </tr>
    <!--{{/payElSum}}-->

    <!--{{/depts}}-->
    <tr style="font-weight: bold; height: 30px;">
        <td style="text-align: left;" colspan="2">Примітки &nbsp;</td>
        <td></td>
        <td colspan="2"></td>
        <td colspan="7"></td>
    </tr>
    <!--{{#notes}}-->
    <tr>
        <td style="text-align: left;" colspan="2"></td>
        <td style="text-align: left;">{{filterName}}</td>
        <td style="text-align: left;"  colspan="2">{{value}}</td>
        <td colspan="7"></td>
    </tr>
    <!--{{/notes}}-->
    </tbody>
</table>