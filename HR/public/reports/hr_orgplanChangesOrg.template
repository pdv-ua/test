<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; font-size: 14px; table-layout: fixed; line-height: 1.3; border-collapse: collapse; width: 1270px;  word-break: normal;  margin: 0px 10px 0px 70px;" border="0px" cellspacing="0" cellpadding="0px">
    <tbody>
        <tr>
            <td style="width: 70px; padding: 0;">&nbsp;</td>
            <td style="width: 120px; padding: 0;">&nbsp;</td>
            <td style="width: 250px; padding: 0;">&nbsp;</td>
            <td style="width: 80px; padding: 0;">&nbsp;</td>
            <td style="width: 230px; padding: 0;">&nbsp;</td>
            <td style="width: 230px; padding: 0;">&nbsp;</td>
            <td style="width: 90px; padding: 0;">&nbsp;</td>
            <td style="width: 90px; padding: 0;">&nbsp;</td>
            <td style="width: 110px; padding: 0;">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 14pt;" colspan="9">{{organizationName}}</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 14pt;" colspan="9">Перелік змін до штатного розпису</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 14pt;" colspan="9">за документом планування штатного розпису "{{nameStaffTable}}" від {{orderDate}}</td>
        </tr>
        <!--{{#titleOrder}}-->
        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 14pt;" colspan="9">{{titleOrder}}</td>
        </tr>
        <!--{{/titleOrder}}-->
        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 14pt;" colspan="9">&nbsp;</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" rowspan="2">№ з/п</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" rowspan="2">Тип підрозділу <br />або посада</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" rowspan="2">Назва структурного підрозділу <br />або посади</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" rowspan="2">Тип зміни</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" colspan="2">Опис зміни</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" rowspan="2">Кількість<br/>шт. од.</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" rowspan="2">Посадовий оклад (грн.)</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;" rowspan="2">Фонд заробітної плати на місяць за посадовими окладами (грн.)</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;">Старе значення</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-weight:bold; font-size: 12pt; border: 1px solid;">Нове значення</td>
        </tr>

        <tr>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">1</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">2</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">3</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">4</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">5</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">6</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">7</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">8</td>
            <td style="font-family: TimesNewRoman; padding: 0px 1px 0px 1px; text-align: center; font-size: 12pt; border: 1px solid;">9</td>
        </tr>
        <tr>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: left; border: 1px solid;" colspan="6">Всього за штатним розписом до змін:</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{#$fs}}"oldTotalQuantity","{{roundToQuantityOld}}"{{/$fs}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">&nbsp;</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{#$fs}}"oldTotalFundpay","{{roundTo}}"{{/$fs}}</td>
        </tr>

        <!--{{#data}}-->
        <tr style="font-size: 12pt;">
            <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{code}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: left; border: 1px solid;" >{{typeName}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: left; border: 1px solid;" >{{{name}}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;" >{{typeChange}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: left; border: 1px solid;">{{{oldValue}}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: left; border: 1px solid;">{{{newValue}}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{#$fs}}"quantity","{{roundToQuantity}}"{{/$fs}}</td>
            <!--{{#paymentType}}-->
                <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;" colspan="2">{{paymentType}}</td>
            <!--{{/paymentType}}-->
            <!--{{^paymentType}}-->
                <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{#$fs}}"basepay","{{roundTo}}"{{/$fs}}</td>
                <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{#$fs}}"fundpay","{{roundTo}}"{{/$fs}}</td>
            <!--{{/paymentType}}-->

        </tr>
        <!--{{/data}}-->

        <tr>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: left; border: 1px solid;" colspan="6">Всього за штатним розписом із врахуванням змін:</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{#$fs}}"totalQuantity","{{roundToQuantity}}"{{/$fs}}</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">&nbsp;</td>
            <td style="font-family: TimesNewRoman; font-size: 12pt; font-weight:bold; padding: 0px 1px 0px 1px; vertical-align: top; text-align: center; border: 1px solid;">{{#$fs}}"totalFundpay","{{roundTo}}"{{/$fs}}</td>
        </tr>

    </tbody>
</table>