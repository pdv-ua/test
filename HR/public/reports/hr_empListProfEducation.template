<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; overflow-wrap: break-word; border-collapse: collapse; width: {{tableWidth}}px;">

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 12pt; " colspan="{{colSpan}}">Список працівників за професійним навчанням</td>
  </tr>

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; " colspan="{{colSpan}}">{{organizationName}}</td>
  </tr>
    <!-- {{#departmentName}} -->
  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; " colspan="{{colSpan}}">{{departmentName}}</td>
  </tr>
    <!-- {{/departmentName}} -->
  <tr>
    <td style="font-size: 11pt; " colspan="{{colSpan}}">&nbsp;</td>
  </tr>

  <tr style="font-weight: bold; font-size: 11pt; height: 54px;">
    <td style="width: 150px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">ПІБ (Таб. №)</td>
    <td style="width: 100px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Тематика</td>
    <td style="width: 70px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Дата з</td>
    <td style="width: 70px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Дата по</td>
    <td style="width: 200px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Заклад освіти</td>
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Вид<br/>навчання</td>
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Кількість<br/>годин</td>
    <td style="width: 80px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Кредит<br/>ЄКТС</td>
    <td style="width: 100px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Категорія</td>
    <!-- {{#showAddDescrPerson}} -->
    <td style="width: 200px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Додаткова інформація</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="width: 200px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Посада</td>
    <!-- {{#useActualPositionName}} -->
    <td style="width: 200px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Фактична посада</td>
    <!-- {{/useActualPositionName}} -->
    <td style="width: 100px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Країна</td>
    <td style="width: 150px; text-align: center; font-family: TimesNewRoman; border: 1px solid;">Організація</td>
  </tr>

  <!-- {{#rows}} -->
  <tr style="font-size: 10pt; vertical-align: top; height: 18px;">
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{fullFIO}}</td>
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{dictTrainingTopicName}}</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{dateFrom}}</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{dateTo}}</td>
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{educationName}}</td>
    <td style=" text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{dictProfCompDevelopFormName}}</td>
    <td style=" text-align: right; font-family: TimesNewRoman; border: 1px solid;">{{hours}}</td>
    <td style=" text-align: right; font-family: TimesNewRoman; border: 1px solid;">{{ects}}</td>
    <td style=" text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{groupCategory}}</td>
    <!-- {{#showAddDescrPerson}} -->
    <td style=" text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{addDescrPerson}}</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style=" text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{posName}}</td>
    <!-- {{#useActualPositionName}} -->
    <td style=" text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{actualPositionName}}</td>
    <!-- {{/useActualPositionName}} -->
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{country}}</td>
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{orgName}}</td>
  </tr>
  <!-- {{/rows}} -->

</table>