<!--%pageOrientation:landscape-->
<table style="border-collapse: collapse; page-break-inside:auto; font-family: TimesNewRoman; font-size: 10pt" border="0" width="1450px" cellspacing="0" cellpadding="0">
    <tbody>
    <!--{{#report}}-->
    <tr>
        <td colspan="2">Додаток 1а</td>
        <td colspan="10" style="font-weight: bold; font-size: 11pt; text-align: center;">Інформація щодо фактично зайнатих ставок за звітний період працівників освіти</td>
        <td colspan="2"></td>
    </tr>
    <!--{{#headReport}}-->
    <tr>
        <td colspan="2">{{hrOrg}}</td>
        <td colspan="10" style="font-weight: bold; font-size: 11pt; text-align: center;">{{dictProgClassName}}</td>
        <td colspan="2"></td>
    </tr>
    <tr>
        <td colspan="2"></td>
        <td colspan="10" style="text-align: center;">за {{period}}</td>
        <td colspan="2"></td>
    </tr>
    <!--{{/headReport}}-->
    <tr>
        <td colspan="14" style="height: 20px;"></td>
    </tr>
    <!--{{#layoutYear}}-->
    <tr>
        <td colspan="2" style="border: 1px solid; text-align: center; width: 100px;">Найменування в розрізі всіх КПК</td>
        <td style="border: 1px solid; text-align: center;">на {{col1}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col2}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col3}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col4}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col5}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col6}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col7}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col8}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col9}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col10}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col11}}</td>
        <td style="border: 1px solid; text-align: center;">на {{col12}}</td>
    </tr>
    <!--{{/layoutYear}}-->
    <tr>
        <td colspan="2" style="border: 1px solid;"></td>
        <td style="border: 1px solid; text-align: center; width: 100px;">1</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">2</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">3</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">4</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">5</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">6</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">7</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">8</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">9</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">10</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">11</td>
        <td style="border: 1px solid; text-align: center; width: 100px;">12</td>
    </tr>
      <!--{{#allColSum}}-->
      <tr>
        <td colspan="2" style="border: 1px solid;">Всього</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol1}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol2}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol3}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol4}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol5}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol6}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol7}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol8}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol9}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol10}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol11}}</td>
        <td style="border: 1px solid; text-align: center;">{{sumCol12}}</td>
    </tr>
     <!--{{/allColSum}}-->
    <!--{{#ratesSum}}-->
    <tr>
        <td colspan="2" style="border: 1px solid;">{{name}}</td>
        <td style="border: 1px solid; text-align: center;">{{col1}}</td>
        <td style="border: 1px solid; text-align: center;">{{col2}}</td>
        <td style="border: 1px solid; text-align: center;">{{col3}}</td>
        <td style="border: 1px solid; text-align: center;">{{col4}}</td>
        <td style="border: 1px solid; text-align: center;">{{col5}}</td>
        <td style="border: 1px solid; text-align: center;">{{col6}}</td>
        <td style="border: 1px solid; text-align: center;">{{col7}}</td>
        <td style="border: 1px solid; text-align: center;">{{col8}}</td>
        <td style="border: 1px solid; text-align: center;">{{col9}}</td>
        <td style="border: 1px solid; text-align: center;">{{col10}}</td>
        <td style="border: 1px solid; text-align: center;">{{col11}}</td>
        <td style="border: 1px solid; text-align: center;">{{col12}}</td>
    </tr>
    <!--{{/ratesSum}}-->
    <tr>
        <td colspan="14" style="padding-top: 10px;">{{selectOrg}}</td>
    </tr>
    <!--{{/report}}-->
    </tbody>
</table>
