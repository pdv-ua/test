        <td style="text-align: center; width: 100%; font-size: 11pt;" colspan="{{permColSpan}}">{{text}}</td>
        <td style="text-align: left; width: 100%; font-size: 12pt;" colspan="{{addColSpan}}">&nbsp;</td>
    </tr>
    <!--{{/title}}-->
    <tr style="height: 10px">
        <td colspan="{{colSpan}}">&nbsp;</td>
    </tr>

    <tr>
        <td style="text-align: center; border: 1px solid black; font-weight: bold; background-color: #f0f0f0; " bgColor="#F0F0F0" rowspan="2">Таб. №</td>
