        <td style="text-align: center; border: 1px solid black; font-weight: bold; background-color: #f0f0f0; " bgColor="#F0F0F0" >Діє з</td>
        <td style="text-align: center; border: 1px solid black; font-weight: bold; background-color: #f0f0f0; " bgColor="#F0F0F0" >Діє по</td>
    </tr>

    <tr style="font-size: 10pt;">
        <!-- {{#colNums}} -->
        <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid black;">{{#$fs}}"name","numberGroup"{{/$fs}}</td>
        <!-- {{/colNums}} -->
    </tr>

    <!--{{#data}}-->
    <tr>
        <!--{{#isTitle}}-->
            <!--{{#isOrg}}-->
