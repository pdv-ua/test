<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; word-wrap: break-word; border-collapse: collapse;" border="0px" width="{{tableWidth}}px" cellspacing="0" cellpadding="3px">
    <tbody>
    <tr>
        <td style="text-align: left; width: 100%; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">Список працівників, які мають додаткові дні відпустки по причині пільг, пов'язаних з Чорнобильською катастрофою</td>
    </tr>
    <tr>
        <td style="text-align: left; width: 100%; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">{{organizationName}}</td>
    </tr>
    <!-- {{#departmentName}} -->
    <tr>
        <td style="text-align: left; width: 100%; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">{{departmentName}}</td>
    </tr>
    <!-- {{/departmentName}} -->
    <tr>
        <td style="width: 100%; text-align: right; font-size: 12pt;" colspan="{{colSpan}}">Станом на {{dateFrom}}</td>
    </tr>
    <tr style="font-size: 12pt;">
        <td style="width: 50px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">№ з/п</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Прізвище, ім'я,<br/>по батькові</td>
        <td style="width: 250px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Назва пільги</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Кількість додаткових днів<br/>відпустки (відповідних)</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Додаткові платежі</td>
        <!-- {{#showAddDescrPerson}} -->
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Додаткова інформація</td>
        <!-- {{/showAddDescrPerson}} -->
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Примітки</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Посада</td>
        <!-- {{#useActualPositionName}} -->
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Фактична посада</td>
        <!-- {{/useActualPositionName}} -->
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Підрозділ</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; ">Самостійний<br/>структурний підрозділ</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">Організація</td>

    </tr>
    <!--{{#personTable}}-->
    <tr style="font-size: 12pt;">
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{pn}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{fullFIO}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{benefitName}}</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{dayCount}}</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;"></td>
        <!-- {{#showAddDescrPerson}} -->
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{addDescrPerson}}</td>
        <!-- {{/showAddDescrPerson}} -->
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{benefitComment}}<br/>{{vacations}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{posName}}</td>
        <!-- {{#useActualPositionName}} -->
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{actualPositionName}}</td>
        <!-- {{/useActualPositionName}} -->
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{depName}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; ">{{structDepName}}</td>
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">{{orgName}}</td>
    </tr>
    <!--{{/personTable}}-->

    </tbody>
</table>