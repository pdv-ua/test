<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; word-wrap: break-word; border-collapse: collapse;" border="0px" width="950px" cellspacing="0" cellpadding="3px">
    <tbody>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt;" colspan="7">СПИСОК</td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt;" colspan="7">працівників, які мають пільги з виплат у звязку з хворобою</td>
    </tr>
    <tr>
        <td style="text-align: right; font-weight: bold; font-size: 11pt;" colspan="3">за</td>
        <td style="text-align: center;font-weight: bold; font-size: 11pt; border-bottom: 1px solid;" colspan="2">{{dateFrom}} - {{dateTo}}</td>
        <td style="text-align: left; font-weight: bold; font-size: 11pt;" colspan="2">року</td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt;" colspan="7"> </td>
    </tr>
    <tr>
        <td style="text-align: right; font-weight: bold; font-size: 11pt;" colspan="3">підрозділ</td>
        <td style="text-align: left;font-weight: bold; font-size: 11pt; border-bottom: 1px solid;" colspan="2">{{departmentName}}</td>
        <td style="text-align: left; font-weight: bold; font-size: 11pt;" colspan="2"></td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 12pt; height: 24px" colspan="7"> </td>
    </tr>
    <tr style="font-weight: bold; font-size: 11pt;">
        <td style="width: 50px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">№ з/п</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Таб.№</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">ПIБ</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Посада</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Пiльга</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Документ-підстава</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">Перiод дії</td>
    </tr>
    <!--{{#personTable}}-->
    <tr style="font-size: 10pt; page-break-inside: avoid;">
        <td style="width: 50px; text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{pn}}</td>
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{tabNum}}</td>
        <td style="width: 150px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{fullFIO}}</td>
        <td style="width: 150px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{posName}}</td>
        <td style="width: 150px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{typeSickLimit}}</td>
        <td style="width: 150px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{docNumber}}</td>
        <td style="width: 150px; text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{period}}</td>
    </tr>
    <!--{{/personTable}}-->
    </tbody>
</table>