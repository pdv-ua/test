<!--%pageOrientation:landscape-->
<table style="font-family: TimesNewRoman; font-size: 11px; table-layout: fixed; border-collapse: collapse; width: {{tableWidth}}px;  word-break: normal; margin: 0px 10px 0px 70px;"  border="0px" cellspacing="0" cellpadding="0px">
  <tr style="font-size: 10pt;">
    <td style="width: 50px;">&nbsp;</td>
    <td style="width: 150px;">&nbsp;</td>
    <td style="width: 100px;">&nbsp;</td>
    <td style="width: 100px;">&nbsp;</td>
    <td style="width: 150px;">&nbsp;</td>
    <td style="width: 100px;">&nbsp;</td>
    <td style="width: 100px;">&nbsp;</td>
    <!-- {{#showAddDescrPerson}} -->
    <td style="width: 150px;">&nbsp;</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="width: 150px;">&nbsp;</td>
    <!-- {{#useActualPositionName}} -->
        <td style="width: 150px;">&nbsp;</td>
    <!-- {{/useActualPositionName}} -->
    <td style="width: 250px;">&nbsp;</td>
    <td style="width: 150px;">&nbsp;</td>
    <td style="width: 150px;">&nbsp;</td>
  </tr>

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 12pt; " colspan="{{colSpan}}">{{title}}</td>
  </tr>

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; " colspan="{{colSpan}}">{{organizationName}}</td>
  </tr>
  <!-- {{#departmentName}} -->
  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; " colspan="{{colSpan}}">{{departmentName}}</td>
  </tr>
  <!-- {{/departmentName}} -->

  <tr>
    <td style="text-align: right; font-size: 11pt; " colspan="{{colSpan}}">Станом на {{onDate}}</td>
  </tr>

  <tr style="font-weight: bold; font-size: 11pt;">
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">№ з/п</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Прізвище, ім'я,<br/>по батькові</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Стать</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Сімейний стан</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Дитина (ПІБ)</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Вік дитини</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Дата народження дитини</td>
    <!-- {{#showAddDescrPerson}} -->
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Додаткова інформація</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Посада</td>
    <!-- {{#useActualPositionName}} -->
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Фактична посада</td>
    <!-- {{/useActualPositionName}} -->
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Підрозділ</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Самостійний<br/>структурний підрозділ</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid; height: 54px;">Організація</td>
  </tr>

  <tr style="font-size: 10pt;">
    <!-- {{#colNums}} -->
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{name}}</td>
    <!-- {{/colNums}} -->
  </tr>

  <!-- {{#rows}} -->
  <tr style="font-size: 10pt;">
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{index}}</td>
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{fullFIO}}</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{sexType}}</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{maritalStatus}}</td>
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{childName}}</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{childAge}}</td>
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{childBirthDate}}</td>
    <!-- {{#showAddDescrPerson}} -->
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{addDescrPerson}}</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{posName}}</td>
    <!-- {{#useActualPositionName}} -->
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{actualPositionName}}</td>
    <!-- {{/useActualPositionName}} -->
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{depName}}</td>
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{structDepName}}</td>
    <td style="text-align: left; font-family: TimesNewRoman; border: 1px solid;">{{orgName}}</td>
  </tr>
  <!-- {{/rows}} -->

  <tr>
    <td colspan="{{colSpan}}" style="height: 50px"></td>
  </tr>
  <tr style="font-size: 10pt;">
    <td></td>
    <td colspan="{{colSpan2}}" style="height: 20px; border-top: 1px solid; text-align: center;">(Посада)</td>
    <td></td>
    <td colspan="{{colSpan3}}" style="height: 20px; border-top: 1px solid; text-align: center;">(Прiзвище I.Б.)</td>
    <td></td>
  </tr>
</table>