<!--%pageOrientation:portrait-->
<table style="font-family: TimesNewRoman; font-size: 10pt; table-layout: fixed; border-collapse: collapse; width: 1050px; word-break: normal;" border="0px" cellspacing="0" cellpadding="0">
    <tbody>
    <tr style="height: 1px; padding: 0; margin: 0;">
        <td style="width: 15%; padding: 0;">&nbsp;</td>
        <td style="width: 15%; padding: 0;">&nbsp;</td>

        <td style="width: 15%; padding: 0;">&nbsp;</td>
        <td style="width: 15%; padding: 0;">&nbsp;</td>
        <td style="width: 15%; padding: 0;">&nbsp;</td>

        <td style="width: 25%; padding: 0;">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6">{{{orgName}}}</td>
    </tr>

    <tr>
        <td style="font-family: TimesNewRoman; font-size: 6pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 14pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="6" >Підсумки на перерахування</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 6pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >{{payElName}}</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 6pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >за {{periodSalaryM}} {{periodSalaryY}} р.</td>
    </tr>
    <!--{{#isDepName}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 6pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >{{depName}}</td>
    </tr>
    <!--{{/isDepName}}-->
    <!--{{#isFundName}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 6pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >Джерело фінансування: {{fundSourceNames}}</td>
    </tr>
    <!--{{/isFundName}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="1" >Дата:</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; border-bottom-width: 1px; border-bottom-color: black; border-bottom-style: solid;" colspan="5" >&nbsp;&nbsp;&nbsp;{{orderDate}}</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 6pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold; border: 1px solid;" colspan="2">Перерахуваня</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;" colspan="3">Отримувач</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold; border: 1px solid;">Сума</td>
    </tr>


    <!--{{#data}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; border: 1px solid;" colspan="6">{{payOutName}}</td>
    </tr>

    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid;" colspan="2">{{paymentMethod}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; word-break: break-all; text-align: left; border: 1px solid;" colspan="3">{{contractorDesc}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; border: 1px solid;">{{#$fs}}"payRollDtSum","decimal2"{{/$fs}}</td>
    </tr>

    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; font-weight: bold; border: 1px solid;" colspan="6">Обов'язкові платежі</td>
    </tr>
    <!--{{#paymentDt}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid;" colspan="2">{{payObligatoryName}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; word-break: break-all; text-align: left; border: 1px solid;" colspan="3">{{contrAccountName}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; border: 1px solid;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/paymentDt}}-->

    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Всього обов'язкових платежів по {{payOutName}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"paymentDtSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Всього до перерахунку по {{payOutName}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"blockSumToRecount","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Додаткові утримання по {{payOutName}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"dopTaxAllSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Всього по {{payOutName}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"blockSum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/data}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; font-weight: bold; border: 1px solid;" colspan="6">Всього по відомості</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: left; border: 1px solid;" colspan="5">{{paymentMethod}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; border: 1px solid;">{{#$fs}}"allPayRollDtSum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{#allPaymentDt}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center; border: 1px solid;" colspan="5">{{payObligatoryName}}</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; border: 1px solid;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/allPaymentDt}}-->
    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Всього обов'язкових платежів</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"allPaymentDtSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Всього до перерахунку</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"allSumToRecount","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Додаткові утримання</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"allDopTaxSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td colspan="5" style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; font-weight: bold; border: 1px solid; text-align: right;">Всього</td>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"allSum","decimal2"{{/$fs}}</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: 12pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="6" >&nbsp;</td>
    </tr>
    </tbody>
</table>
