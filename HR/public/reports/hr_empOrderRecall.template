<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; line-height: {{lineHeight}}; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
<tbody>
    <tr style="font-size: 1pt;">
      <td style="width: 50px; padding: 0;">&nbsp;</td>
      <td style="width: 220px; padding: 0;">&nbsp;</td>
      <td style="width: 50px; padding: 0;">&nbsp;</td>
      <td style="width: 50px; padding: 0;">&nbsp;</td>
      <td style="width: 220px; padding: 0;">&nbsp;</td>
      <td style="width: 50px; padding: 0;">&nbsp;</td>
     </tr>
    <tr style="padding: 0; margin: 0;">
        <td colspan="6" style="text-align:center;" align="center"><img  src="{{emblem}}" data-style-pdf="padding-left:{{logoPaddingLeft}}px;" alt="emblem" width="{{logoWidthPx}}" height="{{logoHeightPx}}" /></td>
    </tr>
    <!--{{#orderBlock}}-->
    <tr style="height: 15px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; {{boldOrganizationName}}" colspan="6">{{{organizationName}}}</td>
    </tr>
    <tr style="height: 48px; padding: 0; margin: 0;">
        <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <!--{{/orderBlock}}-->
    <!--{{#mainRespPos}}-->
    <tr style="height: 10px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{headFontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="6">{{{mainRespPos}}}</td>
    </tr>
    <tr style="padding: 0px; margin: 0px;">
        <td colspan="6" style="padding: 0; margin: 0;">
            <img width="{{appointmentLinesWidth}}" height="{{appointmentLinesHeight}}" data-style-pdf="padding: 0; margin: 0;"
            src="{{appointmentLinesFoto}}"/>
        </td>
    </tr>
    <tr style="height: 6px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <!--{{/mainRespPos}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{titleFontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="6">{{{orderType}}}</td>
    </tr>
    <!--Дата та номер наказу-->
    <!--{{#orderBlock}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="2">{{fromDate}}{{orderDate}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="2">{{city}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: right;" colspan="2">№ {{orderNumber}}{{orderIndex}}</td>
    </tr>
    <!--{{/orderBlock}}-->
    <!--{{#appointmentBlock}}-->
    <tr>
        <td colspan="6" style="font-family: TimesNewRoman; font-size: {{appointmentNumberFontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;">{{orderDate}}р. № {{orderNumber}}{{orderIndex}}</td>
    </tr>
    <!--{{/appointmentBlock}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left; {{titleOrderParams}}" colspan="3">{{{titleOrder}}}</td>
        <td style="padding: 0px 1px 0px 1px;" colspan="4">&nbsp;</td>
    </tr>
    <!--{{#preamble}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="6">{{{preamble}}}</td>
    </tr>
    <!--{{/preamble}}-->
    <!--{{#orderBlock}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; font-weight:bold; padding: 0px 1px 0px 1px;" colspan="6">НАКАЗУЮ: </td>
    </tr>
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <!--{{/orderBlock}}-->
    <!--{{#data}}-->
        <!--{{#orderText}}-->
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="9">{{{orderText}}}</td>
        </tr>
        <!--{{/orderText}}-->
        <!--{{#stName}}-->
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; font-weight: bold; color:blue;" colspan="9">{{{stName}}}</td>
        </tr>
        <!--{{/stName}}-->
        <!--{{#deps}}-->
            <!--{{#depName}}-->
            <tr>
                <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; font-weight: bold;" colspan="9"><em>{{{depName}}}</em></td>
            </tr>
            <!--{{/depName}}-->
            <!--{{#items}}-->
                <tr style=" padding: 0; margin: 0;">
                    <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: justify;  padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="6">{{{text}}}</td>
                </tr>
            <!--{{/items}}-->
            <!--{{#persons}}-->
                <tr style="page-break-inside:avoid; page-break-after:auto;">
                    <td style="vertical-align: top; font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; " >{{{npp}}}</td>
                    <td style="vertical-align: top; font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; " colspan="2">{{{empName}}}</td>
                    <td style="vertical-align: top; font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; " colspan="2">{{{posName}}}</td>
                    <td style="vertical-align: top; font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; " ></td>
                </tr>
            <!--{{/persons}}-->
         <!--{{/deps}}-->
    <!--{{/data}}-->
    <!--{{#tasks}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt;text-align: justify; padding: 0px 1px 0px 1px; text-indent: 34px;" colspan="6">{{{task}}}</td>
     </tr>
     <!--{{/tasks}}-->
    <!--{{#reason}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; {{indent}}" colspan="6">{{{text}}}</td>
    </tr>
    <!--{{/reason}}-->
    <!--{{#responsiblesInfo}}-->
    <tr style="height: 45px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="6">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; {{bold}} padding: 0px 25px 0px 1px; vertical-align: top;" colspan="3">{{respPos}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: {{align}}; {{bold}} padding: 0px 1px 0px 25px; vertical-align: bottom;" colspan="3">{{respFirstName}}</td>
    </tr>
    <!--{{/responsiblesInfo}}-->

    </tbody>
</table>