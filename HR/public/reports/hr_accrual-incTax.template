<!--%pageOrientation:portrait-->
<table style="font-family: TimesNewRoman; word-break: normal; font-size: 11pt; border-collapse: collapse;" border="0" width="{{tabWidth}}px" cellspacing="0" cellpadding="0">
<tbody>
<tr>
    <td style="width: 40px">&nbsp;</td>
    <td style="width: 180px"></td>
    <td style="width: 90px"></td>
    <td style="width: 90px"></td>
    <td style="width: 90px"></td>
    <!--{{#widthRates}}-->
    <td style="width: 90px"></td>
    <!--{{/widthRates}}-->
    <td style="width: 90px"></td>
    <!--{{#widthRates}}-->
    <td style="width: 90px"></td>
    <!--{{/widthRates}}-->
</tr>
<tr>
    <td style="text-align: center; font-weight: bold" colspan="{{allCols}}">{{orgName}}</td>
</tr>
<tr>
    <td style="text-align: center; font-weight: bold" colspan="{{allCols}}">Звіт про дохід, з якого вираховується ЄСВ за видами нарахувань</td>
</tr>
<tr>
    <td style="text-align: center; font-weight: bold" colspan="{{allCols}}">{{period}}</td>
</tr>
<!--{{#isDep}}-->
<tr>
    <td style="text-align: center; font-weight: bold" colspan="{{allCols}}">{{depName}}</td>
</tr>
<!--{{/isDep}}-->
<tr>
    <td colspan="{{allCols}}">&nbsp;</td>
</tr>

<tr style="background-color: #f0f0f0;">
    <td style="text-align: center; font-weight: bold; border: 1px solid;" <!--{{#isRates}}-->rowspan="2"<!--{{/isRates}}-->>№<br/>з/п</td>
    <td style="text-align: center; font-weight: bold; border: 1px solid;" <!--{{#isRates}}-->rowspan="2"<!--{{/isRates}}-->>Вид нарахування</td>
    <td style="text-align: center; font-weight: bold; border: 1px solid;" <!--{{#isRates}}-->rowspan="2"<!--{{/isRates}}-->>Нараховано</td>
    <td style="text-align: center; font-weight: bold; border: 1px solid;" <!--{{#isRates}}-->rowspan="2"<!--{{/isRates}}-->>Сума для<br/>нарахування<br/>ЄСВ<br/>(не обмежена)</td>
    <td style="text-align: center; font-weight: bold; border: 1px solid;" <!--{{#isRates}}-->rowspan="2"<!--{{/isRates}}-->>Сума, на яку нарахован ЄСВ</td>
    <!--{{#isRates}}--><td style="text-align: center; font-weight: bold; border: 1px solid;" colspan="{{rateCols}}">У тому числі</td><!--{{/isRates}}-->
    <td style="text-align: center; font-weight: bold; border: 1px solid; " <!--{{#isRates}}-->rowspan="2"<!--{{/isRates}}-->>Сума ЄСВ</td>
    <!--{{#isRates}}--><td style="text-align: center; font-weight: bold; border: 1px solid;" colspan="{{rateCols}}">У тому числі</td><!--{{/isRates}}-->
</tr>
<!--{{#isRates}}-->
<tr style="background-color: #f0f0f0;">
    <!--{{#headerRates}}-->
    <td style="text-align: center; font-weight: bold; border: 1px solid;">{{name}}</td>
    <!--{{/headerRates}}-->
    <!--{{#headerRates}}-->
    <td style="text-align: center; font-weight: bold; border: 1px solid;">{{name}}</td>
    <!--{{/headerRates}}-->
</tr>
<!--{{/isRates}}-->

<!--{{#dataAccrual}}-->
<!--{{#titleRow}}-->
<tr style="background-color: #f0f0f0;">
    <td style="text-align: left; font-weight: bold; border: 1px solid;" colspan="{{allCols}}">{{titleRow}}</td>
</tr>
<!--{{/titleRow}}-->
<!--{{#accrual}}-->
<tr>
    <td style=" border: 1px solid; text-align: center;">{{num}}</td>
    <td style=" border: 1px solid; text-align: left;">{{description}}</td>
    <td style=" border: 1px solid; text-align: right;">{{#$fs}}"accrued","decimal2"{{/$fs}}</td>
    <td style=" border: 1px solid; text-align: right;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    <td style=" border: 1px solid; text-align: right;">{{#$fs}}"sumOnESV","decimal2"{{/$fs}}</td>
    <!--{{#rateSums}}-->
    <td style=" border: 1px solid; text-align: right;">{{#$fs}}"sum","decimal2"{{/$fs}}</td>
    <!--{{/rateSums}}-->
    <td style=" border: 1px solid; text-align: right;">{{#$fs}}"sumESV","decimal2"{{/$fs}}</td>
    <!--{{#rateSums2}}-->
    <td style=" border: 1px solid; text-align: right;">{{#$fs}}"sum","decimal2"{{/$fs}}</td>
    <!--{{/rateSums2}}-->
</tr>
<!--{{/accrual}}-->
<!--{{#allSum}}-->
<tr style="background-color: #f0f0f0;">
    <td style="text-align: right; font-weight: bold; border: 1px solid;" colspan="2">Всього</td>
    <td style="text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"accrued","decimal2"{{/$fs}}</td>
    <td style="text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"paySum","decimal2"{{/$fs}}</td>
    <td style="text-align: right; font-weight: bold; border: 1px solid;">{{#$fs}}"sumOnESV","decimal2"{{/$fs}}</td>
    <!--{{#rateSumArr}}-->
    <td style="font-weight: bold;  border: 1px solid; text-align: right;">{{#$fs}}"sum","decimal2"{{/$fs}}</td>
    <!--{{/rateSumArr}}-->
    <td style="text-align: right; font-weight: bold;  border: 1px solid;">{{#$fs}}"sumESV","decimal2"{{/$fs}}</td>
    <!--{{#rateSumArr2}}-->
    <td style="font-weight: bold;  border: 1px solid; text-align: right;">{{#$fs}}"sum","decimal2"{{/$fs}}</td>
    <!--{{/rateSumArr2}}-->
</tr>
<!--{{/allSum}}-->
<!--{{/dataAccrual}}-->
</tbody>
</table>