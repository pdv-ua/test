<table style="font-family: TimesNewRoman; overflow-wrap: break-word; border-collapse: collapse; width: {{tableWidth}}px;">
  <tr style="font-size: 11pt;">
    <td style="width: 50px;">&nbsp;</td>
    <td style="width: 100px;">&nbsp;</td>
    <td style="width: 200px;">&nbsp;</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="width: 200px;">&nbsp;</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="width: 250px;">&nbsp;</td>
    <!-- {{#useActualPositionName}} -->
        <td style="width: 250px;">&nbsp;</td>
    <!-- {{/useActualPositionName}} -->
    <td style="width: 150px;">&nbsp;</td>
  </tr>

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 12pt; " colspan="{{colSpan}}">ДАТИ НАРОДЖЕННЯ ПРАЦІВНИКІВ</td>
  </tr>

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; " colspan="{{colSpan}}">{{organizationName}}</td>
  </tr>
  <!-- {{#departmentName}} -->
  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; " colspan="{{colSpan}}">{{departmentName}}</td>
  </tr>
  <!-- {{/departmentName}} -->

  <tr>
    <td style="text-align: center; font-weight: bold; font-size: 11pt; " colspan="{{colSpan}}">з {{dateFrom}} по {{dateTo}}</td>
  </tr>
  <tr>
    <td style="font-size: 12pt; " colspan="{{colSpan}}">&nbsp;</td>
  </tr>

  <tr style="font-weight: bold; font-size: 11pt;">
    <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; height: 54px;">№ з/п</td>
    <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; height: 54px;">Дата народження</td>
    <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; height: 54px;">Прізвище, ім'я, по батькові</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; height: 54px;">Додаткова інформація</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; height: 54px;">Посада</td>
    <!-- {{#useActualPositionName}} -->
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; height: 54px;">Фактична посада</td>
    <!-- {{/useActualPositionName}} -->
    <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid; height: 54px;">Організація</td>
  </tr>

  <tr style="font-size: 10pt;">
    <!-- {{#colNums}} -->
    <td style="text-align: center; font-family: TimesNewRoman; border: 1px solid;">{{name}}</td>
    <!-- {{/colNums}} -->
  </tr>

  <!-- {{#rows}} -->
  <tr style="font-size: 10pt; vertical-align: top;">
    <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{index}}</td>
    <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{birthDate}}</td>
    <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{fullFIO}}</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="text-align: justify; border-left: 1px solid; border-bottom: 1px solid;">{{addDescrPerson}}</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="text-align: justify; border-left: 1px solid; border-bottom: 1px solid;">{{posName}}</td>
    <!-- {{#useActualPositionName}} -->
        <td style="text-align: justify; border-left: 1px solid; border-bottom: 1px solid;">{{actualPositionName}}</td>
    <!-- {{/useActualPositionName}} -->
    <td style="text-align: justify; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{orgName}}</td>
  </tr>
  <!-- {{/rows}} -->

</table>