<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; border-collapse: collapse; word-break: normal;" width="{{tableWidth}}" cellspacing="0" cellpadding="3px">
    <tbody>
    <tr>
        <td style="width: 100%; text-align: center; font-size: 14pt; border: none; font-weight: bold" colspan="{{columnCount}}">Звіт</td>
    </tr>
    <tr>
        <td style="width: 100%; text-align: center; font-size: 14pt; border: none; font-weight: bold" colspan="{{columnCount}}">щодо кількості посад у штатному розписі</td>
    </tr>
    <tr>
        <td style="width: 100%; text-align: center; font-size: 14pt; border-left: none; border-top: none; border-right: none;" colspan="{{columnCount}}">{{orgName}}</td>
    </tr>
    <tr style="height: 19px;">
        <td style="width: 100%; text-align: right; font-size: 11pt; height: 19px;" colspan="{{columnCount}}">Станом на {{onDate}}</td>
    </tr>

    <tr style="text-align: center; font-size: 12pt;">
        <td style="width: 50px; border-left: 1px solid; border-top: 1px solid; border-bottom: 1px solid;">№ з/п</td>
        <td style="width: 300px; border-left: 1px solid; border-top: 1px solid; border-bottom: 1px solid;">Посада</td>
        <td style="width: 150px; border-left: 1px solid; border-top: 1px solid; border-bottom: 1px solid;">Тип посади</td>
        {{#isGroupPos}}<td style="width: 150px; border-left: 1px solid; border-top: 1px solid; border-bottom: 1px solid;">Категорія посади</td>{{/isGroupPos}}
        <td style="width: 150px; border-left: 1px solid; border-top: 1px solid; border-bottom: 1px solid;">Посадовий оклад<br/>(грн.)</td>
        <td style="width: 150px; border: 1px solid;">Кількість<br/>шт. од.</td>
    </tr>

    <tr style="text-align: center; font-size: 10pt;">
        <!--{{#colNumbers}}-->
        <td style="border: 1px solid;">{{colNum}}</td>
        <!--{{/colNumbers}}-->
    </tr>

    <!--{{#pos}}-->
    <tr style="font-size: 12pt;">
        <td style="width: 50px; text-align: center; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"indexNum","numberGroup"{{/$fs}}</td>
        <td style="width: 300px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{posName}}</td>
        <td style="width: 150px; text-align: left; border-left: 1px solid; border-bottom: 1px solid;">{{posType}}</td>
        {{#isGroupPos}}<td style="border-left: 1px solid; border-top: 1px solid; border-bottom: 1px solid;">{{psCategory}}</td>{{/isGroupPos}}
        <td style="width: 150px; text-align: right; border-left: 1px solid; border-bottom: 1px solid;">{{#$fs}}"basepay","{{roundTo}}"{{/$fs}}</td>
        <td style="idth: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-right: 1px solid;">{{#$fs}}"quantity","{{roundToQuantity}}"{{/$fs}}</td>
    </tr>
    <!--{{/pos}}-->
    </tbody>
</table>