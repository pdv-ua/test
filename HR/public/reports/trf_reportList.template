<!--%pageOrientation:portrait-->
<div style="display: flex;">
    <table style="border-collapse: collapse; height: 100%; font-family: TimesNewRoman; font-size: 7pt;" border="0" width="350px" cellspacing="0" cellpadding="0">
        <tbody>
        <!--{{#pages}}-->
        <!--{{#leftTable}}-->
        <!--{{#setRenderHeadBlock}}-->
        <tr>
            <td colspan="12" style="text-align: left; font-size: 9pt;">{{hrOrg}}</td>
            <td colspan="2" style="text-align: right;">{{issueDate}}</td>
        </tr>
        <tr>
            <td colspan="14" style="font-weight: bold; font-size: 10pt;">{{fullFIO}}</td>
        </tr>
        <!--{{/setRenderHeadBlock}}-->
        <tr>
            <td colspan="2" style="border-top: 1px solid; font-weight: bold; border-bottom: 1px solid;">Таб № </td>
            <td style="border-top: 1px solid; font-weight: bold; border-bottom: 1px solid;">{{tabNum}}</td>
            <td colspan="2" style="border-top: 1px solid;">Посада</td>
            <td colspan="5" style="border-top: 1px solid; font-weight: bold; text-align: left;">{{name}}</td>
            <td colspan="2" style="border-top: 1px solid; text-align: right;">Категорія</td>
            <td colspan="2" style="border-top: 1px solid;">{{dictQualificationName}}</td>
        </tr>
        <tr>
            <td colspan="3" style="border-bottom: 1px solid; font-size: 6pt; font-weight: bold;">{{dateFrom}}</td>
            <td colspan="1" >Предмет</td>
            <td colspan="6" style="text-align: left; font-weight: bold;">{{subjectName}}</td>
            <td colspan="4"></td>
        </tr>
        <tr>
            <td colspan="1" >Освіта</td>
            <td colspan="6" style="font-weight: bold;">{{dictEducationLevel}}</td>
            <td colspan="5" style="text-align: right;">Тарифний розряд</td>
            <td colspan="2" style="font-weight: bold;">{{dictTarifCoeff}}</td>
        </tr>
        <tr>
            <td colspan="1" >Стаж</td>
            <td colspan="6" style="font-weight: bold;">{{experience}}</td>
            <td colspan="5" style="text-align: right;">Ставка</td>
            <td colspan="2" style="font-weight: bold; text-align: right;">{{#$fs}}"accrualSum1","decimal2"{{/$fs}}</td>
        </tr>
        <tr>
            <td style="border-bottom: 1px dotted;">Звання</td>
            <td colspan="6" style="border-bottom: 1px dotted; font-weight: bold;">{{educationRank}}</td>
            <td colspan="5" style="border-bottom: 1px dotted; text-align: right;">Кількість ставок</td>
            <td colspan="2" style="border-bottom: 1px dotted; font-weight: bold; text-align: left;">{{#$fs}}"rate","decimal4"{{/$fs}}</td>
        </tr>
        <!--{{#accrualAlt}}-->
        <tr>
            <td colspan="12" style="padding-left: 10px; text-align: left;">{{rise}}</td>
            <td colspan="1" style="text-align: right;">{{rate}}</td>
            <td colspan="1" style="font-weight: bold; text-align: right;">{{#$fs}}"riseSum","decimal2"{{/$fs}}</td>
        </tr>
        <!--{{/accrualAlt}}-->
        <tr>
            <td colspan="1" style="border-top: 1px dotted; border-bottom: 1px dotted;"></td>
            <td colspan="11" style="border-top: 1px dotted; border-bottom: 1px dotted; text-align: left;">Ставка для розрахунку навантаження</td>
            <td colspan="2" style="font-weight: bold; border-top: 1px dotted; border-bottom: 1px dotted; text-align: right;">{{#$fs}}"accrualSum3","decimal2"{{/$fs}}</td>
        </tr>
        <!--{{#overpayPosition}}-->
        <tr>
            <td colspan="12" style="padding-left: 10px;">{{name}}</td>
            <td style="text-align: right;">{{rate}}</td>
            <td colspan="1" style="text-align: right;">{{#$fs}}"accrualSum","decimal2"{{/$fs}}</td>
        </tr>
        <!--{{/overpayPosition}}-->
        <tr>
            <td colspan="12" style="padding-left: 40px; font-weight: bold; padding-top: 5px;">Разом</td>
            <td colspan="2" style="text-align: right; padding-top: 5px;">{{#$fs}}"allAccrualSum","decimal2"{{/$fs}}</td>
        </tr>
        <!--{{#setRenderBottomBlock}}-->
        <tr>
            <td colspan="12" style="font-weight: bold; border-bottom: 1px solid; padding-top: 5px;">Всього по працівнику</td>
            <td colspan="2" style="font-weight: bold; border-bottom: 1px solid; padding-top: 5px; text-align: right;">{{#$fs}}"allAccrual","decimal2"{{/$fs}}</td>
        </tr>
        <tr>
            <td colspan="14" style="border-top: 4px double;"></td>
        </tr>
        <tr>
            <td colspan="14" style="height: 10px;"></td>
        </tr>
        <!--{{/setRenderBottomBlock}}-->
        <!--{{#isPageBreak}}--> 
            <tr> 
                <td colspan="14"><p>&nbsp;<!-- pagebreak --></p></td>
            </tr>
        <!--{{/isPageBreak}}-->
        <!--{{/leftTable}}-->
        <!--{{/pages}}-->
        </tbody>
    </table>
    <table style="border-collapse: collapse; font-family: TimesNewRoman; font-size: 7pt; margin-left: 10px; height: 100%;" border="0" width="350px" cellspacing="0" cellpadding="0">
        <tbody>
        <!--{{#pages}}-->
        <!--{{#rightTable}}-->
        <!--{{#setRenderHeadBlock}}-->
