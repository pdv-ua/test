<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; word-wrap: break-word; border-collapse: collapse;" border="0px" width="{{tableWidth}}px" cellspacing="0" cellpadding="3px">
  <tbody>
    <tr>
      <td style="text-align: left; width: 100%; font-weight: bold; font-size: 12pt;" colspan="{{colSpan}}">
        <!--{{ #regionName }}-->
        Список працівників, які постраждали внаслідок Чорнобильської катастрофи на поточний день. {{regionName}}
        <!--{{ /regionName }}-->

        <!--{{ ^regionName }}-->
        Список працівників, які постраждали внаслідок Чорнобильської катастрофи
        <!--{{ /regionName }}-->
      </td>
    </tr>

    <tr>
      <td style="text-align: left; width: 100%; font-weight: bold; font-size: 11pt;" colspan="{{colSpan}}">{{organizationName}}</td>
    </tr>
    <!-- {{#departmentName}} -->
    <tr>
      <td style="text-align: left; width: 100%; font-weight: bold; font-size: 11pt;" colspan="{{colSpan}}">{{departmentName}}</td>
    </tr>
    <!-- {{/departmentName}} -->

    <tr>
      <td style="width: 100%; text-align: right; font-size: 11pt;" colspan="{{colSpan}}">Станом на {{onDate}}</td>
    </tr>

    <tr style="font-weight: bold; font-size: 11pt;">
      <td style="width: 50px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">№ з/п</td>
      <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Прізвище, ім'я,<br/>по батькові</td>
      <td style="width: 100px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Назва пільги</td>
      <td style="width: 300px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Адреса реєстрацїі</td>
      <!-- {{#showAddDescrPerson}} -->
      <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Додаткова інформація</td>
      <!-- {{/showAddDescrPerson}} -->
      <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Примітки</td>
      <td style="width: 100px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Посада</td>
      <!-- {{#useActualPositionName}} -->
      <td style="width: 200px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Фактична посада</td>
      <!-- {{/useActualPositionName}} -->
      <td style="width: 200px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Підрозділ</td>
      <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Самостійний<br/>структурний підрозділ</td>
      <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Організація</td>
      <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">Вид документу</td>
    </tr>

    <!--{{#rows}}-->
    <tr style="font-size: 10pt;">
      <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{index}}</td>
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{lastName}} {{firstName}} {{middleName}}</td>
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{benName}}</td>
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{regAddress}}</td>
      <!-- {{#showAddDescrPerson}} -->
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{addDescrPerson}}</td>
      <!-- {{/showAddDescrPerson}} -->
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{benComment}}</td>
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{posName}}</td>
      <!-- {{#useActualPositionName}} -->
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{actualPositionName}}</td>
      <!-- {{/useActualPositionName}} -->
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{depName}}</td>
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{structDepName}}</td>
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">{{orgName}}</td>
      <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">{{empDocs}}</td>
    </tr>
    <!--{{/rows}}-->
  </tbody>
</table>