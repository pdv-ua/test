<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: 9pt; table-layout: fixed; border-collapse: collapse; word-break: normal; margin: 0px 10px 0px 70px;" width="{{sheetWidth}}px"  cellspacing="0" cellpadding="3px">
<tbody>
    <tr style="font-size: 1pt;">
        <td style="width: 100px; ">&nbsp;</td>
        <td style="width: 440px; ">&nbsp;</td>
        <!--{{#showQuantity}}-->
        <td style="width: 100px; ">&nbsp;</td>
        <!--{{/showQuantity}}-->
    </tr>
    <tr style="height: 48px;">
        <td style="vertical-align: bottom; text-align: center; font-size: 14pt; border: none;" colspan="{{colSpan}}"><b>СТРУКТУРА ТА ЧИСЕЛЬНІСТЬ</b></td>
    </tr>
    <tr>
        <td style="text-align: center; font-size: 14pt; border: none;" colspan="{{colSpan}}"><b>апарату {{organizationName}}</b></td>
    </tr>
    <tr>
        <td style="text-align: center; font-size: 12pt; border-left: none; border-top: none; border-right: none;" colspan="{{colSpan}}">Станом на {{onDate}}</td>
    </tr>
    <tr style="text-align: center; font-size: 12pt; word-break: normal;">
        <td style="border: 1px solid;">№ з/п</td>
        <td style="border: 1px solid;">Назва структурного підрозділу та посад</td>
        <!--{{#showQuantity}}-->
        <td style="border: 1px solid;">Фактична чисельність</td>
        <!--{{/showQuantity}}-->
    </tr>
    <tr style="text-align: center; font-size: 10pt;">
        <td style="border: 1px solid;">1</td>
        <td style="border: 1px solid;">2</td>
        <!--{{#showQuantity}}-->
        <td style="border: 1px solid;">3</td>
        <!--{{/showQuantity}}-->
    </tr>

    <!--{{#data}}-->
    <!--{{#isTotal}}-->
    <tr style="font-size: 12pt; font-weight: bold;">
        <td style="text-align: center; border: 1px solid;"></td>
        <td style="text-align: left; border: 1px solid;">{{name}}</td>
        <!--{{#showQuantity}}-->
        <td style="text-align: center; border: 1px solid;">{{#$fs}}"quantityFact","{{roundToQuantity}}"{{/$fs}}</td>
        <!--{{/showQuantity}}-->
    </tr>
    <!--{{/isTotal}}-->
    <!--{{^isTotal}}-->
    <tr style="font-size: 12pt;">
        <td style="text-align: center; border: 1px solid;">{{indexNum}}</td>
        <td style="text-align: left; border: 1px solid;">{{{name}}}</td>
        <!--{{#showQuantity}}-->
        <td style="text-align: center; border: 1px solid;">{{#$fs}}"quantityFact","{{roundToQuantity}}"{{/$fs}}</td>
        <!--{{/showQuantity}}-->
    </tr>
    <!--{{/isTotal}}-->
    <!--{{/data}}-->
</tbody>
</table>