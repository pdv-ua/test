<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; word-wrap: break-word; border-collapse: collapse;" width="{{tableWidth}}px" cellspacing="0" cellpadding="3px">
    <tbody>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 14pt;" colspan="5">ФІКСОВАНІ ДНІ ВІДПУСТКИ</td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 14pt;" colspan="5">на {{onDate}}</td>
    </tr>
    <!-- {{#organizationName}} -->
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; font-size: 14pt;" colspan="5">{{organizationName}}</td>
    </tr>
    <!-- {{/organizationName}} -->
    <tr style="font-size: 12pt; font-weight: bold;">
        <td style="width: 150px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Працівник</td>
        <td style="width: 130px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Посада</td>
        <td style="width: 170px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Вид відпустки</td>
        <td style="width: 30px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">Фіксовані дні відпустки</td>
        <td style="width: 100px; text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">Періоди</td>
    </tr>
    <!--{{#data}}-->
        <!--{{#isDepartment}}-->
            <tr style="font-size: 10pt; vertical-align: middle;">
                <td style="text-align: {{textAlign}}; border: 1px solid; font-weight: bold; border-color: black; {{style}}" colspan="2">{{name}}</td>
                <td style="border: 1px solid; font-weight: bold;" colspan="1"></td>
                <td style="text-align: center; border: 1px solid; font-weight: bold; border-color: black;{{style}}" colspan="1">{{#$fs}}"quantityInDep","numberGroup"{{/$fs}}</td>
                <td style="border: 1px solid; font-weight: bold;" colspan="1"></td>
            </tr>
        <!--{{/isDepartment}}-->
        <!--{{^isDepartment}}-->
            <tr style="font-size: 10pt; vertical-align: middle;">
                <td style="font-family: TimesNewRoman; text-align: left; border: 1px solid;">{{empName}}</td>
                <td style="font-family: TimesNewRoman; text-align: center; border: 1px solid;">{{posName}}</td>
                <td style="font-family: TimesNewRoman; text-align: center; border: 1px solid;">{{dictVacationKindIDName}}</td>
                <td style="font-family: TimesNewRoman; text-align: center; border: 1px solid;">{{#$fs}}"dayFix","numberGroup"{{/$fs}}</td>
                <td style="font-family: TimesNewRoman; text-align: center; border: 1px solid;">{{description}}</td>
            </tr>
        <!--{{/isDepartment}}-->
    <!--{{/data}}-->
    <!--{{#orgResults}}-->
    <tr style="font-size: 10pt;">
        <td style="text-align: left; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; font-weight: bold;">Всього по {{depName}}</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">&nbsp;</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid;">&nbsp;</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; font-weight: bold;">{{#$fs}}"quantity","numberGroup"{{/$fs}}</td>
        <td style="text-align: center; border-left: 1px solid; border-bottom: 1px solid; border-top: 1px solid; border-right: 1px solid;">&nbsp;</td>
    </tr>
    <!--{{/orgResults}}-->
    </tbody>
</table>