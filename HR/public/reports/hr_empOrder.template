<!--%pageOrientation:portrait-->
<table style="font-family: TimesNewRoman; font-size: 10pt; table-layout: fixed; line-height: 1.3; border-collapse: collapse; width: 750px;  word-break: normal;" border="0px" >
    <tbody>
    <tr>
        <td colspan="13" style="border-style: hidden;"></td>
        <td colspan="17" style="border-style: hidden;"><img style="display: block;" src="data:image/jpeg;base64," alt="emblem" width="97" height="123"/></td>

    </tr>
    <tr style="height: 60px;">
        <td style="border-style: hidden; font-size: 14pt; text-align: center; font-family: TimesNewRoman;" colspan="30">{{{organizationName}}}</td>
    </tr>
    <tr style="height: 30px;">
        <td style=" border-style: hidden; font-size: 14pt; text-align: center; font-size: 14pt; vertical-align: top; font-family: TimesNewRoman;" colspan="30"><b>Н А К А З</b></td>
    </tr>
    <tr style="height: 30px;">
        <td style="border-style: hidden; text-align: center; font-size: 14pt; vertical-align: top; font-family: TimesNewRoman;" colspan="30">{{city}}</td>
    </tr>
    <!--Дата та номер наказу-->
    <tr style="height: 60px;">
        <td colspan="10" style="font-family: TimesNewRoman; font-size: 14pt; text-align: left;  height: 18px;">{{fromDate}}{{orderDate}}</td>
        <td colspan="10" style="font-family: TimesNewRoman; font-size: 14pt; text-align: center; height: 18px;">{{city}}</td>
        <td colspan="10" style="font-family: TimesNewRoman; font-size: 14pt; height: 18px;text-align: right">№ {{orderNumber}}&nbsp;{{orderIndex}}</td>
    </tr>

    <tr style="height: 30px;">
        <td colspan="15" style="text-align: justify; font-family: TimesNewRoman; font-weight:bold; font-size: 14pt; height: auto;">{{{titleOrder}}}<br/>{{titleName}}</td>
        <td colspan="15"></td>
    </tr>
    <tr style="height: 60px">
        <td colspan="30" style="font-family: TimesNewRoman; text-align: justify; font-size: 14pt; text-indent: 65px;">{{{preamble}}}</td>
    </tr>
    <tr style="height: 30px">
        <td colspan="30" style="text-align: left; font-family: TimesNewRoman; font-size: 14pt;"><B>НАКАЗУЮ: </B></td>
    </tr>
    <!--{{#detail}}-->
    <tr style="height: 30px">
        <td ccolspan="30" style="font-family: TimesNewRoman; text-align: justify; font-size: 14pt; text-indent: 65px;">
            {{itemIdx}}.&nbsp;Відрядити <B>{{lastName}} {{tailName}}</B> до {{cityName}} {{destOrganizationName}} на {{dayCount}} календарних днів з {{dayFrom}} до {{dayTo}}, з метою {{purpose}}
        </td>
    </tr>
    <!--{{/detail}}-->
    <!--{{#task}}-->
    <tr style="height: 30px">
        <td style="text-align: justify; font-family: TimesNewRoman; font-size: 12pt; text-indent: 65px;">
            {{itemIdx}}.&nbsp; {{task}}
        </td>
    </tr>
    <!--{{/task}}-->
    <!--{{#orderReason}}-->
    <tr style="height: 30px">
        <td ccolspan="30" style="font-family: TimesNewRoman; text-align: left; font-size: 14pt;">
           {{reason}}
        </td>
    </tr>
    <!--{{/orderReason}}-->
    <tr style="height: 30px">
        <td ccolspan="15" style="font-family: TimesNewRoman; font-size: 14pt; text-align: left;"><b>{{respPos}}</b></td>
        <td ccolspan="15" style="font-family: TimesNewRoman; font-size: 14pt; text-align: right;"><b>{{respFirstName}}</b></td>
    </tr>
    </tbody>
</table>