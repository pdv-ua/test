<!--%pageOrientation:landscape-->

<table style="font-family: Arial; word-wrap: break-word; font-size: 11pt; border-collapse: collapse;" border="0px" width="1050" cellspacing="0" cellpadding="3px">
    <tbody>
    <tr style="height: 1px;">
        <td style="width: 150px;">&nbsp;</td>
        <td style="width: 150px;">&nbsp;</td>
        <td style="width: 150px;">&nbsp;</td>
        <td style="width: 150px;">&nbsp;</td>
        <td style="width: 150px;">&nbsp;</td>
        <td style="width: 150px;">&nbsp;</td>
        <td style="width: 150px;">&nbsp;</td>
    </tr>
    <tr>
        <td style="text-align: right; font-size: 11pt;">Організація</td>
        <td style="text-align: center; font-size: 11pt; border-bottom: 1px solid;" colspan="6">{{orgName}}</td>
    </tr>
    <tr>
        <td style="text-align: center;" colspan="7"> </td>
    </tr>
    <tr>
        <td style="text-align: right; font-size: 11pt;">&nbsp;</td>
        <td style="text-align: center; font-weight: bold; font-size: 12pt;" colspan="6">{{reportName}}</td>
    </tr>
    <tr>
        <td style="text-align: center;" colspan="7"> </td>
    </tr>
    <tr>
        <td style="text-align: right; font-size: 11pt;">за</td>
        <td style="text-align: center; font-size: 11pt; border-bottom: 1px solid;" colspan="6">{{periodName}}</td>
    </tr>
    <tr>
        <td style="text-align: right; font-size: 11pt;">підрозділ</td>
        <td style="text-align: center; font-size: 11pt; border-bottom: 1px solid;" colspan="6">{{depName}}</td>
    </tr>
    <tr>
        <td style="text-align: center; width: 100%; font-weight: bold; height: 30px;" colspan="7"> </td>
    </tr>
    <tr style="text-align: center; background-color: #f0f0f0; font-weight: bold">
        <td style="border: 1px solid;">Розрахунковий період</td>
        <td style="border: 1px solid;">Відсоток</td>
        <td style="border: 1px solid;">Нарахована сума</td>
        <td style="border: 1px solid;">Додаткова база нарахування</td>
        <td style="border: 1px solid;">Перевищення максимальної бази</td>
        <td style="border: 1px solid;">Сума, на яку нараховано ЄСВ</td>
        <td style="border: 1px solid;">ЄСВ на загальну базу оподаткування</td>
    </tr>
    <!--{{#data}}-->
    <tr>
        <td style="text-align: center; border: 1px solid;">{{periodCalc}}</td>
        <td style="text-align: right; border: 1px solid black;">{{#$fs}}"rate","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid black;">{{#$fs}}"sourceSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid black;">{{#$fs}}"addMinSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid black;">{{#$fs}}"excMaxBaseSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid black;">{{#$fs}}"baseSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid black;">{{#$fs}}"calcSum","decimal2"{{/$fs}}</td>
    </tr>
    <!--{{/data}}-->
    <tr style="background-color: #f0f0f0; font-weight: bold; page-break-inside: avoid;">
        <td style="border: 1px solid;">&nbsp;</td>
        <td style="border: 1px solid;">&nbsp;</td>
        <td style="text-align: right; border: 1px solid;">{{#$fs}}"totalSourceSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid;">{{#$fs}}"totalAddMinSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid;">{{#$fs}}"totalExcMaxBaseSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid;">{{#$fs}}"totalBaseSum","decimal2"{{/$fs}}</td>
        <td style="text-align: right; border: 1px solid;">{{#$fs}}"totalSum","decimal2"{{/$fs}}</td>
    </tr>
    </tbody>
</table>