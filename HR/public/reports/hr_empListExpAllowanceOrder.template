<!--%pageOrientation:landscape-->

<table style="font-family: TimesNewRoman; font-size: 14px; table-layout: fixed; line-height: 1.3; border-collapse: collapse; width: {{tableWidth}}px;  word-break: normal;  margin: 0px 10px 0px 70px;" border="0px" cellspacing="0" cellpadding="0px">
  <tr>
    <td style="width: 20px;">&nbsp;</td>
    <td style="width: 50px;">&nbsp;</td>
    <td style="width: 200px;">&nbsp;</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="width: 200px;">&nbsp;</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="width: 150px;">&nbsp;</td>
    <td style="width: 100px;">&nbsp;</td>
    <td style="width: 150px;">&nbsp;</td>
    <td style="width: 200px;">&nbsp;</td>
    <td style="width: 250px;">&nbsp;</td>
    <td style="width: 250px;">&nbsp;</td>
    <!-- {{#useActualPositionName}} -->
       <td style="width: 250px;">&nbsp;</td>
    <!-- {{/useActualPositionName}} -->
    <td style="width: 150px;">&nbsp;</td>
  </tr>

  <tr>
    <td style="font-family: TimesNewRoman; text-align: center; font-weight: bold; font-size: 14pt;" colspan="{{colSpan}}">Список осіб щодо встановлення надбавки за вислугу років за період {{dateFrom}} - {{dateTo}}</td>
  </tr>

  <tr>
    <td style="font-family: TimesNewRoman; text-align: center; font-weight: bold; font-size: 14pt; " colspan="{{colSpan}}">{{organizationName}}</td>
  </tr>
  <!--{{#departmentName}}-->
  <tr>
    <td style="font-family: TimesNewRoman; text-align: center; font-weight: bold; font-size: 14pt; " colspan="{{colSpan}}">{{departmentName}}</td>
  </tr>
  <!--{{/departmentName}}-->

  <tr>
    <td style="font-family: TimesNewRoman; text-align: right; font-size: 14pt;" colspan="{{colSpan}}">cтаном на {{onDate}}</td>
  </tr>

  <tr>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;"> </td>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">№ з/п</td>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Прізвище, ім'я,<br/>по батькові</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Додаткова інформація</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Вислуга (в<br/>роках)</td>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Надбавка %</td>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Дата встановлення</td>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Посада</td>
    <!-- {{#useActualPositionName}} -->
        <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Фактична посада</td>
    <!-- {{/useActualPositionName}} -->
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Підрозділ</td>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Самостійний<br/>структурний підрозділ</td>
    <td style="font-family: TimesNewRoman; font-weight: bold; font-size: 14pt; text-align: center; border: 1px solid;">Організація</td>
  </tr>

  <!-- {{#emps}} -->
  <tr>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: center; border: 1px solid;">{{checked}}</td>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: center; border: 1px solid;">{{num}}</td>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: left; border: 1px solid;">{{fullFIO}} ({{tabNum}})</td>
    <!-- {{#showAddDescrPerson}} -->
        <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: center; border: 1px solid;">{{addDescrPerson}}</td>
    <!-- {{/showAddDescrPerson}} -->
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: center; border: 1px solid;">{{stageYear}}</td>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: center; border: 1px solid;">{{rate}}</td>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: center; border: 1px solid;">{{setDate}}</td>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: left; border: 1px solid;">{{posName}}</td>
    <!-- {{#useActualPositionName}} -->
        <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: left; border: 1px solid;">{{actualPositionName}}</td>
    <!-- {{/useActualPositionName}} -->
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: left; border: 1px solid;">{{depName}}</td>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: left; border: 1px solid;">{{structDepName}}</td>
    <td style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: top; page-break-inside: avoid; text-align: left; border: 1px solid;">{{orgName}}</td>
  </tr>
  <!-- {{/emps}} -->

  <tr>
    <td colspan="{{colSpan}}" style="height: 50px">&nbsp;</td>
  </tr>
  <tr>
    <td>&nbsp;</td>
    <td colspan="{{colSpan2}}" style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: bottom; text-align: center;">{{respPosName}}</td>
    <td>&nbsp;</td>
    <td colspan="{{colSpan3}}" style="font-family: TimesNewRoman; font-size: 14pt; vertical-align: bottom; text-align: center;">{{respName}}</td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>&nbsp;</td>
    <td colspan="{{colSpan2}}" style="font-family: TimesNewRoman; height: 20px; font-size: 12pt; border-top: 1px solid; text-align: center;">(Посада)</td>
    <td>&nbsp;</td>
    <td colspan="{{colSpan3}}" style="font-family: TimesNewRoman; height: 20px; font-size: 12pt; border-top: 1px solid; text-align: center;">(Прiзвище I.Б.)</td>
    <td>&nbsp;</td>
  </tr>
</table>