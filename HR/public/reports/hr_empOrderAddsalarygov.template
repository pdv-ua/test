<!--%pageOrientation:portrait-->

<table style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; line-height: {{lineHeight}}; table-layout: fixed; border-collapse: collapse; word-break: normal; padding: 0px; margin: 0px 10px 0px 70px;" border="0px" width="640px" cellspacing="0" cellpadding="0px">
    <tbody>
    <tr>
        <td style="width: 50px; padding: 0;">&nbsp;</td>
        <td style="width: 140px; padding: 0;">&nbsp;</td>
        <td style="width: 40px; padding: 0;">&nbsp;</td>
        <td style="width: 55px; padding: 0;">&nbsp;</td>
        <td style="width: 70px; padding: 0px 1px 0px 1px; text-align: center;">&nbsp;</td>
        <td style="width: 55px; padding: 0;">&nbsp;</td>
        <td style="width: 50px; padding: 0;">&nbsp;</td>
        <td style="width: 95px; padding: 0;">&nbsp;</td>
        <td style="width: 90px; padding: 0;">&nbsp;</td>
    </tr>
    <tr style="padding: 0; margin: 0;">
        <td colspan="9" style="text-align:center;" align="center"><img  src="{{emblem}}" data-style-pdf="padding-left:{{logoPaddingLeft}}px;" alt="emblem" width="{{logoWidthPx}}" height="{{logoHeightPx}}" /></td>
    </tr>
    <!--{{#orderBlock}}-->
    <tr style="height: 15px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; {{boldOrganizationName}}" colspan="9">{{{organizationName}}}</td>
    </tr>
    <tr style="height: 48px; padding: 0; margin: 0;">
        <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <!--{{/orderBlock}}-->
    <!--{{#mainRespPos}}-->
    <tr style="height: 10px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{headFontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="9">{{{mainRespPos}}}</td>
    </tr>
    <tr style="padding: 0px; margin: 0px;">
        <td colspan="9" style="padding: 0; margin: 0;">
            <img width="{{appointmentLinesWidth}}" height="{{appointmentLinesHeight}}" data-style-pdf="padding: 0; margin: 0;"
            src="{{appointmentLinesFoto}}"/>
        </td>
    </tr>
    <tr style="height: 6px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <!--{{/mainRespPos}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{titleFontSize}}pt; padding: 0px 1px 0px 1px; text-align: center; font-weight: bold;" colspan="9">{{{orderType}}}</td>
    </tr>
    <!--Дата та номер наказу-->
    <!--{{#orderBlock}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="3">{{fromDate}}{{orderDate}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: center;" colspan="3">{{city}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: right;" colspan="3">№ {{orderNumber}}{{orderIndex}}</td>
    </tr>
    <!--{{/orderBlock}}-->
    <!--{{#appointmentBlock}}-->
    <tr>
        <td colspan="9" style="font-family: TimesNewRoman; font-size: {{appointmentNumberFontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;">{{orderDate}}р. № {{orderNumber}}{{orderIndex}}</td>
    </tr>
    <!--{{/appointmentBlock}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left; {{titleOrderParams}}" colspan="4">{{{titleOrder}}}</td>
        <td style="padding: 0px 1px 0px 1px;" colspan="5">&nbsp;</td>
    </tr>
    <!--{{#preamble}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style=" padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="9">{{{preamble}}}</td>
    </tr>
    <!--{{/preamble}}-->
    <!--{{#orderBlock}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: left;" colspan="9"><strong>НАКАЗУЮ: </strong></td>
    </tr>
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <!--{{/orderBlock}}-->
    <!--{{#detail}}-->

        <!--{{#text}}-->
        <tr>
            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="9">{{{text}}}</td>
        </tr>
        <!--{{/text}}-->

        <!--{{#stDeps}}-->
            <!--{{#stName}}-->
            <tr>
                <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; font-weight: bold; color:blue; {{indent}}" colspan="9">{{{stName}}}</td>
            </tr>
            <!--{{/stName}}-->
            <!--{{#deps}}-->
                <!--{{#depName}}-->
                <tr>
                    <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; font-weight: bold;" colspan="9"><em>{{{depName}}}</em></td>
                </tr>
                <!--{{/depName}}-->
                    <!--{{#items}}-->
                        <tr>
                            <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="9">{{{text}}}</td>
                        </tr>
                    <!--{{/items}}-->

            <!--{{/deps}}-->
        <!--{{/stDeps}}-->
     <!--{{/detail}}-->
    <!--{{#tasks}}-->
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; text-indent: 34px;" colspan="9">{{{task}}}</td>
    </tr>
    <!--{{/tasks}}-->
    <!--{{#orderReason}}-->
    <tr style="height: 26px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; {{indent}}" colspan="9">{{{text}}}</td>
    </tr>
    <!--{{/orderReason}}-->
    <!--{{#responsiblesInfo}}-->
    <tr style="height: 45px; padding: 0; margin: 0;">
        <td style="padding: 0; margin: 0; font-size: 1pt;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; {{bold}} padding: 0px 25px 0px 1px; text-align: left; vertical-align: top;" colspan="5">{{respPos}}</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; {{bold}} padding: 0px 1px 0px 25px; text-align: {{align}}; vertical-align: bottom;" colspan="6">{{respFirstName}}</td>
    </tr>
    <!--{{/responsiblesInfo}}-->

    <!--{{#isPrintAddon}}-->
    <tr style="page-break-after: always;">
        <td colspan="9">
            <p>&nbsp;<!-- pagebreak --></p>
        </td>
    </tr>
    <tr>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px;" colspan="6">&nbsp;</td>
        <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px;" colspan="3">Додаток до наказу <br />від {{orderBlock.orderDate}} №{{orderBlock.orderNumber}}{{orderBlock.orderIndex}}</td>
    </tr>
    <!--{{#addons}}-->
    <tr>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; font-weight:bold; padding: 0px 1px 0px 1px;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; " colspan="9">Список {{positionType}} {{organizationNameGen}}, яким встановлюється {{payElName}} за {{experienceName}}</td>
    </tr>
    <tr>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; font-weight:bold; padding: 0px 1px 0px 1px;" colspan="9">&nbsp;</td>
    </tr>
    <tr>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;">№ <br />з/п</td>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" >ПІБ</td>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" colspan="3">Посада</td>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" colspan="2">Дата встановлення надбавки</td>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" >Кількість років</td>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; font-weight:bold; padding: 0px 1px 0px 1px; border: 1px solid black;" >Відсоток</td>
    </tr>
        <!--{{#stDeps}}-->
            <!--{{#stName}}-->
            <tr>
                <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; font-weight: bold; color:blue; border: 1px solid black;" colspan="9">{{{stName}}}</td>
            </tr>
            <!--{{/stName}}-->
            <!--{{#deps}}-->
                <!--{{#depName}}-->
                <tr>
                    <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; padding: 0px 1px 0px 1px; text-align: justify; font-weight: bold; border: 1px solid black;" colspan="9"><em>{{{depName}}}</em></td>
                </tr>
                <!--{{/depName}}-->
                <!--{{#items}}-->
                <tr>
                  <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; ">{{index}}</td>
                  <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " >{{{empName}}}</td>
                  <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " colspan="3">{{posName}}</td>
                  <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " colspan="2">{{{dateFrom}}}</td>
                  <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " >{{{stageYear}}}</td>
                  <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px; border: 1px solid black; vertical-align: top; " >{{#valueIsInt}}{{#$fs}}"value","numberGroup"{{/$fs}}{{/valueIsInt}}{{^valueIsInt}}{{#$fs}}"value","decimal2"{{/$fs}}{{/valueIsInt}}</td>
                </tr>
                <!--{{/items}}-->
            <!--{{/deps}}-->
        <!--{{/stDeps}}-->
    <!--{{/addons}}-->
    <tr>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: left; padding: 0px 1px 0px 1px; border: 0px; " colspan="9">&nbsp;</td>
    </tr>
    <tr>
      <td style="font-family: TimesNewRoman; font-size: {{fontSize}}pt; text-align: center; padding: 0px 1px 0px 1px; border: 0px; " colspan="9">{{line}}</td>
    </tr>
    <!--{{/isPrintAddon}}-->
    </tbody>
</table>