      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 100,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "shortname",
      "dataType": "String",
      "size": 50,
      "caption": "Скорочена назва",
      "description": "Скорочена назва",
      "documentation": "Скорочена назва",
      "allowNull": false
    },
    {
      "name": "isCorr",
      "dataType": "Boolean",
      "caption": "Дозвіл на пряме занесення",
      "description": "Дозвіл на пряме занесення",
      "documentation": "Дозвіл на пряме занесення",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 132,
      "caption": "Опис",
      "description": "Опис",
