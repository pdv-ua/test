    {
      "name": "excludeNameInPos",
      "dataType": "Boolean",
      "defaultValue": "0",
      "caption": "Не враховувати у назвах Посад",
      "description": "Не враховувати у назвах Посад",
      "documentation": "Не враховувати у назвах Посад"
    },
    {
      "name": "quantity",
      "dataType": "Currency",
      "caption": "Гранична чисельність",
      "documentation": "Гранична чисельність",
      "description": "Гранична чисельність"
    },
    {
      "name": "quantityLead",
      "dataType": "Currency",
      "caption": "Керівництво та ін. (підпорядковані безпосередньо)",
      "documentation": "Керівництво та ін. (підпорядковані безпосередньо)",
      "description": "Керівництво та ін. (підпорядковані безпосередньо)"
    },
    {
      "name": "liquidate",
      "dataType": "Boolean",
      "caption": "Ліквідувати",
      "description": "Ліквідувати",
      "documentation": "Ліквідувати",
      "defaultValue": "0",
      "defaultView": false
    },
    {
      "name": "quantityFact",
      "dataType": "Int",
      "caption": "Кількість посад (Фактична)",
      "documentation": "Кількість посад",
      "description": "Кількість посад",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select sum(p.quantity) from hr_position p where p.parentUnitID = {self}.mi_data_id and p.state = 'ACTIVE' and p.mi_dateFrom <= GETDATE() and p.mi_dateTo >= GETDATE() and p.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select sum(p.quantity) from hr_position p where p.parentUnitID = {self}.mi_data_id and p.state = 'ACTIVE' and p.mi_dateFrom <= CURRENT_DATE and p.mi_dateTo >= CURRENT_DATE and p.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "isStructDep",
      "dataType": "Boolean",
      "caption": "Є структурним підрозділом",
      "documentation": "Є структурним підрозділом",
      "description": "Є структурним підрозділом",
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT CASE WHEN max(o.ID) is not null THEN 1 ELSE 0 END FROM hr_organization o WHERE o.ID = {self}.parentUnitID)"
        }
      ]
    },
    {
      "name": "isParentStructDep",
      "dataType": "Boolean",
      "caption": "Батьківський підрозділ є структурним",
      "documentation": "Батьківський підрозділ є структурним",
      "description": "Батьківський підрозділ є структурним",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT CASE WHEN max(o.ID) is not null THEN 1 ELSE 0 END FROM hr_organization o INNER JOIN hr_department d ON d.mi_data_id = {self}.parentUnitID and d.state = 'ACTIVE' and GETDATE() between d.mi_dateFrom and d.mi_dateTo and d.parentUnitID = o.ID)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT CASE WHEN max(o.ID) is not null THEN 1 ELSE 0 END FROM hr_organization o INNER JOIN hr_department d ON d.mi_data_id = {self}.parentUnitID and d.state = 'ACTIVE' and CURRENT_DATE between d.mi_dateFrom and d.mi_dateTo and d.parentUnitID = o.ID)"
        }
      ]
    },
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішній ID при імпорті",
      "description": "Зовнішній ID при імпорті",
      "documentation": "Зовнішній ID при імпорті"
    },
    {
      "name": "impSourceID",
      "dataType": "BigInt",
      "caption": "Код джерела",
      "description": "Код джерела даних імпорту",
      "documentation": "Код джерела даних імпорту",
      "allowNull": true
    },
    {
      "name": "treePath",
      "dataType": "String",
      "size": 400,
      "caption": "treePath",
      "documentation": "treePath",
      "description": "treePath"
    },
    {
      "name": "parentName",
      "dataType": "String",
      "size": 4000,
      "caption": "Підпорядкування",
      "description": "Підпорядкування",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 su.name from hr_staffUnit su WHERE su.mi_data_id={self}.parentUnitID and su.state = 'ACTIVE' and su.mi_dateFrom <= {self}.mi_dateTo and su.mi_dateTo >= {self}.mi_dateFrom and su.mi_deleteDate >= '9999-12-31' order by su.mi_dateFrom desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select su.name from hr_staffUnit su WHERE su.mi_data_id={self}.parentUnitID and su.state = 'ACTIVE' and su.mi_dateFrom <= {self}.mi_dateTo and su.mi_dateTo >= {self}.mi_dateFrom and su.mi_deleteDate >= '9999-12-31' order by su.mi_dateFrom desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "parentTreeDepID",
      "dataType": "Entity",
      "associatedEntity": "hr_department",
      "associationAttr": "mi_data_id",
      "caption": "Підпорядкування",
      "description": "Підпорядкування (для пошуку посад)",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 d.mi_data_id from hr_department d WHERE /*# d.mi_data_id {whereValue} and #*/ {self}.mi_treePath like '%/' + CAST(d.mi_data_id as varchar) + '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and GETDATE() between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select d.mi_data_id from hr_department d WHERE /*# d.mi_data_id {whereValue} and #*/ {self}.mi_treePath like '%/' || CAST(d.mi_data_id as varchar) || '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and CURRENT_DATE between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ],
      "customSettings": {
        "noEntityDetails": true
      }
    },
    {
      "name": "parentTreeDepName",
      "dataType": "String",
      "size": 300,
      "caption": "Підпорядкування (назва)",
      "description": "Підпорядкування (для пошуку посад)",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 d.caption from hr_department d WHERE {self}.mi_treePath like '%/' + CAST(d.mi_data_id as varchar) + '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and  GETDATE() between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select d.caption from hr_department d WHERE {self}.mi_treePath like '%/' || CAST(d.mi_data_id as varchar) || '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and CURRENT_DATE between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ]
    },
    {
      "name": "mi_maxDateTo",
      "dataType": "DateTime",
      "caption": "mi_maxDateTo",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT MAX(d.mi_dateTo) FROM hr_department d WHERE d.mi_data_id = {self}.mi_data_id and d.state='ACTIVE' and d.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "isSecondaryChanges",
      "dataType": "Int",
      "caption": "Другорядні зміни",
      "description": "Признак false, если у Посад были изменены К-во ставок либо Оклад, иначе true"
    },
    {
      "name": "codeSort",
      "dataType": "Float",
      "caption": "Код",
      "description": "Код",
      "documentation": "Код"
    }
  ],
  "dbExtensions": {
    "UIDX_HR_DEPARTMENT_HIST": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "mi_dateFrom": { "sort": "ASC" },
          "mi_data_id": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" },
          "staffOrderID": { "sort": "ASC" }
        },
        "isUnique": true
      }
    },
    "IDX_HR_DEPARTMENT_DATES": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "mi_dateFrom": { "sort": "ASC" },
          "mi_dateTo": { "sort": "ASC" },
          "state": { "sort": "ASC" },
          "orgID": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_DEPARTMENT_ORGDATAID": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "mi_data_id": { "sort": "ASC" },
          "orgID": { "sort": "ASC" },
          "state": { "sort": "ASC" },
          "mi_dateFrom": { "sort": "ASC" },
          "mi_dateTo": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_DEPARTMENT_TREEPATH": {
      "type": "INDEX",
        "definition": {
        "keys": {
          "mi_treePath": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "dataHistory": {},
    "unity": {
      "entity": "hr_staffUnit",
      "attributeList": ["orgID", "code", "name", "fullName", "state", "description", "staffOrderID",
        "changeStaffOrderID", "entryOrderID", "mi_dateFrom", "mi_dateTo", "mi_treePath", "parentUnitID",
        "mi_data_id", "idxNum", "liquidate", "treePath", "linkToSourceID", "quantity", "quantityLead", "isSecondaryChanges"]
    }
  }
}
