{
  "caption": "Святкові дні",
  "description": "Святкові дні",
  "cacheType": "None",
  "attributes": [
    {
      "name": "name",
      "dataType": "String",
      "size": 255,
      "caption": "Назва",
      "documentation": "Назва",
      "description": "Назва",
      "allowNull": false
    },
    {
      "name": "dayHoliday",
      "dataType": "Int",
      "caption": "День",
      "description": "День",
      "documentation": "День",
      "allowNull": false
    },
    {
      "name": "monthHoliday",
      "dataType": "Entity",
      "associatedEntity": "ac_dictMonth",
      "caption": "Місяць",
      "description": "Місяць",
      "documentation": "Місяць",
      "allowNull": false
    },
    {
      "name": "yearHoliday",
      "dataType": "Int",
      "caption": "Рік",
      "description": "Рік",
      "documentation": "Рік",
      "allowNull": true
    },
    {
      "name": "shortDay",
      "dataType": "Float",
      "caption": "Скорочення передсвяткового дня (годин)",
      "description": "Скорочення передсвяткового дня (годин)",
      "documentation": "Скорочення передсвяткового дня (годин)",
      "defaultValue": "1"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку",
      "description": "Дата початку",
      "documentation": "Дата початку"
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення",
      "description": "Дата закінчення",
      "documentation": "Дата закінчення"
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "description": "Дата початку",
      "documentation": "Дата початку",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Дата закінчення",
      "documentation": "Дата закінчення",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "excludeOrg",
      "dataType": "Boolean",
      "caption": "Виключення",
      "description": "Виключення організацій",
      "defaultValue": "0"
    }
  ],
  "dbExtensions": {
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}