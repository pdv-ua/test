    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Припинення споріднення",
      "description": "Припинення споріднення",
      "documentation": "Припинення споріднення",
      "defaultView": false
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Припинення споріднення",
      "description": "Припинення споріднення",
      "documentation": "Припинення споріднення",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "dictBenefitsKindID",
      "dataType": "Entity",
