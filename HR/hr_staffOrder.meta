{
  "caption": "Наказ про зміну штатного розпису",
  "description": "Наказ про зміну штатного розпису",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "orderNumber",
      "dataType": "String",
      "size": 30,
      "caption": "Номер наказу",
      "description": "Номер наказу",
      "documentation": "Номер наказу",
      "allowNull": false
    },
    {
      "name": "orderDate",
      "dataType": "Date",
      "caption": "Дата наказу",
      "description": "Дата наказу",
      "documentation": "Дата наказу",
      "allowNull": false
    },
    {
      "name": "entryDate",
      "dataType": "Date",
      "caption": "Дата вступу в дію",
      "description": "Дата вступу в дію",
      "documentation": "Дата вступу в дію",
      "allowNull": false
    },
    {
      "name": "orderState",
      "dataType": "Enum",
      "enumGroup": "HR_ORDER_STATE",
      "caption": "Стан наказу",
      "description": "Стан наказу",
      "documentation": "Стан наказу",
      "defaultValue": "PROJECT",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організація",
      "description": "Організація",
      "documentation": "Організація"
    },
    {
      "name": "orgName",
      "dataType": "String",
      "size": 4000,
      "caption": "Організація",
      "description": "Організація",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 org.name from hr_organization org where {self}.orgID = org.mi_data_id and org.mi_deleteDate >= '9999-12-31' and org.state = 'ACTIVE' and org.mi_dateFrom <= GETDATE() and org.mi_dateTo >= GETDATE())"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select org.name from hr_organization org where {self}.orgID = org.mi_data_id and org.mi_deleteDate >= '9999-12-31' and org.state = 'ACTIVE' and org.mi_dateFrom <= CURRENT_DATE and org.mi_dateTo >= CURRENT_DATE LIMIT 1)"
        }
      ]
    },
    {
      "name": "organizationID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організація",
      "description": "Організація",
      "documentation": "Організація",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Field",
          "expression": "orgID"
        }
      ]
    },
    {
      "name": "textOrder",
      "dataType": "String",
      "size": 1000,
      "caption": "Текст наказу",
      "description": "Текст наказу",
      "documentation": "Текст наказу",
      "allowNull": false
    },
    {
      "name": "respEmployeeID",
      "dataType": "Entity",
      "associatedEntity": "hr_employee",
      "caption": "Підписав",
      "description": "Підписав",
      "documentation": "Підписав"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 128,
      "caption": "Опис",
      "description": "Опис наказу",
      "documentation": "Опис наказу",
      "allowNull": false,
      "customSettings": {
        "compositeFields": [
          "orderNumber",
          "orderDate"
        ],
        "compositeSeparator": " від "
      }
    },
    {
      "name": "notes",
      "dataType": "String",
      "size": 128,
      "caption": "Примітки",
      "description": "Примітки",
      "documentation": "Примітки"
    },
    {
      "name": "isImportOrder",
      "dataType": "Boolean",
      "caption": "Ознака імпортованого",
      "documentation": "Ознака імпортованого",
      "description": "Ознака імпортованого",
      "defaultValue": "0"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "rls": {
      "func": "RLS.byOrg"
    }
  }
}