    {
      "name": "birthDate",
      "dataType": "Date",
      "caption": "Дата народження",
      "description": "Дата народження",
      "documentation": "Дата народження"
    },
    {
      "name": "age",
      "dataType": "Int",
      "caption": "Вік",
      "description": "Вік",
      "documentation": "Вік",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select DATEDIFF(yy, {self}.birthDate, GETDATE()) - CASE WHEN MONTH(GETDATE()) < MONTH({self}.birthDate) THEN 1 WHEN MONTH(GETDATE()) > MONTH({self}.birthDate) THEN 0 WHEN DAY(GETDATE()) < DAY({self}.birthDate) THEN 1 ELSE 0 END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select date_part('years', AGE(CURRENT_DATE, {self}.birthDate)))"
        }
      ]
    },
    {
      "name": "taxCode",
      "dataType": "String",
      "size": 20,
