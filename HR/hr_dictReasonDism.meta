{
  "caption": "Причина звільнення",
  "description": "Причина звільнення",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 500,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "orderText",
      "dataType": "String",
      "size": 200,
      "caption": "Текст для наказу",
      "description": "Текст для наказу",
      "documentation": "Текст для наказу"
    },
    {
      "name": "lawName",
      "dataType": "String",
      "size": 500,
      "caption": "Стаття закону",
      "description": "Стаття закону",
      "documentation": "Стаття закону"
    },
    {
      "name": "dismPayValue",
      "dataType": "Int",
      "caption": "Розмір вихідної допомоги (середньомісячних окладів)",
      "description": "Розмір вихідної допомоги (середньомісячних окладів)",
      "documentation": "Розмір вихідної допомоги (середньомісячних окладів)"
    },
    {
      "name": "dismPaySum",
      "dataType": "Float",
      "caption": "Розмір вихідної допомоги (грн)",
      "description": "Розмір вихідної допомоги (грн)",
      "documentation": "Розмір вихідної допомоги (грн)"
    },
    {
      "name": "isDeductExcessLeave",
      "dataType": "Boolean",
      "caption": "Не відраховувати надлишкову відпустку",
      "description": "Не відраховувати надлишкову відпустку",
      "documentation": "Не відраховувати надлишкову відпустку",
      "defaultValue": "0"
    },
    {
      "name": "isDueToDeath",
      "dataType": "Boolean",
      "caption": "У зв'язку зі смерттю",
      "description": "У зв'язку зі смерттю",
      "documentation": "У зв'язку зі смерттю",
      "defaultValue": "0"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 550,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(CONCAT({self}.code, ' ', {self}.name))"
        }
      ],
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис"
    },
    {
      "name": "caption",
      "dataType": "String",
      "size": 550,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "allowNull": false,
      "customSettings": {
        "compositeFields": [
          "name",
          "code"
        ],
        "compositeSeparator": [
          "",
          " [",
          "]"
        ]
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}