      "caption": "Розрахунок від заробітку",
      "description": "Розрахунок від заробітку"
    },
    {
      "name": "factHours",
      "dataType": "Currency",
      "caption": "Відпрацьовано годин",
      "description": "Відпрацьовано годин",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select COALESCE(sum(hp.hours),0) from hr_docRegHourPay hp where hp.employeePositionID = {self}.employeePositionID and hp.orderState='POSTED' and hp.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "factHoursInDoc",
      "dataType": "Currency",
      "caption": "Відпрацьовано годин",
      "description": "Відпрацьовано годин",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select COALESCE(sum(hp.hours),0) from hr_docRegHourPay hp where hp.employeePositionID = {self}.employeePositionID and hp.orderRegistryID = {self}.orderRegistryID and hp.orderState='PROJECT' and hp.ID != {self}.orderID and hp.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
