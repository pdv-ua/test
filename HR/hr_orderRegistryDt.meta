    },
    {
      "name": "storno",
      "dataType": "Boolean",
      "caption": "Сторно",
      "description": "Сторно",
      "allowNull": true,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT CASE WHEN {self}.flagsRec & 512 = 512 THEN 1 ELSE 0 END)"
        }
      ]
    },
