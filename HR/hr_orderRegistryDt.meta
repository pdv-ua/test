      "caption": "Кадровий наказ деталь",
      "description": "Кадровий наказ деталь"
    },
    {
      "name": "employeePositionID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeePositionSR",
      "caption": "Призначення",
      "description": "Призначення"
    },
    {
      "name": "employeeNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberSR",
      "caption": "Табельний номер",
      "description": "Табельний номер",
      "allowNull": false
