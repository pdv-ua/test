    {
      "name": "dictTechID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictTech",
      "caption": "Технологічна карта",
      "description": "Технологічна карта"
    },
    {
      "name": "posName",
      "dataType": "String",
      "size": 4000,
      "caption": "Посада",
      "description": "Посада",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 (case when dp.name IS NOT NULL then dp.name else pos.name end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.state = 'ACTIVE' and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.employeeNumberID and ep.isActive = 1 and ep.dateFrom <= {self}.dateTo and ep.dateTo >= {self}.dateFrom and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo, pos.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select (case when dp.name IS NOT NULL then dp.name else pos.name end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.state = 'ACTIVE' and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.employeeNumberID and ep.isActive = 1 and ep.dateFrom <= {self}.dateTo and ep.dateTo >= {self}.dateFrom and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo, pos.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "tabNum",
      "dataType": "String",
      "size": 15,
      "caption": "Таб.№",
      "description": "Таб.№",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 en.tabNum from hr_employeeNumber en where en.ID = {self}.employeeNumberID)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select en.tabNum from hr_employeeNumber en where en.ID = {self}.employeeNumberID LIMIT 1)"
        }
      ]
    },
    {
      "name": "depName",
      "dataType": "String",
      "size": 4000,
      "caption": "Посада",
      "description": "Посада",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 dep.caption from hr_employeePosition ep join hr_department dep on dep.mi_data_id = ep.departmentID and dep.state = 'ACTIVE' and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.employeeNumberID and ep.isActive = 1 and ep.dateFrom <= {self}.dateTo and ep.dateTo >= {self}.dateFrom and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo, dep.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select dep.caption from hr_employeePosition ep join hr_department dep on dep.mi_data_id = ep.departmentID and dep.state = 'ACTIVE' and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.employeeNumberID and ep.isActive = 1 and ep.dateFrom <= {self}.dateTo and ep.dateTo >= {self}.dateFrom and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo, dep.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
