{
  "caption": "Шкала стажу",
  "description": "Шкала стажу",
  "descriptionAttribute": "payElID",
  "cacheType": "None",
  "attributes": [
    {
      "name": "payElID",
      "dataType": "Entity",
      "associatedEntity": "hr_payEl",
      "caption": "Вид оплати",
      "description": "Вид оплати",
      "documentation": "Вид оплати",
      "allowNull": false
    },
    {
      "name": "years",
      "dataType": "Int",
      "caption": "Кількість років стажу",
      "description": "Кількість років стажу",
      "documentation": "Кількість років стажу",
      "allowNull": false
    },
    {
      "name": "months",
      "dataType": "Int",
      "caption": "Кількість місяців стажу",
      "description": "Кількість місяців стажу",
      "documentation": "Кількість місяців стажу",
      "allowNull": false
    },
    {
      "name": "rate",
      "dataType": "Currency",
       "caption": "Відсоток",
      "description": "Відсоток",
      "documentation": "Відсоток",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "allowNull": false,
      "defaultView": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}