{
  "caption": "Група елементів обліку робочого часу",
  "description": "Група елементів обліку робочого часу",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 100,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "isClose",
      "dataType": "Boolean",
      "caption": "Не використовується",
      "description": "Не використовується",
      "documentation": "Не використовується",
      "allowNull": true,
      "defaultValue": "0"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 132,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "allowNull": false,
      "customSettings": {
        "compositeFields": ["code","name"],
        "compositeSeparator": " "
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
