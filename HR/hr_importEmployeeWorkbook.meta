      "description": "Категорія посади держслужбовця"
    },
    {
      "name": "empWorkPlace",
      "dataType": "Enum",
      "enumGroup": "HR_WORKER_PLACE",
      "caption": "Місце роботи",
      "description": "Місце роботи",
      "defaultValue": "1"
    },
    {
      "name": "mtCount",
      "dataType": "Float",
      "caption": "Кількість ставок",
