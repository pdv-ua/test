{
  "caption": "Трудова книжка працівника (імпорт)",
  "description": "Трудова книжка працівника (імпорт)",
  "descriptionAttribute": "employeeID",
  "cacheType": "None",
  "attributes": [
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішня ID",
      "description": "Зовнішня ID",
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "employeeID",
      "dataType": "BigInt",
      "caption": "Особа",
      "description": "Особа"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку",
      "description": "Дата початку роботи"
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення",
      "description": "Дата закінчення роботи"
    },
    {
      "name": "workPlace",
      "dataType": "String",
      "size": 800,
      "caption": "Місце роботи",
      "description": "Місце роботи"
    },
    {
      "name": "workPosition",
      "dataType": "String",
      "size": 1100,
      "caption": "Посада",
      "description": "Посада"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 1000,
      "caption": "Опис",
      "description": "Опис"
    },
    {
      "name": "dateTrialEnd",
      "dataType": "Date",
      "caption": "Закінчення випробувального терміну",
      "description": "Закінчення випробувального терміну"
    },
    {
      "name": "baseDocument",
      "dataType": "String",
      "size": 400,
      "caption": "Коментар",
      "description": "Коментар"
    },
    {
      "name": "appointOrder",
      "dataType": "String",
      "size": 400,
      "caption": "Наказ (про початок)",
      "description": "Наказ (про початок)"
    },
    {
      "name": "dismOrder",
      "dataType": "String",
      "size": 400,
      "caption": "Наказ (про закінчення)",
      "description": "Наказ (про закінчення)"
    },
    {
      "name": "appointReason",
      "dataType": "String",
      "size": 400,
      "caption": "Умови призначення",
      "description": "Умови призначення"
    },
    {
      "name": "dischargeReason",
      "dataType": "String",
      "size": 400,
      "caption": "Причина звільнення",
      "description": "Причина звільнення"
    },
    {
      "name": "positionType",
      "dataType": "Enum",
      "enumGroup": "HR_POSITION_TYPE",
      "caption": "Тип посади",
      "description": "Тип посади"
    },
    {
      "name": "appointmentLevel",
      "dataType": "Enum",
      "enumGroup": "HR_APPOINTMENT_LEVEL",
      "caption": "Рівень призначення",
      "description": "Рівень призначення"
    },
    {
      "name": "positionCategory",
      "dataType": "String",
      "size": 50,
