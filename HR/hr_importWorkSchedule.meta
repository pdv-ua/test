{
  "caption": "Графік роботи (імпорт)",
  "description": "Графік роботи (імпорт)",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішня ID",
      "description": "Зовнішня ID",
      "documentation": "Зовнішня ID",
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код"
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 100,
      "caption": "Назва",
      "description": "Назва"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії"
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії"
    },
    {
      "name": "begins",
      "dataType": "Enum",
      "enumGroup": "HR_SCHEDULE_BEGINS",
      "caption": "Тип",
      "description": "Тип Періоду",
      "defaultValue": "MONTH"
    },
    {
      "name": "isPayDayOff",
      "dataType": "Boolean",
      "caption": "У вихідний день",
      "description": "У вихідний день",
      "defaultValue": "0"
    },
    {
      "name": "isPayHoliday",
      "dataType": "Boolean",
      "caption": "У святковий день",
      "description": "У святковий день",
      "defaultValue": "0"
    },
    {
      "name": "isHoliday",
      "dataType": "Boolean",
      "caption": "Святкові дні",
      "description": "Святкові дні",
      "defaultValue": "0"
    },
    {
      "name": "isLastHoliday",
      "dataType": "Boolean",
      "caption": "Скорочення у передсвяткові дні",
      "documentation": "Скорочення у передсвяткові дні",
      "description": "Скорочення у передсвяткові дні",
      "defaultValue": "0"
    },
    {
      "name": "isChangeDay",
      "dataType": "Boolean",
      "caption": "Переноси днів",
      "documentation": "Переноси днів",
      "description": "Переноси днів",
      "defaultValue": "0"
    },
    {
      "name": "isCalendar",
      "dataType": "Boolean",
      "caption": "Використовувати календар",
      "documentation": "Використовувати календар",
      "description": "Використовувати календар",
      "defaultValue": "0"
    },
    {
      "name": "isMtCount",
      "dataType": "Boolean",
      "caption": "Кількість ставок працівника",
      "documentation": "Кількість ставок працівника",
      "description": "Кількість ставок працівника",
      "defaultValue": "1"
    },
    {
      "name": "impOrgID",
      "dataType": "BigInt",
      "caption": "Зовнішня організаційна одиниця",
      "description": "Зовнішня організаційна одиниця",
      "documentation": "Зовнішня організаційна одиниця"
    }
  ],
  "mixins": {
