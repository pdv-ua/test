{
  "caption": "Рівень посадового окладу",
  "description": "Рівень посадового окладу",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "dictSalarySchemeID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictSalaryScheme",
      "caption": "Схема посадових окладів",
      "description": "Схема посадових окладів",
      "documentation": "Схема посадових окладів"
    },
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "sortNumber",
      "dataType": "BigInt",
      "caption": "Номер за порядком",
      "description": "Номер за порядком",
      "documentation": "Номер за порядком"
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 200,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "allowNull": true
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "allowNull": true
    },
    {
      "name": "isActive",
      "dataType": "Boolean",
      "caption": "Ознака дії",
      "description": "Ознака дії",
      "documentation": "Ознака дії",
      "allowNull": false,
      "defaultValue": "1"
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "accrualSumMin",
      "dataType": "Currency",
      "caption": "Сума окладу (мін)",
      "description": "Сума окладу (мін)",
      "documentation": "Сума окладу (мін)",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 det.accrualSumMin from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select det.accrualSumMin from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "accrualSumMax",
      "dataType": "Currency",
      "caption": "Сума окладу (макс)",
      "description": "Сума окладу (макс)",
      "documentation": "Сума окладу (макс)",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 det.accrualSumMax from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select det.accrualSumMax from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "accrualSumAvg",
      "dataType": "Currency",
      "caption": "Середнє значення",
      "description": "Середнє значення",
      "documentation": "Середнє значення",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 (det.accrualSumMax + det.accrualSumMin)/2 from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select (det.accrualSumMax + det.accrualSumMin)/2 from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "accDateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select max(det.dateFrom) from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "accDateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select max(det.dateTO) from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "coefMin",
      "dataType": "Float",
      "caption": "Коефіцієнт (мін)",
      "description": "Коефіцієнт (мін)",
      "documentation": "Коефіцієнт (мін)",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 det.coefMin from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select det.coefMin from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "coefMax",
      "dataType": "Float",
      "caption": "Коефіцієнт (макс)",
      "description": "Коефіцієнт (макс)",
      "documentation": "Коефіцієнт (макс)",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 det.coefMax from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select det.coefMax from hr_dictSalarySchemeDet det where det.dictSalarySchemeLevelID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "dictPositionID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictPosition",
      "caption": "Довідник посад",
      "description": "Довідник посад",
      "documentation": "Довідник посад"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 250,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "allowNull": false,
      "customSettings": {
        "compositeFields": ["code","name"],
        "compositeSeparator": " "
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}