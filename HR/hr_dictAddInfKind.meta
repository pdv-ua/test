{
  "caption": "Вид додаткової інформації",
  "description": "Вид додаткової інформації",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 10,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 50,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 60,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "customSettings": {
        "compositeFields": ["code", "name"],
        "compositeSeparator": " "
       }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}