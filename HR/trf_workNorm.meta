{
    "caption": "Норми тривалості робочого часу",
    "description": "Норми тривалості робочого часу",
    "descriptionAttribute": "code",
    "cacheType": "None",
    "attributes": [
        {
            "name": "code",
            "dataType": "String",
            "size": 32,
            "caption": "Код",
            "description": "Код"
        },
        {
            "name": "name",
            "dataType": "String",
            "size": 400,
            "caption": "Назва",
            "description": "Назва"
        },
        {
            "name": "scheduleType",
            "dataType": "Enum",
            "enumGroup": "SCHEDULE_TYPE",
            "caption": "Тип графіка роботи",
            "description": "Тип графіка роботи"
        },
        {
            "name": "weekHours",
            "dataType": "Currency",
            "caption": "Тижнева норма",
            "description": "Тижнева норма",
            "allowNull": false
        },
        {
            "name": "dateFrom",
            "dataType": "Date",
            "caption": "Дата початку дії",
            "description": "Дата початку дії",
            "defaultView": false
        },
        {
            "name": "dateTo",
            "dataType": "Date",
            "caption": "Дата закінчення дії",
            "description": "Дата закінчення дії",
            "defaultView": false
        },
        {
            "name": "dateFromEmpty",
            "dataType": "Date",
            "caption": "Діє з",
            "description": "Дата початку дії",
            "mapping": [
                {
                    "name": "MSSQL2012",
                    "expressionType": "Expression",
                    "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
                },
                {
                    "name": "PostgreSQL",
                    "expressionType": "Expression",
                    "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
                }
            ]
        },
        {
            "name": "dateToEmpty",
            "dataType": "Date",
            "caption": "Діє по",
            "description": "Дата закінчення дії",
            "mapping": [
                {
                    "name": "MSSQL2012",
                    "expressionType": "Expression",
                    "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
                },
                {
                    "name": "PostgreSQL",
                    "expressionType": "Expression",
                    "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
                }
            ]
        }
        /*,
        {
            "name": "avg",
            "dataType": "Currency",
            "caption": "Середньомісячна",
            "description": "Середньомісячна",
            "allowNull": true,
            "defaultView": false,
            "mapping": [
                {
                    "name": "MSSQL2012",
                    "expressionType": "Expression",
                    "expression": "(select sum(d1.avg) from trf_workNormDt d1 where d1.workNormID = {self}.ID and d1.mi_deleteDate >= '9999-12-31' and d1.year = YEAR(GETDATE()))"
                },
                {
                    "name": "PostgreSQL",
                    "expressionType": "Expression",
                    "expression": "(select sum(d1.avg) from trf_workNormDt d1 where d1.workNormID = {self}.ID and d1.mi_deleteDate >= '9999-12-31' and d1.year = date_part('year', CURRENT_DATE))"
                }
            ]
