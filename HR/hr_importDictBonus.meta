{
  "caption": "Нагорода (імпорт)",
  "description": "Нагорода (імпорт)",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішня ID",
      "description": "Зовнішня ID",
      "documentation": "Зовнішня ID",
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код"
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 200,
      "caption": "Назва",
      "description": "Назва"
    },
    {
      "name": "bonusKindID",
      "dataType": "Bigint",
      "description": "Вид нагороди",
      "caption": "Вид нагороди"
    },
    {
      "name": "bonusTypeID",
      "dataType": "Bigint",
      "description": "Тип нагороди",
      "caption": "Тип нагороди"
    },
    {
      "name": "isActive",
      "dataType": "Boolean",
      "caption": "Ознака дії",
      "description": "Ознака дії",
      "defaultValue": "1"
    },
    {
      "name": "isEnc",
      "dataType": "Boolean",
      "caption": "Ознака заохочення",
      "description": "Ознака заохочення",
      "defaultValue": "0"
    },
    {
      "name": "impOrgID",
      "dataType": "BigInt",
      "caption": "Зовнішня організаційна одиниця",
      "description": "Зовнішня організаційна одиниця",
      "documentation": "Зовнішня організаційна одиниця"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}