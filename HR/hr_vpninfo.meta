{
  "caption": "Доступ до VPN",
  "description": "Доступ до VPN",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "userID",
      "dataType": "Entity",
      "associatedEntity": "uba_user",
      "caption": "Працівник",
      "description": "Працівник",
      "documentation": "Працівник",
      "allowNull": false,
      "isUnique": true
    },
    {
      "name": "uPasswordHashVpn",
      "dataType": "String", "size": 64,
      "caption": "Password hash",
      "defaultView": false,
      "documentation": "PasswordHashHexa := SHA256('salt:' + login + ':' + PasswordPlain) in UTF-8"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": false
    },
    "rls": {
      "expression": "hr_vpninfo.rls()"
    }
  }

}