    },
    {
      "name": "filterParams",
      "dataType": "String",
      "size": 4000,
      "caption": "JSON параметри фільтру",
      "description": "JSON параметри фільтру",
      "documentation": "JSON параметри фільтру"
    },
    {
      "name": "docNumber",
      "dataType": "String",
      "size": 20,
      "caption": "Номер наказу",
      "description": "Номер наказу",
      "documentation": "Номер наказу"
    },
    {
      "name": "empOrderID",
      "dataType": "Entity",
      "associatedEntity": "hr_order",
      "caption": "Наказ",
      "description": "Наказ",
      "documentation": "Наказ"
    },
    {
      "name": "empOrderDetID",
      "dataType": "Entity",
      "associatedEntity": "hr_empOrderDet",
      "caption": "Наказ деталь",
      "description": "Наказ деталь",
      "documentation": "Наказ деталь"
    },
    {
      "name": "isOnlyPositive",
      "dataType": "Boolean",
      "caption": "Тільки позитивні суми",
      "description": "Тільки позитивні суми",
      "documentation": "Тільки позитивні суми",
      "defaultValue": "0"
    },
    {
      "name": "flagsFixDoc",
      "dataType": "BigInt",
      "caption": "Маска ознаки фіксації полів в документі",
      "description": "Маска ознаки фіксації полів в документі",
      "documentation": "Маска ознаки фіксації полів в документі",
      "defaultValue": "0"
    },
    {
      "name": "payElParams",
      "dataType": "Text",
      "caption": "JSON список видів оплат",
      "description": "JSON список видів оплат",
      "documentation": "JSON список видів оплат"
    },
    {
      "name": "dailyWage",
      "dataType": "Boolean",
      "caption": "Від денного заробітка",
      "description": "Від денного заробітка",
      "defaultValue": "0"
    },
    {
      "name": "checkBalance",
      "dataType": "Boolean",
      "caption": "Перевіряти на борг",
      "description": "Перевіряти на борг",
      "defaultValue": "0"
    },
    {
      "name": "employeeList",
      "dataType": "String",
      "size": 128,
      "caption": "Список осіб",
      "description": "Список осіб",
      "documentation": "Список осіб"
    },
    {
      "name": "paySum",
      "dataType": "Currency",
      "caption": "Сума",
      "description": "Сума",
      "documentation": "Сума",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select sum(dt.paySum) from hr_orderRegistryDt dt where dt.orderRegistryID = {self}.ID and (dt.dtType = 'rd' or dt.dtType is null) and dt.mi_deleteDate>='9999-12-31')"
        }
      ]
    },
    {
      "name": "lineCount",
      "dataType": "Int",
      "caption": "Кількість рядків",
      "description": "Кількість рядків",
      "documentation": "Кількість рядків",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select count(1) from hr_orderRegistryDt dt where dt.orderRegistryID = {self}.ID and (dt.dtType = 'rd' or dt.dtType is null) and dt.mi_deleteDate>='9999-12-31')"
        }
      ]
    },
    {
      "name": "orderStatePayRoll",
      "dataType": "Enum",
      "enumGroup": "HR_ORDER_STATE",
      "caption": "Статус привязаної платіжної відомості",
      "description": "Статус привязаної платіжної відомості",
      "documentation": "Статус привязаної платіжної відомості",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 pr.orderState from hr_payRoll pr join hr_RollReg rr on rr.payRollID = pr.ID join hr_orderRegistry org on org.ID = rr.orderRegistryID where org.ID = {self}.ID and org.mi_deleteDate>='9999-12-31' and pr.mi_deleteDate>='9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select pr.orderState from hr_payRoll pr join hr_RollReg rr on rr.payRollID = pr.ID join hr_orderRegistry org on org.ID = rr.orderRegistryID where org.ID = {self}.ID and org.mi_deleteDate>='9999-12-31' and pr.mi_deleteDate>='9999-12-31' LIMIT 1)"
        }
      ]
    },
    {
      "name": "hasPosted",
      "dataType": "Int",
      "caption": "Ознака наявності дочірніх документів в статусі POSTED",
      "description": "Ознака наявності дочірніх документів в статусі POSTED",
      "documentation": "Ознака наявності дочірніх документів в статусі POSTED",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT count(*) FROM hr_orderRegistryDt det INNER JOIN hr_order ON hr_order.ID=det.orderID WHERE det.orderRegistryID={self}.ID AND det.mi_deleteDate>='9999-12-31' AND hr_order.orderState='POSTED')"
        }
      ]
    },
    {
      "name": "hasProject",
      "dataType": "Int",
      "caption": "Ознака наявності дочірніх документів в статусі PROJECT",
      "description": "Ознака наявності дочірніх документів в статусі PROJECT",
      "documentation": "Ознака наявності дочірніх документів в статусі PROJECT",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT count(*) FROM hr_orderRegistryDt det INNER JOIN hr_order ON hr_order.ID=det.orderID WHERE det.orderRegistryID={self}.ID AND det.mi_deleteDate>='9999-12-31' AND hr_order.orderState='PROJECT')"
        }
      ]
    },
    {
      "name": "hasCanceled",
      "dataType": "Int",
      "caption": "Ознака наявності дочірніх документів в статусі CANCELED",
      "description": "Ознака наявності дочірніх документів в статусі CANCELED",
      "documentation": "Ознака наявності дочірніх документів в статусі CANCELED",
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT count(*) FROM hr_orderRegistryDt det INNER JOIN hr_order ON hr_order.ID=det.orderID WHERE det.orderRegistryID={self}.ID AND det.mi_deleteDate>='9999-12-31' AND hr_order.orderState='CANCELED')"
        }
      ]
    },
    {
      "name": "createUser",
      "dataType": "String",
      "size": 512,
      "caption": "Користувач, що створив",
      "description": "Користувач, що створив",
      "documentation": "Користувач, що створив",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 u.fullName from uba_user u where u.ID = {self}.mi_createUser)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select u.fullName from uba_user u where u.ID = {self}.mi_createUser LIMIT 1)"
        }
      ]
    },
    {
      "name": "modifyUser",
      "dataType": "String",
      "size": 512,
      "caption": "Користувач, що останнім коригував",
      "description": "Користувач, що останнім коригував",
      "documentation": "Користувач, що останнім коригував",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 u.fullName from uba_user u where u.ID = {self}.mi_modifyUser)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select u.fullName from uba_user u where u.ID = {self}.mi_modifyUser LIMIT 1)"
        }
      ]
    },
    {
      "name": "minDateOrderRegistryDt",
      "dataType": "Date",
      "caption": "Найменша дата",
      "description": "Найменша дата",
      "documentation": "Найменша дата",
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select min(dt.orderDateFrom) from hr_orderRegistryDt dt inner join hr_order o on dt.orderID = o.ID where dt.orderRegistryID = {self}.ID and o.orderState = 'PROJECT' and dt.mi_deleteDate>='9999-12-31')"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "rls": {
      "func": "RLS.byOrganization"
    }
  }
}
