  "dbExtensions": {
    "UIDX_HR_POSITION_HIST": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "mi_dateFrom": { "sort": "ASC" },
          "mi_data_id": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" },
          "staffOrderID": { "sort": "ASC" }
        },
        "isUnique": true
      }
    },
    "IDX_HR_POSITION_DATES": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "mi_dateFrom": { "sort": "ASC" },
          "mi_dateTo": { "sort": "ASC" },
          "state": { "sort": "ASC" },
          "orgID": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_POSITION_MIDATAID": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "mi_data_id": { "sort": "ASC" },
          "mi_dateFrom": { "sort": "ASC" },
          "mi_dateTo": { "sort": "ASC" },
          "state": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" },
          "positionType": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_POSITION_ORGDATAID": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "mi_data_id": { "sort": "ASC" },
          "orgID": { "sort": "ASC" },
          "state": { "sort": "ASC" },
          "mi_dateFrom": { "sort": "ASC" },
          "mi_dateTo": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "dataHistory": {},
    "unity": {
      "entity": "hr_staffUnit",
      "attributeList": ["orgID", "code", "name", "fullName", "state", "description", "staffOrderID",
        "changeStaffOrderID", "entryOrderID", "mi_dateFrom", "mi_dateTo", "mi_treePath", "parentUnitID",
        "mi_data_id", "idxNum", "quantity", "accrualSum", "liquidate", "treePath", "linkToSourceID", "isSecondaryChanges"]
    }
  }
