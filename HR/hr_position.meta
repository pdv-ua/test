      "name": "mi_minDateFrom",
      "dataType": "DateTime",
      "caption": "mi_minDateFrom",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT MIN(p.mi_dateFrom) FROM hr_position p WHERE p.mi_data_id = {self}.mi_data_id and p.state='ACTIVE' and p.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "posDepName",
      "dataType": "String",
      "size": 800,
      "caption": "Посада та підрозділ",
      "description": "Посада та підрозділ",
      "documentation": "Посада та підрозділ",
      "allowNull": true,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "CONCAT([name], ', ', [depName])"
        }
      ]
