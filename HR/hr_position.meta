    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.mi_dateTo) WHEN 9999 THEN null ELSE {self}.mi_dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.mi_dateTo) WHEN 9999 THEN null ELSE {self}.mi_dateTo END)"
        }
      ]
    },
    {
      "name": "positionTypeNotNull",
      "dataType": "String",
      "size": 100,
      "caption": "Тип посади",
      "documentation": "Тип посади",
      "description": "Тип посади",
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "COALESCE([positionType],'0')"
        }
      ]
    },
    {
      "name": "vacancyRate",
      "dataType": "Float",
      "caption": "Кількість вакансій",
      "documentation": "Кількість вакансій",
      "description": "Кількість вакансій",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT COALESCE({self}.quantity, 0) - COALESCE(sum(ep.mtCount), 0) from hr_employeePosition ep where ep.positionID = {self}.mi_data_id and ep.isActive = 1 and ep.dateFrom <= GETDATE() and ep.dateTo >= GETDATE() and ep.mi_deleteDate >= '9999-12-31' AND NOT EXISTS (SELECT 1  FROM hr_empLongTermAbsc absc WHERE absc.employeeNumberID=ep.employeeNumberID AND absc.dateFrom<=GETDATE() AND absc.dateTo>=GETDATE() AND absc.mi_deleteDate >= '9999-12-31'))"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT COALESCE({self}.quantity, 0) - COALESCE(sum(ep.mtCount), 0) from hr_employeePosition ep where ep.positionID = {self}.mi_data_id and ep.isActive = 1 and ep.dateFrom <= CURRENT_DATE and ep.dateTo >= CURRENT_DATE and ep.mi_deleteDate >= '9999-12-31' AND NOT EXISTS (SELECT 1  FROM hr_empLongTermAbsc absc WHERE absc.employeeNumberID=ep.employeeNumberID AND absc.dateFrom<=CURRENT_DATE AND absc.dateTo>=CURRENT_DATE AND absc.mi_deleteDate >= '9999-12-31'))"
        }
      ]
    },
