      "caption": "Джерело створення",
      "description": "Джерело створення",
      "documentation": "Джерело створення"
    },
    {
      "name": "departmentID",
      "dataType": "Entity",
      "associatedEntity": "hr_department",
      "associationAttr": "mi_data_id",
      "caption": "Підрозділ",
      "description": "Підрозділ",
      "documentation": "Підрозділ",
      "allowNull": false,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 mi_data_id from hr_staffUnit where mi_data_id = {self}.parentUnitID and mi_unityEntity = 'hr_department')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select mi_data_id from hr_staffUnit where mi_data_id = {self}.parentUnitID and mi_unityEntity = 'hr_department' LIMIT 1)"
        }
      ]
    },
    {
      "name": "depName",
      "dataType": "String",
      "size": 800,
      "caption": "Підрозділ",
      "description": "Підрозділ",
      "documentation": "Підрозділ",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 name from hr_staffUnit dep where mi_data_id = {self}.parentUnitID and dep.state = 'ACTIVE' and dep.mi_deleteDate >= '9999-12-31' order by dep.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select name from hr_staffUnit dep where mi_data_id = {self}.parentUnitID and dep.state = 'ACTIVE' and dep.mi_deleteDate >= '9999-12-31' order by dep.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "parentUnitDepName",
      "dataType": "String",
      "size": 4000,
      "caption": "Підпорядкування підрозділу",
      "description": "Підпорядкування підрозділу",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "select TOP 1 d2.name from hr_department d2 where d2.mi_data_id = (select TOP 1 d.parentUnitID from hr_department d where d.mi_data_id = {self}.parentUnitID and d.state = 'ACTIVE' ORDER BY d.mi_dateTo DESC) and d2.state = 'ACTIVE' ORDER BY d2.mi_dateTo DESC"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "select d2.name from hr_department d2 where d2.mi_data_id = (select d.parentUnitID from hr_department d where d.mi_data_id = {self}.parentUnitID and d.state = 'ACTIVE' ORDER BY d.mi_dateTo DESC LIMIT 1) and d2.state = 'ACTIVE' ORDER BY d2.mi_dateTo DESC LIMIT 1"
        }
      ]
    },
    {
      "name": "depDescription",
