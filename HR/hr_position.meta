    {
      "name": "fundSourceName",
      "dataType": "String",
      "size": 600,
      "caption": "Джерело фінансування",
      "description": "Джерело фінансування",
      "documentation": "Джерело фінансування",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 CONCAT(fs.description, CASE WHEN df.description IS NULL THEN '' ELSE CONCAT(' ', '(', df.description, ')') END) FROM ac_fundSource fs LEFT JOIN ac_dictFundSource df ON fs.ID = df.fundSourceID AND df.organizationID={self}.orgID AND df.mi_deleteDate>='9999-12-31' WHERE fs.ID = {self}.dictFundSourceID)"
      },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT CONCAT(fs.description, CASE WHEN df.description IS NULL THEN '' ELSE CONCAT(' ', '(', df.description, ')') END) FROM ac_fundSource fs LEFT JOIN ac_dictFundSource df ON fs.ID = df.fundSourceID AND df.organizationID={self}.orgID AND df.mi_deleteDate>='9999-12-31' WHERE fs.ID = {self}.dictFundSourceID LIMIT 1)"
        }
      ]
    },
