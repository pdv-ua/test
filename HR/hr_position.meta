        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select description from hr_department dep where mi_data_id = {self}.parentUnitID and dep.state = 'ACTIVE' and dep.mi_deleteDate >= '9999-12-31' order by dep.mi_dateTo desc LIMIT 1)"
