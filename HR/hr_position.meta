      "name": "mi_maxDateTo",
      "dataType": "DateTime",
      "caption": "mi_maxDateTo",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT MAX(p.mi_dateTo) FROM hr_position p WHERE p.mi_data_id = {self}.mi_data_id and p.state='ACTIVE' and p.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
