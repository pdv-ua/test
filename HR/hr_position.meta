    {
      "name": "parentUnitID",
      "dataType": "Entity",
      "associatedEntity": "hr_staffUnit",
      "associationAttr": "mi_data_id",
      "caption": "Підпорядкування",
      "description": "Підпорядкування",
      "documentation": "Підпорядкування",
      "allowNull": false
    },
    {
      "name": "parentTreeDepID",
      "dataType": "Entity",
      "associatedEntity": "hr_department",
      "associationAttr": "mi_data_id",
      "caption": "Підпорядкування",
      "description": "Підпорядкування (для пошуку посад)",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 d.mi_data_id from hr_department d WHERE {self}.mi_treePath like '%/' + CAST(d.mi_data_id as varchar) + '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and GETDATE() between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select d.mi_data_id from hr_department d WHERE {self}.mi_treePath like '%/' || CAST(d.mi_data_id as varchar) || '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and CURRENT_DATE between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ],
      "customSettings": {
        "noEntityDetails": true
      }
    },
    {
      "name": "parentTreeDepName",
      "dataType": "String",
      "size": 300,
      "caption": "Підпорядкування (назва)",
      "description": "Підпорядкування (для пошуку посад)",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 d.caption from hr_department d WHERE {self}.mi_treePath like '%/' + CAST(d.mi_data_id as varchar) + '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and GETDATE() between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select d.caption from hr_department d WHERE {self}.mi_treePath like '%/' || CAST(d.mi_data_id as varchar) || '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and CURRENT_DATE between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ]
    },
    {
      "name": "selfStructDepName",
      "dataType": "String",
      "size": 300,
      "caption": "Підпорядкування (назва)",
      "description": "Підпорядкування (для пошуку посад)",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 d.name from hr_department d WHERE {self}.mi_treePath like '%/' + CAST(d.mi_data_id as varchar) + '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and GETDATE() between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select d.name from hr_department d WHERE {self}.mi_treePath like '%/' || CAST(d.mi_data_id as varchar) || '/%' and d.state = 'ACTIVE' and d.mi_data_id <> {self}.mi_data_id and CURRENT_DATE between d.mi_dateFrom and d.mi_dateTo and d.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ]
    },
    {
      "name": "departmentName",
      "dataType": "String",
      "size": 800,
      "caption": "Підрозділ",
      "description": "Підрозділ",
      "documentation": "Підрозділ",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 name from hr_department dep where mi_data_id = {self}.parentUnitID and dep.state = 'ACTIVE' and dep.mi_deleteDate >= '9999-12-31' order by dep.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select name from hr_department dep where mi_data_id = {self}.parentUnitID and dep.state = 'ACTIVE' and dep.mi_deleteDate >= '9999-12-31' order by dep.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "linkToSourceID",
