      "name": "isCancelMoneyHelp",
      "dataType": "Boolean",
      "caption": "Скасувати матеріальну допомогу",
      "description": "Скасувати матеріальну допомогу",
      "documentation": "Скасувати матеріальну допомогу",
      "defaultValue": "0"
    },
    {
      "name": "calcDateTo",
      "dataType": "Date",
      "caption": "Дата закінчення за розрахунком",
      "description": "Дата закінчення за розрахунком",
      "documentation": "Дата закінчення за розрахунком",
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT MAX(l.dateTo) FROM hr_empOrderVacationListDet l WHERE l.paraID = {self}.ID and l.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "calcDayCount",
      "dataType": "Int",
      "caption": "Тривалість за розрахунком",
      "description": "Тривалість за розрахунком",
      "documentation": "Тривалість за розрахунком",
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT SUM(l.dayCount) FROM hr_empOrderVacationListDet l WHERE l.paraID = {self}.ID and l.mi_deleteDate >= '9999-12-31')"
        }
      ]
    }
  ],
  "dbExtensions": {
    "IDX_HR_EMPORDERVACPROLONGDET_EMPNUM": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "dateFrom": { "sort": "ASC" },
          "dateTo": { "sort": "ASC" },
          "employeeNumberID": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPORDERVACPROLONGDET_EMP": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "employeeID": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" },
          "dateTo": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPORDERVACPROLONGDET_EMPPOS": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "employeePositionID": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" },
          "dateTo": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
