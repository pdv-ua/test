{
  "caption": "Метод розрахунку нарахувань на зарплату",
  "description": "Метод розрахунку нарахувань на зарплату",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 255,
      "caption": "Назва",
      "description": "Назва",
      "allowNull": false
    },
    {
      "name": "correctByTime",
      "dataType": "Boolean",
      "caption": "Коригувати максимальну базу нарахування на час у трудових відносинах",
      "description": "Коригувати максимальну базу нарахування на час у трудових відносинах",
      "defaultValue": "0"
    },
    {
      "name": "accrueUnSick",
      "dataType": "Boolean",
      "caption": "Нараховувати при наявності непідтвердженого лікарняного",
      "description": "Нараховувати при наявності непідтвердженого лікарняного",
      "defaultValue": "0"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 290,
      "caption": "Опис",
      "description": "Опис",
      "defaultView": false,
      "allowNull": false,
      "customSettings": {
        "compositeFields": ["code","name"],
        "compositeSeparator": " "
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}