{
  "caption": "Профіль підготовки офіцерів запасу (імпорт)",
  "description": "Профіль підготовки офіцерів запасу (імпорт)",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішня ID",
      "description": "Зовнішня ID",
      "documentation": "Зовнішня ID",
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код"
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 200,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва"
    },
    {
      "name": "impOrgID",
      "dataType": "BigInt",
      "caption": "Зовнішня організаційна одиниця",
      "description": "Зовнішня організаційна одиниця",
      "documentation": "Зовнішня організаційна одиниця"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}