{
  "caption": "Учасник погодження",
  "description": "Учасник погодження документу",
  "descriptionAttribute": "positionID",
  "cacheType": "None",
  "attributes": [
    {
      "name": "recStageID",
      "dataType": "Entity",
      "associatedEntity": "hr_recstage",
      "cascadeDelete": true,
      "caption": "Етап погодження",
      "description": "Етап погодження",
      "allowNull": false
    },
    {
      "name": "positionID",
      "dataType": "Entity",
      "associatedEntity": "hr_position",
      "caption": "Учасник",
      "description": "Учасник погодження",
      "allowNull": true
    },
    {
      "name": "executionTerm",
      "dataType": "DateTime",
      "caption": "Срок",
      "description": "Срок виконання",
      "allowNull": true
    },
    {
      "name": "executionDate",
      "dataType": "DateTime",
      "caption": "Дата виконання",
      "allowNull": true
    },
    {
      "name": "executionComment",
      "dataType": "Text",
      "caption": "Коментарій",

      "allowNull": true
    },
    {
      "name": "resolution",
      "dataType": "Enum",
      "enumGroup": "HR_PART_RESOLUTION",
      "caption": "Резолюція",
      "allowNull": false,
      "defaultValue": "NEW"
    },
    {
      "name": "resolutionText",
      "dataType": "String",
      "size": 2000,
      "caption": "Зміст резолюції",
      "description": "Зміст резолюції",
      "allowNull": true
    },
    {
      "name": "docID",
      "dataType": "ID",
      "caption": "Ідентифікатор документу",
      "description": "Ідентифікатор документу",
      "allowNull": true,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "[recStageID.docID]"
        }
      ]
    },
    {
      "name": "getCopyAfterRegistration",
      "dataType": "Boolean",
      "caption": "Отримати копію після реєстрації",
      "description": "Ознака, чи повинен учасник узгодження отримувати копію документа після його реєстрації",
      "defaultValue": "0"
    },
    {
      "name": "tempExecEmpPosition",
      "dataType": "Entity",
      "associatedEntity": "hr_employeePositionS",
      "caption": "ТВО",
      "description": "ТВО",
      "allowNull": true
    },
    {
      "name": "employeePosition",
      "dataType": "Entity",
      "associatedEntity": "hr_employeePositionS",
      "caption": "Виконавець",
      "description": "Виконавець",
      "allowNull": true
    },
    {
      "name": "plannedEmployeePosition",
      "dataType": "Entity",
      "associatedEntity": "hr_employeePositionS",
      "caption": "Плановий виконавець",
      "description": "Плановий виконавець plannedOrgUnitEOSID",
      "allowNull": true
    },
    {
      "name": "plannedOrgUnitCaption",
      "dataType": "String",
      "size": 512,
      "caption": "Заголовок",
      "description": "Заголовок",
      "allowNull": true
    },
    {
      "name": "prevParticipantID",
      "dataType": "Entity",
      "associatedEntity": "hr_recparticipant",
      "caption": "Попередній погоджувач",
      "description": "Попередній погоджувач"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": false
    }
  }
}
