{
  "caption": "Скорочення робочого дня/тижня - працівники",
  "description": "Скорочення робочого дня/тижня - працівники",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "timeSheetChangeID",
      "dataType": "Entity",
      "associatedEntity": "hr_timeSheetChange",
      "caption": "Скорочення робочого дня/тижня",
      "description": "Скорочення робочого дня/тижня",
      "documentation": "Скорочення робочого дня/тижня",
      "allowNull": false
    },
    {
      "name": "employeeNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberS",
      "caption": "Табельний номер",
      "description": "Табельний номер",
      "documentation": "Табельний номер",
      "allowNull": false
    },
    {
      "name": "orderState",
      "dataType": "Enum",
      "enumGroup": "HR_ORDER_STATE",
      "caption": "Стан наказу",
      "description": "Стан наказу",
      "documentation": "Стан наказу",
      "defaultValue": "PROJECT",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "allowNull": false
    },
    {
      "name": "flagsFix",
      "dataType": "BigInt",
      "caption": "Маска ознаки фіксації полів",
      "description": "Маска ознаки фіксації полів",
      "documentation": "Маска ознаки фіксації полів"
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}
