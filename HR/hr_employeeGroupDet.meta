{
  "caption": "Група (персонал) - учасники",
  "description": "Група (персонал) - учасники",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "employeeGroupID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeGroup",
      "caption": "Група (персонал)",
      "description": "Група (персонал)",
      "documentation": "Група (персонал)",
      "allowNull": false
    },
    {
      "name": "employeeNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberS",
      "caption": "Учасник",
      "description": "Учасник",
      "documentation": "Учасник",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку",
      "description": "Дата початку",
      "documentation": "Дата початку",
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення",
      "description": "Дата закінчення",
      "documentation": "Дата закінчення",
      "allowNull": false
    },
    {
      "name": "workPlace",
      "dataType": "String",
      "size": 32,
      "caption": "Місце роботи",
      "description": "Місце роботи",
      "documentation": "Місце роботи",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 case when ep.positionID is not null then workPlace else null end from hr_employeePosition ep where ep.employeeNumberID = {self}.employeeNumberID and ep.isActive = 1 and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select case when ep.positionID is not null then workPlace else null end from hr_employeePosition ep where ep.employeeNumberID = {self}.employeeNumberID and ep.isActive = 1 and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата закінчення",
      "description": "Дата закінчення",
      "documentation": "Дата закінчення",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}