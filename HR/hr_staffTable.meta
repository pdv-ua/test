        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select pos.description from hr_position pos where pos.mi_data_id = {self}.respPosition3ID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
