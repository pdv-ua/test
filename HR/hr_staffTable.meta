      "defaultValue": "ACTUAL"
    },
    {
      "name": "massPosChangeParam",
      "dataType": "Json",
      "caption": "Конфігурація змін параметрів посад",
      "description": "Конфігурація змін параметрів посад",
      "documentation": "Конфігурація змін параметрів посад"
    },
    {
      "name": "entryOrderEntryDate",
      "dataType": "Date",
      "caption": "Дата наказа вступу в дію",
      "description": "Дата наказа вступу в дію",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "COALESCE((select top 1 eo.entryDate from hr_empOrder eo where eo.ID = {self}.entryOrderID), (select top 1 eo.entryDate from hr_empOrder eo where eo.staffTableID = {self}.ID and eo.mi_deleteDate >= '9999-12-31'))"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "COALESCE((select eo.entryDate from hr_empOrder eo where eo.ID = {self}.entryOrderID LIMIT 1), (select eo.entryDate from hr_empOrder eo where eo.staffTableID = {self}.ID and eo.mi_deleteDate >= '9999-12-31' LIMIT 1))"
        }
      ]
    },
    {
      "name": "entryOrderDescription",
      "dataType": "String",
      "size": 128,
      "caption": "Наказ вступу в дію",
      "description": "Наказ вступу в дію",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "COALESCE((select top 1 eo.description from hr_empOrder eo where eo.ID = {self}.entryOrderID), (select top 1 eo.description from hr_empOrder eo where eo.staffTableID = {self}.ID and eo.mi_deleteDate >= '9999-12-31'))"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "COALESCE((select eo.description from hr_empOrder eo where eo.ID = {self}.entryOrderID LIMIT 1), (select eo.description from hr_empOrder eo where eo.staffTableID = {self}.ID and eo.mi_deleteDate >= '9999-12-31' LIMIT 1))"
        }
      ]
    },
    {
      "name": "respPosDescription",
      "dataType": "String",
      "size": 2000,
      "caption": "Посада",
      "description": "Посада",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 pos.description from hr_position pos where pos.mi_data_id = {self}.respPositionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select pos.description from hr_position pos where pos.mi_data_id = {self}.respPositionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
