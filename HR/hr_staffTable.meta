      "description": "Стан наказу",
      "documentation": "Стан наказу",
      "defaultValue": "PROJECT",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 255,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва"
    },
    {
      "name": "textOrder",
      "dataType": "String",
      "size": 4000,
