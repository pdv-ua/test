    {
      "name": "respPos5Description",
      "dataType": "String",
      "size": 2000,
      "caption": "Посада",
      "description": "Посада",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 pos.description from hr_position pos where pos.mi_data_id = {self}.respPosition5ID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select pos.description from hr_position pos where pos.mi_data_id = {self}.respPosition5ID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc LIMIT 1)"
        }
      ]
