{
  "caption": "Планування штатного розпису",
  "description": "Планування штатного розпису",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "orderNumber",
      "dataType": "String",
      "size": 30,
      "caption": "Номер",
      "description": "Номер",
      "documentation": "Номер",
      "allowNull": false
    },
    {
      "name": "orderDate",
      "dataType": "Date",
      "caption": "На дату",
      "description": "На дату",
      "documentation": "На дату",
      "allowNull": false
    },
