{
  "caption": "Тарифікаційний список",
  "description": "Тарифікаційний список",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "orderNumber",
      "dataType": "String",
      "size": 30,
      "caption": "Номер",
      "description": "Номер",
      "documentation": "Номер",
      "allowNull": false
    },
    {
      "name": "orderDate",
      "dataType": "Date",
      "caption": "Дата",
      "description": "Дата",
      "documentation": "Дата",
      "allowNull": false
    },
    {
      "name": "entryDate",
      "dataType": "Date",
      "caption": "На дату",
      "description": "На дату",
      "documentation": "На дату",
      "allowNull": false
    },
    {
      "name": "orderState",
      "dataType": "Enum",
      "enumGroup": "HR_ORDER_STATE",
      "caption": "Стан наказу",
      "description": "Стан наказу",
      "documentation": "Стан наказу",
      "defaultValue": "PROJECT",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 255,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва"
    },
    {
      "name": "textOrder",
      "dataType": "String",
      "size": 4000,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис"
    },
    {
      "name": "comment",
      "dataType": "String",
      "size": 512,
      "caption": "Коментар",
      "description": "Коментар",
      "documentation": "Коментар"
    },
    {
      "name": "orgID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організація",
      "description": "Організація",
      "documentation": "Організація",
      "allowNull": false
    },
    {
      "name": "organizationID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організація",
      "description": "Організація",
      "documentation": "Організація",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Field",
          "expression": "orgID"
        }
      ]
    },
    {
      "name": "orgName",
      "dataType": "String",
      "size": 4000,
      "caption": "Організація",
      "description": "Організація",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 org.name from hr_organization org where org.mi_data_id = {self}.orgID and org.state = 'ACTIVE' and org.mi_dateFrom <= {self}.orderDate and org.mi_dateTo >= {self}.orderDate and org.mi_deleteDate >= '9999-12-31' order by org.mi_dateFrom desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select org.name from hr_organization org where org.mi_data_id = {self}.orgID and org.state = 'ACTIVE' and org.mi_dateFrom <= {self}.orderDate and org.mi_dateTo >= {self}.orderDate and org.mi_deleteDate >= '9999-12-31' order by org.mi_dateFrom desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "entryOrderID",
      "dataType": "Entity",
      "associatedEntity": "hr_order",
      "caption": "Наказ вступу в дію",
      "description": "Наказ вступу в дію",
      "documentation": "Наказ вступу в дію"
    },
    {
      "name": "departmentID",
      "dataType": "Entity",
      "associatedEntity": "hr_department",
      "associationAttr": "mi_data_id",
      "caption": "Підрозділ",
      "description": "Підрозділ",
      "documentation": "Підрозділ"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 500,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "allowNull": false,
      "customSettings": {
        "compositeFields": ["orderNumber", "orderDate"],
        "compositeSeparator": ["№ ", " від "]
      }
    },
    {
      "name": "notes",
      "dataType": "String",
      "size": 128,
      "caption": "Примітки",
      "description": "Примітки",
      "documentation": "Примітки"
    },
    {
      "name": "docText",
      "dataType": "Text",
      "caption": "Збережений текст",
      "documentation": "Збережений текст",
      "description": "Збережений текст",
      "allowNull": true
    },
    {
      "name": "document",
      "dataType": "Document",
