{
  "caption": "Присвоєння рангу держслужбовця",
  "description": "Присвоєння рангу держслужбовця",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "employeeID",
      "dataType": "Entity",
      "associatedEntity": "hr_employee",
      "caption": "Особа",
      "description": "Особа",
      "documentation": "Особа",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dictRankID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictRank",
      "caption": "Ранг",
      "description": "Ранг",
      "documentation": "Ранг",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата присвоєння",
      "description": "Дата присвоєння",
      "documentation": "Дата присвоєння",
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Закінчення дії",
      "description": "Закінчення дії",
      "documentation": "Закінчення дії",
      "allowNull": false
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Закінчення дії",
      "description": "Закінчення дії",
      "documentation": "Закінчення дії",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "dateNext",
      "dataType": "Date",
      "caption": "Планована дата присвоєння",
      "description": "Планована дата присвоєння",
      "documentation": "Планована дата присвоєння"
    },
