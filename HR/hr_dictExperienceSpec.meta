{
  "caption": "Підстави обліку спецстажу",
  "description": "Підстави обліку спецстажу",
  "descriptionAttribute": "num",
  "cacheType": "None",
  "attributes": [
    {
      "name": "num",
      "dataType": "Int",
      "caption": "Номер",
      "description": "Номер",
      "documentation": "Номер",
      "allowNull": false
    },
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "fullName",
      "dataType": "String",
      "size": 1000,
      "caption": "Повна назва",
      "description": "Повна назва",
      "documentation": "Повна назва",
      "allowNull": false
    },
    {
      "name": "shortName",
      "dataType": "String",
      "size": 50,
      "caption": "Скорочена назва",
      "description": "Скорочена назва",
      "documentation": "Скорочена назва"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "documentation": "Дата початку дії",
      "description": "Дата початку дії",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "orderN",
      "dataType": "Int",
      "caption": "Впорядкування",
      "description": "Впорядкування",
      "documentation": "Впорядкування",
      "allowNull": false
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 255,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "allowNull": false,
      "customSettings": {
        "compositeFields": [
          "code",
          "shortName"
        ],
        "compositeSeparator": " "
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}
