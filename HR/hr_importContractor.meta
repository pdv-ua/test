{
  "caption": "Контрагент (імпорт)",
  "description": "Контрагент (імпорт)",
  "cacheType": "None",
  "descriptionAttribute": "description",
  "attributes": [
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішня ID",
      "description": "Зовнішня ID",
      "documentation": "Зовнішня ID",
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "dataType": "String",
      "size": 16,
      "caption": "Внутрішній код",
      "description": "Внутрішній код організації",
      "name": "code"
    },
    {
      "dataType": "String",
      "size": 16,
      "caption": "ЄДРПОУ/РНОКПП",
      "description": "ЄДРПОУ/РНОКПП",
      "name": "OKPOCode"
    },
    {
      "dataType": "String",
      "size": 32,
      "caption": "Податковий №",
      "description": "Податковий номер",
      "name": "taxCode"
    },
    {
      "dataType": "BigInt",
      "caption": "Тип організації",
      "description": "Тип організації",
      "name": "orgBusinessTypeID"
    },
    {
      "dataType": "String",
      "size": 32,
      "caption": "№ св. ПДВ",
      "description": "№ свідоцтва платника ПДВ",
      "name": "vatCode"
    },
    {
      "dataType": "String",
      "size": 128,
      "caption": "Назва організації",
      "description": "Назва без лапок та абревіатур",
      "name": "name"
    },
    {
      "dataType": "String",
      "size": 256,
      "caption": "Повна назва організації",
      "description": "Повна назва організації, як це вказано в свідоцтві про реєстрацію",
      "name": "fullName"
    },
    {
      "dataType": "String",
      "size": 128,
      "caption": "Назва організації в родовому відмінку",
      "description": "Назва без лапок та абревіатур у родовому відмінку",
      "name": "nameGen"
    },
    {
      "dataType": "String",
      "size": 128,
      "caption": "Назва організації в давальному відмінку",
      "description": "Назва без лапок та абревіатур у давальному відмінку",
      "name": "nameDat"
    },
    {
      "dataType": "String",
      "size": 255,
      "caption": "Повна назва організації в родовому відмінку",
      "description": "Повна назва організації, як це вказано в свідоцтві про реєстрацію, в родовому відмінку",
      "name": "fullNameGen"
    },
    {
      "dataType": "String",
      "size": 255,
      "caption": "Повна назва організації в давальному відмінку",
      "description": "Повна назва організації, як це вказано в свідоцтві про реєстрацію, в давальному відмінку",
      "name": "fullNameDat"
    },
    {
      "dataType": "String",
      "size": 255,
      "caption": "Опис",
      "description": "Опис організації",
      "name": "description"
    },
    {
      "name": "contrType",
      "dataType": "Enum",
      "enumGroup": "AC_CONTRACTOR_TYPE",
      "caption": "Тип контрагента",
      "description": "Тип контрагента",
      "defaultValue": "legalEntitie"
    },
    {
      "dataType": "Text",
      "caption": "Формулювання адресата",
      "description": "Формулювання адресата, яке буде відображатися при генерації PDF образу вихідного документа",
      "name": "addrText"
    },
    {
      "dataType": "String",
      "size": 255,
      "caption": "Заголовок",
      "description": "Заголовок",
      "name": "caption"
    },
    {
      "dataType": "Boolean",
      "caption": "Нерезидент",
      "description": "Нерезидент",
      "name": "nonResident",
      "defaultValue": "0"
    },
    {
      "name": "impOrgID",
      "dataType": "BigInt",
      "caption": "Зовнішня організаційна одиниця",
      "description": "Зовнішня організаційна одиниця",
      "documentation": "Зовнішня організаційна одиниця"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": false,
      "safeDelete": false
    },
    "audit": {
      "enabled": false
    }
  }
}