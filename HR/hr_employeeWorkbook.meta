    },
    {
      "name": "organizationID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організація",
      "description": "Організація",
      "documentation": "Організація",
      "allowNull": true
    },
    {
      "name": "isManualWorkPlace",
      "dataType": "Boolean",
      "caption": "Ручне введення",
      "description": "Ручне введення",
      "documentation": "Ручне введення",
      "defaultValue": "0",
      "allowNull": false
    },
    {
      "name": "isAuto",
      "dataType": "Boolean",
      "caption": "Створений автоматично",
      "description": "Створений автоматично",
      "documentation": "Створений автоматично",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(case when {self}.employeePositionID is null then 0 else 1 end)"
        }
      ]
    },
    {
      "name": "isOrgAppoint",
      "dataType": "Boolean",
      "caption": "Є призначенням",
      "description": "Запис про призначення на посаду в організації (прийом)",
      "documentation": "Запис про призначення на посаду в організації (прийом)",
      "defaultValue": "0",
      "allowNull": false
    },
    {
      "name": "isOrgDismiss",
      "dataType": "Boolean",
      "caption": "Є звільненням",
      "description": "Запис про звільнення з організації",
      "documentation": "Запис про звільнення з організації",
      "defaultValue": "0",
      "allowNull": false
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата закінчення",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "impEmployeeID",
      "dataType": "BigInt",
      "caption": "Зовнішній ID особи",
      "description": "Зовнішній ID особи",
      "documentation": "Використовується тільки при імпорті"
    },
    {
      "name": "taxCode",
      "dataType": "String",
      "size": 20,
      "caption": "РНОКПП",
      "description": "РНОКПП",
      "documentation": "Використовується тільки при імпорті",
      "allowNull": true,
      "isUnique": true,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "select null"
        }
      ]
    },
    {
      "name": "fullFIO",
      "dataType": "String",
      "size": 512,
      "caption": "Повне ім'я",
      "description": "Повне ім'я",
      "documentation": "Використовується тільки при імпорті",
      "allowNull": true,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "select null"
        }
      ]
    },{
      "name": "birthDate",
      "dataType": "Date",
      "caption": "Дата народження",
      "description": "Дата народження",
      "documentation": "Використовується тільки при імпорті",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "select null"
        }
      ]
    },
    {
      "name": "hasDetails",
      "dataType": "BigInt",
      "caption": "Стажі внесені",
      "description": "Стажі внесені",
      "documentation": "Стажі внесені",
      "allowNull": true,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select count(*) from hr_employeeWorkbookDt dt where dt.employeeWorkbookID = {self}.ID and mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
      "name": "impSourceID",
      "dataType": "BigInt",
      "caption": "Код джерела",
      "description": "Код джерела даних імпорту",
      "documentation": "Код джерела даних імпорту",
      "allowNull": true
    },
    {
      "name": "rank",
      "dataType": "String",
      "size": 50,
      "caption": "Ранг",
      "description": "Ранг",
      "documentation": "Ранг",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 r.name from hr_publServRang psr inner join hr_dictRank r on r.ID = psr.dictRankID and r.mi_deleteDate >= '9999-12-31' where psr.employeeID = {self}.employeeID and psr.mi_deleteDate >= '9999-12-31' and {self}.dateFrom between psr.dateFrom and psr.dateTo)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select r.name from hr_publServRang psr inner join hr_dictRank r on r.ID = psr.dictRankID and r.mi_deleteDate >= '9999-12-31' where psr.employeeID = {self}.employeeID and psr.mi_deleteDate >= '9999-12-31' and {self}.dateFrom between psr.dateFrom and psr.dateTo LIMIT 1)"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "unity": {
      "entity": "hr_attachEntity",
      "attributeList": [],
      "defaults": {
        "entityName": "hr_employeeWorkbook"
      }
    }
  }
}