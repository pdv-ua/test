{
  "caption": "Тарифи для видів робіт",
  "description": "Тарифи для видів робіт",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "dictWorkTypeID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictWorkType",
      "caption": "Вид роботи",
      "cascadeDelete": true,
      "description": "Вид роботи",
      "documentation": "Вид роботи"
    },
    {
      "name": "tariffSum",
      "dataType": "Currency",
      "caption": "Тариф",
      "documentation": "Тариф",
      "description": "Тариф",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "allowNull": false
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 255,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "customSettings": {
        "compositeFields": ["tariffSum","dateFrom"],
        "compositeSeparator": " з "
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}