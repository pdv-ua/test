{
  "caption": "Причина нагородження",
  "description": "Причина нагородження",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 40,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "abbr",
      "dataType": "String",
      "size": 20,
      "caption": "Абревіатура",
      "description": "Абревіатура",
      "documentation": "Абревіатура",
      "allowNull": true
    },
    {
      "name": "isOneOff",
      "dataType": "Boolean",
      "caption": "Одноразовий",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Діє по",
      "documentation": "Діє по. виводити тільки при Вкл. ознаці Одноразовий (isOneOff)",
      "description": "Діє по",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "description": "Діє з",
      "documentation": "Діє з",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}