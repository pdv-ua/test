      "allowNull": true,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select count(*) from hr_empAssessmentResult er where er.assessmentID = {self}.ID and er.mi_deleteDate >= '9999-12-31')"
        }
      ]
    },
    {
