      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 ID from hr_empAssessmentResult er where er.assessmentID = {self}.ID and er.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select ID from hr_empAssessmentResult er where er.assessmentID = {self}.ID and er.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ]
