      "defaultValue": "0"
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 255,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "customSettings": {
        "compositeFields": ["illnessKind", "serie", "number", "dateFrom", "dateTo", "illnessReasonID.name"],
        "compositeSeparator": ["",  " ", " № ", " з ", " по ", " "],
        "caption": ""
      }
    },
    {
      "name": "sicknessMeeting",
      "dataType": "String",
      "size": 300,
      "caption": "Протокол комісії",
      "description": "Протокол комісії",
      "documentation": "Протокол комісії",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 sm.description from hr_sicknessMeetingDt det left join hr_sicknessMeeting sm on sm.ID = det.sicknessMeetingID where det.empOrderSicknessID = {self}.ID and det.mi_deleteDate >= '9999-12-31' and sm.mi_deleteDate >= '9999-12-31') "
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select sm.description from hr_sicknessMeetingDt det left join hr_sicknessMeeting sm on sm.ID = det.sicknessMeetingID where det.empOrderSicknessID = {self}.ID and det.mi_deleteDate >= '9999-12-31' and sm.mi_deleteDate >= '9999-12-31' limit 1) "
        }
      ]
    },
    {
      "name": "sicknessRequis",
      "dataType": "String",
      "size": 600,
      "caption": "Заява-розрахунок",
      "description": "Заява-розрахунок",
      "documentation": "Заява-розрахунок",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 sr.description FROM hr_accrual acc INNER JOIN hr_sicknessRequisAccrual sra ON acc.ID=sra.accrualID INNER JOIN hr_sicknessRequisDt dt ON sra.sicknessRequisDtID=dt.ID INNER JOIN hr_sicknessRequis sr ON sr.ID = dt.sicknessRequisID WHERE acc.employeeNumberID = {self}.employeeNumberID and acc.orgID = {self}.organizationID and acc.empOrderID = {self}.ID AND dt.mi_deleteDate >='9999-12-31') "
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT sr.description FROM hr_accrual acc INNER JOIN hr_sicknessRequisAccrual sra ON acc.ID=sra.accrualID INNER JOIN hr_sicknessRequisDt dt ON sra.sicknessRequisDtID=dt.ID INNER JOIN hr_sicknessRequis sr ON sr.ID = dt.sicknessRequisID WHERE acc.employeeNumberID = {self}.employeeNumberID and acc.orgID = {self}.organizationID and acc.empOrderID = {self}.ID AND dt.mi_deleteDate >='9999-12-31' LIMIT 1) "
        }
      ]
    },
    {
      "name": "payRoll",
      "dataType": "String",
      "size": 600,
      "caption": "Виплата",
      "description": "Виплата",
      "documentation": "Виплата",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 CONCAT(pr.description, ' №', pr.orderNumber) FROM hr_accrual acc INNER JOIN hr_sicknessRequisAccrual sra ON acc.ID=sra.accrualID INNER JOIN hr_sicknessRequisDt dt ON sra.sicknessRequisDtID=dt.ID INNER JOIN hr_RollRequis rr ON rr.sicknessRequisID = dt.sicknessRequisID INNER JOIN hr_payRoll pr ON pr.ID = rr.payRollID WHERE acc.employeeNumberID = {self}.employeeNumberID and acc.orgID = {self}.organizationID and acc.empOrderID = {self}.ID AND dt.mi_deleteDate >='9999-12-31') "
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT CONCAT(pr.description, ' №', pr.orderNumber) FROM hr_accrual acc INNER JOIN hr_sicknessRequisAccrual sra ON acc.ID=sra.accrualID INNER JOIN hr_sicknessRequisDt dt ON sra.sicknessRequisDtID=dt.ID INNER JOIN hr_RollRequis rr ON rr.sicknessRequisID = dt.sicknessRequisID INNER JOIN hr_payRoll pr ON pr.ID = rr.payRollID WHERE acc.employeeNumberID = {self}.employeeNumberID and acc.orgID = {self}.organizationID and acc.empOrderID = {self}.ID AND dt.mi_deleteDate >='9999-12-31' LIMIT 1) "
        }
      ]
    }
  ],
  "dbExtensions": {
    "IDX_HR_EMPORDERSICK_DATA": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "employeeID": { "sort": "ASC" },
          "orderState": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" },
          "dateTo": { "sort": "ASC" },
          "illnessKind": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "rls": {
      "func": "RLS.byOrganization"
    }
  }
}