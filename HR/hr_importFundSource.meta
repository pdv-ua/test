{
  "caption": "Джерело фінансування зарплата(імпорт)",
  "description": "Джерело фінансування зарплата (імпорт)",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішня ID",
      "description": "Зовнішня ID",
      "documentation": "Зовнішня ID",
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код"
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 255,
      "caption": "Назва",
      "description": "Назва"
    },
    {
      "name": "impOrgID",
      "dataType": "BigInt",
      "caption": "Зовнішня організаційна одиниця",
      "description": "Зовнішня організаційна одиниця",
      "documentation": "Зовнішня організаційна одиниця"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": false,
      "safeDelete": false
    },
    "audit": {
      "enabled": false
    }
  }

}