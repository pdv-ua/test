{
  "caption": "Нарахування за KPI",
  "description": "Нарахування за KPI",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 256,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "allowNull": false,
      "defaultView": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "excludeOrg",
      "dataType": "Boolean",
      "caption": "Виключення",
      "description": "Виключення організацій",
      "defaultValue": "0"
    },
    {
      "name": "excludeStaff",
      "dataType": "Boolean",
      "caption": "Виключення",
      "description": "Виключення категорій персоналу",
      "defaultValue": "0"
    },
    {
      "name": "excludePosition",
      "dataType": "Boolean",
      "caption": "Виключення",
      "description": "Виключення посад",
      "defaultValue": "0"
    },
    {
      "name": "excludeDepartment",
      "dataType": "Boolean",
      "caption": "Виключення",
      "description": "Виключення підрозділів",
      "defaultValue": "0"
    },
    {
      "name": "excludeWorkPlace",
      "dataType": "Boolean",
      "caption": "Виключення",
      "description": "Виключення місце роботи",
      "defaultValue": "0"
    },
    {
      "name": "excludeWorkerType",
      "dataType": "Boolean",
      "caption": "Виключення",
      "description": "Виключення форма зайнятості ",
      "defaultValue": "0"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}