{
  "caption": "Файли експорту",
  "description": "Файли експорту",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "orgID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 255,
      "caption": "Назва метода",
      "description": "Назва метода",
      "allowNull": false
    },
    {
      "name": "shortName",
      "dataType": "String",
      "size": 50,
      "caption": "Коротка назва метода",
      "description": "Коротка назва метода",
      "allowNull": false
    },
    {
      "name": "nameFile",
      "dataType": "String",
      "size": 50,
      "caption": "Префікс назви файлу",
      "description": "Префікс назви файлу"
    },
    {
      "name": "typeFile",
      "dataType": "Enum",
      "enumGroup": "HR_EXPORT_METHOD_TYPE_FILE",
      "caption": "Тип файлу",
      "description": "Тип файлу",
      "allowNull": false
    },
    {
      "name": "isActive",
      "dataType": "Boolean",
      "caption": "Ознака використання",
      "defaultValue": "1"
    },
    {
      "name": "isNegative",
      "dataType": "Boolean",
      "caption": "Вивантажувати записи з від'ємними сумами в окремий файл",
      "description": "Вивантажувати записи з від'ємними сумами в окремий файл",
      "defaultValue": "0"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}