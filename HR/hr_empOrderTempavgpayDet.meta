  "dbExtensions": {
    "IDX_HR_EMPORDTEMPAVG_ORDERDAT": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "orderID": { "sort": "ASC" },
          "empOrderType": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPORDTEMPAVG_ORGDAT": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "organizationID": { "sort": "ASC" },
          "empOrderType": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "unity": {
      "entity": "hr_empOrderDet",
      "attributeList": [
        "organizationID",
        "departmentID",
        "positionID",
        "empOrderType",
        "orderID",
        "orderState",
        "cancelOrderID",
        "cancelParaID",
