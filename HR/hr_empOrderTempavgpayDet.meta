        "empNameCase",
        "changedValues",
        "dateFrom",
        "dateTo",
        "itemIdx",
        "isGroup"
      ],
      "defaults": {
        "isExternal": "0"
      },
      "mapping": {
        "title": "title"
      }
    }
  }
