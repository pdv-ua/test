{
  "caption": "Надбавки до посадових окладів за вислугу років держслужбовців",
  "description": "Надбавки до посадових окладів за вислугу років держслужбовців",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "yearFrom",
      "dataType": "Int",
      "size": 8,
      "caption": "Років з",
      "documentation": "Років з",
      "description": "Років з",
      "allowNull": false
    },
    {
      "name": "yearTo",
      "dataType": "Int",
      "size": 8,
      "caption": "Років по",
      "documentation": "Років по",
      "description": "Років по",
      "allowNull": false
    },
    {
      "name": "payRate",
      "dataType": "Float",
      "caption": "Відсоток надбавки",
      "description": "Відсоток надбавки",
      "documentation": "Відсоток надбавки",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}