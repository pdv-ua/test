{
  "caption": "Підстава змін окладів",
  "description": "Підстава змін окладів",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 40,
      "caption": "Код",
      "allowNull": false,
      "isUnique": true
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 240,
      "caption": "Найменування",
      "allowNull": false
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 300,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "allowNull": false,
      "customSettings": {
        "compositeFields": ["code", "name"],
        "compositeSeparator": " "
      }
    },
    {
      "name": "isIndexSalary",
      "dataType": "Boolean",
      "caption": "Індексувати оклад",
      "description": "Індексувати оклад",
      "documentation": "Індексувати оклад",
      "defaultValue": "0"
    },
    {
      "name": "isSignAction",
      "dataType": "Boolean",
      "caption": "Ознака дії",
      "description": "Ознака дії",
      "documentation": "Ознака дії",
      "defaultValue": "0"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}
