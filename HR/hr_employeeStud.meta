      "allowNull": false
    },
    {
      "name": "payOutID",
      "dataType": "Entity",
      "associatedEntity": "hr_payOut",
      "caption": "Шаблон виплати",
      "description": "Шаблон виплати",
      "documentation": "Шаблон виплати"
    },
    {
      "name": "personalAccount",
      "dataType": "String",
      "size": 30,
      "caption": "Номер особового рахунку",
      "description": "Номер особового рахунку",
      "documentation": "Номер особового рахунку"
    },
    {
      "name": "parentEmpNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberSR",
      "caption": "Попередній особовий рахунок",
      "description": "Попередній особовий рахунок"
    },
    {
      "name": "childEmpNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberS",
      "caption": "Наступний особовий рахунок",
      "description": "Наступний особовий рахунок",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 n.ID from hr_employeeNumber n where n.parentEmpNumberID = {self}.ID AND n.mi_deleteDate >= '9999-12-31' order by n.dateFrom)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select n.ID from hr_employeeNumber n where n.parentEmpNumberID = {self}.ID AND n.mi_deleteDate >= '9999-12-31' order by n.dateFrom LIMIT 1)"
        }
      ]
    },
    {
      "name": "bankSubAccount",
      "dataType": "String",
      "size": 256,
      "caption": "Номер субрахунку",
      "description": "Номер субрахунку",
      "documentation": "Номер субрахунку"
    },
    {
      "name": "posName",
      "dataType": "String",
      "size": 4000,
      "caption": "Посада",
      "description": "Посада",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 (case when pos.name IS NOT NULL then pos.name else dp.name end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select (case when pos.name IS NOT NULL then pos.name else dp.name end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "positionName",
      "dataType": "String",
      "size": 4000,
      "caption": "Штатна посада",
      "description": "Штатна посада",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 pos.name from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select pos.name from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "dictPositionName",
      "dataType": "String",
      "size": 4000,
      "caption": "Посада з довідника посад",
      "description": "Посада з довідника посад",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 dp.name from hr_employeePosition ep left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select dp.name from hr_employeePosition ep left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "descriptionExt",
      "dataType": "String",
      "size": 4000,
      "caption": "Опис",
      "description": "Опис",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "({self}.description + ' ' + coalesce((select top 1 (case when pos.ID IS NOT NULL then pos.caption else dp.caption end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc), ''))"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CONCAT({self}.description, ' ', coalesce((select (case when pos.ID IS NOT NULL then pos.caption else dp.caption end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc LIMIT 1), '')))"
        }
      ]
    },
    {
      "name": "posCaption",
      "dataType": "String",
      "size": 4000,
      "caption": "Посада",
      "description": "Посада",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 (case when pos.ID IS NOT NULL then pos.caption else dp.caption end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select (case when pos.ID IS NOT NULL then pos.caption else dp.caption end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "posCategoryName",
      "dataType": "String",
      "size": 4000,
      "caption": "Категорія посади",
      "description": "Категорія посади",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 (case when pos.positionCategory IS NOT NULL OR pos.psCategory IS NOT NULL  then COALESCE(pos.positionCategory, pos.psCategory) else COALESCE(dp.positionCategory, pos.psCategory) end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1   and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select (case when pos.positionCategory IS NOT NULL OR pos.psCategory IS NOT NULL  then COALESCE(pos.positionCategory, pos.psCategory) else COALESCE(dp.positionCategory, pos.psCategory) end) from hr_employeePosition ep left join hr_position pos on pos.mi_data_id = ep.positionID and pos.orgID = ep.organizationID and pos.state = 'ACTIVE' and pos.mi_dateFrom <= ep.dateTo and pos.mi_deleteDate >= '9999-12-31' left join hr_dictPosition dp ON dp.ID = ep.dictPositionID where ep.employeeNumberID = {self}.ID and ep.isActive = 1   and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, pos.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "posOrderID",
      "dataType": "BigInt",
      "caption": "Наказ про призначення чи переміщення на посаду",
      "description": "Останній наказ про призначення чи переміщення на посаду",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 ep.orderID from hr_employeePosition ep left join hr_empOrder eo on eo.ID = ep.orderID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select ep.orderID from hr_employeePosition ep left join hr_empOrder eo on eo.ID = ep.orderID where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "appointOrderID",
      "dataType": "Entity",
      "associatedEntity": "hr_empOrder",
      "caption": "Наказ про призначення на посаду",
      "description": "Останній наказ про призначення на посаду",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 ep.orderID from hr_employeePosition ep left join hr_empOrder eo on eo.ID = ep.orderID and eo.empOrderType = 'APPOINT' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select ep.orderID from hr_employeePosition ep left join hr_empOrder eo on eo.ID = ep.orderID and eo.empOrderType = 'APPOINT' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "appointOrderDetID",
      "dataType": "Entity",
      "associatedEntity": "hr_empOrderDet",
      "caption": "Пункт наказу про призначення на посаду",
      "description": "Останній пункт наказу про призначення на посаду",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 od.ID from hr_employeePosition ep left join hr_empOrder eo on eo.ID = ep.orderID and eo.empOrderType = 'APPOINT' join hr_empOrderDet od on od.orderID = eo.ID and od.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' and od.employeeNumberID = {self}.ID order by ep.dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select od.ID from hr_employeePosition ep left join hr_empOrder eo on eo.ID = ep.orderID and eo.empOrderType = 'APPOINT' join hr_empOrderDet od on od.orderID = eo.ID and od.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' and od.employeeNumberID = {self}.ID order by ep.dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "depName",
      "dataType": "String",
      "size": 4000,
      "caption": "Підрозділ",
      "description": "Підрозділ",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 dep.name from hr_employeePosition ep left join hr_department dep on dep.mi_data_id = ep.departmentID and dep.orgID = ep.organizationID and dep.state = 'ACTIVE' and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, dep.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select dep.name from hr_employeePosition ep left join hr_department dep on dep.mi_data_id = ep.departmentID and dep.orgID = ep.organizationID and dep.state = 'ACTIVE' and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, dep.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "depCaption",
      "dataType": "String",
      "size": 4000,
      "caption": "Підрозділ",
      "description": "Підрозділ",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 dep.caption from hr_employeePosition ep left join hr_department dep on dep.mi_data_id = ep.departmentID and dep.orgID = ep.organizationID and dep.state = 'ACTIVE' and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, dep.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select dep.caption from hr_employeePosition ep left join hr_department dep on dep.mi_data_id = ep.departmentID and dep.orgID = ep.organizationID and dep.state = 'ACTIVE' and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, dep.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "facultyCaption",
      "dataType": "String",
      "size": 4000,
      "caption": "Факультет",
      "description": "Факультет",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 dep.caption from hr_studEducationHistory seh left join hr_department dep on dep.mi_data_id = seh.departmentID and dep.state = 'ACTIVE' and dep.mi_dateFrom <= seh.dateTo and dep.mi_deleteDate >= '9999-12-31' where seh.employeeNumberID = {self}.ID AND seh.employeeID = {self}.employeeID and seh.mi_deleteDate >= '9999-12-31' order by seh.dateTo desc, dep.mi_dateTo desc, seh.mi_createDate desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select dep.caption from hr_studEducationHistory seh left join hr_department dep on dep.mi_data_id = seh.departmentID and dep.state = 'ACTIVE' and dep.mi_dateFrom <= seh.dateTo and dep.mi_deleteDate >= '9999-12-31' where seh.employeeNumberID = {self}.ID AND seh.employeeID = {self}.employeeID and seh.mi_deleteDate >= '9999-12-31' order by seh.dateTo desc, dep.mi_dateTo desc, seh.mi_createDate desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "depID",
      "dataType": "BigInt",
      "caption": "Підрозділ",
      "description": "Підрозділ",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 dep.mi_data_id from hr_employeePosition ep left join hr_department dep on dep.mi_data_id = ep.departmentID and dep.orgID = ep.organizationID and  dep.state = 'ACTIVE' and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by  ep.dateTo desc, dep.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select dep.mi_data_id from hr_employeePosition ep left join hr_department dep on dep.mi_data_id = ep.departmentID and dep.orgID = ep.organizationID and  dep.state = 'ACTIVE' and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31' where ep.employeeNumberID = {self}.ID and ep.isActive = 1  and ep.mi_deleteDate >= '9999-12-31' order by  ep.dateTo desc, dep.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "parentUnitDepName",
      "dataType": "String",
      "size": 4000,
      "caption": "Підпорядкування підрозділу",
      "description": "Підпорядкування підрозділу",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 dep2.name from hr_department dep2 where dep2.mi_data_id = (SELECT TOP 1 dep.parentUnitID FROM hr_employeePosition ep LEFT JOIN hr_department dep ON dep.mi_data_id = ep.departmentID AND dep.orgID = ep.organizationID AND dep.state = 'ACTIVE' AND dep.mi_dateFrom <= ep.dateTo AND dep.mi_deleteDate >= '9999-12-31' WHERE ep.employeeNumberID = {self}.ID AND ep.isActive = 1 AND ep.mi_deleteDate >= '9999-12-31' ORDER BY ep.dateTo DESC, dep.mi_dateTo DESC) and dep2.state = 'ACTIVE' ORDER BY dep2.mi_dateTo DESC)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select dep2.name from hr_department dep2 where dep2.mi_data_id = (SELECT dep.parentUnitID FROM hr_employeePosition ep LEFT JOIN hr_department dep ON dep.mi_data_id = ep.departmentID AND dep.orgID = ep.organizationID AND dep.state = 'ACTIVE' AND dep.mi_dateFrom <= ep.dateTo AND dep.mi_deleteDate >= '9999-12-31' WHERE ep.employeeNumberID = {self}.ID AND ep.isActive = 1 AND ep.mi_deleteDate >= '9999-12-31' ORDER BY ep.dateTo DESC, dep.mi_dateTo DESC LIMIT 1) and dep2.state = 'ACTIVE' ORDER BY dep2.mi_dateTo DESC LIMIT 1)"
        }
      ]
    },
