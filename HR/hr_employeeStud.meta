    {
      "name": "appointDateFrom",
      "dataType": "Date",
      "caption": "Дата початку призначення",
      "description": "Дата початку призначення",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 ep.dateFrom from hr_employeePosition ep left join hr_order o on o.ID = ep.orderID where ep.employeeNumberID = {self}.ID and ep.isActive = 1 and ep.mi_deleteDate >= '9999-12-31' and o.empOrderType in ('APPOINT', 'APPOINT_MOVE', 'APPOINT_LIQ', 'MOVE', 'PLURALIST', 'CANCELDISM') order by ep.dateFrom desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select ep.dateFrom from hr_employeePosition ep left join hr_order o on o.ID = ep.orderID where ep.employeeNumberID = {self}.ID and ep.isActive = 1 and ep.mi_deleteDate >= '9999-12-31' and o.empOrderType in ('APPOINT', 'APPOINT_MOVE', 'APPOINT_LIQ', 'MOVE', 'PLURALIST', 'CANCELDISM') order by ep.dateFrom desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "appointDateTo",
      "dataType": "Date",
      "caption": "Дата закінчення",
      "description": "Дата закінчення",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 case year(ep.dateTo) when 9999 then null else ep.dateTo end from hr_employeePosition ep where ep.employeeNumberID = {self}.ID and ep.isActive = 1 and (ep.dateFrom <= {self}.dateTo or {self}.dateTo is null) and ep.dateTo >= {self}.dateFrom and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select (case Extract(YEAR from ep.dateTo) when 9999 then null else ep.dateTo end) from hr_employeePosition ep where ep.employeeNumberID = {self}.ID and ep.isActive = 1 and (ep.dateFrom <= {self}.dateTo or {self}.dateTo is null) and ep.dateTo >= {self}.dateFrom and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc LIMIT 1)"
        }
      ]
    },
