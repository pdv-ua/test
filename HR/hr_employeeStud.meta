          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT top 1 d.name from hr_department d where d.orgID = {self}.orgID and d.parentUnitID = {self}.orgID and state = 'ACTIVE' and (select top 1 dep.mi_treePath from hr_employeePosition ep  left join hr_department dep on dep.mi_data_id = ep.departmentID  and dep.orgID = ep.organizationID and dep.state = 'ACTIVE'  and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31'  where ep.employeeNumberID = {self}.ID and ep.isActive = 1   and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, dep.mi_dateTo desc) LIKE CONCAT('%',d.mi_treePath,'%') order by d.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT d.name from hr_department d where d.orgID = {self}.orgID and d.parentUnitID = {self}.orgID and state = 'ACTIVE' and (select dep.mi_treePath from hr_employeePosition ep  left join hr_department dep on dep.mi_data_id = ep.departmentID  and dep.orgID = ep.organizationID and dep.state = 'ACTIVE'  and dep.mi_dateFrom <= ep.dateTo and dep.mi_deleteDate >= '9999-12-31'  where ep.employeeNumberID = {self}.ID and ep.isActive = 1   and ep.mi_deleteDate >= '9999-12-31' order by ep.dateTo desc, dep.mi_dateTo desc LIMIT 1) LIKE CONCAT('%',d.mi_treePath,'%') order by d.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
