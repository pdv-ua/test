    },
    {
      "name": "appointmentOrderDate",
      "dataType": "Date",
      "caption": "Дата наказу призначення на поточну посаду",
      "description": "Дата наказу  призначення на поточну посаду",
      "documentation": "Дата наказу  призначення на поточну посаду"
    },
    {
      "name": "appointmentOrderNumber",
