    },
    {
      "name": "testDateTo",
      "dataType": "Date",
      "caption": "Дата закінчення випробувального строку",
      "description": "Дата закінчення випробувального строку",
      "documentation": "Дата закінчення випробувального строку"
    },
    {
      "name": "planDateTo",
      "dataType": "Date",
      "caption": "Планова дата звільнення",
      "description": "Планова дата звільнення",
      "documentation": "Планова дата звільнення"
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата звільнення",
      "description": "Дата звільнення",
      "documentation": "Дата звільнення"
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата звільнення",
      "description": "Дата звільнення",
      "documentation": "Дата звільнення",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "appointmentDate",
      "dataType": "Date",
      "caption": "Дата призначення на поточну посаду",
