{
  "caption": "Реєстр електронних табелів",
  "description": "Реєстр електронних табелів",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "orderState",
      "dataType": "Enum",
      "enumGroup": "HR_ORDER_STATE",
      "caption": "Стан наказу",
      "description": "Стан наказу",
      "defaultValue": "PROJECT",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "empOrderType",
      "dataType": "Enum",
      "enumGroup": "HR_EMPORDRETYPE",
      "caption": "Тип наказу",
      "description": "Тип наказу",
      "allowNull": false,
      "defaultValue": "REGISTRYSHEET"
    },
    {
      "name": "docText",
      "dataType": "Text",
      "caption": "Збережений текст",
      "description": "Збережений текст"
    },
    {
      "name": "document",
      "dataType": "Document",
      "caption": "PDF образ",
      "description": "PDF образ"
    },
    {
      "name": "organizationID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організація",
      "description": "Організація",
      "allowNull": false
    },
    {
      "name": "periodSalaryID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictPeriod",
      "caption": "Обліковий період",
      "description": "Обліковий період",
      "allowNull": false
    },
    {
      "name": "periodCalcID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictPeriod",
      "caption": "Розрахунковий період",
      "description": "Розрахунковий період",
      "allowNull": false
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 512,
      "caption": "Опис",
      "description": "Опис",
      "allowNull": false
    },
    {
      "name": "verSheet",
      "dataType": "Int",
      "caption": "Версія",
      "description": "Версія",
      "allowNull": false
    },
    {
      "name": "departmentID",
      "dataType": "Entity",
      "associatedEntity": "hr_department",
      "caption": "Підрозділ",
      "description": "Підрозділ"
    },
    {
      "name": "includeSubDep",
      "dataType": "Boolean",
      "caption": "з підлеглими",
      "description": "з підлеглими",
      "defaultValue": "0"
    },
    {
      "name": "sheetType",
      "dataType": "Enum",
      "enumGroup": "HR_TYPE_REGISTRY_SHEET",
      "caption": "Тип",
      "description": "Тип",
      "allowNull": false
    },
    {
      "name": "employeeNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberS",
      "caption": "Таб.номер співробітника",
      "description": "Таб.номер співробітника",
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}
