{
  "caption": "Тарифні розряди, коефіцієнти",
  "description": "Тарифні розряди, коефіцієнти",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 5,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 32,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "koef",
      "dataType": "Float",
      "caption": "Коефіцієнт",
      "description": "Коефіцієнт",
      "documentation": "Коефіцієнт",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "allowNull": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "baseAccrual",
      "dataType": "Boolean",
      "caption": "Базовий оклад",
      "description": "Базовий оклад",
      "documentation": "Базовий оклад",
      "defaultValue": "0"
    },
    {
      "name": "accrualSum",
      "dataType": "Currency",
      "caption": "Сума окладу (поточна)",
      "description": "Сума окладу (поточна)",
      "documentation": "Сума окладу (поточна)",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select TOP 1 det.accrualSum from hr_dictTarifCoeffDet det where det.dictTarifCoeffID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select det.accrualSum from hr_dictTarifCoeffDet det where det.dictTarifCoeffID = {self}.ID and det.mi_deleteDate >= '9999-12-31' order by dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 50,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис",
      "defaultView": false,
      "allowNull": false,
      "customSettings": {
        "compositeFields": ["code","name"],
        "compositeSeparator": " "
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}