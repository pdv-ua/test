{
  "caption": "Ступінь споріднення",
  "description": "Ступінь споріднення",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 10,
      "caption": "Код",
      "description": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 50,
      "caption": "Назва",
      "description": "Назва",
      "allowNull": false
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 50,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "{self}.name"
        }
      ],
      "caption": "Опис",
      "description": "Опис"
    },
    {
      "name": "nameBackwardMale",
      "dataType": "String",
      "size": 50,
      "caption": "Працівник по відношенню до нього (ч.с.)",
      "description": "Працівник по відношенню до нього (ч.с.)"
    },
    {
      "name": "nameBackwardFemale",
      "dataType": "String",
      "size": 50,
      "caption": "Працівник по відношенню до нього (ж.с.)",
      "description": "Працівник по відношенню до нього (ж.с.)"
    },
    {
      "name": "genNameBackwardMale",
      "dataType": "String",
      "size": 50,
      "caption": "Працівник по відношенню до нього (ч.с.) (родовий)",
      "description": "Працівник по відношенню до нього (ч.с.) (родовий)"
    },
    {
      "name": "genNameBackwardFemale",
      "dataType": "String",
      "size": 50,
      "caption": "Працівник по відношенню до нього (ж.с.) (родовий)",
      "description": "Працівник по відношенню до нього (ж.с.) (родовий)"
    },
    {
      "name": "isChild",
      "dataType": "Boolean",
      "caption": "Дитина",
      "description": "Дитина",
      "defaultValue": "0"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }

}