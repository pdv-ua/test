          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select fs.dictFundSourceID from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID AND fs.mi_deleteDate >= '9999-12-31' order by fs.mtCount desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "dictProgClassID",
      "dataType": "Entity",
      "associatedEntity": "ac_dictProgClass",
      "caption": "КПК",
      "description": "Код програмної класифікації",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(case when (select top 1 fs.dictProgClassID from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID AND fs.mi_deleteDate >= '9999-12-31'  order by fs.mtCount desc) IS NOT NULL THEN (select top 1 fs.dictProgClassID from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID AND fs.mi_deleteDate >= '9999-12-31' order by fs.mtCount desc) ELSE {self}.dictProgClassID END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(case when (select fs.dictProgClassID from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID AND fs.mi_deleteDate >= '9999-12-31'  order by fs.mtCount desc LIMIT 1) IS NOT NULL THEN (select fs.dictProgClassID from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID AND fs.mi_deleteDate >= '9999-12-31' order by fs.mtCount desc LIMIT 1) ELSE {self}.dictProgClassID END)"
        }
      ]
    },
