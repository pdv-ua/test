      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 fs.name from hr_position pos left join ac_fundSource fs on fs.ID = pos.dictFundSourceID AND fs.mi_deleteDate >= '9999-12-31' where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc) "
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select fs.name from hr_position pos left join ac_fundSource fs on fs.ID = pos.dictFundSourceID AND fs.mi_deleteDate >= '9999-12-31' where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc LIMIT 1) "
        }
      ]
    },
    {
      "name": "fundSourceName",
      "dataType": "String",
      "size": 600,
      "caption": "Джерело фінансування",
      "description": "Джерело фінансування",
      "documentation": "Джерело фінансування",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 CONCAT(fs.description, CASE WHEN df.description IS NULL THEN '' ELSE CONCAT(' ', '(', df.description, ')') END) FROM ac_fundSource fs LEFT JOIN ac_dictFundSource df ON fs.ID = df.fundSourceID AND df.organizationID={self}.organizationID WHERE fs.ID = (select top 1 fs.dictFundSourceID from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID AND fs.mi_deleteDate >= '9999-12-31' AND df.mi_deleteDate >= '9999-12-31' order by fs.mtCount desc))"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT CONCAT(fs.description, CASE WHEN df.description IS NULL THEN '' ELSE CONCAT(' ', '(', df.description, ')') END) FROM ac_fundSource fs LEFT JOIN ac_dictFundSource df ON fs.ID = df.fundSourceID AND df.organizationID={self}.organizationID WHERE fs.ID = (select fs.dictFundSourceID from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID AND fs.mi_deleteDate >= '9999-12-31' AND df.mi_deleteDate >= '9999-12-31' order by fs.mtCount desc LIMIT 1) LIMIT 1)"
        }
      ]
    },
