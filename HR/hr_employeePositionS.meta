        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT ID FROM ac_dictCostType dct WHERE dct.ID = {self}.d0Value OR dct.ID = {self}.d1Value OR dct.ID = {self}.d2Value OR dct.ID = {self}.d3Value OR dct.ID = {self}.d4Value OR dct.ID = {self}.d5Value OR dct.ID = {self}.d6Value OR dct.ID = {self}.d7Value OR dct.ID = {self}.d8Value OR dct.ID = {self}.d9Value) LIMIT 1"
