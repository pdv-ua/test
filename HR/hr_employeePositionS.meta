      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select fs.ID, fs.employeeNumberID, fs.employeePositionID, fs.dictFundSourceID, fs.dictProjectID, fs.dictProgClassID, fs.mtCount, fs.mi_modifyDate from hr_empPosFundSource fs where fs.employeePositionID = {self}.ID and fs.mi_deleteDate >= '9999-12-31' FOR JSON AUTO)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT json_agg(t) FROM (SELECT fs.ID \"ID\", fs.employeeNumberID \"employeeNumberID\", fs.employeePositionID \"employeePositionID\", fs.dictFundSourceID \"dictFundSourceID\", fs.dictProjectID \"dictProjectID\", fs.dictProgClassID \"dictProgClassID\", fs.mtCount \"mtCount\", fs.mi_modifyDate \"mi_modifyDate\" FROM hr_empPosFundSource fs where fs.employeePositionID = {self}.ID and fs.mi_deleteDate >= '9999-12-31') t)"
        }
      ]
