          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT json_agg(t) FROM (SELECT fs.ID \"ID\", fs.employeeNumberID \"employeeNumberID\", fs.employeePositionID \"employeePositionID\", fs.dictFundSourceID \"dictFundSourceID\", fs.mtCount \"mtCount\", dfs.name \"name\", dfs.nominalName \"nominalName\" FROM hr_empPosFundSource fs left join ac_fundSource dfs on dfs.ID = fs.dictFundSourceID where fs.employeePositionID = {self}.ID and fs.mi_deleteDate >= '9999-12-31') t)"
        }
