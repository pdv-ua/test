    {
      "name": "vacancyDateFrom",
      "dataType": "Date",
      "caption": "Вакантна з",
      "description": "Вакантна з",
      "documentation": "Вакантна з",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 a.dateFrom from hr_empLongTermAbsc a where a.employeeNumberID = {self}.employeeNumberID and a.dateFrom <= GETDATE() and a.dateTo >= GETDATE() and a.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select a.dateFrom from hr_empLongTermAbsc a where a.employeeNumberID = {self}.employeeNumberID and a.dateFrom <= CURRENT_DATE and a.dateTo >= CURRENT_DATE and a.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ]
    },
    {
      "name": "vacancyDateTo",
      "dataType": "Date",
      "caption": "Вакантна по",
      "description": "Вакантна по",
      "documentation": "Вакантна по",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 a.dateTo from hr_empLongTermAbsc a where a.employeeNumberID = {self}.employeeNumberID and a.dateFrom <= GETDATE() and a.dateTo >= GETDATE() and a.mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select a.dateTo from hr_empLongTermAbsc a where a.employeeNumberID = {self}.employeeNumberID and a.dateFrom <= CURRENT_DATE and a.dateTo >= CURRENT_DATE and a.mi_deleteDate >= '9999-12-31' LIMIT 1)"
        }
      ]
    },
    {
      "name": "vacancyDateToEmpty",
      "dataType": "Date",
      "caption": "Вакантна по",
      "description": "Вакантна по",
      "documentation": "Вакантна по",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select (case year(t.dateTo) when 9999 then null else t.dateTo end) from (select top 1 a.dateTo dateTo from hr_empLongTermAbsc a where a.employeeNumberID = {self}.employeeNumberID and a.organizationID = {self}.organizationID and a.dateFrom <= GETDATE() and a.dateTo >= GETDATE() and a.mi_deleteDate >= '9999-12-31') t)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "( select (case Extract(YEAR from t.dateTo) when 9999 then null else t.dateTo end) from (select a.dateTo dateTo from hr_empLongTermAbsc a where a.employeeNumberID = {self}.employeeNumberID and a.organizationID = {self}.organizationID and a.dateFrom <= CURRENT_DATE and a.dateTo >= CURRENT_DATE and a.mi_deleteDate >= '9999-12-31' LIMIT 1) t)"
        }
      ]
    },
