    {
      "name": "selfStructDepName",
      "dataType": "String",
      "size": 4000,
      "caption": "Самостійний структурний підрозділ",
      "description": "Самостійний структурний підрозділ",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT top 1 d.name from hr_department d where d.orgID = {self}.organizationID and d.parentUnitID = {self}.organizationID and state = 'ACTIVE' and ( select top 1 dep.mi_treePath  from hr_department dep  where dep.mi_data_id ={self}.departmentID and dep.state = 'ACTIVE'  order by dep.mi_dateTo desc ) LIKE CONCAT('%',d.mi_treePath,'%') order by d.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT d.name from hr_department d where d.orgID = {self}.organizationID and d.parentUnitID = {self}.organizationID and state = 'ACTIVE' and (select dep.mi_treePath  from hr_department dep  where dep.mi_data_id ={self}.departmentID and dep.state = 'ACTIVE'  order by dep.mi_dateTo desc LIMIT 1) LIKE CONCAT('%',d.mi_treePath,'%') order by d.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
