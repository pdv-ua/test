    {
      "name": "accrualSumDPLast",
      "dataType": "Currency",
      "size": 256,
      "caption": "Сума для останнього призначення з групи підрозділ та посада",
      "description": "Сума для останнього призначенні з групи підрозділ та посада",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 ep.accrualSum FROM hr_employeePosition ep where {self}.employeeNumberID = ep.employeeNumberID and ({self}.departmentID is null or {self}.departmentID = ep.departmentID) and ({self}.positionID is null or {self}.positionID = ep.positionID) order by ep.dateFrom desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select ep.accrualSum FROM hr_employeePosition ep where {self}.employeeNumberID = ep.employeeNumberID and ({self}.departmentID is null or {self}.departmentID = ep.departmentID) and ({self}.positionID is null or {self}.positionID = ep.positionID) order by ep.dateFrom desc LIMIT 1)"
        }
      ]
