    {
      "name": "dictTrialPeriodID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictTrialPeriod",
      "caption": "Термін",
      "description": "Термін випробувального періоду",
      "documentation": "Термін випробувального періоду",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 dictTrialPeriodID FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT dictTrialPeriodID FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC LIMIT 1)"
        }
      ]
    },
    {
      "name": "dateTrialEnd",
      "dataType": "Date",
      "caption": "Закінчення випробувального терміну",
      "description": "Закінчення випробувального терміну",
      "documentation": "Закінчення випробувального терміну",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 dateTrialEnd FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT dateTrialEnd FROM hr_employeeTrialPeriod tp WHERE tp.employeeNumberID = {self}.employeeNumberID AND tp.mi_deleteDate >= '9999-12-31' AND (tp.employeePositionID={self}.ID OR tp.positionID={self}.positionID OR tp.employeePositionID IS NULL OR tp.positionID IS NULL) ORDER BY tp.dateFrom DESC LIMIT 1)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
