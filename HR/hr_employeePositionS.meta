      "caption": "Ознака видаленого запису зв'язанного с ОР",
      "description": "Ознака видаленого запису зв'язанного с ОР",
      "documentation": "Ознака видаленого запису зв'язанного с ОР",
      "defaultValue": "0"
    },
    {
      "name": "tabNum",
      "dataType": "String",
      "size": 15,
      "caption": "Табельний номер",
      "description": "Табельний номер",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 en.tabNum from hr_employeeNumber en where en.ID = {self}.employeeNumberID)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select en.tabNum from hr_employeeNumber en where en.ID = {self}.employeeNumberID LIMIT 1)"
        }
      ]
    },
    {
      "name": "orgName",
      "dataType": "String",
      "size": 500,
      "caption": "Організація",
      "description": "Організація",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 org.name from hr_organization org where org.mi_data_id = {self}.organizationID and org.state = 'ACTIVE' AND org.mi_deleteDate >= '9999-12-31' order by org.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select org.name from hr_organization org where org.mi_data_id = {self}.organizationID and org.state = 'ACTIVE' AND org.mi_deleteDate >= '9999-12-31' order by org.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "dictPositionValue",
      "dataType": "BigInt",
      "caption": "Довідник посад",
      "description": "Довідник посад",
      "documentation": "Довідник посад",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(case when {self}.positionID IS NOT NULL then (select top 1 pos.dictPositionID from hr_position pos where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc) else {self}.dictPositionID end)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(case when {self}.positionID IS NOT NULL then (select pos.dictPositionID from hr_position pos where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc LIMIT 1) else {self}.dictPositionID end)"
        }
      ]
    },
    {
      "name": "dictPositionName",
      "dataType": "String",
      "size": 500,
      "caption": "Довідник посад",
      "description": "Довідник посад",
      "documentation": "Довідник посад",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(case when {self}.positionID IS NOT NULL then (select top 1 dictPos.name from hr_position pos inner join hr_dictPosition dictPos on dictPos.ID = pos.dictPositionID and dictPos.mi_deleteDate >= '9999-12-31' where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc) else (select top 1 dictPos.name from hr_dictPosition dictPos where dictPos.ID = {self}.dictPositionID and dictPos.mi_deleteDate >= '9999-12-31') end)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(case when {self}.positionID IS NOT NULL then (select dictPos.name from hr_position pos inner join hr_dictPosition dictPos on dictPos.ID = pos.dictPositionID and dictPos.mi_deleteDate >= '9999-12-31' where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc LIMIT 1) else (select dictPos.name from hr_dictPosition dictPos where dictPos.ID = {self}.dictPositionID and dictPos.mi_deleteDate >= '9999-12-31' LIMIT 1) end)"
        }
      ]
    },
    {
      "name": "posStaffName",
      "dataType": "String",
      "size": 2000,
      "caption": "Штатна посада",
      "description": "Штатна посада",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 pos.name from hr_position pos where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc) "
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select pos.name from hr_position pos where pos.mi_data_id = {self}.positionID and pos.state = 'ACTIVE' AND pos.mi_deleteDate >= '9999-12-31' order by pos.mi_dateTo desc LIMIT 1) "
        }
      ]
    },
    {
      "name": "posStaffNameActual",
      "dataType": "String",
      "size": 2000,
      "caption": "Штатна посада",
      "description": "Штатна посада",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
