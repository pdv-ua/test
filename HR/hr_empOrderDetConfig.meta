  "descriptionAttribute": "empOrderType",
  "cacheType": "None",
  "attributes": [
    {
      "name": "organizationID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "caption": "Організація",
      "description": "Організація",
      "documentation": "Організація",
      "associationAttr": "mi_data_id"
    },
    {
      "name": "empOrderType",
      "dataType": "Enum",
      "enumGroup": "HR_EMPORDRETYPE",
      "caption": "Тип наказу",
      "documentation": "Тип наказу",
      "description": "Тип наказу",
      "allowNull": false
    },
    {
      "name": "empOrderTypeName",
      "dataType": "String",
      "size": 255,
      "caption": "Тип наказу",
      "description": "Тип наказу",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 en.name from ubm_enum en where eGroup = 'HR_EMPORDRETYPE' and en.mi_deleteDate = '9999-12-31' and en.code = {self}.empOrderType)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select en.name from ubm_enum en where eGroup = 'HR_EMPORDRETYPE' and en.mi_deleteDate = '9999-12-31' and en.code = {self}.empOrderType LIMIT 1)"
        }
      ]
    },
    {
      "name": "positionType",
      "dataType": "Enum",
      "enumGroup": "HR_POSITION_TYPE",
      "caption": "Тип посади",
