{
  "caption": "Інші способи виплати зарплати",
  "description": "Інші способи виплати зарплати",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "employeeNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberSR",
      "caption": "Табельний номер",
      "description": "Табельний номер",
      "documentation": "Табельний номер",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку дії",
      "description": "Дата початку дії",
      "documentation": "Дата початку дії",
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата закінчення дії",
      "description": "Дата закінчення дії",
      "documentation": "Дата закінчення дії",
      "allowNull": false
    },
    {
      "name": "personalSubAccount",
      "dataType": "String",
      "size": 256,
      "caption": "Субрахунок",
      "description": "Субрахунок",
      "documentation": "Субрахунок"
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Початок",
      "description": "Початок",
      "documentation": "Початок",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Кінець",
      "description": "Кінець",
      "documentation": "Кінець",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "paymentMethod",
      "dataType": "Enum",
      "enumGroup": "HR_PAYMENT_METHOD",
      "caption": "Спосіб виплати",
      "description": "Спосіб виплати",
      "documentation": "Спосіб виплати",
      "defaultValue": "1",
      "allowNull": false
    },
    {
      "name": "payOutID",
      "dataType": "Entity",
      "associatedEntity": "hr_payOut",
      "caption": "Шаблон виплати",
      "description": "Шаблон виплати",
      "documentation": "Шаблон виплати"
    },
    {
      "name": "bankID",
      "dataType": "Entity",
      "associatedEntity": "ac_bank",
      "caption": "Банк",
      "description": "Банк",
      "documentation": "Банк"
    },
    {
      "name": "bankAccount",
      "dataType": "String",
      "size": 30,
      "caption": "Номер р/р",
      "description": "Розрахунковий рахунок",
      "documentation": "Розрахунковий рахунок"
    },
    {
      "name": "personalAccount",
      "dataType": "String",
      "size": 30,
      "caption": "Номер о/р",
      "description": "Особовий рахунок",
      "documentation": "Особовий рахунок"
    },
    {
      "name": "exportMethodID",
      "dataType": "Entity",
      "associatedEntity": "hr_exportMethod",
      "caption": "Метод експорту",
      "description": "Метод експорту",
      "documentation": "Метод експорту"
    },
    {
      "name": "branchCode",
      "dataType": "String",
      "size": 15,
      "caption": "Код відділення банку",
      "description": "Код відділення банку",
      "documentation": "Код відділення банку"
    },
    {
      "name": "projectCode",
      "dataType": "String",
      "size": 15,
      "caption": "Код зарплатного проєкту",
      "description": "Код зарплатного проєкту",
      "documentation": "Код зарплатного проєкту"
    },
    {
      "name": "exportMethodIdOld",
      "dataType": "String",
      "size": 32,
      "caption": "Метод експорту old",
      "description": "Метод експорту old"
    },
    {
      "name": "isDefault",
      "dataType": "Boolean",
      "caption": "Основний",
      "description": "Основний",
      "defaultValue": "1"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }

}