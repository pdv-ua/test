{
  "caption": "Наказ з персоналу",
  "description": "Наказ з персоналу",
  "descriptionAttribute": "description",
  "cacheType": "None",
  "attributes": [
    {
      "name": "orderNumber",
      "dataType": "String",
      "size": 30,
      "caption": "Номер наказу",
      "description": "Номер наказу",
      "documentation": "Номер наказу",
      "allowNull": false
    },
    {
      "name": "orderNumberFull",
      "dataType": "String",
      "size": 40,
      "caption": "Номер з індексом",
      "description": "Номер з індексом",
      "documentation": "Номер з індексом",
      "allowNull": true
    },
    {
      "name": "orderNumberFullView",
      "dataType": "String",
      "size": 40,
      "caption": "Номер з індексом",
      "description": "Номер з індексом",
      "documentation": "Номер з індексом",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select case when {self}.orderNumberFull is not null then {self}.orderNumberFull when {self}.dictEmpOrderIndexID is null then {self}.orderNumber else CONCAT({self}.orderNumber, '/', (select i.code from hr_dictEmpOrderIndex i where i.ID = {self}.dictEmpOrderIndexID)) end)"
        }
      ]
    },
    {
      "name": "dictEmpOrderIndexID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictEmpOrderIndex",
      "caption": "Індекс",
      "description": "Індекс",
      "documentation": "Індекс",
      "allowNull": true
    },
    {
      "name": "orderDate",
      "dataType": "Date",
      "caption": "Дата наказу",
      "description": "Дата наказу",
      "documentation": "Дата наказу"
    },
    {
      "name": "entryDate",
      "dataType": "Date",
      "caption": "Дата вступу в дію",
      "description": "Дата вступу в дію",
      "documentation": "Дата вступу в дію",
      "allowNull": false
    },
    {
      "name": "orderState",
      "dataType": "Enum",
      "enumGroup": "HR_ORDER_STATE",
      "caption": "Стан наказу",
      "description": "Стан наказу",
      "documentation": "Стан наказу",
      "defaultValue": "PROJECT",
      "defaultView": false,
      "allowNull": false
    },
    {
