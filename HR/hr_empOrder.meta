    },
    {
      "name": "bonusRate",
      "dataType": "Float",
      "caption": "Відсоток",
      "description": "Відсоток",
      "documentation": "Відсоток",
      "allowNull": true
    },
    {
      "name": "isGroupDepart",
      "dataType": "Boolean",
      "caption": "Групувати за підрозділом",
      "documentation": "Групувати за підрозділом",
      "description": "Групувати за підрозділом",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "isGroup",
      "dataType": "Boolean",
      "caption": "Груповий",
      "documentation": "Чи являється наказ груповим",
      "description": "Чи являється наказ груповим",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "isService",
      "dataType": "Boolean",
      "caption": "Технічна операція",
      "documentation": "Технічна операція",
      "description": "Чи наказ додано/проведено в результаті технічнної операції. Скасування такого наказу неможливе",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "particle",
      "dataType": "String",
      "size": 20,
      "caption": "Суфікс друкованої форми",
      "description": "Суфікс, який визначає форму друкованої форми",
      "documentation": "Суфікс, який визначає форму друкованої форми"
    },
    {
      "name": "impDateAppoint",
      "dataType": "Date",
      "caption": "Дата прийому на роботу",
      "description": "Дата прийому на роботу",
      "documentation": "Використовується тільки при імпорті"
    },
    {
      "name": "employeeList",
      "dataType": "String",
      "size": 4000,
      "caption": "Список перших працівників",
      "description": "Список перших працівників",
      "documentation": "Список перших працівників"
    },
    {
      "name": "isAppendix",
      "dataType": "Boolean",
      "caption": "Наказ з додатком",
      "documentation": "Наказ з додатком",
      "description": "Наказ з додатком",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "organizationName",
      "dataType": "String",
      "size": 400,
      "caption": "По організації",
      "documentation": "Організація, по якій створено наказ",
      "description": "Організація, по якій створено наказ",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 description from hr_organization org  where org.mi_data_id = {self}.organizationID and org.state = 'ACTIVE' and {self}.entryDate between org.mi_dateFrom and org.mi_dateTo and mi_deleteDate >= '9999-12-31')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select description from hr_organization org  where org.mi_data_id = {self}.organizationID and org.state = 'ACTIVE' and {self}.entryDate between org.mi_dateFrom and org.mi_dateTo and mi_deleteDate >= '9999-12-31' limit 1)"
        }
      ]
    },
    {
      "name": "mOrganizationName",
      "dataType": "String",
      "size": 400,
      "caption": "Видано в ",
      "documentation": "Головна организація",
      "description": "Головна организація",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select(coalesce({self}.masterOrganizationName, (select top 1 description from hr_organization org  where org.mi_data_id = {self}.masterOrganizationID and org.state = 'ACTIVE' and {self}.entryDate between org.mi_dateFrom and org.mi_dateTo and mi_deleteDate >= '9999-12-31'))))"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select(coalesce({self}.masterOrganizationName, (select description from hr_organization org  where org.mi_data_id = {self}.masterOrganizationID and org.state = 'ACTIVE' and {self}.entryDate between org.mi_dateFrom and org.mi_dateTo and mi_deleteDate >= '9999-12-31' limit 1))))"
        }
      ]
    },
    {
      "name": "allowPosting",
      "dataType": "Boolean",
      "caption": "Дозволено проведення",
      "documentation": "Дозволено проведення",
      "description": "Дозволено проведення",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "skipCancelReconciliation",
      "dataType": "Int",
      "caption": "Не відміняти погодження",
      "description": "Не відміняти погодження",
      "documentation": "Не відміняти погодження",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "select null"
        }
      ]
    },
    {
      "name": "sortItems",
      "dataType": "Enum",
      "enumGroup": "HR_EMP_ORDER_SORT",
      "caption": "Сортувати в тексті",
      "description": "Сортувати в тексті",
      "documentation": "Сортувати в тексті"
    },
    {
      "name": "documentOrderType",
      "dataType": "Enum",
      "enumGroup": "HR_DOCUMENT_APPOINT",
      "caption": "Вид документа",
      "documentation": "Вид документа",
      "description": "Вид документа"
    }
  ],
  "dbExtensions": {
    "IDX_HR_EMPORDER_TYPE": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "empOrderType": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPORDER_ORGSTATE": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "organizationID": { "sort": "ASC" },
          "orderState": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    },
    "rls": {
      "func": "RLS.byEmpOrderOrganization"
    }
  }
}
