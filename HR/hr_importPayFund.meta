{
  "caption": "Нарахування на зарплату (Фонди) (імпорт)",
  "description": "Нарахування на зарплату (Фонди) (імпорт)",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "impID",
      "dataType": "BigInt",
      "caption": "Зовнішня ID",
      "description": "Зовнішня ID",
      "documentation": "Зовнішня ID",
      "allowNull": false
    },
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код"
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 100,
      "caption": "Назва",
      "description": "Назва"
    },
    {
      "name": "payFundMethodID",
      "dataType": "BigInt",
      "caption": "Метод розрахунку",
      "description": "Метод розрахунку",
      "documentation": "Метод розрахунку"
    },
    {
      "name": "typeTaxECBID",
      "dataType": "BigInt",
      "caption": "Тип ставки страхового внеску",
      "description": "Тип ставки страхового внеску",
      "documentation": "Тип ставки страхового внеску"
    },
    {
      "name": "calcPeriod",
      "dataType": "Enum",
      "enumGroup": "HR_ACCPERIOD_TYPE",
      "caption": "Розраховується",
      "description": "Розраховується",
      "defaultValue": "CALC"
    },
    {
      "name": "sequence",
      "dataType": "Int",
      "caption": "Послідовність розрахунку",
      "description": "Послідовність розрахунку",
      "documentation": "Послідовність розрахунку"
    },
    {
      "name": "isAutoCalc",
      "dataType": "Boolean",
      "caption": "Розраховувати автоматично",
      "description": "Розраховувати автоматично",
      "defaultValue": "1"
    },
    {
      "name": "isRecalculate",
      "dataType": "Boolean",
      "caption": "Перераховувати",
      "description": "Перераховувати",
      "defaultValue": "1"
    },
    {
      "name": "entryOperationID",
      "dataType": "BigInt",
      "caption": "Бухгалтерська проводка",
      "description": "Бухгалтерська проводка",
      "documentation": "Бухгалтерська проводка"
    },
    {
      "name": "impOrgID",
      "dataType": "BigInt",
      "caption": "Зовнішня організаційна одиниця",
      "description": "Зовнішня організаційна одиниця",
      "documentation": "Зовнішня організаційна одиниця"
    }
  ],
  "mixins": {
