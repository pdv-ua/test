    },
    {
      "name": "dateDoc",
      "dataType": "Date",
      "caption": "Дата видачи свідоцтва про смерть",
      "description": "Дата видачи свідоцтва про смерть",
      "documentation": "Дата видачи свідоцтва про смерть",
      "allowNull": false
    },
    {
      "name": "actNumber",
      "dataType": "String",
      "size": 10,
      "caption": "Номер акту про нещасний випадок",
      "description": "Номер акту про нещасний випадок",
      "documentation": "Номер акту про нещасний випадок"
    },
    {
      "name": "actDate",
      "dataType": "Date",
      "caption": "Дата акту про нещасний випадок",
      "description": "Дата акту про нещасний випадок",
      "documentation": "Дата акту про нещасний випадок"
    },
    {
      "name": "dateDeath",
      "dataType": "Date",
      "caption": "Дата смерті",
      "description": "Дата смерті",
      "documentation": "Дата смерті",
      "allowNull": false
    },
    {
      "name": "dateFuneral",
      "dataType": "Date",
      "caption": "Дата поховання",
      "description": "Дата поховання",
      "documentation": "Дата поховання",
      "allowNull": false
    },
    {
      "name": "orderState",
      "dataType": "Enum",
      "enumGroup": "HR_ORDER_STATE",
      "caption": "Стан",
      "description": "Стан",
      "documentation": "Стан",
      "defaultValue": "PROJECT",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dead",
      "dataType": "String",
      "size": 200,
      "caption": "Померлий",
      "description": "Померлий",
      "documentation": "Померлий"
    },
    {
      "name": "sertificate",
      "dataType": "String",
      "size": 20,
      "caption": "Свідоцтво про смерть",
      "description": "Свідоцтво про смерть",
      "documentation": "Свідоцтво про смерть",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "CONCAT({self}.seriaDoc, ' ', {self}.numberDoc)"
        }
      ]
    },
    {
      "name": "sicknessMeeting",
      "dataType": "String",
      "size": 100,
      "caption": "Протокол комісії",
      "description": "Протокол комісії",
      "documentation": "Протокол комісії",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "select top 1 sm.description from hr_sicknessMeetingDt smDt inner join hr_sicknessMeeting sm on sm.ID=smDt.sicknessMeetingID where smDt.empOrderFuneralID={self}.ID and smDt.mi_deleteDate>='9999-12-31'"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "select sm.description from hr_sicknessMeetingDt smDt inner join hr_sicknessMeeting sm on sm.ID=smDt.sicknessMeetingID where smDt.empOrderFuneralID={self}.ID and smDt.mi_deleteDate>='9999-12-31' LIMIT 1"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}