      "caption": "Померлий родич",
      "description": "Померлий родич",
      "documentation": "Померлий родич"
    },
    {
      "name": "paySum",
      "dataType": "Currency",
      "caption": "Сума допомоги",
      "description": "Сума допомоги",
      "documentation": "Сума допомоги",
      "allowNull": false
    },
    {
      "name": "addDoc",
      "dataType": "String",
      "size": 500,
      "caption": "Додаткові документи",
      "description": "Додаткові документи",
