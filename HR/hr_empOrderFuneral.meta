      "name": "description",
      "dataType": "String",
      "size": 500,
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис"
    },
    {
      "name": "seriaDoc",
      "dataType": "String",
      "size": 5,
      "caption": "Серія свідоцтва про смерть",
      "description": "Серія свідоцтва про смерть",
      "documentation": "Серія свідоцтва про смерть",
      "allowNull": false
    },
    {
      "name": "numberDoc",
      "dataType": "String",
      "size": 10,
      "caption": "Номер свідоцтва про смерть",
      "description": "Номер свідоцтва про смерть",
      "documentation": "Номер свідоцтва про смерть",
