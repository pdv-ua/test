    {
      "name": "employeeFullName",
      "dataType": "String",
      "size": 120,
      "caption": "ПІБ",
      "documentation": "ПІБ",
      "description": "ПІБ",
      "allowNull": false,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select CONCAT(coalesce({self}.lastName, ''), ' ', coalesce({self}.firstName, ''), ' ', coalesce({self}.middleName, '')))"
        }
      ]
    }
