{
  "caption": "Пільги ПДФО",
  "description": "Пільги ПДФО",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "employeeNumberID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeNumberS",
      "caption": "Табельний номер",
      "description": "Табельний номер",
      "documentation": "Табельний номер",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Діє з",
      "description": "Діє з",
      "documentation": "Діє з",
      "allowNull": true,
      "defaultView": false

    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "allowNull": true,
      "defaultView": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "description": "Діє з",
      "documentation": "Діє з",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "taxLimitID",
      "dataType": "Entity",
      "associatedEntity": "hr_taxLimit",
      "caption": "Вид пільги",
      "documentation": "Вид пільги",
      "description": "Вид пільги",
      "allowNull": false
    },
    {
      "name": "amountChild",
      "dataType": "Int",
      "caption": "Кількість дітей",
      "description": "Кількість дітей",
      "documentation": "Кількість дітей"
    },
    {
      "name": "employeeBenefitsID",
      "dataType": "Entity",
      "associatedEntity": "hr_employeeBenefits",
      "caption": "Пільга",
      "description": "Пільга",
      "documentation": "Пільга",
      "allowNull": true
    }
  ],
