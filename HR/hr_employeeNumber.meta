      "caption": "Тип",
      "documentation": "Тип",
      "description": "Тип",
      "defaultValue": "WORK"
    },
    {
      "name": "empWorkPlace",
      "dataType": "Enum",
      "enumGroup": "HR_WORKER_PLACE",
      "caption": "Місце роботи",
      "documentation": "Місце роботи",
      "description": "Місце роботи"
    },
    {
      "name": "empDictPositionID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictPosition",
      "caption": "Посада",
      "description": "Посада",
      "documentation": "Посада"
    },
    {
      "name": "descriptionWithDates",
      "dataType": "String",
      "size": 1024,
      "caption": "Опис с датами початку та завершення",
      "description": "Опис с датами початку та завершення",
      "documentation": "Опис с датами початку та завершення",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "CONCAT({self}.description, ' (', FORMAT({self}.dateFrom,'dd.MM.yyyy'), ' - ', (CASE year({self}.dateTo) WHEN 9999 THEN null ELSE FORMAT({self}.dateTo,'dd.MM.yyyy') END),')')"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "CONCAT({self}.description, ' (', TO_CHAR({self}.dateFrom,'DD.MM.YYYY'), ' - ', (CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE TO_CHAR({self}.dateTo,'DD.MM.YYYY') END),')')"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}
