  "dbExtensions": {
    "IDX_HR_EMPORDERPROL_ORDERDAT": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "orderID": { "sort": "ASC" },
          "empOrderType": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" }
        },
        "isUnique": false
      }
    },
    "IDX_HR_EMPORDERPROL_ORGDAT": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "organizationID": { "sort": "ASC" },
          "empOrderType": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" },
          "dateFrom": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
