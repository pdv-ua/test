  "dbExtensions": {
    "IDX_HR_EMPORDEREXTRACT_TYPE": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "empOrderType": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}
