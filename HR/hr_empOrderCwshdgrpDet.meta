      "caption": "Тип наказу",
      "documentation": "Тип наказу",
      "description": "Тип наказу",
      "allowNull": false,
      "defaultValue": "CWSHDGRP"
    },
    {
      "name": "descriptionExt",
      "dataType": "String",
