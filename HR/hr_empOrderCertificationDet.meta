      "documentation": "Обмежити значеннями з 'Тип спеціальності' = 'За фахом'"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата присвоєння",
      "description": "Дата присвоєння",
      "documentation": "Дата присвоєння",
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Терміном до",
      "description": "Терміном до",
      "documentation": "Терміном до"
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Терміном до",
      "description": "Терміном до",
      "documentation": "Терміном до",
      "allowNull": true,
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "docNumber",
      "dataType": "String",
      "size": 100,
