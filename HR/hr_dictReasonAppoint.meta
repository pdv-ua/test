{
  "caption": "Підстави для прийому на роботу",
  "description": "Підстави для прийому на роботу",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
       {
        "name": "code",
        "dataType": "String",
        "size": 32,
        "caption": "Код",
        "description": "Код",
        "documentation": "Код",
        "allowNull": false
      },
      {
        "name": "name",
        "dataType": "String",
        "size": 200,
        "caption": "Назва",
        "description": "Назва",
        "documentation": "Назва",
        "allowNull": false
      },
      {
        "name": "description",
        "dataType": "String",
        "size": 250,
        "mapping": [
          {
            "name": "AnsiSQL",
            "expressionType": "Expression",
            "expression": "(CONCAT({self}.code, ' ', {self}.name))"
          }
        ],
        "caption": "Опис",
        "description": "Опис",
        "documentation": "Опис"
      },
      {
        "name": "caption",
        "dataType": "String",
        "size": 350,
        "caption": "Опис",
        "description": "Опис",
        "documentation": "Опис",
        "defaultView": false,
        "allowNull": false,
        "customSettings": {
          "compositeFields": ["name", "code"],
          "compositeSeparator": ["", " [", "]"]
        }
      }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}