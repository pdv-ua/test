      "name": "mi_maxDateTo",
      "dataType": "DateTime",
      "caption": "mi_maxDateTo",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(SELECT MAX(o.mi_dateTo) FROM hr_organization o WHERE o.mi_data_id = {self}.mi_data_id and o.mi_deleteDate >= '9999-12-31')"
