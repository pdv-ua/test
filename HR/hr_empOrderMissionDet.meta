      "size": 600,
      "caption": "Наказ Деталь",
      "description": "Наказ Деталь",
      "documentation": "Наказ Деталь",
      "defaultView": false,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(SELECT TOP 1 CONCAT(heo.description, ' ', {self}.description) FROM hr_empOrder heo WHERE heo.id = {self}.orderID )"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(SELECT CONCAT(heo.description, ' ', {self}.description) FROM hr_empOrder heo WHERE heo.id = {self}.orderID LIMIT 1)"
        }
      ]
    }
