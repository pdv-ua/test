{
  "caption": "Нарахування на зарплату (Фонди)",
  "description": "Нарахування на зарплату (Фонди)",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "documentation": "Код",
      "allowNull": false
    },
    {
      "name": "codeSort",
      "dataType": "Float",
      "caption": "Код",
      "description": "Код",
      "documentation": "Код"
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 100,
      "caption": "Назва",
      "description": "Назва",
      "documentation": "Назва",
      "allowNull": false
    },
    {
      "name": "payFundMethodID",
      "dataType": "Entity",
      "associatedEntity": "hr_payFundMethod",
      "caption": "Метод розрахунку",
      "description": "Метод розрахунку",
      "documentation": "Метод розрахунку"
    },
    {
      "name": "typeTaxECBID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictTypeTaxECB",
      "caption": "Тип ставки страхового внеску",
      "description": "Тип ставки страхового внеску",
      "documentation": "Тип ставки страхового внеску"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Діє з",
      "documentation": "Діє з",
      "description": "Діє з",
      "defaultView": false,
      "allowNull": false
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "allowNull": false,
      "defaultView": false
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Діє з",
      "description": "Діє з",
      "documentation": "Діє з",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Діє по",
      "description": "Діє по",
      "documentation": "Діє по",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "calcPeriod",
      "dataType": "Enum",
      "enumGroup": "HR_ACCPERIOD_TYPE",
      "caption": "Розраховується",
      "description": "Розраховується",
      "documentation": "Розраховується",
      "allowNull": false
    },
    {
      "name": "sequence",
