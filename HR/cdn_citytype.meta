{
  "caption": "City types",
  "description": "City types directory",
  "connectionName": "",
  "sqlAlias": "cityt",
  "cacheType": "SessionEntity",
  "descriptionAttribute": "name",
  "documentation": "",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 16,
      "caption": "Code",
      "description": "Internal code of city type",
      "allowNull": false,
      "isMultiLang": false,
      "isUnique": true
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 128,
      "caption": "Name",
      "description": "City type name",
      "allowNull": false,
      "isMultiLang": true
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 150,
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "{self}.name"
        }
      ],
      "caption": "Опис",
      "description": "Опис",
      "documentation": "Опис"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}