{
  "caption": "Групи підрозділів для меню",
  "description": "Групи підрозділів для меню",
  "descriptionAttribute": "name",
  "cacheType": "None",
  "attributes": [
    {
      "name": "code",
      "dataType": "String",
      "size": 32,
      "caption": "Код",
      "description": "Код",
      "allowNull": false
    },
    {
      "name": "name",
      "dataType": "String",
      "size": 255,
      "caption": "Повна назва",
      "description": "Повна назва",
      "documentation": "Повна назва",
      "allowNull": false
    },
    {
      "name": "shortName",
      "dataType": "String",
      "size": 255,
      "caption": "Скорочена назва",
      "description": "Скорочена назва",
      "documentation": "Скорочена назва",
      "allowNull": false
    },
    {
      "name": "isClose",
      "dataType": "Boolean",
      "caption": "Не використовується",
      "description": "Не використовується",
      "allowNull": false,
      "defaultValue": "0"
    },
    {
      "name": "orgID",
      "dataType": "Entity",
      "associatedEntity": "hr_organization",
      "associationAttr": "mi_data_id",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 550,
      "caption": "Опис",
      "documentation": "Опис",
      "allowNull": true,
      "description": "Опис",
      "defaultView": false,
      "customSettings": {
        "compositeFields": ["code","name"],
        "compositeSeparator": " "
      }
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}
