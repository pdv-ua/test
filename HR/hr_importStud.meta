{
  "caption": "Список студентів (імпорт)",
  "description": "Список студентів (імпорт)",
  "descriptionAttribute": "studentNumber",
  "cacheType": "None",
  "attributes": [
    {
      "name": "orgID",
      "dataType": "BigInt",
      "caption": "Організаційна одиниця",
      "description": "Організаційна одиниця",
      "documentation": "Організаційна одиниця",
      "allowNull": false
    },
    {
      "name": "taxCode",
      "dataType": "String",
      "size": 20,
      "caption": "РНОКПП",
      "description": "РНОКПП",
      "documentation": "РНОКПП"
    },
    {
      "name": "studentNumber",
      "dataType": "String",
      "size": 50,
      "caption": "Номер студентського квитка",
      "description": "Номер студентського квитка",
      "documentation": "Номер студентського квитка"
    },
    {
      "name": "firstName",
      "dataType": "String",
      "size": 30,
      "caption": "Ім'я",
      "description": "Ім'я",
      "documentation": "Ім'я"
    },
    {
      "name": "lastName",
      "dataType": "String",
      "size": 30,
      "caption": "Прізвище",
      "description": "Прізвище",
      "documentation": "Прізвище"
    },
    {
      "name": "middleName",
      "dataType": "String",
      "size": 30,
      "caption": "По батькові",
      "description": "По батькові",
      "documentation": "По батькові"
    },
    {
      "name": "birthDate",
      "dataType": "Date",
      "caption": "Дата народження",
      "description": "Дата народження",
      "documentation": "Дата народження"
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Дата початку нарахування стипендії",
      "description": "Дата початку нарахування стипендії",
      "documentation": "Дата початку нарахування стипендії"
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Дата кінця нарахування стипендії ",
      "description": "Дата кінця нарахування стипендії",
      "documentation": "Дата кінця нарахування стипендії"
    },
    {
      "name": "accrualSum",
      "dataType": "Currency",
      "caption": "Сума стипендії",
      "description": "Сума стипендії",
      "documentation": "Сума стипендії"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": false,
      "safeDelete": false
    },
    "audit": {
      "enabled": false
    }
  }
