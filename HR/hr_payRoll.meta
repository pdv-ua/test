    },
    {
      "name": "totalAmount",
      "dataType": "Int",
      "caption": "Рядків у документі",
      "description": "Рядків у документі",
      "documentation": "Рядків у документі",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select count(*) from hr_payRollDt dt where dt.payRollID = {self}.ID and dt.mi_deleteDate >= '9999-12-31' and reason = '0')"
        }
      ]
    },
    {
      "name": "totalPaySum",
      "dataType": "Currency",
      "caption": "Підсумкова сума по документу",
      "description": "Підсумкова сума по документу",
      "documentation": "Підсумкова сума по документу",
      "mapping": [
        {
          "name": "AnsiSQL",
          "expressionType": "Expression",
          "expression": "(select sum(dt.paySum) from hr_payRollDt dt where dt.payRollID = {self}.ID and dt.mi_deleteDate >= '9999-12-31' and reason = '0')"
        }
      ]
    },
