{
  "caption": "Відсоток підвищення за звання",
  "description": "Відсоток підвищення за звання",
  "descriptionAttribute": "",
  "cacheType": "None",
  "attributes": [
    {
      "name": "dictEducationRankID",
      "dataType": "Entity",
      "associatedEntity": "trf_dictEducationRank",
      "caption": "Звання",
      "description": "Звання",
      "allowNull": false
    },
    {
      "name": "dateFrom",
      "dataType": "Date",
      "caption": "Початок",
      "description": "Початок"
    },
    {
      "name": "dateFromEmpty",
      "dataType": "Date",
      "caption": "Початок",
      "description": "Початок",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateFrom) WHEN 2000 THEN null ELSE {self}.dateFrom END)"
        }
      ]
    },
    {
      "name": "dateTo",
      "dataType": "Date",
      "caption": "Кінець",
      "description": "Кінець"
    },
    {
      "name": "dateToEmpty",
      "dataType": "Date",
      "caption": "Кінець",
      "description": "Кінець",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(CASE year({self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(CASE Extract(YEAR from {self}.dateTo) WHEN 9999 THEN null ELSE {self}.dateTo END)"
        }
      ]
    },
    {
      "name": "rate",
      "dataType": "Currency",
      "caption": "Відсоток підвищення тарифу",
      "description": "Відсоток підвищення тарифу"
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}