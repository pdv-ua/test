{
  "caption": "Можливі накази",
  "description": "Перелік об'єктів, що можуть виступати в якості наказів",
  "descriptionAttribute": "description",
  "cacheType": "SessionEntity",
  "attributes": [
    {
      "name": "numCode",
      "dataType": "Int",
      "caption": "Цифровий код",
      "documentation": "Унікальний цифровий код класу документа",
      "allowNull": false
    },
    {
      "name": "description",
      "dataType": "String",
      "size": 150,
      "caption": "Опис",
      "allowNull": false
    },
    {
      "name": "entityName",
      "dataType": "String",
      "size": 30,
      "caption": "Сутність",
      "description": "Сутність",
      "allowNull": false
    },
    {
      "name": "ordersType",
      "dataType": "String",
      "size": 255,
      "caption": "Тип документа",
      "description": "Тип документа",
      "allowNull": false
    },
    {
      "name": "empOrderType",
      "dataType": "Enum",
      "enumGroup": "HR_EMPORDRETYPE",
      "caption": "Тип Наказу з персоналу",
      "documentation": "Тип Наказу з персоналу",
      "description": "Тип Наказу з персоналу",
      "allowNull": true
    }
  ],
  "dbExtensions": {
    "IDX_HR_ORDERCLASS_ENT": {
      "type": "INDEX",
      "definition": {
        "keys": {
          "entityName": { "sort": "ASC" },
          "mi_deleteDate": { "sort": "ASC" }
        },
        "isUnique": false
      }
    }
  },
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
}