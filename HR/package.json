{
  "name": "hr",
  "version": "1.38.0",
  "description": "Accounting for Ukraine State Institution",
  "repository": "https://gitlab.intecracy.com/unitybase/gl/tree/master/apps/acc/models/HR",
  "config": {
    "ubmodel": {
      "name": "HR"
    }
  },
  "scripts": {
    "build": "cd ./public && webpack --mode production",
    "build:watch": "cd ./public && webpack --progress --colors --watch",
    "prepare": "npm run build",
    "analyse-boundle": "cd ./public && webpack --profile --json > /tmp/.wp_stats.json && webpack-bundle-analyzer /tmp/.wp_stats.json"
  },
  "public": false,
  "publishConfig": {
    "registry": "http://registry.unitybase.info"
  },
  "main": "hr.js",
  "browser": {
    "dev": "/models/HR/hr-public.js",
    "prod": "/models/HR/dist/hr-public.app.min.js"
  },
  "dependencies": {
    "@unitybase/base": "^5.0.0"
  },
  "devDependencies": {
    "@unitybase/stubs": "^5.0.0",
    "webpack-cli": "^3.3.10"
  },
  "keywords": [
    "UnityBase",
    "UB5"
  ],
  "author": "UnityBase team (https://unitybase.info)",
  "license": "(GPL-3.0 OR LGPL-3.0 OR MPL-2.0)"
}
