        "middleName",
        "title",
        "description",
        "empNameCase",
        "changedValues",
        "dateFrom",
        "dateTo",
        "itemIdx"
      ],
      "defaults": {
        "isExternal": "0"
      },
      "mapping": {
        "title": "title"
      }
    }
  }
