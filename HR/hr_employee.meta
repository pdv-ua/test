    {
      "name": "whereRegisteredInPFU",
      "dataType": "String",
      "size": 100,
      "caption": "Де оформлений в ПФУ",
      "description": "Де оформлений в ПФУ",
      "documentation": "Де оформлений в ПФУ"
    },
    {
      "name": "emailContact",
      "dataType": "String",
      "size": 255,
      "caption": "Email",
      "description": "Email",
      "documentation": "Email",
      "allowNull": true,
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 ec.value from hr_employeeContact ec inner join cdn_contacttype ct on ct.ID = ec.contactTypeID where ec.employeeID = {self}.ID and ct.code = 'email' and ec.mi_deleteDate >= '9999-12-31' order by ec.isDefault desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select ec.value from hr_employeeContact ec inner join cdn_contacttype ct on ct.ID = ec.contactTypeID where ec.employeeID = {self}.ID and ct.code = 'email' and ec.mi_deleteDate >= '9999-12-31' order by ec.isDefault desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "DaysToBirthday",
      "dataType": "Int",
      "caption": "Днів до дня народження",
      "description": "Днів до дня народження",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "Case When IsDate(Convert(varchar, Year(getdate())) + '-' + Convert(varchar, {self}.monthBirthDate) + '-' + Convert(varchar, {self}.dayBirthDate)) != 1 Then 0 Else DateDiff(day, getdate(), Convert(date, Convert(varchar, Year(getdate())) + '-' + Convert(varchar, {self}.monthBirthDate) + '-' + Convert(varchar, {self}.dayBirthDate))) End"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "Case When extract(year from current_date)::integer % 4 > 0 and {self}.monthBirthDate = 2 and {self}.dayBirthDate = 29 Then 0 Else (to_date(extract(year from current_date)::varchar || '-' || {self}.monthBirthDate::varchar || '-' || {self}.dayBirthDate::varchar, 'yyyy-mm-dd') - current_date) End"
        }
      ]
    }
  ],
  "mixins": {
    "mStorage": {
      "simpleAudit": true,
      "safeDelete": true
    }
  }
