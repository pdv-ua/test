    {
      "name": "lastEducationLevelID",
      "dataType": "Entity",
      "associatedEntity": "hr_dictEducationLevel",
      "caption": "Освіта",
      "description": "Освіта",
      "documentation": "Освіта",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 ee.dictEducationLevelID from hr_employeeEducation ee where ee.employeeID = {self}.ID and ee.mi_deleteDate >= '9999-12-31' order by ee.dateFrom desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select ee.dictEducationLevelID from hr_employeeEducation ee where ee.employeeID = {self}.ID and ee.mi_deleteDate >= '9999-12-31' order by ee.dateFrom desc LIMIT 1)"
        }
      ]
    },
    {
      "name": "currentOrganization",
      "dataType": "String",
      "size": 2000,
      "caption": "Поточна організація",
      "description": "Поточна організація",
      "mapping": [
        {
          "name": "MSSQL2012",
          "expressionType": "Expression",
          "expression": "(select top 1 org.name from hr_employeeNumber en left join hr_organization org on org.mi_data_id = en.orgID and org.state = 'ACTIVE' and org.mi_dateFrom <= GETDATE() and org.mi_deleteDate >= '9999-12-31' where en.employeeID = {self}.ID and en.mi_deleteDate >= '9999-12-31' order by en.dateTo desc, org.mi_dateTo desc)"
        },
        {
          "name": "PostgreSQL",
          "expressionType": "Expression",
          "expression": "(select org.name from hr_employeeNumber en left join hr_organization org on org.mi_data_id = en.orgID and org.state = 'ACTIVE' and org.mi_dateFrom <= CURRENT_DATE and org.mi_deleteDate >= '9999-12-31' where en.employeeID = {self}.ID and en.mi_deleteDate >= '9999-12-31' order by en.dateTo desc, org.mi_dateTo desc LIMIT 1)"
        }
      ]
    },
